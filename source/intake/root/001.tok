༄༅།_། ཐུབ་བསྟན་ དོན་ བརྒྱུད་ སྙིང་པོ་ མགོན་པོ་ འབྲི་གུང་པ འི་ དམ་ཆོས་ དགོངས་པ་ གཅིག་པ འི་ རྣམ་བཤད་ བློ་ གས ར་ དགའ་བ འི་ རྣ་རྒྱན་ དབྱར་ གྱི་ རྔ་སྒྲ་ ཞེས་ བྱ་བ་ བཞུགས་ སོ །_།༄༅།_། ན་མོ་ གུ་རུ་ རཏྣ་ ཤྲཱི་ ཡེ །སྣ་ཚོགས་ བསོད་ནམས་ འོ་མ འི་ མཚོ་ ལ་ བརྩོན་འགྲུས་ སྐྱ་བ ས་ བསྲུབས་པ་ ལ ས །_།གཟུགས་སྐུ འི་ རྩི་བཅུད་ མངོན་པར་ འཁྲུངས་ ནས་ སྤང་ རྟོག་ མཐ ར་ ཕྱིན་ རྫོགས་ སངས་རྒྱས །_།དེ ས་ གསུངས་ འགོག་ ལམ་ དམ་པ འི་ ཆོས་ དང་ རིག་ གྲོལ་ དབང་ཕྱུག་ དགེ་འདུན་ ལ །_།བྱང་ཆུབ་ བར་ དུ་ སྐྱབས་གནས་ བསླུ་མེད་ དཀོན་མཆོག་ རྣམ་ གསུམ་ གཙུག་ ན་ རྒྱལ །_།༄༅།_། འགྲོ་ ཀུན་ མ་རིག་ ཞགས་པ ས་ བཅིངས་ རྣམས་ རྣམ་དཔྱོད་ རིག་པ འི་ རལ་གྲི་ ཡིས །_།བསྐྲལ་ ནས་ བདེ་བ འི་ གནས་ ལ་ དབྱུང་ མཛད་ ཇི་སྙེད་ མཁྱེན་པ འི་ པོ་ཏི་ བསྣམས །_།རྒྱལ་བ་ ཀུན་ གྱི་ མཁྱེན་པ འི་ མངའ་བདག་ འཇམ་དཔལ་ དཔའ་བོ་ ཁྱེད་ མིན་ སུ །_།བདག་ བློ་ དད་པ འི་ ལན་ བརྒྱ ར་ བསྟོད་ ནས་ མི་ འབྲལ་ སྤྱི་བོ འི་ རྒྱན་ དུ་ མཆོད །_།སྟོན་པ ས་ ལུང་བསྟན་ གངས་ཅན་ བྱང་ཕྱོགས་ འབྲི་ ཐེལ་ རྡོར་ གདན་ གཉིས་ པ་རུ །_།ཟབ་མོ་ ལྟ་བ འི་ ཤིང་རྟ འི་ རྣམ་ རོལ་ ཀླུ་སྒྲུབ་ གཉིས་པ་ རཏྣ་ ཤྲཱི །_།ཆོས་ ཀུན་ གཤིས་ བབ་ རྟེན་འབྲེལ་ མངོན་ བསྒྱུར་ རྩེ་གཅིག་ སྤྲོས་བྲལ་ རོ་ གཅིག་ དང༌ །སྒོམ་ མེད་ ལྟ་བ འི་ ཡང་རྩེ ར་ སོན་པ་ ཆོས་རྗེ་ འཇིག་རྟེན་ མགོན་ ལ་ འདུད །_།འཕགས་ཡུལ་ གྲུབ་ཆེན་ ས་ར་ ཧ་ དང་ གངས་ཅན་ ཤེར་ འབྱུང་ རཏྣའི་ མཚན །_།སྤྲུལ་པ འི་ སྐུ་ མཆོག་ བཅུ་ཕྲག་ རིག་གནས་ རྒྱུད་སྡེ་ རྒྱ་མཚོ འི་ དོན་ ལ་ མཁས །_།འཇམ་པ འི་ དབྱངས་ དང་ གཉིས་ སུ་ མེད་པ་ རྒྱལ་དབང་ རིག་འཛིན་ ཆོས་ ཀྱི་ གྲགས །_།ཐུགས་རྗེ ས་ རྗེས་བཟུང་ བདག་ ཡིད་ དྭངས་ བས་ དྲིན་ཅན་ བླ་མ ར་ ཕྱག་ བགྱི འོ །_།སྟོན་པ ས་ གསུང་པ འི་ མདོ་སྔགས་ ཀྱི །_།དོན་ རྣམས་ མ་ ནོར་ གོ་ བདེ འི་ ཕྱིཪ །_།རྒྱལ་མཆོག་ འབྲི་གུང་ རིན་ཆེན་ གྱི །_།གསུངས་པ འི་ ཁྱད་ཆོས་ དགོངས་པ་ གཅིག _།བློ་ དམན་ བདག་ འདྲ་ རྣམས་ ལ་ ནི །_།ཕན་ ཕྱིར་ ཚིག་དོན་ འགྲེལ་ འདི་ བརྩམས །_།སྔོན་ཆད་ མ་ བྱུང་ འདི ར་ བརྗོད་ མེད །_།སྡེབ་སྦྱོར་ སྙན་པ འང་ བདག་ ལ་ མེད །_།གཞན་ ལ་ ཕན་པ འི་ བློ་ ཡང་ དཀའ །_།རང་ཉིད་ ལས་སྒྲིབ་ དག་ ཕྱིར་ བྱ །_།དེང་ འདི ར་ རང་ཅག་ རྣམས་ ཀྱི་ མེ་ཏོག་ གང་ ལ་ ཕོག་པ འི་ ལྷ་ སྐལ །ཆོས་རྗེ་ རིན་པོ་ཆེ འི་ གསུང་ དམ་ཆོས་ དགོངས་པ་ གཅིག་པ འི་ གཞུང་བཟང་ ཡིད་བཞིན་ གྱི་ ནོར་བུ་ རྡོ་རྗེ འི་ གསུང་ བརྒྱ་ དང་ ལྔ་ བཅུ །ལྷན་ཐབས་ བཞི་ བཅུ་པ འི་ དོན་ བཟང་པོ་ བདེ་བླག་ ཏུ་ རྟོགས་ ཆེད་ ཚིག་དོན་ གྱི་ རྣམ་བཤད་ འདི་ཉིད་ འཆད་པ་ ལ །ཐོག་མ ར་ དགེ་བ་ མཚན་ གྱི་ དོན་ དང༌ །འགྱུར་ཕྱག་ གཉིས་ ལ ས །དང་པོ །_ མཚན་དོན་ ནི །རྡོ་རྗེ་ སྟེ་ མཚོན་བྱེད་ དཔེ་ མཚོན་བྱ་ དོན་ གྱི་ རྡོ་རྗེ་ མཚོན་ ཏེ །སྒྲ་ རྟོག་ གི་ རྟོགས་པ ར་ དཀའ་བ ས་ ཟབ་མོ་ ལྟ་ངན་ གཞན་ གྱིས་ མི་ ཐུབ་པ་ དང༌ །སྟོང་ཉིད་ མི་ཕྱེད་པ་ དང༌ །རྡོ་རྗེ་ རིན་ཆེན་ ལྟར་ དཀོན་པ ས་ ན་རྡོ་རྗེ་ སྟེ་ དེ་ལྟ་ བུ འི་ གསུང་ གི་ གཞུང་ཚིག་ འབྲུ་ བརྒྱ་ ལྔ་ བཅུ་ ང་ གཉིས་པ་ དང་ ལྷན་ཐབས་ ཞེ་ བདུན་པ་ ཞེས་ བྱ་བ །གཉིས་པ་ འགྱུར་ཕྱག་ ནི །གནས་ དང་ གནས་མིན །ལ ས་ ཀྱི་ རྣམ་སྨིན །དབང་མཆོག་ མཆོག་ མིན །ཁམས་ སྣ་ཚོགས །མོས་པ་ སྣ་ཚོགས །ཀུན་ ནས་ འགྲོ་བ འི་ ལམ །བསམ་གཏན་ དང་ རྣམ་ཐར །སྔོན་ གནས་ རྗེས་དྲན །འཆི་ འཕོ་ དང་ སྐྱེ་བ །ཟག་ཟད་ དེ་ བཅུ་པོ་ དེ་ མཁྱེན་པ ས་ ན་སྟོབས་ བཅུ་ སྟེ་ དེ་ལྟ འི་ ཚུལ་ ལ་ དབང་ཕྱུག་ ཕ་ ཤཱཀྱ་ སྟེ་ ནུས་པ་ ལ་ འཇུག་པ ས་དེ འི་ བདག་ཉིད་ མུ་སྟེགས་ རྣམས་ སྐྲགས་པ ར་ མཛད་པ འི་ སེང་གེ་ ལྟ་བུ འི་ ཐུབ་དབང་ དེ་ ལ་ ཕྱག་ འཚལ་ ལོ །_།དུག་ གསུམ་ མམ་ སྒྲིབ་ གསུམ་ གྱི་ དྲི་མ་ མེད་པ ས་སྤང་བ་ དང་ རང་བཞིན་ འོད་གསལ་མཚན་མ འི་ རྡུལ་བྲལ་ སོ་སོ་ རང་རིག་ ཡེ་ཤེས་ ཀྱིས་ མཉམ་བཞག་ ཏུ་ གཟིགས་པ་ ཇི་ལྟ་བ་ དང༌ །དེ འི་ རྗེས་ཐོབ་ ཐུགས་ ཀྱི་ དཀྱིལ་འཁོར་ དུ །མཚན་ཉིད་ སོ་སོ ར་ རེ་རེ་ ནས་ མ་ འདྲེས་པ་ཤེས་བྱ འི་ དངོས་པོ་ མ་ལུས་པ་ ཀུན་ ཇི་ལྟ་བ་ དེ་ལྟར་ དང་ །ཐམས་ཅད་ ཆགས་ ཐོག་ བྲལ་བ ས་ལམ་ མེ ར་ གཟིགས་པ་ ཇི་སྙེད་པ་ མཁྱེན་པ འི་ ཡེ་ཤེས་ ཏེ་དེ་ལྟར་ སྤང་བ་ དང་ རྟོགས་པ་ ཕུན་སུམ་ ཚོགས་པ འི་ བདག་ཉིད་ ཀུན་མཁྱེན་ ཆོས་ ཀྱི་ རྗེ །དཔེ་ཟླ་ བྲལ་བ ས་ མཉམ་པ་ མེད་པ་འབྲི་གུང་ རིན་ཆེན་ ཏེ་ དགོས་འདོད་ ཐམས་ཅད་ སྟེར་བ་ དེ་ ལ་ ཕྱག་ འཚལ་ ལོ །_།རྒྱལ་བ་ སངས་རྒྱས་ མཆོག་ གི་ ཞལ་ ནས་ གསུངས་པ་ ཡི་མདོ་ རྒྱུད་ དམ་པ འི་ ཆོས་ རྣམས་ ཇི་བཞིན་ ཐུགས་ སུ་ ཆུད་པ་ ལ་ བརྟེན་ ནས་ཁྱད་པར་ དུ་ འཕགས་པ་ ཟབ་མོ འི་ དོན་ ཐུན་མོང་ མ་ཡིན་པ །_།སྔོན་ དུ་ འཇིག་རྟེན་ མགོན་པོ ས་ མཛད་པ འི་ བཞེད་སྲོལ་ དཔག་ ཏུ་ མེད་པ་ ཐོས་ ཀྱང་མི་ བརྗེད་པ འི་ གཟུངས་མ་ ཐོབ་པ་ རྨོངས་པ ས་ཐམས་ཅད་ བློ ར་ མ་ ཆུད་པ ས་ དྲན་པ་ ཅུང་ཟད་ ཙམ་ ཞིག་ བྲི །༈_ རྡོ ༽༽_ གཞན་དག་ ན་རེ །དེ་བཞིན་ གཤེགས་པ་ ནི་ ཆོས་ ཀྱི་ དབང་ཕྱུག་ ཡིན་པ ས་དེ ས་ ཇི་ལྟར་ བཞེད་པ་ དེ་ལྟར་ འགྱུར་ ཏེ །ཆོས་ ཐམས་ཅད་ ལ་ དབང་ བསྒྱུར་བ་ ཉིད་ ཀྱིས་ སོ་ ཞེས་ འདོད་ དོ །_།འདི ར་ ནི །ཆོས་ ཀུན་ གྱི་ གཤིས་ སམ་ བབ་ ཀྱི་ རང་བཞིན་ སྟོང་ཉིད་ གནས་ཚུལ་ སངས་རྒྱས་ ཀྱིས་ བསྟན་པ་ ཡིན་ ཏེ །ཆོས་ ཀུན་ རྣམ་པ ར་ དག་པ འི་ ངོ་བོ་ སངས་རྒྱས་པ ས་ཕྱྭ་ དང་ དབང་ཕྱུག་ ལྟར་ བྱེད་པོ་ མིན་པ་ དང༌ །ཆོས་ རྣམས་ ཀྱི་ གནས་ལུགས་ འདི་ལྟར་ ཡིན་པ་ དེ་བརྩེ་བ ས་ སེམས་ཅན་ རྣམས་ ལ་ སྟོན་པ ར་ མཛད་པ་ དང༌ །རང་བཞིན་ སངས་རྒྱས་ ཀྱིས་ ཀྱང་ བསྒྱུར་ དུ་ མེད་པ་ དང༌ །རྟེན་འབྲེལ་ གྱི་ གཤིས་ བསླུ་བ་ མེད་པ་ མཐོ་དམན་ ཀུན་ ཏུ་ འབྱུང་བ་ དང༌ །གནས་ དང་ གནས་མ་ ཡིན་པ་ མཁྱེན་པ འི་ ཡེ་ཤེས་ ཀྱི་ ཕྱིར །བབ་ ཀྱི་ གནས་ལུགས་ བསྟན་ ཏེ །གནས་ལུགས་ སམ་ རྟེན་འབྲེལ་ དེ་ དང་ གཅིག་ དང་ དུ་མ ར་ གསུངས་ ཀྱང་རྒྱུ་འབྲས་ ཀྱི་ དབང་ དུ་ ན །ཉེས་པ་ མི་དགེ་བ་ སྡུག་བསྔལ་ རྒྱུ་འབྲས་ སྤོང་བ འི་ ཐབས་ བསྟན །དགེ་བ་ བདེ་ལེགས་ ཀྱི་ ལ ས་ སྒྲུབ་པ འི་ ཐབས་ཚུལ་ ལ་འགོད་པ ས་ སངས་རྒྱས་ ཀྱི་ ཆོས་ ཏེ་སྣང་བ་ རྟེན་འབྲེལ་ དང་ རྟེན་འབྲེལ་ སྟོང་པ་ དངོས་པོ འི་ གཤིས་ ཡིན་པ ས་ དེ་ལྟར་ བསྟན་ ཏེ །འོ་ན་ དབང་ བསྒྱུར་བ་ མི་ འགྲུབ་བོ་ སྙམ་ ན །དེ་ ནི་ གཤིས་ བབ་ བསྒྱུར་བ་ མ་ ཡིན་ ཏེ་སྐྱོན་ སྤོང་བ་ དང་ ཡོན་ཏན་ སྒྲུབ་པ འི་ ཚུལ་ ཐམས་ཅད་ མི་ གཟིགས་པ འམ་ མངོན་དུ་ མ་ མཛད་པ་ གང་ཡང་ མེད་པ ས་ཆོས་ ཐམས་ཅད་ ལ་ དབང་ བསྒྱུར་ ཞེས་ བྱ །མི་ མཚུངས་ བློ་ ལ ས་ འདས་པ འི་ རྫུ་འཕྲུལ་ བསྟན་པ་ ཡང་རྒྱུ་རྐྱེན་ རྟེན་འབྲེལ་ གྱི་ གཤིས་ བབ་ བསྟན་པ་ ཡིན་ ནོ །_།དེ་སྐད་ དུའང་རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་ མ་གཏོགས་པ འི །_།ཆོས་ འགའ་ ཡོད་པ་ མ་ཡིན་པ །_།དེ་ཕྱིར་ སྟོང་པ་ མ་ཡིན་པ འི །_།ཆོས་ འགའ་ ཡོད་པ་ མ་ ཡིན་ ནོ །_།ཅེས་ དང་ །གང་ ལ་སྟོང་པ་ ཉིད་ རུང་བ །_།དེ་ ལ་ ཐམས་ཅད་ རུང་བ ར་ འགྱུར །སོགས་ དང༌ །གང་ཞིག་ རྐྱེན་ ལ་ སོཌ་ དང །ལྗོན་པ ས་ ཞུས་པ འི་ མདོ ར །རྒྱུ་ལ་ བརྟེན་ པའིམཁས་པ་ བཅོམ་ལྡན་འདས །_།མཐའ་ གཉིས་ ལྟ་བ་ རྟག་ ཏུ་ མི་ མངའ་ ཞིང༌ །_།ལ ས་ ཀྱི་ རྣམ་སྨིན་ འབྲས་བུ་ དེ་ཉིད་ གསུངས །_།ལྟ་བ འི་ མུན་འཇོམས་ ཁྱོད་ ལ་ ཕྱག་ འཚལ་ ལོ་ ༑ཞེས་ སོ །_།ལུགས་ འདི་ ལ ས་ གཞན་ དུ་ ན་བདེ་གཤེགས་ བྱེད་པོ ར་ ཐལ་བ་ དང་ །གནས་ དང་ གནས་མིན་ མཁྱེན་པ འི་ ཡེ་ཤེས་ མེད་པ་ ཐལ་བ་ སོགས་ཉེས་པ་ བསྟན་ རྣམས་ ལྡོག་ ཏུ་ མེད་ དོ །༈_ ལྷན ༽༽_ མཁས་པ་ གཞན་ གྱིས་ གདུལ་བྱ་ ཐ་དད་ ལ་ཐེག་པ འང་ སྣ་ཚོགས་ སུ་ བསྟན་པ ས་ ཐ་དད་ དོ་ ཞེས་ ཟེར་ རོ །འདི ར་ ནི་ ཕྱོགས་ བཅུ་ དུས་གསུམ་ གྱི་ རྒྱལ་བ་ མ་ལུས་པ་ ཀུན་ གྱི་ཆོས་ རྣམས་ བསྟན་པ འི་ ཐབས་ ནི་ གཅིག་ ཏུ་ འདོད་ དེ་སངས་རྒྱས་ ཞེས་པ འི་ ཡི་གེ་ དང་གསུངས་ དབྱངས་ ཡན་ལག་ དྲུག་ བཅུ་ དང་ཆོས་ བྱང་ཕྱོགས་ སོ་ འདུན་ དང་སྐུ་ཆོས་ སྐུ་ དང་ གཟུགས་སྐུ་ མཚན་དཔེ འི་ རྒྱན་པ་ དང་ བཞི་པོ་ དེ་སངས་རྒྱས་ ཐམས་ཅད་ ལ་ མཚུངས་པ ས་ བསྟན་པ་ གཅིག་ སྟེ་ལང་ཀ ར་ གཤེགས་པ་ ལ ས །འོད་སྲུང་ ལོག་པ ར་ དད་ སེལ་ དང༌ །གསེར་ཐུབ་ དག་ ཀྱང་ ང་ ཡིན་ ཅེས །མཉམ་པ་ཉིད་ དུ་ མཉམ་ གྱུར་པ ས །རྒྱལ་བ འི་ སྲས་ ལ་ ངས་ བཤད་ དོ །ཅེས་པ ས་ སངས་རྒྱས་ རྣམས་ དང་པོ་ ཐུགས་བསྐྱེད་ ཚུལ །བར་ དུ་ ལམ་ བསྒྲོད་ ཚུལ །ཐ་མ་ སངས་རྒྱས་ ནས་ ཆོས་འཁོར་ བསྐོར་བ་ དང་འབྲས་བུ་ དང་ བཅས་པ་ སེམས་ཅན་ ཁོ་ན འི་ དོན་ ཡིན་པ ས་ སོ ༑ལྷན ༽༽_ ཁ་ཅིག་ ན་རེ །སངས་རྒྱས་ ཀྱི་ ཆོས་ ཐེག་པ་ དང་ གྲུབ་མཐའ་ ཐ་དད་ ངེས་པ་ ཅན་ ཏེ་འཇིག་རྟེན་ ལ་ལ ར་ ཀུན་ ཏུ་ གཟིགས་ ལྟ་བུ ས་ ཐེག་ཆེན་ འབའ་ཞིག _།ཞི་བ འི་ བློ་གྲོས་ ལྟ་བུ ས་ ཐེག་ཆུང་ དང་ །གཟི་བརྗིད་ ཡོན་ཏན་ ལྟ་བུ ས་ བསྙེན་གནས་ གཅིག་པུ་ དང་ །ལ་ལ ར་ གསང་སྔགས་ ཁོ་ན་ སོ་སོ ར་ རྟོགས་པ འི་ ངེས་པ་ ཅན་ ཡིན་ ནོ །_།ཞེས་ ཟེར་ རོ །འདི ར་ ནི་ སངས་རྒྱས་ གྱི་ ཐེག་པ་ དང་ གྲུབ་མཐའ་ ཡི་ ཆོས་ ཐམས་ཅད་ རྟེན་འབྲེལ་ འབའ་ཞིག་ ཡིན་ ཏེ །རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་ མ་གཏོགས་པ་ སོགས་ ཞེས་པ་ ལྟར་དུས་གསུམ་ གྱི་ སངས་རྒྱས་ ཐམས་ཅད་ ཀྱིས་ མངོན་དུ་ མཛད་པ འི་ ཆོས་ ཐམས་ཅད་ རྟེན་འབྲེལ་ ཏེ །དེ འང་ ཚིག་དོན་ གཉིས་དོན་ ལ འང་ ཕྱི་ ནང་ གསང་ གསུམ་ ཐུགས་ སུ་ ཆུད་ མཁན་ དང་ བཞི །དང་པོ་ ལ་ རླུང་ བརྟེན་ དེ་ ལ་ ཆུ་ སོགས་ དང་ །གཉིས་པ་ སྟོང་ བཞིན་ རྒྱུ་འབྲས་ སུ་ འབྱུང་བ་ ཕྱག་རྒྱ་ ཆེན་པོ འི་ དོན་ དང༌ །ནང་ གི་ རྟེན་འབྲེལ་ ལ ས །ཕྱི་ སྣོད་ དུ་ སྣང་བ་ དང་ བཅུད་ རྣམས་ རྒྱུ་ དེ་ལས་ འདི་ འབྱུང་བ་ དང༌ །གསུམ་པ་ ཕྱི འི་ དངོས་པོ་ བྱ་བ་ འདི་ དང་ འདི་ འགྲུབ་ ཚུལ་ ལོ །_།གསུམ་པ་ གསང་བ་ རང་བཞིན་ གྱི་ བསམ་པ་ལུས་ ཀྱི་ རྟེན་འབྲེལ་ སྐྱོན་ཡོན་ གྱི་ རྒྱུ་རྐྱེན་ ཐམས་ཅད་ དེ ར་ གནས་པ ས་ སོ །_།གང་ཟག་ ནི་ ཆོས་རྗེ་ ལྟ་བ འོ །༈_ རྡོ ༽༽_ འདི ར་ ནི་ ཆོས་ཕུང་ བརྒྱད་ ཁྲི་ ཉོན་མོངས་ ཐམས་ཅད་ ཟད་པར་ སྤོང་བ འི་ ཐབས་ ཡིན་པ ས་དེས་ན་ སངས་རྒྱས་ སྒྲུབ་པ ར་ ཟག་པ་ བག་ཆགས་ དང་ བཅས་པ་ སྤོང་ དགོས་པ་དེ འི་ ཕྱིར་ ཐབས་ གཅིག་ ཏུ་ ཤེས་ དགོས་ ཤིང༌ །གལ་ཏེ་ གཅིག་ མ་ཚང་ ཡང་དེ་ ཡི་ ངོ་སྐལ་ གྱི་ སྤང་བྱ་ མི་ སྤོང་བ ས་མཐར་ཐུག་ གི་ བྱང་ཆུབ་ མི་ ཐོབ་ སྟེ་གཙུག་ ན་ རིན་པོ་ཆེ འི་ མདོ འི་ དོན་ རྒྱུད་ བླ ར་ཇི་ལྟར་ རི་མོ་ བྲི་ བྱེད་པ་ སོགས་ ནས །དེ་ རྣམས་ འབྲི་ བྱེད་ གང་ཡིན་པ །སྦྱིན་ དང་ ཚུལ་ཁྲིམས་ བརྗོད་ ལ་སོགས །_།རྣམ་པ་ ཀུན་ གྱི་ མཆོག་ལྡན་པ །སྟོང་པ་ཉིད་ ནི་ གཟུགས་ སུ་ བརྗོད །ཅེས་ དང༌ །ཇི་སྲིད་ དགེ་བ འི་ རྩ་བ་ དེ་ ནི་ སོགས་ ཀྱིས་བོར་ རྒྱུ་ བཞག་ རྒྱུ་ རྡུལ་ ཙམ་ མེད་ཐམས་ཅད་ ཉམས་ སུ་ ལེན་ དགོས་ སོ །༈_ ལྷན ༽༽_ ཁ་ཅིག་ ན་རེ །_།ཆོས་ཕུང་ ནི་ བ་གླང་ གི་ རྒྱབ་ཁལ་ དང་བསྟན་བཅོས་ ཚད་ དང་ ཕུང་པོ་ སོགས་ གཏམ་ རེ་ ཚང་བ་ སོགས་ འདོད་ དོ །འདི ར་ ནི་བརྒྱད་ ཁྲི་ བཞི་ སྟོང་པོ་ ཉོན་མོངས་ བརྒྱད་ ཁྲི་ བཞི་ སྟོང་ གི་ གཉེན་པོ ར་ བཞག་པ་སྙིང་རྗེ་ པད་དཀར་ གསང་བ་ བསམ་ མི་ ཁྱབ་པ་ སོགས་ ལ ས་ དངརྣམ་སྣང་ མངོན་བྱང་ ལ ས་ ཀྱང །ཉོན་མོངས་ རྣམས་ ཀྱི་ གཉེན་པོ ར་ ནི །_།ཕུང་པོ་ བརྒྱད་ ཁྲི་ བཞི་ སྟོང་ གསུངས །མཛོད་ ལ ས །སྤྱོད་པ་ རྣམས་ ཀྱི་ གཉེན་པོ་ ནི །_།ཆོས་ ཀྱི་ ཕུང་བོ་ མཐུན་པ ར་ གསུངས །ཞེས་ སོ །ཁ་ཅིག་ ན་རེ །སྡེ་སྣོད་ རྒྱུད་སྡེ་ གང་རུང་ རེ་ ཉམས་ སུ་ བླངས་ ན་མྱང་འདས་ ཐོབ་པ ས་ གང་ མོས་ ཀྱི་ ལམ་ ཡིན་ ཅེས་ ཟེར་ རོ །འདི ར་ ནི་ སྡེ་སྣོད་ གསུམ་ རྒྱུད་སྡེ་ བཞི་ ལམ་ གྱི་ རིམ་པ་ ཡིན་པ ས་གང་ཟག་ གཅིག་ ལ་ ཚང་ དགོས་ ཏེ་བསླབ་ གསུམ་ གྱི་ མདོ ར །དགེ་སློང་ དག་ ཚུལ་ཁྲིམས་ ལ་ གནས་ ན་ ཏིང་འཛིན་ སྐྱེ་བ ར་ འགྱུར་ རོ །དེ་ ཡུན་རིང་ དུ་ གནས་ ན་ ཤེས་རབ་ ཐོབ་པ་ འགྱུར་ རོ །དེ་ གོམས་པ ར་ བྱས་ ན་ དུག་ གསུམ་ ལ ས་ སེམས་ རྣམ་པ ར་ གྲོལ་ ལོ །ཞེས་ དང་ །དེ་ ལ་ བྱེ་བྲག་ སྨྲ་བ་ གྲག་ ཅེས་ སོགས་ ཀྱི་ གསལ་ ལོ །༈_ ལྷན ༽༽_ གཞན་དག་ ན་རེ །གསུང་རབ་ ཡན་ལག་ བཅུ་གཉིས་ སོ་སོ ར་ མ་ འདྲེས་པ་ ཐ་དད་ ཡིན་ ཟེར །འདི ར་ ནི །_ སྡེ་སྣོད་ རེ་རེ་ ལ་ ཡང་ གསུང་རབ་ བཅུ་གཉིས་པོ་ འདི་རིགས་ སུ་ ཚང་ སྟེ་ ཕལ་ཆེན་ ལྟ་བུ འོ །_།མདོ་སྡེ་ དབྱངས་ བསྙད་ ལུང་བསྟན་ ཚིགས་བཅད་ ཆེད་བརྗོད་གླེང་ གཞི་ རྟོགས་བརྗོད་ དེ་ལྟར་ བྱུང་སྐྱེས་ རབ་ ཤིན་ཏུ་ རྒྱས་པ་ རྨད་བྱུང་ གཏན་ དབབ་ བཅུ་གཉིས་ ཏེ་ །དང་པོ་ ལྔ་ ཉན་ཐོས་ ཀྱི་ མདོ་སྡེ་དེ་འོག་ བཞི་ འདུལ་བ འི་ སྡེ་སྣོད་དེ་འོག་ གཉིས་ བྱང་སེམས་ ཀྱི་ མདོ་སྡེ་ཐ་མ་ གཅིག་ ནི་ གཉིས་ཀ འི་ མངོན་པ འོ །ལྷན ༽༽ མཁས་པ་ ལ་ལ ས་སྡེ་སྣོད་ གསུམ་ སོ་སོ ར་ ཐུག་ རེག་ མེད་ དེ་འདུལ་བ ར་ གསུང་ ས་ མངོན་པ་ ན་ མེད་པ་ སོགས་ ཀྱིས་ མ་ འདྲེས་པ་ ཡིན་ ཟེར་ རོ །འདི ར་ སྡེ་སྣོད་ སྔ་མ འི་ དེ་བཞིན་ དུ་ སྡེ་སྣོད་ འདུལ་བ་ ལྟ་བུ་ གཅིག་ ལ འང་ སྡེ་སྣོད་ གསུམ་ ཀ་ འདུས་ ཏེ་ དང༌པོ་ཝཱ་ རཱ་ ཎ་ སྰིར་ གསུངས་པ་ ནས་ ཐ་མ་ ཀུཤའི་ གྲོང་ དུ་ མྱ་ངན་ ལ ས་ འདས་པ འི་ བར་ དུ་ འདྲེས་ ཅན་ དུ་ གསུངས་ ཏེ་ཤས་ ཆེ་ཆུང་ ཙམ་ ལ ས་ ཐ་དད་ ཡིན་ ན་བསླབ་པ་ གསུམ་ ཡ་བྲལ་ དུ་ འགྱུར་བ འི་ ཕྱིར་ རོ །རྡོ ༽༽ བསྟན་འཛིན་ གཞན་ གྱི་ ཐེག་ཆུང་ ཐེག་ཆེན་ ཐེག་པ་ སྣ་ཚོགས་ ཏེ་རིགས་ཅན་ གསུམ་པོ་ ཐ་དད་ ལ་ བསྐོར་བ་ ཡིན་ ཟེར་ རོ །འདི ར་ རང་ བཞེད་ ནི་ཆོས་འཁོར་ རྣམ་པ་ གསུམ་པོ་འཁོར་ གྱི་ གདུལ་བྱ འི་ རྟོགས་པ་ གོང་ ནས་ གོང་ དུ་ འཁྲིད་པ འི་ ཐབས་ ཀྱི་ ཁྱད་པར་ རམ་ བོག་ དབྱུང་བ འི་ དོན་ དུ་ གསུངས་པ་ སྟེ་ཝ་ རུ་ ན་ ལྟ་བུ་ བདེན་ བཞི འི་ ཆོས་འཁོར་ གྱིས་ ཉོན་མོངས་ ཀྱིས་ མ་ གོས་པ ས་ སྨིན་པ ར་ བྱས །བར་ དུ་ བདེན་ བཞི་ དེ་ཉིད་ སོགས་ གཟུགས་ ནས་ རྣམ་མཁྱེན་ བར་ སྤྲོས་བྲལ་ དུ་ བསྟན་པ་མཚན་ཉིད་ མེད་པ ར་ མངོན་པར་ རྟོགས་པ འི་ ཤེས་རབ་ སྐྱེས་ ཏེ་ས ས་ རྒྱས་ ཀྱིས་ ང་ ཡང་ དགྲ་བཅོམ་པ་ ཡིན་ ལ་ཁྱེད་ རྣམས་ ཀྱང་ དགྲ་བཅོམ་ ཡིན་ གསུངས་པ ས་ ཤིན་ཏུ་ སྨིན་པ ར་ བྱས །སྟོང་པ་ཉིད་ རྟོགས་པ་ དེ ས་ མི་ ཆོག་ ཆོག་ ག་ བསམ་ གྱིས་ མི་ ཁྱབ་པ འི་ གནས་ ལ་ འཇུག་པ འི་ ཕྱིར །ཁྱེད་ རྣམས་ དགྲ་བཅོམ་ མ་ ཡིན་ སོགས་ གྱིས་ འོག་མ་ སུན་ དབྱུང་ ནས་གཙང་ བདེ་ རྟག་ བདག་ དམ་པ འི་ ཕར་ཕྱིན་ བསྟན་ ཏེ་ བྱང་ཆུབ་ ཏུ་ ལུང་བསྟན་པ ས །ངེས་དོན་ འཁོར་ལོ ས་ ཤིན་ཏུ་ སྨིན་པ ར་ མཛད་ དོ །_།བྱང་ཆུབ་ ཕུང་པོ ར་ ཞེན་ ནས་ མཆོག་འཛིན་ མ་ བྱེད་ ཅེས །དང་པོ་ ལས་ཅན་ དེ་ ལ་སོགས་ ཀྱིས་ སྒྲུབ་བོ །ལྷན ༽༽_ མཁས་པ་ ལ་ལ འི་ བཞེད་དོན་སྟོན་འཁོར་ ཆོས་ གནས་དུས་ ཏེ་ ཕུན་ཚོགས་ ལྔ ས་ བསྡུས་པ་ བཀའ་ ཡིན་ ཀུན་ ལ་མ་ ཁྱབ་པ ར་ འདོད་ མོད །འདི ར་ ནི་ འཁོར་བ་ རིགས་ དྲུག་ དང་ མྱང་འདས་ ཐམས་ཅད་ ཕུན་སུམ་ ཚོགས་པ་ ལྔ་ ཡིས་ བསྡུས་པ ར་ བཞེད་ དེ་རྣམ་བྱང་ ཕྱོགས་ འཁོར་ལོ་ གསུམ་ ལ་ བཀའ་ དང་ བསྟན་བཅོས་ མན་ངག་ གསུམ་ གསུམ་ གྱིས་ དགུ་སྟེ་དེ་དག་ དང་ འཁོར་བ་ འགྲོ་བ་ དྲུག་ ཀྱང་ སོ་སོ ར་ སྟོན་པ་ སོགས་ ཕུན་ཚོགས་ ལྔ་ ཚང་བ་ ཡིན་ ནོ །རྡོ ༽༽_ ཁོ་ན་ རེ །_ ཆོས་འཁོར་ གསུམ་ བརྗོད་བྱ་ ཐ་དད་པ་ སྔ་ཕྱི་ སོགས་ མ་ འདྲེས་པ་ ཡིན་ ཟེར་ ཡང༌ །འདི ར་ ཆོས་ ཀྱི་ འཁོར་ལོ་ རེ་རེ་ ལ་ ཡང་ ཆོས་འཁོར་ དང་པོ་ དང་ གཉིས་པ་ གསུམ་པ་ དང་ བཅས་ གསུམ་ ཀ་ ཚང་བ ར་ བཞེད་ དེ །དང་པོ ར་ སྡུག་བསྔལ་ གྱི་ རྒྱུ་ ཀུན་འབྱུང་འཕགས་ལམ་ གྱིས་ སྤང་བ ས་འབྲས་བུ་ འགོག ས་པ་ མངོན་དུ་ བྱས་པ་ དང་གཉིས་པ ར་ ཡང་ འདུ་ཤེས་ གཉིས་ འཛིན་བཟང་ངན་ གྱི་ ཀུན་འབྱུང་ དང་ མཐོ་རིས་ ཡོན་ཏན་ བདུན་ ཐོབ་པ ར་ བྱ་ སྙམ་པ་ཆོས་ ལ་ བརྟེན་པ འི་ ཀུན་འབྱུང་ སྤང་བ ས་རྟེན་འབྲེལ་ སྟོང་ཉིད་ མཚན་མ་ མེད་པ་ མངོན་དུ་ བྱས་པ་ དང༌ །གསུམ་པ ར་ ཡང་དག་པ ར་ གནས་པ འི་ བྱང་སེམས་ ཀྱི་ རྒྱུད་ ཀྱི་ བག་ཆགས་ ཕྲ་བ འི་ ཀུན་འབྱུང་ སྤངས་པ ས་མཐར་ཐུག་ གི་ འགོག ས་པ་ མངོན་དུ་ བྱས་པ ས་ཀུན་འབྱུང་ སྤོང་བ་ མཚུངས་པ འི་ ཕྱིར་ དང༌ །དང་པོ་ ལ་ དགག་སྒྲུབ་ ཀྱི་ མཚན་ཉིད་ བདེན་ བཞི་ ༑རྣམ་ཐར་ སྒོ་གསུམ་ སོགས་ ནི་ མཚན་ཉིད་ མེད་པ །གཏུམ་པོ་ རབ་ སྣང་ ལ་ གསུམ་ གསོལ་བ ས་ སྟོབས་ བཅུ་ བསྟན་པ་ ངེས་དོན་ ཏེ་དེ་ལྟར་ གཞན་ གཉིས་ ལ་ ཡོད་པ འི་ ཕྱིར་ རོ །རྡོ ༽༽_ མཁས་པ་ གཞན་དག་ ན་རེ །འཁོར་ལོ་ གསུམ་ གྱི་ དོན་ འབྲེལ་ དེ་ལྟར་ ཚང་བ ར་ གནས་ ཀྱང་ཚིག་མཚོན་པ་ མི་ གསལ་བ་ ཡོད་ ཟེར་ མོད །འདི ར་ ཕྱི་མ་ ཕྱི་མ འི་ ས་བོན་ སྔ་མ་ སྔ་མ ར་ གནས་པ འི་ ཕྱིར་ཚིག་ གིས་ ཀྱང་ གསལ་ ཏེ་སྐྱེས་མ་ ཐག་ གི་ བྱིས་པ་ ན ར་ སོན་པ འི་ དུས་ སུ འང་ གཞི་ དང་པོ འི་ ལུས་ དེ་ ཡིན་པ་ བཞིན །དང་པོ ར་ བསྟན་པ་ དེ་ཉིད་ མཐར་ཐུག་ གི་ དུས་ སུ་ གསལ་བ ར་ བསྟན་པ་ ཙམ་ ལ ས་འགལ་བ ར་ མ་ བསྟན་པ་ ནི་ དང་པོ ར་ སྡོམ་པ འི་ ངོ་བོ་ རྣམ་རིག་ མིན་པ་དེ་ཉིད་ བར་པ འི་ ས་བོན་ ཡིན་པ འི་ ཕྱིར་ དང་ །བར་པ ར་ དགོངས་འགྲེལ་ ལ ས །ལེན་པ འི་ རྣམ་པ ར་ ཤེས་པ་ ཟབ་ ཅིང་ ཕྲ །ས་བོན་ ཐམས་ཅད་ ཆུ་བོ འི་ རྒྱུན་ བཞིན་ བབས །བདག་ ཏུ་ རྟོག་པ ར་ འགྱུར་ ན་ མི་ རུང་ ཏེ །བྱིས་པ་ རྣམས་ ལ་ ངས་ ནི་ དེ་ མ་ བསྟན །ཅེས་ དང་ །སྨྲ་ བསམ་བརྗོད་ མེད་ ཤེས་རབ་ ཕ་རོལ་ ཕྱིན །སོགས་ ནས །ངོ་བོ་ ཉིད་ ཅེས་ བསྟན་པ་ ནི །ཐ་མ འི་ ས་བོན་ ཡིན་པ འི་ ཕྱིར་ དང༌ །དེ་ཡང་ འཁོར་ལོ་ ཐ་མ འི་ སྐབས་ ལ་སྔགས་ ཀྱི་ ས་ འོན་ བཞག་པ་ ལང་ཀ ར་ གཤེགས་པ་ ལ ས །བློ་གྲོས་ ཆེན་པོ་ ས་མཐ ར་ ཕྱིན །_།ཆོས་ ཀྱི་ དབང་ ནི་ བསྐུར་ གནས་ སུ །_།འོག་མིན་ སྟུག་པོ་ ཉམས་ དགའ་བ ར །_།ཡང་དག་ སངས་རྒྱས་ དེ ར་ སངས་རྒྱས །_།སྤྲུལ་པ་པོ་ ཞིག་ འདི ར་ འཚང་ རྒྱ །ཞེས་ དང་ དེ་ཉིད་ ལ ས །འདོད་པ འི་ ཁམས་ དང་ གཟུགས་ མེད་ དུ །_།སངས་རྒྱས་ རྣམ་པ ར་ འཚང་ མི་ རྒྱ །_།གཟུགས་ ཀྱི་ ཁམས་ ཀྱི་ འོག་མིན་ དུ །_།འདོད་ཆགས་ བྲལ་ ཁྱོད་ འཚང་ རྒྱ འོ །_།ཞེས་ སོགས་ ཀྱིས་ ཕྱི་མ་ ཕྱི་མ འི་ འབྲས་བུ་ ཐེག་པ་ ནས་ བཟུང་རྒྱུ འི་ ཐེག་པ་ སྔ་མ འི་ བར་ གྱི་ ས་བོན་ གནས་ཚུལ་ གསལ་བ ར་ སྒྲུབ་ མོ །རྡོ ༽༽_ ཁ་ཅིག་ ན་རེ །འཁོར་ལོ་ གསུམ་ ནི་ གནས་དུས་ རིགས་ཅན་ གསུམ་ གསུམ་ གྱིས་ འབྱེད་པ ར་ འདོད་ མེད་ ལ །འདི ར་ མདོ་ དང་ དོན་ གྱི་ གནད་ ཀྱིས་ ཆོས་ ཀྱི་ འཁོར་ལོ་ རྣམ་པ་ གསུམ་ དུ་ ངེས་ ཏེ །ཚངས་རིས་ ཀྱི་ ལྷས་ ཨེ་མ་ སྔོན་ཆད་ འཇིག་རྟེན་ དུ་དགེ་སྦྱོང་ ངམ་ བྲམ་ཟེ་ འམ །_ ལྷ་ འམ །_ བདུད་ དམ །_ ཚངས་པ འམ །_ སུ ས་ ཀྱང་ མ་ བསྐོར་བ འི་ ཆོས་ ཀྱི་ འཁོར་ལོ་ བསྐོར་ རོ །_།ཞེས་པ ས་ དང་པོ་ དང༌ །རབ་འབྱོར་ གྱིས་ དེ་བཞིན་ཉིད་ ཀྱི་ ལེའུ་ བསྟན་ ཚེ་གཙང་རིས་ ལྷས་ མེ་ཏོག་ འཐོར་ ཞིང་ཨེ་མ་ འཛམ་བུ འི་ གླིང་ དུ་ ཆོས་ ཀྱི་ འཁོར་ལོ་ གཉིས་པ་ འསྐོར་བ་ མཐོང་ ངོ་ །ཞེས་པ ས་ གཉིས་པ་ དང༌ །དགོངས་འགྲེལ་ ལ ས་དོན་དམ་ ཡང་དག་ འཕགས་ ཀྱིས་ བཅོམ་ལྡན་འདས་ ཀྱི་ དང་པོ ར་ ཝཱ་ རཱ་ ཎ་ སཱིར་ བསྐོར་བ་ དེ་ཡང་ བླ་ ན་ མཆིས་པ །སྐབས་མཆིས་པ །དྲང་དོན་ རྩོད་གཞི ར་ གྱུར་པ་ ལགས་ ལ །གཉིས་པ་ བྱ་རྒོད་ ཕུང་པོ་ རེ ར་ བསྐོར་བ འང་ དེ་བཞིན་ དང་ །ད་ལྟར་ བསྐོར་བ་ འདི་ ནི་ སྐབས་ མ་ མཆིས་པ་ དང་ །བླ་ ན་མ་ མཆིས་ སོགས་ ཀྱིས་ མཐའ་མ ར་ བཞག་པ་ མདོ་ ལུང་ འདི འི་ གནད་ ཀྱིས་ གསུམ་ དུ་ ངེས་ སོ །གཉིས་པ་ དོན་ གྱི་ གནད་ ཀྱིས་ སངས་རྒྱས་ ཀྱིས་ འཁོར་བ་ སྤོང་བ འི་ ཐབས་ མངོན་རྟོགས་ ཀྱི་ རིམ་པ་ རྒྱུད་ ལ་ དགོས་པ ར་ གསུངས་པ ས་གང་ཟག་ གི་ རྒྱུད་ ལ་ རིམ་པ འི་ ཚུལ་ གྱིས་ འབྱུང་ སྟེ་དེ་དོན་ སྒམ་པོ་པ འི་ རྣལ་འབྱོར་ བཞི ར་ འཁོར་ལོ་ བཞི འི་ དོན་ དང་ གཅིག་པ ས་ གསུམ་ དུ་ ངེས་པ འོ །_།འཁོར་ལོ་ གསུམ་ དོན་ མཐོ་དམན་ ཡོད་པ་ ཆེད་ དུ་ བརྗོད་ མཁན་ ཡང་ དེ་བཞིན་ ནོ །_།དེས་ན་ གནས་དུས་ སོགས་ ཀྱིས་ མི་ ཕྱེད་ དེ །ཝཱ་ རཱ་ ཎ་ སཱིར་ རྡོ་རྗེ འི་ མཆུ་ སོགས་ དང༌ །རྒྱལ་པོ འི་ ཁབ་ ཏུ་ བདེན་ བཞི །_ མདོ་ བཟུང་བ་ སྙིང་པོ་ བསྟན་པ་ སོགས་ དང༌ །རྩ་ མཆོག་ ཏུ་ རབ་ བཟང་ ལ་ བདེན་ བཞི་ བསྟན་པ འི་ ཕྱིར་ དང་ །གཉིས་པ་ དུས་ ཀྱིས་ ཀྱང་ མི་ ཕྱེད་ དེ །དུས་ དང་པོ ར་ ཡུམ་ གྱི་ ལྷུམས་ སུ་ ཐེག་ཆེན་ གསུང་པ་ དང༌ །སངས་རྒྱས་ མ་ ཐག་ རྣམ་ འཇོམས་ སོ ར་ འབྲད་ ཕལ་པོ་ ཆེ འི་ དབུ་ སྟོད་ སོགས་ དང༌ །བར་པ ར་ ཡང་ ནོར་ བཟང་ མི་ རྣམ་པ ར་ སྡོང་པོ་ རྒྱན་ སོགས་ དང་ །ཐ་མ ར་ ལུང་ཞུ་བ་ སོགས་ གསུངས་པ་ དང་ །གསུམ་པ་ འཁོར་ གྱིས་ ཀྱང་ མི་ ཕྱེད་ དེ་དང་པོ ར་ བྱམས་པ་ སོགས་ དང་ །_ བར་ མཐའ་ གཉིས་ ལ འང་ ལྔ་ སྡེ་ བཟང་པོ་ ཡོད་པ འི་ ཕྱིར་ རོ །རྡོ ༽༽ ཚུལ་ དགུ་ འཛིན་པ་ ཁ་ གཅིག་ གིས །དགག་ བྱེད་ ལ་ལུང་ རྣམ་འབྱེད་ སྒྲུབ་བྱེད་ ལ་ལུང་ གཞི །ལུང་ ཕྲན་ ཚིག _།ཐེ་ཚོམ་ གཅོད་པ་ ལ་ལུང་ ཞུ་བ་ སོགས་དགག་སྒྲུབ་ ཐེ་ཚོམ་ གཅོད་པ་ གསུམ་ བརྗོད་དོན་ ཡིན་ གྱི་ བདེན་ བཞི་ བསྟན་པ འི་ ཕྱིར །བདེན་ བཞི་ མངོན་པ་ ནས་ རྒྱས་པ ར་ བསྟན་པ ས་ མངོན་པ འི་ སྡེ་སྣོད་ ཡིན་ ཟེར་ ལ །འདི ར་ ནི་ འདུལ་བ འི་ སྡེ་སྣོད་ བདེན་ བཞི འི་ ཆོས་འཁོར་ ཡིན་ ཏེ་ཉོན་མོངས་པ་ སེམས་ དང་ དེ་ དང་ རྗེས་སུ་ འབྲེལ་བ་ ལ ས་ ཏེ་དེ་ གཉིས་ ལས་འབྲས་ བུ་སྡུག་ བསྔལ་ འབྱུང་བ་འཁོར་བ་ རྒྱུ་འབྲས་ དགག་ བཅས་ སྤང་བྱ་ ལྡོག་པ འི་ ཚུལ་ཁྲིམས་ ལུང་ རྣམ་འབྱེད་ ཀྱིས་ བསྟན་པ་ ན་ཉིས་ བརྒྱ་ ལྔ་ བཅུ་ རྩ་ གསུམ་ སྡུག་བསྔལ་ ཤེས་པ །ཀུན་འབྱུང་ སྤོང་བ་ དང༌ །རྩ་བ་ བླ་མ་ ཡན་ལག་ འཕགས་ལམ་ བསྟེན་པ ས་འབྲས་བུ་ འགོག་པ་ ཐོབ་པ་མྱང་འདས་ རྒྱུ་འབྲས་ སྒྲུབ་ བཅས་བླང་ བྱ་ འཇུག་པ འི་ ཚུལ་ཁྲིམས་ ལུང་བཞི ས་ བསྟན་པ་རབ་བྱུང་ སོགས་ བཞི་ བཅུ་བདུན་ ལས་མི་ འགལ་བ་ ལམ་ དང་ །དེ ས་ ཀུན་འབྱུང་ སྤང་བ ས་ སྡུག་བསྔལ་ འགག་པ་ འགོག་ འདེན་ ཡིན་པ འི་ ཕྱིར་ དང་ ༑བསྟན་བཅོས་ ཁོ་ན ས་ ཀྱང་ ལུང་སྡེ་བཞི འི་ དོན་བདེན་ བཞི ར་ བཀྲལ་ ཏེ་ ངེས་འབྱུང་ གི་ དབང་ དུ །གང་ འབྱུང་ ན་ གང་ཟག་ གམ་ ཀུན་འབྱུང༌ །གར་ འབྱུང་ ན་ མྱང་འདས་ སམ་ འགོག་པ །ཐབས་ཚུལ་ གང་ གིས་ འབྱུང་ ན་ འཕགས་ལམ་ དགག་སྒྲུབ་ ཀྱི་ བསླབ་པ འི་ ཚུལ་ གྱིས་ འབྱུང་བ འི་ ཕྱིར་ དང༌ །གནས་མལ་ གྱི་ གཞི་ ལས་སྒོ་ གདོད་ དུ་སྲིད་པ འི་ འཁོར་ལོ་ ཆ་ ལྔ་པ ར་ གསུངས་པ་ དང །ལུང་ ཡང་དགེ་སློང་ དག _། ང་ དང་ ཁྱེད་ཅག་ ཁོ་ན་ ལ ས །འཕགས་པ འི་ བདེན་པ་ བཞི་པོ་ དག །ཇི་ལྟ་བ་ བཞིན་ མ་ མཐོང་བ ས །།ཡུནརིང་ ལམ་ དུ་ ལཁོར་ བར་ འགྱུར །ཞེས་ དང༌ །སློབ་དཔོན་ ཀླུ་སྒྲུབ་ ཀྱིས །ཀཱ་ ཤི་ ཀ་ ཡི་ ཝཱ་ རཱ་ ཎ་ སཱི་ རུ །_།ཆོས་ ཀྱི་ འཁོར་ལོ་ རྣམ་གྲོལ་ རྨད་བྱུང་ བས །_།ཉོན་མོངས་ སྒྲིལ་པ་ རྣམ་པ ར་ གཅོད་ མཛད་པ འི །_།ཡེ་ཤེས་ མཆོད་རྟེན་ བཞི་ ལ་ ཕྱག་ འཚལ་ ལོ །ཞེས་ སོ །_།རིག་པ་ ཕ འང་ བདེན་ བཞི་ ལ ས་ གཞན་ འདུལ་བ་ མེད་པ ས་ སོ །རྡོ ༽༽_ གཞན་ བཞེད་པ་ཐེག་པ་ སྣ་ཚོགས་ སྟོན་པ་ བར་པ་ མཚན་ཉིད་ མེད་པ་ ངེས་དོན་ དང་འགའ་ཞིག་ གོན་ དང་ བཟང་པོ་ ལ་ ཤེས་པ ར་ བརྗོད་པ་ དང་པོ །བདེན་ བཞི་ བར་པ་ མཚན་ཉིད་ མེད་པ་ ངེས་དོན །ཐེག་པ་ སྣ་ཚོགས་ བསྟན་པ་ མ་ངེས་པ འི་ འཁོར་ལོ་ ཡིན་ ཟེར་ ཞིང༌ །ཕྱི་མ་ གཉིས་ ཀྱང་ ངེས་དོན་ མིན་ ཏེ་རྒྱུད་ བླ ར །སྤྲིན་ དང་ རྨི་ལམ་ སྒྱུ་མ་ བཞིན །དེ་ དང་ དེ ར་ སོགས་ ཀྱི་ དྲང་དོན་ ཡིན་མོད་འདི ར་ མགོན་པོ་ འབྲི་གུང་པ འི་ བཞེད་པ་ ནི་ཐེག་པ་ སྣ་ཚོགས་ ངེས་དོན་ འཁོར་ལོ་ སྟེ་རིམ་པ འི་ དབང་ གིས་ དང་པོ ར་ རྒྱུ་འབྲས་བར་པ ར་ སྟོང་པ་ཉིད་ དུ་ བསྟན་པ་ མཚན་ཉིད་ མེད་པ་ཐ་མ ར་ དེ འི་ སྟེང་ དུ་ སྟོང་ཉིད་ རྒྱུ་འབྲས་ སྣ་ཚོགས་ ལ་ འཇུག་པ །ལམ་སྣ་ ཚོགས་ སུ་ འབྱུང་བ་ ཐེག་པ་ སྣ་ཚོགས་ བསྟན་ ནས་ཐེག་པ་ གཅིག་ ཏུ་ གཏན་ ལ་ ཕབ་ སྟེ་དཀོན་མཆོག་ གསུམ་ རྟག་པ་ རྒྱུན་ མི་ ཆད་པ་ གཏན་ ལ་ ཕབ་པ འི་ ཕྱིར་ དང་ལུང་ ཡང་ དེ་བཞིན་ གཤེགས་པ འི་ སྙིང་པོ འི་ མདོ ར་ནོར་བུ་ བསྐྲུ་བ་ གསུམ་ཕྱི་བ་ གསུམ་ གྱི་ དཔེ་ སྙིང་པོ་ བསྟན་པ ར་ གསུངས་པ ས་ཐ་མ་ དེ་ ངེས་དོན་ དགོངས་པ་ ངེས་ འགྲེལ་ ལ ས་ ཀྱང་ ཐ་མ་ བླ་ ན་མ་ མཆིས་པ །སྐབས་ མ་ མཆིས་པ །ངེས་པ འི་ དོན་ རྩོད་གཞི ར་ མ་ གྱུར་པ ར་ གསུངས་ ཤིང༌ །བར་པ་ གཉིས་ བླ་ ན་ མཆིས་པ་ དང་ རྩོད་གཞི ར་ ཅན་ དུ་ གསུངས་པ འི་ ཕྱིར་ དང༌ །ཉམས་ལེན་ གྱི་ རིམ་པ་ མངོན་རྟོགས་ སྐྱེ་བ འི་ དབང་ གིས་ ཀྱང་ ཐ་མ་ ངེས་དོན་ དུ་ ངེས་པ་ ཡིན་ ནོ །_།འོ་ན་ ངེས་དོན་ སྟོང་ཉིད་ དྲང་དོན་ རྒྱུ་འབྲས་ ཡིན་ གསུངས་པ་ དང་ འགལ་ སྙམ་ ན །དེ་ ནི་ ཕྱོགས་ རེ་ཙམ་ ལྡོག་པ་ ནས་ གསུངས་པ་ མ་གཏོགས་ སྟོང་ཉིད་ རྒྱུ་འབྲས་ དབྱེ ར་ མེད །ཕྱི་མ་ ངེས་དོན་ ཏེ་ མཁའ་འགྲོ་ དྲྭ་བ འི་ ལེའུ་ ལ ས །གལ་ཏེ་ སྟོང་པ་ ཐབས་ ཡིན་ ན །དེ་ ནི་ སངས་རྒྱས་ ཐོབ་ མི་ འགྱུར །ཞེས་པ་ ཡིན་ ནོ །རྡོ ༽༽_ གཞན་དག་ ན་རེ །དྲང་དོན་ ངེས་དོན་དགོངས་ ཅན་ དགོངས་ མིན་སྒྲ་ ཇི་བཞིན་ ཇི་བཞིན་ མ་ཡིན་པ་ མཐའ་ དྲུག་ ལ ས༌དྲང་དོན་ དགོངས་ ཅན་ སྒྲ་ ཇི་བཞིན་ མ་ཡིན་པ་ གསུམ་ གནས་སྐབས་ ཐབས་ ཀྱི་ རྫུན་པ ར་ གསུངས་པ ས་ ངེས་དོན་ ཡིན་ ཟེར་ རོ །_།འདི ར་ ནི་ མཐའ་ དྲུག་ དགོངས་པ་ ངེས་པ འི་ དོན་ འབའ་ཞིག་ ཏེ་དེ་ ཁོ་ན་ཉིད་ དུ་ བཞེད་པ་ ཡིན་ ཏེ་འདི ར་ ནི་ སངས་རྒྱས་ ཀྱིས་ སེམས་ཅན་ འཁོར་བ་ ལ ས་ ཐར་པ འི་ ཐབས་ རྒྱུ་འབྲས་ རྟེན་འབྲེལ་ ལ་ ཇི་ལྟར་ ཡོད་པ་ དེ་ བསྟན་པ ས་སྟོན་ ལུགས་ ཇི་ལྟར་ མཛད་ ཀྱང་ ཐབས་མཁས་ མཐའ་ ཡས་ ཀྱི་ རྣམ་ རོལ་ ཡིན་པ ས་མཐའ་ དྲུག་ ཀ་ ལྷུན་གྲུབ་ བདེ་བ་ ཆེན་པོ ར་ འདྲེན་བྱེད་ ཀྱི་ གསུངས་ ཡིན་པ ས་དེ འི་ ངོས་ ནས་ ཐམས་ཅད་ དྲང་དོན་ ཡིན །གནས་སྐབས་ མཐར་ཐུག་ གི་ འབྲས་བུ་ འགྲུབ་ ཚུལ་འཁོར་བ འི་ སྡུག་བསྔལ་ གྱི་ བསྐྱེད་ ཚུལ་ རྣམས་བསླུ་མེད་ འབྲས་བུ་འབྱུང་ བར་ ངེས་པ འི་ ཕྱིར་ ངེས་དོན་ འབའ་ཞིག་ ཡིན་པ ས་དོན་ ལ་ དྲང་ ངེས་ ཐ་དད་ མེད་ དེ །_།ཟླ་བ་ སྒྲོན་མེ འི་ མདོ ར །གཞོན་ནུ་ ཁྱེད་ ལ་ བསྒོ་ ཞིང་ བསྟན་པ ར་ བྱ །དད་པ ར་ གྱིས་ ཤིག་ ང་ ལ་ མི་ བདེན་ མེད །བདེ་གཤེགས་ རྫུན་ གྱི་ ཚིག་ ནི་ མི་སྨྲ་ སྟེ །ཐུགས་རྗེ་ རྒྱལ་བ་ རྟག་ ཏུ་ བདེན་པ ར་ གསུང༌ །ཞེས་ དང་གསེར་འོད་ ལ ས་བདེན་པ་ སྟོན་པ་ མི་ བསླུ་བ་ ཞེས་ སོགས་ ལུང་ མཐའ་ ཡས་ སོ །_།དེས་ན་ ཐུགས་རྗེ་ དང་ རྟེན་འབྲེལ་ ཇི་བཞིན་ གཟིགས་པ་ དང་སེམས་ཅན་ ལ་ ཕན་བདེ་ སྒྲུབ་ ཕྱིར་ ངེས་དོན་ འབའ་ཞིག་ ཡིན་པ་ ལ་བདེན་རྫུན་ ཕྱེ་བ་ ནི་ མནར་མེད་ དུ་ སྐྱེ་ ང འི་ ལ ས་ གསོག་པ ས་ རྣ་བ་ བག་ ཡོད་ བྱ་ སྟེ་དེ་ཕྱིར་ མཐའ་ དྲུག་ དགོངས་པ་ ངེས་དོན་ འབའ་ཞིག་ བཞེད་ དོ །_།རྡོ ༽༽_ གཞན་དག་ ན་རེ །ཐེག་ཆེན་ དབུ་ སེམས་ གཉིས་ ཕར་ཕྱིན་ དང༌ །ཕལ་ཆེན་ སོགས་ སེམས་ ཙམ་ མདོ་ བཞི་ ལྟ་བུ་ འཀའ་ ཐ་དད །བསྟན་བཅོས་ ཀྱང་ བྱམས་པ ས་ དང་པོ ར་ མངོན་ རྒྱན་ རྒྱུད་ བླ །གཉིས་པ ར་ རྒྱན་ དང་ འབྱེད་ གཉིས་ མཛད་པ་ དང༌ །འཕགས་པ་ ཡབ་ སྲས་ ཀྱིས་ དབུ་མ འི་ དགོངས་འགྲེལ་ རིགས་པ འི་ ཚོགས་ དང༌ །ཐོགས་མེད་ སྐུ་མཆེད་ ཀྱིས་ སེམས་ ཙམ་ གྱི་ དགོངས་འགྲེལ་ མངོན་པ་ གོང་འོག་ ལྟ་བུ་མདོར་ན་ བཀའ་ བསྟན་ གང་ གི་ སྒོ་ ནས་ བརྟགས་ ཚེ་ དབུ་ སེམས་ ཐ་དད་ ཡིན་ ཟེར་ རོ །_།འདི ར་ ནི །_ སེམས་ ཙམ་ བཀའ་ ཡིས་ མཐའ་བྲལ་ དབུ་མ འི་ དོན་ སྟོན་ ཏེ་བཀའ་ དང་ བསྟན་བཅོས་ བླ་མ འི་ མན་ངག་ གསུམ་ གྱིས་ ངེས་ ཏེ །དང་པོ་ ནི་ ལང་ གཤེགས་ ལ ས །སེམས་ ཙམ་ དུ་ ནི་ རྟོགས་པ་ དང་ །དངོས་པོ་ ཐམས་ཅད་ རྣམས་ གསལ་བ །ཕྱི་རོལ་ རྟོག་པ་ རྣམས་ བཟློག་ སྟེ །ལམ་ དེ་ཉིད་ ནི་ དབུ་མ འོ །_།ཞེས་པ ས་ དང་ །གཉིས་པ་ ཡོད་མེད་ ཀྱི་ མཐའ་ གཟིགས་པ་སློབ་དཔོན་ འཕགས་པ་ དེ་ མདོ་ རྒྱུད་ ཉེར་ གཅིག་ ཏུ་ ལུང་བསྟན་ ཀྱང་ཕར་ཕྱིན་ དབུ་མ འི་ བཀའ་ ལ་མ་ བརྟེན་པ ར་ རྔ་བོ་ ཆེ་ ལང་ གཤེགས་ འཇམ་དཔལ་ རྩ་རྒྱུད་ སོགས་སེམས་ ཙམ་ གྱི་ བཀ ར་ ལུང་བསྟན་ ཅིང་ཆོས་འཁོར་ བསྐོར་བ ར་ འགྱུར་ རོ་ ཞེས་ གསུངས་པ ས་ལུང་བསྟན་པ འི་ གསུངས་ རབ་ དེ་གང་ཟག་ དེ ས་ སྐོར་ རྒྱུ འི་ ཆོས་ སུ་ འདོད་པ ས་ དང་ །གསུམ་པ་ མན་ངག་ ཡང་ སེམས་ ཙམ་ གྱིས་ ཆོས་ ཐམས་ཅད་ སེམས་ ནང་ དུ་ གཏན་ ལ་ ཕབ་པ་ ན །སེམས་ ཀྱང་ སྤྲོས་བྲལ་བ འི་ དབུ་མ་ ཡིན་ ཏེ །སེམས་ ཀྱི་ རང་བཞིན་ འོད་གསལ་བ་ ཞེས་ གསུངས་པ ས་ སོ ༑ལྷན ༽༽_ མཁས་པ་ གཞན་ གྱིས་ སངས་རྒྱས་ ཀྱི་ ཆོས་སྡེ་ སྣོད་ དུ་ བྱས་ ན་ལུང་སྡེ་བཞི་ འདུལ་བ འི་ སྡེ་སྣོད་ དེང་སང་ མདོ་ མང་ དུ་ གྲགས་པ་ འདི་ རྣམས་ མདོ་སྡེ འི་ སྡེ་སྣོད །མངོན་པ་ ལ་ གོང་འོག་ གཉིས་ ལ ས་གོང་མ་ ནི་ མུ་སྟེགས་ ཀྱི་ རྒན་མོ་ སྒྲ་མཁན་ དང་ སྤྲང་པོ་ ཉི་མ འི་ དངོས་གྲུབ །སྟག་ གཟིགས་ ཀྱི་ རྒྱལ་པོ་ གསུམ་ གྱིས་ བསྣུབས་པ ས་ བོད་ ན་ མི་ བཞུགས །གཉིས་པ་ སེམས་ ལ་ འཇུག་པ་ རྣམ་ཤེས་ ཚོགས །རབ་ཏུ་ རྣམ་འབྱེད །ཆོས་ ཀྱི་ ཕུང་པོ་ རུ་ གདཌ་པ །ཡང་དག་པ ར་ འགྲོ་བ་ སྟེ་བདུན་པོ་ དེ་ ཉན་ཐོས་ བདུན་ གྱིས་ མཛད་པ ས་ འོག་མ་ ཡིན་ གོང་མ་ ལོགས་ སུ་ མེད་ ཟེར་ རོ །འདི ར་ ནི་ ཐུན་མོང་ གི་ མདོ་ དང་ ཐུན་མོང་ མ་ཡིན་པ་ སེམས་ ཙམ་ སྟོན་པ འི་ མདོ་ རྣམས་ མངོན་པ འི་ སྡེ་སྣོད་ དུ་ བཞེད་ དོ །_།བདེན་ བཞི་ འདུལ་བ །མཚན་ཉིད་ མེད་པ་ མདོ་སྡེ །ངེས་དོན་ འཁོར་ལོ་ སྙིང་པོ འི་ མདོ་ སེམས་ ཙམ་ མདོ་ བཞི་ སོགས་ མངོན་པ་ གོང་འོག་ མ་ ཡིན་ ཏེ །རྒྱུ་མཚན་ མངོན་པ འི་ བསྟན་ དོན་ ལྷག་པ འི་ ཤེས་རབ་ ཡིན་ ན་དེ་ཉིད་ མཐར་ཐུག་ མེད་དགག་ གི་ སྟོང་ ཀྱང་ ཙམ་ དུ་ མིན་པ་ སྣང་སྟོང་ ཟུང་འཇུག་ ཆོས་སྐུ་ རྟག་པ་ རྒྱུན་ མི་ ཆད་པ་ སྟོན་པ ར་ ངེས་དོན་ འཁོར་ལོ་ ཡིན་པ འི་ ཕྱིར་ རོ །རྡོ ༽༽_ ལོག་པ འི་ ཀུན་རྫོབ་ ཆུ་ཟླ་ ལྟ་བུ ས་ དོན་ མི་ བྱེད་པ་སློབ་དཔོན་ ཕལ་ཆེ་བ་ འཞེད་ ཀྱང་འདི ར་ དེ་ཉིད་ ཀྱིས་ ཀྱང་ དོན་ བྱེད་ ནུས་པ ར་ འདོད་ དེ །ཆུ་ཟླ་ དང་ གཟུགས་བརྙན་ ལ་ ཡང་ རང་བཞིན་ གྲུབ་པ་ མེད་པ ར་ བརྟགས་ ན་བདེན་ མ་ མཐོང་ ཞིང་རྟོགས་པ ར་ བྱེད་པ འི་ སེམས་ དང༌ །དེ ས་ བསྒྲུབས་པ འི་ ལ ས་དེ འི་ རྣམ་སྨིན་ འབྱུང་ སྟེ་དྲིན་ལན་ བསབ་ མདོ ར་བཙུན་མོ་ རི་དྭགས་ མ འི་ བུ་ ལྔ་ བརྒྱ་ རྫིང་བུ ར་ རང་ གི་ གཟུགས་བརྙན་ ཤར་བ་ མཐོང་བ ས་ རང་ བྱང་ཆུབ་ ཐོབ་པ་ དང༌ །བྲམ་ཟེ་ ཆེན་པོ ས་ ཐོས་ ཆང་ དུ་ རྩི་ཤིང་ གི་ གཟུགས་བརྙན་ མཐོང་བ ས་ ཕྱག་ ཆེན་ རྟོགས་པ་ དང༌ །འདུལ་བ་ ལུང་ ལ ས་ཆུ་ ནང་ གི་ ཟླ་བ་ མཐོང་བ འི་ སྤྲེའུ་ ལྔ་ བརྒྱ་ ཤི་བ འི་ དོན་ བྱས་པ་ དང༌ །ཆུ་ཟླ་ དེ་ རྟེན་འབྲེལ་ ལ་ བབ་ ཀྱི་ མཐུན་པ ར་ཀུན་ ལ་ སྣང་བ་ དང་ནམ་མཁའ་ དང་ ཆུ འི་ རྒྱུ་རྐྱེན་ ལ ས་ སྐྱེས་པ ས་མཚན་ཉིད་ བཞི་ ཚང་བ ས་ ཁྱད་པར་ མི་ བྱེད །འོ་ན་ གང་ཡིན་ ན །ཉོན་མོངས་ མེད་པ་ སེམས་ དགེ་བ ས་ བསླང་ ཞིང་ལ ས་ སྒྲུབ་པ་ རྣམ་སྨིན་ དང་ བཅས་པ་ ཡང་དག _།དེ་ལས་ ལྡོག་པ་ ལོག་པ འི་ ཀུན་རྫོབ་ སྟེ །སློབ་དཔོན་ ཀླུ ས །ཡང་དག་ ཀུན་རྫོབ་ རྣམ་ གཉིས་ སྐས །སོགས་ དང་ །ཞི་བ་ལྷ ས །ཡན་ལག་ འདི་དག་ ཐམས་ཅད་ ནི །ཐུབ་པ ས་ ཤེས་རབ་ དོན་ དུ་ གསུངས །ཞེསསོ །རྡོ ༽༽_ ཁ་ཅིག་ ན་རེ །་མཚན་ཉིད་ ཐེག་པ འི་ ལམ་ ས་བཅུ ས་ བགྲོད་ ཀྱང་སྔགས་ལམ་ གཅིག་ ཆ ར་ བས་ དེ་ འགྲོད་ མི་ དགོས་ ཏེ་དེ་ལས་ གཞན་ ཞིག་ ཡིན་ ཟེར་ མོད །འདི ར་ ནི །ཇི་སྙེད་པ འི་ ལམ་ རྣམས་ ས་བཅུ་པོ་ ནས་ བགྲོད་པ་ ཡིན་ སྟེ་མདོ་སྔགས་ གང་ཡང་ ས་ དང་པོ་ མཐོང་ལམ་ ནས་ ས་རིམ་ བཞིན་ བགྲོད་ དེ་ས་བཅུ འི་ རྒྱུན་མཐའ་ ལ་ ཤེས་སྒྲིབ་ ཆེ་ཆུང་ དང་སྔོན་ གྱི་ སྦྱང་པ་ ཡོད་མེད་ ཀྱི་ བགྲོད་ མྱུར་ མི་ མྱུར་ ཡང་ གཉིས་ཀ ར་ ཡོད་ དེ་མཚན་ཉིད་ ལ་ ཡང་གསང་ ཆེན་ ཐབས་ ལ་ མཁས་པ་ ལ ས །བྱང་སེམས་ དགའ་བྱེད་ ས་ དང་པོ འི་ དུས་ སུ་ཉོན་མོངས་པ འི་ འདུག་ལུགས་ མཐོང་བ ས་ས་ བརྒྱད་པ་ ཐོབ་པ་ དང༌ །སྔགས༌ ལ་ སློབ་དཔོན་ རྒྱལ་པོ་ ཚེ་ གཅིག་ སངས་རྒྱས་ ཐོབ་པ་ ཡང་འོག་མ་ མ་ བགྲོད་པ་ གོང་མ ར་ ཕྱིན་ ཕ་ མིན་ ཏེ་ཨུཏྤ་ ལ འི་ འདབ་མ་ འརྩེགས་པ་ ལ་ ཁབ་ ཀྱིས་ བསྙུན་པ་ བཞིན་ ནོ །_།དེ་ནས་ རིང་ དུ་ ཚོགས་ བསགས་པ་ དང་ ཉེ་ རྒྱུ་ བརྩོན་འགྲུས་ དང༌ །བླ་མ འི་ བྱིན་རླབས་ འཛོམ་ ཚེ་ གོང་མ་ ཐབས་ བྱུང་ དུ་ སྐྱེ་བ་ ཡིན་ ཞིང་ །ཐབས་ ཁྱད་ ཙམ་ ལ ས་ སངས་རྒྱས་ ཀྱི་ རྒྱུ་ དང་ འབྲས་བུ་ སྒྲུབ་པ ར་ གཅིག་ གོ །རྡོ ༽༽_ གཞན་ འདོད་ ལ་ལ འི་ ལམ་ མངོན་པར་ རྟོགས་པ་ སྐབས་གདངས་ ལྟར་ རིམ་གྱིས་ བགྲོད་པ་ སློབ་དཔོན་ འཕགས་པ་ ལྟ་བུ་ དང་ །གཉིས་ ཆ ར་ དུ་ བགྲོད་པ་ བྲམ་ཟེ་ ཆེན་པོ་ ལྟ་བུ་ གཉིས་ ཡོད་ ཟེར་ ལ །འདི ར་ ནི་ དེ་ཡང་ རིམ་གྱིས་ འཇུག་པ་ ཁོ་ན ར་ ངེས་ ཏེ །མཚན་ཉིད་ ཐེག་པ་ ལྟ་ ཞོགས་ སྔགས་ ལ འང་ཀྱེེཻ_རྡོ་ རྗེ་ ལ ས །དང་པོ ར་ གསོ་སྦྱོང་ བསྟན་པ ར་ བྱ །དེ་ རྗེས་ བསླབ་ སོགས །ཅེས་པ འི་ ལུང་ དང་ རིམ་གྱིས་ མ་ བགྲོད་པ་ གཅིག་ ཆ ར་ མི་ སྲིད་པ་ ནི་སྔར་ གྱི་ ཨུཏྤ་ ལ འི་ དཔེ ས་ བསྟན་པ ས་ ན་རིམ་ གྱིས་ ངེས་ སོ །_།ཞེས་ གསུངས་པ་ དེ་ ཅི་ ཞེ་ན །དེ་ལྟར་ ན་ མཚན་ཉིད་ ལ་ ཡང༌ །མཁྱེན་པ འི་ སྐད་ཅིག་ གཅིག་ གིས །_།ཤེས་བྱ འི་ འཁོར་ལོ་ ཀུན་ཁྱབ་ ཅན །ཞེས་ སྐད་ཅིག་ གཅིག་ གིས་ རྣམ་པ་ ཐམས་ཅད་ མཁྱེན་པ་ བརྙེས་པ ས་ ན་ མཚུངས་ སོ །_།གྲངས་མེད་ གསུམ་ དུ་ ཚོགས་ བསགས་པ ས་ མི་ མཚུངས་ སྙམ་ ན །སྔགས་ ལ་ ཡང་ ཚོགས་ བསགས་ སྔོན་ དུ་ སོང་བ ས་ ཡིན་ གྱི །གཞན་ དུ་ ན་ རྒྱུ་ མེད་པ ས་ འབྲས་བུ་ ཁ ས་ ལོངས་ ཤིག་ གོ །རྡོ ༽༽_ མཁྱེན་པ འི་ ཡེ་ཤེས་ ལ་སྒྲིབ་བྱེད་ ལ ས་ ཉོན་ ཤེས་བྱ འི་ སྒྲིབ་པ་ གསུམ་ ལ་རིམ་བཞིན་ ལ ས་ རྒྱུ་འབྲས་ ལ་ རྨོངས་པ་ཀུན་བརྟགས་ ལྷན་སྐྱེས་ སམ་དེ་ཉིད་ ལ་ རྨོངས་པ འི་ མ་རིག་ གསུམ་ ཟེར །སྤོང་ ཚུལ་ རིམ་བཞིན་ས་ དང་པོ་ མན་ངག་ དང་ །འདུན་པ་ ཡན་ དང་ །ས་བཅུ འི་ རྒྱུན་མཐ ར་ ཤེས་སྒྲིབ་ སྤོང་བ་ ངེས་ ཟེར །འདི ར་ ནི་ ཤེས་བྱ འི་ སྒྲིབ་པ་ ཐོག་མ ར་ སྤོང་བ འང་ ཡོད་ དེ་རྗེ་བཙུན་ མི་ལ ས་ དྭགས་པོ་ ལ་ང་ ནི་ ཤེས་སྒྲིབ་ སྔོན་ དུ་ སྤོང་བ ར་ འདོད་པ་ ཡིན་ གསུངས་པ་དེ འི་ རྒྱུ་མཚན་ ལ་བླ་མ ས་ སློབ་མ ར་ གདམས་ངགརྗེས་ བསྟན་ གནང་ ནས་ སྒོམ་པ ས་ ལ ས་ ཉོན་ གྱི་ སྒྲིབ་པ་ སྤོང་བ འི་ མངོན་རྟོགས་ སྐྱེ་ དགོས །དེ་ སྐྱེ་བ ར་ ལྷན་སྐྱེས་ ཀྱི་ མ་རིག་པ་ སྤོང་ དགོས་ ཏེ་རྟོགས་ བྱ ར་ སྒྲིབ་པ་ ཤེས་ སྒྲིབ_ཡིན་པ ས་ སོ །_།དེ་ཕྱིར་ དབང་རྣོན་ ཁ་ཅིག་ ཤེས་སྒྲིབ་ སྔོན་ ལ་ སྤོང་བ འང་ ཡོད་ དོ །རྡོ ༽༽_ གཞན་དག་ ན་རེ །ཚད་མ་ རིགས་ བྱེད་ དང་ ཐུན་མོང་ དུ་ གྱུར་པ་ ཕྱི་རོལ་ རྩོད་པ་ ཟློག་ ཕྱིར་ ལ ས་སངས་རྒྱས་ ཀྱི་ ཆོས་ སུ་ མི་འགྱུར་བ་ འདོང་པ འང་ ཡོད་ མོད །འདི ར་ ནི་ ཚད་མ འི་ དོན་ མི་ བསླུའི་ ཤེས་པ ར་ ཟེར་དེ་ ནི་ སངས་རྒྱས་ ཀྱི་ མཁྱེན་པ འི་ ཡེ་ཤེས་ ཉག་གཅིག་ ཡིན་ ཏེ །ཕུང་པོ་ གསུམ་པ་ ལ ས །ཡེ་ཤེས་ སུ་ གྱུར་པ །སྤྱན་ དུ་ གྱུར་པ །དབང་ དུ་ གྱུར་པ །ཚད་མ ར་ གྱུར་པ་ ཞེས་ དང༌ །ཕྱོགས་གླང་ གིས །ཚད་མ ར་ གྱུར་པ་ འགྲོ་ ལ་ ཕན་ བཞེད་པ །_།སྟོན་པ་ བདེ་བ ར་ གཤེགས་ ལ་ ཕྱག་ འཚལ་ ལོ །_།ཞེས་ དང་ །ཆོས་གྲགས་ རྣམ་ ངེས་ ལ ས །ཕན་པ་ དང་ མི་ ཕན་ཐོབ་པ་ དང་ སྤོང་བ་ ནི་ངེས་པར་ ཡང་དག་པ འི་ ཤེས་པ་ སྔོན་ དུ་ འགྲོ་བ་ ཅན་ ཡིན་པ ས་དེ་ མི་ ཤེས་པ་ རྣམས་ ཀྱི་ དོན་ དུ་ འདི་ བརྩམ་ མོ་ ཞེས་པ ས །གནས་སྐབས་ དོན་ དང་ ལྡན་པ འི་ བློ་ ཅུང་ཟད་ སྐྱེ་བ་ ནས་བཟུང་ མཐ ར་ སྐྱོན་བྲལ་ ཡོན་ཏན་ རྫོགས་པ འི་ སངས་རྒྱས་ ཐོབ་པ་ མན་ཆད་ ཡང་དག་པ འི་ ཤེས་པ ས་ འགྲུབ་ སྟེ །སྟོབས་ བཅུ་ མཁྱེན་པ འི་ ཡེ་ཤེས་ དེ་ཡང་ དག་ གི་ ཤེས་པ་ ཡིན་པ འི་ ཕྱིར་ རོ །རྡོ ༽༽_ ལ་ལ་ དག་ གིས་རྟོག་གེ་ ཚད་མ་ ནི་ གྲུབ་མཐའ་ དན་པ་ སུན་ འབྱིན་ བྱེད་ལས་འབྲས་ བུ་ མེད་ དེ་ རྗེ་བོ ས །མངོན་སུམ་ རྗེས་དཔག་ དགོས་པ་ མེད་ ༑མུ་སྟེགས་ རྒོལ་བ་ བཟློག་པ འི་ ཕྱིར །མཁས་པ་ རྣམས་ ཀྱིས་ བྱས་པ་ ཡིན །ཞེས་ འགའ་ཞིག་ ཟེར་ རོ །_།འདི ར་ ནི་ ཚད་མ འི་ འབྲས་བུ་ ཟབ་མོ་ སྟོང་པ་ཉིད་ སྟོན་ ཏེ་དེ འང་ ཚད་མ་ ལ་ གཞལ་བྱ་ ཡུལ །འཇལ་བྱེད་ བློ །དེ་ རྟོགས་ བྱེད་ཐབས་ གསུམ་ དུ་ འདུ་ ཞིང་ཡུལ་ དང་ ངོ་བོ འི་ སྒོ་ ནས་ དངོས་ དང་ དངོས་མེད །འདུ་ བྱས་ འདུ་ མ་ བྱས །ལྐོག་གྱུར་ ཤིན་ཏུ་ ལྐོག་གྱུར་ གསུམ་འཇལ་བྱེད་ བློ་རིག་ ཤེས་ གསུམ་ དོན་ གཅིག་ ཅིང་དེ འང་ མངོན་ གསུམ་ རྗེས་དཔག་ གཉིས །མངོན་སུམ་ ལ་ དབང་ ཡིད་ རང་རིག་ རྣལ་འབྱོར་ མངོན་སུམ །རྗེས་དཔག་ ལ །_ དངོས་ སྟོབས་ གྲགས་པ་ ཡིད་ ཆོས་ གསུམ་རྟོགས་ བྱེད་ འགལ་ འགྲེལ་ དགག་སྒྲུབ་ སྤྱི་བྱེ་ བྲག་ གཅིག་ ཐ་དད་ སེལ་འཇུག _།སྒྲུབ་འཇུག་ གཞན་སེལ །_ མཚན་ མཚོན །_ རྫས་ ལྡོག _། རྗེས་དཔག་ གཉིས་ དང་ བཅས་པ་ ནི་ ཚད་མ འི་ བརྗོད་བྱ་ སྟེ །རང་དོན་ རྗེས་དཔག་ ཚུལ་ གསུམ་ ཚང་བ འི་ རྟགས་ ཏེ །བདེན་པ ར་ འཛིན་པ འི་ དངོས་པོ་ ཆོས་ཅན །བདེན་པ འི་ སྐྱེ་བ་ མེད་ དེ །གཅིག་ དང་ དུ་མ་ ཕྲལ་བ འི་ ཕྱིར །དཔེར་ན་ གཟུགས་བརྙན་ བཞིན །ཞེས་པ ས་ རང་བཞིན་ མ་གྲུབ་པ འི་ གནས་ཚུལ་ སྟོང་ཉིད་ སྟོན་པ་ ཡིན་ ནོ །_།དེ་སྐད་ དུའང་ རྣམ་འགྲེལ་ ལ ས །གང་ གི་ དངོས་པོ་ རྣམ་དག་ ན །དེ་ཉིད་ དུ་ ནི་ དེ་ དངོས་མེད །གང་ གི་ ཕྱིར་ ན་ དེ་དག་ ལ །_།གཅིག་ དང་ དུ་མ འི་ རང་བཞིན་ མེད །ཅེས་ དང་ །རྟོག་པ འི་ དྲྭ་བ་ རྣམ་ བསལ་ ཅིང༌ །_།ཟབ་ ཅིང་ རྒྱ་ ཆེ འི་ སྐུ་ མངའ་བ །_།ཀུན་ ཏུ་ བཟང་པོ འི་ འོད་ཟེར་ དག _།ཀུན་ ནས་ འཕྲོ་ ལ་ ཕྱག་ འཚལ་ ལོ ༑_།ཞེས་པ ས །ཚད་མ་ ལ་ འབྲས་བུ་ ཡོད་པ་ གྲུབ་ སྟེ་ །རྣལ་འབྱོར་ མངོན་སུམ་ དེ་ མཐོང་ ལ ས་ གྱི་ བདེན་པ་ ཡིན་པ འི་ ཕྱིར་ རོ །རྡོ ༽༽_ སྤྱིར་ སེམས་ཅན་ ཐ་མལ་པ་ དང་ གྲུབ་མཐ ས་ བློ་བསྒྱུར་བ་ གཉིས །ཕྱི་མ ར་ ཕྱི་རོལ་པ འི་ ལྟ་བ་ བསྡུ་ ན་ རྟག་ཆད་ གཉིས །ནང་པ ར་ ཐེག་དམན་ དོན་ སྨྲ་ སྡེ་གཉིས །ཐེག་ཆེན་ སེམས་ ཙམ་ དབུ་མ་ གཉིས་ ལ ས་ཕྱི་རོལ་པ འི་ གྲུབ་མཐའ་ དེ་དག་ རྒྱ་གར་ ན་ ཡོད་ བོད་ ལ་ མེད་ ཟེར །འདི ར་ ཇི་སྲིད་ གྲུབ་མཐའ་ ཁ་ བཟང་ངན་ གྱི་ འཛིན་ ཡོད་པ་དེ་སྲིད་ དུ་ ལྟ་ངན་ དེ་ ཐམས་ཅད་ རང་རྒྱུད་ དུ་ཡོད་པ་ ཡིན་ ཏེ་ང་ ནི་ ཕ་ འདི འི་ བུ་ ཡིན་ ཞེས་ གྲུབ་ གྲུབ་ ཏུ་ འཛིན་པ་རྟག་ལྟ་ རྒྱུ་འབྲས་ ཀྱི་ སྐྱོན་ཡོན་ དགེ་སློང་ ནག་པོ་ ལ་ བྱ་རོག་ ཞར་ མ་ བཞིན་ ནོ །_།བྱས་པ ས་ བྱ་རོག་ ཞར་ མ འི་ སྐྱེ་བ་ ལྔ་ བརྒྱ་ ལེན་པ ར་ གསུངས་པ་ དང༌ །སངས་རྒྱས་ ཀྱི་ མཚན་ དང་ ཆོས་ ཐོས་པ་ ཙམ་ གྱི་ ཡོན་ཏན་ དཔག་མེད་ འབྱུང་བ ར་ གསུངས་པ་ རྣམས་ ལ་དེ་ཙམ་ ཅི་ ཡིན་ སྙམ་ ནས །ཡིད་ མི་ ཆེས་པ་ ཆད་ལྟ་ ཡིན་པ ས་ མུ་སྟེགས་ བྱེད་ རང་ཉིད་ ཡིན །གཉིས་པ་ ཉན་ཐོས་ ནས་ མ་བུ་ ཆེན་པོ འི་ བར་ གྱི་ གྲུབ་མཐ ར་ དེ་ འཛིན་ གྱི་ བར་ཡང་དག་ དོན་ ལ་ རྨོངས་པ་ ནང་ གི་ མུ་སྟེགས་ ཡིན་ ཏེ །དགེ་བ འི་ རྩ་བ་ འཛིན་པ འི་ མདོ ར །བསྐལ་པ་ བྱེ་བ་ ཚུལ་ཁྲིམས་ བསྲུངས་ བྱས་ ཤིང་ ཡུན་རིང་ སོཊ ། རྩད་ ནག་པ ས །མཆོག་ ལ་ སྐྱབས་ སོང་ འགྲོ་ ལ་ ཕན་ བརྩོན་ ཡང༌ །གང་ཟག་ རྡུལ་ དང་ སྐད་ཅིག་ རྫས་ སྨྲ་ དང༌ །འཇིག་ དང་ སྟོང་ དང་ དོན་དམ་ མཚན་མ ར་ བཀྲ་ །_།ཡང་དག་ དོན་ ལ་ གང་ གི་ མུ་སྟེགས་ ཡིན །ཅེས་ སོ །རྡོ ༽༽_ ལོག་ལམ་ མུ་སྟེགས་པ འི་ ལྟ་སྤྱོད་ སྒྲུབ་པ་ ཐམས་ཅད་ སྤང་བྱ་ འབའ་ཞིག་ ཡིན་ ཏེ་ལོག་པ འི་ ལམ་ ལ་ བསྒྲུབ་བྱ་ མེད་པ འི་ ཕྱིར་ རོ་ ཞེས་ ཟེར་ མོད །འདི ར་ ནི་ མུ་སྟེགས་པ་ ལ འང་ གཤིས་ ཀྱི་ དགེ་བ འི་ བསྒྲུབ་བྱ་ མང་ ཏེ་དེ་དག་ ལ་ སྙིང་རྗེ་ ཡོད་ ལ ས་སྲོག་གཅོད་ སོགས་ མི་དགེ་བ་ བཅུ་ ལ ས་ དགུ་ དངོས་ སུ་ སྤོང་བ འི་ ཕྱིར་ དང༌ །དབྱར་ ག་ ནས་ གསོ་སྦྱོང་ དགག་དབྱེ་ རྣམས་ དང་པོ ས་ སོ །_།ནང་པ་ ལ་ མེད་པ ས་ སངས་རྒྱས་ ཀྱིས་ དགེ་སློང་ དག་མུ་སྟེགས་ ཀྱི་ འཕྱ་བ་ ནི་ ཐོག་ ཏུ་ འབབ་པ་ ཡིན་པ ས་ཕྱིན་ཆད་ འདི་ རྣམས་ བྱ འོ །_།གསུངས་ ཏེ་ བཅས་པ་ མཛད་པ་ དེ་ སྒྲུབ་ དགོས་པ འི་ ཕྱིར་གཤིས་ ཀྱི་ དགེ་བ་ ལེགས་པ་ ཞིག་ མུ་སྟེགས་ སམ་ དུད་འགྲོ འི་ རྒྱུད་ ལ་ ཡོད་ ཀྱང་ ལེན་ དགོས་ ཏེ་ ༑མཐའ་ ཡས་ ཡོན་ཏན་ དཔག་མེད་ ཀྱང་ །_།གཞན་ གྱི་ ཡོན་ཏན་ ཆུང་ངུ་ ལེན །_།དེ་ལྟར་ ཡུན་ དུ་ སྤྱད་པ་ ཡིས །_།མྱུར་ དུ་ ཐམས་ཅད་ མཁྱེན་པ ར་ འགྲོ །_།གཤིས་ ཀྱི་ ཉེས་པ་ ཞིག་ མཐོ་བ་ བླ་མ འི་ ཐུགས་རྒྱུད་ དུ་ཡོད་ ཀྱང་ དོར་ དགོས་ ཏེ །ཏཱ་ལ འི་ རྒྱུད་ ལ ས །དགེ་སློང་ དག་ གམ་ མཁས་ རྣམས་ ཀྱིས །_།སྲེག་ བཅད་བརྡར་བ འི་ གསེར་ བཞིན་ དུ །ལེགས་པ ར་ཞེས་ སོ ༑།ལྷན ༽༽_ ལ་ལ་ དག་ མུ་སྟེགས་ བོན་ གྱི་ ཐུབ་པ་ ཆེན་པོ་ ལྟ་བུ་ ཐོབ་པ ར་ མི་ ནུས་ ཀྱང་ཆོས་ཉིད་ ཀྱི་ བདེན་པ་ མཐོང་བ་ ཡོད་ ཟེར །འདི ར་ ནི་ མུ་སྟེགས་ བོན་ གྱི་ གྲུབ་མཐའ་ འཛིན་པ་ ཆོས་ཅན །བདེན་པ་ མཐོང་བ འི་ སྐབས་མེད་ དེ་ལོག་ལམ་ ཡིན་པ འི་ ཕྱིར །དེ འང་ མཆོག་ གསུམ་ ལ་ སྐྱབས་ སུ་ མི་ འཛིན་ འཕགས་ལམ་ དང་ བྲལ་བ འི་ བདེན་པ་ མི་ མཐོང་ སྟེ །ཕྲན་ ཚེག་ ལ ས །རབ་ བཟང་ གང་ཡང་ འཕགས་པ འི་ ལམ་ ཡན་ལག་ བརྒྱད་པ་ མི་སྣང་བ་དེ་ ལ་ དགེ་སྦྱོང་ ཡང་ མེད་ དོ །_།ཅེས་ དང༌ །ཆོས་སྐྱོབ་ ཀྱིས །ནམ་མཁའ་ ལ་ ནི་ བྱ་རྗེས་ བཞིན །_།ཀུན་ ཏུ་ རྒྱུ་ལ་ དགེ་སྦྱོང་ མེད །ཅེས་ དང་ ཤེས་ སྤྲིང་ ལ ས །གང་ཟག་ ལོག་པ ར་ ལྟ་བ འི་ ལེགས་བྱས་ ཀྱང་ །ཐམས་ཅད་ རྣམ་པ ར་ སྨིན་པ་ མི་ཟད་ ལྡན །ཞེས་ སོ །དེ་བཞིན་ དུ་ བརྡོལ་བོན་ འགྱར་ བོན་ བསྒྱུར་བོན་ རྣམས་ ཀྱང་ རོ །ལྷན ༽༽ ཡང་ དགའ་ ཞིག་ གིས་བདེན་ མཐོང་ ལྟ་ཅི་ ཐར་པ་ ཆ་ མཐུན་ ཙམ་ ཡང་ མེད་ ཟེར་ ལ །འདི ར་ ནི་ དེ་དག་ ཐར་པ འི་ ཆ་ དང་ མཐུན་པ འི་ དགེ་བ་ འགའ་ཞིག་ ཡོད་ ཀྱང་ རུང་ སྟེ་དེ འང་ ཆ་ མཐུན་ ནི་ མཐོ་རིས་ ཀྱི་ བདེ་བ ར་ དམིགས་པ འི་ ལ ས་ བསོད་ནམས་ ཆ་ མཐུན །མྱང་འདས་ ལ་ དམིགས་པ འི་ ཐར་པ་ ཆ་ མཐུན །ངེས་འབྱེད་ ཆ་ བཞི་ འཇིག་རྟེན་པ འི་ བསྒོམ་པ་ ལ ས་ སྐྱེས་པ་ཆོས་ཉིད་ སྟོང་པ་ གསལ་བ་ དང་པོ ར་ རྟོགས་པ་ དྲོད་ དེ་ འཕེལ་བ་ རྩེ་མོ །དེ་ བརྟན་པ་ བཟོད་པ་ དེ་རབ་ ཀྱི་ མཐར་ཐུག་ ཆོས་མཆོག་ སྟེ་ གསུམ་ ལ ས་ཐར་པ་ ཆ་ མཐུན་ སྙིང་རྗེ་ དང་ དབྱར་གནས་ སོགས་ སྔར་ བཤད་པ་ ལྟར་ རོ །རྡོ ༽༽_ ཕྱི་ ནང་ གི་ ཁྱད་པར་ ཕྱག་རྒྱ་ བཞི་ དང་ ལྟ་བ་ དང་ སྤྱོད་པ་ དང་ སྙིང་རྗེ་ དང་ བདག་ འཛིན་ ཡོད་མེད་ ཀྱི་ འབྱེད་པ་ མི་མཐུན་པ་ མང་ དུ་ སྣང་ མོད །འདི ར་ ནི་ ཕྱི་ ནང་ ཁྱད་པར་སངས་རྒྱས་ ཆོས་ དགེ་འདུན་ ལ་ སྐྱབས་ སུ་ འགྲོ་བ ས་ འབྱེད་པ་ སྟེ་གཞན་ གང་ གིས་ མིན་ ནོ །། དེ་དག་ གིས་ མི་ ཕྱེད་ དེ་ཆད་ལྟ ས་ འདུས་བྱས་ མི་རྟག་པ་ དང་ །འཁོར་བ་ སྡུག་བསྔལ་ དུ་ མཐོང་བ་ དང་ །སྟོང་པ་ ཆལ་ ཆད་ དུ་ ལྟ་བ་ དང་ལུང་ མ་ བསྟན་ བཅུ འི་ ཡ་གྱལ་ མཐའ་ ཡོད་མཐའ་ མེད་པ ས་ དབུ་མ་ དང༌ །དགེ་ བཅུ་ སྤྱོད་པ་ དང་ །སྙིང་རྗེ ས་ རྐང་པ ར་ དྲིལ་གཡེར་ འདོགས་པ་ རྣམས་ ཕྱི་རོལ་པ་ ལ་ ཡོད་པ འི་ ཕྱིར་ དང་ནང་པ ར་ ཡང་ བྲམ་ཟེ་ རྒྱལ་བ འི་ དྲོད་ ཀྱི་ མེ་ ལྔ་ བརྟེན་པ་ དང་ །གནས་མ་ བུ འི་ སྡེ་ བས་བདག་ རྫས་ གྲུབ་ ཏུ་ འདོད་པ་ སོགས་ ཡོད་པ འི་ ཕྱིར་ རོ །_།འོ་ན་ ཅི་ ཞེ་ན ༑ཇོ་བོ ས་ སྐྱབས་འགྲོ འི་ ཕན་ཡོན་ དུ་ནང་པ ར་ ཚུད་པ ར་ འགྱུར་བ་ ཞེས་པ ས་དེ་ ཡོད་ ན་ རྒྱུ་མཚན་ གནག་རྫི་ ལྟ་བུ འང་ ནང་པ་ ཡིན །མེད་ ན་ པཎྜི་ཏ་ ལྟ་བུ་ ཡང་ཕྱི་ རོལ་པ་ ཡིན་པ་ དེ འི་ ཕྱིར་ རོ །_།ལྷན ༽༽_ ཕྱི་པ ར་ སྡོམ་ དང་ སྙིང་རྗེ་ མེད་ དེ་ལྟ་ བསྒོམ་ སྤྱོད་པ་ འབྲས་བུ་ ལོག་པ འི་ ཕྱིར་ནང་པ ས་ སྤང་པ ར་ བྱ་བ་ འབའ་ཞིག་ ཡིན་ ཟེར་ ཡང༌ །འདི ར་ སྡོམ་ དང་ སྙིང་རྗེ་ ཙམ་ ཕྱི་རོལ་པ་ ལ འང་ ཡོད །དེ་ སྲོག་གཅོད་ སྤོང་བ ར་ རྐང་པ ར་ དྲིལ་བུ་ འདོགས་པ་ སྦྱིན་ལེན་ ན་ཆུ་ མི་ འཐུང་བ་ འདོད་ཆགས་ སྐྱེས་ ཀྱི་ དོག་ ན་ འགྲོགས་ སྟེ་ འདུག་པ །རྫུན་ བསྲུང་བ ར་ མི་སྨྲ་བ་ སྟེ་བརྟུལ་ཞུགས་ ཀྱིས་ མི་དགེ་བ་ སྤོང་ ཞིང་ དགེ་བ་ སྤྱོད་པ་ དང་ སྙིང་རྗེ་ དེ་ལྟར་ ཡོད་པ ས་ སོ །རྡོ ༽༽_ ཐེག་པ་ ཆེ་ཆུང་ གི་ ཁྱད་པར་རིགས་ལམ་ འབྲས་བུ་ ལྟ་སྤྱོད་ སྙིང་རྗེ་ སེམས་ཅན་ གྱི་ དོན་ རྣམས་ ཡོད་མེད་ མཆོག་ དམན་ གྱིས་ འབྱེད་ ཟེར །འདི ར་ ནི་ ཐེག་པ་ ཆེ་ཆུང་ གི་ ཁྱད་པར་ སེམས་བསྐྱེད་ ཡིན་ ཏེ །གཞན་དོན་ འཁོར་བ ར་ གནས་ ཀྱང་ ནི །_།སྙིང་རྗེ་ ཅན་ དག་ཅི་ སྟེ་ སྐྱོ ༑འདི་ ནི་ བྱང་ཆུབ་ སེམས་ སྟོབས་ ཀྱིས །_།སྔོན་ གྱི་ སྡིག་པ་ ཟད་ བྱེད་ ཅིང་ །_།བསོད་ནམས་ རྒྱ་མཚོ་ བསྡུད་ བྱེད་ ཕྱིར །ཉན་ཐོས་ རྣམས་ ལ ས་ མཆོག་ ཏུ་ བཤད །_།དེ་བ ས་ སྐྱོ་ངལ་ ཀུན་ སེལ་བ འིབྱང་ཆུབ་ སེམས་ ཀྱི་ རྟ་ ཞོན་ ནས །_།བདེ་ ནས་ བདེ་བ ར་ འགྲོ་བ་ ལ །_།སེམས་ཤེས་ སུ་ཞིག་ སྒྱིད་ ལུགས་ འགྱུར་ ༑_།ཞེས་ གསུངས་པ་ འཞིན་ སྙིང་རྗེ ས་ གཞན་དོན་ ཕྱིར་དུ་བྱང་ཆུབ་ འདོད་པ འི་ སེམས་བསྐྱེད་ ཀྱིས་ འབྱེད་པ་ ལ ས་ གཞན་ གྱིས་ མིན་ ནོ །རྡོ ༽༽_ མདོ་ དང་ སྔགས་ ཀྱི་ ཁྱད་པར་ལམ་ བདེ་བ་ དུས་ མྱུར་བ་འབྲས་བུ་ ལམ་ བྱེད་ དེ་ ལམ་ དང་ འཇུག་པ་འབྲས་བུ་ བདེ་བ ས་ འབྱེད་ ཟེར་ ཡང་འདི ར་ ནི་ དབང་ གིས་ ཡིན་ ཏེ་ འཇམ་དཔལ་ རྩ་རྒྱུད་ ལ ས །གང༌ཞིག་ དཀྱིལ་འཁོར་ མ་ མཐོང་བ ར །རྣལ་འབྱོར་པ་ ནི་ དངོས་གྲུབ་ འདོད །མཁའ་ ལ་ ཁུ་ཚུར་ གྱིས་ བརྡེག་ དང་ །སྨིག་རྒྱུ འི་ ཆུ་ ནི་ འཐུང་ དང་ མཚུངས །ཞེས་པ་ དབང་ བཞི་ དང་ །དེ་ལས་ ཀྱང་ དུམ་ དབང་ གིས་ འབྱེད་པ་ ཡིན་ ཏེ་གཞན་ རྣམས་ མཚན་ཉིད་ ལ འང་ ཡོད་གསེར་མདོག་ དང་ ཆོས་ འཕགས་ ན་རེ་ རྟག་ ཏུ་ དུ་ བཞིན་ ནོ །ལྷན ༽༽_ མཚན་ཉིད་ ཐེག་པ ས་ གྲས་ མེད་ གསུམ་ གྱིས་ སངས་རྒྱས་པ ར་ འདོད་ མོད །འདི ར་ ནི་ ཚེ་ གཅིག་ གིས་ འཚང་རྒྱ་བ ར་ ཡོད་ དེ །བསོད་ནམས་ དང་ བརྩོན་ འགྲུས_བླ་ མ་ མཚན་ལྡན་ སོགས་ ཚོགས་པ་ ཚང་ ན་ཚེ་ གཅིག་ འཚང་ རྒྱ །མ་ ཚོགས་ ན་ གསང་སྔགས་ ཀྱིས་ ཀྱང་ སངས་ མི་ རྒྱ་ སྟེ ༑ཞུས་ ལན་ ཚིག་ བཅད་ མ་ལ ས །འདི་ ཡང་ སྟོན་པ་ ཉིད་ ཀྱི་ བཀའ །སེམས་བསྐྱེད་ གཅིག་ གིས་ སངས་རྒྱས་པ ར །_།འདོད་པ ས་ ཕ་རོལ་ ཕྱིན་པ་ ལ །_།བསླབ་པ ར་ བྱ་ ཞེས་ གསུངས་པ་ དང་ །_།ལོ་ ནི་ བཅུ་གཉིས་ ནང་རོལ་ དུ །ནོར་བུ་ བཟང་པོ ས་ ཀུན་བཟང་ ཐོབ །_།བྱང་ཆུབ་ སེམས་དཔའ་ རྟག་ ཏུ་ ངུ་ །_།ཚེ་ འདི ར་ ས་བཅུ་ ཕ་རོལ་ ཕྱིན །_།དེ་ཕྱིར་ ཕར་ཕྱིན་ ཐེག་པ་ ཡང༌ །_།ཚེ་ གཅིག་ སངས་རྒྱས་ བཞེད་པ་ ལགས །ཅེས་ སོ །ལྷན ༽༽_ གཞན་ ཤེས་ ལ་ སྔགས་ མཚན་ཉིད་ གཉིས་ ཀྱི་ སངས་རྒྱས་ དེ ས་ གསུངས་པ འི་ ཆོས་དེ་ ཉམས་ སུ་ ལེན་པ འི་ དགེ་འདུན་ གསུམ་པོ་ ཐ་དད་ ཡིན་ ཟེར་ ཡང༌ །འདི ར་ ཆོས་ དང་ ཉམས་ལེན་ གྱི་ འགྲོས་ སམ་ བབ་ ཀྱིས་ འབྲས་བུ་ སངས་རྒྱས་ གཅིག་ ཡིན་ ཏེ་སངས་རྒྱས་ ཐོབ་པ ར་ བྱེད་པ་ ལ་ ས་བཅུ་ གཅིག་ དང་ བཅུ་གསུམ་ གཉིས་ སུ་ གསུངས་ ཀྱང་མཚོན་ ལུགས་མ་ གཏོགས་ དོན་ ལ་ ཁྱད་མེད་ དོ །སྔགས་ ཀྱིས་ ལུས་ རྩ འི་ མདུད་ བཅུ་གསུམ་ གྲོལ་ རྒྱུ་ ཐ་མལ་ གྱི་ རླུང་ ཉི་ཁྲི་ ཆིག་སྟོང་ དྲུག་ བརྒྱ་ འགག་པ་ དང་ སྦྱར་ ཏེ་འཕོ་བ་ བཅུ་གཉིས་ གཙོ་བོ ར་ བྱས་པ་ ལ་ ས་བཅུ་ གཉིས་ ཏེ་རྩ་ རླུང་ ལ་ བརྟེན་པ་ མ་ དག་པ འི་ རྟེན་འབྲེལ་ སྦྱངས་པ་ དང་ །རྡོ་རྗེ་ འཛིན་པ འི་ ས་ དང་ བཅུ་གསུམ་ མོ །ཕར་ཕྱིན་པ ས་ སྒྲིབ་ བཅུ་ སྤངས་ ཤིང་ ཕར་ཕྱིན་ བཅུ་ རྫོགས་པ ས་ས་བཅུ་ མཐ ར་ ཕྱིན་ ནས་ བཅུ་གཅིག་ པ་སངས་ རྒྱས་ ཀྱི་ ས ར་ འདོད་པ ས་ ན་ ས ས་ བགྲོད་པ་ དང༌ །ཉམས་ལེན་ བསླབ་ གསུམ་ དགེ་བ །ཉོན་མོངས་ འདུལ་བ་ ཐེག་ཆེན་ ཡིན་པ །བགྲོད་པ་ གཅིག་པ འི་ ལམ་ ཡིན་པ་ རྣམས་སྔགས་ མཚན་ཉིད་ གཉིས་ཀ་ གཅིག་པ་ ཡིན་པ འི་ ཕྱིར་ རོ །_།རྡོ ༽༽_ སྔགས་ མཚན་ཉིད་ གཉིས་ གཞི་ ལམ་ འབྲས་བུ་ གསུམ་ གྱི་ གང་རུང་ རེས་ སངས་རྒྱས་ ཐོབ་པ་ ཡིན་ ཟེར །འདི ར་ ནི་ དེ་ གཉིས་ གང་ ལ་ གང་ མེད་ རྫོགས་ བྱང་ ཐོབ་པ ར་ མི་ སྲིད་ དེ་རགས་པ འི་ སྤང་བྱ་ མཚན་ཉིད་ ཀྱིས་ སྤོང །ཕྲ་བ་ སྔགས་ ཀྱིས་ སྤོང་བ ས་སྔགས་ ལ་ མཚན་ཉིད་ མེད་ ན་ རག་པ་ མི་ སྤོང་ ཞིང་སློབ་དཔོན་ རྒྱལ་བོ་ དང་ ནཱ་ རོ་པ་ ལྟ་བུ ས་ ཀྱང་སངས་རྒྱས་ མི་ ཐོབ་ སྟེ་ རགས་པ་ མ་ སྤང་བ འི་ སངས་རྒྱས་ མི་ སྲིད་པ འི་ ཕྱིར །མཚན་ཉིད་ ལ་ སྔགས་ མེད་ ན་ ཕྲ་བ་ མི་ སྤོང་ ཞིང་ནོར་ བཟང་ དང་ རྟག་ ཏུ་ ངུ་ ལྟ་བུ ས་ ཀྱང་ སངས་རྒྱས་ མི་ ཐོབ་ ཏེ །ཇོ་བོ ས །གསང་སྔགས་ ཕ་རོལ་ ཕྱིན་པ་ ལ །_།བརྟེན་ ནས་ བྱང་ཆུབ་ བསྒྲུབ་པ ར་ གསུངས །_།ཅེས་པ ས་ སོ །རྡོ ༽༽_ གཞན་ འདོད་ ལ་ སྡོམ་ གསུམ་ རིམ་བཞིན་ ལུས་ངག་ གི་ མི་དགེ་བ་ བདུན་ དང་ །ཡིད་ ཀྱི་ གསུམ་ དང་ །ལོག་ལྟ་ སྤོང་ ཞིང༌ །དེ་ཡང་ གཙོ་བོ ར་ བདུན་ ལ་ འདོད་ཆགས །གསུམ་ ལ་ ཞེ་སྡང །ཕྱི་མ འི་ སྐབས་ སུ་ གཏི་མུག་ སྤོང་བ ས་སོ་སོ ར་ གསུམ་ དུ་ བྱུང་བ་ ཡིན་ ཞེས་ ཟེར །འདི ར་ ནི་ སྡོམ་ གསུམ་ སྤང་བྱ་ མི་དགེ་ བཅུ་ སྤོང་བ འི་ ཕྱིར་གནད་ དམ་ སྡོག་ ནི་ གཅིག་ སྟེ་མི་དགེ་ བཅུ་ སྡོམ་པ་ གསུམ་ ཆ ར་ དུ་ སྤང་བྱ་ ཡིན་པ་སོ་ཐར་ གྱི་ སྐབས་ སུ་ ལུང་ རྣམ་འབྱེད་ ལ ས །ལུས་ ཀྱི་ སྡོམ་པ་ ལེགས་པ་ ན །སོགས །།ཅེས་ བྱང་སེམས་ ཀྱིས་ ཀྱང་ ཕུང་པོ་ གསུམ་པ་ སོགས་ ལ ས་ དེ་ལྟར་ གསུངས་ ཤིང༌ །སྔགས་ ལ འང་ གསང་བདག་ གིས་ བཅོམ་ལྡན་འདས་ ལ་ དམ་ཚིག་ གང་ ལགས་ ཞུས་པ ས །མི་དགེ་བ་ བཅུ་ སྤོང་བ འོ །_།ཞེས་ དང་ །བཅོམ་ལྡན་འདས་ ནི་ བདུད་ བཅོམ་པ་ ཡིན་ ན །དུག་ གསུམ་ ཉོན་མོངས་པ་ སྤོང་ དགོས་ ཏེ །ཉོན་མོངས་ བདུད་ ནི་ བཅོམ་པ འི་ ཕྱིར་ དང་ །སྲོག་གཅོད་ ལྟ་བུ་ གཅིག་ སྤོང་བ་མི་ཆོས་ བཅུ་དྲུག་ གི་ དང་པོ་སོ་ཐར་ གྱི་ རྩ་ བཞི འི་ ཡ་གྱལ །བྱང་སེམས་ ཀྱི་ སྨོན་སེམས་ སྐྱེ་བ འི་ རྒྱུ །སྐྱེ་ ནས་ འཇུག་ སྡོམ་ གྱི་ ངོ་བོ །_།སྔགས་ སུ་ བཀའ་ འདས་ ཀྱི་ ལྟུང་བ་ འབྱུང་བ ས་ཚུལ་ འདི ས་ མི་དགེ་བ་ ཀུན་ ལ་ མཚུངས་པ ར་ གནད་ གཅིག་ ཏུ་ འོང་ ངོ༌ །ལྷན ༽༽_ འགའ་ཞིག་ སོར་སྡོམ་ སྤང་ གཉེན་ གྱི་ ཚུལ་ དུ་ཡོད་པ་ སྣ་ རེ་ ཉམས་ ན་ ངན་སོང་ དུ་ འགྲོ་བྱང་སེམས་ ལ་ མི་དགེ་བ་ བདུན་གནང་ སྔགས་ ཀྱིས་ བཀག་པ་ དེ་ རྣམས་ ལམ་ དུ་ བྱེད་པ ས་གོང་ ནས་ གོང་ དུ་ ཡངས་ སུ་ སོང་བ་ ཡིན་ ཟེར །འདི ར་ ནི་ སོ་ བྱང་ སྔགས་ ཀྱི་ སྡོམ་ གསུམ་ དེ་ཡང་གོང་ ནས་ གོང་ དུ་ དོག་ ཏུ་ འགྲོ་བ་ བསྒྲུབ་ ཏེ་སོ་ཐར་ གྱི་ སྤང་བྱ་ རག་པ་ ཆེ་ལོང་ ཙམ་ བཅས་པ་ཉིས་ བརྒྱ་ ང་ གསུམ་ རང་ གཅིག་པུ འི་ དོན་ ཡིན་པ ས་ སླ་བ འི་ ཕྱིར་ དང༌ །བྱང་སེམས་ ཀྱིས་ ཕྲ་བ་ སྤོང་བ ར་བྱང་སེམས་ ཀྱི་ སྡེ་སྣོད་ དུ་ ཞིབ་ ཏུ་ བཅས་ ཏེ་གཞན་དོན་ ཁོ་ན་ ལ ས་ རང་དོན་ སྐད་ཅིག་ ཙམ་ སྐྱེས་ ན་ ཉམས་པ ར་ འགྱུར་བ་སྔར་ བས་ བསྲུང་ དཀའ་བ འི་ ཕྱིར་ དང༌ །སྔགས་ ཀྱིས་ ཤིན་ཏུ་ ཕྲ་བ འི་ བག་ཉལ་ སྤོང་བ་རྒྱུད་སྡེ་ རྣམས་ ལ ས་ འབུམ་ སྡེ་ སོགས་ གསུངས་ ཤིང་སྔ་མ འི་ སྟེང་ དུ་ ལུས་ངག་ ཡིད་ ཀྱི་ བྱ་ བྱེད་ ཐམས་ཅད་ ལྷ འི་ ང་རྒྱལ་ ལ ས་ སྐད་ཅིག་ ཙམ་ ཡང་ མ་ བྲལ་བ ར་ དགོས་པ འི་ ཕྱིར་ རོ །རྡོ ༽༽_ ཆོས་ ཀྱི་ འཁོར་ལོ་ བསྐོར་བ འི་ དོན་ སྡོམ་ གསུམ་ ཡིན །དེ་ གསུམ་ དུ་ འོང་བ འི་ རྒྱུ་མཚན་ སྤང་བྱ་ དང༌ །བསྒྲུབ་བྱ་ དང་ ཐོབ་ བྱ་འབྲས་ བུ་ མི་མཐུན་པ ས་ལེན་ ན་སོ་ སོ ར་ ལེན །གནས་ ན་ གཅིག་ ཏུ་ གནས །བསྲུང་ ན་ འཆོལ་བ ར་ བསྲུང་བ་ཐ་དད་ ཀྱིས་ ཁྱད་ འབྱེད་ ཟེར །འདི ར་ ནི་ སྤང་བྱ་ མི་དགེ་ བཅུ་བསྒྲུབ་བྱ་ དགེ་བ་ བཅུ་ ཡིན་པ ས་ཐ་དད་ དུ་ བྱ་བ་ ཅུང་ཟད་ མེད་ དོ ༑_།འོ་ན་ གསུམ་ དུའང་ བཞག་ རྒྱུ་ མེད་ ཅེ་ན །དཔེར་ན་ རྒྱན་ གྱི་ ངོ་བོ་ གཅིག་ ལ་འབངས་ དང་ བློན་པོ་ རྒྱལ་པོ་ གསུམ་ གྱིས་ སོ་སོ ར་ བཏགས་ ན་འདོགས་ མཁན་ དེ འི་ དབང་ གིས་ གསུམ་ དུ་ འབྱུང་བ་ ལྟར །སྡོམ་པ འི་ ངོ་བོ་ ཉམས་ སུ་ ལེན་ རྒྱུ་ལ་ ཁྱད་པར་ མེད་ ཀྱང་ཉམས་ སུ་ ལེན་ མཁན་ བདག་པོ་ གསུམ་ ལ་སོ་ སོ ར་ འཕོས་པ ས་བྱེ་བྲག་ གིས་ སྡོམ་པ་ གསུམ་ དུ་ འོང་ སྟེ་འདི་ ནི་ གསང་བདག་ གིས་ དམ་ཚིག་ ཕྱི་མ་ ཞུས་པ་ ལ་ བརྟེན་ ནས་ གསུངས་པ འི་ དོན་ དེ་ ཡིན་ གསུངས་ སོ །རྡོ ༽༽_ གཞན་ ཤེས་ ལ་ དེ་བཞིན་ གཤེགས་པ འི་ སྙིང་པོ་ ཡོད་པ ར་ གསུངས་པ་ དེ་དགེ་ མི་དགེ་ ལུང་ མ་ བསྟན་ གང་ དུ་ མི་ གཏུབས་པ འི་ ནམ་མཁའ་ ལྟ་བུ་ ཞིག་ ཡིན་ ཟེར་ རོ །འདི ར་ རང་བཞིན་ རྣམ་དག་ ལ་ བྲལ་ སྨིན་ འབྲས་བུ འི་ ཡོན་ཏན་ དང་ ལྡན་པ ར་ གྲུབ་ སྟེ །ཉེས་པ་ བློ་བུར་བ་ ཡིན་པ་སྙིང་པོ འི་ མདོ ར་ དཔེ་ དགུ ས་ བསྟན་པ་ དང་ ༈ཕལ་པོ་ ཆེ ར་ སྟོང་གསུམ་ དར་ཡུག་ གི་ དཔེ་ དང་ །གཟུང་ དབང་ ཞུས་ མདོ ར་ ནོར་བུ་ སྦྱོང་བ འི་ དཔེ ས་ བསྟན་ ཏེ །ཡོན་ཏན་ ཞི་ དུས་ ན་ ཇི་ལྟར་ ཡོད་པ་ མངོན་དུ་ བྱ་བ ར་ གསུངས་_ ཏེ ༑རྒྱུད་ བླ ར །འདི་ ལ་ བསལ་ བྱ་ ཅི་ཡང་ མེད །སོགས་ དང་ །ཉེས་པ་ བློ་བུར་ དང་ ལྡན་ དང་ །སོགས་ དང་ །སེམས་ ཀྱི་ རང་བཞིན་ འོད་གསལ་ གང་ཡིན་པ །སོགས་ དང༌ །དཔལ་ ཕྲེང་ གི་ མདོ་ ལ ས །དེ་བཞིན་ གཤེགས་པ འི་ སྙིང་པོ་ ནི་ བྲལ་ ཤེས་པ །དབྱེ ར་ མེད་པ་ ཉོན་མོངས་པ འི་ སྦུབས་ ཀྱིས་ སྟོང་པ །བྲལ་ མི་ ཤེས་པ་ རྣམ་པ ར་ དབྱེ ར་ མེད་པ་སངས་རྒྱས་ ཀྱི་ ཆོས་ གངྒཱའི་ ཀླུང་ གི་ བྱེ་མ་ སྙེད་ འདས་པ འི་ ཡོན་ དང་ ལྡན་པ འོ །_།ཞིང་ རྣམ་པ ར་ མི་ རྟོག་པ འི་ གཟུངས་ ལ ས་རང་ ཁྱིམ་ བྱི་ གཏོར་ དང་ འདྲ་བ ར་ གསུངས་ སོ །_།དེ་ལྟར་ མིན་ ན་ མཐོང་ལམ་ མཐོང་ ནས་ དེ་ཡན་ བོག་ དབྱུང་ དུ་ མེད་པ ར་ འགྱུར་ རོ །_།རྡོ ༽༽ བྱང་ཕྱོགས་ སོ་ བདུན་ ལམ་ ཁོ་ན འི་ ཆོས་ ཡིན་ ཟེར་བ་ དང༌ །འགའ་ཞིག་ སྡོམ་པ ར་ ལུས་ དྲན་པ་ ཉེ་བར་ བཞག་ གི་ ཁྲོ་ མ འོ །ཞེས་པ ས་ འབྲས་བུ འི་ ཆོས་ ཡིན་ ཟེར་འགའ་ཞིག་ དེ་ གཉིས་ཀ་ ཡིན་ ཟེར །འདི ར་ ནི་ གཞི་ ལམ་ འབྲས་བུ་ གསུམ་ ཀར་ ཁམས་ ཡོན་ཏན་ དང་ ལྡན་པ་དེ་ཉིད་ དང་ དབྱེ ར་ མེད་པ ར་ ཡོད་ དེ །དེ ས་ བརྗོད་ བླ་མ་ ལ ས །བྱང་ཆུབ་ ཕྱོགས་ ནི་ སུམ་ཅུ་ བདུན །_།ཆོས་ ཀྱི་ རྣམ་པ ར་ དག་པ་ ཡིན །ཞེས་པ་ དང༌ །འབྲས་བུ འི་ ཆོས་ ཐམས་ཅད་ གཞི་ ལ་ ཡོད་པ་ མངོན་དུ་ བྱས་པ ར་ གསུངས་ ན་ཀུན་སྤྱོད་ སྡོམ་པ་ ལྷ་ སོ་ བདུན་ དུ་ གསུངས་པ་ དང༌ །མདོ་སྡེ ར་ སངས་རྒྱས་ ལ་ བྱང་ཆུབ་ ཀྱི་ ཡན་ལག་ བདུན་ གྱིས་ ཕྱུག་པ ར་ གསུངས་པ ས་བྱང་ཕྱོགས་ སོ་ བདུན་ བཞི་ བདེ་གཤེགས་ སྙིང་པོ ར་ ཡོད་པ་ ངེས་ སོ །ལྷན ༽༽_ བྱང་ཕྱོགས་ སོ་ བདུན་ གནས་སྐབས་ བདུན་ དུ་ གསུངས་པ་ལམ་ གྱི་ ཆོས་ མིན་ གྱི་ སངས་རྒྱས་ ཀྱི་ ས་ ནི་ དེ འི་ ཕ་རོལ་ ན་ ཡོད །ཚོགས་ལམ་ འབྲིང་པོ ར་ དྲན་པ་ ཉེར་ བཞག་ ལ་དོན་ མེད་ ཟེར །འདི ར་ ནི་ མཐར་ཐུག་ གི་ ས་ ཚུན་ཆད་ ཚོགས་ལམ་ གསུམ་ ངོ་བོ ས་ བགྲོད་པ་ ཡིན་ ཏེ །སངས་རྒྱས་ མ་ ཐོབ་ བར་ དུ་ ཚོགས་ གཉིས་ བསགས་ དགོས་པ་ དང༌ །ཚོགས་ལམ་ གྱི་ དྲན་པ་ ཉེར་ བཞག་ དེ་སྦྱོར་ལམ་ དུ་ དྲན་དབང་ དྲན་ སྟོབས་མཐོང་ལམ་ དུ་ དྲན་པ་ ཡང་དག་ བྱང་ཆུབ་ ཀྱི་ ཡན་ལག་བསྒོམ་ ལམ་ དུ་ ཡང་དག་པ འི་ དྲན་པ་མཐ ར་ ཕྱིན་ ལམ་ དུ་ དྲན་པ་ ཉམས་ མེད །དྲན་པ ས་ དབང་ བསྐུར་ དྲན་པ ས་ མ་ འདྲེས་པ་ གསུམ་ དུ་ འབྱུང་བ་དེ་ རིམ་བཞིན་ སངས་རྒྱས་ ཀྱི་ མ་ འདྲེས་པ་ དང་ སྐབས་ བརྒྱད་ ཀྱི་ རྣམ་མཁྱེན་ དང་ བྲལ་བ འི་ ཡོན་ཏན་ ཡིན་པ འི་ ཕྱིར་ རོ །རྡོ ༽༽_ ཞི་གནས་ ཀྱི་ གཞི་མ་ ཚད་ མེད་ རྣམ་ བཞི འམ་ ཚང་ གནས་ བཞི ས་ ཚངས་པ འི་ རྒྱལ་པོ་ ཐོབ་ ཕྱིར་འཇིག་རྟེན་པ འི་ ལམ་ ཡིན་ ཟེར །འདི ར་ ནི་ དེ འང་ གཞི ར་ ཡོད་པ་ལམ་ དུ་ བྱེད་པ་ ངེས་དོན་ འཁོར་ལོ ར་ མ་ཟད་སྔགས་ སུ འང་ གཞན་ ལ་ ཕན་པ འི་ སེམས་ ནི་ བྱམས་པ་ ཡིན་ ཞེས་ སོགས་ དང༌ །འབྲས་བུ འི་ སྐབས་ ན འང་དེ་དག་ གི་ ངོ་བོ ར་ སངས་རྒྱས་པ ར་ གསུངས་ ཏེ །རྒྱ་ ཆེ ར་ རོལ་པ་ ལ ས །གང་ གི་ དོན་ སྟོབས་ བཅུ་པོ་ ལ །_།སེམས་ཅན་ རྣམས་ ལ་ བསྒོམ་པ་ ཡིན །_།བྱམས་པ འི་ སྟོབས་ ཀྱི་ རྒྱལ་ གྱུར་པ །ཞེས་པ ས་ སངས་རྒྱས་ ཀྱི་ ངོ་བོ་ དེ་ བཞི་པོ་ ཉིད་ དོ །རྡོ ༽༽_ གཞན་ འདོད་ ནི །རིགས་ ནི་ ངེས་ དང་ མ་ ངེས་ དང༌ །_།རྐྱེན་ རྣམས་ ཀྱིས་ ནི་ མི་ འཕྲོག་ དང །འཕྲོག་མ་ ཉིད་ དེ་ སོཊ །ཅེས་པ ས་ རྒྱུ་ རིགས་ ཐ་དད །ལང་ གཤེགས་ ལ ས །ལྷ་ ཡི་ ཐེག་ དང་ ཚངས་པ འི་ ཐེག་ སོགས །ཅེས་པ ས་ ལམ་ ཐ་དད་པ ས་ འབྲས