་ སེམས་དཔའ་ དང་ སློབ་དཔོན་ ཀླུ་ གྲུབ་ སོགས་ ཀྱིས་ བཀྲལ་བ འི་ དོན་ ཡིན་པ འི་ ཕྱིར་ རོ །རྡོ ༽༽_ སྐྱབས་འགྲོ་ བདེན་ བཞི འི་ ཆོས་འཁོར་ སྡེ་སྣོད་ འདུལ་བ །བསླབ་པ་ ཚུལ་ཁྲིམས །སྡོམ་པ་ སོ་ཐར །སེམས་བསྐྱེད་ དོན་དམ་ རྒྱུད་ བླ་མེད་ དབང་ བཞི་པ་ གྲོལ་ ལམ་ རྫོགས་རིམ་ རྣམས་ཟབ་ ཅིང་ གཞན་པ་ མི་ ཟབ་པ་ འདོད་ མོད །འདི ར་ ནི་ གཞན་ གྱི་ མི་ ཟབ་པ ར་ འདོད་པ་ དེ་ རྣམས་འདི ར་ ཟབ་པ ར་ བྱ་ སྟེ་དེ་དག་ མེད་ ན་ སངས་རྒྱས་་_པ་ ལྟ་ཅི་ལམ་ གྱི་ ཡོན་ཏན་ ཡང་ ཐོབ་པ ར་ མི་ ནུས་པ འི་ ཕྱིར་རྩ་བ་ དང་ དྲལ་བ འི་ ཡལ་ འདབས་ བཞིན་ ནོ །_།དེ་བས་ན་ སྐྱབས་ སུ་ འགྲོ་བ་ ཟབ་ སྟེ །ཆོས་ ཐམས་ཅད་ ཀྱི་ གཞི་མ་ ཡིན་པ འི་ ཕྱིར །དཔེར་ན་ འཁོར་ལོ ས་ བསྒྱུར་ རྒྱལ་འཇིག་རྟེན་ དུ་ འབྱུང་བ་ ལ་ཐོག་མ ར་ དེ འི་ རིགས་ སུ་ སྐྱེ་ དགོས་པ་ བཞིན་ ནོ །_།དེ འི་ འོག་ ཏུ་ བདེན་ བཞི་ དང་ འདུལ་བ་ སོགས་ ཟབ་པ་ ཡིན་ ཏེ །དེ ས་ ཁྱད་པར་ གྱི་ ཆོས་འཁོར་ དང་ བཟོ་གནས་ དང་ ཡིག་རྩིས་ ལ་ བརྟེན་ དགོས་པ་ བཞིན་ ནོ །_།དེ་ལྟར་ ཡང་ རྗེ་ འཇིག་རྟེན་ མགོན་པོ ས །གཞན་ གྱི་ ཆོག་ དབང་ གོང་མ་ ཟབ་ ཟེར་ ཡང༌ །འམ་ བུ་ བུམ་ དབང་ ལ་ རྩི་ ཆོད་ ཆེ །གཞི་ དང་ སྣོད་ དང་ ལུས་ ལྟ་བུ །_།གཞན་ རྣམས་ དེ་ ཡི་ ཁྱད་པར་ ཆོས །ཞེས་ སོ །_།གཞན་ ཡང་ བརྟག་ གཉིས་ ལ ས །དང་པོ་ གསོ་སྦྱོང་ སྦྱིན་པ ར་ བྱ །ཞེས་པ་ ནས །དེ་ རྗེས་ ཀྱེ་ རྡོ་རྗེ་ བརྩམས །ཞེས་ སོ །_།རྡོ ༽༽_ བཤད་ མ་ ཐག་པ འི་ མི་ ཟབ་པ་ དེ་ རྣམས་མི་ དགོས་པ ར་ རྩ་ རླུང་ བསྒྲུབས་པ ས་འགྲོས་ བཞི་ རིམ་པ ར་ ཐིམ་པ ས་ས་བཅུ འི་ བར་ བགྲོད་ དེ་འབྲས་བུ་ སྐུ་བཞི་ ཡེ་ཤེས་ ལྔ་ མངོན་དུ་ གྱུར་ ཏེ་རྡོ་རྗེ་ འཆང་ གི་ གོ་འཕང་ ཐོབ་ ཟེར །འདི ར་ མི་ ཟབ་པ་ དེ་ རྣམས་ མེད་ ན་རྩ་ རླུང་ གི་ གདམས་པ ས་ སངས་ མི་ རྒྱ་ སྟེ་རྟེན་གཞི་ མེད་པ འི་ ཕྱིར །དཔེར་ན་ འཁོར་ བསྒྱུར་ ཟས་ ལ་མ་ བརྟེན་ ན་ འཚོ་ མི་ ནུས་པ་ བཞིན་ ནོ །_།བརྩོན་འགྲུས་ ཅན་ མངོནཤེས་ དང་ རྫུ་འཕྲུལ་ རེ་ ཐོབ་པ་ སྲིད་ ཀྱང་ །ཕྱི་རོལ་པ་ ལ འང་ ཡོད་ དེ །དེ འང་ འདོད་ཆགས་ དང་ བྲལ་ དགོས་པ ས་དེང་སང་ དཀའ་བ ར་ སྣང་ངོ་ །ལྷན ༽༽_ སྔགས་ ཀྱི་ ཉམས་ལེན་ ཐུན་ མིན་ རྩ་ རླུང་ གི་ གདམས་པ་ ཟབ་པ ར་ འདོད་ མོད །འདི ར་ སྔགས་ གང་ གི་ གདམས་པ འི་ གནད་ ལ་ འདུལ་བ་ ལྷག་པ་ ཡིན་ ཏེ་སྒོ་གསུམ་ གྱི་ སྐྱོན་ བསྡམས་པ ས་ལུས་ངག་ ཡིད་ གསུམ་ ལ ས་ སུ་ རུང་ ཞིང་ །སྐྱོན་ ལུས་ རྩ་ ཡི་ མི་ ཚངས་སྤྱོད །ངག་ རླུང་ གི་ རྫུན །ཡིད་ ཐིག་ལེ འི་ བརྣབ་སེམས་ སོགས་ དག་ ཅིང་ཡོན་ཏན་ དྭངས་མ་ འཕེལ་བ ས་འཁོར་ལོ་ བཞི་ གང་ སྟེ་ བསམ་གཏན་ བཞི་ དགེ་སྦྱོང་ གི་ འབྲས་བུ་ བཞི་མཐར་ཐུག་ སྟོབས་ སོགས་ ཀྱང་ འབྱུང་བ འི་ ཕྱིར་ རོ །_།དེས་ན་ སྒོ་གསུམ་ མ་ དག་ ན་ དུག་ གསུམ་ གྱིས་ རྙོག་པ ར་ འགྱུར་བ ས་རྩ་ རླུང་ ཐིག་ལེ་ གསུམ་ ཀ་ སྡོམ་ བྱེད་ དགེ་སློང་ གི་ སྡོམ་སེམས་ བརྟན་པོ ས་ སྡོམ་པ་ སྟེ་འཁོར་ལོ་ བཞི་ དང་ སྡེ་པ་ བཞི་ སྤྲད་པ འི་ རྒྱུ་མཚན་ ཡང་ དེ་ ཡིན་ ནོ །ལྷན ༽༽_ ཀུན་གཞི་ བདེ་གཤེགས་ སྙིང་པོ་ དེ་ས་བཅུ་པ ས་ ཀྱང་ མུན་ཁུང་ གི་ གླང་པོ་ ལྟར་ ཕྱོགས་ ཙམ་ ལས་མི་ རྟོགས་ ཏེ །སྤྲིན་ མཐོང་ མཁའ་ ལ་ ཉི་ བཞིན་འདི ར་ ཁྱོད་ བློ་གྲོས་ ཅན་ བློ་མིག་ དག་པ འི་ འཕགས་ རྣམས་ ཀྱིས་ ཀྱང་ཐམས་ཅད་ མཐོང་ མ་ ལགས །ཞེས་པ ས་ སྤྱི འི་ བཞེད་པ་ དེ་ མཐུན་ ཡང་ །འདི ར་ བླ་མ་ བྱིན་ རླབ་ དང་ ལྡན་པ ས་གདམས་ངག་ བསྟན་པ འི་ དོན་ བརྩོན་འགྲུས་ ཀྱིས་ བསྒོམ་པ འི་ མཐུ ས་ ཀུན་གཞི་ དེ་དུས་ རེ་འགའ་ གཞན་ དུ་ ཡང་ མཐོང་ སྟེ་གོམ་པ་ གནད་ དུ་ སོང་བ ས་ཁམས་ ནང་ དུ་ འདུས་ ཏེ་ལུས་ ལ་ བག་ཆགས་ ཀྱི་ ས་བོན་ རྩ་མདུད་ དང་ཡི་གེ ར་ གནས་པ འི་ ངང་ རིག་ དྲུག་ གི་ ས་བོན་ རྣམས་ མཐོང་ །དེ ར་ རླུང་ ཆུད་པ ས་ རིགས་ དྲུག་པོ །དེ་ དང་ དེ ར་ མཐོང་ དེ་ ཡུན་རིང་ དུ་ གོམ་པ ས་ཕྱི་རོལ་ ཏུ་ རིག་ དྲུག་ གི་ དཀྱིལ་འཁོར་ ཡོད་པ་ དང༌ །ཕྱི་རོལ་ གྱི་ རྒྱུ་རྐྱེན་ གང་ ལ ས་ གང་ འབྱུང་ ཕལ་ཆེར་ མཐོང་བ ས་ཀུན་གཞི འམ་ ཆོས་ཉིད་ བདེ་གཤེགས་ སྙིང་པོ་ མཐོང་བ་ སྟེ་ཆོས་ རྣམས་ ཀྱི་ རྟེན་འབྲེལ་ མངོན་དུ་ བྱས་པ འི་ ཕྱིར་ རོ །_།དེ འང་ ཀུན་གཞི་ ཉོན་ཡིད་ ཡིད་ཤེས་ སྒོ་ ལྔ་ དག་པ ས་ ཆོས་དབྱིངས །མེ་ལོང་ དང་ མཉམ་ཉིད་ སོགས་ ཡེ་ཤེས་ ལྔ་ འབྱུང་ ཞིང༌ །དེ་ལྟར་ ན་ ས་བཅུ ས་ ཀྱང་ མི་ མཐོང་བ་ དང་ །ས་ བདུན་པ ས་ མཐོང་བ་ དང་ །ས་ དང་པོ ས་ མཐོང༌ །སོ་སྐྱེ ས་ མཐོང་བ འི་ ཀུན་གཞི་ སྟེ་ རྣམ་ གྲངས་ བྱེད་ དགོས །རྡོ _༽༽_ སྒོམ་ཆེན་པ ས་ ཉམས་ སུ་ མྱོང་བ་བཀའ་ དང་ བསྟན་བཅོས་ གང་ ནས་ ཀྱང་ མ་ བཤད་པ་ ཞིག་ བྱུང་ ན འང་ ཟབ་ ཟེར །འདི ར་ བཀའ་ དང་ འགལ་བ འི་ ཉམས་མྱོང་ བྱུང་བ་ ལོག་རྟོག་ ཡིན་ ཏེ་ཐམས་ཅད་ མཁྱེན་པ འི་ གསུང་ དང་ འགལ་བ འམ་མུ་སྟེགས་ ཀྱི་ ལམ་སྣ་ ཟིན་པ་ ཡིན་པ འི་ ཕྱིར །མུ་སྟེགས་ མངོན་ མཐའ་ འཇིག་པ་ དང་ཕྱི་མཐའ་ མི་ འཇིག་པ ས་ མངོན་ཤེས་ ཀྱིས་ བརྟགས་པ འི་ གྲུབ་མཐའ་ བཞིན་ ནོ །_།མཁྱེན་པ་ དང་ བརྩེ་བ་ ཆེན་པོ་ སངས་རྒྱས་ ཀྱི་ གསུངས་ ལ ས་ ལྡོགཔའི་ མྱོང་བ་དེ་ ནི་ འདུད་ ཀྱི་ ལ ས་ ཡིན་པ ས་ཡུམ་ དང་ གཙུག་ཏོར་ བམ་ དགུ་ ལ ས་ གསུངས་པ་ བཞིན་ རིགས་པ ར་ བྱ འོ །རྡོ ༽༽_ སྡེ་སྣོད་ རྒྱུད་སྡེ་ དྲང་དོན་ ངེས་དོན་ ཐ་དད་པ ས་ལ་ལ ར་ བཀག་པ་ ལ་ལ ར་ གནང །ལ་ལ ར་ སྤང་བ་ ལ་ལ ར་ སྒྲུབ་པ ས་ཕྱོགས་ རེ ར་ མཐུན་པ ས་ ཆོག་ ཟེར་བ་ དང་འོག་མ་ གོང་མ ར་ ཞུགས་ ནས་ དོར་ ཟེར །འདི ར་ ནི་ དགོངས་པ་ ཐམས་ཅད་ འགལ་བ་ མེད་པ ར་ ཤེས་པ ར་ བྱ་ དགོས་ ཏེ་ཆོས་ཕུང་ བརྒྱད་ ཁྲི་ ཉོན་མོངས་པ འི་ གཉེན་པོ ར་ གསུངས་པ ས་སྐྱོན་ སྤོང་ ཡོན་ཏན་ བསྒྲུབ་པ་ ལ་ ཐམས་ཅད་ ཉམས་ སུ་ ལེན་ དགོས་པ འི་ ཕྱིར་ དང་ །སྡོམ་ གསུམ་ དང་ ཕྱག་ ཆེན་ ཚུལ་ཁྲིམས་ གནད་ གཅིག་པ འི་ ཕྱིར་ དང་བརྗོད་བྱ འི་ དོན་ ཡང་ གཅིག་ སྟེ་ཟླ་ སྒྲོན་ ལ ས །ངས་ ནི་ མདོ་སྡེ་ གང་ བཤད་པ །ཚིག་འབྲུ་ ཐ་དད་ དོན་ གཅིག་ སྟེ །ཞེས་ དང༌ །ཇོ་བོ ས །ཆོས་ ཀྱི་ ཕུང་པོ་ བརྒྱད་ ཁྲི་ དང༌ །_།བཞི་ སྟོང་ གསུང་པ་ གང་ཡིན་པ །_།ཆོས་ཉིད་ འདི་ ལ་ གཞོལ་ ཞིང་ འབབས །ཞེས་པ ས་ མི་འགལ་བ་ བྱེད་ དགོས །རྡོ ༽༽_ ཉམས་ སུ་ ལེན་པ འི་ སྐྱོན་ཡོན་ ནི་ གདམས་ངག་ དམིགས་བསལ་ ཡིན་པ ས་དེ་ ཁོ་ན་ཉིད་ ལྟར་ འབྱུང་ ཟེར །འདི ར་ ནི་ གདམས་ངག་ ལྟར་ མིན་པ ར་ རྒྱལ་བ་ ཐམས་ཅད་ མཁྱེན་པ འི་ བཀའ་ ལྟར་ འོང་བ ར་ བཞེད་ དེ་རྒྱུ་འབྲས་ ཀྱི་ རྟེན་འབྲེལ་ ཐམས་ཅད་ མངོན་སུམ་ དུ་ གྱུར་པ ས་གནད་ ཇི་ དང་ ཇི་ལྟ་བུ ས་ ཡོན་ཏན་ བསྐྱེད་པ་ དང་སྐྱོན་ སྤོང་བ་ མཁྱེན་པ ས་ བརྩེ་བ་ ཆེན་པོ ས་ གདུལ་བྱ་ རྣམས་ ལ་ བསྟན་པ འི་ ཕྱིར་གསུང་རབ་ ནས་ གསུངས་པ་ དེ་བཞིན་ དུ་ འབྱུང་བ་ ཡིན་ ནོ །_།རྡོ ༽༽_ རྟོག་པ་ ཕྲ་མོ་ ཙམ་ ཡང་ མི་ འགྱུ་བ་མི་ རྟོག་ ལུས་ ལ་ གྲི་ རྒྱབ་ ཀྱང་ བདེ་བ ར་ འོང་བ་བདེ་བ་ ཕྱི་ ནང་ དང་ གང་ཟག་ ཁྱད་མེད་པ་ གསལ་བ་ སྟེ་ཏིང་ངེ་འཛིན་ དེ་ གསུམ་ སྐུ་གསུམ་ གྱི་ རྒྱུ་ ཡིན་པ ར་ འདོད་ ཀྱང་ །འདི ར་ ནི་ སྐྱོན་མེད་པ འི་ ཏིང་འཛིན་ དེ་ གསུམ་ ཁམས་ གསུམ་ འཁོར་བ འི་ རྒྱུ འམ་ ས་བོན་ ཡིན་ ཏེ །བདེ་བ ས་ འདོད་ཁམས །གསལ་བ ས་ གཟུགས་ཁམས །མི་ རྟོག་པ ས་ གཟུགས་ མེད་ ཁམས་ སུ་ སྐྱེ་བ འི་ ཕྱིར །ཨཱརྱ་ དེ་ཝ ས །བསམ་གཏན་ ནགས་མེ ས་ ཡང་ དང་ ཡང་ དུ་ ནི་ ཉོན་མོངས་ ཚང་ཚིང་ བསྲེག་པ ར་ གྱུར་ ན་ ཡང༌ །_།བདག་ ལྟ འི་ རྩ་བ་ བརྟན་པོ་ མ་ སྤངས་པ ས །_།ཆ ར་ གྱིས་ བརླན་ བཞིན་ མོད་ ལ་ རབ་ཏུ་ སྐྱེ །ཞེས་ དང༌ །མགོན་པོ་ ཕག་མོ་ གྲུ་པ ས་ ཀྱང༌ །_།བདེ་ དང་ གསལ་བ འི་ རྒྱ་མཚོ་ རུ །_།ཞེན་ དང་ འཛིན་པ འི་ ནོར་བུ་ གནས །_།ནོར་བུ་ ལ་ མངོན་ཞེན་ སྐྱེ་ གྱུར་ ན །_།དུག་སྦྲུལ་ ལྟ་བུ འི་ དམྱལ་་ སྲུང་ གིས །_།བདེ་བ་ ཆེན་པོ འི་ སྲོག་ བཅད་ དེ ༑_༑ཉམ་ང་ ཆེན་པོ འི་ གཡང་ ལ་ བསྐུར །ཞེས་པ ས །གསུམ་པོ་ དབྱེ ར་ མེད་ ཆོས་དབྱིངས་ སུ་ རོ་ མཉམ་པ་ ཞིག་ དགོས་པ ར་ སེམས་ ཤིང་ གཞན་ དུ་ སྐྱོན་མེད་ དུ་ བཤད་_ ཀྱང་བདེ་ གསལ་ སོགས་ སོ་སོ ར་ འཛིན་པ འི་ རྟོག་པ་ ལས་མ་ འདས་པ ར་ དགོངས་པ་ ཡིན་ ནམ་ མཉམ་ མོ །རྡོ ༽༽_ དཀྱིལ་འཁོར་ གྱི་ འཁོར་ལོ་ བདེ་མཆོག་ ལྟ་བུ ར་ མཚོན་ ན་ལོངས་སྐུ་ ཡུམ་ ཆོས་སྐུ་ ཡུལ་ ཉེར་ བཞི་ གནས་པ འི་ ཐུགས་ གསུང་ སྐུ་ ཡི་ འཁོར་ལོ་ དཔའ་བོ་ མཁའ་འགྲོ་ སྒོ་མཚམས་ ཀྱི་ ལྷ་མོ་ དང་ བཅས་པ་ སྤྲུལ་སྐུ་ སྟེ་དེ་ གསུམ་ ཐ་དད་ ཡིན་ ཟེར་ རོ །འདི ར་ ནི་ སྐུ་གསུམ་པོ་ རེ་རེ་ ལ་ ཡང་ གཞན་ གཉིས་ཀ་ ཚང་ སྟེ་དཀྱིལ་འཁོར་ གྱི་ དུར་ཁྲོད་ བརྒྱད་ དང་ བཅས་པ་རང་ གི་ ལུས་ ལ་ གནས་པ་ དེ་ལམ་ གྱིས་ བསྒོམ་པ ས་ ཕུང་ ཁམས་ སྐྱེ་མཆེད་ རྣམ་པ ར་ དག་པ་དེ འི་ འཁོར་ལོ་ ལ་ ཐ་དད་ མེད་པ འི་ ཕྱིར་གསང་བ་ རྒྱ་མཚོ་ ལ ས །སྐུ་གསུམ་ ཡོངས་སུ་ གྲུབ་པ་ གསང་སྔགས་ ཐེག་པ་ སྟེ །སྐུ་གསུམ་ ཉིད་ ལ་ འཇུག་པ་ ལམ་ གྱི་ ཐེག་པ་ ཡིན །_།སྐུ་གསུམ་ འདུ་ འབྲལ་ མེད་པ་ འབྲས་བུ འི་ ཐེག་པ འོ །_།ཞེས་ གསུངས་ སོ །_།རྡོ ༽༽_ ཐུབ་དབང་ དང་ རྡོ་རྗེ་ འཆང་ གི་ བསྟན་པ་ མདོ་སྔགས་ གཉིས་ ཐ་དད་ ཡིན་པ ས་ སྔགས་ ལ་ ཚུལ་ཁྲིམས་ མི་ དགོས་ ཏེ །གསང་འདུས་ ལ ས །འདོད་པ འི་ ཡོན་ཏན་ རྣམ་ ལྔ་ ལ །།བརྟེན་ ནས་ མྱུར་ དུ་ འགྲུབ་པ ར་ འགྱུར །ཞེས་ དང༌ །ཁྱོད་ ཀྱི་ སྲོག་ཆགས་ བསད་པ ར་ བྱ །ཞེས་ སོགས་ གསུངས་པ ས་ སོ་ ཟེར་ རོ །འདི ར་ ནི་ གསང་སྔགས་ ལ་ ནི་ ཚུལ་ཁྲིམས་ མེད་ ཀ་མེད་ ཡིན་ ཏེ་ཚེ་ གཅིག་ རྡོ་རྗེ་ འཆང་ གི་ གོ་འཕང་ ཐོབ་པ ར་ བྱེད་པ་ ལ་སྐྱོན་ སྤོང་བ་ དང་ ཡོན་ཏན་ སྒྲུབ་ དགོས་ ཤིང་དེ འང་ སྒོ་གསུམ་ ཉེས་པ་ ཕྲ་མོ ས་ ཀྱང་ མི་ གོས་པ ར་ བྱེད་ དགོས་པ འི་ ཕྱིར །དུས་འཁོར་ ལ ས །བསླབ་པ་ ལྔ་ ཡི་ གནས་ ལྡན་ ཞིང༌ །_།བྱང་ཆུབ་ སེམས་དཔ འི་ སྡོམ་པ་ དང༌ །_།གསང་སྔགས་ དམ་ཚིག་ ལྡན་པ་ ནི །_།དགེ་བསྙེན་ རྡོ་རྗེ་ འཛིན་པ་ ཡིན །_།བསླབ་པ་ བཅུ་ ཡི xབྱང་ཆུབ་ སེམས་དཔ འི xགསང་སྔགས xདགེ་ཚུལ xབསླབ་པ་ བྱེ་བ འི xབྱང་ཆུབ xགསང་སྔགས xདགེ་སློང་ xཅེས་ དང༌ །དང་པོ ར་ གསོ་སྦྱོང་ སྦྱིན་པ ར་ བྱ །ཞེས་པ་ ནས །དེ་ རྗེས་ ཀྱེ་ རྡོ་རྗེ་ རྩམ །ཞེས་ དང༌ །འཇམ་དཔལ་ རྩ་རྒྱུད་ ལ ས ༑ཚུལ་ཁྲིམས་ འཆལ་བ ས་ སྔགས་ མི་ འགྲུབ །ཅེས་ སོ །_།རྡོ ༽༽_ སྔགས་ ནི་ འཇུག་ ལམ་ འབྲས་བུ་ བདེ་བ ས་ འདོད་ཡོན་ སྤྱད་པ ས་ གྲུབ་ ཟེར །འདི ར་ ནི་ འདོད་པ ས་ བར་ དུ་ གཅོད་པ འི་ སྟེང་ དུ་མདོ་སྔགས་ གཉིས་ཀ་ གཅིག་པ་ ཡིན་ ཏེ་ མཚན་ཉིད་ དུ༌ །ཡུམ་ ལ ས་ འདོད་པ ས་ ནི་ ཚངས་པ འི་ འཇིག་རྟེན་ དུ་ སྐྱེ་བ་ ལ་ ཡང་བ ར་ དུ་ གཅོད་ ན་མྱ་ངན་ ལ ས་ འདས་པ་ ལ ས་ ལྟ་ སྨོས་ ཀྱང་ ཅི་ དགོས་ ཞེས་ དང༌ །འདོད་པ་ རྣམས་ ནི་ དུག་ གི་ ལོ་མ་ ལྟ་བུ འོ །རལ་གྲི འི་ སོ་ ལྟ་བུ འོ །_།མི་གཙང་བ འི་ སྦུབས་ ལྟ་བུ འོ །_།ཞེས་ དང༌ །སྔགས་ ལ་ ཚུལ་ཁྲིམས་ མེད་ ཐབས་མེད་པ་ བཤད་ མ་ ཐག་པ་ ཉིད་ ཀྱི་ ཕྱིར་ དང་བརྟག་པ་ གོང་མ་ ལ ས །བཅོམ་ལྡན་ མ་ དག་པ་ གང་ ལགས །བཀའ་ རྩལ་པ་ གཟུགས་ ལ་སོགས་པ་ ལྔ འོ །_།ཅི་ཕྱིར་ ཞུས་པ ས །གཟུགས་འཛིན་ གྱི་ ངོ་བོ་ ཡིན་པ འི་ ཕྱིར་ རོ །_།ཞེས་ དང༌ །དཀོན་ རྩེགས་ ལ ས །བར་ དུ་ གཅོད་པ འི་ ཆོས་ གང་དག _།སྐྱེ་བོ་ རྣམས་ ལ་ ངས་ བསྟན་པ །_།དེ་ ཀུན་ ཡང་དག་ ཉིད་ དུ་ སྨྲ །_།གཞན་ དུ་ གྱུར་པ་ ཡོད་ མ་ ཡིན །_།ཅེས་ སོ །འདོད་པ་ བསྟེན་པ ར་ གསུངས་པ་ ནི །གང་ཟག་ གཉེན་པོ་ སྟོབས་ དང་ ལྡན་ ན་རྒྱུད་ ལ་ མི་ གོས་པ་ འདམས་ ཀྱི་ པདྨ་ བཞིན་ ཡིན་ ཀྱང༌ །དེ་ མཚན་ཉིད་ ལ ས་ ཤིན་ཏུ་ དཀའ་བ ར་ སྣང་ངོ༌ །_།དེ འི་ ཕྱིར་ རལ་གྲི་ དང་ འདྲ་བ འི་ སྔགས་ འདི་ ཕུབ་ ལྟ་བུ འི་ ཚུལ་ཁྲིམས་ ལ་མ་ བརྟེན་ ན་ ཉམས་པ་ ཡིན་ ནོ །རྡོ ༽༽_ འདུལ་བ་ གཞི་ སྤོང་བ་ མཚན་ཉིད་ གཞི་ སྦྱོང་བ་ སྔགས་ གཞི་ བསྒྱུར་བ་ སྟེའང་འདོད་ཆགས་ ལམ་ དུ་ བསྒྱུར་བ་ བདེ་བ འི་ ཏིང་ངེ་འཛིན་ འབྲས་བུ་ ལོངས་སྐུ །ཞེ་སྡང་ དང་ གཏི་མུག་ ལམ་ དུ་ བསྒྱུར་བ་གསལ་བ་ དང་ མི་ རྟོག་པ འི་ ཏིང་ངེ་འཛིན་འབྲས་བུ་ སྤྲུལ་སྐུ་ དང་ ཆོས་སྐུ ར་ བསྒྱུར་བ ས་རྣམ་རྟོག་ ཡེ་ཤེས་ ཀྱི་ རོལ་པ་ ཡིན་ ཟེར །འདི ར་ ནི་ སྔགས་ ཀྱི་ ལམ་ གྱིས་ མི་དགེ་བ་ དགེ་བ ར་ བསྒྱུར་བ ར་ འདོད་ ན་འདི ར་ འགྱུར་བ འི་ སྐབས་མེད་ དེ་གདོད་ ནས་ དཀྱིལ་འཁོར་ གྱི་ འཁོར་ལོ་ ཡིན་ ཀྱང་གློ་བུར་ གྱི་ དྲི་མ ས་ བསྒྲིབས་པ་ བསལ་བ འམ་ སྦྱོང་པ འི་ ལམ་པ་ ཡིན་པ འི་ ཕྱིར །ཀྱེ་རྡོར་ ལ ས །སེམས་ཅན་ རྣམས་ སངས་རྒྱས་ ཏེ །_།འོན་ཀྱང་ གློ་བུར་ དྲི་མ ས་ བསྒྲིབས །_།དེ་ཉིད་ བསལ་ ན་ སངས་རྒྱས་ ཉིད །ཅེས་པ ས་ སྦྱོང་བ འི་ ལམ་པ་ ཡིན་ ཅིང༌ །དེ ར་ མ་ཟད་ མཚན་ཉིད་ དུའང་ ཕལ་ཆེན་ ལ ས །སྟོང་གསུམ་ དར་ཡུག་ དང་ སྙིང་པོ འི་ མདོ ར་ དཔེ་ དགུ ས་ བསྟན་པ་ སོགས་སྤོང་བ འི་ ལམ་པ་ མིན་ བསྒྱུར་བ འི་ ལམ་ ཡིན་ ནོ །_།དེ་ལྟར་ མིན་པ་ བསྒྱུར་བ འི་ ལམ་པ་ ཡིན་ ན་ཀུན་ ནས་ ཉོན་མོངས་ སོགས་ བདུད་ བཅོམ་ ཕྱིར་ བཅོམ་ལྡན་འདས་ ཞེས་ བྱ་ ཞེས་པ་ དང་འགལ་བ་ དང་ དུག་ གསུམ་ གཞི་མ་གྲུབ་པ ས་ བསྒྱུར་བ ས་ འགྱུར་ ན་མི་དགེ་ དགེ་བ ར་ འགྱུར་ ཏེ་རྒྱུ་འབྲས་ ཀྱི་ བབ་ དང་ འགལ་བ འི་ ཕྱིར་ སྤོང་བ་ ཡིན་ ན འང་སྙིང་པོ་ རྟག་པ་ དང་ འགལ་བ འི་ ཕྱིར་སྔགས་ སུ་ མི་འགྱུར་བ ས་ སྦྱོང་བ འི་ ལམ་པ་ ཡིན་ ནོ །རྡོ ༽༽_ སྔགས་ སུ་ མི་དགེ་བ་ ཐབས་མཁས་པ ས་ སྤྱད་པ ས་ དགེ་བ ར་ འགྱུར་ ཏེ་འདོད་ཆགས་ ཞེ་སྡང་ གཏི་མུག་ དང་ །ང་རྒྱལ་ ཕྲག་དོག་ མི་ སྤང་ ངོ་ ཞེས་ ཟེར་ རོ །འདི ར་ ནི་ འདུལ་བ ར་ མི་དགེ་བ་ བཀག་པ་སྔགས་ སུ འང་ མི་དགེ་ ཞིང་ སྤང་བྱ་ ཡིན་པ ས་དགེ་བ ར་ མི་ འགྱུར་ ཏེ་སངས་རྒྱས་ ཀྱི་ གནས་ དང་ གནས་མིན་ མཁྱེན་པ འི་ ཡེ་ཤེས་ ཀྱི་ གཟིགས་པ་ དང་ལམ་ གྱི་ གེགས་ དམ་བཅ ས་པ་ ལ་ལྷ་ དང་ བཅས་པ འི་ འཇིག་རྟེན་ ན་ སུ ས་ ཀྱང་ རྒོལ་བ་ མེད་པ འི་ ཕྱིར་ དང་རྡོ་རྗེ་ འཆང་ གི་ རྒྱུད་ དཀྲུགས་ ལུང་ བཅུ ས་ མན་ངག་ གབ་པ་ དང་ མཐའ་ དྲུག་ ལ ས་དགོངས་པ་ ཅན་ དང་ སྒྲ་ ཇི་བཞིན་ མ་ཡིན་པ་ དང༌ །ཚུལ་བཞིན་ ལ ས་ སྦས་དོན་ སྤྱི་ བཤད་ ཤས་ ཆེ་བ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང་གསང་ འདུས་ རིགས་བཞི འི་ དམ་ཚིག་ གི་ སྲོག་ཆགས་ གསོད་པ་ སོགས་ བཞི འི་ དོན་དགོངས༌པ་ ལུང་བསྟན་ དུ་ བཀྲལ་ ཏེ །མ་ བྱིན་པ་ ལ་ བྱང་ཆུབ་ སེམས །ཀུན་རྫོབ་ སྟོན་པ་ རྫུན་སྨྲ་བ །_།ཕུང་པོ་ སྲོག་ཆགས་ གྱུར་པ་ སྟེ །_།ཚངས་པ འི་ གནས་ བཞི་ བུད་མེད་ ཡིན །_།དགོངས་པ་ ཡིས་ ནི་ བཤད་པ་ ལ །_།བྱིས་པ་ རྣམས་ ནི་ ཡི་ག ར་ རྟོགས །_།རྗེ་ རྗེ་_ ཐེག་པ ར་ གནས་ འདོད་ ཀྱང་ །_།ཆོས་ཉིད་ དེ་ ཡི་ ཡེ་ཤེས་ སོ །_།ཞེས་ དང༌ །དགོངས་པ འི་ ཚིག་ ལ་ རྨོངས་པ་ རྣམས །_།གསུངས་པ འི་ དོན་ འདི་ མ་ རྟོགས་ ནས །_༑གསུངས་པ་ འདི་ ལ ས་ གཞན་ མིན་ ཞེས །_།དེ་ནས་ ཇི་བཞིན་ སྨྲ ར་ འཛིན་ ཏོ །ཞེས་པ ས་ དུག་ གསུམ་ འབྲེལ་བ འི་ ལ ས་ སྔགས་ སུ འང་ མི་དགེ་བ་ ལ་དེ་ མེད་ ན་ སྔགས་ སུ འང་ དགེ་བ་ ཡིན་ ནོ །ལྷན ༽༽_ གཞི་ སྡེ་སྣོད་ གསུམ་ ལམ་ སོ་ བྱང་ སོགས་ ཀྱི་ གང་ཟག་ དབང་པོ་ ཐ་མ་ འབྲིང་ རབ་ གསུམ་ གྱིས་ བསླབས་པ ས །འབྲས་བུ་ ཞི་བདེ་ མི་ གནས་པ འི་ མྱང་འདས །ཟུང་འཇུག་ བདེ་ཆེན་ གསུམ་ ཐོབ་ ཟེར །འདི ར་ རྡོ་རྗེ་ ཐེག་པ འི་ ལམ་རིམ་ གྱི་ བསླབ་པ་དེ་ གསུམ་ ཀ འི་ གང་ཟག་ ཆོས་ འབྲས་བུ་ སོགས་ བཟང་ངན་ བསལ་ བཞག་ མེད་པ ས་ ཐམས་ཅད་ དགོས་ ཏེ །གང་ཟག་ གཅིག་ སངས་རྒྱས་པ འི་ རྒྱུ་རྐྱེན་ ཐབས་ ཀྱི་ རིམ་པ་ ཡིན་པ འི་ ཕྱིར །དཔེར་ན་ རྒྱལ་པོ་ མཁས་པ ས་ ཁྲིམས་ འཆའ་བ་ བཞིན་ ནོ །_།དེ་ལྟར་ ཡང་ བརྟག་ གཉིས་ ལ ས །དང་པོ་ གསོ་སྦྱོང་ སྦྱིན་པ ར་ བྱ །སོགས་ གསུངས་པ ས །སྔགས་སྡོམ་ མན་ཆད་ ལ་ བསླབ་པ་ གསུམ་ ལམ་རིམ་ སྤྱི་ཁྱབ་ ཏུ་ དགོས་པ་ ཁོ་ན་ ཡིན་ ནོ །ལྷན ༽༽_ སོ་ བྱང་ སྔགས་ གསུམ་ ལམ་ མི་ གཅིག་པ་ ཐ་དད་ ཡིན་ ཟེར་ ཡང༌ །འདི ར་ ཕར་ཕྱིན་ དྲུག་ ནི་ མདོ་སྔགས་ ཀྱི་ ཐེག་པ་ གསུམ་ ཀ འི་ ལམ་ ཡིན་ ཏེ་ཚོགས་ གཉིས་ མ་ བརྟེན་པ ར་ སངས་རྒྱས་པ འི་ ཐབས་མེད་པ འི་ ཕྱིར །དེ འང་ དང་པོ་ གསུམ་བསོད་ནམས་ ཐ་མ་ གཉིས་ ཡེ་ཤེས་ ཀྱི་ ཚོགས་ བརྩོན་འགྲུས་ གཉིས་ ཀྱི་ གྲོགས་དཔལ་མགོན་ ཀླུ་སྒྲུབ་ ཀྱི་ དབུ་མ་ རིན་ཆེན་ ཕྲེང་བ་ ལ ས །མདོར་ན་ སངས་རྒྱས་ བསྟན་ འདི་དག _།ཕ་རོལ་ ཕྱིན་ དྲུག་ ཁོ་ན་ ཡོད །ཅེས་པ་ སོགས་ རྒྱ་ ཆེ ར་ གསུངས་པ ས་ ཤེས་ སོ །རྡོ ༽༽_ ཉོན་མོངས་ སངས་རྒྱས་ ཀྱི་ གདུང་ དང་རིགས་ སུ་ ཕར་ཕྱིན་ དང་ སྔགས་ གཉིས་ཀ་ ནས་ བཤད་ ཟེར་ རོ །_།ཉོན་མོངས་པ་ དག་པ འམ་ བྲལ་བ འི་ འབྲས་བུ་ བདེ་བ ར་ གཤེགས་པ་ ཉིད་ དེ་གཞི་ བསྒྱུར་བ འི་ ལམ་པ་ མི་ སྲིད་པ་ གོང་ དུ་ བསྒྲུབས་ ཟིན་པ འི་ ཕྱིར་ཀུན་ ཏུ་ ཁྭ་ ཀྱི་ རྒྱུད་ ལ ས །གཏི་མུག་ རྣམ་དག་ བསྒོམ་པ་ ཡི །_།རྣམ་པ ར་ སྣང་ མཛད་ ཉིད་ དུ་ འགྱུར །_།ཞེ་སྡང་ རྣམ་དག་ བསྒོམ་པ་ ཡི །_།མི་བསྐྱོད་པ་ ནི་ ཉིད་ དུ་ འགྱུར །_།ཕྲག་དོག་ རྣམ་དག་ བསྒོམ་པ་ ཡི །_།དོན་ཡོད་ གྲུབ་པ་ ཉིད་ དུ་ འགྱུར །_།ང་རྒྱལ་ རྣམ་དག་ བསྒོམ་པ་ ཡི །_།རིན་ཆེན་ འབྱུང་ ལྡན་ ཉིད་ དུ་ འགྱུར །ཞེས་ དང༌ །མགོན་པོ་ འབྲི་གུང་པ་ ཆེན་པོ ས །དགྲ་གཉེན་ དུ་ ཆོད་པ འི་ དཔའ་བོ་ དང་ །_།གཉེན་ སྟོང་པ ར་ རྟོགས་པ འི་ མཁའ་འགྲོ་ གཉིས །_།སེམས་ འགྱུར་བ་ མེད་པ འི་ རྣལ་འབྱོར་པ །_།དུས་རྒྱུན་ ཆད་ མེད་པ་ སྒོར་ རོ་ རོ །_།ཞེས་ དང༌ །དཀོན་མཆོག་ སྤྲིན་ ལ ས །སྲིད་པ འི་ མྱ་ངན་ སྒྲོལ་བ་པོ །_།ཉོན་མོངས་ བསྒྲལ་ ལ་ ཕྱག་ འཚལ་ ལོ །_།ཞེས་ དང༌ །བྱང་ཆུབ་ སྙིང་པོ ར་ བཞུགས་པ་ ན །_།འདོད་ཆགས་ ཞེ་སྡང་ གཏི་མུག་ དང་ །_།དྲི་མ་ གཞན་ ཡང་ རྣམ་ མང་པོ །_།ཁྱོད་ ཀྱི་ ཡེ་ཤེས་ མེ་ ཡིས་ བསྲེགས །ཞེས་པ ས་དུག་ གསུམ་ སྦྱོང་བྱེད་ ལམ་ གྱིས་ སྦྱངས་པ ས་བྲལ་འབྲས་ སྐུ་ དང་ ཡེ་ཤེས་ མཛད་ ཕྲིན་ རྒྱ་མཚོ་ ལྟ་བུ་ འབྱུང་བ ས་རིགས་ དང་ གདུངས་ ཞེས་ གསུངས་ སོ །_།གཞན་ དུ་ ཉོན་མོངས་ ཉིད་ མ་ སྦྱངས་ ན་སངས་རྒྱས་ ཀྱི་ གདུང་ དུ་ ལྟ་ཅི་ མཐོ་རིས་ ཀྱི་ གདུང་ དུའང་ མི་ འགྱུར་ ཏེ །ངན་སོང་ གི་ གདུང་ ཡིན་པ ས་ སོ །ལྷན ༽༽_ དུག་ གསུམ་ གྱིས་ རིམ་བ་ ཞིག་ རྩ་ རླུང་ ཐིག་ལེ་ གསུམ་ མ་ དག་པ ས་དག་པ ར་ བྱེད་ དགོས་ ཟེར་བ ས་དེ་ ངེད་ དང་ མཐུན་ ཀྱང་འདི ར་ རྩ་ རླུང་ ཐིག་ལེ་ ནི་ སྙིགས་མ་ སྟེ་ དྲུག་ དང་ བཅས་པ་དེ་ ཟབ་ སྟེ་ རྩ་ རླུང་ མ་ དག་པ འི་ གང་ཟག་ ལ ས་ དག་པ འི་ སྐུ་ དང་ ཡེ་ཤེས་ འབྱུང་ ཞིང༌ །གཞན་ དུ་ ན་ དག་ རྒྱུ འི་ དེ་ གསུམ་ མེད་ ན་དག་པ འི་ འབྲས་བུ་ མི་ འབྱུང་ སྟེ་རྒྱུ་ མེད་པ འི་ འབྲས་བུ་ བཞིན་ ནོ །_།དེ་ལྟར་ ཡང་ འོད་སྲུང་ གིས་ ཞུས་པ་ ལ ས །ཇི་ལྟར་ གྲོང་ཁྱེར་ དབུས་ ཀྱི་ མི་གཙང་ ལུད །_།དེ་ ནི་ བུ་རམ་ཤིང་པ འི་ ཞིང་ ལ་ ཕན །_།དེ་བཞིན་ བྱང་ཆུབ་ སེམས་དཔ འི་ ཉོན་མོངས་ ལུད །_།རྒྱལ་ དང་ རྒྱལ་བ འི་ ཆོས་ ལ་ ཕན་པ ར་ བྱེད །ཅེས་པ་ བཞིན་ རྩ་ རླུང་ ཐིག་ལེ་ མ་ དག་པ་ འདམ་རྫབ་ དང་ འདྲ་བ་ དེ་ རྒྱུ་ བྱས་རྐྱེན་ བླ་མ་ དམ་པ འི་ གདམས་ངག་ ལ་ བརྟེན་ ནས་བརྩོན་འགྲུས་ བརྩམས་པ ས་ དག་པ་ ཐོབ་པ ར་ འགྱུར་ རོ ༑_༑མ་ དག་པ་ དེ་ སེམས་ཅན་ ཐམས་ཅད་ ལ་ ཡོད་ ཀྱང་རྐྱེན་ མ་ཚང་ བས་ དེ་ལྟར་ མི་ འགྱུར་ ཏེ །རྩོལ་བ་ མ་ བྱས་པ འི་ གསེར་རྡོ་ བཞིན་ ནོ །རྡོ ༽༽_ སྔགས་ ཀྱི་ མངོན་སྤྱོད་ ཀྱིས་ གདུག་པ་ ཅན་ སྒྲོལ་ དགོས་པ ར་ གསུངས་པ་ སྒྲ་ ཇི་བཞིན་པ་ ཡིན་པ ས་ཉེས་པ ར་ མི་འགྱུར་བ ས་ གནང་ བར་ འདོད་ དོ །འདི ར་ ནི་ སྔགས་ ཀྱི་ མཐུ འམ་ ནུས་པ་ བསྟན་ ཙམ་ ལ ས་མངོན་སྤྱོད་ དངོས་ སུ་ གནང་བ་ མེད་ དེ་སྦྱོར་བ་ ཞེ་སྡང་ ཡིན་པ འི་ ཕྱིར་ དང༌ །དེ་ གནས་ དང་ གནས་མིན་ མཁྱེན་པ འི་ ཡེ་ཤེས་ དང་མི་ འཇིགས་པ་ དམ་བཅ ས་པ་ དང་ །_།_ འགལ་བ འི་ ཕྱིར་འཇམ་དཔལ་ རྩ་རྒྱུད་ ལ ས །བྲམ་ཟེ་ ཙ་ ནག་ སྐྱ་ གཤིན་རྗེ འི་ ཤེད་ ཀྱི་ རྣལ་འབྱོར་པ་ ཞིག་ རྒྱལ་པོ་ ཟླ་བ ས་ བླ་མཆོད་ དུ་ བྱས་ ནས་མངོན་སྤྱོད་ ཀྱིས་ དགྲ་ མང་པོ་ བསད་པ ས་ལྷ་ དེ་ ཡི་ གཟུགས་ བཟུང་ ནས་ དམྱལ་བ ར་ སྐྱེ་བ ར་ གསུངས་ ན །གཙང་ བཙན་ དང་ པེ་ ཧར་ སོགས་ ལ་ རྟེན་ ནས་་སྲོག་གཅོད་པ་ ངན་སོང་ དུ་ སྐྱེ་བ་ ལྟ་ སྨོས་ ཀྱང་ ཅི་ དགོས །འོ་ན་ མ་ གནང་ ངམ་ ཞེ་ན །བསད་པ་ དག་ གསོ་ ནུས་པ་ རྣམ་ཤེས་ སྤར་ ནུས་པ་ཆོས་ ཀུན་ མཉམ་ཉིད་ དུ་ རྟོགས་པ་ ཇོ་བོ་ རྗེ་ དང༌ །_ རྗེ་བཙུན་ མི་ལ །_ སློབ་_དཔོན་ པདྨ་ ལྟ་བུ་ ཞིག་ གི་ མཛད་པ་ སྟེ་གཤིན་རྗེ་ མེ་ རུ་ རྩེ འི་ རྒྱུད་ ལ ས །རང་རིག་ གསལ་བ འི་ ཐུགས་རྗེ་ ཡི །_།ཉོན་མོངས་ བསྒྲལ་བ་ མ་གཏོགས་པ །_།ཞེ་སྡང་ གདུག་པ འི་ སེམས་ ཀྱིས་ སྒྲོལ །_།དམྱལ་བ འི་ སྐྱེ་བ་ མནར་མེད་ ལེན །ཅེས་ སོ །༑རྡོ ༽༽_ རྡོ་རྗེ འི་ དམྱལ་བ་ ནི་ རྒྱུ འི་ ཐེག་པ ར་ བཤད་པ འི་ བཅོ་བརྒྱད་ ལ ས་ གུད་ ན་ སྡུག་བསྔལ་_ ལག་པ ར་ ཆེ་བ་ ཞིག་ ཡོད་ ཟེར །འདི ར་ ནི་ དེ་ ལ་ ལོགས་ སུ་ མེད་ དེ་མནར་མེད་ ལ་སོགས་ བཅོ་བརྒྱད་ དེ་ རྣམས་ ཡིན་ ཏེ་མི་གཡོ་བ འི་ རྟོགས་པ་ དང་ བླ་མ་ ལྔ་ བཅུ་པ་ ལ ས །མནར་མེད་ ལ་སོགས་ འཇིགས་རུང་བ འི །_།དམྱལ་བ་ བསྟན་བ་ གང་ཡིན་པ །_།སློབ་དཔོན་ ལ་ ནི་ སྨོད་པ་ རྣམས །_།དེ ར་ ནི་ ངེས་པར་ གནས་པ ར་ བསྟན །ཅེས་ དང༌ །རྡོ་རྗེ་ གུར་ ལ ས །དེ་ ཚེ་དབང་ བསྒྱུར་ མཆོག་ཐོབ་པ འི །_།སློབ་མ ས་ བླ་མ འི་ བཀའ་ འདས་ ན །_།འཇིག་རྟེན་ འདི ར་ ནི་ སྡུག་བསྔལ་ ཞིང༌ །_།ཕ་རོལ་ མནར་མེད་ གནས་པ ར་ འགྱུར །ཞེས་ དང་ །གསང་སྔགས་ སུ་ ངུ་འབོད་ ལ་རྡོ་རྗེ འི་ དམྱལ་བ་ མནར་མེད་ དུ་ བཞག་པ་ ཡང་ ཡོད་ དེ །དུས་འཁོར་ གྱི་ འགྲེལ་བ་ དྲི་མེད་ འོད་ ལ ས །རླུང་ གི་ དཀྱིལ་འཁོར་ གྱི་ དབུས་ སུ་ ངུ་འབོད་ དང༌ །དེ འི་ སྟེང་ དུ་ མུན་པ་ ཆེན་པོ་ དང༌ །དེ་བཞིན་ དུ་ མེ་ དཀྱིལ་ ལ་ མེ འི་ དམྱལ་བ་ དང་ངུ་བ་ མི་བཟད་པ་ ཆུ་ དཀྱིལ་ ལ་ འདམ་ གྱི་ ཆུ་ དང་ བྱེ་མ འི་ ཆུ །ས་ དཀྱིལ་ གྱི་ ཕྱེད་ འོག་མ་ ལ་ གསེག་མ འི་ དམྱལ་བ་ སྟེ །གནས་ བདུན་ ལ་ ཚ་གྲང་ གི་ དམྱལ་བ་ འཁོར་བཅས་འདུ་བ ར་ ཡང་ གསུངས་ སོ །རྡོ ༽༽_ དམ་ཚིག་ འདས་ ནས་ རྡོ་རྗེ འི་ དམྱལ་བ ར་ སྐྱེས་ ན་ཐར་པ་ དང་ ཐོབ་པ འི་ དུས་ མེད་ ཅེས་ ཟེར་ ཡང་འདི ར་ ནི་ སློབ་དཔོན་ རྒྱུད་ ཚོད་ མཐོ་ ན་ མྱུར་ དུ་ འདྲེན་པ་ ཡིན་ ཏེ །ཆོས་ ལ་ བརྟེན་པ འི་ བསྐུལ་བ་ ཡིན་པ འི་ ཕྱིར །དཔེར་ན་ ཐུབ་དཀའ་ གཞོན་ནུ ས་ ཐར་པ་ ནག་པོ ར །དེ་བཞིན་ཉིད་ དེ་ མ་ བཅོ ས་ ན །_།ཆེན་པོ་ བཞི་ ལ་ གནས་ བཅས་ ཀྱང་ །_།ནམ་མཁའ་ ལ་ ནི་ སྤྲིན་ བཞིན་ དུ །ཞེས་ སོགས་ བསྟན་པ་ སྒྲ་ ཇི་བཞིན་ དུ་ བཟུང་ ནས་ལས་མི་ ཟད་པ་ ལ་ སྤྱད་པ ས་ ངན་སོང་ དུ་ ལྟུང་བ་དད་ འཕགས་ འཇིགས་བྱེད་ ཆེན་པོ ར་ སྤྲུལ་ ནས་ དྲང་བ་ བཞིན་ ནོ །ལྷན ༽༽_ སྔགས་ ཀྱི་ རྩ་ལྟུང་ སློབ་མ ས་ སློབ་དཔོན་ ལ་ བརྙས་ ན་ལྟུང་བ་ དང་པོ་ འཕོག་པ ས་སློབ་མ འི་ དམ་ཚིག་ ཤིན་ཏུ་ གཉེན་ ལ་སློབ་དཔོན་ གྱིས་ ནི་ སློབ་མ ར་ དེ་ལྟར་ མི་ གཉེན་ ཟེར །འདི ར་ ནི་ དཔོན་སློབ་ གཉིས་ཀ་ ཕན་ཚུན་ དམ་ཚིག་ གཉེན་ མི་ གཉེན་ མཉམ་པ་ ལ་ གཅིག་ ཡིན་ ཏེ །སློབ་དཔོན་ གྱིས་ སློབ་མ ར་ བརྙས་ ན་ རྩ་ལྟུང་ བཅུ་གཉིས་པ་ ཡིན་པ འི་ ཕྱིར་ དང་ས ། ཉེས་པ་ བྱས་ ན་ བླ་མ་ ཡིན་ ཀྱང་ འབྲས་བུ་འབྱུང་བ་ རྟེན་འབྲེལ་ ཡིན་པ འི་ ཕྱིར །དཔེ ར་ མས་ བུ་ བསད་པ་ དང༌ །བུས་ མ་ བསད་པ་ གཉིས་ཀ་ གང་ཡིན་ ཡང་ དམྱལ་བ ར་ ལྟུང་བ་ བཞིན་ ནོ །གསང་སྔགས་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ འི་ ཚིག་རྐང་ ཉེར་ བརྒྱད་ ལྷན་ཐབས་ ཚིག་རྐང་ བཅུ་བདུན་ བཅས་ ཀྱི་ འགྲེལ་བཤད་ བྱེད་པ འི་ སྐབས་ ཏེ་ ལྔ་པ འོ །རྡོ ༽༽_ འགའ་ཞིག་ ཆོས་ རྒྱུད་པ་ མེད་པ འི་ ཉམས་མྱོང་ དང༌ །རྡོལ་ཆོས་ དཔེ་ དཀ ར་ བུ་ བཞི་ དང །ཤིང་ ཆོས་ གསོ་སྦྱོང་ ཡན་ལག་ བརྒྱད་པ །གནམ་ ཆོས་ ཏནྡྲ་ སྡེ་ བཅོ་བརྒྱད་ ལ་སོགས་པ་ཟབ་པ ར་ འཛིན་པ་ མང་ དུ་ བྱུང་ ཡང༌ །དེ་དག་ རྣམས་ ཚིག་དོན་ བཟང་ ཡང་བླ་མ་ བརྒྱུད་པ་ མེད་པ ས་ འབྲས་བུ་ མི་ འབྱིན་པ འི་ ཕྱིར །འདི ར་ ནི་ དམ་པ འི་ ཆོས་ གང་ཞིག་ བརྒྱུད་པ་ ནས་ བརྒྱུད་པ ར་ འབྲེལ་པ་དེ་ ཟབ་པ ར་ བཞེད་ དེ་དེ འང་ ཆོས་ ཐམས་ཅད་ ལུང་ དང་ བཅས་པ །ལུང་ མན་ངག་ དང་ བཅས་པ་ དགོས་པ ས་བརྒྱུད་པ འི་ བླ་མ་ ལ་མ་ བརྟེན་ ན་རང་ཉིད་ ཀྱི་ མི་ ཤེས་པ འི་ ཕྱིར་དཔེར་ན་ སངས་རྒྱས་ བཞིན་ ནོ །མདོ་ ལ ས་ ཀྱང༌ །སངས་རྒྱས་ ཆོས་ རྣམས་ དགེ་བ འི་ བཤེས་ ལ་ བརྟེན་ ཏོ་ ཞེས །_།ཡོན་ཏན་ ཀུན་ གྱི་ མཆོག་ མངའ་ རྒྱལ་བ ས་ དེ་སྐད་ གསུངས །ཞེས་ སོགས་ གསུངས་ ན་ སྔགས་ སུ་ རྒྱུད་ དཀྲུག་པ །ལུང་ བཅུ ས །མན་ངག་ གབ་པ འི་ ཕྱིར་ ལྟ་ སྨྲོས་ ཀྱང་ ཅི་ དགོས་དེ་ལྟར་ ཡང་ སཾ་ བྷུ་ ཊི་ ལ ས །ཡོན་ཏན་ ཐམས་ཅད་ རབ་ རྫོགས་ ཀྱང༌ །བླ་མ་ མེད་ ན་ སྲིད་མཐ ར་ མིན །ཅེས་པ ས་ སངས་རྒྱས་ ནས་ བརྒྱུད་པ འི་ ཆོས་ ཟབ་ ཅིང་ ངོ་མཚར་བ་ ཡིན་ ལ །དེ འང་ མཚན་ཉིད་ ལྡན་པ འི་ བླ་མ ར་ རག་ ལས་པ་ ཡིན་ ནོ །_།བླ་མ་ མ་ བརྟེན་པ ར་ རྡོལ་ཆོས་ སོགས་ ཀྱིས་ སྒོམ་ སྐྱེས་ ཀྱང་ཕལ་ཆེར་ འཇིག་རྟེན་པ འི་ ཏིང་འཛིན་ འབའ་ཞིག་ ཏུ་ འོང་བ ས་འཁོར་བ་ ལ ས་ ཀྱང་ མི་འདའ་ ན་ཐམས་ཅད་ མཁྱེན་པ་ ལྟ་ཅི་ སྨོས །དེས་ན་ རྣམ་པ ར་ དག་པ འི་ བརྒྱུད་པ་དེ་ འདྲ་བ་ ནི་ བཀའ་ བརྒྱུད་ རིན་པོ་ཆེ་ འདི་ ཡིན་ ཏེ །དེ འང་ ལྟ་བ་ རྣམ་པ ར་ དག་པ་ སངས་རྒྱས་ དང་ ཀླུ་ གྲུབ་ ནས་ བརྒྱུད་པ འི་ དབུ་མ །སྤྱོད་པ་ རྣམ་དག་ སངས་རྒྱས་ དང་ ཐོགས་མེད་ ནས་ བརྒྱུད་པ འི་ ཕར་ཕྱིན །རྒྱུད་པ་ ཆུ་བོ་ གཉིས་ འདྲེས་ ཇོ་བོ་ རྗེ་ དང་ །བླ་མ་ དྭགས་པོ་ ལྷ་རྗེ་ ཕག་གྲུ་ ཆོས་རྗེ་ འབྲི་གུང་པ་ ནས་ད་བར་ ཆོས་བརྒྱུད་ རྣམ་པ ར་ དག་པ །སྔགས་ ཀྱི་ ལྟ་སྤྱོད་ སྒོམ་ གསུམ་ དབྱེ ར་ མེད་ རྣམ་དག་ རྡོ་རྗེ་ འཆང་ ཏེ་ལོ་ན ས་ བརྒྱུད་པ འི་ ཟབ་ ལམ་ ཕྱག་རྒྱ་ ཆེན་པོ་ སྟེ་བརྒྱུད་པ་ དེ་ལྟར་ རྣམ་པ ར་ དག་པ་ ཡིན་པ ས་ ཟབ་བོ །རྡོ ༽༽ སྣང་བ་ སྣ་ཚོགས་ སུ་ སྣང་བ་ ཐམས་ཅད་ ཕྱི་དོན་ དུ་ སྒྲུབ་པ ས་བློ་ དང་ མ་ འབྲེལ་བ ར་ བྱེ་ སྨྲ་ སོགས་ འདོད་པ་ ཡོད་ ཀྱང་འདི ར་ ནི་ ཁམས་ གསུམ་ འཁོར་བ་ དང་ མྱང་འདས་ གསུམ་ གྱི་ ཆོས་མ་ ལུས་པ་ཀུན་ གྱི་ བཟང་ངན་ སྣང་བ་ ནི་ རང་ གི་ སེམས་ ཡིན་ ཏེ །སྣང་ མི་ སྣང་ དུ་ འཛིན་པ་ རང་ གི་ སེམས་ ཡིན་པ འི་ ཕྱིར །འོ་ན་ སྣང་ཡུལ་ ཡོད་པ ས་ སེམས་ ཡིན་ ནམ་ མེད་པ ས་ ཡིན །དང་པོ་ ལྟར་ ན་ ཡུལ་ ལྟར་ ཡོད་པ་ བཞིན་སེམས་ ཀྱང་ དེ ར་ ཐལ་བ འམ་སེམས་ བཞིན་ དུ་ ཡུལ་ ཀྱང་ མཐོང་ཆོས་ སུ་ མི་ རུང་བ ར་ འགྱུར་ རོ །_།གཉིས་པ་ ལྟར་ ན འང་ དོན་ཡོད་པ་ ལྟར་ འགྱུར་ རོ་ སྙམ་ ན་སྣང་བ་ ཕྱི་དོན་ དུ་ གྲུབ་པ་ མེད་པ ས་ ཡིན་ ཀྱང་བག་ཆགས་ འཁྲུལ་བ་ རྨི་ལམ་ གྱི་ སྣང་བ་ ལྟར་ཕྱི་ ནང་ གང་ཡང་ མ་ ཡིན་གང་ དུའང་ མ་གྲུབ་པ་རང་བཞིན་ མེད་པ ར་ སྨྲ་བ ས་ སྐྱོན་ དེ་དག་ མེད་ དོ །_།དེ་ལྟར་ ཡང་སློབ་ དཔོན་ འཕགས་པ ས་ རྡོ་རྗེ འི་ བསྟོད་པ་ ལ ས །སེམས་ རྟོགས་པ ས་ ནི་ བྱང་ཆུབ་ སྟེ །སེམས་ ནི་ འགྲོ་བ་ ལྔ་པོ་ ཡིན །_།བདེ་ དང་ སྡུག་བསྔལ་ མཚན་ཉིད་ དག _།སེམས་ལས་ མ་གཏོགས་ ཅུང་ཟད་ མེད །ཅེས་ དང་ །གུར་ ལ ས །ཡུལ་ དང་ དབང་པོ འི་ བྱེ་བྲག་ རྣམས །_།རྣམ་པ་ ཐ་དད་ མ་ མཆིས་ ཏེ ༑གཟུགས་ སོགས་ སྣང་བ ར་ གྱུར་པ་ ནི །རང་སེམས་ སྣང་བ་ ཁོ་ན འོ །_།ཞེས་པ ས་སྣང་བ འི་ ཡུལ་ ལུས་སེམས་ གསུམ་སེམས་ལས་ གཞན་ དུ་མ་ དམིགས་ ཤིང༌ །དེ ས་ བསྒྲུབས་པ འི་ དགེ་སྡིག་ གི་ འབྲས་བུ་ ཡང་ སེམས་ ལ་ སྣང་བ་ ཡིན་ ནོ །_།དེ་ལྟར་ སློབ་དཔོན་ ཟླ་བ ས །སེམས་ཉིད་ ཀྱིས་ ནི་ སེམས་ཅན་ འཇིག་རྟེན་ དང༌ །སྣོད་ ཀྱི་ འཇིག་རྟེན་ ཤིན་ཏུ་ སྣ་ཚོགས་ འགོད །_།འགྲོ་བ་ མ་ ལུས་ ལ ས་ ལ ས་ སྐྱེས་པ ར་ གསུངས །_།སེམས་ སྤང་ ནས་ ནི་ལ ས་ ཀྱང་ ཡོད་ མ་ ཡིན །གལ་ཏེ་ གཟུགས་ ཡོད་ མོད་ ཀྱི་ དེ་ ལ་ ནི །_།སེམས་ བཞིན་ བྱེད་པ་པོ་ ཉིད་ ཡོད་ མ་ ཡིན །_།དེ ས་ ནི་ སེམས་ལས་ གཞན་པ འི་ བྱེད་པ་པོ །_།བཟློག་པ འི་ གཟུགས་ ནི་ བཀག་པ་ མ་ ཡིན་ ནོ །_།ཞེས་ སོ །རྡོ ༽༽ ད་ལྟ འི་ བདེ་སྡུག་ སྔོན་ གྱི་ དགེ་སྡིག་ གི་ འབྲས་བུ་ སྨིན་པ་ ཡིན་ ཅིང་ད་ལྟ་ གང་ བསགས་པ་ ཕྱི་མ་ ལ ས་ ད་ལྟ་ འབྲས་བུ་ མི་ འབྱུང་ ཟེར །འདི ར་ ནི་ རྒྱུ་ དགེ་སྡིག་ གི་ ལ ས་ ལ་ འབྲས་བུ་ བདེ་སྡུག་ མྱོང་བ འི་ སྣང་བ་ ཐམས་ཅད་ཀུན་གཞི་ ལ་ འཁྲུལ་བ འི་ བག་ཆགས་ བཞག་པ་དེ་སྐད་ ཅིག་ གི་ བསམ་པ་ དེ འི་ རང་ གི་ སྣང །གཟུགས་ ཡིན་པ ས་ འཁྲུལ་སྣང་ སྟེ་ བག་ཆགས་ མ་ཟད་ རིང་ ལ་སྟོང་ མི་ སྲིད་པ་མཁྲིས་ནད་ མ་ འབྱང་བ ར་ དུ་ དུང་ལ་ སེ ར་ འཛིན་ མི་ ལྡོག་པ་ བཞིན་ ནོ །_།དེ་ལྟར་ ཡང་ མདོ་ དྲན་ ཉེར་ ལ ས །འཇིག་རྟེན་ དག་ ན་ ཇི་ལྟར་ སྣང་བ་ ཀུན །_།ཐམས་ཅད་ རང་ གི་ ལ ས༌ ལ༌ཉེ་ བར་ བྱུང༌ །ཞེས་ སོ །དེ འང་ འདུས་བྱས་ སྐད་ཅིག་མ་ ཡིན་པ་ ནི །རྒྱུ་རྐྱེན་ གྱི་ ཆོས་ རྣམས་ ཆོས་ཅན་ སྐད་ཅིག་མ་ ཡིན་ ཏེ །རྒྱུན་ གྱི་ འཇུག་པ འི་ ཕྱིར །དཔེར་ན་ ཕྲེང་བ་ རེ་རེ་བ་ མེད་པ འི་ བརྒྱ་ མི་ འབྱུང་བ་ བཞིན་ ནོ །_།སྣང་ གཟུགས་ ནི་ ཕྱག་རྒྱ་ ཆེན་པོ འི་ ཆོས་ཉིད་ འདི་ བསམ་པ འི་ རང་གཟུགས་ ཡིན་ ལ་ཆོས་ཅན་ བསམ་པ འི་ རང་གཟུགས་ ལ་ ནི་ གསུམ་ སྟེ །ད་ལྟ འི་ བསམ་པ འི་ རང་གཟུགས་ དང་ ཚེ་ འཕོས་པ་ དང༌ །_ ཚེ་ འཕོས་ ཀྱང་ ལུས་ འགྱུར་པ འི་ བསམ་པ་ སྐད་ཅིག་མ འི་ རང་གཟུགས་ སོ །_།དང་པོ་ ནི་དེ འང་ རང་རྒྱུད་ ལ་ དགེ་ མི་དགེ འི་ རྣམ་རྟོག་ གང་ སྐྱེས་པ འི་ འབྲས་བུ འམ་ ས་བོན་དེ་ དང་ རིགས་ མཐུན་པ་ ཞིག་ རྟོག་པ་དེ འི་ རང་གཟུགས་ སུ་ འགྲུབ་པ་ ནི་ ཞེ་སྡང་ གིས་ དམར་ ལམ་ གྱི་ སོང་བ་ དང །བྱམས་ སོགས་ ཀྱི་ བདེ་ལྡན་ གྱིས་ འགྲོ་བ་ ལྟ་བུ་ སྟེ་བྲམ་ཟེ་ ཏོ་ རྒྱ འི་ ནེ་ ཚོ འི་ ཁྱི་ དཀར་པོ་ དུང་ ལྟ་བུ འི་ གཏམ་རྒྱུད་ བཞིན་ ནོ །_།གཉིས་པ་ ནི་ སྔར་ དགེ་རྩ་ དཔག་མེད་ བསྒྲུབ་ ཀྱང་འཆི་ཁ ར་ མི་དགེ་བ ས་ མཚམས་ སྦྱར་ ན་ སོང་ དུ་ སྐྱེ་བ་ ཆོས་རྒྱལ་ མྱ་ངན་མེད་པ་ དང་ །དགེ་བ ས་ མཚམས་ སྦྱར་ ན་ འཕགས་རྒྱལ་ གྱི་ རྔོན་པ་ ལྟ་བུ་ བཞིན་ ནོ །_།གསུམ་པ་ ནི །ལུས་ འགྱུར་བ་ དགེ་ཚུལ་ ཀླུ ར་ གྱུར་པ འི་ གླེང་ གཞི་ བཞིན་ ནོ །_།དེ་ལྟར་ སེམས་ དང་ །_ ལ ས་ དང་ །ལ ས་ ཀྱི་ འབྲས་བུ ས་ རྟེན་འབྲེལ་ ལ ས་ འབྱུང་བ་ ནི་མོ་མཁན་ དང་ འདྲ་བ འི་ སེམས་ ལ་ སྣང་བ འི་ གཟུགས་ ཡིན་ ནོ །_།འདི་ གོ་ ན་ མཐོང་ཆོས་ སྐད་ཅིག་ ཏུ་ འབྱུང་བ་ ལ་ མཁས་པ་ དང༌ །སྐད་ཅིག་ ལ་ དགེ་ མི་དགེ འི་ བསམ་པ་ མི་རྟག་པ ར་ ཤེས་པ་ དང༌ །ལུས་ མི་རྟག་པ ར་ འགྱུར་བ་ ཤེས་པ ས་སྐྱོན་ སྤོང་ ཡོན་ཏན་ བསྒྲུབ་པ་ ལ་ ཚེགས་ མེད་པ ར་ འོང་བ་ ཡིན་ ཏེ །ཕར་ཕྱིན་ མངོན་རྟོགས་ རྒྱན་ ལ ས །ཇི་ལྟར་ སྐྱེས་པ འི་ ཟོ་ཆུན་ རྒྱུད །རྡོག་ ཐབས་ གཅིག་ གིས་ བསྐྱེད་པ་ ན །_།ཐམས་ཅད་ གཅིག་ ཅ ར་ འགུལ་བ་ ལྟར །སྐད་ཅིག་ ཡེ་ཤེས་ དེ་བཞིན་ ནོ །_༑ཞེས་ སོ །རྗེ་ འཇིག་རྟེན་ མགོན་པོ ས །རྗེ་ ཕག་མོ་ གྲུ་པ འི་ སྣང་བ་རང་སེམས་ ཀྱི་ ཁྲོད་ ནས་ང་ འབུས་ བསམ་པ འི་ རང་གཟུགས་ འདི་ རྙེད་པ་ ཡིན་ གསུངས །དེ འི་ ཕྱིར་ ན་ རྡོ་རྗེ འི་ གསུངས་ འདི ས་ སྣང་བ་ རང་རང་ སེམས་ གསལ་པོ ར་ བསྟན་པ་ ཡིན་ ནོ །རྡོ ༽༽_ གཤིས་ ལ་ མི་ གནས་ ཀྱང་ བལྟས་པ ས་ འགྱུར་ ཏེ །གཤིས་ མ་གྲུབ་པ་ དང་འཁྲུལ་སྣང་ ཡིན་པ་ དང་རང་བཞིན་ མ་ངེས་པ འི་ ཕྱིར་ ཞེས་ ཟེར་ རོ །འདི ར་ རྒྱུ་འབྲས་ ཀྱི་ གཤིས༌ ལ་ རྟེན་འབྲེལ་ ལ་ མི་ གནས་ ན་བལྟས་པ ས་ འགྱུར་ མི་ སྲིད་ དེ་གནས་ དང་ གནས་མིན་ མཁྱེན་པ འི་ ཡེ་ཤེས་ དང་ འགལ་བ འི་ ཕྱིར་ དང་ །རྒྱུ་འབྲས་ རྟེན་འབྲེལ་ གྱི་ གཤིས་ དང་ འགལ་བ་ དང༌ །ཆོས་ ཀྱི་ གྲགས་པ འི་ ཚད་མ ས་ ཀྱང་ མི་ འགྲུབ་པ འི་ ཕྱིར་ རོ །གལ་ཏེ་ འགྱུར་ ན་ སྡུག་བསྔལ་ བདེ་བ ར་ བལྟས་པ ས་དེ ར་ འགྱུར་ རིགས་ ན འང་ མངོན་སུམ་ དང་ འགལ་ ཞིང་མི་ འགྲུབ་པ འི་ ཕྱིར་ རོ །_།རྫུ་འཕྲུལ་ ཏིང་འཛིན་ གྱི་ སྟོབས་ ལ ས་སྐུ་ སྟོད་ ལ ས་ མེ་ འབར་བ་ སོགས་ དང་ནམ་མཁའ་ དངོས་པོ ར་ སྒྲུབ་པ་ སོགས་ ནི་རྒྱུ་ འདོད་ཡོན་ སྤོང་ ཞིང་བསམ་གཏན་ བསྒྲུབ་པ ས་དེ་དག་ འབྱུང་བ་ གཤིས་ ལ་ གནས་པ་རྒྱུ་ བསྒྲུབས་པ ས་ ཐོབ་པ་ ལ ས་གཞན་ དུ་ བལྟས་པ ས་ འགྱུར་ ན་སྤང་བླང་ ལ་ ལྟོས་ མི་ དགོས་པ འི་ ཕྱིར་ རོ །རྡོ ༽༽_ མཚན་ཉིད་ མི་ ལྡན་པ འི་ བླ་མ ས་ ཀྱང་ ཡོན་ཏན་ སྐྱེ་ ནུས་ ཏེ་ཀུན་དགའ་བོ་ རྒྱུན་ཞུགས་ ལ་ སློབ་པ ས་ དགྲ་བཅོམ་པ་ བྱུང་བ་ བཞིན་ ནོ་ ཞེས་ ཟེར་ རོ །འདི ར་ ནི་ མཚན་ཉིད་ དང་ མི་ ལྡན་པ འི་ བླ་མ ས་ ཡོན་ཏན་ སྐྱེད་ མི་ ནུས་ ཏེ་རང་ཉིད་ མ་ སྨིན་པ ར་ གཞན་ སྨིན་ མི་ ནུས་པ འི་ ཕྱིར །དཔེར་ན་ འཕོང་ མི་ ཤེས་པ འི་ སློབ་དཔོན་ གྱིས་ གཞན་ ལ་ དེ་ སྟོན་ མི་ ཤེས་པ་ བཞིན་ ནོ །_།དེ་ལྟར་ ཡང༌ །ཆེད་ དུ་ བརྗོད་པ ར །དམན་པ་ བརྟེན་པ ས་ མི་ དག་ རྣམ་པ ར་ འགྱུར །ཐད་ཀ ར་ བབས་པ་ བརྟེན་པ ས་ སོ་ ན་ གནས །_།གཙོ་བོ་ བརྟེན་པ ས་ དམ་པ་ ཐོབ་པ ར་ འགྱུར །_།དེ་ཕྱིར་ བདག་པ ས་ གཙོ་ གྱུར་ བརྟེན་པ ར་ བྱ ། ཞེས་ དང་ །སྡུད་པ ར ། སློབ་མ་ བཟང་པོ་ བླ་མ ར་ གུས་ ལྡན་ དེ་དག་ གིས །_།བླ་མ་ མཁས་པ་ རྣམས་ ལ་ རྟག་ ཏུ་ བརྟེན་པ ར་ བྱ །_།ཅི་ཕྱིར་ ཞེ་ན་ མཁས་པ འི་ ཡོན་ཏན་ དེ་ལས་ འབྱུང༌ །_།དེ་ལྟ འི་ མཚན་ཉིད་ ཕར་ཕྱིན་ ཐེག་པ ར །བཤེས་གཉེན་ དུལ་བ་ ཞི་བ་ ཉེར་ཞི་བ །_།ཡོན་ཏན་ ལྷག་པར་ བརྩོན་ བྱ་ ལུང་ གིས་ ཕྱུག _།དེ་ཉིད་ རབ་ཏུ་ རྟོགས་ ལ་ སྨྲ་མཁས་ ལྡན །_།བརྩེ་བ འི་ བདག་ཉིད་ སྐྱོ་ངལ་ སྤང་ ལ་ བརྟེན །_།རྟག་པ ར་ དགེ་བ འི་ བཤེས་གཉེན་ ནི །_།ཐེག་ཆེན་ དོན་ ལ་ མཁས་པ་ དང༌ །_།བྱང་ཆུབ་ སེམས་དཔ འི་ རྟུལ་ ཞུགས་ མཆོག _།ཅེས་ སོ །_།སྔགས་ བླ་མེད་ ལ ས ། དབང་ བཞི་ བསྐུར་བ འི་ བླ་མ་ ནི །ཞེས་ སོགས་ དང༌ །དུས་འཁོར་ ལ ས །སངས་རྒྱས་ ཞལ་ འདི་ གང་ གི་ ཐུགས་ དང་ ཞལ་ལ་ གནས་པ ར་ གྱུར་པ་ དེ་ ནི་ དཔལ་ལྡན་ བླ་མ འོ །_།ཞེས་པ་ དེ་དག་ དང་ ལྡན་པ་ ནི་བླ་མ འི་ མཆོག་ ཡིན་པ ས་ བརྟེན་པ ར་ བྱ་ ཞིང་ ༈དེ་ལས་ གཞན་པ་ དག་ གི་ ཁྱད་པར་ བྱ་ དགོས་ ཏེ །དོན་དམ་ བསྙེན་པ་ ལ ས །རྩོད་ ལྡན་ དབང་ གིས་ བླ་མ་ སྐྱོན་ དང་ ཡོན་ཏན་ འདྲེན །རྣམ་པ་ ཀུན་ ཏུ་ སྡིག་ དང་ བྲལ་བ་ ཡོད་ མ་ ཡིན །_།དེ་ཕྱིར་ ཡོན་ཏན་ ལྷག་པ་ ཡང་ ནི་ དཔྱད་ བྱས་ ཏེ །_།བུ་ རྣམས་ ཀྱིས་ ནི་ དེ་ ལ་ བརྟེན་པ ར་ བྱ་བ འོ །_༑ཞེས་ སོ །_།ཡོན་ཏན་ མེད་པ ས་ གཞན་ ཡོན་ཏན་ ལ་ འགོད་པ འང་ རང་ཉིད་ ཀྱིས་ མ་ ཡིན་ ཏེ །སངས་རྒྱས་ ཀྱི་ མཐུ འི་ ཕྱིར །ཕག་པ་ སྡུད་པ་ ལ ས །རྒྱལ་བ འི་ ཉན་ཐོས་པ་ དག་ ཇི་སྙེད་ ཆོས་སྟོན་ དང༌ །འཆད་ དང་ རིགས་པ་ དག་ དང་ ལྡན་པ ར་ བརྗོད་པ་ དང་ །_།མཆོག་ འཕགས་ བདེ་བ་ བྱེད་ དང་ དེ་ ཡི་ འབྲས་ ཐོབ་པ །_།དེ་དག་ ཀུན་ ཀྱང་ དེ་བཞིན་ གཤེགས་པ འི་ སྐྱེས་བུ འི་ མཐུ །_།ཅི་ཕྱིར་ ཞེ་ན་རྒྱལ་བ ས་ ཆོས་ ཚུལ་ གང་ བསྟན་པ །_།དེ་ ལ་ མི་མཆོག་ སློབ་མ ར་ གྱུར་པ ས་ མངོན་ བསླབས་ ཤིང་ །_༑མངོན་སུམ་ བྱས་ ནས་ བསླབ་པ་ ཇིབཞིན་ སྟོན་ བྱེད་ དེ །_།སངས་རྒྱས་ མཐུ ས་ བྱེད་ རང་ གི་ སྟོབས་ ཀྱི་ མཐུ ས་ མ་ ཡིན །ཞེས་ སོ །རྡོ ༽༽_ ལྷན་སྐྱེས་ ཀྱི་ ཡེ་ཤེས་ ཐོས་བསམ་ སྒོམ་ གསུམ་ གཏན་ཚིག་ ལྔ ས་ གཞིག་ ན་རྟོགས་པ ར་ འདོད་པ་ དང་ གཞན་ ཡང་ མ་ངེས་པ འི་ ཐབས་ མང་ ཟེར །འདི ར་ ནི་ རྟོགས་པ་ སྐྱེད་ ཐབས་ གཙོ་བོ་ མེད་ མི་ རུང་བ་ ནི་དྭངས་བ འི་ དད་པ་ མོས་གུས་ ཁོ་ན ར་ ངེས་ ཏེ་དཀར་པོ འི་ ཆོས་ ཐམས་ཅད་ ཀྱི་ རྟེན་ ཡིན་པ འི་ ཕྱིར །དཀོན་ བརྩེགས་ ལ ས །དད་པ་ མེད་པ འི་ མི་ རྣམས་ ལ །_།དཀར་པོ འི་ ཡོན་ཏན་ མི་ འབྱུང་ སྟེ །_།ས་བོན་ མེ་ ཡིས་ ཚིགས་པ་ ལ ས །_༑མྱུ་གུ་ སྔོན་པོ་ ཇི་བཞིན་ ནོ །_།ཞེས་ དང༌ །ཆོས་ བཅུ་པ འི་ མདོ་ ལ ས །གང་ གི་ འདྲེན་པ་ ངེས་འབྱུང་བ །_།དད་པ་ ཐེག་པ འི་ མཆོག་ ཡིན་ ཏེ །_།དེ་ཕྱིར་ བློ་ དང་ ལྡན་པ འི་ མི ས །_།དད་པ འི་ རྗེས་སུ་ འབྲང་བ་ བརྟེན །ཅེས །ལམ་ གྱི་ ཆོས་ ཐམས་ཅད་ དྭངས་བ འི་ དད་པ་ མོས་གུས་ ལ་ རག་ ལས་ཤིང་མཐར་ཐུག་ གི་ དོན་ ཡང་ དེ་ལས་ ཡིན་ ཏེ །རྒྱུད་ བླ ར །རང་བྱུང་ ཉིད་ ཀྱི་ དོན་དམ་ ནི ༑_།དད་པ་ ཉིད་ ཀྱིས་ རྟོགས་ བྱ་ ཡིན །_།ཉི་མ འི་ དཀྱིལ་འཁོར་ འོད་འབར་བ །_།མིག་ མེད་པ་ ཡིས་ མཐོང་བ་ མེད །_།ཅེས་པ ས་ ཆོས་སྐུ ར་ འདུ་ཤེས་པ ས་ མོས་གུས་ སྐྱེས་ ན །ཏིལླི་པ ས །མི་ བརྗེད་ གཟུངས་ ཐོབ་ ནཱ་ རོ་པ ས །_།བཅུ་གཉིས་ བར་ དུ་ ང་ མཉེས་ བྱས །_།ང་ ཡི་ རྟོགས་པ་ ཁོ་ ལ་ ཡོད །_།ཅེས་པ་ ལྟར་ འབྱུང་བ་ ཡིན་ ནོ །_།དད་པ་ མེད་ ན་ ཅིར་ འགྱུར་ སྙམ་ ན །_།བྱང་ཆུབ་ ཐོབ་ མི་ སྲིད་ དཔེར་ན །མཚོ་ གཏིང་ གི་ རྡོ་བ་ སྐམ་ ལ་ མི་ འབྱུང་བ་ བཞིན་ ནོ །རྡོ ༽༽_ ལྟ་བ འི་ མཐར་ཐུག་ དབུ་མ་ ཆེན་པོ་ འདོད་ མོད །དེ་དག་ ནི་ ཡང་དག་པ འི་ ལྟ་བ་ རྟོགས་པ་ དང་ ལྡན་པ་ མིན་ ཏེ །བློ ས་ བཞག་པ འི་ ཕྱིར་ ཡེ་ སྙིང་ གིས་ སྐྱེ་ མེད་ ཅེས་ དང་ སྟོང་ ཞེས་ དང༌ །བདག་མེད་ ཅེས་ དང༌ །སྟོང་པ་ཉིད་ དམན་པ འི་ ཡིད་ ཀྱིས་ གང་ སྒོམ་པ་ དེ་ ནི་ འདི་ ལ་ བདག་ བསྒོམ་པ འོ །_།ཞེས་ དང༌ །རྩ་ཤེ ར་ ལ ས །གང་ གི་ ཐུགས་ བརྩེས་ ཉེར་ བཟུང་ ན །ལྟ་བ་ ཐམས་ཅད་ སྤོང་བ འི་ ཕྱིར ༑_།དམ་པ འི་ ཆོས་ ནི་ སྟོན་ མཛད་པ །གོོོོ་ ཏམ་ དེ་ ལ་ ཕྱག་ འཚལ་ ལོ །_།ཞེས་ སོ །།_།དེ འི་ ཕྱིར་ དོན་དམ་པ ར་ བལྟ་ བྱ་ ལྟ་ བྱེད་ བྲལ་བ ས་ལྟ་བ་ མི་ འདོད་ ཀྱང༌ །_།ཀུན་རྫོབ་ ཙམ་ དུ་ དཔོན་སློབ་ ཀྱི་ རྟེན་འབྲེལ་ ཚོགས་པ་ ལ ས་ཆོས་ ཐམས་ཅད་ རང་སེམས་ དང་ དེ་ ལ་ ཆོས་སྐུ་ སྤྲོས་བྲལ་ དུ་ རྟོགས་པ འི་ ལྟ་ རྟོགས་ དབྱེ ར་ མེད་ དམ །ཡུམ་ ལ ས །སེམས་ ལ་ སེམས་མ་ མཆིས་ ཏེ །སེམས་ ཀྱི་ རང་བཞིན་ ནི་ འོད་གསལ་བ འོ །_།ཞེས་པ ས་ སྣང་སྲིད་ ཡེ་ཤེས་ སུ་ འཆར་བ ར་ བྱེད་པ་དེ་ ནི་ ལྟ་བ འི་ མཆོག་གྱུར་ རྟོགས་པ་ དང་ སོ་སོ ར་ ཐ་ མི་ དད་ དུ་ ལྡན་པ་ ལ་ བཞེད་ དོ །_།གནས་ལུགས་ རྟོགས་པ་ ལ་དབུ་ ཕྱག་ རྫོགས་ གསུམ་ ཁོ་ན་ མཐོ་བ་ ཡིན་པ ར་ འདོད་ ཀྱང༌ །འདི ར་ ནི་ ཆེན་པོ་ དེ་ གསུམ་ གྱིས་ གནས་ལུགས་ ལ་མ་ རེག་པ་ ཡིན་ ཏེ །མདོ་ ཏིང་འཛིན་ རྒྱལ་པོ་ ལ ས །ཡོད་ དང་ མེད་ ཅེས་བྱ་བ་ མཐའ་ ཡིན་ ཏེ །དེ་བཞིན་ གཙང་ དང་ མི་གཙང་ འདི་ ཡང་ མཐའ །_།དེ་ཕྱིར་ མཐའ་ འདི་དག་ ནི་ རྣམ་ སྤང་ ནས །_།མཁས་པ ས་ དབུས་ ལ འང་ གནས་པ ར་ མི་ བྱ འོ །_།ཞེས་ དང་ །_ ཕལ་ཆེན་ ལ ས །ཇི་ལྟར་ བར་ སྣངཤིན་ ཏུ xདེ་བཞིན xཡིད་ དང་སེམས་ ཀྱིས་ ཡུལ་ དུ་ ཤེས་ མ་ ཡིན །ཅེས་པ་ བཞིན་ བློ་ དང་སེམས་ ཚིག་ གིས་ གཏན་ ལ་ མི་ ཕབ་བོ །_།འོ་ན་ ཅི་ ཞེ་ན །སྨྲ་ བསམ་བརྗོད་ མེད་ ཤེས་རབ་ ཕ་རོལ་ ཕྱིན །མ་ སྐྱེས་ མི་ འགག་ ནམ་མཁ འི་ ངོ་བོ་ ཉིད །སོ་སོ་ རང་རིག་ ཡེ་ཤེས་ སྤྱོད་ཡུལ་བ །_།དུས་གསུམ་ རྒྱལ་བ འི་ ཡུམ་ ལ་ ཕྱག་ འཚལ་ ལོ །_།ཞེས་ དང༌ །ཆོས་རྒྱལ་ སྲོང་ བཙན་ གྱིས །_།བསམ་པ་ ཐམས་ཅད་ བློ་ ཡིན་ གྱི །_།བློ་ ཡི་ བྱེད་པ་ ཞོག་ ལ་ ཐོང༌ །_།ཞོག་ ཅེས་བྱ་བ འང་ ཚིག་ ཡིན་པ ས །_།ཚིག་ གི་ འཛིན་པ་ བོར་ ལ་ཐོད །ཞེས་ དང༌ །_ ཏེ་ལོ་པ ས །བློ་ ཡི་ ཆོས་ ཀྱིས་ བློ་འདས་ དོན་ མི་ རྟོགས །བྱས་པ འི་ ཆོས་ ཀྱི་ བྱར་མེད་ སངས་ མི་ རྒྱ །ཞེས་པ ས་ ཚིག་ གིས་ སྨྲ ར་ མེད །བརྗོད་པ ས་ གཏན་ ལ་ མི་ ཕེབ །དཔེ ས་ མཚོན་ དུ་ མེད་པ འི་ འཁོར་འདས་ གཉིས་ མེད་ ཀྱི་ དོན་ རྟོགས་པ་ དེ་ ཡིན་ ནོ །_།མིང་ དུ་ བཏགས་པ་ གསུམ་པོ་ ནི་ཟླ་བ་ སྟོན་པ འི་ འཛུབ་ མོ་ བཞིན་ ནོ ༑_།དེས་ན་ འདི་ ལ་ དཀར་པོ་ ཆིག་ཐུབ་ ཅེས་ བཏགས་པ་ ལ ས་འགའ་ཞིག་ གསུམ་ དུ་ འགྱུར་བ འི་ ཐལ་བ་ འཕེན་པ་ ནི་ བློ་གྲོས་ རྩིང་ སྟེ །དེ་ལྟར་ ན་ མཐར་ཐུག་ གཉིས་ མེད་ བྱ་བ་ ཡོད་པ འི་ ཆོས་ ཞིག་གཏན་ མི་ རྙེད་པ ར་ འགྱུར་ རོ །_།དེ་བས་ན་ རྟོགས་པ འི་ མཆོག་ གོ _།རྡོ ༽༽_ གནས་ལུགས་ ཐོས་བསམ་ སྒོམ་ གསུམ་ གྱི་ རྟོགས་པ ར་ འདོད་ མོད །འདི ར་ ནི་ ཐོས་བསམ་ སྒོམ་པ འི་ སྟོང་ཉིད་ ནི་ ཤོ ར་ གོལ་ ཡིན་ ཏེ་རིག་པ ས་ གཞལ་ བློ ས་ བརྟགས་ ཚིག་ གིས་ གཏན་ ལ་ ཕབ་པ་ དེ་སྟོང་ཉིད་ ཀྱི་ དོན་སྤྱི་ བློ་ཡུལ་ དུ་ བྱས་པ་ ལ ས་ མཚན་ཉིད་ མིན་པ ས་མཚན་ཉིད་པ་ མཐར་ཐུག་ ལྟ་ རྟོགས་ དབྱེ ར་ མེད་པ་དེ འི་ ཤོ ར་ ས་ དང་ གོལ་ས་ ཡིན་པ ར་ གསུངས་པ འི་ ཕྱིར །མགོན་པོ་ བྱམས་པ ས །ཕྲ་ ཕྱིར་ ཐོས་པ འི་ ཡུལ་ མིན་ ཏེ །_།དོན་དམ་ ཕྱིར་ ན་ བསམ་པ ས་ མིན །_།ཆོས་ཉིད་ ཟབ་ ཕྱིར་ འཇིག་རྟེན་པ འི །_།སྒོམ་པ་ ལ་སོགས་ ཡུལ་ མ་ ཡིན །ཅེས་ དང༌ །འབྲི་གུང་ ཆོས་རྗེ་ རིན་པོ་ཆེ ས །རང་སེམས་ མི་ སྒོམ་ སེམས་ ཀྱི་ ཡུལ་མི་ བསྒོམ །_།སྒོམ་ དུ་ མེད་པ་ ཡང་ ནི་ མི་ སྒོམ་ སྟེ །_།མ་ བསྒོམ་པ་ ཡི་ བསྒོམ་ ཞིག་ འོང་བ་ ཡི །_།རེ་བ་ དེ་ཡང་ བསྒོམ་པ ར་ མི་ བྱ འོ །ཞེས་པ ས་ མདོ ར་ བསྡུ་ ན་ སྟོང་པ ར་ ཤོ ར་ གོལ །སྣང་བ་ ཤོ ར་ གོལ །རྒྱུ་འབྲས་ ཀྱི་ རྟོག་པ ར་ ཤོར་བ འོ །_།རྡོ ༽༽_ ཆོས་ཉིད་ གཏན་ ལ་ ཕབ་ ནས་ ཡུལ་ དུ་ བྱེད་པ་ ལྟ་བ་དེ འི་ སྟེང་ ནས་ ཞི་གནས་ སྒྲུབ་པ་སྒོམ་པ འམ་ གདམ་ངག་ ལྟར་ བསྒོམ་པ ས་བདེ་ གསལ་ མི་ རྟོག་ གི་ ཉམས་ སྐྱེས་པ་ སྒོམ་པ་ དང༌ །དེ་ལས་ བྱུང་བ འི་ དོན་སྤྱི་ ནི་ ལྟ་བ ར་ བྱེད་ དོ །འདི ར་ ནི་ དཔོན་སློབ་ ཀྱི་ རྟེན་འབྲེལ་ ལ ས་ བྱུང་བ འི་ལྟ་བ་ ཡང་དག་ རྟོགས་པ་ དབྱེ ར་ མེད་པ་ གསུམ་ གྱིས་མ་ རེག་པ འི་ རྟོགས་པ་ དེ་ ལ་ འདྲིས་ ཤིང་ རྒྱུན་ མ་ ཆད་ གོམ་པ ར་ བྱེད་པ་ ནི་སྒོམ་པ་ མཐར་ཐུག་ སྟེ །བདེ་མཆོག་ རྩ་རྒྱུད་ ལ ས །ཡིད་ ནི་ ནང་ དུ་ ཆུད་ གྱུར་ ན །_།གང་ འདོད་པ་ ཡི་ དངོས་གྲུབ་ ཐོབ །_།ཅེས་ དང་ །མགོན་པོ་ འབྲི་གུང་པ་ ཆེན་པོ ས །_།བརྩོན་འགྲུས་ ཆེན་པོ འི་ གོ་བ་ ནི །_།དྲན་པ་ རྒྱུན་ ཆད་ མེད་པ་ ཡིན །ཅེས་ དང་ །དུས་གསུམ་ སངས་རྒྱས་ ཀྱི་ གཞུང་ལམ་ དེ །དུས་རྒྱུན་ ཆད་ མེད་པ ར་ མ་ ཤེས་ ན །_།_།དྲན་པ འི་ རྒྱུན་ ཆད་ མ་ ཤེས་ ན །_།ལུས་ངག་ ཏབ་ ཏབ་ ཁ་ ན་ ཡོད །_།ཅེས་ གསུངས་པ་ བཞིན་ གོམ་ ཞེས་པ་ སེམས་ དྲན་པ་ ཉེར་ བཞག _།གྲོགས་ ཡང་དག་ སྤོང་ བཞི ས་ ཉམས་ སུ་ བླངས་པ ས་རྐང་བཞི་ ལ་ གཙོ་བོ ར་ སེམས་ ཀྱི་ ཏིང་ངེ་འཛིན་ སྤོང་བ འི་ འདུ་བྱེད་ དང་ ལྡན །དྲན་པ འི་ དབང་པོ །_ དྲན་ སྟོབས །དྲན་པ་ ཡང་དག་ བྱང་ཆུབ་ ཡན་ལག་ བདུན །འཕགས་ལམ་ ཡན་ལག་དེ་ བྱང་ཕྱོགས་ སོ་ བདུན་ རིམ་བཞིན་ མངོན་དུ་ བྱེད་ ཅིང་མཐ ར་ མ་ འདྲེས་པ འི་ དྲན་ ཉམས་པ་ མངའ་བ འི་ བར་ དུ་ འགྲུབ་པོ །རྡོ ༽༽_ དགེ་བ་ དང་ སྡིག་པ་ རིམ་བཞིན་ བླང་དོར་ བྲལ་པ་ སྟེ་བྱ་ བྱེད་ རྣམ་སྨིན་ ཐམས་ཅད་ སྟོང་ཉིད་ ཡིན་པ ས་ སོ་ ཟེར །འདི ར་ ནི་ སྤྱོད་པ་ སྡིག་པ་ བླང་བ་ དང་དགེ་བ་ དོར་བ་ དང་བྲལ་བ འི་ ཚུལ་ཁྲིམས་ སུ་ བཞེད་ དེ་འདོད་ཆགས་ ཡུལ་ སྡུག་པ་ དང་དགག་ བཅས་ ཀུན་འབྱུང་ དུ་ འོང་ཞིང༌ །ཞེ་སྡང་ གི་ ཡུལ་མི་ སྡུག་པ་ དང་སྒྲུབ་ བཅས་ ཐར་ལམ་ འདོར་ དུ་ མེད་པ་ སྟེ །དཔེར་ན །_ ཟས་ ལྟ་བུ་ གཅིག་ ལ འང་ འདུལ་བ ར་ ཀཱ་རི་ཀ་ ལ ས །ཤུ་བ འི་ ནད་ ལ ས་ ལྡོག་པ འི་ ཕྱིར །བཟའ་ འོ་ སྙམ་པ འི་ སེམས་ ཀྱི་ བཟའ །ཞེས་ དང༌ །ཕར་ཕྱིན་ དུ་ ལུས་ ཀྱི་ སྲིན་བུ འི་ ཆེད་ དུ་ བཟའ་བ ར་ གསུངས་ ཤིང༌ །སྔགས་ སུའངདཀྱིལ་ འཁོར་ གྱི་ ལྷ ར་ མཆོད་པ ས་ ཆགས་སྡང་_ བྲལ་བ ར་ བསྟན་ ཏོ །མདོར་ན་ གསང་སྤྱོད་ ལ ས །ལྟ་བ ར་ མི་ ལྡན་ སྤྱོད་པ་ དང་ །_།སྤྱོད་པ ར་ མི་ ལྡན་ ལྟ་བ་ གཉིས །_།འདི་ ནི་ གསང་སྔགས་ དམ་སྲི་ སྟེ །_།མནར་མེད་ སེམས་ཅན་ དམྱལ་བ ར་ སྐྱེ །_།ཞེས་པ ས་ ལུས་ འདི་ ལ་ བདེ་བ་ འདོད་ཡོན་ བརྒྱ་ བཏབ་པ་ དང༌ །སྡུག་བསྔལ་ མདུང་ བརྒྱ་ བཏབ་པ་ གཉིས་ མཉམ་ ཞིང་སོ་སོ ར་ མི་ རྟོག་ ན་ རྒྱུ་འབྲས་ ལ ས་ གྲོལ་བ་ ཡིན་ མ་ གཏོག་ གཞན་ ནི །འདོད་ཆགས་ ཞེ་སྡང་ གཏི་མུག་ གསུམ །དེ ས་ བསྐྱེད་ ལ ས་ ནི་ མི་དགེ་བ འོ །_།མ་ ཆགས་ མི་ སྡང་ གཏི་མུག་ མེད །_།དེ ས་ བསྐྱེད་ ལ ས་ ནི་ དགེ་བ འོ །_།ཞེས་པ་ ལྟར །དོན་ དུ་ དགེ་བ་ མི་ བླང་ །སྡིག་པ་ མི་ འདོར་ ཞེས་པ་ མིན་ གྱི །མཆོག་ དམན་ བར་མ་ གང་ ལ་ ཡང་དགེ་བ་ ལ་ ཆགས་ ཤིང་ མི་དགེ་བ་ ལ་ སྡང་བ འི་ བསམ་པ་ མེད་པ་ ཞིག་ ཡིན །དེ་ཡང་ གང་ཟག་ ལྟ་ རྟོགས་ དང་ ལྡན་པ་ དེ ས་ བསྒྲུབས་པ འི་ སྤྱོད་པ་ ནི་དོན་སྙིང་པོ ར་ གྱུར་པ་བསླབ་པ་ རིན་པོ་ཆེ་ གསུམ་ ཆགས་སྡང་ མེད་པ འི་ སྒོ་ ནས་ སྤྱོད་ དགོས་པ་ ཞིག་ གོ _༑རྡོ ༽༽_ ལྟ་ སྒོམ་ སྤྱོད་ གསུམ་ ཐ་དད་ དུ་ འདོད་པ་ མང་ མོད་ ཀྱང༌ །འདི ར་ ནི་ ལྟ་ སྒོམ་ སྤྱོད་ གསུམ་ སོ་སོ ར་ ཐ་དད་ མེད་པ ར་ གཅིག་པ་ བཞེད་ དེ་ལྟ་བ་ རྟོགས་པ་ ལྡན་པ་ སྒོམ་པ ར་ བྱེད་ ཅིང་དེ་ དང་ མི་འགལ་བ ར་ ཁྱད་པར་ དུ་ བྱེད་པ་ ཡིན་པ འི་ ཕྱིར་ དང་ །དེ་ གསུམ་ ཀ་ རང་བཞིན་ མེད་པ ར་ ཉམས་ སུ་ ལེན་ དགོས་པ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང་ །ལྟ་ སྒོམ་ སྤྱོད་ གསུམ་ གཅིག་ ན་ སྐུ་གསུམ་ འདུ་ འབྲེལ་ མེད །ཅེས་ སོ །རྡོ_གཉིས་ མེད་ ཕྱག་ ཆེན་ དང་ སྤང་བླང་ དགག་སྒྲུབ་ ཀྱི་ ཚུལ་ཁྲིམས་ གཉིས་ མི་ གཅིག་ སྡེ་ འགལ་བ འོ་ ཟེར །འདི ར་ ནི་ ཕྱག་ ཆེན་ དང་ ཚུལ་ཁྲིམས་ གནད་ གཅིག་པ་སྟོང་ཉིད་ རྒྱུ་འབྲས་ སུ་ འབྱུང་བ་ འདི་གཞན་ ལ་ མེད་པ འི་ ཁྱད་པར་ གྱི་ ཆོས་ ཡིན་ ཏེ་སེམས་ཉིད་ རྟོགས་ ན་ཆགས་སྡང་ དང་ བྲལ་བ་ དང་ཚུལ་ཁྲིམས་ ཀྱིས་ ཀྱང་ དེ་ སྤོང་ ཞིང་དེ འང་ གཞི་ ཆོས་ཉིད་ ལ་ རག་ ལས་པ འི་ ཕྱིར་ དང༌ །ཕྱག་རྒྱ་ ཆེན་པོ འི་ མངོན་རྟོགས་གཞི་ ཚུལ་ཁྲིམས་ ལ་ བརྟེན་ དགོས་པ འི་ ཕྱིར་ དང༌ །དུག་ གསུམ་ སྤོང་བ་ གནས་སྐབས་ དང་མཐར་ཐུག་ གི་ ཡོན་ཏན་ སྒྲུབ་པ འི་ བྱེད་ལས་ གཅིག་པ འི་ ཕྱིར་ དང་ །གཤིས་ བབས་ སྟོང་ཉིད་ དང་ གཅིག་པ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང༌ །གལ་ཏེ་ སངས་རྒྱས་ ཁམས་ མེད་ ན །སྡུག་ ལ་ སྐྱོ་བ ར་ མི་ འགྱུར་ ཞིང༌ །མྱ་ངན་ འདས་ ལ་ འདོད་པ་ དང༌ །དོན་གཉེར་ སྨོན་པ འང་ མེད་པ ར་ འགྱུར །སློབ་དཔོན་ འཕགས་པ ས ༑ཁྲིམས་ ནི་ རྒྱུ་ དང་ མི་ རྒྱུ འི་ ས་ བཞིན་ དུ །༑། ཡོན་ཏན་ ཀུན་ གྱི་ གཞི་ རྟེན་ ཡིན་པ ར་ གསུངས །ཞེས་ དང༌ །སོ་སོ་ སྐྱེ་བོ་ རྣམས་ དང་ གསུང་སྐྱེས་ དང་ །རང་ བྱང་ཆུབ་ ལ་ བདག་ཉིད་ ངེས་ རྣམས་ དང༌ །རྒྱལ་སྲས་ རྣམས་ ཀྱི་ ངེས་པར་ ལེགས་པ་ དང༌ །_།མངོན་མཐོ འི་ རྒྱུ་ ནི་ ཚུལ་ཁྲིམས་ ལ ས་ གཞན་ མེད །ཅེས་ དང༌ །ཚུལ་ཁྲིམས་ ཀྱིས་ ནི་ ཞི་བ་ འདོད་ རྣམས་ འཕགས་པ ར་ འགྱུར །ཞེས་ དང་ །ཏིང་ རྒྱལ་ ལ ས །ཏིང་འཛིན་ རྒྱལ་པོ་ སྟོང་པ་ འདི་ བསྒོམ་པ ས །_།ཚུལ་ཁྲིམས་ དག་པ འི་ མགོ་ ལ་ དེ་ འདུག་ སྟེ །_།ཆོས་ རྣམས་ རང་བཞིན་ སྟོང་པ ར་ མཉམ་ གཞག་ ནས །།བྱིས་པ་ མེ་ རེག་ བརྩོན་པ ས་ མི་ ཤེས་ སོ །ཞེས་ སོ །མདོ ར་ བསྡུ་ ན །གཉིས་ཀ་ ཉོན་མོངས་ ཀྱི་ དབེན་ ཀྱང་དཀར་པོ འི་ ཆོས་སྤྱོད་ རྒྱུན་ མི་ བཅད །མར་ ངན་སོང་ ལ་ དོགས་པ་ མེད་ ཀྱང་སྡིག་པ་ ཕྲ་བ ས་ གཅིག་པ་ ཡིན་ ནོ །རྡོ ༽༽_ ཕྱག་ ཆེན་ ནམ་མཁའ་ དང་ འདྲ་བ ས་ དགེ་ མི་དགེ ར་ བཞག་ ཏུ་ མེད་ ཅིང༌ །སྐྱོན་ཡོན་ མེད་པ འི་ སྟོང་ཉིད་ ཡིན་ ཟེར །འདི ར་ ནི་ ཕྱག་ ཆེན་ ནི་གཞི་ ལམ་ འབྲས་བུ་ གསུམ་ ཐམས་ཅད་ དུ་ ཡོན་ཏན་ ཀུན་ གྱི་ བདག་ཉིད་ དུ་ བཞུགས་ ཏེ་གཞི་ དུས་ སུ་ སྡུག་བསྔལ་ ལ་ སྐྱོ་བ་མྱང་འདས་ ལ་ འདོད་འདུན་ སྐྱེ་བ་ ཁམས་ ཀྱི་ མཐུ་ ཡིན་ ཏེ །རྒྱུད་བླ་མ་ ལ ས །གལ་ཏེ་ སངས་རྒྱས་ ཁམས་ མེད་ ན །སྡུག་བསྔལ་ ལ་ སྐྱོ་བ ར་ མི་ འགྱུར་ ཞིང༌ །མྱ་ངན་ འདས་ ལ་ འདུན་པ་ དང༌ །དོན་གཉེར་ སྨོན་པ འང་ མེད་པ ར་ འགྱུར །ཞེས་ སོ །_།གཞི་ དེ་ཉིད་ ལ་ བླ་མ ས་ ངོ་ སྤྲད་ དེ་ གོམ་པ ར་ བྱེད་པ་ ལ་ ལམ་ ཟེར་དགེ་རྩ་ གང་ བྱེད་ ཀྱང་ དེ འི་ མཐུ ས་ དཔག་མེད་ དུ་ འགྱུར་ རོ །_།ཡུམ་ ལ ས །མེ་ཏོག་ གཅིག་ གམ་ གདུགས་ གཅིག་ གིས་ འཇིག་རྟེན་ གྱི་ ཁམས་ ཐམས་ཅད་ ཁྱབ་པ ར་ འདོད་པ ས་ཤེས་རབ་ ཀྱི་ ཕ་རོལ་ ཏུ་ ཕྱིན་པ་ ལ་ བསླབ་པ ར་ བྱ འོ །_།ཞེས་ སོ །འབྲས་བུ་ དུས་ སུ་ ཆོས་སྐུ་ ཡོན་ཏན་ མཛད་པ་ དང་ བཅས་པ་རྒྱུན་ མི་ ཆད་པ་ འབྱུང་བ ས་ ཡོན་ཏན་ གྱི་ བདག་ཉིད་ དུ་ གནས་ སོ །_།མདོར་ན་ གཞི་ ལམ་ འབྲས་བུ་ ཐམས་ཅད་ དུ་སྐྱོན་ཡོན་ བསལ་ གཞག་ མེད་པ ར་ གནས་ ཏེ །རྒྱུད་བླ་མ་ ལ ས །འདི་ ལ་ བསལ་ བྱ་ ཅི་ཡང་ མེད །བཞག་པ ར་ བྱ་བ་ ཅུང་ཟད་ མེད །ཡང་དག་ ཉིད་ ལ་ ཡང་དག་ ལྟ །ཡང་དག་ མཐོང་ ནས་ རྣམ་པ ར་ གྲོལ །ཅེས་ 