བུ །རྗེས་ ཐིམ་པ །སྡུག་ འསྔལ་ གྱི་ དུམ་བུ་ སྟེ་རྟོག་པ་ གཅིག་ སྐྱེས་པ་ ནས་ འགགས་པ འི་ བར་ ལ་ ཚང་བ ར་ འབྱུང་བ ར་ འགྲུབ་བོ །རྡོ ༽༽_ འཇིག་རྟེན་ གྱི་ ཚད་ དང་ བྱུང་ཚུལ་ ཆགས་ གནས་ འཇིག་ སྟོང་ མི་ གཅིག་པ་ དུས་འཁོར །རྟ་མགྲིན་ གཤམ་པ་ བཀོད་པ །འདུལ་བ་ གདགས་པ །དྲན་ ཉེར་ སོགས་ ལ ས་ དུ་མ་ འབྱུང་བ་སྙན་ངག་ ལྟར་ བཤད་པ་ དང་ གནས་ལུགས་ ལྟར་ བཤད་པ་ གཉིས་ སུ་ ཡོད་ ཟེར །འདི ར་ ནི་ སེམས་ ནི་ ཐ་དད་ དབང་ གིས་ སྣང་བ་ ཡང་ཐ་ དད་ དེ །དོན་དམ་པ ར་ སྣོད་བཅུད་ གང་ཡང་ མ་ གྲུབ་ མོད །ཚུ་རོལ་ མཐོང་བ འི་ ངོ ར་ བག་ཆགས་ ཀྱི་ ཁམས་ དང་ཆོས་ ཐ་དད་པ ས་ སྒྲུབ་པ འི་ སྣང་བ་ བསོད་ནམས་ བསགས་ ཚུལ་ གྱི་ བྱེ་བྲག་ གིས་ ཏེ །རྡོ་རྗེ་ གུར་ ལ ས །ཡུལ་ དང་ དབང་པོ འི་ བྱེ་བྲག་ རྣམས །རྣམ་པ་ ཐ་དད་ མ་ མཆིས་ ཏེ །གཟུགས་ སོགས་ སྣང་བ ར་ གྱུར་པ་ ནི །_།རང་སེམས་ ཁོ་ན ར་ སྣང་བ འོ །_།ཞེས་ དང་ །དྲིམ་ མེད་པ ར་ གྲགས་པ འི་ མདོ་ ལ ས །ལྟ་བ་ ཐུན་མོང་བ་ གཅིག་ ལ་ཤཱ་རི འི་ བུས་ རང་རོང་ ཅན་ དུ་ མཐོང་ ཞིང་ཚངས་པ་ རལ་བ་ ཅན་ གྱིས་ རྣམ་པ ར་ དག་པ འི་ ཞིང་ དུ་ མཐོང་བ ར་ གསུངས་པ་ དང༌ །སྤྱོད་འཇུག་ ལ ས །ལྕགས་ བསྲེག་ ས་གཞི་ སུ་ ཡིས་ བྱས །སོགས་ གསུངས་པ ས་ ཆུ་ ལ་ འགྲོ་བ་ དྲུག་ གིས་ མཐོང་བ་ བཞིན་ ནོ །རྡོ ༽༽_ བདེ་སྡུག་ རྣམས་ སྔོན་ གྱི་ ལ ས་ ཁོ་ན ར་ ལས་ཤིང་ རྐྱེན་ གྱིས་ བསྒྲུབས་ ཀྱང་ ལ ས་ དེ་ མི་ འགྱུར་ ཟེར །འདི ར་ ནི་ དེ ར་ མ་ངེས་པ་ད་ལྟ་ ཉིད་ དུ་ ལ ས་ གང་ བསྒྲུབས་ འབྲས་བུ ར་ ལོངས་སྤྱོད་པ འང་ ཡོདདེ །ཆོས་ ཀུན་ རྐྱེན་ ལ་ བརྟེན་པ་ དང༌ །སྐད་ཅིག་མ་ ཡིན་པ འི་ གནད་ ཀྱིས་ད་ལྟ་ བླ་མ་ དང་ རྒྱལ་པོ་ ལྟ་བུ་ མཉེས་པ འི་ ལ ས་ བསྒྲུབ་ ན་གདམ་ ག་ དང་ བྱ་དགའ་ ཐོབ་ ཅིང་མ་ མཉེས་ ན་ དེ་ལས་ ལྡོག་པ་ དེ་སྔོན་ལས་ ཁོ་ན ར་ མི་ ལྟོས་པ ར་ མཉེས་ མ་ མཉེས་ ཀྱི་ ཁྱད་པར་ ཡིན་པ ར་ གྲུབ་བོ །ཐམས་ཅད་ སྔོན་ལས་ ཡིན་ ན་ རྒྱུ ར་ སྨྲ་བ འི་ ཞེ་འདོད་ ཡིན་པ ས་ དོར་བ ར་ བྱོས་ ཤིགརྡོ ༽༽_ གཞན་དག་ ན་རེ །བསྐལ་པ་ ཡར་ འཕེལ་ མར་ འགྲིབ་ རང་བཞིན་ བབས་ ཀྱིས་ འབྱུང་ སྟེ་འཕེལ་བ་ ན་ ཐབས་ གང་ གིས་ ཀྱང་ མི་ འགྲིབ །འགྲིབ་པ་ ན་ ཐབས་ གང་ གིས་ ཀྱང་ མི་ འཕེལ་ ཟེརཡང་ །འདི ར་ དུས་ ཀྱི་ འཕེལ་འགྲིབ་ ད་ལྟར་ ཡང་ བྱ ར་ ཡོད་པ་ ཡིན་ ཏེ་དེ འི་ རྒྱུ་ དགེ་ མི་དགེ་ ཞེས་ བྱ་བ་ ལོ་ བརྒྱད་ ཁྲི འི་ ས་ ནས་ བརྒྱད་ བཅུ འི་ བར་ དུ་ འགྲིབ །དེ་ ཚེ་ རང་ རེ འི་ སྟོན་པ་ གདོལ་བ་ སྟོབས་ཆེན་ དུ་ སྐྱེ་བ་ བཞེས་ ན་སུ ས་ སེམས་ཅན་ གྱི་ སྲོག་ བཅད་ ན་ ངས་ དེ འི་ སྲོག་གཅོད་ ཅེས་ བསྒྲགས་ ཏེ་རིམ་གྱིས་ ཆོས་ འཅུ་ དྲུག་ ལ་ བཀོད་པ ས་ལྔ་ བརྒྱ འི་ བར་ དུ་ འཕེལ་བ ར་ གསུངས་པ་ཆུ་ལུད་ དྲོད་གཤེར་ ཚོགས་པ འི་ ས་བོན་ གྱི་ མྱུ་གུ་ བཞིན་ ནོ །རྡོ ༽༽_ ཁོ་ན་ རེད་ལྟར་ གྱི་ དུས་ སུ་ སྐྱེས་ ནས་ མྱོང་ གྱུར་ དང་ལན་ གྲངས་ གཞན་ ལ་ མྱོང་ འགྱུར་ མ་གཏོགས་ མཐོང་ཆོས་ བྱུང་ ཟེར་ རོ །སྐབས་ འདི་ ན་ཚེ་ འདི ར་ རང་ ལ་ མཐོང་ཆོས་ གཙོ་བོ ར་ འབྱུང་ སྟེ །མ་སྐྱེས་དགྲ ས་ མཐོང་ཆོས་ གང་ ལགས་ ཞུས །ཁྱོད་ ཀྱི་ འབངས་ ཐ་ཆད་ ཞིག་ ང་ ལ ས་ རབ་ཏུ་ བྱུང་ སྟེ་ཁྱོད་ ཀྱི་ ས ར་ ཕྱིན་ ན་ ཐ་ཆད་ བྱ འམ་ གསུངས་པ ས །དེ་ འདྲ་ ལྟ་ཅི་ བདག་ གིས་ ཕྱག་ དང་ བསྙེན་བཀུར་བ་ ཡིན་ ཞུས་པ ས །དེ་ མཐོང་ཆོས་ ཡིན་ གསུངས་དེ་ལྟར་ དེང་སང་ ལ འང་ ཕལ་ཆེར་ རབ་ཏུ་ བྱུང་བ་ དང༌ །བྱང་ཆུབ་ ཀྱི་ སེམས་བསྐྱེད་པ་ དང་སྔགས་ ལ་ ཞུགས་པ་ དག་ མཐོང་བ འི་ ཆོས་ ལ་ སྤྱོད་པ ར་ མངོན་སུམ་ གྱིས་ གྲུབ་བོ །རྡོ ༽༽_ དགེ་ བཅུ འི་ ཁ ར་ཕ་མ་ དགེ་སྦྱོང་ བྲམ་ཟེ ར་ ཤེས་པ་ བཞི་རྒན་ ལ་ རིམ་གྲོ་ སྦྱིན་ གཏོང་ སྟེ་ བཅུ་དྲུག་ མི་ཆོས་ ཡིན །ལྷ་ཆོས་ དེ་ལས་ གཞན་ ཏེ །མི་ཆོས་ མཁས་པ་ ལྷ་ཆོས་ ཡིན །_།མཐུན་འཇུག་ མཁས་པ་ ཟོལ་ཟོག་ ཡིན་ཅེས་ གསུངས་ སོ་ ཟེར །འདི ར་ ནི་ ལྷ་ཆོས་ སྡོམ་པ་ གསུམ་ ཀ འི་ སྐབས་ སུ་གཞན་དོན་ དུ་ འཁོར་བ་ འདའ་ འདོད་ ཀྱི་ བསམ་པ ས་སྒྲུབ་ དགག་ དེ་ལས་ གཞན་ མེད་པ འི་ ཕྱིར་ དང་ །འདི་ དང་ ལྡན་ ན་ མི་ཆོས་ ཀྱི་ ཡོན་ཏན་ ཕྲ་མོ་ ནས་ མཆོག་ གི་ དངོས་གྲུབ་ བར་ འབྱུང་བ ར་ གཅིག་པ འི་ ཕྱིར་ དང༌ །མི་ ལྡན་ ན་ ཉེ ས་ ཚོགས་ སྡུག་བསྔལ་ འབྱུང་བ ར་ གཅིག་པ འི་ ཕྱིར །སློབ་དཔོན་ འཕགས་པ ས །མི་ ཡི་ ཆོས་ལུགས་ ལེགས་སྤྱད་ ནས །ལྷ་ཡུལ་ སོགས་ གསུངས་པ ས་མི་ཆོས་ བཅུ་དྲུག་ ལྷ་ཆོས་ དང་ གནད་ དམ་དོན་ གཅིག་ སྟེ་ མཚུངས་པ ར་ གྲུབ་བོ །རྡོ ༽༽_ བསྟན་པ འི་ གནས་ཚད་ གསུང་རབ་ རྣམས་ ནས་ དུ་མ་ ཞིག་ གསུངས་ ཀྱང་འབུམ་ ཊིཀཱ་པ ས་ བསྟན་པ་ ལྔ་ བརྒྱ་ ཕྲག་ བཅུ་ ལ ས་དང་པོ་ གསུམ་ རིམ་བཞིན་ དགྲ་བཅོམ་ དང་ ཕྱིར་ མི་ འོང་ དང་ །ལན་ཅིག་ ཕྱིར་ འོང་ རྒྱུན་ཞུགས་ འབྲས་བུ་ ཐོབ་པ ར་ དེ འི་ དུས །བར་པ་ གསུམ །ཤེས་རབ་ དང་ །_ ཏིང༌ངེ༌འཛིན་ དང་ །_ ཚུལ་ཁྲིམས་ ལྡན་པ ས་ སྒྲུབ་པ འི་ དུས །ཕྱི་མ་ གསུམ་ མངོན་པ་ དང་ །_ མདོ་སྡེ་ དང་ །_ འདུལ་བ འི་ དུས་ ཏེ་ ལུང་ གི་ དུས །དེང་སང་ མདོ་སྡེ འི་ དུས་ ལ་ ཡོད་པ ས་ འབྲས་བུ་ མི་ སྐྱེ་ ཟེར་ རོ །_།འདི ར་ ནི་ དཀོན་མཆོག་ གསུམ་ རྟག་པ འི་ གནད་ ཀྱིས་ ཉམས་ སུ་ ལེན་པ་ ཡོད་ ན་འབྲས་བུ་ ཐོབ་པ་ རྒྱུན་ མི་ ཆད་པ་ འབྱུང་ སྟེ །ཟླ་བ་ སྙིང་པོ འི་ མདོ ར །བསྟན་པ་ ནུབ་ ཁ ར་ རྒྱལ་པོ་ དཔུང་ མར་ ཅན་ གྱི་ རིང་ ལ་ དགྲ་བཅོམ་པ་ དེས་པ་ དང་ཁྲོ་ མ་ དུས་ མཇུག་ ལ ས་ ཚེ་ལོ་ བཅུ་པ འི་ དུས་རྒྱལ་པོ་ རྡོ་ རྟ་ཅན་ གྱི་ རིང་ ལ་ དགྲ་བཅོམ་ གཉིས་ འབྱུང་བ ར་ གསུངས་ ཤིང༌ །མ་ སྒྲུབ་ ན་ སངས་རྒྱས་ བཞུགས་ ཀྱང་ མི་ ཐོབ་པ་ ལྷ་ སྦྱིན་ དང་ ལེགས་ སྐར་ བཞིན་ ནོ །_།གསེར་འོད་ ལ ས་ ཀྱང །སངས་རྒྱས་ མྱ་ངན་ ཡོངས་ མི་འདའ །གྲོལ་བ་ རྒྱུན་ མི་ ཆད་པ ར་ འཁོར་བ་ མ་ སྟོང་ གི་ བར་ དུ་ འབྱུང་ ངོ་ །༽དུས་བཞི ར་ བཞག་པ་ ཤས་ ཆེ་ཆུང་ ངམ་ གཙོ་ཕལ་ ཙམ་ ལས་འབྲས་ ཐོབ་ རྒྱུན་ ཆད་ མེད་ དོ །རྡོ ༽༽_ བསླབ་ གསུམ་ ལ ས་ ཚུལ་ཁྲིམས་ བསླབ་པ་ སྔོན་ དུ་ འགྲོ་བ ར་ འདོད་ དེ །ཞི་གནས་ རབ་ཏུ་ ལྡན་པ འི་ ལྷག་མཐོང་ གིས་ སོགས །ཅེས་པ ས་ གོ་རིམ་ ངེས་ཅན་ ཡིན་ ཟེར །འདི ར་ ནི་ དེ་ ཁོ་ན ར་ ངེས་ ཏེ་ལྔ་ སྡེ་ བཟང་པོ་ ཡེ་ཤེས་ ཁོང་ དུ་ ཆུད་པ ས་ བསྙེན་པ ར་ རྫོགས་པ་ དང༌ །ཁྱིམ་བདག་ གཙོ་བོ འི་ བུ་ གྲགས་པ་ ཁྱིམ་པ འི་ ཆ་བྱད་ དུ་ འདུག་ བཞིན་པ ར་ དགྲ་བཅོམ་པ་ ཐོབ་ ནས་ཕྱིས་ རབ་ཏུ་ བྱུང་བ་ ལྟ་བུ་ སྟེ །དབྱེ་ ན་ གཞི་ ལ ས །རྒྱན་ གྱི་ རྒྱན་ བཞིན་ དུ་ ནི་ སོགས་ དང །སྡུད་པ་ ལ ས །སྦྱིན་པ་ སྦྱིན་པ འི་ སྔོན་ དུ་ འགྲོ་བ་ ཤེས་རབ་ སྟེ །སོགས་ གསུངས་པ ས །ཤེས་རབ་ བསླབས་པ་ ཐོག་མ ར་ འགྲོ་བ འང་ ཡོད་ དོ །རྡོ ༽༽_ མདོ་སྔགས་ ལམ་ གྱི་ རིམ་པ་ སྔགས་ ལ་ རིམ་ ལྔ་ སྦྱོར་ དྲུག་ སོགས་ དང་ མཚན་ཉིད་ རིམ་པ་ གསུམ་ ཡོད་པ ས་སྔོན་ དུ་ འཆི་བ །_ མི་རྟག་པ །_ ལ ས་ རྒྱུ་འབྲས །_ འཁོར་བ འི་ ཉེས་དམིགས །_ བསྐྱེད་རིམ་ རྣམས་ ལོ་ བཅུ་གཉིས་ རེ་ བསྒོམས་ ནས །དེ་ རྗེས་ བཅུ་གཉིས་ རྫོགས་རིམ་ བསྒོམ་པ་ ཡིན་ཅེས་ བཀའ་ གདམས་པ་ འགའ་ཞིག་ གིས་ ཟེར་ རོ །_།འདི ར་ ནི་ ལམ་རིམ་ ཐམས་ཅད་ ཐུན་ གཅིག་ གི་ སྟེང་ དུའང་ ཉམས་ སུ་ ལེན་ དགོས་ ཏེ །སྔ་ཐུན་ དང་པོ ར་ མི་རྟག་པ་ ཐུན་ གཅིག་ མ་ བསྒོམ་ ན་འཇིག་རྟེན་ རང་ གར་ འཁྱམས་ འགྲོ་བ འི་ ཕྱིར་ དང༌ །དེ་ རྗེས་ ལ ས་ རྒྱུ་འབྲས་ འཁོར་བ འི་ ཉེས་དམིགས་ ཐུན་ གཅིག་ མ_སྒོམ་ ན་ཉེས་པ་ ལ ས་ བཙན་པ ར་ མི་འགྱུར་བ འི་ ཕྱིར་ དང །དེ་ རྗེས་ བྱམས་ སྙིང་རྗེ་ བྱང་ཆུབ་ ཀྱི་ སེམས་མ་ བསྒོམ་ ན་དོན་ དུ་ མི་འགྱུར་བ འི་ ཕྱིར་ དང་དེ་ རྗེས་ མཚན་ཉིད་ ལྟར་ ན་ བདག་མེད་ གཉིས་ སྔགས་ ལྟར་ ན་བསྐྱེད་རྫོགས་ གཉིས་ དངོས་གཞི་ མེད་ ཐབས་མེད་པ་ དང་དགེ་རྩ་ བྱང་ཆུབ་ ཏུ་ བསྔོ་བ་ དང་ བཅས་པ་ མེད་ ན་ ཆུད་ ཟ་བ འི་ ཕྱིར །དེ་ལྟར་ ཐུན་ གཅིག་ གི་ སྟེང་ དུ་ ཉམས་ སུ་ ལེན་ ན་ ཇོ་བོ་ རྗེའི་ དགོངས་པ་ ཡིན་ ནོ །རྡོ ༽༽_ ཞིང་ གཅིག་ ལ་ སངས་རྒྱས་ གཅིག་ ལས་མི་ འབྱུང་བ་དགོངས་ འདུས་ དང་ བོན་ འབུམ་ ན་ འདོད་ འདོད་པ ས་དེ་ལྟར་ ཡིན་པ་ འགའ་ཞིག་ གིས་ ཟེར་ ཡང་སངས་རྒྱས་ ནི་ གྲངས་མེད་ བྱོན་པ་ ཡོད་ དེ་སངས་རྒྱས་ རྣམས་ ཀྱི་ སྐུ་གསུང་ཐུགས་ ཀྱི་ ཟད་པ་ རྒྱན་ གྱི་ འཁོར་ལོ འི་ རྣམ་འཕྲུལ་ མཐའ་ ཡས་ ཤིང་ ཐུག་པ་ མེད་པ འི་ ཕྱིར་ དང༌ །རྡུལ་ གཅིག་ གི་ ཁྱོན་ ལ་ རྡུལ་ སྙེད་ ཀྱི་ སངས་རྒྱས་ ཀྱི་ མཛད་པ་ སྟོན་པ ར་ གསུངས་པ འི་ ཕྱིར་ དང །རང་ རེ འི་ སྟོན་པ ས་ འདུས་པ་ རིན་པོ་ཆེ་ དང་པདྨ་ དཀར་པོ་ གསུངས་པ འི་ དུས་སངས་རྒྱས་ དཔག་ ཏུ་ མེད་པ ར་ འབྱོན་པ ར་ གསུངས་པ འི་ ཕྱིར་ རོ །_།དགོངས་ འདུས་ ཀྱི་ ལུང་དོན་ མཛད་པ་ཞིང་ དེ ར་ མཐ ར་ ཕྱིན་པ་ ལ་ དགོངས་ ཤིང་བོན་ ལུང་ ནི་ ལུང་ དུ་ མི་ འགྲུབ་བོ །_།རྒྱུད་ གཉིས་ མེད་ རྣམས་ ལ ས་ ལྷ་ སྦྱིན་ དང་ བདུད་ དང་ །འཁོར་ རྣམས་ སངས་རྒྱས་ ཡིན་པ ར་ གསུངས་ སོ །རྟེན་འབྲེལ་ གནད་བསྡུས་ རྡོ་རྗེ་ ཚིགས་ རྐང་ བཅོ་ལྔ་ ལྷན་ཐབས་ ཚིགས་ རྐང་ གཅིག་ གི་ འགྲེལ་བཤད་ ཀྱི་ སྐབས་ ཏེ་ གཉིས་པ འོ །_༈གཞན་དག་ ན་རེ་འདུལ་བ འི་ སྡེ་སྣོད་ སོ་སོ ར་ ཐར་པ་ ཞེས་པ་རང་ཉིད་ ཁོ་ན་ ཐར་པ འི་ དོན་ ཡིན་པ ས་ ཐེག་དམན་ ས ར་ འདོད་པ་ མང་ མོད །འདི ར་ ནི་ དམ་ཆོས་ འདུལ་བ་ ཐེག་པ་ ཐུན་མོང་ ཡིན་ ཏེ་གནས་སྐབས་ འཁོར་བ འི་ བདེ་སྐྱིད་ ཀྱང་ སོ་ཐར་ སྡོམ་པ ར་ བརྟེན་ ནས་ བྱུང་ སྟེ་ཚུལ་ཁྲིམས་ ཀྱིས་ ནི་ བདེ་འགྲོ ར་ འགྲོ་ ཞེས་ དང་ །ཞི་བ་ ཉན་རང་ མི་ལུས་ ལ་ བརྟེན་ དགོས་ ཤིང་ལུས་ དེ འང་ ཚུལ་ཁྲིམས་ ལ་ རག་ ལས་པ འི་ ཕྱིར་ དང༌ །མཐར་ཐུག་ སངས་རྒྱས་ ཀྱི་ ཡོན་ཏན་ སྟོབས་ སོགས་ ཚུལ་ཁྲིམས་ ཀྱི་ འབྲས་བུ་ གསུངས་ ཏེ །སྡུད་པ་ ལ ས །ཚུལ་ཁྲིམས་ ཀྱིས་ ནི་ ཞི་བ་ འདོད་ རྣམས་ འཕགས་པ ར་ འགྱུར །_།སྟོབས་ བཅུ འི་ སྤྱོད་ཡུལ་ གནས་ ཀྱང་ ཚུལ་ཁྲིམས་ ཉམས་པ་ མེད །ཅེས་པ་ ཐོག་མ ར་ མཐོ་རིས་ ཀྱི་ ཡོན་ཏན་ བར་ དུ་ ཉན་རང་ གི་ བྱང་ཆུབ །མཐར་ཐུག་ བྱང་ཆུབ་ ཆེན་པོ འི་ བར་ ཚུལ་ཁྲིམས་ ལ ས་ བྱུང་བ་ ནི ༑བཤེས་ སྤྲིང་ ལ ས །ཁྲིམས་ ནི་ རྒྱུ་ དང་ མི་ རྒྱུ འི་ ས་ བཞིན་ དུ །ཡོན་ཏན་ ཀུན་ གྱི་ གཞི་ རྟེན་ ལགས་པ ར་ གསུངས །ཞེས་པ་ དང༌ །ཐུན་མོང་ དུ་ སྲོག་གཅོད་པ་ ལྟ་བུ་ གཅིག་ ལ་ མཚོན་ ན །འཇིག་རྟེན་པ འི་ མི་དགེ་བ །ཉན་རང་ གི་ ཕས་ ཕམ །བྱང་སེམས་ ཀྱི་ རྩ་བ་ ལྟ་བུ །སྔགས་ སུ་ བཅུད་ རྣམས་ ལྷ ར་ གསུངས་ ན་ལྟུང་བ་ དེ་བ ས་ ཆེ་བ་ མེད་པ ས་དེ་ལྟར་ ཐུན་མོང་ དུ་ གྲུབ་བོ །སོ་ཐར་ གྱི་ སྒྲ་དོན་ པྲ་ ཏི་ མོཀྵ་ ཞེས་པ་དྲི་མེད་ བཤེས་ ཉེན་ གྱི་ འགྲེལ་བ་ བམ་པོ་ ལྔ་ བཅུ་པ་ ལ ས །སོ་སོ ར་ ཐར་པ་ ཞེས་ བྱ་བ་ ནི་དགག་སྒྲུབ་ ཀྱི་ བསླབ་པ་ སོ་སོ ར་ མ་ འདྲེས་ ཕར་ཉམས་ སུ་ བླངས་པ ས་ ཐར་པ་ ཐམས་ཅད་ མཁྱེན་པ་ ཉིད་ མངོན་དུ་ བྱེད་པ འི་ ཕྱིར་ སོ་སོ ར་ ཐར་པ འོ །ཞེས་ སོ །སོ་ཐར་ སྨྲོས་ ཙམ་ གྱིས་ ཐེག་དམན་ ཡིན་ ན་བྱང་སེམས་ དང་ སྔགས་ ཀྱི་ སྡེ་སྣོད་ ཀྱང་ དམན་པ ར་ ཐལ་ ཏེ །དེ་ དང་ དེ་ལས་ སྨྲས་པ ས་ སོ །དེ་ཕྱིར་ ལུང་ རྣམ་འབྱེད་ ལ ས །ཇི་ལྟར་ འདི་ ན་ ཤིང་རྩ་ གཙོ་བོ་ སྟེ །_།རྣམ་པ ར་ འཕེལ་ དང་ ཀུན་འཛིན་ གཉིས་ ཀྱི་ གཞི །_།དེ་བཞིན་ ཡོན་ཏན་ ཚོགས་ རྣམས་ ཀུན་ གྱི་ ཡང་ །_།རྒྱུ་ དང་ རྩ་བ་ འདུལ་བ་ ཡིན་པ ར་ གསུངས །ཞེས་ སོ །རྡོ ༽༽_ ཐེག་དམན་ དུ་ འདོད་ མོད །ལྷག་པར་ དུའང་ ཐེག་པ་ ཆེན་པོ ར་ གསལ་བ ར་ བཞུགས་ ཏེ་སངས་རྒྱས་ ཐོབ་བྱེད་ ཀྱི་ རྒྱུ་ དང་པོ་ སེམས་བསྐྱེད་པ་ལུང་ སྨན་ གཞི་ ལ ས་འོད་ལྡན་ དུ་ སྐྱེ་བ་ བཞེས་པ་ ན་ སངས་རྒྱས་ ཀྱི་ སྒྲ་ ཐོས་ ནས །གཏོང་བ་ ལ ས་ བྱུང་ བསོད་ནམས་ རྣམས་ ལ ས་ བྱུང་ གང་ ལ །།དེ ས་ ནི་ འཇིག་རྟེན་ སངས་རྒྱས་ ཉིད་ ཐོབ་ ཅིང༌ །_།འདོད་པ འི་ རིམས་ནད་ ཀུན་ ལ ས་ ཐར་བ ར་ བྱ །ཞེས་ སེམས་བསྐྱེད་པ་ དེ ར་ བཤད་པ འི་ ཕྱིར་ དང་ །བར་ དུ་ ལམ་ ཕྱིན་ དྲུག་ རྫོགས་པ འི་ རིམ་པ་སྐྱེས་ རབ་ ལྔ་ བརྒྱ་ ན་ མགོ་ དང་ རྐང་ལག་ གཏོང་བ་ སོགས་བྱ་ དཀའ་བ འི་ སྤྱོད་པ་ སྤྱད་ ཚུལ་ དེ ར་ འཞུགས་པ འི་ ཕྱིར་ དང་ །མཐ ར་ བསྔོ་བ་ སྨོན་ལམ་ དང་ གྲུབ་པ འི་ འབྲས་བུ འང །སྦྱིན་པ་ རྒྱ་ ཆེན་ སོགས །ཅེས་ དང་ མཛད་པ་ བཅུ་གཉིས་ དེ་ལས་བསྟན་པ འི་ ཕྱིར་ དང་ བསྟན་བཅོས་ ལ ས་ ཀྱང་ བཀྲལ་བ འི་ ཕྱིར་ རོ །ལྷན ༽༽_ གཞན་དག་ ན་རེ །སྤང་བྱ་ རེ་རེ འི་ གཉེན་པོ ར་ ཆོས་ཕུང་ དེ་ཉིད་ དུ་ གསུངས་པ ས་ ཆོས་ཕུང་ ཐ་དད་ ཡིན་ ཟེར །འདི ར་ ནི་ ཆོས་ ཀུན་ སོ་སོ་ ཐར་པ་ སོགས་ སྡོམ་ གསུམ་ རེ་རེ ར་ ཡང་ འདུ་བ ར་ གསུངས་ ཏེ །དེ འི་ རྒྱུ་མཚན་ སྤང་བྱ འི་ གྲངས་ སུ་ གསུངས་པ་ མཐུན་ ཡང་འདུ་ ཚུལ་ གསང་ བསམ་ ལ ས །སངས་རྒྱས་ ཀྱིས་ གསུངས་པ འི་ ཆོས་ རྣམས་ བསོད་ནམས་ ཡེ་ཤེས་ ཀྱི་ ཚོགས་ གཉིས་ སུ་ འདུ་བ ར་ བྱ འོ །_།ཞེས་ གསུངས་པ ས་ཐབས་ཤེས་ དེ་ གཉིས་ ཀྱིས་ སྡོམ་པ་ གསུམ་ ཀར་ ཁྱབ་པ འི་ ཕྱིར་ རོ །_།རྡོ ༽༽_ འདུལ་འཛིན་ ལ་ལ འི་ འདུལ་བ འི་ དོན་དགག་སྒྲུབ་ ཏུ་ བཅས་པ འི་ ཚུལ་ཁྲིམས་ ནི་ ཉན་ཐོས་ ཀྱི་ ཉམས་ སུ་ བླང་ བྱ་ ཡིན་པ་བོད་ ཀྱི་ འདུལ་འཛིན་ དག་ གིས་ ཟེར་ རོ །འདི ར་ ནི་ འདུལ་བ་ ཐམས་ཅད་ མཁྱེན་པ འི་ ཡེ་ཤེས་ ཀྱི་ ཡུལ་ འདི་ཉིད་ ཡིན་ ཏེ་དེ འང་ མཁྱེན་པ འི་ ཡེ་ཤེས་ སྟོབས་ བཅུ་ ལ ས་གནས་ དང་ གནས་མིན་ སོགས་ དགུ་ ནི་ ཇི་སྙེད་པ་ ཐ་མ་ ཟག་ཟད་ མཁྱེན་པ་ ཇི་ལྟ་བ་ སྟེ །ཇི་སྙེད་ མཁྱེན་པ འི་ སྟོབས་ དགུ་ ཀ་ དགག་སྒྲུབ་ ཀྱི་ ཚུལ་ཁྲིམས་ འདི ས་ བསྡུས་ ཤིང་དེ་ལས་ ཀྱང་ ལ ས་ དང་ལ ས་ ཀྱི་ རྣམ་སྨིན་ མཁྱེན་པ འི་ སྟོབས་ ལ་ འཇུག _།ཡེ་ཤེས་ དེ འི་ གཟིགས་པ ས་ བསླབ་པ་ བཅས་ ཏེ་ ཉམས་ སུ་ བླངས་པ ས་སྟོབས་ བཅུ་ མངོན་དུ་ བྱེད་པ འི་ ཚུལ་ འདི ས་ སངས་རྒྱས་ ཁོ་ན འི་ སྤྱོད་ཡུལ་ ཏེ །ལོ་པཎ་ རྣམས་ ཀྱིས་ འདུལ་བ འི་ ཐད་ དུ །ཐམས་ཅད་ མཁྱེན་པ་ ལ་ ཕྱག་ འཚལ་ ལོ །_།ཞེས་པ་ དང༌ །དེ་ལྟར་ ཉམས་ སུ་ བླངས་ ན་ སྟོན་པ་ ཉིད་ ཀྱི་ བྱ་བ་ བྱེད་པ ར་ གསུངས་ ཏེ །ང་ ནི་ མྱ་ངན་ འདས་ གྱུར་ ན །_།འདི་ ནི་ ཁྱོད་ ཀྱི་ སྟོན་པ་ ཞེས །_།རང་བྱུང་ ཉིད་ ཀྱིས་ གུས་ བཅས་པ ར །_།ནན་ཏན་ དགེ་སློང་ ཚོགས་ མདུན་ བསྟོད །ཅེས་ སོ །_།ཚུལ་ཁྲིམས་ ཐམས་ཅད་ མཁྱེན་པ་ འདི་ ཡིན་པ་ དེ་ལྟར་ ན །དེ་ བསྲུང་བ འི་ བཙུན་པ ར་ ཡེ་ཤེས་ ཡོད་པ ར་ འགྱུར་ རོ་ ཞེ་ན །མངོན་གྱུར་ དུ་ མེད་ ཀྱང་ རང་བཞིན་ དུ་ཡོད་ དེ །དཔེར་ན་ མཚམས་མེད་ བྱེད་པ འི་ མི་ལ་ དམྱལ་བ་པ་ བྱས་པ་ དང་ འདྲ འོ །རྡོ ༽༽_ མཚམས་མེད་ སྒྲ་ མི་ སྙན་ སྤྲུལ་པ་ སྐྱེ་བ་_ ༡_ དང་ །ཕ་མ ས་ མ་ གནང་བ་ སོགས་ གནས་པ འི་ དང་_ ༢ནད་པ་ ཡོན་ཏན་ ཐོབ་པ འི་_ ༣_ དང༌ །གཞན་དོན་ དུ་ མི་ མཛེས་པ་ མཛེས་པ འི་_ ༤_ དང༌ །བར་ཆད་ དེ་ བཞི་ ལ ས་ སྐྱེ་བ འི་ བར་ཆད་ གང་རུང་ གཅིག་ བྱུང་ ན་ སྡོམ་པ་ མི་ སྐྱེ་ ཟེར །འདི ར་ ནི་ བར་ཆད་ ལྡན་ ལ་ སྡོམ་པ་ སྐྱེ་བ ར་ ངེས་ ཏེ །དེ་དག་ དགེ་ སྦྱོད་ གི་ འབྲས་བུ་ སྐྱེ་བ འི་ བར་ཆད་ ལ ས་ སྡོམ་པ་ མིན་ ཏེ །རབ་ཏུ་ བྱུང་བ འི་ གཞི་ ལ ས །ཁྱིམ་བདག་ ཞིག་ གི་ བུས་ མ་ བསད་པ ར་ འགྱོད་ ནས་ རབ་ཏུ་ བྱུང །སྡེ་སྣོད་ གསུམ་ ཤེས་ མཚམས་མེད་ བྱེད་པ་ མི་ སྐྱེ་བ འི་ ཆོས་ཅན་ ཡིན་པ ས་བཀྲོད་ ཅིག་ གསུངས་པ ས་ བཀྲད །རྒྱ་མཚོ འི་ འགྲམ་ དུ་ ཕྱིན །སློབ་མ་ བསྡུས་ ཆོས་ བཤད་པ ས་ དགྲ་བཅོམ་པ་ མང་པོ་ བྱུང༌ །ཚེ་ འཕོས་ ནས་ དམྱལ་བ ར་ སྐྱེས་མ་ ཐག་མེ་ ལ་ བསྲོ་ཁང་ གི་ སྣང་བ་ བྱུང་བ ར་ བརྟེན་ལྷ ར་ སྐྱེས་ ནས་ སངས་རྒྱས་ ལ ས་ ཆོས་ ཐོས་པ ས་འབྲས་བུ་ ཐོབ་པ་ རབ་ཏུ་ བྱུང་བ འི་ ཕན་ཡོན་ ཡིན་ ཏེ །རྣམ་སྨིན་ སྐལ་ ཆེན་ དུ་ གསུངས་ ན་འདི་ སྐྱེས་མ་ ཐག་ ལྷ ར་ འཕོས་པ འི་ ཕྱིར་ རོ །འོ་ན་ མ་སྐྱེས་དགྲ་ སོགས་ མཚམས་མེད་ བྱས་པ་བདེན་པ་ མཐོང་བ ར་ གསུངས་པ ས་ འགལ་ ལོ་ སྙམ་ ན །དེ་དག་ སྔོན་ གྱི་ རྒྱུ འི་ སྟོབས་ ཀྱིས་ རྐྱེན་ མཚམས་མེད་པ ས་བར་ དུ་ གཅོད་ མ་ནུ ས་པ་ སྟེ་མ་སྐྱེས