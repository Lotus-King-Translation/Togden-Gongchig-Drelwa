 ལྡན་པ་ རྒྱུད་ ལ་ ཡོད་པ འི་ ཕྱིར་ དང་ཐེག་པ་ ཐམས་ཅད་ རིགས་ གཅིག་ ཡིན །ལྷན ༽༽_ དེ་ལྟར་ རྒྱས་པ ར་ བཤད་པ་ ནི་རྒྱུ་ དང་ ལྡན་ ཕྱིར་ ཉན་རང་ སངས་རྒྱས་ སྟེ་བྱང་ཆུབ་ ཆེན་པོ་ རཐོབ་པ ར་ འགྱུར་ ཏེ་རྐུ་ ཐབས་ སུ་ སེམས་བསྐྱེད་པ ས་བྱང་ཆུབ་ ཆེན་པོ ར་ ཐོབ་པ ར་ ངེས་ སོ །མྱང་འདས་ ཀྱི་ ངལ་ སྟེགས་ ཙམ་ ལས་མ་ གསུངས་པ འི་ ཕྱིར་ དང་ །སངས་རྒྱས་ ཀྱི་ ཐུགས་རྗེ་ འོད་ཟེར་ གྱིས་ བསྐུལ་བ འི་ ཕྱིར་ དང༌ །རྣམ་གྲོལ་ གྱི་ ངོ་བོ་ ཟླ་ དད་ མེད་པ ར་ གསུངས་པ འི་ ཕྱིར་ ཏེ་བྱང་སེམས་ སྤྱོད་ཡུལ་ ཐབས་ ཀྱི་ རྣམ་པ ར་ འཁྲུལ་པ ར་ བསྟན་པ འི་ མདོ་ ལ ས །དཔེར་ན་ མེ་སྟག་ ཆུང་ངུ་ འཕེལ་ གྱུར་ ན །_།མེ་ལྕེ་ ཆེ་ཆེ ར་ འབར་ ཞིང་ མཆེད་པ་ ལྟར །_།ཉན་ཐོས་ ཡེ་ཤེས་ མེ་ ཡི་ མེ་སྟག་ ཀྱང་ །_།དེ་ཉིད་ སངས་རྒྱས་ ཡོན་ཏན་ མེ་ལྕེ་ སྐྱེ །ཞེས་ སོ །_།ལོག་ སྲེད་ ཅན་ ཡང་ དུས་ རིང་བ ར་ དགོངས་པ་ ལ ས་འདུས་བྱས་ ཀྱི་ བློ་ དེ་ བྲལ་བ་ ན་ འཇུག་པ ར་ འགྱུར་ ཏེ །ལེགས་ སྐར་ སངས་རྒྱས་ བར་ གསུངས་པ་ བཞིན་ ནོ །_།ཆོས་ ཀྱི་ འཁོར་ལོ འི་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ་ ཚིགས་ རྐང་ སུམ་ བཅུ་པ་ ལྷན་ཐབས་ ཚིགས་ རྐང་ བཅོ་ལྔ འི་ འགྲེལ་བཤད་ ཀྱི་ སྐབས་ ཏེ་ དང་པོ འོ །_།རྡོ ༽༽_ གཞན་དག་ ན་རེ །དགེ་ མི་དགེ་ གང་ གིས་ ཀྱང་ དབང་མ་ བྱས་པ འི་ འབྱུང་ ཆེན་ བཞི་ ཁམས་ བཅོ་བརྒྱད་ ལུང་ མ་ བསྟན་ དུ་ གསུངས་ མོད །འདི ར་ ནི་ དགེ་སྡིག་ གཉིས་ ལ་ཐག་ བཅད་ ན་དེ་ གཉིས་ ལ ས་ ལུང་ མ་ བསྟན་ བྱ་བ་ གཞན་ ཞིག་ མེད་ དེ་སློབ་དཔོན་ འཕགས་པ ས །འདོད་ཆགས་ ཞེ་སྡང་ གཏི་མུག་ གསུམ །_།དེ ས་ བསྐྱེད་ ལ ས་ ནི་ མི་དགེ་བ །མ་ ཆགས་ མི་ སྡང་ གཏི་མུག་ མེད །_།དེ ས་ བསྐྱེད་ ལ ས་ ནི་ དགེ་བ འོ །_།ཞེས་ གསུངས་པ ས་ཕུང་པོ་ གསུམ་པ་ ཞིག་ མེད་ དོ །_།སངས་རྒྱས་ ཀྱིས་ གསུངས་པ འི་ ལུང་ མ་ བསྟན་ ནི་ ལྷན་སྐྱེས་ ཀྱི་ མ་རིག་པ་ ལ་ གསུངས་ ཏེ །སྤང་བྱ་ ཤེས་སྒྲིབ་ གཏི་མུག་ ལ ས་ གྱུར་པ་ ཉི་ཁྲི་ ཆིག་སྟོང་ གི་ ཁོངས་ སུ་ འདུ་བ ས་དཔེར་ན་ ཁྱོ་ཤུག་ གཉིས་ བུ་མོ་ དང་ གསུམ་ ཡོད་ ཀྱང་ཕོ་མོ ར་ འདུས་ ན་ གཉིས་ ལ ས་ མེད་པ་ བཞིན་ལུང་ མ་ བསྟན་ མི་དགེ་བ འི་ ཕྱོགས་ སུ་ འདུ འོ །རྡོ ༽༽_ མངའ་བདག་ སྟག་ ཚ་ ན་རེ །ཕྱི་རོལ་ གྱི་ ཡུལ་ ཇི་སྲིད་པ་ དང་ མཉམ་པ འི་ གྲངས་ བཞིན་ རྟོག་པ འང་ དེ་ཉིད་ ཅིག་ ཆ ར་ དུ་ སྐྱེ་ ཟེར་ ཡང་ །དེ་ ཆོས་ཅན་ རྟོག་པ་ གཉིས་ སམ་ མང་པོ་ དུས་ གཅིག་ ཅ ར་ དུ་ འཇུག་པ་ མི་ སྲིད་ དེ་དེ་ལྟར་ ན་ དགེ་ མི་དགེ འང་ ལྷན་ཅིག་ སྐྱེ་ རིགས་ ན འང་ ཕན་ཚུན་ སྤང་ འགལ་ ཡིན་པ འི་ ཕྱིར །དཔེར་ན་ ཚ་གྲང་ གི་ རེག་བྱ་ བཞིན །དཔལ་ ཕྲེང་ གིས་ ཞུས་པ་ ལ ས །དགེ་བ འི་ སེམས་ ཀྱང་ སྐད་ཅིག་མ །_།མི་དགེ འི་ སེམས་ ཀྱང་ སྐད་ཅིག་མ །ཞེས་ དང༌ །གཞན་ ཡང་ཕྱི་ དོན་ འདོད་ ན་མདོ་སྡེ་པ་ གཟུངས་ འཛིན་ གྲངས་ མཉམ་ དང༌ །མེད་ ན་ སེམས་ ཙམ་ རྣམ་ བདེན་ ལ་ འགོག་པ འི་ རིགས་པ་ འཇུག་ སྟེ །དབུ་མ་ རྒྱན་ ལ ས །དེ་ལྟ་ ཡིན་ ན་ དཀ ར་ ལ་སོགས །སོགས་ དང་ རྡུལ་ཕྲན་ བདག་ཉིད་ དཀ ར་ སོགས་ དང༌ །ཇི་སྟེ་ རྣམ་པ འི་ གྲངས་ བཞིན་ དུ །སོགས་ དང༌ །གལ་ཏེ་ སྣ་ཚོགས་ དེ་ གཅིག་ ན །ཞེས་ སོགས་ ཀྱིས་ གནོད་ ཅིང་གང་ཟག་ གཅིག་ ཤེས་རྒྱུད་ དུ་མ ར་ ཐལ་བ ས་ སོ །རྡོ ༽༽ གཞན་ དུ་ སེམས་ གཞི་ ལ ས་ སེམས་བྱུང་ འབྱུང་བ ར་ འདོད་ དེ །དབུས་ མཐ ར །དེ་ ལ་དོན་ མཐོང་ རྣམ་པ ར་ ཤེས །དེ་ ཡི་ ཁྱད་པར་ ཅེས་པ ས །སྒྲོ་འདོགས་ ཆོད་པ འི་ དོན་ ལ་ སེམས་ དང་དེ་ནས་ རྟོག་དཔྱོད་ བྱེད་པ ས་དེ འི་ ཁྱད་པར་ གྱི་ ཆོས་སེམས་ བྱུང་ དུ་ བཤད་ མོད །འདི ར་ སེམས་ལས་ སེམས་བྱུང་ འབྱུང་བ་ གཞིར་བཞག་དེ་ལས་ ཀྱང་ སེམས་ ནི་ འབྱུང་བ་ འགྲུབ་ སྟེ །དཔེར་ན་ བདག་ ཐེག་ཆེན་པ་ བྱ་ སྙམ་པ་ སེམས །དེ་ ལ་ བརྟེན་ ནས་ སེམས་བསྐྱེད་པ་ སེམས་བྱུང༌ །དེ ས་ ཐེག་ཆེན་ གྲུབ་པ་ གོང་ གི་ སེམས་ དེ་ གྲུབ་པ ས་སེམས་ ཏེ་ མདོར་ན་ ཡུལ་ ལ་ གཏོད་པ འི་ སྐད་ཅིག་ དང་པོ །སེམས་ དང་ དེ འི་ ཁྱད་པར་ ལ་ དཔྱོད་པ་ གཉིས་པ་ སེམས་བྱུང་ དེ་ ཟིན་པ་ སླར་ སེམས་ སྐྱེ་ སྟེ །སྐད་ཅིག་ གི་ ཕྲེང་བ་ ཡིན་པ ར་ གསུངས་པ་དེ འི་ ཕྱིར་ འདི འང་ ཡོད་པ ར་ སྒྲུབ་བོ །རྡོ_གཞན་ དག་ ན་རེ །འཁོར་བ ར་ འཁོར་བ་ ནི་ སེམས་ ཡིན་ ཏེ །སྡུག་བསྔལ་ དང་ རྣམ་སྨིན་ དེ ར་ བརྟེན་པ འི་ ཕྱིར་ དང་ །ལུས་ བེམ་པོ་ ཡིན་པ འི་ ཕྱིར་ ཞེས་ ཟེར་ རོ །འདི ར་ ནི་ འཁོར་བ འི་ རྒྱ་མཚོ ར་ ལུས་ ཉིད་ འཁོར་བ ར་ བཞེད་ དེ །དེ་ འཁོར་བ འི་ གཞི་ རྟེན་ ཐོག་མེད་ བག་ཆགས་ ཀྱི་ ས་བོན་ རྣམས་ ཀྱིས་ གང་བ ར་ གནས་ ཤིང༌ །དེ་དག་ རྐྱེན་ དང་ ཕྲད་པ ས་ རྟོག་པ་ སྣ་ཚོགས་ སྐྱེ་ ཞིང་དེ ས་ ཕྱི་མ འི་ ལུས་ འགྲུབ་པ འི་ ཕྱིར །དཔེར་ན་ རྒྱ་མཚོ་ ཆེན་པོ་ སྲོག་ཆགས་ རྣམས་ ཀྱི་ རྟེན་གནས་ སུ་ གྱུར་པ་ བཞིན་ ནོ །_།འོ་ན་ གཟུགས་ མེད་ བཞི་ སོགས །དངོས་ ལུས་མེད་པ ར་ ཇི་ལྟར་ འཁོར་ སྙམ་ ན །གཟུགས་ མེད་ ན་ རྣམ་རིག་ མིན་པ འི་ གཟུགས་ དང་ རྨི་ལམ་ ན་ བག་ ཆག་ གི་ དང་ །སྲིད་པ་ བར་དོ ར་ ཡིད་ ལུས་ ཡོད་པ ར་ གསུངས་པ འི་ ཕྱིར་ ལུས་ འཁོར་བ འོ །ལྷན ༽༽_ ཁོ་ན་ རེ །འཁོར་བ་ མཐའ་ ཡོད་ དེ་ གས ར་ སྐྱེ་ མེད་པ ས་ དང་ །འགའ་ཞིག་ མཐའ་མེད་ དེ་ ཟོ་ཆུན་ ལྟར་ དུ་ གསུངས་པ འི་ ཕྱིར