་ ཡོན་ཏན་ ཡིན །ཞེས་ སོ །_།དེ་ལྟར་ མིན་ ན་སོ་ སྐྱེ་ འོག་མ་ རྣམས་ ལ་ ཡོན་ཏན་ འབྱུང་བ་ དང་ ༑སངས་རྒྱས་ ལ་ མི་ འབྱུང་བ ར་ རིགས་ ཏེ་སོ་སྐྱེ་ རྣམས་ རྗེ་ ཤེས་ ཁོ་ན་ ཡིན་པ འི་ ཕྱིར་ དང༌ །སངས་རྒྱས་ དུས་ རྟག་ ཏུ་ མཉམ་པ ར་ མ་ བཞག་པ་ མི་ མངའ་བ འི་ ཕྱིར་ རོ །_།དེ འང་ སངས་རྒྱས་ དང་ ས་བཅུ་པ འི་ བྱང་སེམས་ ཀྱི་ ཡོན་ཏན་རྒྱ་མཚོ་ དང་བ་ ལང་ རྨིག་ རྗེས་ ཀྱི་ ཆུ་ ལྟར་ ཁྱད་ ཡོད་པ ར་ གསུངས་པ ས་ བསལ་ ལོ ༑།རྡོ ༽༽_ ཆོས་སྐུ་ ཕྱག་རྒྱ་ ཆེན་པོ་ རྟོགས་ ན་ རྒྱུ་མ་ བསྒྲུབས་ ཀྱང་ ཡོན་ཏན་ ཐམས་ཅད་ འབྱུང་ ཟེར །འདི ར་ ནི་ རྒྱུ་ ནི་ མ་ བསྒྲུབ་པ ར་ ཡོན་ཏན་ ཐམས་ཅད་ འབྱུང་ མི་ སྲིད་ དེ་ཚོགས་ གཉིས་ མ་ བསགས་པ་ ལ འང་ ཡོན་ཏན་ འབྱུང་བ ར་ ཐལ་བ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང་ དཀོན་མཆོག་ བརྩེགས་པ་ ལ ས །ས་ ནི་ བསམ་ གྱིས་ མི་ ཁྱབ་པ འི །_།དགེ་བ འི་ ལ ས་ ཀྱི་ རྒྱུ་རྐྱེན་ གྱིས །།རྨོངས་པ་ རབ་ཏུ་ སྤངས་པ་ ཡིིས །_།འོད་ཟེར་ སྣ་ཚོགས་ འགྲུབ་པ་ ཡིན །ཅེས་ སོགས་ མཐའ་ཡས་པ ར་ གསུངས་ སོ །མཉམ་བཞག་ ལ་ ཡོན་ཏན་ འབྱུང་བ་ དང་རྒྱུ་མ་ བསྒྲུབ་པ ར་ མི་ འབྱུང་བ་ གཉིས་ མི་འགལ་བ ར་དེ འི་ ངང་ ལ ས་ ཐ་དད་ མེད་པ ར་ བསྒྲུབ་པ ས་རྗེས་ཤེས་ སུ་ མི་ འགྱུར་ ཏེ །སྡུད་པ་ ལ ས །བདག་ ནི་ མཉམ་པ ར་ བཞག་ ཅེས་པ འམ་ ལང་ ཞེས་ རློམ་སེམས་ མེད་ ཅེས་པ ས་ སོ །ལྷན ༽༽_ འགའ་ཞིག་ བྲལ་བ འི་ འབྲས་བུ འི་ ཡོན་ཏན་ ལ་ རྒྱུ་ མི་ དགོས་ ཟེར་ ཡང་འདི ར་ བྲལ་འབྲས་ ཐམས་ཅད་ རྒྱུ་ དང་ བཅས་པ་ ཡིན་ ཏེ །རྒྱུ་ མེད་པ འི་ འབྲས་བུ་ གཤིས་ ལ་ མི་ སྲིད་པ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང་ །བུ་མོ་ རིན་ཆེན་ གྱིས་ ཞུས་པ འི་ མདོ ར །བུ་མོ་ བྱང་ཆུབ་ སེམས་དཔ འི་ སྤྱད་པ་ སྤྱོད་པ་ ན་ཐེག་པ་ དམན་པ་ འདི་ ནི་ གནས་མིན །སྐབས་མེད་ བསྟན་པ འི་ སྟོབས་ དང་ ལྡན་པ་སངས་རྒྱས་པ འི་ དུས་ ན་ གནས་ དང་ གནས་མིན་ མཁྱེན་པ འི་ སྟོབས་ ཐོབ་པ ར་ འགྱུར་ རོ །ཞེས་ སོགས་ གསུངས་ སོ །རྡོ ༽༽_ ཆོས་ ཐམས་ཅད་ རང་སེམས་ ལས་མི་ གཞན་པ ས་དེ འི་ ཆོས་ཉིད་ ལམ་ གྱིས་ རྟོགས་ ན་དགེ་ མི་དགེ་ ལས་འབྲས་ སོགས་ སྣ་ཚོགས་པ འི་ སྣང་བ་ ཐམས་ཅད་ སྣང་མེད་ སྟོང་ཉིད་ དུ་ རྟོགས་ ཏེ །རྒྱུ་འབྲས་ ཀྱི་ རྟེན་འབྲེལ་ མེད་པ་ ནམ་མཁའ་ བཞིན་ ནོ་ ཟེར་ རོ །འདི ར་ ནི་ སྟོང་ཉིད་ རྟོགས་པ འི་ ཚེ་ ན་དེ་ དང་ དབྱེ ར་ མེད་པ ར་ རྒྱུ་འབྲས་ ཀྱི་ རྟེན་འབྲེལ་ ཉིད་སྒྱུ་མ འི་ སྣང་བ་ བཞིན་ འགོག ས་པ་ མེད་པ ར་ འབྱུང་བ ས་སྟོང་ཉིད་ ཀྱིས་ རྒྱུ་འབྲས་ མི་ ཁེགས་ ཏེ །དཔེར་ན་ ནམ་མཁའ་ ལ ས་ བྱུང་བ འི་ འཇའ་ཚོན་ནམ་མཁའ་ དེ་ དང་ དབྱེ ར་ མེད་ དུ་ འཆར་བ འི་ ཚེ་ནམ་མཁ ས་ འཇའ་ཚོན་ མི་ ཁེགས་པ་ བཞིན་ ནོ །_།དེ་ལྟར་ ཡང་ ཏིང་འཛིན་ རྒྱལ་པོ་ ལ ས །ཆོས་ཉིད་ ལ ས་ ཀྱི་ རྣམ་སྨིན་ མེད་ ཤེས་ ཀྱང་ །དགེ་ དང་ མི་དགེ འི་ ལ ས་ ནི་ ཆུད་ མི་ ཟ །_།ཞི་བ ར་ གནས་པ་ རང་རྒྱལ་ ཐེག་པ་ དེ །ཉན་ཐོས་ རྣམ་པ ར་ གྲོལ་བ འི་ སྒྲ་ ཕྱིར་ འབྲང༌ །_།ལྗོན་པ ས་ ཞུས་པ འི་ མདོ་ ལ ས །རྒྱུ་ལ་ བརྟེན་པ འི་ མཁས་པ་ བཅོམ་ལྡན་འདས །_།མཐའ་ གཉིས་ ལྟ་བ་ རྟག་ ཏུ་ མི་ མངའ་བ །ལ ས་ ཀྱི་ རྣམ་སྨིན་ འབྲས་བུ་ ཁོ་ན་ གསུངས །_།ལྟ་བ འི་ མུན་ བྲལ་ ཁྱེད་ ལ་ ཕྱག་ འཚལ་ ལོ །_།ཞེས་ སོ །_།རྗེ་བཙུན་ གྱིས་ སྒམ་པོ་པ་ ལ་ འགྲོ་ ཆོས་ སུ་ གསུངས་པ །ཡར་ སངས་རྒྱས་ ལ་ རེ་བ་ མེད་ ཀྱང་དཀར་པོ འི་ ཆོས་སྤྱོད་ རྒྱུན་ མི་ བཅད །མར་ ངན་སོང༌ ལ་ དོགས་པ་ མེད་ ཀྱང་སྡིག་པ་ ཕྲ་ ཞིང་ ཕྲ་བ་ ལ་ འཛེམ་ ཞེས་ སོགས་ གསུངས་ སོ །_།འོ་ན་ འགལ་བ ར་ འགྱུར་ རོ་ སྙམ་ ན་མི་ འགལ་ ཏེ །ཏིང་འཛིན་ རྒྱལ་བོ་ ལ ས །ཆོས་ ཐམས་ཅད་ མཉམ་པ་ཉིད་རྣམ་པ ར་ སྤྲོས་པ འི་ ཏིང་འཛིན་ གྱི་ རྒྱལ་པོ་ ཞེས་པ་མཉམ་པ་ཉིད་ ནི་ སྟོང་ཉིད་ དང་རྣམ་པ ར་ སྤྲོས་པ་ རྒྱུ་འབྲས་ ཀྱི་ རྟེན་འབྲེལ་ སྤྲོས་པ་ གཉིས་མི་འགལ་བ ར་ བསྟན་པ་ བཞིན་ ནོ །_།དེ་ལྟར་ ཡང་ །གང་ ལ་སྟོང་པ་ ཉིད་ རུང་བ །_།དེ་ ལ་ ཐམས་ཅད་ རུང་བ ར་ གྱུར །ཞེས་ དང༌ །རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་ མ་གཏོགས་པ འི །_།ཆོས་ འགའ་ ཡོད་པ་ མ་ ཡིན་ ནོ །_།དེ་ཕྱིར་ སྟོང་ཉིད་ མ་ཡིན་པ འི །།ཞེས་ སོ །_།དེ་བས་ན་ མཐར་ཐུག་ ཐམས་ཅད་ མཁྱེན་པ་ ཐོབ་པ འི་ དུས་ ན འང་སྤྲོས་པ་ བྲལ་བ འི་ ངང་ ལ ས་རྒྱུ་འབྲས་ ཀྱི་ སྤུ་རིས་ མི་ འདོར་བ་ ཉིད་ དུ་ ལྡང་བ འམ་ འབྱུང་བ་ ཡིན་ ནོ །ལྷན ༽༽_ བསྒོམ་ བྱ་ སྒོམ་ བྱེད་ གཉིས་ མེད་ དོན་དམ་ ཆོས་དབྱིངས་ རྟོགས་ ན་ནམ་མཁའ་ གཉིས་ འདྲེས་ བཞིན་ དུ་ གྱུར་བ་ དེ་མཐར་ཐུག་ ཏུ་ འགའ་ཞིག་ འདོད་ དོ །འདི ར་ ནི་ དེ་ ནི་ མཐར་ཐུག་ མ་ ཡིན་ ཏེ་ཡུལ་ ཡུལ་ཅན་ གཉིས་ཀ་ སྟོང་ ཞིང་རྒྱུ་འབྲས་ ཀྱི་ རྟེན་འབྲེལ་ མངོན་དུ་ མ་ གྱུར་པ འི་ སྟོང་པ་ རྐྱང་པ །ནམ་མཁའ་ གཉིས་ འདྲེས་ ལྟ་བུ་དེ་ ནི་ ཉན་ཐོས་ ཀྱི་ མངོན་རྟོགས་ ཡིན་པ འི་ ཕྱིར་ རོ །རྡོ ༽༽_ སྨིན་གྲོལ་ གཉིས་ ལ ས་གྲོལ་ ལམ་ བསྐྱེད་རྫོགས་ གཉིས་རྫོགས་རིམ་ ལ་ མཚན་མེད་ ཕྱག་རྒྱ་ ཆེན་པོ་ དང་མཚན་བཅས་ ཆོས་ དྲུག་ སོགས་ ཐབས་ལམ་ རྣམས་ དང་ གཉིས་ ལ ས་ཐབས་ལམ་ དེ་ རྟོགས་པ་ མ་ སྐྱེ་བ ར་ དགོངས་ ཤིང་སྐྱེས་ ནས་ མི་ དགོས་ ཏེ་ཆུ་ བརྒལ་ ཟིན་པ འི་ ཟམ་པ་ བཞིན་ ནོ་ ཞེས་ ཟེར་ རོ །འདི ར་ ནི་ རྟོགས་པ་ དང་ ལྡན་པ འི་ རྣལ་འབྱོར་པ་ ལ་ ཡང་ཐབས་ལམ་ ལྷག་པར་ དགོས་ ཏེ་མ་ རྟོགས་པ འི་ སེམས་ཅན་ རྣམས་ སྨིན་གྲོལ་ བྱེད་པ འི་ དོན་ དུ་རྫུ་འཕྲུལ་ དང་ མངོནཤེས་ ཡ་མ་ཟུང་ དགོས་ ཤིང་ །དེ འི་ རྒྱུ་ གཏུམ་མོ་ དང་ སྦྱིན་ སོགས་ ཐབས་ ཀྱི་ ལམ་ ཐམས་ཅད་ཉམས་ སུ་ ལེན་པ འི་ སྟོང་ཉིད་རྒྱུ་འབྲས་ སུ་ འབྱུང་བ འི་ ཕྱིར་ དང་ །དེ་དག་ དང་ དོན་མཐུན་པ ར་ སྤྱོད་ དགོས་པ འི་ ཕྱིར་ རོ །_།དེ་ལྟ་ ཡང །སློབ་དཔོན་ གྱིས །དེ་ལྟར་ རྣལ་འབྱོར་པ་ རྣམས་ ཀྱི །_།སྟོང་པ་ཉིད་ ནི xབློ་ ནི་ གཞན་དོན xའགྱུར་བ་ ཉིད་ དུ xཅེས་ དང༌ །བྱམས་མགོན་ གྱིས །མགོ་ ལ་ སེམས་ཅན་ ཁུར་ཆེན་ ཁྱེར་བ་ ཡི །_།སེམས་དཔའ་ མཆོག་ རྣམས་ དལ་ གྱིས་ འགྲོ་ མི་ མཛེས །_།ཞེས་པ ས་ སྒྲུབ་ རྒྱུད་ འདི འི་ གོང་མ་ རྣམས་ ཀྱིས་ མཛད་པ་ བཞིན་ ནོ །ལྷན ༽༽_ གཞན་ བཞེད་ ནི །མཚན་བཅས་ ཀྱི་ རྫོགས་རིམ་ རླུང་ སྦྱོར་བ་ བཞི་ ལྡན་ ནི ༑དང་པོ་ ཞག་འགའ་ སྟོང་པ ར་ བསྒོམས །དེ་ནས་ སྣ་བུག་ གཉིས་ ཀྱི་ རླུང་ །_།དྲག་པོ་ ལན་ གསུམ་ ཕྱི་རུ་ འབུད །_།དེ་ལྟར་ མ་ བྱས་ ནང་ དུ་ འགྲོ །_།དེ་ནས་ སྣ་ཐུག་ གཉིས་ ཀྱི་ རླུང༌ །_།ལྕགས་ཀྱུ་ བཞིན་ དུ་ དགུག་པ ར་ བྱ །_།དེ་ཡང་ འཇམ་ ལ་ རིང་བ འོ །_།དེ་ ཡིས་ རླུང་ ནི་ རང་གནས་ ཚུད །_།དྲག་ན་ རྩ་ གནས་ གཞན་ དུ་ དབྱེ ར །_།དེ་ ནི་ རྔུབ་པ འི་ རླུང་ སྦྱོར་ ཡིན ༑_༑རླུང་ ནི་ གཡས་གཡོན་ གཉིས་ ན་མ ར །_།ལུག་ རྒྱུད་ རྒྱུ་མ་ ཕུ ས་ བཏབ་ བཞིན །_།ཧ་ ར་ར་ ནི་ སོང་ ནས་ ཀྱང་ །_།དབུ་མ འི་ ནང་ དུ་ ཞུགས་པ ར་ བསམ །_།དེ་ ནི་ འགང་བ འི་ རླུང་ སྦྱོར་ རོ །_།དེ་ནས་ ཕོ་བ ར་ རླུང་ བཅུག་ ལ ༑_།ཐུབ་ ཀྱང་ དྲག་ ཏུ་ མནན་པ ར་ བྱ །_།མི་ ཐུབ་ དུས་ སུ་ ཅུང་ཟད་ རྔུབ །_།དེ ས་ ཀྱང་ མ་ ཐུབ་ སྣ་ གཉིས་ ནས །_།སེ་གོལ་ གཏོགས་པ འི་ ཚད་ ཙམ་ ཞིག _།ཕྱི་རུ་ བཏང་ ལ་ ལྷག་མ་ བསྡམས །_།དེ་ ནི་ གཞིལ་བ འི་ རླུང་ སྦྱོར་ རོ །_།བསྡམས་པ ས་ མ་ ཐུབ་ གཏོང་ དུས་ སུ །_།དངོས་ སུ་ སྣ་བུག་ གཉིས་ ན་ ཡར །_།ཆ་ གཅིག་ ཙམ་ གཅིག་ དལ་བར་ བཏང༌ །_།དམིགས་པ་ དབུ་མ འི་ ནང་ ལ་ ཡར །_།རྩལ་པོ་ཆེ་ ཡིས་ མདའ་ འཕང་ བཞིན །ཚངས་པ འི་ སྒོ་ ནས་ ནམ་མཁའ་ ལ །_།སྔོ་ ནི་ ཕྱུར་ཕྱུར་ འགྲོ་བ ར་ བསམས །_།མདའ་ ལྟར་ འཕངས་བ འི་ རླུང་ སྦྱོར་ རོ །_།ཞེས་ དེ་ བཞི་པོ་ ཟབ་པ ར་ འདོད་ ཀྱང་ །འདི ར་ ནི་ རླུང་ མི་ འཛིན་པ ར་ མ་ བཅོ ས་ལྷུག་པ ར་ འཇོག་པ་ ཉིད་ གནད་ ཟབ་པ ས །རླུང་ སེམས་ ཐ་དད་ མེད་པ ས་རླུང་ ལ་ རྩོལ་ འབུང་ འདོན་པ འི་ རྩ ར་ རྩི ར་ གཡོ་འགུལ་ མང་པོ་ ལ་འཁྲུལ་ འཁོར་ སྐད་ དུ་ བཏགས་ ནས་ བྱས་ ཀྱང་སེམས་ དངོས་པོ འི་ གནས་ལུགས་ མ་ མཐོང་ ན་གནས་སྐབས་ ལྟར་ སྣང་ཀུན་རྫོབ་པ འི་ ཡོན་ཏན་ ཕྲན་བུ་ སྐྱེ་སྲིད་ ཀྱང་མཐར་ཐུག་ གི་ ས་ཆོད་ ཆེ་བ འི་ གོ་ ཆོད་པོ་ མི་ འབྱུང་བ ས །རླུང་ སེམས་ དབྱེ ར་ མེད་ ཀྱི་ རྟོགས་པ འི་ ཡེ་ཤེས་ བསྐྱེད་པ འི་ རླུང་ གི་ གནད་ འཆིང་བ་ མ་ བྱས་ བྱར་མེད་ དུ་ཉམས་ སུ་ ལེན་པ་ ནི་ བཤད་རྒྱུད་ རྡོ་རྗེ་ ཕྲེང་བ་ ནས་ གསུངས་པ་ ལྟར་ཉམས་ སུ་ ལེན་པ་ གནད་ ཆེ་ སྟེ་ཚུལ་ ནི་ གཏུམ་མོ་ གསུམ་ ཁྲིད་ དུ་ རྟོགས་པ ར་ བྱོས་ ཤིག༑ ལྷན ༽༽_ འཕོ་བ་ ནི་ ཧཱུཾ་ ངམ་ ཡིག་འབྲུ་ གང་རུང་ ལ་ བརྟེན་ ནས་བླ་མ འམ་ ཡི་དམ་ གྱི་ ཐུགས་ཀ ར་ འཕོ་བ་ ཡིན་ ཟེར་ ཡང་དེ་ ནི་ རིམ་གྱིས་པ འི་ དབང་ དུ་ བྱས་ ཀྱི །འདི ར་ མཐར་ཐུག་ ནི་ རྣམ་ཤེས་ དང་ བླ་མ་ དང་ འོད་གསལ་ ཆོས་སྐུ་ གསུམ་ དབྱེ ར་ མེད་ དུ་ གྱུར་པ་ ནི་ འཕོ་བ འི་ མཆོག་ སྟེ །འཕོ་ བྱ་ འཕོ་ བྱེད་ ཀྱི་ རྟེན་ དང་ བྲལ་བ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང་ འཕོ་ རྒྱུ་ བྱུང་ ན་ རྣལ་འབྱོར་ མིན །ཞེས་ གསུངས་པ འི་ ཕྱིར་ ན་རྣལ་འབྱོར་ རབ་ ཀྱི་ འཕོ་བ འོ །རྡོ ༽༽_ རྟོགས་པ འི་ བོགས་ འདོན་པ་ ལ་རིགས་པ་ བརྟུལ་ཞུགས་ ཀྱི་ སྤྱོད་པ་ སྣ་ཚོགས་པ ས་རབ་བྱུང་ གི་ རྟགས་ དོར་ ནས་ རྣལ་འབྱོར་ གྱི་ ཆ་ལུགས་ ཕྱག་རྒྱ་ མ་ ཁྲིད་ ནས་དུར་ཁྲོད་ དང་ ཚོང་འདུས་ སོགས་ རྒྱུ་ ཞིང་ གླུ་གར་ བྱེད་ དགོས་ ཟེར །འདི ར་ རིགས་ ཤིང་ འོས་པ འི་ སྤྱོད་པ་ ཁྱད་པར་ དུ་ འཕགས་པ་ ནི་ ཚུལ་ཁྲིམས་ རིན་པོ་ཆེ་ ཡིན་ ཏེ་སྤང་བྱ་ ཉོན་མོངས་ དང་ རྣམ་རྟོག་ བརྟུལ་ ནས་ཡེ་ཤེས་ ཀྱི་ སྟོབས་ ལ་ ཞུགས་པ འི་ སྤྱོད་པ་སངས་རྒྱས་ ཀྱི་ གནས་ དང་ གནས་མིན་ མཁྱེན་པ འི་ ཡེ་ཤེས་ ཀྱིས་ བཅས་པ འི་དགག་སྒྲུབ་ ཀྱི་ བསླབ་པ་ འདི་ ཡིན་པ འི་ ཕྱིར་ དང༌ །དམ་པ་ དང་པོ་ ལ ས་ ཀྱང༌ །རྡོ་རྗེ་ འཛིན་པ་ མཆོག་ དགེ་སློང་ དུ་ གསུངས་པ་ དང༌ །བསྟན་པ་ འཛིན་སྐྱོང་ སྤེལ་བ་ ལ འང་འདི་ཉིད་ མཆོག་ ཡིན་པ འི་ ཕྱིར །དཔེར་ན་ འཕགས་པ་ ཀླུ་སྒྲུབ་ དང༌ །མཉམ་མེད་ དྭགས་པོ་ ལྷ་རྗེ་ བཞིན་ ནོ །_།དེང་སང་ འགའ་ཞིག་ བརྟུལ་ཞུགས་ ཀྱི་ སྤྱོད་པ་ ཡིན་པ ར་ཁ ས་ འཆེ་བ འི་ རུས་རྒྱན་ གྱི་ རྒྱན །ཁྱི་ ལྤགས་ དཀྲིས །རྒྱུ་འབྲས་ ཁྱད་ དུ་ གསོད་ ཅིང་ལུས་སྲོག་ ཐད་ ལ་ འཁོར་བ འི་ རྟོགས་ལྡན་ སྤྱོད་པ་ ལྷ་ ཀླུ་ ཐམས་ཅད་ དཀྲུག་ ཅིང་ཕཊ་ སྒྲ་ དང་ ཧཱུྃ་ སྒྲ ས་ ལུང་པ་ འགེངས །མིག་ ཧྲིག་ཧྲིག་ དུ་བ ར་ སྣང་ དུ་ བལྟ །ཁ་ ནས་ ཆོས་ ཐམས་ཅད་ སྟོང་པ་ ཆེན་པོ འོ་ ཟེར་ ནས་དོན་མེད་ ཁྱི་ ལྟར་ འཁྱམས་པ་ རྣམས་ ཀྱི་སྤྱོད་པ་ བརྟུལ་ཞུགས་ ལ ས་ ཆེས་ འཕགས་པ འི་ ཕྱིར་ཚུལ་ དེ་ལྟར་ དགོས་ སོ །_།རྡོ ༽༽_ རྣལ་འབྱོར་ བཞི འི་ མཐར་ཐུག་ སྒོམ་ མེད་རྟོགས་པ་ ན་མཉམ་བཞག་ ཆེན་པོ་ བྷུ་ སུ་ ཀུ་ སྟེ་ཟ་ཉལ་ འཆག་ གསུམ་ གྱི་ འདུ་ཤེས་ ཙམ་ མ་གཏོགས་བདེ་སྡུག་ མཐོ་དམན་ གང་ ལ འང་ ཞུམ་ ཁེངས་མེད་པ་ཤིང་ལོ་ རླུང་ ཁྱེར་ བཞིན་ དུ་ སྤྱོད་ དགོས་ ཟེར་ ཡང་འདི ར་ དེ འི་ སྟེང་ དུ་ ཆོས་ ཚུལ་ཁྲིམས་ དང་ སྒྲུབ་པ་ དང་ ཚད་ མེད་པ འི་ སྙིང་རྗེ་ གསུམ་ མི་ ལྡན་ ན་ཉན་རང་ དང་ ཁྱད་པར་ མེད་པ ས་དང་པོ་ རང་རྒྱུད་ ལ་ ཡོད་པ འི་ ལག་མཐིལ་ གྱི་ སྤུ་ཉག་ ལྟ་བུ འི་ ཉེས་པ་ ཤིན་ཏུ་ ཕྲ་བ འང་ སྤང་ དགོས་ ཏེ་ཡོན་ཏན་ མི་ ཐོབ་པ འི་ ཕྱིར །སློབ་དཔོན་ འཕགས་པ་ རྫ་བུམ་ ལ་ ཆགས་པ ས་གནོད་སྦྱིན་ མ་གྲུབ་པ་ དང་ །ཆོས་མཆོག་ ཉིད་ ཀྱི་ བརྩམས་པ འི་ ཚད་མ ར་ མཉེས་པ ས་ཤིང་ སྐམ་ ལ ས་ མེ་ཏོག་མ་ སྐྱེས་པ་ བཞིན་ ནོ །_།གཉིས་པ་ རང་རྒྱུད་ ལ་ འཕགས་པ་ རྣམས་ ཀྱི་ བྲལ་བ་ དང་རྣམ་སྨིན་ གྱི་ ཡོན་ཏན་ ཚད་ མེད་པ་ དག་ སྒྲུབ་ དགོས་ ཏེ །རྒྱུ་རྐྱེན་ མེད་པ ར་ མི་ འབྱུང་བ འི་ ཕྱིར་ རོ །_།གསུམ་པ་ རང་ཉིད་ གཅིག་པུ་ ཞི་བདེ་ འདོད་པ འི་ སེམས་ སྤངས་ ནས་ཚད་ མེད་པ འི་ སྙིང་རྗེ་ གཞན་དོན་ མཐར་ཐུག་ ཏུ་ བྱེད་ དགོས་ ཏེ །སྟོང་ཉིད་ སྙིང་རྗེ་ དང་ བྲལ་ ན་ དམན་པ ར་ འགྱུར་བ འི་ ཕྱིར །དེ་ གསུམ་ གཅེས་པ་ ཡིན་ ནོ །_།ལྟ་ སྒོམ་ སྤྱོད་པ་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ འི་ ཚིག་རྐང་ ཉི་ཤུ་ ལྷན་ཐབས་ ཚིག་རྐང་ ལྔ་ བཅས་ ཀྱི་ འགྲེལ་བཤད་ བྱེད་པ འི་ སྐབས་ ཏེ་ དྲུག་པ འོ །རྡོ ༽༽_ གཞན་ བཞེད་ ལྟར་ ན །སངས་རྒྱས་ ཀྱི་ ས ར་ ཆོས་སྐུ་ ཇི་ལྟ་ མཁྱེན་པ་བྲལ་བ འི་ ཡོན་ཏན་ རྣམས་ དོན་དམ །གཟུགས་སྐུ །ཇི་སྙེད་ མཁྱེན་པ འི་ རྣམ་སྨིན་ གྱི་ ཡོན་ཏན་ ཀུན་རྫོབ་ ཏུ་ འདོད་པ་ དང་ །ཡང་ རྡོར་ གཅོད་ ལ ས །གང་དག་ ང་ ལ་ གཟུགསུ་ མཐོང་ །།གང་དག་ ང་ ལ་ དགྲ ར་ ཤེས་ ན །_།ལོག་པ འི་ ལམ་ དུ་ ཞུགས་པ་ དེ །_།སྐྱེས་བུ་ དེ་དག་ ང་ མི་ མཐོང་ །_།ཞེས་པ ས་ ཆོས་སྐུ་ དོན་དམ་པ་ འབའ་ཞིག་ ཡིན་ ཟེར་བ་ དང༌ །ཡང་ རྟོགས་ བྱ་ དབྱིངས་ དང་རྟོགས་ བྱེད་ ཀྱི་ བློ་ འདྲེས་ གང་ཡོད་པ ས་ཆོས་སྐུ་ ལ་ ཡང་ ཀུན་རྫོབ་ ཀྱི་ ཆ་ཤས་ ཅུང་ཟད་ ཡོད་ ཟེར་བ་ སོགས་ སྣང་ ཡང་ །འདི ར་ འབྲས་བུ་ སངས་རྒྱས་ ཀྱི་ ས་ ན་བདེན་ གཉིས་ ཀྱི་ སྤྲོས་པ་ རྣམ་པ ར་ དབྱེ་བ ར་ བྱ་བ འི་ ཆོས་ ཙམ་ མེད་ དེ་དོན་དམ་ དང་ ཀུན་རྫོབ་ ནི་ གཅིག་ ལ་ གཅིག་ ལྟོས་ ནས་ བཞག་པ ས་འབྲས་བུ་ གཉིས་ མེད་མཉམ་པ་ཉིད་ དུ་ གྱུར་པ ས་ ན་དོན་དམ་པ་ ལ་ ལྟོས་པ འི་ ཀུན་རྫོབ་ མེད་ ཅིང་ །དེ་ ལ་ ལྟོས་པ འི་ དོན་དམ་ མེད་པ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང་ མཚན་ བརྗོད་ ལ ས །གཉིས་ མེད་ གཉིས་ སུ་ མེད་པ ར་ སྟོན །_།ཡང་དག་ མཐའ་ ལ་ རྣམ་པ ར་ གནས །ཞེས་ དང་ །བཤད་རྒྱུད་ རྡོར་ ཕྲེང་ ལ ས །ཀུན་རྫོབ་ དང་ ནི་ དོན་དམ་ དག _།རྟོག་པ་ གཉིས་ དང་ ཡང་དག་ བྲལ །_།གང་ དུ་ ཡང་དག་ འདྲེས་ གྱུར་པ །_།དེ་ ནི་ ཟུང་ དུ་ འཇུག་པ ར་ བཤད །ཅེས་ དང །རྩ་ཤེ ས་ ལ ས །གང་ གི་ རྟེན་ ཅིང་ འབྲེལ་བ ར་ འབྱུང༌ །_།འགག་པ་ མེད་པ་ སྐྱེ་ མེད་པ །_།ཆད་པ་ མེད་པ་ རྟག་ མེད་པ །_།འོང་བ་ མེད་པ་ འགྲོ་མེད་པ །_།ཐ་དད་ དོན་ མིན་ དོན་ གཅིག་ མིན །ཞེས་ དང་ །ཤེར་ སྙིང་ལས །གཟུགས་ སྟོང་པ འོ ༑༑ སྟོང་པ་ཉིད་ གཟུགས་ སོ ༑_།ཞེས་ སོགས་ མཐའ་ཡས་པ ས་ གཉིས་ ཆོས་ ཐམས་ཅད་ ལ ས་ འདས་པ་ ཡིན་ ནོ །རྡོ ༽༽_ བརྟེན་པ་ ཡེ་ཤེས་ ལ་ ཟླ་གྲགས་ སོགས་ ཐལ་འགྱུར་བ་ འགའ་ཞིག་རྒྱུན་མཐ འི་ རྡོ་ཏིང་ གི་ སྤངས་ བྱ་ ཕྲ་བ་ སྤང་བ་ ཡན་ཆད་ སྤང་བྱ་ ཡོད་པ ས་གཉེན་པོ་ ཡེ་ཤེས་ ཀྱང་ ཡོད་ དེ་ཤིང་ ཡོད་ ཚེ་ མེ་ལྕེ་ ཡོད་པ་ བཞིན་ ནོ །_།དེ་ལྟར་ ཡང །ཤེས་བྱ འི་ བུད་ཤིང་ སྐམ་པོ་ མ་ལུས་པ །_།བསྲེགས་པ ས་ ཞིང་ དེ་ རྒྱལ་ རྣམས་ ཆོས་སྐུ་ དེ །_།དེ་ ཚེ་ སྐྱེ་བ་ མེད་ ཅིང་ འགག་པ་ མེད །_།སེམས་ འགགས་པ་ དེ་ སྐུ་ ཡིས་ མངོན་སུམ་ མཛད །ཅེས་ དང །ཤེར་ སྙིང་ལས །ཡེ་ཤེས་ མེད་ ཅེས་པ ས་ སོ །_།ཡོད་པ ར་ གསུངས་པ་ ནི་ གཞན་དབང་ ཡིན་ ཟེར་ རོ །_།ཡང་ ལེགས་ལྡན་ སོགས་ རང་རྒྱུད་པ་ རྣམས་ ནི་མཐར་ཐུག་ ཡེ་ཤེས་ ནི་ ནམ་མཁའ་ ལ་ འདོམ་ གྱི་ གཞལ་བ འམ་མཚོན་ གྱི་ རི་མོ་ འབྲི་བ་ བཞིན་ ནོ །_།ཡེཤེས་ དེ་ ཐོས་ ནས་ ཐེ་ཚོམ་ ཟོས་པ་ ཙམ་ གྱིས་ ཀྱང་འཁོར་བ་ ནུས་ མེད་ དུ་ གཏོང་ སྟེ །བཞི་བརྒྱ་པ ར །གང་ཞིག་ ཆོས་ འདི་ ཐོས་པ འམ །ཐོས་ ནས་ ཐེ་ཚོམ་ ཟོས་པ ས་ ཀྱང༌ །_།སྲིད་པ་ ཧྲུལ་པོ ར་ གཏོང་བ ར་ བྱེད །ཅེས་ སོ །_།རྡོ ༽༽_ མྱ་ངན་ འདས་པ་ ལ ས་ ཆེས་ ལྷག་པ འི་ ཆོས་ གཅིག་ ཡོད་ ན་ཡང་ སྒྱུ་མ་ ལྟ་བུ་ གསུངས་པ ས་ སངས་རྒྱས་ ཀྱང་ སྒྱུ་མ་ ལྟ་བུ་ ཞེས་ འག ར་ སོགས་ ཀྱིས་ ཟེར་ རོ །_།སངས་རྒྱས་ ཆོས་ཅན་ཁྱོད་ སྒྱུ་མ་ ལྟ་བུ འི་ ཆོས་ ལ ས་ ཀྱང་ ཡང་དག་པ ར་ འདས་པ་ ཡིན་ ཏེ་འཁོར་འདས་ ཀྱི་ ཆོས་མ་ ལུས་པ་ སྤྲོས་པ་ དང་ བྲལ་བ འི་ ངོ་བོ ར་ སངས་རྒྱས་པ འི་ ཕྱིར་ དང་ ༑སྒྱུ་མ་ ནི་ འཁྲུལ་ཤེས་ མི་རྟག་པ་ ཡིན་པ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང་ ཆོས་ ཀུན་ སྒྱུ་མ ར་ ཐུགས་ སུ་ ཆུད །སྒྱུ་མ་ ཉིད་ ཀྱང་ མཆིས་ མ་ ལགས །_།སྒྱུ་མ འི་ ཆོས་ ལ ས་ རྣམ་གྲོལ་བ །_།མི་ རྟེན་ ཁྱོད་ ལ་ ཕྱག་ འཚལ་ ལོ །_།ཞེས་ ཡེ་ཤེས་ སྣང་བ་ རྒྱན་ ལ ས་ གསུངས་པ ས་བློ་ ལ ས་ འདས་པ་ ཡིན་ ནོ །_།འོ་ན་ སྒྱུ་མ་ ལྟར་ གསུངས་པ་ ཅི་ ཞེ་ན །དེ་ ནི་ སྒྱུ་མ་ ལ ས་ འདས་པ ར་མ་ རྟོགས་པ འི་ སེམས་ཅན་ སྒྱུ་མ་ དང་ རྨི་ལམ་ བཞིིན་ཁམས་ གསུམ་ དུ་ འཁོར་བ་ རྣམས་ ཀྱི་ ངོ ར་ གསུངས་ སོ །_།རྡོ ༽༽_ ཚད་མ འི་ བློ་ མངོན་སུམ་ དང་ རྗེས་དཔག་ གཉིས་ཚད་ མིན་ གྱི་ བློ་ ཐེ་ཚོམ་ ཡིད་དཔྱོད །_ ལོག་ཤེས །_ བཅད་ཤེས །_ སྣང་བ་ མ་ངེས་པ་ དང་ ལྔ་་ སྟེ་བདུན་ དུ་ གསུསངས་པ ས ༑ཐོ་ རང་ རྣམ་པ་ ཐམས་ཅད་ མཁྱེན་པ འི་ ཡེ་ཤེས་ བརྙེས་པ འི་ སྐད་ཅིག་ དང་པོ་ ཕན་ཆད་ཐུགས་ ཚད་མ་ ཡིན་ ལ་གཉིས་པ་ ཕྱིན་ཆད་ བཅད་ཤེས་ སྒྲོ་འདོགས་ ཆོད་པ་ ཡིན་པ ས་ཚད་མ ར་ མི་ འགྱུར་ ཟེར་བ་ དག་ ཀྱང་ ཡོད་ དོ །འདི ར་ སངས་རྒྱས་པ འི་ དུས་ རྣམས་རྟག་ ཏུ་ ཚད་མ ར་ བཞུགས་པ་ ཡིན་ ཏེ །དེ་བཞིན་ གཤེགས་པ་ འཇིག་རྟེན་ ན་མཉམ་པ་ མེད་པ་ དང་མི་ བསླུ་བ་ ཡིན་པ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང་ ལག་ ན་ རྡོ་རྗེ་ དབར་ བསྐུར་བ འི་ རྒྱུད་ ལ ས །དེ་བཞིན་ གཤེགས་པ་ ལྷ་ དང་ བཅས་པ འི་ འཇིག་རྟེན་ གྱི་ ཚད་མ་ མི་ བསླུ་བ འོ །_།ཞེས་ དང༌ །གསེར་འོད་ དང་ ལྟུང་བཤགས་ ཡོད་ དེ །མདོ་ སྡུད་པ་ ལ ས །ཡེཤེས་ མེད་ ན་ ཡོན་ཏན་ འཕེལ་ མེད་ བྱང་ཆུབ་ མེད །_།རྒྱ་མཚོ་ འདྲ་བ འི་ སངས་རྒྱས་ ཆོས་ ཀྱང་ མེད་པ ར་ གྱུར །ཞེས་ དང །མདོ་སྡེ་ རྣམས་ ནས །ཉིན་མཚན་ དུས་ དྲུག་ ཏུ་ འཇིག་རྟེན་ ལ་ ཡེ་ཤེས་ ཀྱི་ གཟིགས་པ་ འཇུག་པ ར་ གསུངས་པ་ དང༌ །མ་ འདྲེས་པ་ བཅོ་བརྒྱད་ ལ ས་ ཡེ་ཤེས་ ཀྱི་ བསྡུས་པ་ གསུམ་ དུ་ གསུངས་པ འི་ ཕྱིར་ ཡོད་ དོ་ཞེས་ སྨྲ་ ཡང་ །རང་ལུགས་ ལ་ སངས་རྒྱས་ ཀྱི་ ས ར་ མཁྱེན་པ འི་ ཡེ་ཤེས་ གཉིས་ སུ་ མེད་ ཅིང་སྤྲོས་པ འི་ མཐའ་ ཐམས་ཅད་ དང་ བྲལ་བ་ཟབ་མོ་ བསམ་ གྱིས་ མི་ ཁྱབ་པ འི་ འཁོར་ལོ ར་ བཞུགས་པ་ ཡིན་ ཏེ །ཡོད་མེད་ དུ་ འདོད་པ་ ནི་ གཉིས་ སྣང་ གི་ བློ་ ཡིན་ ལ་མཐའ་ ཐུག་ གི་ ཡེ་ཤེས་ སུ་ མ་ཟད་ལམ་ གྱི་ དོན་དམ་ ཡང་ བློ འི་ ཡུལ་ མིན་པ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང་ མཚན་ བརྗོད་ ལ ས །གཉིས་ མེད་ ཡེ་ཤེས་ ཚུལ་ འཆང་བ །_།རྣམ་པ ར་ ཤེས་པ འི་ ཆོས་ཉིད་ འདས །ཞེས་ དང༌ །སྤྱོད་འཇུག་ ལ ས །དོན་དམ་ བློ་ ཡི་ སྤྱོད་ཡུལ་ མིན །_།བློ་ ནི་ ཀུན་རྫོབ་ ཡིན་པ ར་ འདོད །ཅེས་ སོ །དེས་ན་ ཆོས་ ཐམས་ཅད་ ཀྱི་ གནས་ལུགས་ ཇི་ལྟ་བ་ མཁྱེན་པ་ དང༌ །སྟོང་ཉིད་ རྒྱུ་འབྲས་ སུ་ འབྱུང་བ འི་ ཆོས་ ཐམས་ཅད་ ཀྱི་གཞི་ ལམ་ འབྲས་བུ འི་ རྟེན་འབྲེལ་ ཇི་སྙེད་ མཁྱེན་པ་དེ་ གཉིས་ ཡོད་མེད་ སྤྲོས་པ་ ཐམས་ཅད་ ལ ས་ གྲོལ་བ་ ཡིན་ ནོ །_།ཡོད་མེད་ དུ་ འདོད་པ་ ནི་རྟག་ཆད་ དང་ བདེ་འགྲོ འི་ ལམ་ དང་ ངན་འགྲོ་ ལས་མ་ འདས་ ཏེ །ཏིང་འཛིན་_ རྒྱལ་པོ་ ལ ས །ཡོད་ དང་ མེད་ ཅེས་བྱ་བ་ མཐའ་ ཡིན་ ཏེ །དེ་བཞིན་ གཙང་ དང་ མི་གཙང་ འདི་ ཡང་ མཐའ །_།དེ་ཕྱིར་ མཐའ་ འདི་དག་ ནི་ རྣམ་ སྤངས་ ཏེ །མཁས་པ ས་ དབུས་ ལ འང་ གནས་པ ར་ མི་ བྱ འོ །_༑ཞེས་ དང་ །སློབ་དཔོན་ འཕགས་པ ས །ཡོད་ ཅེས་བྱ་བ་ རྟག་པ ར་ ལྟ །_།མེད་ ཅེས་བྱ་བ་ ཆད་པ ར་ ལྟ །_།དེ་ཕྱིར་ ཡོད་_ དང་ མེད་པ་ གཉིས །_།མཁས་པ ས་ གནས་པ ར་ མི་ བྱ འོ །_།ཞེས་ སོ །དེས་ན་ ཆད་པ་ ལྔ་ དང་ བྲལ་བ་ སྟེ །སྟོང་ཉིད་ དབུ་མ་ ཐལ་འགྱུར་བ འི་ རྒྱ་ཆད །ཉན་ཐོས་པ འི་ བཅོམ་ ཆད །མུ་སྟེགས་ ཆད་ལྟ་བ འི་ ཤི་ཆད །བློ ས་ བྱས་ ཀྱི་ སྟོང་པ་ ཕྱལ་ ཆད །རྫོགས་ཆེན་པ འི་ གདོད་ ནས་ ཡེ་ ཆད །དེ་ ལྔ་ ནི་ བློ ས་ གཞལ་བ འི་ ཆོས་ ལས་མ་ འདས་ ཏེ །དོན་དམ་ བློ་ ཡི་ སྤྱོད་ཡུལ་ མིན་ སོགས་ ཀྱིས་ ཤེས་པ ར་ ནུས་ སོ །_།དེས་ན་ བློ ས་ དཔག་པ་ ལ ས །ཚད་མ ར་ གཟིགས་པ །མཁྱེན་པ ར་ གཟིགས་པ་ ཞེས་ དང༌ །སློབ་དཔོན་ ཕྱོགས་གླང་ གིས །ཚད་མ ར་ གྱུར་པ་ འགྲོ་ ལ་ ཕན་ བཞེད་པ །སྟོན་པ་ བདེ་གཤེགས་ སྐྱོབ་ ལ་ ཕྱག་ འཚལ་ ལོ །_།དེས་ན་ བསམ་ གྱིས་ མི་ ཁྱབ་པ འི་ གནས་ ལ་ སྐུར་བ་ འདེབས་པ་འདི་ ལྟ་བུ་ ལ་ རྣ་བ་ བགབ་པ ར་ བྱ འོ །_།རྡོ ༽༽_ ས་ དང་པོ་ ཡན་ ལས་སྒྲིབ་ དང༌ །ས་ བདུན་ ལ་ ཉོན་སྒྲིབ །རྒྱུན་ མཐརཤེས་ སྒྲིབ་ སྤོང་བ འམ །མཐོང་ལམ་ གྱིས་ ཉོན་མོངས །སྒོམ་ལམ་ སྒོམ་ སྤངས་ ཏེ །མོས་པ་ བྲལ་བ འི་ ངོ་བོ ར་ སངས་རྒྱས་པ་ ན་མཉམ་བཞག་ སྟོབས་ ཆེ་བ ས་ རྗེས་ཐོབ་ ཆད་ དེ །རྟེན་ སྐུ་བསོད །བརྟེན་པ་ ཡེ་ཤེས་ མཛད་འཕྲིན་ རྣམས་ ཀྱང་ མེད་ དེ །མེ་ ཆེ ར་ འབར་ ན་ དུ་བ་ ཆད་པ་ བཞིན་ ནོ །ཅི་ཕྱིར །གསང་བ་ བསམ་ གྱིས་ མི་ ཁྱབ་པ འི་ མདོ་ ལ ས །ཐུགས་ ཀྱི་ གསང་བ འི་ སྐབས་འདུ་ཤེས་ མེད་པ འི་ ལྷ ར་ དཔེ་ མཛད་པ་ ཡང་ དོན་ འདི་ ཡིན་ ནོ །རྣམ་རྟོག་ མེད་ བཞིན་ དུ་ སྔར་ ཚོགས་ བསགས་པ ས་ནམ་མཁའ་ ལྡིང་ གི་ མཆོད་སྡོང་ དང་ནོར་བུ་ དཔག་བསམ་ ཉི་མ་ བཞིན་གདུལ་བྱ འི་ བློ་ ངོ ར་ སྣང་བ་ མི་ འགལ་ ཟེར་ རོ །_།འདི ར་ ནི་ སྤང་བྱ་ སྒྲིབ་པ་ ཐམས་ཅད་ དང་ བྲལ་བ འི་ འབྲས་བུ ས་སྤྲོས་བྲལ་ ཇི་ལྟ་ མཁྱེན་པ འི་ ཡེ་ཤེས་ དང་ རྟེན་འབྲེལ་ ཇི་སྙེད་ མཁྱེན་པ འི་ ཡེ་ཤེས་ ཀྱི་ ཐུགས་ ཅན་རྣམ་ རྟོགས་ ཐམས་ཅད་ དང་ བྲལ་བ་ བཞེད་ དེ་སྐུ་གསུང་ཐུགས་ ཀྱི་ ཕྲིན་ལས་ ཐམས་ཅད་ ཀྱི་ སྔོན་ དུ་ འགྲོ་ ཞིང་རྗེས་སུ་ འབྲང་བ་ དང༌ །དུས་གསུམ་ ལ་མ་ ཆགས་ མ་ ཐོག་པ འི་ ཡེ་ཤེས་ ཀྱི་ གཟིགས་པ་ འཇུག་པ ར་ གསུངས་པ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང་ །ནད་ ཐམས་ཅད་ ཞི་བ ར་ བྱེད་པ འི་ གཟུངས་ ལ ས །འདི་ ལ་ སངས་རྒྱས་ ནི་ སེམས་ཅན་ གྱི་ མཆོག་ གོ _།དཔའ་བོ ས །རྣམ་རྟོག་ མི་ མངའ་ ཅིར་ ཡང་ ས་ལེ ར་ མཁྱེན །ཅེས་ དང་ །མཚན་ བརྗོད་ ལ ས་ ༑ཡེ་ཤེས་ སྣང་བ་ ལམ་མེ་བ །ཞེས་ སོ ༑_།སངས་རྒྱས་ ཐུགས་ ཀྱི་ འཇུག་པ་ ཆད་པ ར་ འདོད་པ་ དེ་ ཆོས་ཅན །མཁྱེན་ གཉིས་ དང་ ཐུགས་ མི་ཟད་པ་ རྒྱན་ གྱི་ འཁོར་ལོ་ རྒྱུན་ ཆད་ དུ་ཐལ །འགགས་པ འི་ ཕྱིར་ བེམ་པོ་ བཞིན་ ནོ །_།དེ་ལྟར་ ཡང་ རིན་ཆེན་ འབར་བ འི་ རྒྱུད་ ལ ས །ཐམས་ཅད་ སེམས་ ལ་ གནས་པ ས་ ན །_།སེམས་ མེད་ སངས་རྒྱས་ མ་ ཡིན་ ཏེ །ངམ་གྲོག ས་ ལ་སོགས་ བེམ་བོ འོ །_།སེམས་ཉིད་ སངས་རྒྱས་ ཡིན་པ འི་ ཕྱིར །ཞེས་ སོ ༑_༑འོ་ན་ མེད་པ ར་ གསུངས་བ་ མཐའ་ཡས་པ ས་ ཅི་ ཞེ་ན །དེ་ ནི་ རྣམ་རྟོག་ གཉིས་ སུ་ འཛིན་པ འི་ སེམས་ མེད་ གསུངས་ ཀྱི །སྒྲིབ་པ་ ཐམས་ཅད་ བྲལ་བ འི་ ཡེ་ཤེས་ ཀྱི་ ཐུགས་ མེད་ ཅེས་ གསུངས་པ་ མིན་པ འི་ ཕྱིར་ རོ །_།སྣང་བ་ མེད་པ ར་ གསུངས་པ་ ཡང་ཕྱི་དོན་ དུ་ གྲུབ་པ་ མེད་པ ས་ ཡིན་ ནོ ༑_༑རྡོ _༽༽_ ཆོས་སྐུ་ སྟོང་པ་ཉིད་ མ་ རྟོགས་ ཀྱང་རང་བཞིན་ གྱིས་ སེམས་ཅན་ རྣམས་ ལ་ ཡོད་པ ས་ཚེས་ གཅིག་ གི་ ཟླ་བ་ ཉ ར་ འཕེལ་བ་ བཞིན་ས་བཅུ་ རྒྱུན་མཐ འི་ བར་ འཕེལ་བ ས་རྒྱུ་རྐྱེན་ གཉིས་ ཆོས་ ཐམས་ཅད་ ལ ས་ འདས་ ཏེ་བྱང་ཆུབ་པ་ ན་ སྐྱོན་ཡོན་ གང་ཡང་ མེད་ ཟེར་ རོ །འདི ར་ ནི་ ཆོས་སྐུ འི་ ཡོན་ཏན་ ལོངས་སྐུ་ དང་ སྤྲུལ་སྐུ་ ནི་དེ འི་ མཛད་པ འི་ ཕྲིན་ལས་ དང་ བཅས་པ་ སྟེ་དེ་དག་ ཆོས་སྐུ ར་ མངའ་བ་ ཡིན་ ཏེ །རྗེ་བཙུན་ བྱམས་པ ས །རང་དོན་ གཞན་དོན་ དོན་དམ་ སྐུ་ རང་ ནི །_།དེ་ ལ་ བརྟེན་ ནས་ ཀུན་རྫོབ་ སྐུ་ ཉིད་ དེ །ཞེས་ སོགས་ གསུངས་པ འི་ ཕྱིར་ རོ ༑_༑དེ་ལྟར་ ན་ སྐུ་གསུང་ཐུགས་ མི་ཟད་པ་ རྒྱན་ གྱི་ འཁོར་ལོ་སེམས་ཅན་ གྱི་ ཁམས་ དང་ མཉམ་པ་ཕྱི་མ འི་ མཐ འི་ མུ ར་ ཐུག་ གི་ བར་ དུ་ འབྱུང་བ་ ཡིན་ ནོ །_།དེ་ལྟར་ མིན་པ་ སངས་རྒྱས་པ་ མཐར་ཐུག་ཆོས་སྐུ འི་ ས ར་ ཡོན་ཏན་ ཕྲིན་ལས་ མེད་ ན་རྒྱུན་ ཆད་ དེ་ ཕྲིན་ལས་ མི་ འཇུག་ ཅིང་ཆད་ལྟ་བ་ དང་ ཁྱད་མེད་པ ར་ འགྱུར་ རོ ༑རྡོ ༽༽_ སངས་རྒྱས་ རྣམས་ འབྲས་བུ འི་ སྔོན་ དུ་རྒྱུ་ བྱང་ཆུབ་ ཏུ་ ཐུགས་བསྐྱེད་ དེ་འབྲས་བུ་ མཐ ར་ ཕྱིན་པ་ ན་རྒྱུ་ལ་ མི་ འཇུག་པ ས་ ཐུགས་བསྐྱེད་ ཡོད་ ཟེར །དེ་ ཆོས་ཅན་འབྲས་བུ་ མཐར་ཐུག་ རྣམ་པ་ ཐམས་ཅད་ མཁྱེན་པ་ སངས་རྒྱས་ ཀྱི་ ས་ ན འང་ ཐུགས་བསྐྱེད་ ཡོད་ དེ །བྱང་ཆུབ་ ཀྱི་ སེམས་ མཐ ར་ ཕྱིན་པ འི་ སྐུ་གསུང་ཐུགས་ མི་ཟད་པ་ རྒྱན་ གྱི་ འཁོར་ལོ་ རྒྱུན་ མི་ ཆད་པ འི་ ཕྱིར །དཔེར་ན་ ཉི་མ འི་ དཀྱིལ་འཁོར་ ལ་ འོད་ཟེར་ རྒྱུན་ མི་ ཆད་པ་ བཞིན་ ནོ །_།དེ་ལྟར་ ཡང་ བྱང་ཆུབ་ སེམས་ འགྲེལ་ ལ ས །བྱང་ཆུབ་ སེམས་ ཀྱི་ རང་བཞིན་ སྐུ །_།དཔལ་ལྡན་ རྡོ་རྗེ་ འཆང་ ལ་ འདུད །ཅེས་པ ས་གཞན་དོན་ དུ་ ཐུགས་བསྐྱེད་པ་ འཁོར་བ་ མ་ སྟོང་ གི་ བར་ དུ་ འབྱུང་ ཞིང་མྱ་ངན་ ལས་མི་ འདའ་ སྟེ །ཡབ་ སྲས་ མཇལ་བ་ ལ ས །དཔའ་བོ་ ཆེན་པོ་ ཐབས་མཁས་ ཏེ །_།བྱེ་བ་ བརྒྱད་ཅུ ར་ རྒྱལ་བ་ ཉིད །_།སངས་རྒྱས་ ཉིད་ དུ་ བསྟན་ གྱུར་ ཀྱང་ །_།ད་དུང་ ཆོག་པ འི་ འདུ་ཤེས་ གསལ །_།དཔའ་བོ་ ཆེན་པོ་ རྣམ་པ ར་ འཕྲུལ །_།བྱང་ཆུབ་ མཆོག་ ཏུ་ ཐུགས་ ཀྱང་ འཇུག _།ཅེས་ དང་ །དབུ་མ་ འཇུག་པ་ ལ ས །བདེ་བ ར་ གཤེགས་པ་ མ་ ལུས་ ཕྱོགས་ ཞིང་ སངས་རྒྱས་ མཐའ་དག་ ན །_།ཕྲ་རབ་ རྡུལ་ གྱི་ རྡུལ་ རྣམས་ བདོག་པ ར་ གྱུར་པ་ ཇི་སྙེད་པ །བྱང་ཆུབ་ མཆོག་རབ་ དམ་པ ར་ གཤེགས་པ འི་ བསྐལ་པ འང་ དེ་སྙེད་ དེ །འོན་ཀྱང་ ཁྱོད་ ཀྱི་ གསང་བ་ འདི་ ནི་ བསྙད་ བགྱི་ མ་ ལགས་སོ །_།རྒྱལ་བ་ ཇི་སྲིད་ འཇིག་རྟེན་ མཐའ་དག་ མཆོག་ ཏུ་ རབ་ ཞི་བ ར །འགྲོ་བ་ མིན་ ཅིང་ ནམ་མཁའ་ རྣམ་ འཇིག་ འགྱུར་ མིན་ དེ་སྲིད་ དུ །ཤེས་རབ་ ཡུམ་ གྱིས་ བསྐྱེད་པ་ ཁྱོད་ ལ་ ཐུགས་ བརྩེ་ མ་མ་ ཡི །_།ཚུལ་ ལུགས་ བྱེད་པ ས་ རབ་ཏུ་ ཞི་བ ར་ འགྱུར་བ་ ག་ལ་ མངའ །_།གཏི་མུག་ སྐྱོན་ གྱིས་ འཇིག་རྟེན་ ཁ་ཟས་ དུག་ བཅས་ ཟ་བ་ ཉིད །_།སྐྱེ་བོ་ ཉིད་ ཀྱི་ ནང་མི་ དེ་ ལ་ ཁྱོད་ བརྩེ་ ཇི་ལྟ་བ །_།དེ་ལྟར་ དུག་ ཟོས་ ཉེན་པ འི་ བུ་ ལ་མ་ ཡི་ སྡུག་བསྔལ་ མིན་པ ར་ འགྱུར་ མ་ ལགས ༎དེས་ན་ མགོན་པོ་ མཆོག་ ཏུ་ རབ་ ཞི ར་ གཤེགས་པ ར་ གྱུར་ མ་ ལགས །_།ཞེས་ དང༌ །སྡུད་པ་ ལ ས །མ་ ཞིག་ ན་བ ར་ གྱུར་པ་ བུ་ ནི་ མང་ ཡོད་པ །_།དེ་ ཀུན་ ཡིད་ མི་ བདེ་ ཞིང་དེ་ ལ་ རིམ་གྲོ་ བྱེད །_།དེ་བཞིན་ ཕྱོགས་ བཅུ འི་ འཇིག་རྟེན་ ཁམས་ ཀྱི་ སངས་རྒྱས་ ཀྱང༌ །_།ཡུམ་ གྱུར་ ཤེས་རབ་ དམ་པ་ འདི་ ལ་ དགོངས་པ་ མཛད །ཅེས་པ ས །སངས་རྒྱས་ ཀྱི་ ས་ ན་ ཐུགས་བསྐྱེད་མངོན་ རྒྱན་ ལ ས །ཆོས་ ཀྱི་ དགའ་སྟོན་ སྒྲ་སྙན་ ལྟ་བུ་ དང༌ །_།བགྲོད་ གཅིག་ ལམ་ ཆུ་བོ་ ལྟ་བུ་ དང༌ །ཆོས་སྐུ་ སྤྲིན་ ལྟ་བུ་ གསུམ་ དུ་ གསུངས་པ་ དང༌ །མངོན་ རྒྱན་ ལ ས །སྒྲིབ་པ་ སྤངས་པ འི་ སེམས་བསྐྱེད་ སོགས་ བཤད་ ཅིང་ །གསང་འདུས་ གཉིས་ མེད་ རྣམས་ ལ ས །བྱང་ཆུབ་ སེམས་ ནི་ མི་ཟད་ ཕྱིར །_།དེ་ཕྱིར་ ཕྲིན་ལས་ རྒྱུན་ མི་ ཆད །ཅེས་ སོ །ལྷན ༽༽_ སངས་རྒྱས་ མྱ་ངན་ འདས་ ན་ བུད་ཤིང་ ཟད་པ འི་ མེ་ བཞིན་ དུ་ འདོད་པ་ དང་སྐུ འི་ གདུལ་བྱ་ ཟད་ ནས་ གསུང་ གི་ གདུལ་བྱ ར་ བསྟན་ ཏེ་འོག་མིན་ དུ་ གཤེགས་ ཏེ་ བཞུགས་པ ས་བསོད་ནམས་ བསགས་པ འི་ ངོ ར་ལན་ རེ་ སྣང་བ་ ཡིན་ ཟེར་ རོ །_།འདི ར་ བྱང་ཆུབ་ ཀྱི་ སེམས་ གཉིས་ ཀྱི་ རང་བཞིན་ གྱི་ གཟུགས་སྐུ་ སངས་རྒྱས་ དེ་སྐུ་གསུང་ཐུགས་ མི་ཟད་པ་ རྒྱན་ གྱི་ འཁོར་ལོ་ མཐའ་ ཐམས་ཅད་ དང་ བྲལ་བ་ ཡིན་ ཏེ །ལྗོན་ ཞུས་ ལ ས །རྒྱུ་ལ་ བརྟེན་པ འི་ མཁས་པ་ བཅོམ་ལྡན་འདས །_༑མཐའ་ གཉིས་ ལྟ་བ་ རྟག་ ཏུ་ མི་ མངའ་བ །ལ ས་ ཀྱི་ རྣམ་སྨིན་ འབྲས་བུ་ ཁོ་ན་ གསུངས །_།ལྟ་བ འི་ མུན་ བྲལ་ ཁྱོད་ ལ་ ཕྱག་ འཚལ་ ལོ །_།ཞེས་ དང་ །མདོ་ རྒྱན་ ལ ས །འཛིན་པ་ མི་ མངའ་ ཉེ ས་ མི་ མངའ །_།རྙོག་པ་ མི་ མངའ་ མི་ གནས་པ །_།མི་ གཡོ་ ཆོས་ རྣམས་ ཐམས་ཅད་ ལ །།སྤྲོས་མེད་ ཁྱོད་ ལ་ ཕྱག་ འཚལ་ ལོ །_།ཞེས་པ་ བཞིན་ ཡིན་ ནོ །རྡོ ༽༽_ ཆོས་སྐུ་ སྟོང་པ་ གཟུགས་སྐུ འི་ ཡོན་ཏན་ ཕྲིན་ལས་ ཐམས་ཅད་ དང་ འབྲེལ་བ་ མེད་ ཅིང་གདུལ་བྱ་ འདི་ ལྟ་བུ ས་ འདུལ་བ ར་ བྱེད་ སྙམ་པ འི་ ཐུགས་ མེད་ ཀྱང་ །མི་ཟད་པ་ རྒྱན་ གྱི་ འཁོར་ལོ ས་ གཞན་ སྣང་ ལ་ རྣམ་འཕྲུལ་ ཙམ་ དུ་ འབྱུང་ ཟེར་བ་ དང་ཡང་འཇུག་པ་ མི་འཆད་པ ར་ བཟང་བ་ འབའ་ཞིག་ ཏུ་ འབྱུང་བ ར་ འདོད་ ཀྱང༌ །འདི ར་ ཐུགས་ ནི་ ཐ་ན་ རྟག་ཆད་ ཀྱི་ ལྟ་བ་ ཚུན་ཆད་ ལ་ ཡང་ འབྱུང་བ་ ཡིན་ ཏེ་གདུལ་བྱ འི་ རྣམ་རྟོག་ དང་ཡིད་ ཀྱི་ འཇུག་པ འི་ བྱེ་བྲག་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་ ཅི་ སྙེད་པ་དེ་སྙེད་ དུ་ འདུལ་ བྱེད་ ཐུགས་ ཀྱི་ འཇུག་པ་ ཡང་ འབྱུང་བ འི་ ཕྱིར །མྱ་ངན་ འདས་ མདོ་ ལ ས །_།ལོང་བ་ མ་ ལགས་ ལོང་བ་ ལྟར །_།ཞ་བོ་ མ་ ལགས་ ཞ་པོ་ ལྟར །_།བྱིས་པ་ མ་ ལགས་ བྱིས་ ཚུལ་ གྱིས །_།སེམས་ཅན་ རྣམས་ ནི་ སྨིན་པ ར་ མཛད །།_།བརྒྱ་བྱིན་ ཚངས་པ འི་ ཆ་བྱད་ ཀྱིས །_།སེམས་ཅན་ རྣམས་ ཀྱི་ དོན་ མཛད་ ཀྱང༌ །_།འཇིག་རྟེན་ རྣམས་ ཀྱིས་ རྟོགས་ མི་ ནུས །ཞེས་ དང་ །གསང་བ་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་ ལ ས །སངས་རྒྱས་ ཀྱི་ ཐུགས་སེམས་ ཀྱི་ དམིགས་པ་ དང་ ཡང་ བྲལ་ ལ །སེམས་ཅན་ ཐམས་ཅད་ ཀྱི་ སེམས་ ཀྱི་ དཔྱོད་པ་ དང་ བསམ་པ་ ཡང་ རབ་ཏུ་ ཤེས་ སོ །_།ཞེས་ གསུངས་པ ས །འཇིག་རྟེན་ ཐ་མལ་པ འི་ གཏམ་ དང་ ཆད་པ་ དང་ རྟག་པ་ ལས་རིམ་ གྱིས་ གོང་ དུ་ ཁྲིད་ དེ །མཐ ར་ ནང་པ འི་ ལམ་ ལ་ དྲངས་ ཏེ་རྣམ་མཁྱེན་ ལ་ འགོད་པ ར་ མཛད་པ འི་ ཐབས་མཁས་ བསམ་ གྱིས་ མི་ ཁྱབ་པ འི་ གནས་ ཡིན་ ནོ །རྡོེ ༽༽ གདུལ་བྱ་ འདུལ་བ་ ལ་ སྤྲུལ་པ་ མཆོག་ གི་ དོན་ བྱེད་པ་ ལ ས་ གཞན་ དམན་པ་ མཱི་ བྱོན་ ཟེར་བ འི་ ཚུལ་ དེ་ ཁོ་ན་ མ་ ཡིན་ ཏེ །འདི ར་ ལྟར་ བེམ་པོ་ དང་ མུ་སྟེགས་ དང་ བདུད་ དང་ ཉོན་མོངས་ སོགས་ ཤེས་བྱ ར་ སྲིད་ ཚད་ ཀྱིས་ སངས་རྒྱས་ ཀྱི་ བྱ་བ་ བྱེད་པ འི་ ཕྱིར །དྲི་མ་ མེད་པ ར་ གྲགས་པ འི་ མདོ་ ལ ས །ཀུན་དགའ་བོ་ གང་དག་ ན་ སངས་རྒྱས་ ཀྱི་ མཛད་པ་ བྱེད་པ འི་ སངས་རྒྱས་ ཀྱི་ ཞིང་ རྣམས་ ཀྱང་ ཡོད་ དོ །_།དེ་བཞིན་ དུ་ སྦྱར་ ཏེ་ འོད་ དང༌ །བྱང་ཆུབ་ ཀྱི་ ཤིང་ དང་ཁ་ ཟས་ དང་ །ཆུ་ དང་ །_ བསྐྱེད་ མོས་ ཚལ་ དང༌ །གཞལ་མེད་ ཁང་ དང་ ཁང་པ་ བརྩེགས་པ་ དང་སྤྲུལ་པ་ དང་ ནམ་མཁའ་ དང༌ །བར་སྣང་ དང །_ རྨི་ལམ་ དང༌ །_ གཟུགས་བརྙན་ དང་ །ཆུ་ཟླ་ དང༌ །_ བྲག་ཆ་ དང༌ །_ སྒྱུ་མ་ དང༌ །སྨིག་རྒྱུ་ དང་ །_ ཡི་གེ ར་ སྟོན་པ་ དང༌ །_ བརྗེད་པ་ མེད་པ་ དང་ །ལོངས་སྤྱོད་ དང་ །_ བདུད་ བཞི་པོ་ དང༌ །ཉོན་མོངས་པ འི་ སྒོ་ སྟོང་ཕྲག་ བརྒྱད་ཅུ་ རྩ་ བཞི་ དག་ གིས་ སངས་རྒྱས་ ཀྱི་ མཛད་པ་ བྱེད་ དོ །_།ཅེས་ དང༌ །བྱང་སེམས་ ཐབས་ ཀྱི་ སྤྱོད་ཡུལ་ རྣམ་པ ར་ འཁྲུལ་པ་ བསྟན་པ་ ལ ས །འཇམ་དཔལ་ སངས་རྒྱས་ ཀྱི་ ཞིང་ འདི་ ན་གཞན་ མུ་སྟེགས་ ཅན་ ཀུན་ ཏུ་ དཔྱོད་པ་བ་ གང་དག་ སྣང་བ་འདི་ ཡང་ དེ་བཞིན་ གཤེགས་པ འི་ བྱིན་རླབས་ དང་ ཐབས་མཁས་ བསམ་ གྱིས་ མི་ ཁྱབ་པ ར་ རིགས་པ ར་ བྱ འོ །_།དེ་ ཅིའི་ཕྱིར་ ཞེ་ན །འདི་དག་ ནི་ རྣམ་པ ར་ ཐར་པ་ བསམ་ གྱིས་ མི་ ཁྱབ་པ འི་ སྒོ་ ལ་ གནས་པ་ དང་ཕ་རོལ་ ཏུ་ ཕྱིན་པ་ ལ་ ངེས་པར་ འབྱིན་པ་ ལ་ཐབས་མཁས་པ ས་ སྣེར་ བརྩེ་བ་ ཤ་སྟག་ གོ _།དཀོན་མཆོག་ གསུམ་ ཡིད་ ལ་ བྱ་བ་ མ་ བཏང་བ་སེམ་ ཅན་ ཡོངས་སུ་ སྨིན་པ ར་ བྱ་བ་ ལ་ དམ་པ འི་ ཕ་རོལ་ ཏུ་ སོན་པ་ ཤ་སྟག་ གོ _།ཞེས་ དང༌ །དེ་བཞིན་ དུ་ བློ་གྲོས་ རྒྱ་མཚོ ས་ ཞུས་པ་ དང༌ །ཆོས་ ཀུན་འགྲོ་བ་ སོགས་ མདོ་ མང་པོ ར་མཐའ་ཡས་པ ར་ གསུངས་ ཤིང་འདོད་ཆགས་ དང༌ །_ ཞེ་སྡང་ །_ གཏི་མུག་ གིས་ བྱ་བ་ བྱས་པ་ རིམ་བཞིན །དགེ་སློང་ བསྟན་པ འི་ བློ་གྲོས་ དང་ ༑སོ ར་ འཕྲེང་ སངས་རྒྱས་ བཅོམ་ལྡན་འདས་ མཐོང་ ན་ དགའ་བ་ ཅན་ དང་ །འོད་སྲུང་ རྫོགས་བྱེད་ ལྟ་བུ་ ཡིན་ ནོ །དེ་ལྟར་ ཡང་ཡང་ དག་སྦྱོར་བ འི་ རྒྱུད་ ལ ས །རྡུལ་ དང༌ །_ མུན་པ །_ སྙིང་སྟོབས་ ཀྱང་ སེམས་ཅན་ གྱི་ དོན་ བྱེད་ དོ་ ཞེས་ སོ །_།དེ་ལྟར་ ཐམས་ཅད་ ཀྱིས་ བྱ་བ་ བྱེད་ ཀྱང་དུས་ ལ་མ་ བབས་པ ར་ མི་ འགྱུར་ ཏེ །ཆོས་ ཀུན་འགྲོ་ བར །དཔེར་ན་ མེ་ ནི་ ཤིང་ ཐམས་ཅད་ ལ་ གནས་ མོད་ ཀྱི །རྐྱེན་ དང་ རྩོལ་བ་ མ་ཚང་ ན་ མི་ འབར་ ཞིང་ དགོས་པ་ རྣམས་ མི་ བྱེད་ དོ །དེ་བཞིན་ དུ་ སངས་རྒྱས་ རྣམས་ ཤེས་བྱ་ ཐམས་ཅད་ ལ་ གནས་ མོད་ ཀྱང་ །དད་པ་ སོགས་ རྐྱེན་ མ་ཚང་ ན་ མི་ འབྱུང་ ཞིང་ བྱ་བ་ མི་ མཛད་ དོ །_།ཞེས་ སོ །རྡོ ༽༽_ སངས་རྒྱས་ རྣམས་ ནི་ ཞིང་ དག་པ་ དང་ མ་ དག་པ་ དབྱིབས་ ཀྱང་ སྣ་ཚོགས་པ འི་ ཞིང་ ཐ་དད་པ་ དེ ར་ སངས་ རྒྱ་བ་ ཡིན་ ཟེར་ ཡང༌ །འདི ར་ ནི་ ཆོས་དབྱིངས་ མ་ལུས་པ་ ཀུན་ ཏུ་ འཚང་ རྒྱ་ དགོས་པ ར་ བཞེད་ དེ་བདེ་བ ར་ གཤེགས་པ་ ཆོས་ ཐམས་ཅད་ མངོན་པར་ རྫོགས་པ ར་ བྱང་ཆུབ་པ་ ཡིན་པ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང་ རྒྱ་ ཆེ ར་ རོལ་པ་ ལ ས །ཚངས་པ་ ངས་ ཡོངས་སུ་ ཆད་པ འི་ རྣམ་པ ས་ཚད་ དང་ ལྡན་པ ར་ སངས་རྒྱས་པ་ མ་ ཡིན་ གྱི །ཚངས་པ་ ང་ ནི་ ཚད་ མེད་ ཅིང་ རིས་ སུ་ མ་ ཆད་པ འི་ རྣམ་པ ས་ཆོས་ ཐམས་ཅད་ མཉམ་པ་ཉིད་ དུ་ མངོན་པར་ རྫོགས་པ ར་ བྱ འོ །_།ཞེས་ དང༌ །ཡུམ་ ལ ས་ ཆོས་ ཐམས་ཅད་ མངོན་པར་ རྫོགས་པ ར་ སངས་རྒྱས་ སོ །_།ཞེས་ དང༌ །ཡུམ་ ལ ས་ ཆོས་ ཐམས་ཅད་ མངོན་པར་ རྫོགས་པ ར་ སངས་ རྒྱ་བ ར་ འདོད་པ་ཤེར་ཕྱིན་ ལ་ བསླབ་པ ར་ བྱ འོ །_།ཞེས་ དང་ ཕལ་ཆེན་ ལ ས །སྟོང་གསུམ་ འདི་ཉིད་ དུ་གླིང་བཞི་ བྱེ་བ་ ཕྲག་ བརྒྱ ར་ སངས་རྒྱས་པ ར་ གསུངས་ ཤིང་ །གཞན་ ཡང་ དཔའ་བ ར་ འགྲོ་བ་ དཀོན་མཆོག་ འབྱུང་གནས །སོ ར་ འཕྲེང་ ལ་ ཕན་པ་ སོགས་ མཐའ་ཡས་པ ར་ གསུངས་ སོ །_།དེ་ ན་མ་ གྲུབ་ ན་ ཚོགས་ མཐའ་ཡས་པ འི་ འབྲས་བུ ས་འཁོར་ལོ ས་ བསྒྱུར་བ་ ལ ས་ ཆུང་བ ར་ འགྱུར་ ཏེ་ཕལ་ཆེན་ ལ ས་ འཇིག་རྟེན་ ཁམས་ རྒྱ་མཚོ་ བཅུ འི་ གྲངས་ ཀྱི་རྡུལ་ དང་ མཉམ་པ་ ལ་ དབང་ བྱེད་པ འི་ འཁོར་ བསྒྱུར་ ཡོད་པ ར་ གསུངས་པ འི་ ཕྱིར་ རོ །_།དེ་བས་ན་ སེམས་བསྐྱེད་པ འི་ གནད་ཕྱིས་ ཐམས་ཅད་ དུ་ སངས་རྒྱས་པ་ ཡིན་ ནོ །རྡོ ༽༽ སྤྲུལ་སྐུ་ སྐྱེས་སྟོབས་ ལ ས་ བྱུང་བ་ མཆོག་ དང༌ །མཆན་ མཛད་པ ༡༢ །དམན་པ་ ཉན་རང་ དང༌ །_ བཟོ་ དང༌ །_ སྒྱེ་བ་ རི་བོང་ སོགས་ སྟེ་ བཞི་ བསྒོམས་པ་ ལ ས་ བྱུང་བ་བསྟན་པ འི་ བློ་གྲོས་ བརྟུལ་བ འི་ སྨད་ ཚོང་ མ་ ལྟ་བུ་ དེ་དག་ རྒྱུ་ མེད་ ཀྱང་རྣམ་འཕྲུལ་ ཙམ་ དུ་ འབྱུང་ ཞིང་དགེ་ མི་དགེ འི་ འབྲས་བུ་ མི་ དགོས་ ཟེར་བ་ དག་ ཆོས་ཅན །རྒྱུ་ མེད་པ འི་ སྤྲུལ་པ་ མི་ སྲིད་པ ར་ ཐལ །གང་ ལ་མ་ ལྟོས་པ འི་ ཆོས་ མི་ འགྲུབ་པ འི་ ཕྱིར །རི་བོང་ གི་ རང་བཞིན་ ནོ །_།མ་ གྲུབ་ ན་ཕུར་བུ་པ འི་ འདོད་པ་ ཁ ས་ ལོངས་ ཤིག _།དེ་ལྟར་ ཡང༌ །རྒྱུ་ལ་ བརྟེན་་_པ འི་ མཁས་པ་ བཅོམ་ལྡན་འདས །_།མཇའ་ གཉིས་ ལྟ་བ་ རྟག་ ཏུ་ མི་ མངའ་ ཞིང༌ །_།ལ ས་ ཀྱི་ རྣམ་སྨིན་ འབྲས་བུ་ དེ་དག་ གསུངས །_།མ་སྐྱེས་དགྲ འི་ འགྱོད་ བསལ་ ལ ས །ཆོས་ ཐམས་ཅད་ རྒྱུ འི་ རྗེས་སུ་ འགྲོ་བ །ཞེས་ དང་ འདུལ་བ འི་ དུས་ ལ་ བབ་པ་ ན །ཏིང་ངེ་འཛིན་ འདི་ ཞེས་ བྱ་བ་ ལ་ སྙོམས་པར་ ཞུགས་ སོ །ཞེས་པ་ དེ་རྒྱུ་ བསྒྲུབ་པ་ ཡིན་ ཅིང་ སྤྱིར་ ཆོས་ ཐམས་ཅད་ སྤྲུལ་པ་ ཡིན་པ །ཡུམ་ ལ ས །རབ་འབྱོར་ ཁ་ཅིག་ ནི་ ཉོན་མོངས་པ འི་ སྤྲུལ་པ འོ །_།དེ་བཞིན་ དུ་ ལ ས་ དང་ །_ ཉན་ཐོས་ དང་ །_ རང་རྒྱལ་ དང་ །_ སངས་རྒྱས་ ཀྱི་ སྤྲུལ་པ འོ །_།གསུངས་པ ས །ཁྱེད་ ལྟར་ ན་ ཐམས་ཅད་ རྒྱུ་ མེད་ དུ་ཐལ་ བར་ འགྱུར་ རོ །_།དེས་ན་ སངས་རྒྱས་ རང་ ལ ས་ རྒྱུད་པ འི་ རྒྱུ་ཅན་ ནོ །རྡོ ༽༽_ གཟུགས་སྐུ་ གཉིས་ དང་ ཡེ་ཤེས་ སངས་རྒྱས་ ཆོས་སྐུ་ ལ་ མེད་ ཀྱང་གདུལ་བྱ འི་ གཞན་ སྣང་ ཡིན་ ཟེར་ ཡང༌ །འདི ར་ ནི་ ཆོས་སྐུ་ རྣམ་པ ར་ དག་པ་ བརྙེས་པ་ དང༌ །སེམས་ཅན་ རྣམས་ སངས་རྒྱས་ ཀྱི་ ས ར་ འགོད་པ འི་ ཐུགས་དམ་ བཞེས་པ་ དང༌ །གདུལ་བྱ་ རྣམས་ ཀྱི་ སངས་རྒྱས་ དང་ ཕྲད་པ འི་ ལ ས་ བསགས་པ འི་ དད་པ འི་ སྣང་བ་ གསུམ་ འཛོམས་ ན་སངས་རྒྱས་ མཐོང་ སྟེ །རྒྱུད་བླ་མ་ ལ ས །ཇི་ལྟར་ བཻཌཱུར་ ས་གཞི་ གཙང་མ་ ལ །_།ལྷ་དབང་ ལུས་ ཀྱི་ གཟུགས་བརྙན་ སྣང་བ་ ལྟར །_།དེ་བཞིན་ འགྲོ་ སེམས་ ས་གཞི་ གཙང་མ་ ལ །_།ཐུབ་པ འི་ དབང་པོ འི་ སྐུ་ ཡི་ གཟུགས་བརྙན་ འཆར །ཞེས་ དང་ །བརྒྱད་ སྟོང་པ་ ལ ས །པི་ཝང་ གི་ དཔེ ས་ བསྟན་པ་ དང་ །དབྱེན་ གྱི་ གཞི་ ལ ས །སངས་རྒྱས་ བཅོམ་ལྡན་འདས་ རྣམས་ ནི་ སྐུ་ གཅིག་ གིས་ མ་ ཡིན །རྐྱེན་ གཅིག་ གིས་ མ་ ཡིན །དགེ་བ འི་ རྩ་བ་ གཅིག་ གིས་ མ་ ཡིན །ཅེས་པ ས །ཡེ་ཤེས་ ཡོན་ཏན་ ཕྲིན་ལས་ རྣམས་ རྒྱུ་རྐྱེན་ ཚོགས་ ན་ འབྱུང་བ་ དང་སྐུ་ དང་ ཡེ་ཤེས་ མཛད་པ་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་ རྣམས་སངས་རྒྱས་ ཉག་གཅིག་ གི་ སྤྱོད་ཡུལ་ ཡིན་པ ས་གཞན་ སྣང་ ཁོ་ན འང་ མིན་པ་ དེ འི་ ཕྱིར །སངས་རྒྱས་ ཞེས་ བྱ་བ་ ནི་ རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་ ལ་སོགས་པ འི་ སྐུ་ ཡིན་ ནོ །རྡོ་ ༽༽_ ཀུན་རྫོབ་ བྱང་ཆུབ་ ཀྱི་ སེམས་ སྨོན་པ་ ལ ས་ སྤྲུལ་སྐུ་ འབྱུང་བ་ ཁོ་ན ར་ ངེས་ ཟེར་ ཡང །དེ་ གཅིག་པུ ར་ མ་ ངེས་ ཏེ །སྨོན་ འཇུག་ གཉིས་ ལས་རིམ་ བཞིན་ ལོངས་སྐུ་ དང་ སྤྲུལ་སྐུ་ རུ་ འབྱུང་བ འང་ ཡོད་པ ར་ སྲིད་ དེ །ནམ་མཁ འི་ མཐའ་ དང་ མཉམ་པ འི་སེམས་ཅན་ བློ འི་ ཁོངས་ སུ་ ཆུད་པ འི་ སྨོན་པ་ འདི འི་ འབྲས་བུ་ ཡང་ ཚད་_ མེད་པ འི་ ཕྱིར་ དང༌ །རབ་འབྱམས་ ཕྱོགས་ བཅུ འི་ སངས་རྒྱས་ ལ་འདོད་འདུན་ གྱིས་ བསྐྱེད་པ འི་ ཕྱིར་སྨོན་པ་ ལ ས་ ལོངས་སྐུ་ འབྱུང་ ཞིང༌ །སེམས་བསྐྱེད་པ་ དེ་ ལ་ བརྟེན་པ་ དགེ་རྩ་ ཐ་དད་ རེ་རེ ས་ ཀྱང་ སྤྲུལ་པ འི་ སྐུ་ རེ་རེ་ འབྱུང་བ་ཆོས་དབྱིངས་ ཐམས་ཅད་ དུ་ སངས་ རྒྱ་བ་ དང་ །སྐུ་རྟེན་ འབྲེལ་ དུ་ བཞེད་པ་ དག་ སྤྲུལ་པ་ རྒྱུ་ཅན་ དུ་ བཞེད་པ འི་ གནད་ ཀྱིས་ ཡིན་ ནོ །༑ སྔ་མ་ ལྟར་ རྫ་མཁན་ ཡང་པ འི་ འོད་ ལྟར་སངས་རྒྱས་ གཅིག་ ལ་ འདོད་འདུན་ བསྐྱེད་པ ས་ སོ །_།རྡོ ༽༽_ སྐུ་གསུམ་པོ་ རིམ་བཞིན་ གནས་ ཆོས་དབྱིངས་ ཀྱི་ ཕོ་བྲང་ དང༌ །འོག་མིན་ དང༌ །བྱ་རྒོད་ ཕུང་ རི་ སོགས་ སུ །འཁོར་ སངས་རྒྱས་ དང་ །_ ས་བཅུ་པ་ དང་ །_ ཐེག་པ་ གསུམ་ གྱི་ རིགས་ཅན་ ལ་ཆོས་ ཟབ་མོ་ སྐྱེ་ མེད་ དང༌ །ཐེག་ཆེན་ དང་ ཐེག་པ་ སྣ་ཚོགས་ དང་ །དུས་ དུས་གསུམ་ དུས་ མེད་ དང་ །རྟག་པ་ རྒྱུན་ འཁོར་ དང་ འདུལ་བ འི་ དུས་ ཏེ་ གསུམ་ ལ་སོ་སོ་ ཐ་དད་ དུ་ སྟོན་པ་ ཡིན་ ཟེར་ རོ །_།འདི ར་ ནི་ སྐུ་གསུམ་པོ་ ཐ་དད་ མེད་པ ར་ བཞུགས་པ་ ཡིན་ ཏེ་རྒྱུ་ བླ་མ་ ལ ས །དེ་ ནི་ རང་བཞིན་ དག་ ཕྱིར་ དང་ །_།བག་ཆགས་ སྤངས་ ཕྱིར་ གཙང་བ་ ཡིན །_།བདག་ དང་ བདག་མེད་ སྤྲོས་པ་ དག _།ཉེ་བར་ ཞི་བ་ དམ་པ འི་ བདག _།ཡིད་ ཀྱི་ རང་བཞིན་ ཕུང་པོ་ དང༌ །_།དེ་ རྒྱུ འི་ ལོག་ ཕྱིར་ བདེ་བ་ ཉིད །_།ཅེས་པ ས་ མཚན་ཉིད་ བཞི་ ལྡན་ གྱི་ ཆོས་སྐུ་ དེ་ཉིད་མཚན་ དང་ དཔེ་བྱད་ ཀྱིས་ བརྒྱན་པ་ ལོངས་སྐུ །དེ་ གཉིས་ དབྱེ ར་ མེད་པ ར་ སེམས་ཅན་ གྱི་ དོན་ མཛད་པ་ སྤྲུལ་སྐུ་ ཡིན་པ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཟླ་ སྒྲོན་ ལ ས །སྐུ་ ནི་ ནམ་མཁ འི་ མཚན་ཉིད་ དེ །_།སངས་རྒྱས་ ཞིང་ ཡང་ དེ་ འདྲ་ སྟེ །_།སྟོབས་ དང་ རྣམ་ཐར་ བསམ་གཏན་ དང་ །_།དེ་དག་ ཐམས་ཅད་ མཚན་ཉིད་ གཅིག _།ཅེས་ སོ །དེས་ན་ ལྡོག་པ་ ཙམ་ ལ ས་ ཐ་དད་ མེད་ དོ །རྡོ_དུས་ གསུམ་ གྱི་ སངས་རྒྱས་ རྣམས་མཛད་པ་ མཛད་ ནས་ བུད་ཤིང་ ཟད་པ འི་ མེ་ བཞིན་མྱ་ངན་ ལ ས་ འདས་ ཏེ་འོག་མིན་ ཆོས་དབྱིངས་ ཀྱི་ ཕོ་བྲང་ ན་ བཞུགས་པ་ ཡིན །ཟེར་ ཡང༌ །འདི ར་ ནི །_ དུས་གསུམ་ གྱི་ སངས་རྒྱས་ ཐམས་ཅད་ སེམས་ཅན་ རྣམས་ ཀྱི་ ཁམས་ རྒྱུད་ ལ་ བཞུགས་པ་ ཡིན་ ཏེ །དང་པོ་ ཐུགས་བསྐྱེད་པ་ ནས་ དམ་པ འི་ ཆོས་ གནས་ ཀྱི་ བར་མཐའ་ཡས་པ འི་ སེམས་ཅན་ གྱི་ དོན་ བསྒྲུབས་ ནས་ད་ ཐུགས་ལས་ ཆུང་ངུ ར་ བཞུགས་པ་ མི་ སྲིད་པ འི་ ཕྱིར་ རོ །_།དེ་ལྟར་ ཡང་ གཏན་ ལ་ ཕབ་པ་ དང༌ །_ ཟླ་བ་ སྒྲོན་མེ་ ལ ས །མྱ་ངན་ ལ ས་ འདས་པ་ ལ་ མི་ གནས་པ་ཡང་དག་པ འི་ མཉམ་པ་ཉིད་ ལ་ གནས་པ །སེམས་ཅན་ ཐམས་ཅད་ ལ་ གཟིགས་པ འི་ ས་ ལ་ བཞུགས་པ་ སྟེ །ཞེས་པ ས །དུས་གསུམ་ གྱི་ དེ་བཞིན་ གཤེགས་པ་ ཐམས་ཅད་ མ་ཚང་བ་ མེད་པ་སེམས་ཅན་ རེ་རེ འི་ ཁམས་ རྒྱུད་ ལ་ བཞུགས་པ་ ནི་སེམས་ཅན་ དོན་ ལ ས་ མཛད་པ་ གཞན་ མེད་པ འི་ ཕྱིར་ རོ །_།ཚུལ་ ཇི་ལྟར་ བཞུགས་ ན །རྫོགས་ སངས་ སྐུ་ ནི་ འཕྲོ་ ཕྱིར་ དང་ །དེ་བཞིན་ཉིད་ དབྱེ ར་ མེད་ ཕྱིར་ དང༌ །_།རིགས་ ཡོད་ ཕྱིར་ ན་ ལུས་ཅན་ ཀུན །རྟག་ ཏུ་ སངས་རྒྱས་ སྙིང་པོ་ ཅན །སངས་རྒྱས་ ཡེ་ཤེས་ སེམས་ཅན་ ཚོགས་ ཞུགས་ ཕྱིར །_།རང་བཞིན་ དྲི་མེད་ དེ་ ནི་ གཉིས་ མེད་ དེ །སངས་རྒྱས་ རིགས་ ལ་ དེ་ འབྲས་ ཉེར་ བརྟགས་ ཕྱིར །_།འགྲོ་ ཀུན་ སངས་རྒྱས་ སྙིང་པོ་ ཅན་ དུ་ གསུངས །ཞེས་པ་ འདི་ ཆོས་ ཀྱི་ རྗེ་ སངས་རྒྱས་ ཐམས་ཅད་ སེམས་ཅན་ གྱི་ རྒྱུད་ ལ་ བཞུགས་པ་ ལ་ བཞེད་ ཅིང་རྟོག་གེ་བ་ རྣམས་ དང་ ནི་ མི་མཐུན་པ་ ཡིན་ ནོ །_།དེ་ཕྱིར་ སྒོ་གསུམ་ སྤྱོད་པ་ ངན་པ་ སྤང་བ ར་ བྱ་ སྟེ །མ་ སྤངས་ ན་ ཐུགས་ ཁྲེལ་བ ར་ འགྱུར་བ་ དང་ །སྤང་ ན་ དགྱེས་ ནས་ འཕྲིན་ལས་ ཀྱི་ འཇུག་ སྒོ་ ཡོད་པ ར་ འགྱུར་བ འི་ ཕྱིར་ རོ །_།འབྲས་བུ་ སངས་རྒྱས་པ འི་ གནད་དོན་ རྣམས་ བསྡུས་ སྟེ་ རྡོ་རྗེ་ ཚིག་རྐང་ བཅུ་དྲུག་ ལྷན་ཐབས་ ཚིག་རྐང་ གཅིག་ བཅས་ ཀྱི་ སྐབས་ ཏེ་ དེ་ལྟར་ ན་ ཚོམ་ བདུན་ ཡོངས་སུ་ རྫོགས་པ འི་ འགྲེལ་བཤད་ ལེགས་པ ར་ བྱེད་པ འོ །_།གཞུང་ གི་ མཇུག་ བསྡུ་བ་ ནི །ཇི་ལྟར་ འཇིག་རྟེན་ གྱི་ ཁམས་ འདི་ ན་ཕ་ ཡི་ བུ་ ཞིག་ ལ་ ལོངས་སྤྱོད་ ཕལ་པ འི་ འབྱོར་བ་གཞན་ ལ་ གྲགས་པ འི་ རྫས་ མང་པོ་ དང་ །ཟབ་ དགུ་ ཚོགས་ སུ་ བཤད་ ན་ ཡང་ །ཉམས་ སུ་ མ་ མྱོང་ སྨྲས་པ་ མེད་ ཅེས་པ་ ལྟར་ཚད་མ་ བཞི འི་ སྒོ་ ནས་ ངེས་ཤེས་ ཁྱད་པར་ཅན་ ལྡན་པ ར་ གྱུར་ ཀྱང་སུ ས་ དེ་ ཆུད་ གསོན་པ ར་ བྱེད་ ན་གཞན་ གྱིས་ སྨད་པ འི་ གནས་ སུ་ ཡིན་པ ར་ གྱུར་ ན །དེ་བ ས་ ཀྱང་ གཅེས་པ་ ཕ་ ཡི་ ཁྱད་ནོར་ གཞན་ ལ་ མེད་པ འི་ ནོར་བུ འི་ རིགས་ དག་སྔོན་ སུ ས་ ཀྱང་ མ་ ཐོས་པ་དེ་ རང་ཉིད་ ཀྱིས་ མི་ འཛིན་པ ར་ འདོད་ ན་དེ་ ནི་ སྨད་པ ར་ བྱེད་པ་ ལྟ་ཅི་ སྨྲོས །དཔེ ར་ བསྟན་པ་ དེ་བཞིན་ དུ་ མཚུངས་མེད་ཆོས་ ཀྱི་ རྒྱལ་པོ་ འཇིག་རྟེན་ གསུམ་ གྱི་ མགོན་པོ་ ཡིས་ འཁྲུངས་ ཏེ་དོན་ མཐའ་དག་ མངོན་དུ་ མཛད་པ འི་ ཁྱད་པར་ གྱི་ ཆོས་ འདི་དག་གངས་ཅན་ འདི ར་ སྔོན་ཆད་ མ་ གྲགས་པ་ ཞིག་ཕྱི་དུས་ འཇིག་རྟེན་ མགོན་པོ ས་ འདི་ལྟར་ གསལ་བ ར་ མཛད་པ་རྗེས་ འབྲངས་ སྲས་ ཀྱིས་ མི་ འཛིན་པ་ ནི་དེ་ དང་ ཚུལ་ མཚུངས་པ་ ཡིན་ ནོ །_།རྒྱུ་མཚན་ དེ འི་ ཕྱིར་ རིགས་པ་ དང་ ལྡན་པ་ཕ་ ཡི་ གདུངས་ འཚོབ་པ ར་ འདོད་ ན་རྗེའི་ ཞལ་ ནས་ སུ འི་ ཆོས་ ལ་ ཡང་ མི་ སྨོད །གང་ ལ་ ཡང་ མ་སྨད་པ ས་ ཆོས་ ལ་ བརྟེན་པ འི་ གཡང་ས་ མེད །སུ འི་ ཆོས་ ཀྱི་ རྗེས་སུ་ མི་ འབྲང་གང་ གི་ རྗེས་སུ་ མ་ འབྲངས་པ ས་ལོག་པ ར་ ཞུགས་པ འི་ ཉེས་པ་ མི་ འབྱུང་ ཞེས་ གསུངས་པ་ ལྟར །རིགས་ འཆོལ་བ ས་ གཞན་ གྱི་ གྲུབ་མཐའ་ དང་ གང་ཟག་ ལ་ སྨོད་པ ར་ མི་ བྱེད་པ་ཁམས་ གསུམ་ ཆོས་ ཀྱི་ རྒྱལ་པོ་ ཆོས་རྗེ་ རིན་པོ་ཆེ་སྲིད་པ་ གསུམ་ ན་ གྲགས་པ་ དང་ ལྡན་པ་དེ་ ཡི་ བཞེད་པ འི་ ཐུགས་དགོངས་ དུས་གསུམ་ སངས་རྒྱས་ ཀྱི་ བསྟན་པ་ མཐའ་དག་ གི་ སྙིང་པོ ར་ གྱུར་པ འི་ ཁྱད་ཆོས་ རྣམས །མདོ་ ལ ས །མེ་ ཚོགས་ སྤུ་གྲི འི་ སོ་ ཡང་ བརྒལ་ ནས་ ནི །_།ཕྱི་མཐ ར་ ཐུག་ གི་ བར་ དུ་ བཟུང་བ ར་ བགྱི །ཞེས་པ་ ལྟར་ ནན་ཏན་ ཆེན་པོ འི་ སྒོ་ ནས་ འཛིན་པ་ ཞིག་ བྱུང་ ན་ངོ་མཚར་ ཤིན་ཏུ་ ཆེ་བ་ ཡིན་ ནོ །_།བསྟན་པ་ གང་ གིས་ འཛིན་པ འི་ ཆོས་མཛད་སྐྱེས་བུ་ དམ་པ་ རྣམས་ ནི་ འབངས་ ཕལ་པ འི་ བུ་ སྟོང་ གི་ ནང་ དུ་ འཁོར་ལོ ས་ བསྒྱུར་ རྒྱལ་ གྱི་ རིགས་རུས་ ལ ས་ འཁྲུངས་པ འི་ མཚན་ལྡན་ གྱི་ སྲས་ དེ་ ནི་ཡོན་ཏན་ དུ་མ འི་ སྒོ་ ནས་ ཁྱད་པར་ འཕགས་པ་ བཞིན་ དུ་བསྟན་པ འི་ སྒོར་ ཞུགས་ཀུན་ གྱི་ ནང་ ན་ ཡོན་ཏན་ དུ་མ ས་ མཛེས་ ཤིང་ལྷག་པ་ ཡིན་ ནོ །དེ འང་ གང་ གིས་ ལྷག་པ་ ཡིན་ སྙམ་ ན །ཐུན་མོང་ མ་ཡིན་པ་ གཞི་ བདེ་བ ར་ གཤེགས་པ་ དམ་པ འི་ སྙིང་པོ་ དང་དེ་ མངོན་དུ་ བྱེད་པ འི་ ཐབས་ལམ་ གྱི་ རིམ་པ་ རབ་འབྱམས་ ཐུབ་པ འི་ བཀའ་ མཐའ་དག་ གམ །ཡང་ན་ གཉིས་ ཆོས་ ཐམས་ཅད་ ལ ས་ འདས་པ འི་ སྟོང་ཉིད་ ཕྱག་རྒྱ་ ཆེན་པོ་ དང་ །དེ་ རྒྱུ་འབྲས་ སུ་ འབྱུང་བ་འཁོར་འདས་ ཀྱི་ རྟེན་འབྲེལ་ ཀུན་ ལ་མ་ རྨོངས་པ ས་དེ་ཕྱིར་ ཕྱི་རོལ་ རྒོལ་བ་ ངན་པ འི་ ཝ་ ཚོགས་ ཀྱིས །_།གངས་ཅན་ སེང་གེ་ ལྟ་བུ ར་ ཉམས་ ང་ །བག་ཚ་ བ་སྤུ་ ཙམ་ ཡང་ མེད་ དོ །རིགས་ དང་ དབང་པོ་ དང་ མཐུན་པ ར་ རྗེས་ འབྲང་ ཀྱི་ འཁོར་ དང་རིགས་ཅན་ སྣ་ཚོགས་པ འི་ གདུལ་བྱ་ སོ་སོ་ ལ་མ་ འདྲེས་པ འི་ ཆོས་_ ཀྱི་ ཁྱད་པར་ ལེགས་པ ར་ བསྟན་པ་དམན་པ་ ཉན་རང་ དང་ བྱང་ཆུབ་ མཆོག་ གི་ ལམ་ ལ་མོ ས་པ་ ཇི་ལྟ་བ འི་ བྱེ་བྲག་ གི་ རིམ་པ་ ཕྱེས་ ཏེ་བསྟན་པ ས་ བྱང༌ཆུབ་ གསུམ་ ལ་ འགོད་པ ར་ བྱེད་ ཅིང་སྙན་པ་ དང་ གྲགས་པ འི་ སྒྲ་ ཆེན་ འབྲུག་སྒྲ་ བཞིན་ དུ་ ཕྱོགས་ བཅུར་ སྒྲོགས་པ ར་ བྱེད་ དོ །_།དེ་ལྟར་ བརྗོད་བྱ་ ཆོས་ཐུན་ མཉམ་པ་ཉིད་སྦྲང་རྩི་ རོ་ གཅིག་པ་ ལྟར་ ཟབ་ ཅིང་རྗོད་ བྱེད་ མདོ་ རྒྱུད་ དང་ བསྟན་བཅོས་ རྒྱ་ ཆེ་ བླ་ ན་ མེད་པ འི །དགོངས་པ་ རྒྱ་མཚོ་ ཆེ་ ལྟར་ཤིན་ཏུ་ ཡངས་པ ར་ གྱུར་པ་ ལ ས །སྐྲ འི་ རྩེ་མོ་ བླངས་པ འི་ ཆུ་ ཐིག་ ཙམ་ ཞིག་ སྨྲས་པ་འདི་ ནི་ བསོད་སྙོམས་ ཀྱི་ འཚོ་བ འི་ བན་དེ་ ལྡོམ་བུ་པ་ ཤེས་རབ་ འབྱུང་གནས་ བདག་ གིས་ བྲིས་ ཞེས་ སོ །_།འཁོར་གསུམ་ གང་ དུ་ གང་ཞིག་ཇི་ལྟར་ བསྔོ་བ འི་ ཆོས་ མི་ དམིགས་རྣམ་པ ར་ དག་པ་གངས་ ཀྱི་ རི་ ལྟར་ དཀར་བ འི་ དགེ་བ་ འདི ས །_།རིན་ཆེན་ རྒྱལ་བ འི་ བསྟན་པ་ ཕྱོགས་ བཅུ་ མུ་མེད་པ་ཕྱི་མ འི་ མཐ འི་ བར་ དུ་ རྒྱས་པ་ དང༌ །དེ འི་ མཐུ ས་ འཇིག་རྟེན་ འཁོར་བ འི་ རྩ་བ་མི་ ཤེས་པ འི་ གཏི་མུག་གློ་བུར་པ འི་ དྲི་མ་ དང་ རྣམ་པ ར་ བྲལ་ ཞིང༌ །མཐ ར་ ཕྱིན་པ འི་ སངས་རྒྱས་ སྐུ་གསུམ་ དང་ཡེ་ཤེས་ ལྔ འི་ བདག་ཉིད་ མྱུར་ དུ་ ཐོབ་པ ར་ ཤོག་ ཅིག་ ཅེས་པ འོ །_།ཞེས་པ་ བཤེར་ འབྱུང་ གིས་ མཛད་པ འི་ གཞུང་ རྩ་བ་ དེ་ཉིད་འབྲི་གུང་ གདན་ རབ་ རྗེ་བཙུན་ དཀོན་མཆོག་ རིན་ཆེན་ ཕྲིན་ལས་ རྣམ་རྒྱལ་ དཔལ་ འཟང་པོ ས་ཚིག་ བཅད་ དུ་ ལྡེབས་པ་ ལ ས་སླར་ ལྷན་ཐབས་ བཅས་ དཀྱུས་ སུ་ བསྒྲིགས་ ནས་མཆན་ གྱིས་ བཀྲལ་བ་སྔོན་བྱོན་ སྐྱེས་ཆེན་ དམ་པ་ བཅུ་ཕྲག་ རིགས་པ འི་ གནས་ ལ་ མཁས་པ་ ཤཱཀྱའི་ དགེ་སློང་ དཔལ་འབྱོར་ རིན་པོ་ཆེ ས་ མཆན་ ཐོར་བུ ར་ སྡེབས་པ་ ལ་ གཞི་ བྱས་ ཏེ་སྙིགས་དུས་ ཀྱི་ ལྡོམ་བུ་བ་ འབྲི་ སྤྲུལ་ རྟོགས་ལྡན་ དཀོན་མཆོག་ ཐུབ་བསྟན་ བསྟན་པ འི་ རྒྱལ་མཚན་ གྱིས་མང་ཡུལ་ ལ་དྭགས་ སྒང་ སྔོན་ བཀྲཤིས་ ཆོས་རྫོང་ དུ་འབྱུང་བ་ བཞི་ ལྡན་ས་མོ་ བྱ་ལོ འི་ དུས་འཁོར་ གྱི་ གསོ་དཔྱད་ རྒྱ་རྩིས་ ཀྱི་ སྟོན་ ར །སྐར་རྩིས་ རྒྱ་གར་ གྱི་ དབྱར་ ཐ་ གྲོ་ཞིན་ཟླ་བ་ མར་ངོ འི་ ཚེས་_ ༡༣_ ལ་ བྲིས་པ་ དགེ་ལེགས་ འཕེལ །།