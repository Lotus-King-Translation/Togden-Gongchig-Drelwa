msgstr "Because they manipulate what is not actuality as actuality."

msgctxt "1ab304e5fb584323a2afa291963d7ef8"
msgid ""
"དེ་བས་ན་ གདོད་མ་ ནས་ ཕུང་ ཁམས་ སྐྱེ་མཆེད་ ཐམསཅད་ དཀྱིལ་འཁོར་ གྱི་ "
"འཁོར་ལོ་␣ར་ གནས་པ་ ཡིན་ ཏེ །"
msgstr ""
"Therefore, from the beginning, all the aggregates, elements, and sense "
"fields are present in the wheel of the mandala."

msgctxt "05ac0a68fbd94133a783c7e4e3f6bc16"
msgid "ཀྱེ་རྡོར་ ལ་␣ས །"
msgstr "According to the Hevajra [Tantra]:"

msgctxt "f10a19c9a3e84b26bed0a895ccc35877"
msgid "འདི་དག་ དབང་ གིས་ སེམས་ཅན་ རྣམས ། །"
msgstr "By the power of these, the sentient beings,"

msgctxt "9fd3e9653b284021ad3665fe522ae767"
msgid "སངས་རྒྱས་ ཉིད་ དུ་ ཐེ་ཚོམ་ མེད ། །"
msgstr "There is no doubt that [they] are buddhas."

msgctxt "c67ce9310bcd461c941333b0560c3700"
msgid "ཟླ་བ་ བཅུ་ ཡང་ ས་ རྣམས་ སྲིང་ ། །"
msgstr "Ten months are also extended to the levels."

msgctxt "522e153d1e514ecc831cfdeac235c755"
msgid "སེམས་ཅན་ ས་བཅུ་␣འི་ དབང་ཕྱུག་ གི  ༑"
msgstr "The sentient beings are the lords of the ten levels."

msgctxt "b03edd815a6543e7afbe3fd7d82f429c"
msgid "གསང་འདུས་ ལ་␣ས །"
msgstr "According to The Gathered Secret:"

msgctxt "c0e28c4ce4b34366805f85b68be66185"
msgid "མདོར་ན་ ཕུང་པོ་ ལྔ་ རྣམས་ ནི །"
msgstr "In brief, the five aggregates are"

msgctxt "2f05d8cbda624d97b91df34095dd8c77"
msgid "སངས་རྒྱས་ ལྔ་␣ར་ ནི་ རྣམ་པ་␣ར་ གྲགས ། །"
msgstr "Known as the five Buddha types."

msgctxt "0145e3227f24432bb67bb79018073f54"
msgid "ཞེས་ དང་ ཀུན་སྤྱོད་ ལ་␣ས ། །"
msgstr "And according to the Conduct:"

msgctxt "37e5da644cb842cf94a7eed2ea89c062"
msgid "འགྲོ་བ་ འདི་དག་ སངས་རྒྱས་ ལྔ་␣འི་ བདག་ཉིད །"
msgstr "These migrators are the nature of the five buddhas."

msgctxt "4a851532732549ce87b29a7f10bc2fc1"
msgid "ཅེས་ དང༌ །"
msgstr "And"

msgctxt "2f82a7f9776c40a28d38b26bdc99c0ce"
msgid "གསང་བ་ རྒྱ་མཚོ་ ལ་␣ས །"
msgstr "According to The Ocean of Secrets:"

msgctxt "b736d92691e74af4b56b6fcff0be23c4"
msgid "ཤེས་བྱ་␣འི་ དཀྱིལ་འཁོར་ མ་ ལུས་ འདི་དག་ ཐམས་ཅད་ ནི །"
msgstr "All of these mandalas of knowable without exception are"

msgctxt "ce1d7d4cf9eb46beb2117f92da79888a"
msgid "སྐུ་གསུམ་ ཡོངས་སུ་ གྲུབ་པ་ གསང་སྔགས་ ཐེག་པ་ སྟེ །"
msgstr ""
"The secret mantra vehicle is the complete accomplishment of the three "
"bodies."

msgctxt "b015d64911c24b58a3e54443371519b6"
msgid "སྐུ་གསུམ་ ཞིང་ ལ་ འཇུག་པ་ ལམ་ གྱི་ ཐེག་པ་ ཡིན །"
msgstr "The vehicle of the path is to enter the realm of the three bodies."

msgctxt "3a852e92efd14e298a707fd8392b1370"
msgid "སྐུ་གསུམ་ འདུ་ འཕྲལ་ མེད་པ་ རྡོ་རྗེ་␣འི་ ཐེག་པ་␣འོ ། །"
msgstr "The three bodies without meeting or parting is the vajra vehicle."

msgctxt "28c285c3510c4ded8f655deadcb8a18e"
msgid "ཞེས་ སོ ། །"
msgstr "And"

msgctxt "01a1c5c3de1c4fdfa634293e2484db61"
msgid "ལྷན་␣༽༽  དང་པོ་ ནས་"
msgstr "Addendum: From the beginning,"

msgctxt "395d88abcc984500a24fab7e0e07ebb8"
msgid "ལྷ་ ལ་ འཇུག་ མི་ ནུས་"
msgstr "One cannot engage with the deity,"

msgctxt "81630afa2a1b4403845436e23bc23045"
msgid "སྦྱང་ སྤེལ་ སྒྱུ་མ་␣ར་ བསླབ་པ་ སོགས་ ཀྱིས་ སྒོམ་ དགོས །"
msgstr ""
"One must meditate by training in purification, alternation, illusion, and so"
" forth."

msgctxt "ca17b5f1d8094b08b66c48b9243e7abc"
msgid "དེ་␣འང་ དང་པོ་"
msgstr "Also, in the first"

msgctxt "b9a8a2309eab4fe99df99ddff5587a4a"
msgid "སྣོད་ གཞལ་ཡས་ བཅུད་ ལྷ་ དང་ ལྷ་མོ་␣ར་ མོས་པ་␣ས་ སྦྱོང༌ །"
msgstr ""
"Purify with adherence to the vessel as the immeasurable celestial mansion "
"and the inhabitants as the deities and goddesses."

msgctxt "37b1c61dacd64ce8a4f57af549772b48"
msgid "བར་ དུ་ དེ་ གཉིས་ སྤེལ་མ་␣ར་ བསླབ །"
msgstr "In the middle, train in alternating those two."

msgctxt "3455e4ea0861461e9d7159dfea8ae3f6"
msgid "མཐ་␣ར་ སྒྱུ་མ་ ཙམ་ ལ་ བསླབས་ ཏེ་"
msgstr "Finally, train in mere illusion."

msgctxt "9ecc9df2829245f59ac91ff0a8bb373d"
msgid "གཟོད་ རང་ ལུས་ ལྷ་␣ར་ བསྒོམས་པ་␣ས་ གསལ་བ་␣ར་ འོང་ ཟེར་␣༑"
msgstr ""
"Then, it is said that by meditating on one’s own body as the deity, it will "
"become clear."

msgctxt "f756b813e8d842e397944506fec2e736"
msgid "འདི་␣ར་ ནི་ བསྐྱེད་རིམ་ ཡོངས་གྲུབ་ ཡིན་པ་␣འི་ ཕྱིར་"
msgstr "In this [system], the generation stage is thoroughly-established."

msgctxt "9098c494f28e409e80f5a33124ddff2f"
msgid "རང་ ལུས་ ལྷ་ དང་ དབྱེ་␣ར་ མེད་པ་ ལ་ ཅིག་ ཆ་␣ར་ དུ་ འཇུག་པ་ ནི་"
msgstr ""
"The simultaneous entry of one’s own body inseparable from the deity is"

msgctxt "7daddd36b28f4088aec491e596bdbfbc"
msgid "ཟབ་མོ་␣འི་ གནད་ ཡིན་ ཏེ །"
msgstr "the profound essential point."

msgctxt "ca6d760c8c9446689cf5e31783cd38e5"
msgid "ལུས་ངག་ ཡིད་ གསུམ་ ཐ་མལ་ དུ་ སྐད་ཅིག་ ཙམ་ ཡང་ མི་ འཆོར་བ་"
msgstr ""
"Not losing body, speech, and mind to ordinary states even for an instant is"

msgctxt "2506359002f6415da22fcfc1bc6d16e1"
msgid "རིག་པ་ འཛིན་པ་␣འི་ སྡོམ་པ་ ཡིན་པ་␣འི་ ཕྱིར་ རོ །"
msgstr " the vow of a knowledge-holder."

msgctxt "5094c4980c25430eaa30572b3904b1e0"
msgid "ལྷན་␣༽༽  ལྷ་ འགྲུབ་པ་␣ར་ བྱེད་པ་ ལ་"
msgstr "Addendum: To accomplish the deity,"

msgctxt "7834e05042e943f18b5f6a3cfeb69c74"
msgid "སཾ་ བྷུ་ ཊི་ ལ་␣ས །"
msgstr "According to the Samputa:"

msgctxt "7cae6f181b8046ce8fe09dd99bd16f11"
msgid "འཁོར་ལོ་␣འི་ བདག་པོ་ འབུམ་ བཟླས་ ཤིང་ །"
msgstr "One hundred thousand recitations of the lord of the wheel."

msgctxt "9b54cb0bb6284574b619d30357344061"
msgid "དཀྱིལ་འཁོར་ ཅན་ གྱིས་ དེ་བཞིན་ ཁྲི །"
msgstr "Those with mandalas, likewise thousands."

msgctxt "8a2c2d801e224abdb4c80bf15c196528"
msgid "ཞེས་པ་ ལྟར་ བསྙེན་པ་ གཙོ་ ཆེ་ ཟེར །"
msgstr "Thus, it is said that recitation is the most important."

msgctxt "441411882f8d4dd9ac2fe122247c82d2"
msgid "འདི་␣ར་ ནི་ དེ་␣འང་ བསྐྱེད་རིམ་ ཡོངས་གྲུབ་ གཞིར་བཅས་ ཏེ་"
msgstr ""
"In this [system], The generation stage is the basis for the thorough-"
"establishment."

msgctxt "689236f97a374c38ae2ea62bb13c0533"
msgid ""
"རྟེན་འབྲེལ་ གྱི་ ཚོགས་པ་ ཚང་བ་ ལ་␣ས་ འགྲུབ་པ་ ངེས་པར་ ཤེས་པ་␣ར་ བྱེད་ དགོས་ "
"ཏེ །"
msgstr ""
"By the complete assembly of interdependence, then one must understand the "
"accomplishment."

msgctxt "93f1976eeda446059b0f4aa9f57e56d8"
msgid "དེ་␣འང་ ནང་ རྟེན་འབྲེལ་ གཞི་ སྟོང་ཉིད །"
msgstr ""
"Further, the inner dependent relationship is the emptiness of the ground,"

msgctxt "43e936b9f812475e8fc94b0ad5b951cf"
msgid "གདན་ ཟླ་བ །  གསུང་ ཡིག་འབྲུ །  ཐུགས་ ཕྱག་མཚན །"
msgstr ""
"The seat is the moon, the speech is the syllables, the mind is the sceptre, "
"and "

msgctxt "a5de4e6eadf54e2c904ff5e8bb38a717"
msgid "སྐུ་ ཡོངས་རྫོགས་ ཏེ་ མངོན་བྱང་ ལྔ །"
msgstr ""
"the body is complete. These are the five manifest enlightenment generations."

msgctxt "adedeb3683644ce19d67dde8afe726f1"
msgid "ཕུང་ ལྔ་ རང་ཆས་ སུ་ ཡོད་པ་ རྒྱུ །"
msgstr "The inherent presence of the five aggregates is the cause."

msgctxt "dd55f84d4ed148678133527b52b8d354"
msgid ""
"རྐྱེན་ བླ་མ་␣ས་ བུམ་ དབང་ གིས་ ངོ་ སྤྲད་པ་␣འི་ རྟེན་འབྲེལ་ ཚོགས་པ་␣འི་ དབང་ "
"གིས་ ཡོངས་སུ་ གྲུབ་པ་␣ར་ ཤེས་པ་"
msgstr ""
"The condition is through the power of the assemblage of the dependent "
"relationship with the guru's introduction of the vase empowerment and being "
"aware of the thorough-establishment."

msgctxt "00bf2a63e24a426aae0b8da0a82cee30"
msgid "ཕྱི་ ནང་ གི་ རྟེན་འབྲེལ་ ཡིན་ ནོ ། །"
msgstr "That is the outer and inner dependent relationships."

msgctxt "6fb481bb220244ac84d94c1b19290684"
msgid "བསྙེན་པ་␣འི་ གྲངས་ དེ་␣འང་ འདི་␣འི་ ཕྱོགས་ ཙམ་ མོ །"
msgstr "The number of recitations is just a portion of this."

msgctxt "7f204345ecc44b32998886ebeef6218b"
msgid "ལྷན་␣༽༽  དཀའ་བ་ མ་ སྤྱད་ ན་ སངས་ མི་ རྒྱ་"
msgstr "Addendum: One will not become a buddha without engaging in austerity"

msgctxt "d756174efe144a0b822e2800c522b413"
msgid "དཀའ་ཐུབ་ ཆུ་ འཐུང་ རྡོ་ ལྟར་ དགོས །"
msgstr "Austerity must be like drinking water or stone."

msgctxt "23c87e535af54120913134f28b3e46db"
msgid "འདོད་ཡོན་ བརྟེན་ ན་ ལུས་ དྲེགས་ ནས་ ཉོན་མོངས་ སྐྱེ་བ་␣ས་"
msgstr ""
"If one depends on sense pleasures, the body will become haughty and "
"afflictions arise."

msgctxt "aa08eeb155c749ea92d272af6ada0411"
msgid "ལུས་ རྒུད་ ན་ མི་ ཡོང །"
msgstr "If the body degenerates, this will not occur."

msgctxt "0c46ea126e1c4eef8ff30e83af22c5de"
msgid ""
"ཡང་ ཉོན་མོངས་ སྐྱེས་ དུས་ རང་ གིས་ རང་ དམའ་ འབབ་ སུན་ འབྱིན་ དགོས་ ཟེར་ རོ "
"། །"
msgstr ""
"Again, it is said that when afflictions arise, one must refute oneself by "
"belittling oneself."

msgctxt "c1322085934f4372b18e568efd8c5245"
msgid "འདི་␣ར་ ནི་ ཐ་མལ་པ་␣འི་ ལུས་ སུ་ བཏགས་པ་␣འི་ ཕྱིར་"
msgstr "In this [system], because it is designated as an ordinary body,"

msgctxt "5d9ea987883f4b9891dd52c9b6a3d8d6"
msgid "དཀའ་ཐུབ་ སྤྱོད་པ་ ནི་ དེ་ལྟར་ སྨད་པ་ ཡིན་ ཏེ་"
msgstr "The conduct of asceticism is disparaged in this way,"

msgctxt "f847b78892d04508aaf13b7696800062"
msgid "བསྐྱེད་པ་␣འི་ རིམ་པ་ ཡོངས་གྲུབ་ ཡིན་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "Because the stages of generation is the thorough-establishment and"

msgctxt "8fc488d5edc7487c887a7a12b32774c6"
msgid "ནང་པ་ སངས་རྒྱས་པ་ ནང་སེམས་ འདུལ་བ་ གཙོ་ ཆེ་བ་␣འི་ ཕྱིར་ དང་ །"
msgstr "Buddhists place the most important emphasis on taming the mind."

msgctxt "a98dc8726b444925804f0fe1844e3724"
msgid "རྩ་ལྟུང་ གཏོང་བ་␣འི་ ཕྱིར །"
msgstr "Because it will pass the root downfalls."

msgctxt "a6ed2169330b460a81faa2c65a76875b"
msgid "རང་ གི་ སེམས་ ནི་ ཡོངས་སུ་ འདུལ །"
msgstr "Completely tame one's own mind."

msgctxt "a44cdd32c31d4970a226d6879330ae22"
msgid "ཅེས་ དང་ །"
msgstr "And"

msgctxt "7caf3ba92b1e4c919eed34372d48882a"
msgid "ཞི་ ལྷས །"
msgstr "Shantideva says:"

msgctxt "567ba9c0f5ee4510b525726fe1354657"
msgid "སེམས་ བསྲུང་ བརྟུལ་ཞུགས་ མ་གཏོགས་པ་␣འི ། །"
msgstr "Except for the discipline of guarding the mind,"

msgctxt "691f0be813b0468b9c08dbb7b3b7b51e"
msgid "བརྟུལ་ཞུགས་ མང་པོ་␣ས་ ཅི་ཞིག་ བྱ །"
msgstr "What to do with many disciplines?"

msgctxt "c1d29e87610145d8aebbf0b6f5b65f91"
msgid "ཞེས་ དང༌ །"
msgstr "And"

msgctxt "7b026e32171c42c29577e8ef9386fa5e"
msgid "ཕུང་པོ་ སངས་རྒྱས་ ལྔ་␣འི་ བདག་ཉིད །"
msgstr "The aggregates are the nature of the five buddhas."

msgctxt "c7099dc0a1f349ff8d6a95b89f66c573"
msgid "ཅེས་ སོ ། །"
msgstr "As said."

msgctxt "d54b55ee7f6c421896fbae0d66324417"
msgid "དེས་ན་ སེམས་ བརྟུལ་ ན་  ལུས་ངག་ ཀྱང་ འདུལ་བ་␣ར་ འགྱུར་ རོ །"
msgstr "Therefore, taming the mind also tames the body and speech."

msgctxt "ff2003a2eca24dfdb94d586263c9de67"
msgid "རྡོ་␣༽༽  སྔོན་ གྱི་ ལས་འཕྲོ་ སད་པ་␣འི་ སྦྱངས་ སྟོབས་ ཅན་"
msgstr ""
"Vajra: Some said that those with the power of training activate the previous"
" uncompleted karma"

msgctxt "b58841ce879848819d346b1e4b652e6e"
msgid "ཤེས་ གཉེན་ དང་ གདམས་ངག་ ལ་མ་ བརྟེན་ ཡང་ ཏིང་འཛིན་ སྐྱེ་བ་ ཡོད་པ་␣ས་"
msgstr ""
"Even without relying on a spiritual friend or oral instruction, "
"concentration can be produced."

msgctxt "6a40ca8fdca64ade9f0b37dd396c7698"
msgid "འཇུག་ ཆོག་ མི་ དགོས་ ཟེར་བ་ ནི་ ཁ་ཅིག་ གོ  །"
msgstr "It is said that the liturgical procedure to engage is not required."

msgctxt "4d1e9af574ed4e28959dd02a76948fd1"
msgid "འདི་␣ར་ ནི་ དེ་ལྟར་ རང་བྱུང་ གི་ ཏིང་འཛིན་ སྐྱེ་བ་"
msgstr ""
"In this [system], for those who have generated the self-arisen concentration"
" in that way,"

msgctxt "e153a3724bf94ea69fa15a64ab72130a"
msgid ""
"དེ་ རྣམས་ ལ་␣འང་ སྐྱབས་འགྲོ་ ནས་ དབང་ གི་ བར་ གྱི་ འཇུག་པ་␣འི་ ཆོ་ག་ ཇི་ལྟར་"
" བཤད་པ་ བཞིན་ དགོས་པ་ ཡིན་ ཏེ །"
msgstr ""
"The liturgical procedures are required in accordance with the explanations "
"from taking refuge to empowerment."

msgctxt "b6ccb69343e3476693ea3e1a6de4d83a"
msgid "ཡིན་ མིན་ གྱི་ སྒྲོ་ འདོག་ ཆོད་ དེ་"
msgstr "By eradicating the exaggeration of what is and what is not,"

msgctxt "32093a1c705e4ebb8b80e322e8c017e9"
msgid "སྤྲོ་ ན་ ལྷག་ ཡར་ ཡང་ རྒྱས་པ་␣ར་ འགྱུར་བ་␣འི་ ཕྱིར །"
msgstr "When elaborated, it becomes more extensive than before."

msgctxt "f7c73a7ef85544e89528737ea14aa794"
msgid "མེ་ འབར་བ་ ལ་ ཤིང་ བསྣན་པ་ བཞིན་ ནོ་␣༑"
msgstr "Like adding wood to a blazing fire."

msgctxt "8f6d4a24203b4c16b94e5a60edd39563"
msgid "༑་␣དེ་ལྟར་ ན་ ནང་པ་␣འི་ ཕྱག་རྒྱ་␣ས་ ཐེབས་པ་␣འི་ སླད་ དུ་"
msgstr ""
"Thus, for the sake of being placed by the Buddhist mudra, is taking refuge."

msgctxt "37c67cba927c473bab39e50fcd3cd645"
msgid "སྐྱབས་འགྲོ་ འཁོར་བ་ ལ་ ངེས་པར་ འབྱུང་བ་␣འི་ སོ་ཐར །"
msgstr "Definite emergence from samsara is individual emancipation."

msgctxt "8a3204b5aaac4aaf8bf00f2b63f73a95"
msgid "ཉན་རང་ དུ་ མི་ གོལ་བ་ སེམས་བསྐྱེད །"
msgstr ""
"To not go astray in the shravakas and pratyekabuddhas is the generation of "
"the mind [for enlightenment]."

msgctxt "9248b311ffe147a0b984ae12eec62770"
msgid "སྒོ་གསུམ་ ཐ་མལ་ དུ་ཞིག་པ་␣ར་ ལྡོག་པ་ སྔགས་ ཀྱི་ དབང་ བསྐུར་ ནས་"
msgstr ""
"To reverse the three doors from their destruction into the ordinary, by "
"bestowing the empowerment of mantra"

msgctxt "c8a8947ee3224daa85fa41e0f4ac1c61"
msgid ""
"བསྐྱེད་རྫོགས་ ཀྱི་ ཏིང་འཛིན་ དང་ དབྱེ་␣ར་ མེད་ བདེ་ཆེན་ གྱི་ དོན་ ངོ་ "
"སྤྲད་པ་␣ས་"
msgstr ""
"Introduced to the meaning of great bliss, which is inseparable from the "
"concentration of the generation and completion stages, "

msgctxt "7cf220619f7346a5bc8cb6d4457ea4d1"
msgid "མཆོག་ ཐུན་ གྱི་ དངོས་གྲུབ་ ཐོབ་པ་␣ར་ འགྱུར་ རོ ། །"
msgstr "The actual supreme and ordinary accomplishment will be attained. "

msgctxt "93cbd1afb1f84ce9a94b0cb9cd945fc1"
msgid "དེས་ན་ མི་ལུས་ ཐོབ་པ་ སྔོན་ ཚུལ་ཁྲིམས་ བསྲུང་བ་␣ས་ ཡིན་ ཀྱང་"
msgstr ""
"Thus, even though the human body is attained by protecting moral discipline."
" "

msgctxt "3b7f6cc2da0e47a19b8243967196e285"
msgid "རྟེན་ དེ་␣ར་ དགེ་བ་␣འི་ འཕྲོ་ མཐུད་ ནས་ མ་ སྒྲུབ་ ན་"
msgstr ""
"If one does not continue to accomplish the radiance of virtue on that basis,"

msgctxt "9e6f29a4ba61487a92f794e01a843cbf"
msgid "ངན་འགྲོ་␣ར་ ལྟུང་བ་ བཞིན་ ནོ །"
msgstr "It is like one will fall into the lower realms of bad migrations."

msgctxt "1b133a4ff4a540bb90ea06144bce58ff"
msgid ""
"རྡོ་␣༽༽  སྔགས་ ཀྱི་ ལྷ་ ནི་ གདུལ་བྱ་ དང་ མཐུན་པ་␣ར་ འདོད་ཆགས་ ཅན་ ལ་ ཞལ་ "
"སྦྱོར །"
msgstr ""
"Vajra: It is said that the deities of mantra are concordant with the "
"disciples, being union for the desirous."

msgctxt "f73f49902c34471f858e9b70555aa465"
msgid "ཞེ་སྡང་ ཅན་ ལ་ ཁྲོ་བོ །"
msgstr "Being wrathful for those with aversion,"

msgctxt "dc416aadf90d4186a522edfe7751b44f"
msgid "གཏི་མུག་ ཅན༌་␣ལ་ དུད་འགྲོ་␣འི་ མགོ་བརྙན་ ལྟ་བུ་ སོགས་"
msgstr "Various heads of animals for the ignorant and so forth."

msgctxt "99a0a0fb72554f658a02d793304b86e6"
msgid "མཚན་དཔེ་ མེད་པ་␣ར་ ཡང་ བྱོན་ ཟེར་ རོ ། །"
msgstr "Arrive without the major and minor marks."

msgctxt "deee7c21ffc441349272894f5b6f7c34"
msgid ""
"འདི་␣ར་ ནི་ ལྷ་ རྣམས་ ཐམས་ཅད་ རང་བཞིན་ གྱིས་ མཚན་དཔེ་␣འི་ ཡོན་ཏན་ ལྡན་ ཞིང་"
msgstr ""
"In this [system], all the deities naturally have the qualities of the major "
"and minor marks,"

msgctxt "d6aeeaf764d14877acd6d2df400e2e96"
msgid "དེ་ལྟར་ བསྒོམ་ ཡང་ དགོས་ ཏེ་"
msgstr "and even one needs to cultivate in this way,"

msgctxt "dad30aeff8f94bf18d9eaabcaa0d94af"
msgid "སྐྱོན་ སྤང་ ཡོན་ཏན་ རྫོགས་པ་␣འི་ སངས་རྒྱས་ ཡིན་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"Because they are buddhas who have abandoned faults and perfected qualities."

msgctxt "35c0f5d3e7d44290bca5eaeeb779ca5c"
msgid "མཚན་ བཟང་ དང་ ལྡན་པ་␣ར་ བསྒོམ་ ན་ ཚོགས་ རྫོགས་ ཤིང༌ །"
msgstr ""
"If one meditates on those having the auspicious marks, the accumulations are"
" completed,"

msgctxt "5139c1d4d0634ff68bad8098c031d045"
msgid "མི་ ལྡན་ ན་ ཉེས་པ་ འབྱུང་བ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "But if one does not have them, faults arise."

msgctxt "f7979ca1d0154cd587fb7ec65e62064a"
msgid "དེ་ལྟར་ ཡང་ དུས་འཁོར་ ལ་␣ས །"
msgstr "Likewise, according to the Kalachakra [Tantra]:"

msgctxt "153c43467d6e48cf80d67323f43dd336"
msgid "རབ་མཆོག་ རྒྱལ་བ་␣འི་ བདག་པོ་ ཡི ། །"
msgstr "The supreme lord of conquerors."

msgctxt "3454326fe8874a22a820d53a8048af6c"
msgid "མཚན་ ནི་ སུམ་ཅུ་རྩ་གཉིས་ དང༌ ། །"
msgstr "The thirty-two major marks and"

msgctxt "92b60961cbee4728bbbfbdd95792f80a"
msgid "དཔེ་བྱད་ བཟང་པོ་ བརྒྱད་ཅུ་ སྟེ ། །"
msgstr "The eighty excellent minor marks."

msgctxt "829e708df69b420fa20804cc86830915"
msgid "འདི་དག་ མ་ ལུས་ འདུས་པ་ སྟེ ། །"
msgstr "The assemblage of all of these, without excluding any."

msgctxt "67ad340a5aaa4cfe892e6a0ee0f2bcd5"
msgid "ཁྱབ་བདག་ མཆོག་ གི་ གོ་འཕང་ ནི །"
msgstr "The achievement level of the presiding lord."

msgctxt "d141999af351464db769abfcfdf08c5e"
msgid "སྔགས་པ་ རྣམས་ ཀྱིས་ བསྒོམ་པ་␣ར་ བྱ ། །"
msgstr "The tantric practitioners must meditate on this."

msgctxt "c0124b22c1b24b109baa29249a860b6f"
msgid "ཞེས་ དང༌ །"
msgstr "And"

msgctxt "ddfe6d7927834af2b3d9658b5bd47e4c"
msgid "རྡོ་རྗེ་ གུར་ ལ་␣ས །"
msgstr "According to the Vajra Dome:"

msgctxt "76e5be7ac04644759fca69ea52ea03dd"
msgid ""
"མཚན་ བཟང་པོ་ སོ་ གཉིས་ དང་ དཔེ་བྱད་ བརྒྱད་ཅུ་␣ས་ བརྒྱན་པ་␣འི་ སྐུ་ དེ་ ནི་ "
"ང་ ཡིན་ ནོ །༑ །"
msgstr ""
"That body adorned with the thirty-two excellent marks and the eighty minor "
"marks is me."

msgctxt "4a4626fff96b48b69801b8163dd725fb"
msgid "ཞེས་ དང༌ །  ཀྱེེ་ རྡོར་ ལ་␣ས །"
msgstr "And. According to the Hevajra [Tantra]:"

msgctxt "608759a1bdb94c73b033e11558c6b48a"
msgid "བཙུན་མོ་␣འི་ བྷ་ ག་␣འི་ བདེ་ གནས་ སུ །"
msgstr "In the bhaga of a queen, the place of bliss."

msgctxt "78f4caf1d2b84da0a03307621fe98e15"
msgid "སྟོན་པ་ སུམ་ཅུ་རྩ་གཉིས་ མཚན ། །"
msgstr "The teacher possesses the thirty-two marks."

msgctxt "8bc218461f2141118a17b3135a190371"
msgid "གཙོ་བོ་ དཔེ་བྱད་ བརྒྱད་ཅུ་ ལྡན ། །"
msgstr "As principal, the eighty minor marks."

msgctxt "c506c30f53e54912b2a3a699c2e6baf9"
msgid "གུ་བ་ ཞེས་ བྱ་␣འི་ རྣམ་པ་␣ར་ གནས ། །"
msgstr "Thoroughly abides in the so-called Guwa."

msgctxt "f891b80b2e6e4eb28b2ef52c3881b5ca"
msgid "ཞེས་ སོགས་ མཐའ་ ཡས་ སོ ། །"
msgstr "There are infinite such examples."

msgctxt "0962674ed4e241a19a48f1529646db0f"
msgid ""
"ཚུལ་ དེ་ལྟར་ མ་ གོ་ ན་ དུག་ གསུམ་ གྱིས་ ཀུན་ ནས་ བསླངས་ ཏེ་ ཞལ་ སྦྱོར །"
msgstr ""
"If one does not understand this approach, one will be motivated by the three"
" poisons, and lead to union, "

msgctxt "54eb6553d55c44c0bcc7a9238ce6cc66"
msgid "འཇིགས་རུང་ །"
msgstr "Fearsome,"

msgctxt "3a8aed4714b84238b929afe88f408f0e"
msgid "དུད་འགྲོ་␣འི་ རྣམ་པ་ ཅན་ སྒོམ་པ་ ནི་"
msgstr "Meditating in the aspect of an animal is"

msgctxt "1d91628a81d14ff0b4d10f1d65996ecc"
msgid "རྒྱལ་བསེན་ སྒྲུབ་པ་ དང་ ཁྱད་མེད་ ཅིང་ །"
msgstr "No different from practicing Gyalsen [A kind of malevolent spirit]."

msgctxt "d7ce5fdfcba8457ebdb4d31424a9c0ec"
msgid "བརྟན་པ་ ཐོབ་ ཀྱང་ ཡོན་ཏན་ སྣ་ གཅིག་ མི་ འབྱུང་ ངོ༌ །"
msgstr "Even if one attains stability, not a single good quality will arise."

msgctxt "4666baa575a84e9fb5ed1a8777f4cc74"
msgid "རྡོ་␣༽༽  ལྷ་ རང་ཉིད་ ཀྱིས་ བསྒོམས་པ་ གཞན་ ལ་ སྟོན་པ་"
msgstr ""
"Vajra: It is said that the deity on which one meditates or teaches it to "
"others,"

msgctxt "a7a171087a78403b8c9108b2c199b000"
msgid "བྲིས་སྐུ་ འབྲི་བ་ གང་ཡང་ རུང་ སྟེ་ འབད་རྩོལ་ ལྡན་པ་␣ར་ སྒྲུབ་པ་␣ས་"
msgstr ""
"Or draws paintings of it, or whatever, since one has done with effort,"

msgctxt "0302b3cf61034f6f9b5c32335a621c30"
msgid "ཞལ་ ཇི་ལྟར་ མཐོང་བ་ དེ་␣ར་ བྱེད་ དགོས་ ཟེར །"
msgstr "It should be whatever faces one sees."

msgctxt "0d26ecd9c54f4f889e868d978d1ce8c9"
msgid ""
"འདི་␣ར་ ནི་ མདོ་ རྒྱུད་ དྲི་མ་ མེད་པ་ ལ་␣ས་ གསུངས་པ་␣འི་ དབྱིབ་ ཚད་ སོགས་"
msgstr ""
"In this [system], the shapes, sizes, and so forth are stated in the "
"stainless sutras and tantras."

msgctxt "caa038c34a0741d4bbb5f36914fcd238"
msgid "ཇི་ལྟར་ བཤད་པ་␣འི་ ལྷ་ དེ་ རྣམས་ ཁོ་ན་ གཙོ་བོ་␣ར་ བྱ་ དགོས་ ཏེ་"
msgstr "The deities as mentioned in there should be the primary ones."

msgctxt "9333d67336c14ab881ece5814410c225"
msgid "ཤེས་བྱ་ ཐམས་ཅད་ མཁྱེན་པ་␣ས་ སྐྱོན་ སྤོང་ ཡོན་ཏན་ སྒྲུབ་པ་␣འི་ ཐབས་"
msgstr ""
"By knowing all the knowable and the means for abandoning faults and "
"accomplishing good qualities."

msgctxt "40eea410dd95498c8654cb387c71cc0b"
msgid "སེམས་ཅན་ ཀུན་ ལ་ སྟོན་པ་␣འི་ ཕྱིར །"
msgstr "Teaching them to all the sentient beings."

msgctxt "a9179042e06543159d87c3a2a065de2c"
msgid "རང་ གིས་ མཐོང་བ་␣འི་ ལྷ་␣ར་ སྐྱོན་ ཅི་ ཡོད་ ཅེ་ན་"
msgstr "If someone asks, \"What is the fault with the deity that one sees?\""

msgctxt "45df050cdbb34f10b4bfc847e94b8a1d"
msgid "རང་རྒྱུད་ སྒྲིབ་པ་␣ས་ བསྒྲིབས་ ཏེ་"
msgstr "Because one's [mental] continuum is obscured by the obscurations."

msgctxt "8041e614499f489394de6f097aff9556"
msgid "ཉོན་མོངས་ འདུ་བ་ བཞི་␣ས་ མཐོང་སྣང་ དུ་མ་ འབྱུང་བ་ དང་"
msgstr ""
"The numerous visual appearances caused by the four collections of affliction"
" and "

msgctxt "6b4bf5df48fe46999e6b08457e2e7de1"
msgid "མཐོང་བ་ དེ་ རྒྱལ་བ་␣འི་ བཀ་␣ས་ མ་ བསྒྱུར་ ན་"
msgstr ""
"If those seeings are not transformed by the teachings of the conqueror,"

msgctxt "fe5e19a1f145484c90ac91d165a9f7a7"
msgid "ལེགས་ཉེས་ གར་ འགྲོ་ མི་ ཤེས་ ཤིང་"
msgstr "One does not know where good and bad are going."

msgctxt "13b3730673794722a1ea06003ee1cf68"
msgid "བཀའ་ དང་ འགལ་བ་␣འི་ ལོག་ཤེས་ ཡིན་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"This is because it is a wrong consciousness that contradicts the Buddha’s "
"words."

msgctxt "56ae277e4710452782c84bbf30c37a83"
msgid "རྡོ་␣༽༽  དབང་ རབ་ འབྲིང་ ཐ་ གསུམ་ ལ་ རིམ་བཞིན །"
msgstr ""
"Vajra: It is said that the most, medium, and least capable faculties, these "
"three progressively"

msgctxt "089ee625287b4650ac5f0eb98ad69ca9"
msgid "ཚོམ་བུ་ རས་བྲིས་ རྡུལ་ མཚོན་ ལ་ བརྟེན་ ནས་"
msgstr ""
"Relying on the cluster, the painted cloth, and the representation of "
"particles,"

msgctxt "30ce9d4c7b854c52b83c80ce85dd8417"
msgid "རིམ་བཞིན་ བསྐྱེད་རིམ་ སྐད་ཅིག་ དྲན་ རྫོགས །"
msgstr ""
"The generation stage is progressively recalled and completed in a moment."

msgctxt "5c83de4c3d3640eb8836869a8408ef5d"
msgid "ས་བོན་ ལ་ བརྟེན་པ་ འབྱུང་བ་ རིམ་ བརྩེགས་ སྒོམ་པ་ དང་ །"
msgstr "Relying on the seed and meditating consecutively. "

msgctxt "9e2957e797d84a799185894ef6a30d8c"
msgid "ཆོ་ག་ མི་ དགོས་པ །  ཆོ་ག་ འབྲིང༌ །  ཆོ་ག་ རྒྱས་པ་ སྟེ་ །"
msgstr ""
"Those that do not require rituals, those that require medium rituals, and "
"those that require extensive rituals."

msgctxt "c2554872e51e4b4c8e6293d3ac1da634"
msgid "རབ་ ལ་ ཚོམ་བུ་ སོགས་ དང་པོ་ གསུམ་ གྱི་ ཆོག་ ཟེར་ རོ ། །"
msgstr ""
"For those of best [faculties], the first three, such as the cluster and so "
"forth, are sufficient."

msgctxt "b960fe8d11904f9985f0f52982b186c1"
msgid "འདི་␣ར་ ནི་ དབང་པོ་ རབ་ ལ་ ཆོ་ག་ རྒྱས་པ་ ལྷག་པར་ ཡང་ དགོས་ ཏེ་"
msgstr ""
"In this [system], for those of the best faculties, an extensive ritual is "
"especially required."

msgctxt "9372bc8a41404ba78116ea4f90dc2e06"
msgid ""
"སྐྱེ་བ་ མེད་པ་␣ར་ རྟོགས་པ་ རྒྱུ་འབྲས་ ཀྱི་ རྟེན་འབྲེལ་ ལ་ རག་ ལས་ཤིང༌ །"
msgstr ""
"The realization of non-arising depends on the interdependence of cause and "
"effect, "

msgctxt "17d247c5036d4e2082010ee95ad6cb49"
msgid "དེ་ རྟོགས་ ན་ རྒྱུ་འབྲས་ ཉིད་ དུ་ འཆར་ ཏེ་"
msgstr "And when that is realized, it arises as cause and effect."

msgctxt "2765ac1c7cec4ca58ecf4e59d117ae25"
msgid "ཡོན་ཏན་ ཕྲིན་ལས་ ཐམས་ཅད་ འབྱུང་བ་␣ར་ འགྱུར་བ་␣འི་ ཕྱིར་ དང་ །"
msgstr "All the qualities and enlightened activities will emerge."

msgctxt "9f3cddb3659c4aec900de629cb1e5206"
msgid "དབང་པོ་ ཐ་མ་␣ས་ དེ་ལྟར་ འཇུག་ མི་ ཤེས་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"Because those of the least faculties do not know how to engage in that way."

msgctxt "56129bceb10d4cd18e8ba32d90d9d938"
msgid "དེ་ལྟར་ ཡང་ ཡུམ་ ལ་␣ས །"
msgstr "Likewise, according to the Mother [Prajnaparamita Sutra]:"

msgctxt "83c5be1f701342819f4303ad1c1c58d0"
msgid "ཆོས་ ཐམས་ཅད་ མཉམ་པ་ཉིད་ བས་"
msgstr "Because of the sameness of all phenomena,"

msgctxt "8c7a5b6b9daf4af09c746f6b8edffb0e"
msgid "ཤེས་རབ་ ཀྱི་ ཕ་རོལ་ ཏུ་ ཕྱིན་པ་ མཉམ་པ་ཉིད་ དོ ། །"
msgstr "The perfection of wisdom is itself sameness."

msgctxt "1490e6b954f0474984b4bb0f016552b9"
msgid "ནམ་མཁའ་ མུ་མེད་པ་␣ས x"
msgstr "Because space has no limits..  X"

msgctxt "d367029d03ea4cb889666fec0b252f81"
msgid "རི་རབ་ སྣ་ཚོགས་␣x"
msgstr "The diversity of Mount Meru.. X"

msgctxt "d24a7187f47d4b06b84055dee4a91a87"
msgid "ཞེས་ གསུངས་པ་ འདི་␣ས་ བསྟན་པ་ ཡིན་ ནོ ། །"
msgstr "This statement teaches this."

msgctxt "c26b471dad714e5494253a723259d0ec"
msgid "ལྷན་␣༽༽  མཁས་པ་ གཞན་དག་ ན་རེ །"
msgstr "Addendum: Other experts say:"

msgctxt "8e23836ace4f4c3c8728cc11dda68912"
msgid "བྱ་སྤྱོད་ རྣལ་འབྱོར་ གསུམ་ མི་ ཟབ་ བླ་མེད་ ཟབ་ སྟེ་"
msgstr ""
"The three of action, conduct, and yoga are not profound, but are the highest"
" profound."

msgctxt "1ae437b65c5b4b4a82313a89c28da046"
msgid "དྲང་དོན་ དང་ ངེས་དོན་ ཡིན་པ་␣འི་ ཕྱིར་ ཞེས་ ཟེར་ རོ ། །"
msgstr ""
"Therefore, it is said to be the provisional meaning and the definitive "
"meaning."

msgctxt "13f44794aa6a49b6a8b2c0eb98863b0b"
msgid "འདི་␣ར་ ངེས་དོན་ ཡིན་པ་␣ར་ མཐུན་ ཀྱང་"
msgstr ""
"In this [system], Although it is in concordance with being the definitive "
"meaning."

msgctxt "e072cfeec50a497ab0e6b950707cc019"
msgid ""
"དྲང་དོན་ གསུམ་པོ་ དང་ ངེས་དོན་ བླ་མེད་པ་␣ར་ གཉིས་ཀ་ ལ་ ཆོ་ག་ རྒྱས་པ་ དགོས་ "
"ཏེ་"
msgstr ""
"The three provisional meanings and the highest definitive meanings require "
"extensive rituals."

msgctxt "43872e2bc7be40aa9ffc8e984eab33c0"
msgid "རྒྱུ་རྐྱེན་ ལ་མ་ བརྟེན་ ན་ མི་ འགྲུབ་པ་␣འི་ ཕྱིར །"
msgstr ""
"If it is not dependent on causes and conditions, it cannot be established."

msgctxt "bbe0e1e363e44b43a76d93fe98fa9b61"
msgid "དཔེར་ན་ ཆུ་ལུད་ དྲོད་གཤེར་ དང་ བྲལ་བ་␣འི་ ས་བོན་ བཞིན་ ནོ ། །"
msgstr ""
"For example, it is like a seed that is free from water, fertilizer, heat, "
"and moisture."

msgctxt "5410184b80ed4a2fba870e55591f3363"
msgid "དེས་ན་ རང་ ལུས་ རྡོ་རྗེ་ གསུམ་ གདོད་ ནས་ ཡིན་པ་␣ར་"
msgstr "Therefore, one’s own body is primarily the three vajras."

msgctxt "43bfd28ff94d4e0c87683188dbc4febb"
msgid "ངེས་པ་␣འི་ དོན་ ཆོ་ག་ ལ་ བརྟེན་ ནས་ རྟོགས་ དགོས་ ཤིང་"
msgstr "The definitive meaning must be realized by relying on ritual."

msgctxt "dd04734fa5914bd0977b1eb683d2a3dd"
msgid "རྟོགས་ ན་ དྲང་དོན་ ཆོ་ག་ སོགས་ ཐབས་ རྣམས་ ཀྱང་"
msgstr ""
"If it is realized, the methods such as the ritual of the provisional meaning"
" and so forth,"

msgctxt "5a05475569894a28b488c8a2c277ec12"
msgid "ངེས་དོན་ དང་ རོ་ གཅིག་པ་␣ར་ འགྱུར་ རོ ། །"
msgstr "Will also become one taste with the definitive meaning."

msgctxt "ad61695d42a843769d1aa50d470d71a4"
msgid ""
"ལྷན་␣༽༽  དབང་ གི་ དང་པོ་ ནས་ ཆོ་ག་ རྒྱས་པ་ གཅིག་ གི་ སྒོར་ འཇུག་ དགོས་ ཟེར །"
msgstr ""
"Addendum: It is said that from the beginning of the empowerment, one must "
"enter through the door of a single extensive ritual."

msgctxt "630d84bb8f284a029c290df8f2b5c927"
msgid "འདི་␣ར་ ནི་ ཐབས་ བསྡུས་པ་ དེ་ ཡིས་ མཚན་མ་␣ར་ ཞེན་པ་ འདུལ་ ནུས་ ན་"
msgstr ""
"In this [system], If that brief method can subdue attachment to signs,"

msgctxt "86094ec8e0b54e8a9622e31e59cfb004"
msgid "ཆོ་ག་ བསྡུས་པ་ ཡང་ ནི་ བཞེད་ དེ་"
msgstr "then the brief ritual is also accepted."

msgctxt "a9ca6c034a5e43d2972d191b3c12adaf"
msgid "རྟོགས་པ་ གཅིག་ ལ་ སེམས་ ཟིན་པ་␣འི་ དུས་ བླ་མ་␣ས་ ངོ་སྤྲོད་ ན་"
msgstr ""
"When one holds their minds on a single comprehension and the guru introduces"
" it,"

msgctxt "2b9e18406a3d4098b2c467f9bbda7497"
msgid "རྟོགས་ལྡན་ དུ་ འགྱུར་བ་ ལ་ ཚེགས་ མེད་པ་␣འི་ ཕྱིར །"
msgstr "One will have no difficulty in becoming a realized being."

msgctxt "a8d2ea4d86a84dc7b54964eaa40063f7"
msgid "ཀླུ་␣འི་ བྱང་ཆུབ་ ལ་སོགས་པ་ བཞིན་ ནོ ། །"
msgstr "It is like the naga bodhisattvas and so forth."

msgctxt "bfbcec2ef88a447dbcd704fa9689a9e6"
msgid "དེ་ བླ་མ་ མཚན་ཉིད་ དང་ ལྡན་པ་ དང་"
msgstr "A qualified master and "

msgctxt "a39962ec0a3542ea84c11bb00963e45e"
msgid "སློབ་མ་␣འི་ མོས་གུས་ དང༌ །"
msgstr "Devoted disciples and "

msgctxt "f3514753424c470891338236b22e9ebe"
msgid "སྔོན་ སྦྱང་ གི་ རྟེན་འབྲེལ་ ཚོགས་པ་ ལ་␣ས་ འབྱུང་བ་ ཡིན་ ནོ ། །"
msgstr ""
"It occurs from the accumulation of dependent-related arisings of the "
"previous training."

msgctxt "602e48949b8f4cc1a22f7749a9064c2b"
msgid "ལྷན་␣༽༽  སྔགས་ ཀྱི་ བར་ དུ་ གཅོད་པ་ དགྲ་ འགེགས་ གཉིས་ ལ་␣ས་"
msgstr ""
"Addendum: From the two hindrances of mantra, the enemy and the obstruction, "

msgctxt "0257f4b2a2e649089b739de5a69d5c68"
msgid "འགེགས་ ལ་ བསྲུང་ འཁོར་ མེ་རི་ རྡོ་ རྭ་ ཁྲོ་བོ་ འཅུ་ གཞལ་ཡས་ ཁང་ དང་"
msgstr ""
"The protection wheel from the obstruction is fire, mountain, vajra fence, "
"ten wrathful ones, the celestial mansion and "

msgctxt "9818eb522f1742f6971e06d007cc14e0"
msgid "བཅས་པ་ སྒོམ་པ་ ཟབ་པ་␣ར་ འདོད་ དོ ། །"
msgstr "so on, which is accepted as a profound cultivation."

msgctxt "acba4cee53ba40459d7457559c98b5c8"
msgid "འདི་␣ར་ དེ་ རྣམས་ ཕྱོགས་ རེ་␣ར་ འོང་པ་ ཡིན་"
msgstr "In this [system], these come from one direction."

msgctxt "1a62b2ea0544439eb86a53d2c771eb11"
msgid ""
"བསྲུང་བ་␣འི་ འཁོར་ལོ་ རྨད་ དུ་ བྱུང་བ་ གཉིས་ མེད་ བྱང་ཆུབ་ ཀྱི་ སེམས་ ཡིན་ "
"ཏེ་"
msgstr "The marvelous protection wheel is the non-dual mind of awakening."

msgctxt "f1b014f647144c3ab66b58d3b046a8b9"
msgid ""
"དོན་དམ་ བདེན་པ་␣འི་ དབང་ དུ་ ན་ གེགས་ ལ་␣ས་ སངས་རྒྱས་ ཉིད་ ཀྱང་ མེད་ ཅེས་ སོ"
" ། །"
msgstr ""
"In terms of the absolute truth, there is not even an enlightened one from "
"the obstructions."

msgctxt "648a6d5102b94758a988a92a60fe3d47"
msgid "མེད་ བཞིན་ དུ་ ཡུལ་ དབང་ཤེས་ གསུམ་ ཚོགས་པ་ ལ་␣ས་ གེགས་ སྣང་ འབྱུང་"
msgstr ""
"Although it is non-existence, the appearance of obstructions occurs when the"
" object, sense faculties, and consciousness come together."

msgctxt "1c299b0523f8413f95aefe5b41fd308d"
msgid "དེ་␣འི་ རྩ་བ་ ཡིད་ ཀྱི་ སྐྱེ་མཆེད་ མིག་ སོགས་ དང་"
msgstr ""
"The roots of that are the sense-source of the mind, eye, and so forth,"

msgctxt "d8ecf68ef67b47a28b8a612f836110f7"
msgid "ཡིད་ཤེས་ གཅིག་ ཏུ་ བྱས་ ཏེ་"
msgstr "And the mental consciousness is taken as one."

msgctxt "a08ababfc30c4ddc94010fa01598c2ef"
msgid "ཕྱི་␣འི་ གཟུགས་ ལ་ སྐྱེ་ ཞིང་ མཆེད་པ་ དྲུག་ ལ་␣ས་"
msgstr ""
"In the outer form, from the six [sources] of the arising and ignition,"

msgctxt "2449c2941d124efea88bac57439a8e13"
msgid "མིག་ རྣ་ སྣ་ ལྕེ་ ལུས་ ཡིད་ དྲུག་ ལ་"
msgstr "In the six: eye, ear, nose, tongue, body, and mind "

msgctxt "08eb18ffda7446098e56c652da5242d0"
msgid ""
"རིམ་བཞིན་ གཏི་མུག །  ཞེ་སྡང །  སེར་སྣ །  འདོད་ཆགས །  ཕྲག་དོག་ གི་ སྐྱེ་མཆེད་"
" ཐམས་ཅད་ བསྡུས་པ་␣འི་ རྡོ་རྗེ་ དྲུག་ ཏུ་ གསུངས་ ཏེ་"
msgstr ""
"The six vajras are taught as that which include all the sensory fields of "
"delusion, anger, avarice, desire, and jealousy respectively."

msgctxt "20ccaa07fa0f4d35a0c07dd39b880bac"
msgid ""
"ཕྱི་ ལྟར་ ན་ མིག་ ས་སྙིང་ རིགས་ རྣམ་སྣང་ རང་ གི་ ས་སྙིང་ ཡིན་པ་ གོམ་ ཞིང་ "
"འདྲིས་པ་␣ས་"
msgstr ""
"The outer aspects are the eyes as the essence of the ground, by habituating "
"or acquainting oneself with the family of Vairocana as one's own essence of "
"the ground."

msgctxt "2478662b4e864ce2ac372d497e73e0a5"
msgid "མཐོང་བ་ ཐམས་ཅད་ རྣམ་སྣང་ ལས་མ་ གཡོས་ ཤིང་"
msgstr "Everything one sees does not waver from Vairocana,"

msgctxt "30855cb8868a4d02aff05567ccf01ca0"
msgid "གེགས་ བྱ་བ་ གདོད་ ནས་ མ་གྲུབ་པ་␣འོ ། །"
msgstr "That which obstructed has never been established primarily."

msgctxt "9528223842be45cb8a6b2c4a6119063a"
msgid "དེ་བཞིན་ རྣ་བ་ སོགས་ ཀྱང་"
msgstr "Likewise, the ears and so on, are"

msgctxt "d4dcb4eb69a441b5b949f3853928fafb"
msgid ""
"རིམ་བཞིན་ གསང་བདག  ནམ་ སྙིང༌ །  སྤྱན་རས་ གཟིགས །  སྒྲིབ་ ་ སེལ །  སྐྱེ་མཆེད་"
" བསྡུས་པ་ ཀུན་བཟང་ དང་ རིགས །  མི་ བསྐྱོད །  རིན་འབྱུང་ །  སྣང་ མཐའ །  "
"དོན་གྲུབ །  དྲུག་པ་ རྡོ་རྗེ་ འཆང་ སྟེ་ ལྔ་པོ་ གོང་ ལྟར་ སྦྱར་ རོ །"
msgstr ""
"Successively, the five of Lord of Secrets or Heart, Avalokiteshvara, "
"Dispeller of Obscurations, Samantabhadra and his family contained with the "
"sense sensory fields, Aksobhya, Ratnasambhava, Amitabha, Amoghasiddhi, and "
"the sixth, Vajradhara. These five are to be connected as before."

msgctxt "461f93e980054cbcb65cf436a53fdc08"
msgid ""
"ནང་ལྟར་ ན །  མེ་ལོང་ །  ཆོས་དབྱིངས །  མཉམ་ཉིད །  སོ་␣ར་ རྟོག །  བྱ་ གྲུབ་ "
"ཀྱི་ ཡེ་ཤེས་"
msgstr ""
"The inner aspects are the mirror, dharmadhatu, equality, individual "
"comprehension, all-accomplishing wisdom,"

msgctxt "343a07b4de2f42d28a184bfddd5fa454"
msgid ""
"ལྔ་␣ས་ སྤང་བྱ །  གཏི་མུག  ། ཞེ་ སྡངསེར་ སྣ་ འདོད་ཆགས །  ཕྲག་དོག་ གི་ "
"མ་རིག་པ་ ལྔ་ བསལ་ བཞག་ མེད་པ་␣ར་ སྤང་ གཉེན་ མི་ བྱེད་པ་␣འི་ ཚུལ་ གྱིས་ "
"འཇོམས་པ་␣ས་ སྲུང་བ་␣འི་ ཆོག་ གོ  །"
msgstr ""
"The five ignorances to be abandoned by these five are ignorance of delusion,"
" hatred, miserliness, desire, and jealousy. These are abandoned without "
"eliminating or placing, without antidotes or antidotes being applied, thus "
"it is the ritual of protection."

msgctxt "245e7a2530be4897a7eaabd3b0ef88ad"
msgid ""
"སྲུང་བ་ ཞེས་པ་ རྒྱུ་ལ་ གནས་པ་ ལམ་ གྱིས་ བསྲུངས་ ནས་ འབྲས་བུ་ མངོན་དུ་ "
"བྱེད་པ་␣འོ ། །"
msgstr ""
"So-called protection is being abided in the cause, protected by the path, "
"and the actualization of the result."

msgctxt "7c3af3b7142745389e3a431d9133f761"
msgid ""
"རྡོ་␣༽༽  སྨིན་ བྱེད་ སྟ་དངོ་␣ས་ གྲོལ་ བྱེད་ བསྐྱེད་རྫོགས་ སོགས་ ཀྱི་ རྣམ་ "
"བཞག་ རྒྱས་པ་ རྣམས་"
msgstr ""
"Vajra: The extensive presentations of the ripening axe blade, the generation"
" and completion stages for the liberating levels, and so on are "

msgctxt "e142c73cca17452f8b5e15b13fd4ecae"
msgid "སྤྲོས་པ་ ལ་ དགའ་བ་ ལ་ གསུངས་པ་ ཡིན་ ཟེར །"
msgstr "It is said that they are taught for those who like elaboration."

msgctxt "357afc0f810644b893eafc73550f1a2e"
msgid "འདི་␣ར་ ནི་ སྤྲོས་པ་␣འི་ རིམ་པ་ དེ་ ཐམས་ཅད་"
msgstr "In this [system], all these stages of elaboration are "

msgctxt "1dfad4bd6d844eb3bb0331ccc539f39d"
msgid "ཤེས་བྱ་␣འི་ གཤིས་ ལ་ ཡོད་པ་ བབས་ ཀྱི་ རྟེན་འབྲེལ་ ཡིན་ ཏེ་"
msgstr ""
"Dependent relationships that naturally exist within the nature of Knowable."

msgctxt "5f22b20d79ab49bf909b5bf6b23dd82b"
msgid "ཕྱི་ སྣོད་ རླུང་ མེ་ ཆུ་ ས་རི་ རབ་ ལྔ །"
msgstr ""
"The outer vessel of the five: wind, fire, water, earth and་Mount Meru."

msgctxt "23c3bfa10cdb4956a23f8ac000c94af0"
msgid ""
"རང་ ལུས་ རྐང་མཐིལ །  འདོམས །  ལྟེ་བ །  བྲང་ །  སྒལ་ཚིགས་ རྣམས་ ཡིན་པ་␣ར་ "
"གསུངས་པ་␣ས་"
msgstr ""
"And one’s own body with the soles of the feet, genitals, navel, chest, and "
"spine are taught."

msgctxt "979f0a6f911e42db8632d35158af32f3"
msgid "ཚུལ་ དེ་ལྟར་ བསྒོམ་ དགོས་པ་ དང༌ །"
msgstr "It is required to meditate in this way and"

msgctxt "b5d7003fd37e4575820c473badd8ce5d"
msgid "བཅུད་ གྲུབ་པ་␣འི་ ཚུལ་ དུ་ ལྷ་ དང་ ལྷ་མོ་␣འི་ རང་བཞིན་ གདོད་ ནས་"
msgstr ""
"As a way of forming the [inner] content, in the prime nature of the deity "
"and the female deity,"

msgctxt "3c192d9d77284ea392504fe1d9a8c39f"
msgid "གྲུབ་པ་ བསྒོམ་པ་␣ས་ འབྲས་བུ་ མཉམ་ཉིད་ མངོན་དུ་ གྱུར་པ་ སྟེ་"
msgstr ""
"The fruition of the realization of equality is actualized through the "
"meditation on accomplishment."

msgctxt "41a935b2528e409faefad9dfe4ae4daa"
msgid ""
"སྤྲོས་པ་ དེ་དག་ གདོད་ ནས་ གནས་པ་ རྟེན་འབྲེལ་ གྱི་ ཚུལ་ དུ་ འབྱུང་བ་␣འི་ "
"ཕྱིར་ རོ ། །"
msgstr ""
"This is because these elaborations primarily exist and arise in the manner "
"of dependent relationships."

msgctxt "c6ec7a05c1dd4dada3b448a34cc8f04d"
msgid "དེ་ལྟར་ ཡང་ །"
msgstr "Likewise, "

msgctxt "ed65f39d92a1437b96c1a10510c62f0f"
msgid "རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་ མ་གཏོགས་པ་␣འི ། །"
msgstr "Other than dependent-related arising,"

msgctxt "884cd2c789274ddda4988ee9107fac37"
msgid "ཆོས་ འགའ་ ཡོད་པ་ མ་ ཡིན་ ནོ ། །"
msgstr "There is not a single phenomenon."

msgctxt "bdcb9c602ff747e98a60a412d047018d"
msgid "ཞེས་ དང་ །"
msgstr "And."

msgctxt "bd88d3f4ae4a4e519b6c61fba656526f"
msgid "ཕུར་པ་␣འི་ རྒྱུད་ ཉི་མ་␣འི་ འོད་ཟེར་ ལ་␣ས ། །"
msgstr "According to The Vajrakila Tantra, the Rays of the Sun:"

msgctxt "862bc43d5be349698477a45cf41d62d2"
msgid "རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་གནས་པ་␣འི་ ཆོས ། །"
msgstr "The phenomena abiding in the dependent-related arising,"

msgctxt "e3dffe4df3634bb8bdf7617eebe568ca"
msgid "རིག་པ་␣འི་ ཡེ་ཤེས་ གསལ་བ་␣ར་ འགྱུར །"
msgstr "The wisdom of rigpa will become clear."

msgctxt "4418644c464f4ffb8cca96cc72af059f"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "b8d44f6ea68846ea9243ef716565a811"
msgid "རྡོ་␣༽༽  རྡོ་རྗེ་␣འི་ ལུས་ ཀྱི་ གནས་ལུགས་ ལུས་ དང་ མཉམ་ དུ་"
msgstr "Vajra: It is said that the actuality of the vajra body, with the body"

msgctxt "278a7b1cc61c4044bacda07e264c2f91"
msgid "ཆགས་པ་ གནས་པ་ རྩ་ གཡོ་བ་ རླུང་ བཀོད་པ་"
msgstr "Attachment abides, the channels move, the wind arrange,"

msgctxt "7098dd7009f5457fb7ebac043385de76"
msgid "བྱང་སེམས་ ཐིག་ལེ་␣འི་ འཁོར་ལོ་ བཞི་ འདི་ ཡིན་ ཟེར །"
msgstr "These are said to be the four wheels of the bodhicitta drop."

msgctxt "28c0bc69633d4f71937c5109f63007ba"
msgid ""
"འདི་␣ར་ ནི་ རྡོ་རྗེ་␣འི་ ལུས་ ཟབ་མོ་ གཉིས་ སུ་ མེད་པ་␣འི་ འཁོར་ལོ་ བཞེད་ དེ་"
msgstr ""
"In this [system], it is accepted that the profound vajra body is the non-"
"dual wheel."

msgctxt "5d97116584c1429a8e69132a0e136b44"
msgid "ཆོས་སྐུ་ ཡིན་པ་␣འི་ ཕྱིར་␣༑"
msgstr "Because it is the dharmakaya."

msgctxt "e42a5887667d4ae18e6b72fcc4acfdee"
msgid "དཔེར་ན་ དམ་བཅའ་ བདུན་ ལྡན་ གྱི་ ཕ་ལམ་ བཞིན་ ནོ །"
msgstr ""
"For example, it is like the path of perfection which is endowed with the "
"seven commitments."

msgctxt "777d18065da3436a8af99bcb49f7132f"
msgid "དེ་ལྟར་ ཡང་ རྡོ་རྗེ་ རྩེ་མོ་ ལ་␣ས་"
msgstr "Likewise, according to the Peak of Vajra:"

msgctxt "62686fa70c824248aa88b631da2ad5a5"
msgid "སྲ་ ཞིང་ སྙིང་པོ་ ཁོང་སྟོང་ མེད ། །"
msgstr "It is firm with no hollow core,"

msgctxt "53d8c5105e8f4024a41f193c4f2f10bd"
msgid "གཞིག་ ཅིང་ གཞོམ་ དུ་ མེད་པ་␣ས་ ན ། །"
msgstr "Unbreakable and cannot be defeated,"

msgctxt "3fe7f01505c94afaae43a2bab5012fb6"
msgid "བསྲེག་ པ་␣ར་ བྱར་མེད་ འཇིགས་པ་ མེད ། །"
msgstr "It cannot be burned, and there is no fear."

msgctxt "ae5f38974e6d45ce80491094f658a23a"
msgid "སྟོང་པ་ཉིད་ ནི་ རྡོ་རྗེ་␣ར་ བཤད ། །"
msgstr "Emptiness is explained as the vajra."

msgctxt "36e25b466d41446d919f81bedf6354b3"
msgid "ཅེས་པ་␣ས་ ཆོས་སྐུ་ ཡོན་ཏན་ མཛད་པ་ དང་ བཅས་པ་ སྟེ་"
msgstr ""
"Thus, the dharmakaya is endowed with qualities and enlightened activities."

msgctxt "fb9cd9bd1e9943e0a848ec862359f732"
msgid ""
"སྒོ་གསུམ་ རྡོ་རྗེ་ གསུམ་ ལ་␣ས་ ནམ་ཡང་ མི་འདའ་ བར་ བྱེད་པ་ རྡོ་རྗེ་ འཛིན་པ་ "
"ཟེར །"
msgstr ""
"One who never passes the three doors and the three vajras is called a vajra "
"holder."

msgctxt "96b3a605f5154a1fac0b685ff2218804"
msgid ""
"དེ་ ལ་ བརྟེན་ ནས་ སྒོ་གསུམ་ དབྱེ་␣ར་ མེད་ གཉིས་ སུ་ མེད་པ་␣འི་ རྡོ་རྗེ་ "
"མི་ཕྱེད་པ་"
msgstr ""
"In dependence on that, the inseparable and non-dual three doors of vajra,"

msgctxt "b43eb9b9526643379349d4252f282769"
msgid "མངོན་དུ་ གྱུར་པ་ ལ་ རྡོ་རྗེ་␣འི་ ལུས་ ཞེས་ བྱ་ སྟེ །"
msgstr "Their actualization without division is called the vajra body."

msgctxt "30a8144a70a1402398a91e2d2cfcd8be"
msgid "ལུས་མེད་ ལུས་ ཏེ་ ལུས་ ཀྱི་ མཆོག  །"
msgstr "The bodyless body is the supreme body."

msgctxt "a5976b0b82d8480eb2be2aa7b8ec69a1"
msgid "ལུས་ ཀྱི་ མཐའ་ ནི་ རྟོཌ་པ་ པོ །"
msgstr "The body’s end is the realizer."

msgctxt "e03d72c4e4e74eab8fe16840d713012a"
msgid "ཞེས་པ་␣ས་ དེ་ མངོན་དུ་ བྱས་པ་␣འོ །"
msgstr "Thus, this is what is manifested."

msgctxt "6a01bebdcdf942eaa66e06ba898575e1"
msgid ""
"རྡོ་␣༽༽  རྩ་ རླུང་ ཐིག་ལེ་␣འི་ གནས་ལུགས་ རྒྱུད་ དུ་ གསུངས་པ་ དེ་ ཁོ་ན་␣ར་ "
"ངེས་ ཟེར་"
msgstr ""
"Vajra: It is said that the actuality of the channels, winds, and drops is "
"ascertained only as taught in the tantras."

msgctxt "7a9ee1fa99034c5cbe7813cdb9a0a1a5"
msgid "འདི་␣ར་ ནི་ ཟབ་མོ་␣འི་ གནས་ལུགས་ འགའ་ཞིག་"
msgstr "In this [system], some profound actualities were"

msgctxt "8004c99d5dd747d78e223dcac45bddd6"
msgid ""
"རྡོ་རྗེ་ འཆང་ གིས་ རྒྱུད་ དཀྲུགས་ ལུང་ བཅུ་␣ས་ མན་ངག་ གབ་པ་␣འི་ སྒོ་ ནས་ "
"སྦས་པ་ ཡིན་ ཏེ །"
msgstr ""
"concealed by Vajradhara in the mixed tantras and the ten transmissions in "
"the approach of hidden foremost instruction."

msgctxt "ad0ea0b24a4c4005abfbc55f4b2b36a8"
msgid "བླ་མ་ ལ་མ་ བརྟེན་པ་␣ར་ དབང་རྣོན་ གོ་བ་␣ས་ ཞུགས་ ན་"
msgstr ""
"If those of sharp faculties engage with comprehension without relying on a "
"guru,"

msgctxt "245b2036a1f5440688aaa0c3a0c921f6"
msgid "དངོས་གྲུབ་ མི་ ཐོབ་ ཅིང༌ །"
msgstr "They will not attain the actual accomplishment."

msgctxt "2f6645d1c6a04b4e863ad4473ddf505d"
msgid "ཉམས་པ་␣ར་ འགྱུར་བ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Therefore, [they] will become degenerated. "

msgctxt "fe0ffa6f15184040993c31ea4e985465"
msgid "ཆོས་ ལུང་ ལ་ རག་ ལ་␣ས །"
msgstr "The Dharma depends on transmission, "

msgctxt "6b4654ab345c4cdcab8e4d155e1f7fd2"
msgid "ལུང་ མན་ངག  །"
msgstr "Transmission [depends] on the foremost instruction,"

msgctxt "90c5f5cd2940498badd2435aa47f819f"
msgid "མན་ངག་ བརྒྱུད་པ་␣འི་ བླ་མ་ ལ་ རག་ ལས་པ་␣ས་"
msgstr "The foremost instruction depends on the lineage gurus."

msgctxt "37187dde2b9e4c1e873b8479bf11e83e"
msgid "དབང་རྣོན་ གྱིས་ ཟབ་མོ་ དེ་ རྟོགས་པ་␣འི་ ཆེད་ དུ་"
msgstr ""
"Therefore, to realize that profound [instruction], those of sharp faculties,"

msgctxt "dd2d302948d74a5f89d6ee883d0f64ea"
msgid "བླ་མ་␣ར་ བསྟེན་ ནས་ བརྩོན་འགྲུས་ ཀྱིས་ ཉམས་ སུ་ བླངས་པ་␣ས་"
msgstr "Rely on a guru and gain experience with diligence."

msgctxt "06020bc035874e5eade41a4f4a3873db"
msgid "གནས་ལུགས་ རྟོགས་པ་␣ར་ འགྱུར་བ་␣འི་ ཕྱིར །"
msgstr "[They] will realize the actuality."

msgctxt "765f12af882c434990f2a54a9eabd587"
msgid "སྦ་␣ས་ ཏེ །"
msgstr "In a hidden:"

msgctxt "57c9672d0bd94950b6da1916714316d9"
msgid "རྡོ་རྗེ་ སྙིང་པོ་ ལ་␣ས །"
msgstr "According to the the Vajra Essence:"

msgctxt "843178add5fd465c9dfedd778aedb412"
msgid "ཆོས་ ཀྱི་ ཕུང་པོ་ བརྒྱད་ ཁྲི་ དང༌ ། །"
msgstr "The eighty thousand heaps of the Dharma and,"

msgctxt "06f125f0a4754893b9c4d4abc6559560"
msgid "བཞི་ སྟོང་ གི་ ནི་ གྲངས་ སྟོང་ གི  །"
msgstr "Four thousand, the thousands of enumeration,"

msgctxt "e4d930b2b1b1409e926c53e72b5a2d24"
msgid "ཡང་དག་ འདུས་པ་␣ར་ ངས་ བཤད་ དོ ། །"
msgstr "I have explained the genuine assemblage."

msgctxt "fc0395c88deb4ed9b8a8d42af8f4e623"
msgid "གཞན་ དུ་ དོན་ འདི་ མ་ བསྒྲགས་པ་␣ས ། །"
msgstr "Because this meaning is not proclaimed elsewhere."

msgctxt "0f31d7c52c9249acb0f008ae7849fcbf"
msgid "བླ་མ་ ལ་ ནི་གུ་␣ས་པ་ ཡི ། །"
msgstr "Paying respect to the guru."

msgctxt "905868706b9a469dadbfbaf98b9f4018"
msgid "སློབ་མ་ དག་ གིས་ རྟོགས་པ་␣འི་ ཕྱིར ། །"
msgstr "For the disciples to realize."

msgctxt "f3789c6a31f946e9b807f9f7950eece0"
msgid "རྒྱུད་ གཞན་དག་ ཏུ་ སྦས་པ་␣འོ ། །"
msgstr "This is hidden in other tantras."

msgctxt "ab0184ca5f2f487d809e937fea947957"
msgid "རྟོགས་ ཚུལ་ ཆོས་རྗེ་ རིན་པོ་ཆེ་ བཞིན་ ནོ ། །"
msgstr ""
"The way of realization is similar to that of the precious lord of the "
"Dharma."

msgctxt "274b981ea6124ae39474f621e8cd4eae"
msgid "རྡོ་␣༽༽  ལུས་ སྐྱོན་ཡོན་ གྱི་ གནས་ལུགས་"
msgstr ""
"Vajra: It is said that the actuality of the faults and good qualities of the"
" body"

msgctxt "dffc124335eb4f0cae4b1f2ff58a003b"
msgid "རྩ་  རླུང་ གི་ རྟེན་འབྲེལ་ ལ་␣ས་ འབྱུང་བ་␣ས་"
msgstr "arises from the interdependence of the channels and winds. "

msgctxt "fccb0817440248d986616ea2f8d89114"
msgid "དང་པོ་ སྐྱེ་བ་␣འི་ རྒྱུ །"
msgstr "The causes of birth at the beginning,"

msgctxt "8615eaea352c4a9a9a48bd589329191b"
msgid "བར་ དུ་ གནས་པ་␣འི་ གཞི །"
msgstr "The basis of abiding in the middle,"

msgctxt "111a4f7354704290b6c8a790e075a8ea"
msgid "མཐ་␣ར་ འཇིག་ རྐྱེན་ རྣམས་ རྒྱུད་ དུ་ བཤད་པ་ ལྟར་ ཟབ་ ཟེར །"
msgstr "and the conditions of destruction at the end."

msgctxt "93b832b86fd4411dbe49cc31a59ded43"
msgid ""
"འདི་␣ར་ ནི་ལ་␣ས་ ཏེ་ རྩ་ རླུང་ གི་ བྱ་ བྱེད་ལས་ གསུམ་ གྱི་ གནས་ཚུལ་ དང་"
msgstr ""
"In this [system], Karma is the circumstances of action, actor, karma of the "
"channels and winds, and "

msgctxt "d3a72d31519649a1bed91ab32e09863c"
msgid "འདུག་ ཚུལ་ འགའ་ཞིག་ ནི་ སྨན་ རྒྱུད་ ཟབ་པ་␣ར་ བཞེད་ དེ །"
msgstr "Some ways of staying are accepted as the profound medicine lineage."

msgctxt "9a5957310cd742f6bf801776554729d0"
msgid "སྔགས་རྒྱུད་ དུ་ སྦ་␣ས་ ཏེ་ གསལ་པོ་␣ར་ མ་ བསྟན་པ་"
msgstr "In the mantra lineage, it is hidden and not clearly taught."

msgctxt "8ae0ee8f96094da292b4506ec75f4fb0"
msgid "འདི་␣ར་ གསལ་བ་␣འི་ ཕྱིར་ ཡན་ལག་ བརྒྱད་པ་␣ར་ མཚོན་ ན་"
msgstr ""
"In this [system], to make them clear, if illustrated by the eight branches,"

msgctxt "f337ee7b20564793a7f73644f5702b5a"
msgid "དང་པོ་ ཆགས་པ་ དུག་ གསུམ་ ཤས་ གང་ ཆེ་␣འི་ ཚུལ་ དུ་"
msgstr ""
"The first is attachment, in the manner of whichever of the three poisons is "
"predominant, "

msgctxt "a1876b1ad2e344339070106862693d4a"
msgid "ཉེ་␣ས་ གསུམ་ པགས་པ་ དེ་"
msgstr "If the skins of the three faults are"

msgctxt "eedf6e01fe924ae0a5a6621342f11d77"
msgid ""
"རྣམ་པ་␣ར་ གྱུར་ ན་ སེལ་ ཐབས་ གང་ གི་ གཉེན་པོ་ གང་ཡིན་པ་ སྐྱོན་ དག་པ་ ཕན་བདེ་"
" སྐྱེད་པ་ དང༌ །"
msgstr ""
"changed, whatever the antidote of the method of elimination, will purify the"
" faults, and produce benefit and ease. "

msgctxt "ce2aa63f4f6a436e90316afd6823f38d"
msgid "རྩ་ འདི་ ལ་ རླུང་ འདི་ གནས་པ་ སོགས་ ཤིན་ཏུ་ གསལ་པོ་␣ར་ བསྟན་ ཅིང་ །"
msgstr "It is clearly taught which winds reside in which channels, and so on."

msgctxt "bae0809afaa346168eb0016e529e4776"
msgid "དེ་␣འང་ སངས་རྒྱས་ ཀྱི་ ཕྲིན་ལས་"
msgstr "Also, the enlightened activities of Buddhas,"

msgctxt "300b63441876491ebe32670b8dbcb0ba"
msgid "གསེར་འོད་ སོགས་ བཀའ་ ནས་ གསུངས་པ་"
msgstr "such as the golden light and so on are taught in the Buddha's words."

msgctxt "33dcad9825c54c2d94108f74a5d2d47b"
msgid ""
"རིགས་གསུམ་ སེམས་དཔའ་ དང་ སློབ་དཔོན་ ཀླུ་ གྲུབ་ སོགས་ ཀྱིས་ བཀྲལ་བ་␣འི་ དོན་ "
"ཡིན་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"This is because it is the meaning that is commented on by the three families"
" of bodhisattvas, the master Nagarjuna, and so forth."

msgctxt "9f6788262eb6495f91514038c0ae6eea"
msgid "རྡོ་␣༽༽  སྐྱབས་འགྲོ་ བདེན་ བཞི་␣འི་ ཆོས་འཁོར་ སྡེ་སྣོད་ འདུལ་བ །"
msgstr ""
"Vajra: Taking refuge, the Dharma wheel of the four truths, the Vinaya "
"Pitaka,"

msgctxt "232f100df4d6454c82c299a020e27027"
msgid "བསླབ་པ་ ཚུལ་ཁྲིམས །"
msgstr "the training of discipline,"

msgctxt "4c7ebe952df94c8f8b6879410b43fa87"
msgid "སྡོམ་པ་ སོ་ཐར །"
msgstr "the vows of individual emancipation, "

msgctxt "708a36e9fe624fdbad698387abac2a4a"
msgid ""
"སེམས་བསྐྱེད་ དོན་དམ་ རྒྱུད་ བླ་མེད་ དབང་ བཞི་པ་ གྲོལ་ ལམ་ རྫོགས་རིམ་ རྣམས་"
msgstr ""
"the generation of bodhicitta, the absolute tantra, the fourth highest "
"empowerment, the path of liberation, and the completion stage, are "

msgctxt "07f7f51e81a241cc9ed9d3c2c34d209b"
msgid "ཟབ་ ཅིང་ གཞན་པ་ མི་ ཟབ་པ་ འདོད་ མོད །"
msgstr "profound and it is also accepted that others are not profound."

msgctxt "22048e4f0fce49e394ebdd192194e9c1"
msgid "འདི་␣ར་ ནི་ གཞན་ གྱི་ མི་ ཟབ་པ་␣ར་ འདོད་པ་ དེ་ རྣམས་"
msgstr "In this [system], Those that are held to be not profound in others"

msgctxt "3f3745e54e384b438013180a6b05f9a7"
msgid "འདི་␣ར་ ཟབ་པ་␣ར་ བྱ་ སྟེ་"
msgstr "are profound here."

msgctxt "6491e06a3ce54c4fa63ae7b34f07a885"
msgid "དེ་དག་ མེད་ ན་ སངས་རྒྱས་་ པ་ ལྟ་ཅི་"
msgstr "Without these, not to mention becoming a buddha,"

msgctxt "a3dc2848f363414fac5b4e4937e9b58d"
msgid "ལམ་ གྱི་ ཡོན་ཏན་ ཡང་ ཐོབ་པ་␣ར་ མི་ ནུས་པ་␣འི་ ཕྱིར་"
msgstr "One cannot even attain the qualities of the path,"

msgctxt "9221ed83a7194d5b876a3c4f7318e724"
msgid "རྩ་བ་ དང་ དྲལ་བ་␣འི་ ཡལ་ འདབས་ བཞིན་ ནོ ། །"
msgstr "It's like a branch broken from the root."

msgctxt "d0ad14aff6d44a3890d1365540bc291e"
msgid "དེ་བས་ན་ སྐྱབས་ སུ་ འགྲོ་བ་ ཟབ་ སྟེ །"
msgstr "Therefore, going for refuge is profound because"

msgctxt "c066a83aa02c4ef5a73174f796d357bd"
msgid "ཆོས་ ཐམས་ཅད་ ཀྱི་ གཞི་མ་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr "It is the basis of all phenomena,"

msgctxt "2699a40a9c9248c3a12eafd8721d3d29"
msgid "དཔེར་ན་ འཁོར་ལོ་␣ས་ བསྒྱུར་ རྒྱལ་"
msgstr "For example, for a universal monarch"

msgctxt "b0d219eb4c2a4eb2a9a068052a46a92f"
msgid "འཇིག་རྟེན་ དུ་ འབྱུང་བ་ ལ་"
msgstr "to emerge in the world,"

msgctxt "48aa134fa3634bc7b6cd97299a1eedf0"
msgid "ཐོག་མ་␣ར་ དེ་␣འི་ རིགས་ སུ་ སྐྱེ་ དགོས་པ་ བཞིན་ ནོ ། །"
msgstr "First, [he] must be born into that family."

msgctxt "2b6b7df2e92548df8179196aa4b7069e"
msgid "དེ་␣འི་ འོག་ ཏུ་ བདེན་ བཞི་ དང་ འདུལ་བ་ སོགས་ ཟབ་པ་ ཡིན་ ཏེ །"
msgstr "Following that, the four truths, Vinaya, and so forth are profound."

msgctxt "d5812c2fa96e42a7971f8e29945ef07b"
msgid ""
"དེ་␣ས་ ཁྱད་པར་ གྱི་ ཆོས་འཁོར་ དང་ བཟོ་གནས་ དང་ ཡིག་རྩིས་ ལ་ བརྟེན་ དགོས་པ་ "
"བཞིན་ ནོ ། །"
msgstr ""
"Thus, one must rely on the special Dharma wheel, crafts,  reading, writing, "
"and arithmetic."

msgctxt "ff8d93afb9c0411ea8f5be8616fdb61d"
msgid "དེ་ལྟར་ ཡང་ རྗེ་ འཇིག་རྟེན་ མགོན་པོ་␣ས །"
msgstr "Likewise, Lord Jigten Gonpo says:"

msgctxt "a69eeff0d0d14bb6854faa70baa0e355"
msgid "གཞན་ གྱི་ ཆོག་ དབང་ གོང་མ་ ཟབ་ ཟེར་ ཡང༌ །"
msgstr ""
"Although the higher ritual empowerment of others is said to be more "
"profound,"

msgctxt "3885a81f95db497a8df43e29741431a7"
msgid "འམ་ བུ་ བུམ་ དབང་ ལ་ རྩི་ ཆོད་ ཆེ །"
msgstr ""

msgctxt "00be152549674bbb917b4f84301108ec"
msgid "གཞི་ དང་ སྣོད་ དང་ ལུས་ ལྟ་བུ ། །"
msgstr "Like the basis, the vessel, and the body."

msgctxt "7eb482e8a68d425084f7233064df41f3"
msgid "གཞན་ རྣམས་ དེ་ ཡི་ ཁྱད་པར་ ཆོས །"
msgstr "The others are the special features of it."

msgctxt "ce75ce2595cc4456a279eacbb557bf04"
msgid "ཞེས་ སོ ། །"
msgstr "As said."

msgctxt "30eec2fb0716448b80898db53dde3145"
msgid "གཞན་ ཡང་ བརྟག་ གཉིས་ ལ་␣ས །"
msgstr ""
"Furthermore, according to the two segments [of the Hevajra root tantra]:"

msgctxt "c5f2f84a7bc646dba72ac480d5aae92d"
msgid "དང་པོ་ གསོ་སྦྱོང་ སྦྱིན་པ་␣ར་ བྱ །"
msgstr "First, one must give the healing and purifying."

msgctxt "807dd05b3b53494e8c76c8380cdfc89d"
msgid "ཞེས་པ་ ནས །"
msgstr "And than. "

msgctxt "b971b9bbd6c248e7a4319bfcf18e0c5d"
msgid "དེ་ རྗེས་ ཀྱེ་ རྡོ་རྗེ་ བརྩམས །"
msgstr "And then compose the Hevajra [Tantra]."

msgctxt "e208422e954d4e32b6641fbb839c6e7d"
msgid "ཞེས་ སོ ། །"
msgstr "As said."

msgctxt "8b67ef1c0b7e4369ab83c87d14f74776"
msgid "རྡོ་␣༽༽  བཤད་ མ་ ཐག་པ་␣འི་ མི་ ཟབ་པ་ དེ་ རྣམས་"
msgstr "Vajra: All the non‑profound ones just explained"

msgctxt "81f60c1ce32e4c54ad8149c94f4d022a"
msgid "མི་ དགོས་པ་␣ར་ རྩ་ རླུང་ བསྒྲུབས་པ་␣ས་"
msgstr "[They] are not needed. By accomplishing the channels and winds, "

msgctxt "23deeaba21894cdfa76cec422bede8cd"
msgid "འགྲོས་ བཞི་ རིམ་པ་␣ར་ ཐིམ་པ་␣ས་"
msgstr "The four processes dissolve gradually,"

msgctxt "ffe1603b0e81454b90ff7944fe1d7a7d"
msgid "ས་བཅུ་␣འི་ བར་ བགྲོད་ དེ་"
msgstr "and by traversing up to the tenth level, "

msgctxt "4e15f6766e364c699c4d7a10dbf064b6"
msgid "འབྲས་བུ་ སྐུ་བཞི་ ཡེ་ཤེས་ ལྔ་ མངོན་དུ་ གྱུར་ ཏེ་"
msgstr "The resultant four bodies and five primordial wisdoms are actualized."

msgctxt "8550da1ef9da482bb12151b975f69f2c"
msgid "རྡོ་རྗེ་ འཆང་ གི་ གོ་འཕང་ ཐོབ་ ཟེར །"
msgstr "It is said that then one attains the achievement level of Vajradhara."

msgctxt "b337f8ffd5a845bd90922999f6805175"
msgid "འདི་␣ར་ མི་ ཟབ་པ་ དེ་ རྣམས་ མེད་ ན་"
msgstr "In this [system], If these non-profound ones are absent,"

msgctxt "597c185f1de444c8b07f69217b6f2fbe"
msgid "རྩ་ རླུང་ གི་ གདམས་པ་␣ས་ སངས་ མི་ རྒྱ་ སྟེ་"
msgstr ""
"one will not become a buddha through the instructions on the channels and "
"winds,"

msgctxt "d1924999279b47dbb3bd056f5d92f8d0"
msgid "རྟེན་གཞི་ མེད་པ་␣འི་ ཕྱིར །"
msgstr "because there is no basis for support."

msgctxt "9104458fe35a4371b9e32f5a1346a565"
msgid "དཔེར་ན་ འཁོར་ བསྒྱུར་ ཟས་ ལ་མ་ བརྟེན་ ན་ འཚོ་ མི་ ནུས་པ་ བཞིན་ ནོ ། །"
msgstr ""
"For example, if a universal monarch does not rely on food, he cannot "
"survive."

msgctxt "57a54e5dba4a4a78a08fe96b7f02bc95"
msgid "བརྩོན་འགྲུས་ ཅན་ མངོནཤེས་ དང་ རྫུ་འཕྲུལ་ རེ་ ཐོབ་པ་ སྲིད་ ཀྱང་ །"
msgstr ""
"Although those who are perseverant can attain some kind of clairvoyance and "
"miraculous powers,"

msgctxt "d4ad462dd1194162a02d7b09cbe2df28"
msgid "ཕྱི་རོལ་པ་ ལ་␣འང་ ཡོད་ དེ །"
msgstr "Even non-Buddhists also have this."

msgctxt "66bd0bebc69c4921af6d85a327764581"
msgid "དེ་␣འང་ འདོད་ཆགས་ དང་ བྲལ་ དགོས་པ་␣ས་"
msgstr "Since this must also be free from desire,"

msgctxt "11a9f4e0173b413eb62c8e374775e1bf"
msgid "དེང་སང་ དཀའ་བ་␣ར་ སྣང་ངོ་ །"
msgstr "It seems to be difficult these days."

msgctxt "6401cab0afb24f25a6096013c2c9c67d"
msgid ""
"ལྷན་␣༽༽  སྔགས་ ཀྱི་ ཉམས་ལེན་ ཐུན་ མིན་ རྩ་ རླུང་ གི་ གདམས་པ་ ཟབ་པ་␣ར་ འདོད་ "
"མོད །"
msgstr ""
"Addendum: Although it is accepted that the uncommon tantric practices are "
"the profound instructions on the channels and winds."

msgctxt "ad121dfbc1e44df28988e0a4d9f83658"
msgid "འདི་␣ར་ སྔགས་ གང་ གི་ གདམས་པ་␣འི་ གནད་ ལ་ འདུལ་བ་ ལྷག་པ་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], The Vinaya is superior in the key point of the "
"instructions of any mantra."

msgctxt "782f89d0dd8b4d5298cb324ad85ac94d"
msgid "སྒོ་གསུམ་ གྱི་ སྐྱོན་ བསྡམས་པ་␣ས་"
msgstr "By restraining the faults of the three doors,"

msgctxt "347314e3505c49b398d929811a60254a"
msgid "ལུས་ངག་ ཡིད་ གསུམ་ ལ་␣ས་ སུ་ རུང་ ཞིང་ །"
msgstr "Any of the body, speech, and mind become suitable."

msgctxt "88347cec4ffb4b1b890c2eab2cfa6ecb"
msgid "སྐྱོན་ ལུས་ རྩ་ ཡི་ མི་ ཚངས་སྤྱོད །"
msgstr "The faults of the body are the sexual misconduct of the channels,"

msgctxt "993accc7d4374368b47244f6d87ffe2a"
msgid "ངག་ རླུང་ གི་ རྫུན །"
msgstr "The lies of the winds in the speech,"

msgctxt "9ba0f16101504e48911334d62ded20aa"
msgid "ཡིད་ ཐིག་ལེ་␣འི་ བརྣབ་སེམས་ སོགས་ དག་ ཅིང་"
msgstr "the covetousness of the drops in the mind and so on are purified and"

msgctxt "a4f0fd2ce7eb4afaa1199c17100bb2fc"
msgid "ཡོན་ཏན་ དྭངས་མ་ འཕེལ་བ་␣ས་"
msgstr "the pure qualities increase."

msgctxt "2ed71ec0d012483d96da797b28504811"
msgid "འཁོར་ལོ་ བཞི་ གང་ སྟེ་ བསམ་གཏན་ བཞི་ དགེ་སྦྱོང་ གི་ འབྲས་བུ་ བཞི་"
msgstr ""
"After fulfilling the four wheels, the four meditative absorptions, the four "
"results of virtuous training, "

msgctxt "ace1f80e227c45aab2082a119a69302e"
msgid "མཐར་ཐུག་ སྟོབས་ སོགས་ ཀྱང་ འབྱུང་བ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "and finally, the strengths and so forth also arise."

msgctxt "3efa3eda1c384cc589f2f75513f968ab"
msgid "དེས་ན་ སྒོ་གསུམ་ མ་ དག་ ན་ དུག་ གསུམ་ གྱིས་ རྙོག་པ་␣ར་ འགྱུར་བ་␣ས་"
msgstr ""
"Therefore, if the three doors are not purified, they will be sullied by the "
"three poisons."

msgctxt "1570ebee8ff64c36a7a7693b50d71ffa"
msgid ""
"རྩ་ རླུང་ ཐིག་ལེ་ གསུམ་ ཀ་ སྡོམ་ བྱེད་ དགེ་སློང་ གི་ སྡོམ་སེམས་ བརྟན་པོ་␣ས་ "
"སྡོམ་པ་ སྟེ་"
msgstr ""
"the channels, winds, and drops are restrained by the firm vows of a monk."

msgctxt "875792da8f8d4c4b9b6496af5b66c5a3"
msgid "འཁོར་ལོ་ བཞི་ དང་ སྡེ་པ་ བཞི་ སྤྲད་པ་␣འི་ རྒྱུ་མཚན་ ཡང་ དེ་ ཡིན་ ནོ །"
msgstr ""
"This is the reason why the four wheels and the four schools are given."

msgctxt "6b8dc76623b64497a63f615f3650c259"
msgid "ལྷན་␣༽༽  ཀུན་གཞི་ བདེ་གཤེགས་ སྙིང་པོ་ དེ་"
msgstr "Addendum: the omni-base, the sugatagarbha,"

msgctxt "298d8019183247b2bcde44571a60e97f"
msgid ""
"ས་བཅུ་པ་␣ས་ ཀྱང་ མུན་ཁུང་ གི་ གླང་པོ་ ལྟར་ ཕྱོགས་ ཙམ་ ལས་མི་ རྟོགས་ ཏེ །"
msgstr ""
"Even those on the tenth level realize it just partially, like like an "
"elephant in the dark."

msgctxt "6d7f3cc0dd4d44cea9320c6e59992ee8"
msgid "སྤྲིན་ མཐོང་ མཁའ་ ལ་ ཉི་ བཞིན་"
msgstr "Like the sun in the sky when clouds are seen."

msgctxt "900873c5f09c47ecb09e740463b1e1b6"
msgid "འདི་␣ར་ ཁྱོད་ བློ་གྲོས་ ཅན་ བློ་མིག་ དག་པ་␣འི་ འཕགས་ རྣམས་ ཀྱིས་ ཀྱང་"
msgstr ""
"In this [system], even you! the intelligent noble ones with pure eyes of "
"intelligence, "

msgctxt "c4e2e92eaeac4d209878e93930f6db9f"
msgid "ཐམས་ཅད་ མཐོང་ མ་ ལགས །"
msgstr "do not see everything."

msgctxt "40413e68556a42b6a161caff6a58afb8"
msgid "ཞེས་པ་␣ས་ སྤྱི་␣འི་ བཞེད་པ་ དེ་ མཐུན་ ཡང་ །"
msgstr "Although this is in concordance with the general acceptance. "

msgctxt "17f69ea5f312480d953c3e49a7a9ff2b"
msgid "འདི་␣ར་ བླ་མ་ བྱིན་ རླབ་ དང་ ལྡན་པ་␣ས་"
msgstr "In this [system], Because gurus who possess blessing,"

msgctxt "a371456c61d9420eafdc2c89215b91f9"
msgid ""
"གདམས་ངག་ བསྟན་པ་␣འི་ དོན་ བརྩོན་འགྲུས་ ཀྱིས་ བསྒོམ་པ་␣འི་ མཐུ་␣ས་ ཀུན་གཞི་ "
"དེ་དུས་ རེ་འགའ་ གཞན་ དུ་ ཡང་ མཐོང་ སྟེ་"
msgstr ""
"The omni-base [consciousness] is seen at other times through the power of "
"meditating with diligence on the meaning of the instructions taught."

msgctxt "a1abe4b136d34e349c664b9d5548bcaa"
msgid "གོམ་པ་ གནད་ དུ་ སོང་བ་␣ས་"
msgstr "Because the meditation has reached the essential point,"

msgctxt "54ddd2f5b72e49439452f3d8b977bd7e"
msgid "ཁམས་ ནང་ དུ་ འདུས་ ཏེ་"
msgstr "The constituents are gathered inside,"

msgctxt "51ad654d0ae44e10b9a4d30b3cf6ad29"
msgid "ལུས་ ལ་ བག་ཆགས་ ཀྱི་ ས་བོན་ རྩ་མདུད་ དང་"
msgstr ""
"The seeds of latency are present in the body in the channel knots and "

msgctxt "8af4edd448684a54a4649084e5004253"
msgid "ཡི་གེ་␣ར་ གནས་པ་␣འི་ ངང་ རིག་ དྲུག་ གི་ ས་བོན་ རྣམས་ མཐོང་ །"
msgstr "The seeds of the six awarenesses are seen while abiding in syllables."

msgctxt "8412ea97fcf243a1ad1d78ae9a7f5f5a"
msgid "དེ་␣ར་ རླུང་ ཆུད་པ་␣ས་ རིགས་ དྲུག་པོ །"
msgstr "When the winds enter there, it is the six families."

msgctxt "51c6271235044448a97650152982d468"
msgid "དེ་ དང་ དེ་␣ར་ མཐོང་ དེ་ ཡུན་རིང་ དུ་ གོམ་པ་␣ས་"
msgstr "By seeing and habituating in them for a ling time,"

msgctxt "24339a276e2b4fcc8cf751e76b45092f"
msgid "ཕྱི་རོལ་ ཏུ་ རིག་ དྲུག་ གི་ དཀྱིལ་འཁོར་ ཡོད་པ་ དང༌ །"
msgstr "The existence of the external mandalas of the six families and"

msgctxt "0ecfff1741984502861a377b4b3eb20c"
msgid "ཕྱི་རོལ་ གྱི་ རྒྱུ་རྐྱེན་ གང་ ལ་␣ས་ གང་ འབྱུང་ ཕལ་ཆེར་ མཐོང་བ་␣ས་"
msgstr ""
"The most parts of what arises from the external causes and conditions are "
"seen."

msgctxt "3c7ffe3404af429a8a48947c2fb23420"
msgid "ཀུན་གཞི་␣འམ་ ཆོས་ཉིད་ བདེ་གཤེགས་ སྙིང་པོ་ མཐོང་བ་ སྟེ་"
msgstr ""
"The omni-base [consciousness] or the Dharmata sugatagarbha is seen because"

msgctxt "493cd6806b53418b8221b380ccf910d8"
msgid "ཆོས་ རྣམས་ ཀྱི་ རྟེན་འབྲེལ་ མངོན་དུ་ བྱས་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Because of the actualization of the interdependence of phenomena."

msgctxt "ded51f4729594d569a8f8496f7e13cc5"
msgid "དེ་␣འང་ ཀུན་གཞི་ ཉོན་ཡིད་ ཡིད་ཤེས་ སྒོ་ ལྔ་ དག་པ་␣ས་ ཆོས་དབྱིངས །"
msgstr ""
"Furthermore, the five doors of the afflicted mind of the omni-base are "
"purified."

msgctxt "54092f476fd64c7cb98f84af67452894"
msgid "མེ་ལོང་ དང་ མཉམ་ཉིད་ སོགས་ ཡེ་ཤེས་ ལྔ་ འབྱུང་ ཞིང༌ །"
msgstr "The five wisdoms such as the equality to mirror and so forth arise."

msgctxt "090a3eebb3544f168a4a02acf72d0226"
msgid "དེ་ལྟར་ ན་ ས་བཅུ་␣ས་ ཀྱང་ མི་ མཐོང་བ་ དང་ །"
msgstr "In this way, it is not even seen by the tenth level and"

msgctxt "32407f5982d3438a8c930d0faa530f5a"
msgid "ས་ བདུན་པ་␣ས་ མཐོང་བ་ དང་ །"
msgstr "It is seen by the seventh level and "

msgctxt "e54775429ed942969ab8a0c868de84b1"
msgid "ས་ དང་པོ་␣ས་ མཐོང༌ །"
msgstr "It is seen by the first level."

msgctxt "e30d17d8d0fb4e3d9282ac9760ea2e9c"
msgid "སོ་སྐྱེ་␣ས་ མཐོང་བ་␣འི་ ཀུན་གཞི་ སྟེ་ རྣམ་ གྲངས་ བྱེད་ དགོས །"
msgstr ""
"and the omni-base that is seen by the individualized beings should be "
"enumerated."

msgctxt "a7950a460c9c4576b7875609edecbe2d"
msgid "རྡོ  ༽༽  སྒོམ་ཆེན་པ་␣ས་ ཉམས་ སུ་ མྱོང་བ་"
msgstr "Vajra: That which is experienced by great meditators,"

msgctxt "21a6e5c7fab24e77a1a82241fa6bc73f"
msgid "བཀའ་ དང་ བསྟན་བཅོས་ གང་ ནས་ ཀྱང་ མ་ བཤད་པ་ ཞིག་ བྱུང་ ན་␣འང་ ཟབ་ ཟེར །"
msgstr ""
"If that is not explained in any of the Buddha-word or treatises, it is said "
"they are profound."

msgctxt "8ef2f038837b434b836a5700e5448b42"
msgid "འདི་␣ར་ བཀའ་ དང་ འགལ་བ་␣འི་ ཉམས་མྱོང་ བྱུང་བ་ ལོག་རྟོག་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], the experiences that contradict the Buddha-word are "
"mistaken conceptions."

msgctxt "94c711a00a994275b355ed1de66e48f0"
msgid "ཐམས་ཅད་ མཁྱེན་པ་␣འི་ གསུང་ དང་ འགལ་བ་␣འམ་"
msgstr "Because it contradicts the speeches of the omniscient one or "

msgctxt "eb0ee37a2e3440039e26e9937473ee7f"
msgid "མུ་སྟེགས་ ཀྱི་ ལམ་སྣ་ ཟིན་པ་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr "It is the beginning of holding the path of the tirthikas."

msgctxt "d244871e9366437aa2c06584eacf9bb8"
msgid "མུ་སྟེགས་ མངོན་ མཐའ་ འཇིག་པ་ དང་"
msgstr "Tirthikas' views of the destruction of the extreme perception and "

msgctxt "81f3a97ad4bf4addb09b8c5cc714eeb5"
msgid ""
"ཕྱི་མཐའ་ མི་ འཇིག་པ་␣ས་ མངོན་ཤེས་ ཀྱིས་ བརྟགས་པ་␣འི་ གྲུབ་མཐའ་ བཞིན་ ནོ ། །"
msgstr ""
"the non-destruction of the extreme outer world are like the philosophical "
"system that is imputed by higher perception."

msgctxt "0270341f55d247b780061e7c3e6ba667"
msgid ""
"མཁྱེན་པ་ དང་ བརྩེ་བ་ ཆེན་པོ་ སངས་རྒྱས་ ཀྱི་ གསུངས་ ལ་␣ས་ ལྡོགཔའི་ མྱོང་བ་"
msgstr ""
"The experience which contradicts the speeches of the Buddha, who is endowed "
"with great knowledge and love,"

msgctxt "eb573fbd703e4c58adf0b7290235b223"
msgid "དེ་ ནི་ འདུད་ ཀྱི་ ལ་␣ས་ ཡིན་པ་␣ས་"
msgstr "is the action of bowing."

msgctxt "63965e25013c42edb02b329d19a2d2a0"
msgid "ཡུམ་ དང་ གཙུག་ཏོར་ བམ་ དགུ་ ལ་␣ས་ གསུངས་པ་ བཞིན་ རིགས་པ་␣ར་ བྱ་␣འོ །"
msgstr ""
"It is proper, as stated in the Mother [Prajnaparamita Sutra] and Crown "
"Probuterance Ninth Volume."

msgctxt "40a0d759661b4a2a9f5bedd9cd1ea731"
msgid "རྡོ་␣༽༽  སྡེ་སྣོད་ རྒྱུད་སྡེ་ དྲང་དོན་ ངེས་དོན་ ཐ་དད་པ་␣ས་"
msgstr ""
"Vajra: It is said that since pitakas and tantra section, and the provisional"
" and definitive meanings are distinct,"

msgctxt "c8e1b9e5772b401a9584026e25eac7d3"
msgid "ལ་ལ་␣ར་ བཀག་པ་ ལ་ལ་␣ར་ གནང །"
msgstr "Some are prohibited, some are permitted,"

msgctxt "c8b893cc272443158ea229c6ee00eb74"
msgid "ལ་ལ་␣ར་ སྤང་བ་ ལ་ལ་␣ར་ སྒྲུབ་པ་␣ས་"
msgstr "some are abandoned, and some are accomplished. "

msgctxt "fd8c2cf373f94d29b3eb6bb9c9ddeb77"
msgid "ཕྱོགས་ རེ་␣ར་ མཐུན་པ་␣ས་ ཆོག་ ཟེར་བ་ དང་"
msgstr " it is sufficient to agree on some points and "

msgctxt "64d997cc0b384543bfcd596680226347"
msgid "འོག་མ་ གོང་མ་␣ར་ ཞུགས་ ནས་ དོར་ ཟེར །"
msgstr ""
"It is also said lower ones are to be discarded after entering the higher "
"ones."

msgctxt "48cc9e2b03394d73b39da12bc54bd3e4"
msgid "འདི་␣ར་ ནི་ དགོངས་པ་ ཐམས་ཅད་ འགལ་བ་ མེད་པ་␣ར་ ཤེས་པ་␣ར་ བྱ་ དགོས་ ཏེ་"
msgstr ""
"In this [system], one must understand that all intents are not "
"contradictory."

msgctxt "8ad201a88dc94ca4bac7672efdf21389"
msgid "ཆོས་ཕུང་ བརྒྱད་ ཁྲི་ ཉོན་མོངས་པ་␣འི་ གཉེན་པོ་␣ར་ གསུངས་པ་␣ས་"
msgstr ""
"The eighty thousand heaps of the Dharma were taught as antidotes to the "
"afflictive emotions"

msgctxt "a02d50c23a8442d0b00a0db3274f14a2"
msgid ""
"སྐྱོན་ སྤོང་ ཡོན་ཏན་ བསྒྲུབ་པ་ ལ་ ཐམས་ཅད་ ཉམས་ སུ་ ལེན་ དགོས་པ་␣འི་ ཕྱིར་ "
"དང་ །"
msgstr ""
"For, in order to abandon faults and accomplish good qualities, everything "
"must be practiced."

msgctxt "e2f21a4e08024d5084954095ed6530d4"
msgid "སྡོམ་ གསུམ་ དང་ ཕྱག་ ཆེན་ ཚུལ་ཁྲིམས་ གནད་ གཅིག་པ་␣འི་ ཕྱིར་ དང་"
msgstr ""
"The three vows and the moral discipline of mahamudra are essentially the "
"same."

msgctxt "c5205ede6f0043228205ec317141045b"
msgid "བརྗོད་བྱ་␣འི་ དོན་ ཡང་ གཅིག་ སྟེ་"
msgstr "The meanings of the subject matter are the same."

msgctxt "6f19b703eaa74fcba70226a6e06c0188"
msgid "ཟླ་ སྒྲོན་ ལ་␣ས །"
msgstr "According to the Moon Lamp [sutra]:"

msgctxt "2e79a86ece6d4fcdb1e50054d4596002"
msgid "ངས་ ནི་ མདོ་སྡེ་ གང་ བཤད་པ །"
msgstr "Whatever sutra section I have explained,"

msgctxt "73256efabd8f46e0b1894e550e32da65"
msgid "ཚིག་འབྲུ་ ཐ་དད་ དོན་ གཅིག་ སྟེ །"
msgstr "The words are different, but the meaning is the same."

msgctxt "f9f9367b2454445fb39d3deca736e009"
msgid "ཞེས་ དང༌ །"
msgstr "And"

msgctxt "729aa9d5f3ed448a8023c2aac31ba85f"
msgid "ཇོ་བོ་␣ས །"
msgstr "Jowo said:"

msgctxt "86b434dce6344735865514e30aa1964d"
msgid "ཆོས་ ཀྱི་ ཕུང་པོ་ བརྒྱད་ ཁྲི་ དང༌ ། །"
msgstr "The eighty thousand heaps of the Dharma and"

msgctxt "520f0c80cce442dcaf2ec59376d807e2"
msgid "བཞི་ སྟོང་ གསུང་པ་ གང་ཡིན་པ ། །"
msgstr "four thousand, whatever it is taught."

msgctxt "17995a55964c499fb477ef84bf3e2767"
msgid "ཆོས་ཉིད་ འདི་ ལ་ གཞོལ་ ཞིང་ འབབས །"
msgstr "Diligently engage and settle down in this Dharmata."

msgctxt "eca0abe541db49b2aee3359e96337826"
msgid "ཞེས་པ་␣ས་ མི་འགལ་བ་ བྱེད་ དགོས །"
msgstr "Thus, it must not contradict this."

msgctxt "4711434bb3e042df9e06b22f7bab4fed"
msgid ""
"རྡོ་␣༽༽  ཉམས་ སུ་ ལེན་པ་␣འི་ སྐྱོན་ཡོན་ ནི་ གདམས་ངག་ དམིགས་བསལ་ ཡིན་པ་␣ས་"
msgstr ""
"Vajra: The faults and good qualities of practice are the special oral "
"instructions."

msgctxt "626ceb22168c41bbb3fb23409af1d29f"
msgid "དེ་ ཁོ་ན་ཉིད་ ལྟར་ འབྱུང་ ཟེར །"
msgstr "It is said that they arise according to it."

msgctxt "6404b5cd60fd45ccbd1569eafb007982"
msgid ""
"འདི་␣ར་ ནི་ གདམས་ངག་ ལྟར་ མིན་པ་␣ར་ རྒྱལ་བ་ ཐམས་ཅད་ མཁྱེན་པ་␣འི་ བཀའ་ ལྟར་ "
"འོང་བ་␣ར་ བཞེད་ དེ་"
msgstr ""
"In this [system], it is accepted that it is not according to the oral "
"instructions, but it is according to the words of the omniscient conqueror."

msgctxt "15133c69706d452891742606082ff9e8"
msgid "རྒྱུ་འབྲས་ ཀྱི་ རྟེན་འབྲེལ་ ཐམས་ཅད་ མངོན་སུམ་ དུ་ གྱུར་པ་␣ས་"
msgstr ""
"All the interdependent relationships of causes and results are directly "
"perceived."

msgctxt "cda964ec7efd4b42bfd9dee23b540420"
msgid "གནད་ ཇི་ དང་ ཇི་ལྟ་བུ་␣ས་ ཡོན་ཏན་ བསྐྱེད་པ་ དང་"
msgstr "By the various essential points, good qualities are generated and "

msgctxt "5773cdec955c4716a6266fb7112f0bb0"
msgid ""
"སྐྱོན་ སྤོང་བ་ མཁྱེན་པ་␣ས་ བརྩེ་བ་ ཆེན་པོ་␣ས་ གདུལ་བྱ་ རྣམས་ ལ་ བསྟན་པ་␣འི་ "
"ཕྱིར་"
msgstr ""
"faults are abandoned, thus with his great knowledge and love, he taught to "
"the disciples."

msgctxt "786f449c406c450396bd0f90368620b5"
msgid "གསུང་རབ་ ནས་ གསུངས་པ་ དེ་བཞིན་ དུ་ འབྱུང་བ་ ཡིན་ ནོ ། །"
msgstr "This is how it occurs, just as said in the excellent speech."

msgctxt "4c64488c810b4f63ab4b5576e44ff2e8"
msgid "རྡོ་␣༽༽  རྟོག་པ་ ཕྲ་མོ་ ཙམ་ ཡང་ མི་ འགྱུ་བ་"
msgstr "Vajra: Not even the slightest conceptuality moves,"

msgctxt "85f36836e40f44478efb55ab4612c309"
msgid "མི་ རྟོག་ ལུས་ ལ་ གྲི་ རྒྱབ་ ཀྱང་ བདེ་བ་␣ར་ འོང་བ་"
msgstr "Bliss comes even by stabbing the body with non-conceptuality."

msgctxt "9fe9bc615c894aa38fff63d78968c3a1"
msgid "བདེ་བ་ ཕྱི་ ནང་ དང་ གང་ཟག་ ཁྱད་མེད་པ་ གསལ་བ་ སྟེ་"
msgstr ""
"The bliss is clear, without any distinction between outer and inner, or "
"between individuals."

msgctxt "f8c4a8367d524e25b748636b30097754"
msgid "ཏིང་ངེ་འཛིན་ དེ་ གསུམ་ སྐུ་གསུམ་ གྱི་ རྒྱུ་ ཡིན་པ་␣ར་ འདོད་ ཀྱང་ །"
msgstr ""
"These three meditative concentrations are accepted to be the cause of the "
"three bodies."

msgctxt "67b7b8838ab5491c9734d1e6dbc9a5c6"
msgid ""
"འདི་␣ར་ ནི་ སྐྱོན་མེད་པ་␣འི་ ཏིང་འཛིན་ དེ་ གསུམ་ ཁམས་ གསུམ་ འཁོར་བ་␣འི་ "
"རྒྱུ་␣འམ་ ས་བོན་ ཡིན་ ཏེ །"
msgstr ""
"In this [system], these three flawless meditative concentrations are the "
"causes or seeds of the three realms of cyclic existence."

msgctxt "7a93061c5b464532b5fc552debde882b"
msgid "བདེ་བ་␣ས་ འདོད་ཁམས །"
msgstr "The desire realm by bliss,"

msgctxt "89d00ed48c2344569d441962f49ad588"
msgid "གསལ་བ་␣ས་ གཟུགས་ཁམས །"
msgstr "The form realm by clarity,"

msgctxt "91e5d66c6e2f4bc2bf0248328802b853"
msgid "མི་ རྟོག་པ་␣ས་ གཟུགས་ མེད་ ཁམས་ སུ་ སྐྱེ་བ་␣འི་ ཕྱིར །"
msgstr "The formless realm by non-conceptuality."

msgctxt "cc42b2ee734444b081fe136b8ce4b8db"
msgid "ཨཱརྱ་ དེ་ཝ་␣ས །"
msgstr "Arya Dewa said:"

msgctxt "f453289ba9164dc082030cef303ec4a9"
msgid ""
"བསམ་གཏན་ ནགས་མེ་␣ས་ ཡང་ དང་ ཡང་ དུ་ ནི་ ཉོན་མོངས་ ཚང་ཚིང་ བསྲེག་པ་␣ར་ གྱུར་ "
"ན་ ཡང༌ ། །"
msgstr ""
"Even the forest fires of concentration burn up the thicket of afflictions "
"again and again."

msgctxt "b62e893c47d649b6b8c4d813847976b3"
msgid "བདག་ ལྟ་␣འི་ རྩ་བ་ བརྟན་པོ་ མ་ སྤངས་པ་␣ས ། །"
msgstr "Because the firm root of the view of a self has not been abandoned,"

msgctxt "b3dab9c1fdab420d9001e71592cdaf04"
msgid "ཆ་␣ར་ གྱིས་ བརླན་ བཞིན་ མོད་ ལ་ རབ་ཏུ་ སྐྱེ །"
msgstr "It grows instantly, like a plant moistened by rain."

msgctxt "2ab37fe7642f44d881bb583ff1d983ab"
msgid "ཞེས་ དང༌ །"
msgstr "And"

msgctxt "1dd566196bda4e51a19627b07673fbf2"
msgid "མགོན་པོ་ ཕག་མོ་ གྲུ་པ་␣ས་ ཀྱང༌ ། །"
msgstr "Lord Phagmo Drupa also said:"

msgctxt "a310f32c68fe4de6a39d3d15132b519a"
msgid "བདེ་ དང་ གསལ་བ་␣འི་ རྒྱ་མཚོ་ རུ ། །"
msgstr "In the ocean of bliss and clarity."

msgctxt "3e3a532e91be45478350d202801089aa"
msgid "ཞེན་ དང་ འཛིན་པ་␣འི་ ནོར་བུ་ གནས ། །"
msgstr "The jewel of clinging and grasping abides."

msgctxt "03666a5bc3da424eb90fde9968e3cdf3"
msgid "ནོར་བུ་ ལ་ མངོན་ཞེན་ སྐྱེ་ གྱུར་ ན ། །"
msgstr "If one is completely attached to the jewel,"

msgctxt "52b91d0a12e545f793e3660d45df59b0"
msgid "དུག་སྦྲུལ་ ལྟ་བུ་␣འི་ དམྱལ་་ སྲུང་ གིས ། །"
msgstr "The guardians of hell, like poisonous snakes,"

msgctxt "672cf41405ea4be5b0d935158fece978"
msgid "བདེ་བ་ ཆེན་པོ་␣འི་ སྲོག་ བཅད་ དེ་␣༑ ༑"
msgstr "It will take the life of great bliss and"

msgctxt "ee9192783c9543ad9b956c537e10180c"
msgid "ཉམ་ང་ ཆེན་པོ་␣འི་ གཡང་ ལ་ བསྐུར །"
msgstr "Throw them into the abyss of great fear."

msgctxt "120d4eb3b7cd4dc9bb8eabf8d53af51e"
msgid "ཞེས་པ་␣ས །"
msgstr "Thus,"

msgctxt "d898b65c33914d1cb8a3dc64cc593f2a"
msgid ""
"གསུམ་པོ་ དབྱེ་␣ར་ མེད་ ཆོས་དབྱིངས་ སུ་ རོ་ མཉམ་པ་ ཞིག་ དགོས་པ་␣ར་ སེམས་ ཤིང་"
" གཞན་ དུ་ སྐྱོན་མེད་ དུ་ བཤད་  ཀྱང་"
msgstr ""
"I think that these three are indivisible and of equal taste in the "
"dharmadhatu, even if it is explained as being without fault,"

msgctxt "d3ac7195e1214a8abfa6a03ce6642939"
msgid ""
"བདེ་ གསལ་ སོགས་ སོ་སོ་␣ར་ འཛིན་པ་␣འི་ རྟོག་པ་ ལས་མ་ འདས་པ་␣ར་ དགོངས་པ་ ཡིན་ "
"ནམ་ མཉམ་ མོ །"
msgstr ""
"I wonder if it is intended that it does not go beyond conceptuality that "
"apprehends bliss, clarity, and so forth as separate."

msgctxt "e352944010024670884cf9160ee326e0"
msgid "རྡོ་␣༽༽  དཀྱིལ་འཁོར་ གྱི་ འཁོར་ལོ་ བདེ་མཆོག་ ལྟ་བུ་␣ར་ མཚོན་ ན་"
msgstr ""
"Vajra: The illustration of the wheel of mandala, such as Cakrasamvara,"

msgctxt "dccc513036844c4cbbae6622e30521da"
msgid ""
"ལོངས་སྐུ་ ཡུམ་ ཆོས་སྐུ་ ཡུལ་ ཉེར་ བཞི་ གནས་པ་␣འི་ ཐུགས་ གསུང་ སྐུ་ ཡི་ "
"འཁོར་ལོ་ དཔའ་བོ་ མཁའ་འགྲོ་ སྒོ་མཚམས་ ཀྱི་ ལྷ་མོ་ དང་ བཅས་པ་ སྤྲུལ་སྐུ་ སྟེ་"
msgstr ""
"The sambhogakaya is the mother, the dharmakaya is the twenty-four objects "
"where the mind abides, the speech, the wheel of body, the heroes, dakinis, "
"and goddesses of the doors are the nirmanakaya."

msgctxt "bb50effddc5e46e6a823f615adbc755c"
msgid "དེ་ གསུམ་ ཐ་དད་ ཡིན་ ཟེར་ རོ །"
msgstr "It is said that they are distinct."

msgctxt "308ee389c1ee4dbbaa4e066f54c0d24c"
msgid "འདི་␣ར་ ནི་ སྐུ་གསུམ་པོ་ རེ་རེ་ ལ་ ཡང་ གཞན་ གཉིས་ཀ་ ཚང་ སྟེ་"
msgstr ""
"In this [system], each of the three bodies also completes the other two."

msgctxt "01240107b5b440a98aaea75ee13eb72c"
msgid "དཀྱིལ་འཁོར་ གྱི་ དུར་ཁྲོད་ བརྒྱད་ དང་ བཅས་པ་"
msgstr "The mandala with the eight charnel grounds"

msgctxt "dd62d9fa70384c0888fd2336bb913321"
msgid "རང་ གི་ ལུས་ ལ་ གནས་པ་ དེ་"
msgstr "is present in one’s body."

msgctxt "5eb90fabb99f414daf6f66a44f9f944b"
msgid "ལམ་ གྱིས་ བསྒོམ་པ་␣ས་ ཕུང་ ཁམས་ སྐྱེ་མཆེད་ རྣམ་པ་␣ར་ དག་པ་"
msgstr ""
"By meditating on this as the path, the aggregates, elements, and sense "
"sources are purified."

msgctxt "50009201a6bc4d168626862afab968fd"
msgid "དེ་␣འི་ འཁོར་ལོ་ ལ་ ཐ་དད་ མེད་པ་␣འི་ ཕྱིར་"
msgstr "Therefore, there is no distinction in the wheel."

msgctxt "abbf9017186249639bff3a609faf3dc4"
msgid "གསང་བ་ རྒྱ་མཚོ་ ལ་␣ས །"
msgstr "According to The Ocean of Secrets:"

msgctxt "704907dd8dd44ef393efff858964da32"
msgid "སྐུ་གསུམ་ ཡོངས་སུ་ གྲུབ་པ་ གསང་སྔགས་ ཐེག་པ་ སྟེ །"
msgstr ""
"The complete accomplishment of the three bodies is the vehicle of the secret"
" mantra."

msgctxt "e0015e2290d3481e9440317f0f685826"
msgid "སྐུ་གསུམ་ ཉིད་ ལ་ འཇུག་པ་ ལམ་ གྱི་ ཐེག་པ་ ཡིན ། །"
msgstr "The path vehicle is the entrance to the three bodies."

msgctxt "fe3de28f518549498b2a1307424fd46e"
msgid "སྐུ་གསུམ་ འདུ་ འབྲལ་ མེད་པ་ འབྲས་བུ་␣འི་ ཐེག་པ་␣འོ ། །"
msgstr "The three bodies without meeting and parting are the result vehicle."

msgctxt "672af578cf29407ebc1e178e034336e0"
msgid "ཞེས་ གསུངས་ སོ ། །"
msgstr "As it is said."

msgctxt "8ecdc9ed8dd54f75a8cecc49f8321365"
msgid ""
"རྡོ་␣༽༽  ཐུབ་དབང་ དང་ རྡོ་རྗེ་ འཆང་ གི་ བསྟན་པ་ མདོ་སྔགས་ གཉིས་ ཐ་དད་ "
"ཡིན་པ་␣ས་ སྔགས་ ལ་ ཚུལ་ཁྲིམས་ མི་ དགོས་ ཏེ །"
msgstr ""
"Vajra: The sutra and mantra teachings of the Lord of Sages and Vajradhara "
"are two distinct, thus there is no requirement for the moral disciple in the"
" mantra."

msgctxt "6be50b3959b14350bee1fc0b0bbefab4"
msgid "གསང་འདུས་ ལ་␣ས །"
msgstr "According to The Gathered Secret:"

msgctxt "7ac713141f2c4e5faaf51d1f1be73068"
msgid "འདོད་པ་␣འི་ ཡོན་ཏན་ རྣམ་ ལྔ་ ལ །།"
msgstr "On the five types of desirables, "

msgctxt "972b9e3c22c447019abf4fb7992a1dd9"
msgid "བརྟེན་ ནས་ མྱུར་ དུ་ འགྲུབ་པ་␣ར་ འགྱུར །"
msgstr "By relying on them, one will swiftly accomplish."

msgctxt "86ead4aa26114fbb8a1598e23511e68e"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "e5680ac8e66844cbb8110613fbe6fccc"
msgid "ཁྱོད་ ཀྱི་ སྲོག་ཆགས་ བསད་པ་␣ར་ བྱ །"
msgstr "Your living beings are being killed."

msgctxt "f5d14988462a4e1db5397fff53bf8561"
msgid "ཞེས་ སོགས་ གསུངས་པ་␣ས་ སོ་ ཟེར་ རོ །"
msgstr "And so on, it is said."

msgctxt "6258c4bc4ce747d19bb20e5d70043e78"
msgid "འདི་␣ར་ ནི་ གསང་སྔགས་ ལ་ ནི་ ཚུལ་ཁྲིམས་ མེད་ ཀ་མེད་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], moral discipline is indispensable in the secret mantra."

msgctxt "fa59e1b8b56f4222b0370aacdbfc2462"
msgid "ཚེ་ གཅིག་ རྡོ་རྗེ་ འཆང་ གི་ གོ་འཕང་ ཐོབ་པ་␣ར་ བྱེད་པ་ ལ་"
msgstr "To attain the achievement level of Vajradhara in one lifetime,"

msgctxt "8e0c1f0d47bd466ab3531014211d8f14"
msgid "སྐྱོན་ སྤོང་བ་ དང་ ཡོན་ཏན་ སྒྲུབ་ དགོས་ ཤིང་"
msgstr "One must abandon faults and accomplish good qualities."

msgctxt "bca0d11cfafb429d925dff5bc850adef"
msgid ""
"དེ་␣འང་ སྒོ་གསུམ་ ཉེས་པ་ ཕྲ་མོ་␣ས་ ཀྱང་ མི་ གོས་པ་␣ར་ བྱེད་ དགོས་པ་␣འི་ ཕྱིར"
" །"
msgstr ""
"Moreover, one must not be stained by even the smallest faults of body, "
"speech, and mind."

msgctxt "806c89680a1f46dcbc7fee00c6ac1bbc"
msgid "དུས་འཁོར་ ལ་␣ས །"
msgstr "According to the Kalachakra [Tantra]:"

msgctxt "6180d2d7c02843b681339d7f4bc27e07"
msgid "བསླབ་པ་ ལྔ་ ཡི་ གནས་ ལྡན་ ཞིང༌ ། །"
msgstr "The one who has the five trainings,"

msgctxt "b976ab844bfc459aa461aabf84214e55"
msgid "བྱང་ཆུབ་ སེམས་དཔ་␣འི་ སྡོམ་པ་ དང༌ ། །"
msgstr "The bodhisattva vows and "

msgctxt "f940990cb9ed43c797a1e6782b4b1010"
msgid "གསང་སྔགས་ དམ་ཚིག་ ལྡན་པ་ ནི ། །"
msgstr "The possession of the sacred commitment of the secret mantra are"

msgctxt "e5c3e0474f14460996f9847c75ce1e37"
msgid "དགེ་བསྙེན་ རྡོ་རྗེ་ འཛིན་པ་ ཡིན ། །"
msgstr "the layman Vajradhara."

msgctxt "f979017e81594906a310eb122683f259"
msgid "བསླབ་པ་ བཅུ་ ཡི་␣x"
msgstr "The ten main trainings..X"

msgctxt "6e09ffd6840948fb9dfd6956dbcd4284"
msgid "བྱང་ཆུབ་ སེམས་དཔ་␣འི་␣x"
msgstr "Bodhisattvas..X"

msgctxt "877c706cae0e4839b68ec07482e725c2"
msgid "གསང་སྔགས་␣x"
msgstr "The secret mantra.. X"

msgctxt "5b7a9498d53842c0ac876dd06903f17c"
msgid "དགེ་ཚུལ་␣x"
msgstr "Novice..X"

msgctxt "713b3e69140f41eca0af81f7b2bd5ed7"
msgid "བསླབ་པ་ བྱེ་བ་␣འི་␣x"
msgstr "Millions of training.. X"

msgctxt "2c586fca9a5640d0b922a08fa7646715"
msgid "བྱང་ཆུབ་␣x"
msgstr "Enlightenment..X"

msgctxt "d26a5bb229c84876a952566df8674c79"
msgid "གསང་སྔགས་␣x"
msgstr "The secret mantra..X"

msgctxt "efdf2074d8d84f03b98a510c0e6c4afa"
msgid "དགེ་སློང་ x"
msgstr "Monks..X"

msgctxt "39f9247854ec4fe296a8e01c8e0703d0"
msgid "ཅེས་ དང༌ །"
msgstr "And."

msgctxt "9f729203cf864feeac7b8fa6efdbbf9a"
msgid "དང་པོ་␣ར་ གསོ་སྦྱོང་ སྦྱིན་པ་␣ར་ བྱ །"
msgstr "First, perform the healing and purification."

msgctxt "f9dbefebb1fe46b19a60b3f8172c10a9"
msgid "ཞེས་པ་ ནས །"
msgstr "And than,"

msgctxt "9e035b02ae0b4ca2b66fb19da6abb6fb"
msgid "དེ་ རྗེས་ ཀྱེ་ རྡོ་རྗེ་ རྩམ །"
msgstr "And then compose the Hevajra [Tantra]."

msgctxt "2c38c3ed1d0f4eefa7602badc0262b66"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "2fb9d0e2ba0f43c3a0b88b2e458cad6a"
msgid "འཇམ་དཔལ་ རྩ་རྒྱུད་ ལ་␣ས ༑"
msgstr "According to the Manjushri Root Tantra:"

msgctxt "7af1e8387fa94b48bd51fa8ece516b00"
msgid "ཚུལ་ཁྲིམས་ འཆལ་བ་␣ས་ སྔགས་ མི་ འགྲུབ །"
msgstr "Mantra is not accomplished by losing moral discipline."

msgctxt "65a617c167cd4ffbac0f8bfb30bfdf3d"
msgid "ཅེས་ སོ ། །"
msgstr "As said."

msgctxt "7064db55b73d4a1d9c23cef30462f3b1"
msgid ""
"རྡོ་␣༽༽  སྔགས་ ནི་ འཇུག་ ལམ་ འབྲས་བུ་ བདེ་བ་␣ས་ འདོད་ཡོན་ སྤྱད་པ་␣ས་ གྲུབ་ "
"ཟེར །"
msgstr ""
"Vajra: Mantra is said to be accomplished by engaging in the sense pleasures "
"of the path of engagement and the blissful result."

msgctxt "083aafee06e045f2899a690bf6d3f4ae"
msgid "འདི་␣ར་ ནི་ འདོད་པ་␣ས་ བར་ དུ་ གཅོད་པ་␣འི་ སྟེང་ དུ་"
msgstr "In this [system], in addition to the hindrances created by desire,"

msgctxt "1f2a020716cb477d8212eb9bfbc36727"
msgid "མདོ་སྔགས་ གཉིས་ཀ་ གཅིག་པ་ ཡིན་ ཏེ་ མཚན་ཉིད་ དུ༌ །"
msgstr "Both sutra and tantra are the same as in the characteristic."

msgctxt "065eaaf1beb644b3a3013773582344dd"
msgid ""
"ཡུམ་ ལ་␣ས་ འདོད་པ་␣ས་ ནི་ ཚངས་པ་␣འི་ འཇིག་རྟེན་ དུ་ སྐྱེ་བ་ ལ་ ཡང་བ་␣ར་ དུ་ "
"གཅོད་ ན་"
msgstr ""
"According to the Mother [Prajnaparamita Sutra]: If desire hinders even to "
"rebirth in the world of Brahma,"

msgctxt "673c0272901741fe84db7b93c02d0da6"
msgid "མྱ་ངན་ ལ་␣ས་ འདས་པ་ ལ་␣ས་ ལྟ་ སྨོས་ ཀྱང་ ཅི་ དགོས་ ཞེས་ དང༌ །"
msgstr "It is needless to mention [its hindrance] to nirvana and "

msgctxt "a4dfe0c7f9cb467695e5630837a5fecb"
msgid "འདོད་པ་ རྣམས་ ནི་ དུག་ གི་ ལོ་མ་ ལྟ་བུ་␣འོ །"
msgstr "Desires are like poisonous leaves."

msgctxt "f91034107d4046beb833da18953e608d"
msgid "རལ་གྲི་␣འི་ སོ་ ལྟ་བུ་␣འོ ། །"
msgstr "It is like the edge of a sword."

msgctxt "0b8c4bb9a4b248168f12bec17f46f352"
msgid "མི་གཙང་བ་␣འི་ སྦུབས་ ལྟ་བུ་␣འོ ། །"
msgstr "It is like the inside of filth."

msgctxt "52372c644eef4bc2aa7d815004296385"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "9641c32f64924a6880cf5c122114f927"
msgid "སྔགས་ ལ་ ཚུལ་ཁྲིམས་ མེད་ ཐབས་མེད་པ་ བཤད་ མ་ ཐག་པ་ ཉིད་ ཀྱི་ ཕྱིར་ དང་"
msgstr ""
"This is because, as just explained, discipline is indispensable for the "
"mantra."

msgctxt "2a7faf0f256b4f359627bdd83f41e649"
msgid "བརྟག་པ་ གོང་མ་ ལ་␣ས །"
msgstr "According to the first segment:"

msgctxt "335894d639a140c4afef8d4ed9a76e06"
msgid "བཅོམ་ལྡན་ མ་ དག་པ་ གང་ ལགས །"
msgstr "The Blessed One, What are the impurities?"

msgctxt "d0954aed4cdc4c359240dbe5ed6e0827"
msgid "བཀའ་ རྩལ་པ་ གཟུགས་ ལ་སོགས་པ་ ལྔ་␣འོ ། །"
msgstr "The five, form, and so forth. [He] replied."

msgctxt "68b99cfb20734830b8e628b54d924b9f"
msgid "ཅི་ཕྱིར་ ཞུས་པ་␣ས །"
msgstr "When [he] was asked, “Why?” "

msgctxt "08e6eace7f884f138cab7092f651b76a"
msgid "གཟུགས་འཛིན་ གྱི་ ངོ་བོ་ ཡིན་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "This is because it is the essence of the apprehension of form."

msgctxt "87556de68b274048a9ba85040237c925"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "ff452906d4da46df9ba14da33c766d27"
msgid "དཀོན་ རྩེགས་ ལ་␣ས །"
msgstr "According to the Heap of Jewels:"

msgctxt "2c2187d5a91c421ca9b155cef0f7c2dd"
msgid "བར་ དུ་ གཅོད་པ་␣འི་ ཆོས་ གང་དག  །"
msgstr "All those phenomena that cause hindrances,"

msgctxt "4aa5f0f756354414bbee3a81d14a5da8"
msgid "སྐྱེ་བོ་ རྣམས་ ལ་ ངས་ བསྟན་པ ། །"
msgstr "I have taught this to people."

msgctxt "bb1b1739dbb34933b768a98c9e43b946"
msgid "དེ་ ཀུན་ ཡང་དག་ ཉིད་ དུ་ སྨྲ ། །"
msgstr "All of them are said genuinely,"

msgctxt "cb53a53da58d4e0ab1f694dae59c6529"
msgid "གཞན་ དུ་ གྱུར་པ་ ཡོད་ མ་ ཡིན ། །"
msgstr "There is nothing other than that."

msgctxt "a2e19ecd4c83438a8b1f7763d513d65b"
msgid "ཅེས་ སོ །"
msgstr "As said."

msgctxt "e26ecf3ced0b4af4b8167fd0c7e77572"
msgid "འདོད་པ་ བསྟེན་པ་␣ར་ གསུངས་པ་ ནི །"
msgstr "The statement that one should rely on desire means that"

msgctxt "288dcdf218bd4093a4dd64e239596a11"
msgid "གང་ཟག་ གཉེན་པོ་ སྟོབས་ དང་ ལྡན་ ན་"
msgstr "If a person has the power of the antidote,"

msgctxt "9b3f1e03e12a4b61a544e89212bb3437"
msgid "རྒྱུད་ ལ་ མི་ གོས་པ་ འདམས་ ཀྱི་ པདྨ་ བཞིན་ ཡིན་ ཀྱང༌ །"
msgstr ""
"[His or her] mindstream will not be covered [by stain], like a lotus in the "
"mud."

msgctxt "cecfb726261f4a8ab0c4a19ba7f38b34"
msgid "དེ་ མཚན་ཉིད་ ལ་␣ས་ ཤིན་ཏུ་ དཀའ་བ་␣ར་ སྣང་ངོ༌ ། །"
msgstr "This appears to be very difficult from characteristics. "

msgctxt "d0edd9da973d4017860c13f8a6dcb485"
msgid ""
"དེ་␣འི་ ཕྱིར་ རལ་གྲི་ དང་ འདྲ་བ་␣འི་ སྔགས་ འདི་ ཕུབ་ ལྟ་བུ་␣འི་ ཚུལ་ཁྲིམས་ "
"ལ་མ་ བརྟེན་ ན་ ཉམས་པ་ ཡིན་ ནོ །"
msgstr ""
"Therefore, if the sword-like mantra does not rely on the shield-like "
"discipline, it will deteriorate."

msgctxt "cdfae5ec296146d7b9880c368078c27a"
msgid ""
"རྡོ་␣༽༽  འདུལ་བ་ གཞི་ སྤོང་བ་ མཚན་ཉིད་ གཞི་ སྦྱོང་བ་ སྔགས་ གཞི་ བསྒྱུར་བ་ "
"སྟེའང་"
msgstr ""
"Vajra: The basis of the Vinaya is abandoning, the basis of the "
"characteristics is purifying, and the basis of the mantra is transforming."

msgctxt "df6c47363432465ca0fd9c5218d0a1e9"
msgid ""
"འདོད་ཆགས་ ལམ་ དུ་ བསྒྱུར་བ་ བདེ་བ་␣འི་ ཏིང་ངེ་འཛིན་ འབྲས་བུ་ ལོངས་སྐུ །"
msgstr ""
"The transformation of desire into the path is the blissful meditative "
"concentration, the result is sambhogakaya."

msgctxt "941576bfb89240b3856a76d784c49267"
msgid "ཞེ་སྡང་ དང་ གཏི་མུག་ ལམ་ དུ་ བསྒྱུར་བ་"
msgstr "The transformation of aversion and delusion into the path is"

msgctxt "fa0f46bc3acb442685a303b3b407733e"
msgid "གསལ་བ་ དང་ མི་ རྟོག་པ་␣འི་ ཏིང་ངེ་འཛིན་"
msgstr "The meditative stabilization of clarity and non-conceptuality,"

msgctxt "1d518a06c79e42aba5cca4c6b61feb3b"
msgid "འབྲས་བུ་ སྤྲུལ་སྐུ་ དང་ ཆོས་སྐུ་␣ར་ བསྒྱུར་བ་␣ས་"
msgstr "The results are nirmanakaya and dharmakaya."

msgctxt "e88dfd12583a4a6f934dc84fb9e6a8cb"
msgid "རྣམ་རྟོག་ ཡེ་ཤེས་ ཀྱི་ རོལ་པ་ ཡིན་ ཟེར །"
msgstr "It is said that discursive thoughts are the display of wisdom."

msgctxt "a5704f08345e4a0990a5ba2d888383de"
msgid ""
"འདི་␣ར་ ནི་ སྔགས་ ཀྱི་ ལམ་ གྱིས་ མི་དགེ་བ་ དགེ་བ་␣ར་ བསྒྱུར་བ་␣ར་ འདོད་ ན་"
msgstr ""
"In this [system], If it is accepted that non-virtue is transformed into "
"virtue through the path of mantra,"

msgctxt "74bc1ec62c98452280b9f86190b9132a"
msgid "འདི་␣ར་ འགྱུར་བ་␣འི་ སྐབས་མེད་ དེ་"
msgstr "In this [system], there is no occasion for transformation."

msgctxt "a205250949d04187ae669d3f9491a8e8"
msgid "གདོད་ ནས་ དཀྱིལ་འཁོར་ གྱི་ འཁོར་ལོ་ ཡིན་ ཀྱང་"
msgstr "Although it is the wheel of the mandala from the beginning,"

msgctxt "02ae720b819a432995a96955cb3bad02"
msgid ""
"གློ་བུར་ གྱི་ དྲི་མ་␣ས་ བསྒྲིབས་པ་ བསལ་བ་␣འམ་ སྦྱོང་པ་␣འི་ ལམ་པ་ ཡིན་པ་␣འི་ "
"ཕྱིར །"
msgstr ""
"It is a path of elimination or purification of what is obscured by "
"adventitious stains."

msgctxt "8e7b395b552244008e23db6b9f3e850e"
msgid "ཀྱེ་རྡོར་ ལ་␣ས །"
msgstr "According to the Hevajra [Tantra]:"

msgctxt "a20df0c320cc4d51a858a6e74c71442f"
msgid "སེམས་ཅན་ རྣམས་ སངས་རྒྱས་ ཏེ ། །"
msgstr "Sentient beings are buddhas,"

msgctxt "3dbab84f692b4df28e8ffa6570c4c252"
msgid "འོན་ཀྱང་ གློ་བུར་ དྲི་མ་␣ས་ བསྒྲིབས ། །"
msgstr "But this is obscured by adventitious stains."

msgctxt "d4dfa46cd1074ec295276f2c121396ea"
msgid "དེ་ཉིད་ བསལ་ ན་ སངས་རྒྱས་ ཉིད །"
msgstr ""
"When these stains are eliminated, then buddhahood itself is [revealed]."

msgctxt "2e893fecbb044322be984d0436d6aeb1"
msgid "ཅེས་པ་␣ས་ སྦྱོང་བ་␣འི་ ལམ་པ་ ཡིན་ ཅིང༌ །"
msgstr "Thus, this is the path of purification."

msgctxt "dc97d86d139045abac3d0312b5ccc4c2"
msgid "དེ་␣ར་ མ་ཟད་ མཚན་ཉིད་ དུའང་ ཕལ་ཆེན་ ལ་␣ས །"
msgstr ""
"Not only that, also in the definition, according to the Avatamsaka [Sutra]:"

msgctxt "d7fea16e758748ba8409214192c7030c"
msgid "སྟོང་གསུམ་ དར་ཡུག་ དང་ སྙིང་པོ་␣འི་ མདོ་␣ར་ དཔེ་ དགུ་␣ས་ བསྟན་པ་ སོགས་"
msgstr ""
"In the Sutra of The Three Thousand Silk Cloth and the Essence Sutra, it is "
"shown by nine examples and so forth,"

msgctxt "95919d5931de4ad499cf140ae7a8aa36"
msgid "སྤོང་བ་␣འི་ ལམ་པ་ མིན་ བསྒྱུར་བ་␣འི་ ལམ་ ཡིན་ ནོ ། །"
msgstr "It is not a path of abandonment, but a path of transformation."

msgctxt "57e7edfdeb71499398416422ee9845e6"
msgid "དེ་ལྟར་ མིན་པ་ བསྒྱུར་བ་␣འི་ ལམ་པ་ ཡིན་ ན་"
msgstr "Unlike that if it is the path of transformation,"

msgctxt "9e7b64fc12cc4ee088bc9cc98568c4a5"
msgid ""
"ཀུན་ ནས་ ཉོན་མོངས་ སོགས་ བདུད་ བཅོམ་ ཕྱིར་ བཅོམ་ལྡན་འདས་ ཞེས་ བྱ་ ཞེས་པ་ དང་"
msgstr ""
"This contradicts the statement that the Blessed One is so-called because he "
"has defeated the total afflictions and so forth."

msgctxt "4a0971a258b945f5a98976014b09116c"
msgid "འགལ་བ་ དང་ དུག་ གསུམ་ གཞི་མ་གྲུབ་པ་␣ས་ བསྒྱུར་བ་␣ས་ འགྱུར་ ན་"
msgstr ""
"Since the three poisons are not established, if it is changed by "
"transformation,"

msgctxt "fe13adc0c82545b6b6f4259c1e90f0e4"
msgid "མི་དགེ་ དགེ་བ་␣ར་ འགྱུར་ ཏེ་"
msgstr "Then the non-virtue would become virtue,"

msgctxt "e790bb78cff7460e9d76884574dc943c"
msgid "རྒྱུ་འབྲས་ ཀྱི་ བབ་ དང་ འགལ་བ་␣འི་ ཕྱིར་ སྤོང་བ་ ཡིན་ ན་␣འང་"
msgstr ""
"Therefore, it would contradict the condition of cause and effect. Even if it"
" were an abandonment, "

msgctxt "aede3544fbd54eaebf19558f8519a741"
msgid "སྙིང་པོ་ རྟག་པ་ དང་ འགལ་བ་␣འི་ ཕྱིར་"
msgstr "It would contradict the eternal essence."

msgctxt "4edceb925c464f8eb00636a6df593da4"
msgid "སྔགས་ སུ་ མི་འགྱུར་བ་␣ས་ སྦྱོང་བ་␣འི་ ལམ་པ་ ཡིན་ ནོ །"
msgstr "Since it does not change in mantra, it is the path of purification."

msgctxt "ab7bdd1769334f8bbe768b90ffaac777"
msgid ""
"རྡོ་␣༽༽  སྔགས་ སུ་ མི་དགེ་བ་ ཐབས་མཁས་པ་␣ས་ སྤྱད་པ་␣ས་ དགེ་བ་␣ར་ འགྱུར་ ཏེ་"
msgstr ""
"Vajra: It is said that non-virtue becomes virtue by being practiced with "
"skillful means in mantra."

msgctxt "8b96aefb0cc14a51aa0a91c6b3410cfb"
msgid "འདོད་ཆགས་ ཞེ་སྡང་ གཏི་མུག་ དང་ །"
msgstr "Attachment, aversion, delusion and"

msgctxt "c8d176c5fdae4557b94d4b4eb4419193"
msgid "ང་རྒྱལ་ ཕྲག་དོག་ མི་ སྤང་ ངོ་ ཞེས་ ཟེར་ རོ །"
msgstr "Pride and jealousy are not being abandoned."

msgctxt "181f036bc1bd425787c6e07b51739dc0"
msgid "འདི་␣ར་ ནི་ འདུལ་བ་␣ར་ མི་དགེ་བ་ བཀག་པ་"
msgstr "In this system, non-virtue is prohibited in the Vinaya, "

msgctxt "68f3a14aeb1e4608ac2759010029520c"
msgid "སྔགས་ སུ་␣འང་ མི་དགེ་ ཞིང་ སྤང་བྱ་ ཡིན་པ་␣ས་"
msgstr "Non-virtue is also an object of abandonment in the mantra."

msgctxt "4ac6371d928a417f900d941c6bdd2137"
msgid "དགེ་བ་␣ར་ མི་ འགྱུར་ ཏེ་"
msgstr "It will not become a virtue."

msgctxt "7aa78afa61834ea5a69a0d9e53c60785"
msgid ""
"སངས་རྒྱས་ ཀྱི་ གནས་ དང་ གནས་མིན་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ ཀྱི་ གཟིགས་པ་ དང་"
msgstr ""
"[What is] appropriate or inappropriate of Buddha, is seen by the omniscient "
"wisdom, and "

msgctxt "3896332cb2ca423caaf920a3916426d6"
msgid "ལམ་ གྱི་ གེགས་ དམ་བཅ་␣ས་པ་ ལ་"
msgstr "In the promise of the path of obstruction, "

msgctxt "5ee56f4f035c4fae9c10ba10796b9f15"
msgid ""
"ལྷ་ དང་ བཅས་པ་␣འི་ འཇིག་རྟེན་ ན་ སུ་␣ས་ ཀྱང་ རྒོལ་བ་ མེད་པ་␣འི་ ཕྱིར་ དང་"
msgstr ""
"This is because no one in the world can oppose including the gods and so on."

msgctxt "a38541fbf9a340c68aaf1cd18310df95"
msgid ""
"རྡོ་རྗེ་ འཆང་ གི་ རྒྱུད་ དཀྲུགས་ ལུང་ བཅུ་␣ས་ མན་ངག་ གབ་པ་ དང་ མཐའ་ དྲུག་ "
"ལ་␣ས་"
msgstr ""
"From the hidden foremost instruction by Vajradhara in the mixed tantras, the"
" ten transmissions, and the six extremes"

msgctxt "9f9cebb3022948f49aaf8f3aec7da58d"
msgid "དགོངས་པ་ ཅན་ དང་ སྒྲ་ ཇི་བཞིན་ མ་ཡིན་པ་ དང༌ །"
msgstr "The implied meaning and the words are not literal,"

msgctxt "82b76224dcf14f1aa85fa55f1d2940ed"
msgid "ཚུལ་བཞིན་ ལ་␣ས་ སྦས་དོན་ སྤྱི་ བཤད་ ཤས་ ཆེ་བ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"This is because most of the hidden meaning is explained suitably in general."

msgctxt "105e243f7b91419db6b78e38dd3ab249"
msgid ""
"དེ་ལྟར་ ཡང་གསང་ འདུས་ རིགས་བཞི་␣འི་ དམ་ཚིག་ གི་ སྲོག་ཆགས་ གསོད་པ་ སོགས་ "
"བཞི་␣འི་ དོན་"
msgstr ""
"Thus, the meaning of the four sacred commitments of the four families of "
"Guhyasamaja, such as not killing living beings, and so forth, is as follows."
" "

msgctxt "28a7df32bbc84ad1a5172002b26bcb59"
msgid "དགོངས༌པ་ ལུང་བསྟན་ དུ་ བཀྲལ་ ཏེ །"
msgstr "The intent is elucidated in the authoritative statements."

msgctxt "732b3ae6a94740b3b9dc3dedd4c14fec"
msgid "མ་ བྱིན་པ་ ལ་ བྱང་ཆུབ་ སེམས །"
msgstr "Bodhicitta to those who do not donate."

msgctxt "72bc0303f2d245af9f56e1b756fd215e"
msgid "ཀུན་རྫོབ་ སྟོན་པ་ རྫུན་སྨྲ་བ ། །"
msgstr "Teaching the relative and speaking falsehood,"

msgctxt "ca96e288e7ab43fd85e91c9f432fdc80"
msgid "ཕུང་པོ་ སྲོག་ཆགས་ གྱུར་པ་ སྟེ ། །"
msgstr "The aggregates become living beings."

msgctxt "c86b0f4343714440a3128182ed4d968c"
msgid "ཚངས་པ་␣འི་ གནས་ བཞི་ བུད་མེད་ ཡིན ། །"
msgstr "The four abodes of Brahma are women."

msgctxt "e011e0948da141b7b6b5cbddcefabd69"
msgid "དགོངས་པ་ ཡིས་ ནི་ བཤད་པ་ ལ ། །"
msgstr "To explain the intent,"

msgctxt "99285056b2254e31891466dd56b0a57d"
msgid "བྱིས་པ་ རྣམས་ ནི་ ཡི་ག་␣ར་ རྟོགས ། །"
msgstr "Children realize as they wish,"

msgctxt "7e5fd0e4b5d84f2ab02e49bdafd72df5"
msgid "རྗེ་ རྗེ་  ཐེག་པ་␣ར་ གནས་ འདོད་ ཀྱང་ ། །"
msgstr "Although one wishes to abide in the lordly vehicle,"

msgctxt "d952d646f8b042ba925f6e3682cca271"
msgid "ཆོས་ཉིད་ དེ་ ཡི་ ཡེ་ཤེས་ སོ ། །"
msgstr "This is the wisdom of the true nature of phenomena."

msgctxt "bfe1982b57c345af87329bef8773d669"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "c3e77f30caad4a81834667668de42545"
msgid "དགོངས་པ་␣འི་ ཚིག་ ལ་ རྨོངས་པ་ རྣམས ། །"
msgstr "Those who are ignorant about the words of the intent."

msgctxt "632b3bddd94747bb93025028a6266eb0"
msgid "གསུངས་པ་␣འི་ དོན་ འདི་ མ་ རྟོགས་ ནས ། ༑"
msgstr "Not realizing the meaning of this statement."

msgctxt "b1f0d0984b594a819d2911df4f8b6b0b"
msgid "གསུངས་པ་ འདི་ ལ་␣ས་ གཞན་ མིན་ ཞེས ། །"
msgstr "[They] said there is nothing other than this statement."

msgctxt "3a435484d181433e8d30e4584dcd43aa"
msgid "དེ་ནས་ ཇི་བཞིན་ སྨྲ་␣ར་ འཛིན་ ཏོ །"
msgstr "Then, they hold the speech as it is."

msgctxt "62c9dae679014901871a3bf9957cc7fb"
msgid "ཞེས་པ་␣ས་ དུག་ གསུམ་ འབྲེལ་བ་␣འི་ ལ་␣ས་ སྔགས་ སུ་␣འང་ མི་དགེ་བ་ ལ་"
msgstr ""
"This means that the actions associated with the three poisons are non-"
"virtuous even in the mantra,"

msgctxt "95c03fe5591f49ffa040eb13c9d6d2e4"
msgid "དེ་ མེད་ ན་ སྔགས་ སུ་␣འང་ དགེ་བ་ ཡིན་ ནོ །"
msgstr "If they are not, they are virtuous even in the mantra."

msgctxt "5f36f103a2ca41c8a67effb5818105e9"
msgid ""
"ལྷན་␣༽༽  གཞི་ སྡེ་སྣོད་ གསུམ་ ལམ་ སོ་ བྱང་ སོགས་ ཀྱི་ གང་ཟག་ དབང་པོ་ ཐ་མ་ "
"འབྲིང་ རབ་ གསུམ་ གྱིས་ བསླབས་པ་␣ས །"
msgstr ""
"Addendum: The basis is the three pitakas, the path of individual and "
"bodhisattva, and so on are studied by individuals of the least, medium, and "
"most capable faculties."

msgctxt "a1444c0936684457be16685944b7567d"
msgid "འབྲས་བུ་ ཞི་བདེ་ མི་ གནས་པ་␣འི་ མྱང་འདས །"
msgstr "The result is peaceful non-dwelling nirvana."

msgctxt "14fe6ad89b094678afd56199b183e8b4"
msgid "ཟུང་འཇུག་ བདེ་ཆེན་ གསུམ་ ཐོབ་ ཟེར །"
msgstr "It is said that the threefold great bliss of union is attained."

msgctxt "ad614c4446dd436e83802efa9593259d"
msgid "འདི་␣ར་ རྡོ་རྗེ་ ཐེག་པ་␣འི་ ལམ་རིམ་ གྱི་ བསླབ་པ་"
msgstr ""
"In this [system], The training in the stages of the path of the Vajra "
"Vehicle."

msgctxt "0ba821a356234998be9ea79e49282795"
msgid ""
"དེ་ གསུམ་ ཀ་␣འི་ གང་ཟག་ ཆོས་ འབྲས་བུ་ སོགས་ བཟང་ངན་ བསལ་ བཞག་ མེད་པ་␣ས་ "
"ཐམས་ཅད་ དགོས་ ཏེ །"
msgstr ""
"Since there is no distinction between good and bad individuals, dharma, "
"results, and so forth, all three are necessary."

msgctxt "3c9cdc13046e487a99a46d63babf8bd4"
msgid ""
"གང་ཟག་ གཅིག་ སངས་རྒྱས་པ་␣འི་ རྒྱུ་རྐྱེན་ ཐབས་ ཀྱི་ རིམ་པ་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr ""
"Therefore, these are the stages of the method and the causes and conditions "
"for one person to become a buddha."

msgctxt "d490c9f4738b4c3eb21762e1c2f81e1d"
msgid "དཔེར་ན་ རྒྱལ་པོ་ མཁས་པ་␣ས་ ཁྲིམས་ འཆའ་བ་ བཞིན་ ནོ ། །"
msgstr "It is like a wise king who establishes laws."

msgctxt "784be05a26aa48d69b0543e8e28b9d87"
msgid "དེ་ལྟར་ ཡང་ བརྟག་ གཉིས་ ལ་␣ས །"
msgstr "Likewise, according to the two segments [of the Hevajra root tantra]:"

msgctxt "1ddf1fff57d445168426a2db538027d5"
msgid "དང་པོ་ གསོ་སྦྱོང་ སྦྱིན་པ་␣ར་ བྱ །"
msgstr "First, one must give the healing and purifying."

msgctxt "27f85bbc16b64538a753031d2b55d5a9"
msgid "སོགས་ གསུངས་པ་␣ས །"
msgstr "And so forth. As it is said."

msgctxt "69f86934696f4d34813dca3134f49660"
msgid ""
"སྔགས་སྡོམ་ མན་ཆད་ ལ་ བསླབ་པ་ གསུམ་ ལམ་རིམ་ སྤྱི་ཁྱབ་ ཏུ་ དགོས་པ་ ཁོ་ན་ ཡིན་ "
"ནོ །"
msgstr ""
"The three trainings are only required in the general stages of the path "
"below the tantric vows."

msgctxt "9c52b8c017284ba1bfcc263f44958d84"
msgid "ལྷན་␣༽༽  སོ་ བྱང་ སྔགས་ གསུམ་ ལམ་ མི་ གཅིག་པ་ ཐ་དད་ ཡིན་ ཟེར་ ཡང༌ །"
msgstr ""
"Addendum: It is said that the paths of the three: solitary realizers, "
"bodhisattvas, and mantra practitioners are not the same but different."

msgctxt "3dbebde4bb9d4d6eba093bb0ee257ed5"
msgid ""
"འདི་␣ར་ ཕར་ཕྱིན་ དྲུག་ ནི་ མདོ་སྔགས་ ཀྱི་ ཐེག་པ་ གསུམ་ ཀ་␣འི་ ལམ་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], the six paramitas are the paths of all three vehicles, "
"sutra and tantra."

msgctxt "c4e8dfb3a94040de88673c6dc5d8f943"
msgid "ཚོགས་ གཉིས་ མ་ བརྟེན་པ་␣ར་ སངས་རྒྱས་པ་␣འི་ ཐབས་མེད་པ་␣འི་ ཕྱིར །"
msgstr ""
"This is because without relying on the two accumulations, there is no method"
" for attaining buddhahood."

msgctxt "6aba49b0569d430db2a705a884e0ef05"
msgid "དེ་␣འང་ དང་པོ་ གསུམ་"
msgstr "The first three are as follows:"

msgctxt "25fff27b2cef4b09bf6dc599f20a8111"
msgid "བསོད་ནམས་ ཐ་མ་ གཉིས་ ཡེ་ཤེས་ ཀྱི་ ཚོགས་ བརྩོན་འགྲུས་ གཉིས་ ཀྱི་ གྲོགས་"
msgstr ""
"The last two merits, the accumulation of wisdom, and the companion of the "
"two perseverances."

msgctxt "060340fc151842ccb0101514ba35fb32"
msgid "དཔལ་མགོན་ ཀླུ་སྒྲུབ་ ཀྱི་ དབུ་མ་ རིན་ཆེན་ ཕྲེང་བ་ ལ་␣ས །"
msgstr ""
"According to the Precious Garland by the glorious protector Nagarjuna:"

msgctxt "d8aa173af4084b47a5086e74da0217f8"
msgid "མདོར་ན་ སངས་རྒྱས་ བསྟན་ འདི་དག  །"
msgstr "In brief, these teachings of the Buddha are"

msgctxt "19796020477a4d29ab89be4cb31d2f1a"
msgid "ཕ་རོལ་ ཕྱིན་ དྲུག་ ཁོ་ན་ ཡོད །"
msgstr "exclusively the six perfections."

msgctxt "058de9334ecb4a2b82cd31a959f17299"
msgid "ཅེས་པ་ སོགས་ རྒྱ་ ཆེ་␣ར་ གསུངས་པ་␣ས་ ཤེས་ སོ །"
msgstr "And because of other extensive teachings, this can be known. "

msgctxt "cab2957ce68d47209c3e84e95200f037"
msgid "རྡོ་␣༽༽  ཉོན་མོངས་ སངས་རྒྱས་ ཀྱི་ གདུང་ དང་"
msgstr ""
"Vajra: It is said that the afflictions being the family line of the buddhas "
"as well as"

msgctxt "1cc4e0f957ee40d3b5f941b913638fcd"
msgid "རིགས་ སུ་ ཕར་ཕྱིན་ དང་ སྔགས་ གཉིས་ཀ་ ནས་ བཤད་ ཟེར་ རོ ། །"
msgstr "being the lineage is explained in both the paramitas and mantra."

msgctxt "ff71b8df6f584fafa22e2e5842494e66"
msgid "ཉོན་མོངས་པ་ དག་པ་␣འམ་ བྲལ་བ་␣འི་ འབྲས་བུ་ བདེ་བ་␣ར་ གཤེགས་པ་ ཉིད་ དེ་"
msgstr ""
"The result of purification or disconnection of the afflictions is the state "
"of sugata. "

msgctxt "60200c61d74f40989061f7799b149787"
msgid ""
"གཞི་ བསྒྱུར་བ་␣འི་ ལམ་པ་ མི་ སྲིད་པ་ གོང་ དུ་ བསྒྲུབས་ ཟིན་པ་␣འི་ ཕྱིར་"
msgstr ""
"The impossibility of the path being transformed into the basis has already "
"been proven above. "

msgctxt "1dbd34466f9d4ddb89786e4bb7361180"
msgid "ཀུན་ ཏུ་ ཁྭ་ ཀྱི་ རྒྱུད་ ལ་␣ས །"
msgstr ""

msgctxt "43f3537be4f84dfa87ad38229e8c86c4"
msgid "གཏི་མུག་ རྣམ་དག་ བསྒོམ་པ་ ཡི ། །"
msgstr "Meditating on the purity of delusion, "

msgctxt "50985280e97e4019a44a2cbf23b62965"
msgid "རྣམ་པ་␣ར་ སྣང་ མཛད་ ཉིད་ དུ་ འགྱུར ། །"
msgstr "One will become Vairochana himself."

msgctxt "b51dd053e47f46cc987c3c4ee34913fb"
msgid "ཞེ་སྡང་ རྣམ་དག་ བསྒོམ་པ་ ཡི ། །"
msgstr "Meditating on the purity of aversion,"

msgctxt "6219c6611a5d40dabd7896e021478cf9"
msgid "མི་བསྐྱོད་པ་ ནི་ ཉིད་ དུ་ འགྱུར ། །"
msgstr "One will become Akshobya himself."

msgctxt "8b02db2e335f4735ab12bfe75f24ff4e"
msgid "ཕྲག་དོག་ རྣམ་དག་ བསྒོམ་པ་ ཡི ། །"
msgstr "Meditating on the purity of jealousy,"

msgctxt "d3b6260cbc2e4cf2a5064ad2c13ff733"
msgid "དོན་ཡོད་ གྲུབ་པ་ ཉིད་ དུ་ འགྱུར ། །"
msgstr "One will become Amoghasiddhih himself."

msgctxt "5b18954bdbd24c569673571f9839eaae"
msgid "ང་རྒྱལ་ རྣམ་དག་ བསྒོམ་པ་ ཡི ། །"
msgstr "Meditating on the purity of pride,"

msgctxt "40acd9490a8f485cb0c8e9b06cdcaf3b"
msgid "རིན་ཆེན་ འབྱུང་ ལྡན་ ཉིད་ དུ་ འགྱུར །"
msgstr "One will become Ratnasambhava himself."

msgctxt "c2d4844424784234afe26cc404e5e947"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "c941b404d3464c8b86b6ef09a619b791"
msgid "མགོན་པོ་ འབྲི་གུང་པ་ ཆེན་པོ་␣ས །"
msgstr "The great lord Drigungpa said,"

msgctxt "58fdb27f729a4a5f94343ef6754be319"
msgid "དགྲ་གཉེན་ དུ་ ཆོད་པ་␣འི་ དཔའ་བོ་ དང་ ། །"
msgstr "The hero who has cut off enemies-relatives and"

msgctxt "8268b21333ff487e81fb2a4e510b7158"
msgid "གཉེན་ སྟོང་པ་␣ར་ རྟོགས་པ་␣འི་ མཁའ་འགྲོ་ གཉིས ། །"
msgstr "The dakini who realizes relatives as empty, both of them"

msgctxt "674c28114e514de6a2716ecf5e8e1d96"
msgid "སེམས་ འགྱུར་བ་ མེད་པ་␣འི་ རྣལ་འབྱོར་པ ། །"
msgstr "Are the yogins whose minds are unchanging."

msgctxt "b5aac06b87404b51aa9535f6296fd152"
msgid "དུས་རྒྱུན་ ཆད་ མེད་པ་ སྒོར་ རོ་ རོ ། །"
msgstr "[They] will be at the door uninterruptedly."

msgctxt "615ba872dd2e440189c28eef45b7b74a"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "335e85be524c43b2b066279252def131"
msgid "དཀོན་མཆོག་ སྤྲིན་ ལ་␣ས །"
msgstr "According to the Cloud of Jewels Sutra:"

msgctxt "ab9d2233a0344176b1da3effa70109e5"
msgid "སྲིད་པ་␣འི་ མྱ་ངན་ སྒྲོལ་བ་པོ ། །"
msgstr "The liberator from the misery of existence,"

msgctxt "31e14c3275af41fca92a0f2b842f9bf9"
msgid "ཉོན་མོངས་ བསྒྲལ་ ལ་ ཕྱག་ འཚལ་ ལོ ། །"
msgstr "Homage to you who liberate from afflictions."

msgctxt "87eae2666d8a4950a449e5914eea8a89"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "539b2f6a55c84301a3932cbad48342d5"
msgid "བྱང་ཆུབ་ སྙིང་པོ་␣ར་ བཞུགས་པ་ ན ། །"
msgstr "When [he] was seated at the essence of enlightenment."

msgctxt "fdc7126f031148948f65b8742fcfaf32"
msgid "འདོད་ཆགས་ ཞེ་སྡང་ གཏི་མུག་ དང་ ། །"
msgstr "Attachment, aversion, delusion and"

msgctxt "06207337d42e41f48a8fe1945c924169"
msgid "དྲི་མ་ གཞན་ ཡང་ རྣམ་ མང་པོ ། །"
msgstr "There are many other kinds of stains."

msgctxt "b9da5dc7903e480ba695cbbd986561dc"
msgid "ཁྱོད་ ཀྱི་ ཡེ་ཤེས་ མེ་ ཡིས་ བསྲེགས །"
msgstr "They are burnt by your flaming wisdom."

msgctxt "799ef2d1d3894abfb2e27ac839f296ea"
msgid "ཞེས་པ་␣ས་"
msgstr "Thus,"

msgctxt "2ce9cfd5e1e64585ae586f38277077be"
msgid "དུག་ གསུམ་ སྦྱོང་བྱེད་ ལམ་ གྱིས་ སྦྱངས་པ་␣ས་"
msgstr "The purifier of the three poisons is the path that purifies them, "

msgctxt "7999678031d24c1da77b3317f4567c06"
msgid "བྲལ་འབྲས་ སྐུ་ དང་ ཡེ་ཤེས་ མཛད་ ཕྲིན་ རྒྱ་མཚོ་ ལྟ་བུ་ འབྱུང་བ་␣ས་"
msgstr ""
"The disconnection results, bodies, and wisdom, enlightened activities occur "
"like the ocean."

msgctxt "a5c518f90505437c93e528625a3a20ea"
msgid "རིགས་ དང་ གདུངས་ ཞེས་ གསུངས་ སོ ། །"
msgstr "Therefore, it is called family and lineage."

msgctxt "6a8918494ad841f190b548361f57e493"
msgid "གཞན་ དུ་ ཉོན་མོངས་ ཉིད་ མ་ སྦྱངས་ ན་"
msgstr "Otherwise, if the afflictions themselves are not purified,"

msgctxt "88986de0e17143c194cba1b856976837"
msgid ""
"སངས་རྒྱས་ ཀྱི་ གདུང་ དུ་ ལྟ་ཅི་ མཐོ་རིས་ ཀྱི་ གདུང་ དུའང་ མི་ འགྱུར་ ཏེ །"
msgstr ""
"Let alone being a family line of buddhas, one will not even become a family "
"line of the higher levels."

msgctxt "c48a70ba0c7b4c88b9ba9a29a3361219"
msgid "ངན་སོང་ གི་ གདུང་ ཡིན་པ་␣ས་ སོ །"
msgstr "This is the family line of the bad migrations."

msgctxt "0147ee199d054104a092727a08beea43"
msgid ""
"ལྷན་␣༽༽  དུག་ གསུམ་ གྱིས་ རིམ་བ་ ཞིག་ རྩ་ རླུང་ ཐིག་ལེ་ གསུམ་ མ་ དག་པ་␣ས་"
msgstr ""
"Addendum: It is said that the three poisons destroy the stages because the "
"channels, winds, and drops are impure,"

msgctxt "14dbfd5981ba482ba99ff93780947984"
msgid "དག་པ་␣ར་ བྱེད་ དགོས་ ཟེར་བ་␣ས་"
msgstr "Thus they are needed to be purified. "

msgctxt "a2f6b15e3f664815b26bd603b3ec0405"
msgid "དེ་ ངེད་ དང་ མཐུན་ ཀྱང་"
msgstr "Although this accords with us,"

msgctxt "d06ce8e4b3234683a483ecce6fd8b424"
msgid "འདི་␣ར་ རྩ་ རླུང་ ཐིག་ལེ་ ནི་ སྙིགས་མ་ སྟེ་ དྲུག་ དང་ བཅས་པ་"
msgstr ""
"In this [system], the channels, winds, and drops are associated with six "
"degenertions."

msgctxt "24e315cbe3634cef89a06d79176ad5fe"
msgid ""
"དེ་ ཟབ་ སྟེ་ རྩ་ རླུང་ མ་ དག་པ་␣འི་ གང་ཟག་ ལ་␣ས་ དག་པ་␣འི་ སྐུ་ དང་ ཡེ་ཤེས་ "
"འབྱུང་ ཞིང༌ །"
msgstr ""
"This is profound because the bodies and wisdom occur to those persons with "
"pure channels, winds, and drops."

msgctxt "658a51175aad48f1be8e8f565d419c77"
msgid "གཞན་ དུ་ ན་ དག་ རྒྱུ་␣འི་ དེ་ གསུམ་ མེད་ ན་"
msgstr "Otherwise, if these three causes of purification are not present."

msgctxt "75cabc19ef054dd49e4e1d2080fff802"
msgid "དག་པ་␣འི་ འབྲས་བུ་ མི་ འབྱུང་ སྟེ་"
msgstr "The results of purification will not occur."

msgctxt "9b9cca2f9b9e420d9c48388c52e1666d"
msgid "རྒྱུ་ མེད་པ་␣འི་ འབྲས་བུ་ བཞིན་ ནོ ། །"
msgstr "It is like a result without a cause."

msgctxt "43ebfa5255f14e239477e18def5d651d"
msgid "དེ་ལྟར་ ཡང་ འོད་སྲུང་ གིས་ ཞུས་པ་ ལ་␣ས །"
msgstr "Likewise, according to the requisition by Kashyapa:"

msgctxt "b7ecfe460f1e46d792e580d82e0adbfa"
msgid "ཇི་ལྟར་ གྲོང་ཁྱེར་ དབུས་ ཀྱི་ མི་གཙང་ ལུད ། །"
msgstr "Just like the unclean manure in the middle of the city,"

msgctxt "8428f457e256421c8724b0d07e5e7633"
msgid "དེ་ ནི་ བུ་རམ་ཤིང་པ་␣འི་ ཞིང་ ལ་ ཕན ། །"
msgstr "That benefits the field of sugarcane."

msgctxt "54ce2c9ea1d2401dba5f10199c970986"
msgid "དེ་བཞིན་ བྱང་ཆུབ་ སེམས་དཔ་␣འི་ ཉོན་མོངས་ ལུད ། །"
msgstr "Likewise the manure of the afflictions of the bodhisattva,"

msgctxt "a842a49fbefa434bbaa97596d1a1049a"
msgid "རྒྱལ་ དང་ རྒྱལ་བ་␣འི་ ཆོས་ ལ་ ཕན་པ་␣ར་ བྱེད །"
msgstr "That benefits the conquerors and their dharma."

msgctxt "782e821fccf0455a8a11fb404c7ed9ff"
msgid ""
"ཅེས་པ་ བཞིན་ རྩ་ རླུང་ ཐིག་ལེ་ མ་ དག་པ་ འདམ་རྫབ་ དང་ འདྲ་བ་ དེ་ རྒྱུ་ བྱས་"
msgstr ""
"Thus, the impure channels, winds, and drops are like a foul swamp that acts "
"as the cause, "

msgctxt "2c0ec44ed80544d0b1d5ca426c714093"
msgid "རྐྱེན་ བླ་མ་ དམ་པ་␣འི་ གདམས་ངག་ ལ་ བརྟེན་ ནས་"
msgstr "By relying on the instructions of a holy guru as the condition,"

msgctxt "83aa508b5041421bb520ff0b7baf14b2"
msgid "བརྩོན་འགྲུས་ བརྩམས་པ་␣ས་ དག་པ་ ཐོབ་པ་␣ར་ འགྱུར་ རོ་␣༑ ༑"
msgstr "By perseverance, one will attain purity."

msgctxt "3dffd202a6a04b23a91a2b3c82febc48"
msgid "མ་ དག་པ་ དེ་ སེམས་ཅན་ ཐམས་ཅད་ ལ་ ཡོད་ ཀྱང་"
msgstr "Although, this impurity is present in all sentient beings,"

msgctxt "b59cd22c4dfd43389ce1525374f101e2"
msgid "རྐྱེན་ མ་ཚང་ བས་ དེ་ལྟར་ མི་ འགྱུར་ ཏེ །"
msgstr "Because of incomplete conditions, it does not become like that."

msgctxt "ddd996e0f8b14721b9e7610bdd838f6b"
msgid "རྩོལ་བ་ མ་ བྱས་པ་␣འི་ གསེར་རྡོ་ བཞིན་ ནོ །"
msgstr "It is like gold ore without making any effort."

msgctxt "e96519f2f05e444d8cbfafd9a520f179"
msgid ""
"རྡོ་␣༽༽  སྔགས་ ཀྱི་ མངོན་སྤྱོད་ ཀྱིས་ གདུག་པ་ ཅན་ སྒྲོལ་ དགོས་པ་␣ར་ གསུངས་པ་"
" སྒྲ་ ཇི་བཞིན་པ་ ཡིན་པ་␣ས་"
msgstr ""
"Vajra: The statement that malevolent ones must be liberated through the "
"mantra's wrathful [ritual] activity is literal."

msgctxt "34ec600f7c30429eb95f496e94059d31"
msgid "ཉེས་པ་␣ར་ མི་འགྱུར་བ་␣ས་ གནང་ བར་ འདོད་ དོ །"
msgstr ""
"Since this would not become a fault, thus it is accepted as permitted."

msgctxt "291411951b984d5b8ae8a4dc691c9802"
msgid "འདི་␣ར་ ནི་ སྔགས་ ཀྱི་ མཐུ་␣འམ་ ནུས་པ་ བསྟན་ ཙམ་ ལ་␣ས་"
msgstr ""
"In this [system], apart from merely teaching the power or capability of the "
"mantra, "

msgctxt "46dbe779c3e34fc7a5c7425e88dd8510"
msgid "མངོན་སྤྱོད་ དངོས་ སུ་ གནང་བ་ མེད་ དེ་"
msgstr "The actual wrathful [ritual] activity is not permitted because"

msgctxt "13959541a2e7420cad96d721af145234"
msgid "སྦྱོར་བ་ ཞེ་སྡང་ ཡིན་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "the preparative step is aversion and "

msgctxt "586d2e4eab99447186d41f638a197fbc"
msgid "དེ་ གནས་ དང་ གནས་མིན་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ དང་"
msgstr ""
"That [which is] appropriate or inappropriate of the omniscient wisdom, and "

msgctxt "5d41e9370b024b1294b41f863ac22a1b"
msgid "མི་ འཇིགས་པ་ དམ་བཅ་␣ས་པ་ དང་ ། །  འགལ་བ་␣འི་ ཕྱིར་"
msgstr "The assurance of fearlessness. This would contradict. "

msgctxt "d2bcfae03e93463bb1358b933445a9ba"
msgid "འཇམ་དཔལ་ རྩ་རྒྱུད་ ལ་␣ས །"
msgstr "According to The Manjushri Root Tantra:"

msgctxt "5ac6a7d75cee4f7cb155f77a1de71096"
msgid ""
"བྲམ་ཟེ་ ཙ་ ནག་ སྐྱ་ གཤིན་རྗེ་␣འི་ ཤེད་ ཀྱི་ རྣལ་འབྱོར་པ་ ཞིག་ རྒྱལ་པོ་ "
"ཟླ་བ་␣ས་ བླ་མཆོད་ དུ་ བྱས་ ནས་"
msgstr ""
"The brahman Tsanagkya, a yogin of the Lord of the Dead, acted as King Dawa's"
" lama in charge of offerings and worship."

msgctxt "20e78d2eda094a79a29743bba0752fd9"
msgid "མངོན་སྤྱོད་ ཀྱིས་ དགྲ་ མང་པོ་ བསད་པ་␣ས་"
msgstr "[He] killed many enemies by the wrathful [ritual] activities."

msgctxt "d42741e85743496fa06b471f08545837"
msgid "ལྷ་ དེ་ ཡི་ གཟུགས་ བཟུང་ ནས་ དམྱལ་བ་␣ར་ སྐྱེ་བ་␣ར་ གསུངས་ ན །"
msgstr ""
"It is said that he held the form of that deity and was reborn in hell."

msgctxt "85b5615f093742f9aa06f38be03eba09"
msgid "གཙང་ བཙན་ དང་ པེ་ ཧར་ སོགས་ ལ་ རྟེན་ ནས་་"
msgstr "With the support of Tsang Tsan and Pehar and so on,"

msgctxt "6d7536d131884ed1a88edd0005ed6d5c"
msgid "སྲོག་གཅོད་པ་ ངན་སོང་ དུ་ སྐྱེ་བ་ ལྟ་ སྨོས་ ཀྱང་ ཅི་ དགོས །"
msgstr ""
"It is needless to mention that taking life leads to rebirth in the bad "
"migrations."

msgctxt "7f3b043aa2d74041beb80e159d274ac9"
msgid "འོ་ན་ མ་ གནང་ ངམ་ ཞེ་ན །"
msgstr "Well then, was it not permitted?"

msgctxt "f67c3e83ba3e420eac97481e53c0349e"
msgid "བསད་པ་ དག་ གསོ་ ནུས་པ་ རྣམ་ཤེས་ སྤར་ ནུས་པ་"
msgstr ""
"The capability to purely restore the dead and the capability to elevate "
"consciousness."

msgctxt "73d0cd2ac8584ee2bf42ae8792d18718"
msgid ""
"ཆོས་ ཀུན་ མཉམ་ཉིད་ དུ་ རྟོགས་པ་ ཇོ་བོ་ རྗེ་ དང༌ །  རྗེ་བཙུན་ མི་ལ །  "
"སློབ་ དཔོན་ པདྨ་ ལྟ་བུ་ ཞིག་ གི་ མཛད་པ་ སྟེ་"
msgstr ""
"This is the deed of one who realizes the equality of all phenomena such as "
"the noble lord Atisha, Jetsun Milarepa, and master Padmasambhava."

msgctxt "9a047f7d5a9c4a3f8da21ea91c47ca59"
msgid "གཤིན་རྗེ་ མེ་ རུ་ རྩེ་␣འི་ རྒྱུད་ ལ་␣ས །"
msgstr "According to the Yamataka Fire Peak Tantra:"

msgctxt "f065cf8cb0da433caa6cea3ca7ce0b7b"
msgid "རང་རིག་ གསལ་བ་␣འི་ ཐུགས་རྗེ་ ཡི ། །"
msgstr "With the compassion of self-awareness and clarity,"

msgctxt "f114a35c3fa145769d77f594d4a24fe4"
msgid "ཉོན་མོངས་ བསྒྲལ་བ་ མ་གཏོགས་པ ། །"
msgstr "Besides liberating the afflictions,"

msgctxt "6d34930b899c4e7698c71becbbae8558"
msgid "ཞེ་སྡང་ གདུག་པ་␣འི་ སེམས་ ཀྱིས་ སྒྲོལ ། །"
msgstr "If liberated by the harmful mind of anger,"

msgctxt "321789ff05c740e8bdf2d401feac94b9"
msgid "དམྱལ་བ་␣འི་ སྐྱེ་བ་ མནར་མེད་ ལེན །"
msgstr "Will take rebirth in the Unending Torment Hell."

msgctxt "1895f752230148d8b4efdc4d47fed211"
msgid "ཅེས་ སོ །༑"
msgstr "As said."

msgctxt "453ddc0a37a94f9887e49dd6a712dc1e"
msgid ""
"རྡོ་␣༽༽  རྡོ་རྗེ་␣འི་ དམྱལ་བ་ ནི་ རྒྱུ་␣འི་ ཐེག་པ་␣ར་ བཤད་པ་␣འི་ བཅོ་བརྒྱད་ "
"ལ་␣ས་ གུད་ ན་ སྡུག་བསྔལ་  ལག་པ་␣ར་ ཆེ་བ་ ཞིག་ ཡོད་ ཟེར །"
msgstr ""
"Vajra: It is said that the Vajra Hell when declines from the eighteen hells "
"as explained in the causal vehicle, there is greater suffering."

msgctxt "03c7a3c69da84dc89c355294e8196a04"
msgid "འདི་␣ར་ ནི་ དེ་ ལ་ ལོགས་ སུ་ མེད་ དེ་"
msgstr "In this [system], there is no hell apart from these "

msgctxt "b5bf34dccaf647d1b64b084288855985"
msgid "མནར་མེད་ ལ་སོགས་ བཅོ་བརྒྱད་ དེ་ རྣམས་ ཡིན་ ཏེ་"
msgstr "eighteen hells, the Unending Torment Hell, and so forth."

msgctxt "62afeee337f542b5a29f42f572e4db49"
msgid "མི་གཡོ་བ་␣འི་ རྟོགས་པ་ དང་ བླ་མ་ ལྔ་ བཅུ་པ་ ལ་␣ས །"
msgstr ""
"According to the realization of the Unwavering [level] and the Fifty Verses "
"of Guru [Devotion]:"

msgctxt "ded25553894d4c619a99b653dad574c9"
msgid "མནར་མེད་ ལ་སོགས་ འཇིགས་རུང་བ་␣འི ། །"
msgstr "The terrifying hells such as the Unending Torment Hell,"

msgctxt "16a5fbe1b1054ab38d10f1859ad0e2c7"
msgid "དམྱལ་བ་ བསྟན་བ་ གང་ཡིན་པ ། །"
msgstr "Whatever is shown as the hell,"

msgctxt "e6c9ea32fe214d2f8ebf9187c6b41d62"
msgid "སློབ་དཔོན་ ལ་ ནི་ སྨོད་པ་ རྣམས ། །"
msgstr "All those who disparage their masters,"

msgctxt "a6b2c34c90724123814596b7a44f7539"
msgid "དེ་␣ར་ ནི་ ངེས་པར་ གནས་པ་␣ར་ བསྟན །"
msgstr "It is taught that [they] will definitely remain in these."

msgctxt "2c1807411393489e9714de12a7755367"
msgid "ཅེས་ དང༌ །"
msgstr "And"

msgctxt "21a4fa2d8c2c4380b034465a101bca17"
msgid "རྡོ་རྗེ་ གུར་ ལ་␣ས །"
msgstr "According to the Vajra Dome:"

msgctxt "b6d445a3ecc7448f8615d428ea6ab3d0"
msgid "དེ་ ཚེ་དབང་ བསྒྱུར་ མཆོག་ཐོབ་པ་␣འི ། །"
msgstr "At that time, with the attainment of supreme mastery,"

msgctxt "62a6260efffc4a8fac72396f37a0e1f6"
msgid "སློབ་མ་␣ས་ བླ་མ་␣འི་ བཀའ་ འདས་ ན ། །"
msgstr "If a disciple transgresses the words of the guru,"

msgctxt "6cd305e91d334c2c9b770cb09334aafc"
msgid "འཇིག་རྟེན་ འདི་␣ར་ ནི་ སྡུག་བསྔལ་ ཞིང༌ ། །"
msgstr "There will suffer in this world,"

msgctxt "6543bb42b4804a69a8c0061ebe7d82a0"
msgid "ཕ་རོལ་ མནར་མེད་ གནས་པ་␣ར་ འགྱུར །"
msgstr "Will remain in Unending Torment [Hell] in the life beyond."

msgctxt "718fd9182c754ab9b944c20843340f2a"
msgid "ཞེས་ དང་ །"
msgstr "And."

msgctxt "e815cad8408d4292879cec923e510f29"
msgid "གསང་སྔགས་ སུ་ ངུ་འབོད་ ལ་"
msgstr "In the secret mantra, there is the Wailing [Hell]."

msgctxt "037edf2f793d47c3a3ef2fea7e40e975"
msgid "རྡོ་རྗེ་␣འི་ དམྱལ་བ་ མནར་མེད་ དུ་ བཞག་པ་ ཡང་ ཡོད་ དེ །"
msgstr ""
"There is also the Vajra Hell being placed as the Unending Torment [Hell]."

msgctxt "d65c776260e64523a568b3dd788dc85f"
msgid "དུས་འཁོར་ གྱི་ འགྲེལ་བ་ དྲི་མེད་ འོད་ ལ་␣ས །"
msgstr ""
"According to the Stainless Light, a commentary on the Kalachakra Tantra:"

msgctxt "283591aae7a147c8a67547371481b3d7"
msgid "རླུང་ གི་ དཀྱིལ་འཁོར་ གྱི་ དབུས་ སུ་ ངུ་འབོད་ དང༌ །"
msgstr "In the center of the wind mandala is the Wailing Hell and"

msgctxt "34ead7e6f3864322aec2974c633e054e"
msgid "དེ་␣འི་ སྟེང་ དུ་ མུན་པ་ ཆེན་པོ་ དང༌ །"
msgstr "Above that is the Great Darkness Hell and"

msgctxt "b93cc7cca38b48839ef383101508ce9e"
msgid "དེ་བཞིན་ དུ་ མེ་ དཀྱིལ་ ལ་ མེ་␣འི་ དམྱལ་བ་ དང་"
msgstr "Likewise, in the fire mandala is the Fire Hell,"

msgctxt "92c4b667a5c748cfae1eaf188b26435a"
msgid "ངུ་བ་ མི་བཟད་པ་ ཆུ་ དཀྱིལ་ ལ་ འདམ་ གྱི་ ཆུ་ དང་ བྱེ་མ་␣འི་ ཆུ །"
msgstr ""
"The overwhelming wailing, the center of the water mandala are the Swamp "
"Water and Sandy Water [Hells], "

msgctxt "18e876f432414378b9c023d809dbeaea"
msgid "ས་ དཀྱིལ་ གྱི་ ཕྱེད་ འོག་མ་ ལ་ གསེག་མ་␣འི་ དམྱལ་བ་ སྟེ །"
msgstr "In the lower half of the earth mandala is the Pebble Hell."

msgctxt "3917d3c1fda641428af6c7048bfe5e44"
msgid "གནས་ བདུན་ ལ་ ཚ་གྲང་ གི་ དམྱལ་བ་ འཁོར་བཅས་"
msgstr "The seven places are the hot and cold hells and their surroundings."

msgctxt "c3d208f5ada442f096199c8bcc35a526"
msgid "འདུ་བ་␣ར་ ཡང་ གསུངས་ སོ །"
msgstr "It is also taught in the Collected [texts]."

msgctxt "d6550ef2e05940ee9cda9c28faeba274"
msgid "རྡོ་␣༽༽  དམ་ཚིག་ འདས་ ནས་ རྡོ་རྗེ་␣འི་ དམྱལ་བ་␣ར་ སྐྱེས་ ན་"
msgstr ""
"Vajra: It is said that if you transgress your commitments and are born in "
"the Vajra Hell,"

msgctxt "c1761e36b12a48059f9f1d6eaf5292b9"
msgid "ཐར་པ་ དང་ ཐོབ་པ་␣འི་ དུས་ མེད་ ཅེས་ ཟེར་ ཡང་"
msgstr "There is no time for liberation or attainment."

msgctxt "38ef6cc1c4c849bb876371bc8bbd9abc"
msgid ""
"འདི་␣ར་ ནི་ སློབ་དཔོན་ རྒྱུད་ ཚོད་ མཐོ་ ན་ མྱུར་ དུ་ འདྲེན་པ་ ཡིན་ ཏེ །"
msgstr ""
"In this [system], if the master’s mental continuum is advanced, he will lead"
" quickly."

msgctxt "8779be45efb94c0d9ca023467b46d7f6"
msgid "ཆོས་ ལ་ བརྟེན་པ་␣འི་ བསྐུལ་བ་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr "This is because it is an exhortation based on the Dharma."

msgctxt "7b52efdc689b422897b99633ade6274e"
msgid "དཔེར་ན་ ཐུབ་དཀའ་ གཞོན་ནུ་␣ས་ ཐར་པ་ ནག་པོ་␣ར །"
msgstr "For example, Durdharsa Kumarabhutah to Tarpanagpo"

msgctxt "10256566652d4be9b4e900e86c9d47a2"
msgid "དེ་བཞིན་ཉིད་ དེ་ མ་ བཅོ་␣ས་ ན ། །"
msgstr "If the thusness is not altered,"

msgctxt "9bc4c694b63546bfa32e7686536a3324"
msgid "ཆེན་པོ་ བཞི་ ལ་ གནས་ བཅས་ ཀྱང་ ། །"
msgstr "Even if one abides in the four greatnesses,"

msgctxt "69397d96a840450899c01b7df176ae1f"
msgid "ནམ་མཁའ་ ལ་ ནི་ སྤྲིན་ བཞིན་ དུ །"
msgstr "It is like clouds in the sky."

msgctxt "839ccf024f934e65a49752ab12b4863e"
msgid "ཞེས་ སོགས་ བསྟན་པ་ སྒྲ་ ཇི་བཞིན་ དུ་ བཟུང་ ནས་"
msgstr "So forth and by taking these teachings literally"

msgctxt "8b35ba6be09c4539aad868590c25bb4e"
msgid "ལས་མི་ ཟད་པ་ ལ་ སྤྱད་པ་␣ས་ ངན་སོང་ དུ་ ལྟུང་བ་"
msgstr ""
"Because of conducting the inexhaustible karma, one falls into the bad "
"migrations,"

msgctxt "a199d5b17dd540538cc3f4dd332c9a11"
msgid "དད་ འཕགས་ འཇིགས་བྱེད་ ཆེན་པོ་␣ར་ སྤྲུལ་ ནས་ དྲང་བ་ བཞིན་ ནོ །"
msgstr ""
"It is like the confident superior being emanated into the Great Terrifier."

msgctxt "04b504bb64134899ae593254192ff905"
msgid "ལྷན་␣༽༽  སྔགས་ ཀྱི་ རྩ་ལྟུང་ སློབ་མ་␣ས་ སློབ་དཔོན་ ལ་ བརྙས་ ན་"
msgstr ""
"Addendum: It is said that the root downfall of mantra is that if a disciple "
"despises the master,"

msgctxt "159e4a546d514886946ab917abd2fc02"
msgid "ལྟུང་བ་ དང་པོ་ འཕོག་པ་␣ས་"
msgstr "The first downfall is incurred."

msgctxt "4b7375ab55bd4f68aadbe7073a7b9302"
msgid "སློབ་མ་␣འི་ དམ་ཚིག་ ཤིན་ཏུ་ གཉེན་ ལ་"
msgstr "Therefore, the disciple’s sacred commitment is very close,"

msgctxt "a63db7c679fe4937bf72ce1ab9620266"
msgid "སློབ་དཔོན་ གྱིས་ ནི་ སློབ་མ་␣ར་ དེ་ལྟར་ མི་ གཉེན་ ཟེར །"
msgstr "But the master does not treat the disciple in that way."

msgctxt "f9cd864e1ce3440b847e4c5dd78dd782"
msgid ""
"འདི་␣ར་ ནི་ དཔོན་སློབ་ གཉིས་ཀ་ ཕན་ཚུན་ དམ་ཚིག་ གཉེན་ མི་ གཉེན་ མཉམ་པ་ ལ་ "
"གཅིག་ ཡིན་ ཏེ །"
msgstr ""
"In this [system], the sacred commitment of both the master and disciple is "
"equal, whether they are close or not."

msgctxt "b1945408c91e4be5a1c3369190dec378"
msgid ""
"སློབ་དཔོན་ གྱིས་ སློབ་མ་␣ར་ བརྙས་ ན་ རྩ་ལྟུང་ བཅུ་གཉིས་པ་ ཡིན་པ་␣འི་ ཕྱིར་ "
"དང་"
msgstr "If a master despises his disciple, this is the twelfth root downfall."

msgctxt "d03ae9f0ab584edc8abbec30abda879f"
msgid ""
"ས ། ཉེས་པ་ བྱས་ ན་ བླ་མ་ ཡིན་ ཀྱང་ འབྲས་བུ་འབྱུང་བ་ རྟེན་འབྲེལ་ ཡིན་པ་␣འི་ "
"ཕྱིར །"
msgstr ""
"If you commit a fault, even as a guru, the result will arise because of the "
"interdependence of causes and conditions."

msgctxt "d9bc98b80e6a4e3585ab360e9536c3f4"
msgid "དཔེ་␣ར་ མས་ བུ་ བསད་པ་ དང༌ །"
msgstr "For example, both the mother who killed her child and"

msgctxt "ea5e20c6a9ad4f69a9faf38eb16c751d"
msgid "བུས་ མ་ བསད་པ་ གཉིས་ཀ་ གང་ཡིན་ ཡང་ དམྱལ་བ་␣ར་ ལྟུང་བ་ བཞིན་ ནོ །"
msgstr "the child who killed its mother will fall into hell."

msgctxt "e76d836edfc84575bf31a0d127386f7b"
msgid ""
"གསང་སྔགས་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ་␣འི་ ཚིག་རྐང་ ཉེར་ བརྒྱད་ ལྷན་ཐབས་ ཚིག་རྐང་"
" བཅུ་བདུན་ བཅས་ ཀྱི་ འགྲེལ་བཤད་ བྱེད་པ་␣འི་ སྐབས་ ཏེ་ ལྔ་པ་␣འོ །"
msgstr ""
"This concludes the fifth section, a commentary on the twenty-eight vajra "
"verses and the seventeen verses of addendums, summarizing the essential "
"points of the secret mantra approach."

msgctxt "f258aa77141b41cdbaab30aa674b39c1"
msgid "རྡོ་␣༽༽  འགའ་ཞིག་ ཆོས་ རྒྱུད་པ་ མེད་པ་␣འི་ ཉམས་མྱོང་ དང༌ །"
msgstr ""
"Vajra: Some [people] have experiences that are not of the Dharma lineage."

msgctxt "fe7490fe19cf455a98c835adc43543b1"
msgid "རྡོལ་ཆོས་ དཔེ་ དཀ་␣ར་ བུ་ བཞི་ དང །"
msgstr ""

msgctxt "365a0a65f3174013a8beb76d9b1bfd3b"
msgid "ཤིང་ ཆོས་ གསོ་སྦྱོང་ ཡན་ལག་ བརྒྱད་པ །"
msgstr "The wood teaching of the eight-limbed restoration and purification."

msgctxt "2641ae2774c84600b448c47c62695e98"
msgid "གནམ་ ཆོས་ ཏནྡྲ་ སྡེ་ བཅོ་བརྒྱད་ ལ་སོགས་པ་"
msgstr "The eighteen sections of the Sky Dharma Tantra and so forth."

msgctxt "ecdebb1a36b64041b8a30c0ab6d425e1"
msgid "ཟབ་པ་␣ར་ འཛིན་པ་ མང་ དུ་ བྱུང་ ཡང༌ །"
msgstr "Although many people hold them as profound,"

msgctxt "784076f6163545cfb675c95553eef430"
msgid "དེ་དག་ རྣམས་ ཚིག་དོན་ བཟང་ ཡང་"
msgstr "Even the words and meaning of those are good, "

msgctxt "9b38de3c6cf64385a29e2cf2c5752318"
msgid "བླ་མ་ བརྒྱུད་པ་ མེད་པ་␣ས་ འབྲས་བུ་ མི་ འབྱིན་པ་␣འི་ ཕྱིར །"
msgstr "They do not bring results because there is no lineage of gurus."

msgctxt "faa82e2434bb49c7bce77facfcb7b7cf"
msgid "འདི་␣ར་ ནི་ དམ་པ་␣འི་ ཆོས་ གང་ཞིག་ བརྒྱུད་པ་ ནས་ བརྒྱུད་པ་␣ར་ འབྲེལ་པ་"
msgstr ""
"In this [system], a holy Dharma that has been inter-connected from one "
"lineage to the next,"

msgctxt "1444c8f6b678412183141a492942f830"
msgid "དེ་ ཟབ་པ་␣ར་ བཞེད་ དེ་"
msgstr "That is accepted as profound."

msgctxt "dc8fd9b60ad54fb59957eac3166f8e3b"
msgid "དེ་␣འང་ ཆོས་ ཐམས་ཅད་ ལུང་ དང་ བཅས་པ །"
msgstr "Furthermore, all Dharmas must have the scriptural transmissions,"

msgctxt "ad89fdaa1ccb46acb8c6f5a95b41f87e"
msgid "ལུང་ མན་ངག་ དང་ བཅས་པ་ དགོས་པ་␣ས་"
msgstr "The scriptural transmissions must have foremost instructions."

msgctxt "f87620309ae04afa8bf56c6215432b39"
msgid "བརྒྱུད་པ་␣འི་ བླ་མ་ ལ་མ་ བརྟེན་ ན་"
msgstr "Thus, if you do not rely on a lineage guru,"

msgctxt "2a46c03f3f564b2e837cf149f3512b20"
msgid "རང་ཉིད་ ཀྱི་ མི་ ཤེས་པ་␣འི་ ཕྱིར་"
msgstr "You will not understand them yourself."

msgctxt "362a6b5ff2c544d2812e6040fc735cea"
msgid "དཔེར་ན་ སངས་རྒྱས་ བཞིན་ ནོ །"
msgstr "Just as, for example, the Buddha did."

msgctxt "6dab1ecd800a4aeea79b00c09dac1a65"
msgid "མདོ་ ལ་␣ས་ ཀྱང༌ །"
msgstr "Also, according to the sutra:"

msgctxt "84f84ab7d9764e0c8d4a628e7798a8d1"
msgid "སངས་རྒྱས་ ཆོས་ རྣམས་ དགེ་བ་␣འི་ བཤེས་ ལ་ བརྟེན་ ཏོ་ ཞེས ། །"
msgstr "The Buddha’s teachings depend on a spiritual friend."

msgctxt "37d32ecac69b49429546855527bc8690"
msgid "ཡོན་ཏན་ ཀུན་ གྱི་ མཆོག་ མངའ་ རྒྱལ་བ་␣ས་ དེ་སྐད་ གསུངས །"
msgstr ""
"This is what the conqueror, who is the supreme of all qualities, has said."

msgctxt "d415f8e439a3447d8ab2ec40106a50b4"
msgid "ཞེས་ སོགས་ གསུངས་ ན་ སྔགས་ སུ་ རྒྱུད་ དཀྲུག་པ །"
msgstr ""
"If such things are said, it would disturb the mainstream in the mantra."

msgctxt "304f5bafdb544f498f4345fb5fc3d814"
msgid "ལུང་ བཅུ་␣ས །"
msgstr "According to the ten scriptural transmissions:"

msgctxt "4138abd23f6e4f92be753d25dcbfd50e"
msgid "མན་ངག་ གབ་པ་␣འི་ ཕྱིར་ ལྟ་ སྨྲོས་ ཀྱང་ ཅི་ དགོས་"
msgstr "It is needless to say it is for concealing the foremost instructions."

msgctxt "36d0f802e02045d1a5c0d163ec46785f"
msgid "དེ་ལྟར་ ཡང་ སཾ་ བྷུ་ ཊི་ ལ་␣ས །"
msgstr "Likewise, according to the Samputa:"

msgctxt "9b2f47955fbe4126a6e160d7cc47cc5d"
msgid "ཡོན་ཏན་ ཐམས་ཅད་ རབ་ རྫོགས་ ཀྱང༌ །"
msgstr "Even if all good qualities are perfected,"

msgctxt "9d60411fd7914e6799f91fb635b6fdc3"
msgid "བླ་མ་ མེད་ ན་ སྲིད་མཐ་␣ར་ མིན །"
msgstr "One will not emancipated from existence without a guru."

msgctxt "c5ca03cad981472ca3ba3448d6baa300"
msgid "ཅེས་པ་␣ས་ སངས་རྒྱས་ ནས་ བརྒྱུད་པ་␣འི་ ཆོས་ ཟབ་ ཅིང་ ངོ་མཚར་བ་ ཡིན་ ལ །"
msgstr ""
"Thus, the Dharma transmitted from the Buddha is profound and marvelous."

msgctxt "e1c9a66c84b94da8964ebe88499c8329"
msgid "དེ་␣འང་ མཚན་ཉིད་ ལྡན་པ་␣འི་ བླ་མ་␣ར་ རག་ ལས་པ་ ཡིན་ ནོ ། །"
msgstr "This also depends on a guru who possesses characteristics."

msgctxt "7469908b6f5e4ca286db776385e343f9"
msgid "བླ་མ་ མ་ བརྟེན་པ་␣ར་ རྡོལ་ཆོས་ སོགས་ ཀྱིས་ སྒོམ་ སྐྱེས་ ཀྱང་"
msgstr ""
"Without relying on a guru, even if meditation is generated by harsh behavior"

msgctxt "6b4529cef748443987b2b03ae1da3dfd"
msgid "ཕལ་ཆེར་ འཇིག་རྟེན་པ་␣འི་ ཏིང་འཛིན་ འབའ་ཞིག་ ཏུ་ འོང་བ་␣ས་"
msgstr "Most likely, one will only have worldly meditative stabilizations."

msgctxt "20bfbf42dfee462aaaa3db5afea8b5da"
msgid "འཁོར་བ་ ལ་␣ས་ ཀྱང་ མི་འདའ་ ན་"
msgstr "If one does not even transcend cyclic existence,"

msgctxt "5156e1e54bba40b4854eacbb91506091"
msgid "ཐམས་ཅད་ མཁྱེན་པ་ ལྟ་ཅི་ སྨོས །"
msgstr "It is needless to mention about omniscient."

msgctxt "93f1bf81b9a141a7927de856d2adff5a"
msgid "དེས་ན་ རྣམ་པ་␣ར་ དག་པ་␣འི་ བརྒྱུད་པ་"
msgstr "Therefore, this kind of pure lineage is"

msgctxt "3674b9441aa241bb932639cc2c343af9"
msgid "དེ་ འདྲ་བ་ ནི་ བཀའ་ བརྒྱུད་ རིན་པོ་ཆེ་ འདི་ ཡིན་ ཏེ །"
msgstr "this precious Kagyu."

msgctxt "1ab5f4812e394006be59770243064671"
msgid ""
"དེ་␣འང་ ལྟ་བ་ རྣམ་པ་␣ར་ དག་པ་ སངས་རྒྱས་ དང་ ཀླུ་ གྲུབ་ ནས་ བརྒྱུད་པ་␣འི་ "
"དབུ་མ །"
msgstr ""
"Furthermore, Madhyamaka is the perfectly pure view transmitted from Buddha "
"and Nagarjuna."

msgctxt "174315d5ad604a83af8a000b3e0c771b"
msgid "སྤྱོད་པ་ རྣམ་དག་ སངས་རྒྱས་ དང་ ཐོགས་མེད་ ནས་ བརྒྱུད་པ་␣འི་ ཕར་ཕྱིན །"
msgstr "Paramita is the pure conduct transmitted form Buddha and Asanga."

msgctxt "e2bec2ecd7254118b84244f405de7533"
msgid "རྒྱུད་པ་ ཆུ་བོ་ གཉིས་ འདྲེས་ ཇོ་བོ་ རྗེ་ དང་ །"
msgstr "The lineage of the two rivers mixed, from Atisha to"

msgctxt "1415978b6ca746b6a32886613387d88d"
msgid "བླ་མ་ དྭགས་པོ་ ལྷ་རྗེ་ ཕག་གྲུ་ ཆོས་རྗེ་ འབྲི་གུང་པ་ ནས་"
msgstr "Lama Dagpo Lhaje, Phagdru Choje, and Drigungpa,"

msgctxt "7385eb13b3f44280821267ad2faa816b"
msgid "ད་བར་ ཆོས་བརྒྱུད་ རྣམ་པ་␣ར་ དག་པ །"
msgstr "Has been a pure Dharma lineage up to the present."

msgctxt "ede214563dc0458ebb2a7f10b7122084"
msgid ""
"སྔགས་ ཀྱི་ ལྟ་སྤྱོད་ སྒོམ་ གསུམ་ དབྱེ་␣ར་ མེད་ རྣམ་དག་ རྡོ་རྗེ་ འཆང་ ཏེ་"
msgstr ""
"The inseparable and completely pure view, conduct, and meditation of the "
"mantra is Vajradhara."

msgctxt "79f9143f9dc04a4cafa95526a360fb4d"
msgid "ལོ་ན་␣ས་ བརྒྱུད་པ་␣འི་ ཟབ་ ལམ་ ཕྱག་རྒྱ་ ཆེན་པོ་ སྟེ་"
msgstr ""
"The profound path of mahamudra, which has been transmitted from years."

msgctxt "4936033c2bef49cf9ad1d1691e8ccfe7"
msgid "བརྒྱུད་པ་ དེ་ལྟར་ རྣམ་པ་␣ར་ དག་པ་ ཡིན་པ་␣ས་ ཟབ་བོ །"
msgstr "Since the lineage is pure in this way, it is profound."

msgctxt "a583bc1ef3f240faa7738c88c5e9f375"
msgid "རྡོ་␣༽༽་␣སྣང་བ་ སྣ་ཚོགས་ སུ་ སྣང་བ་ ཐམས་ཅད་ ཕྱི་དོན་ དུ་ སྒྲུབ་པ་␣ས་"
msgstr ""
"Vajra: Since all appearances that appear as various kinds are established as"
" external objects,"

msgctxt "2f7a87a42c1d4641b69ad5d20e96be6b"
msgid "བློ་ དང་ མ་ འབྲེལ་བ་␣ར་ བྱེ་ སྨྲ་ སོགས་ འདོད་པ་ ཡོད་ ཀྱང་"
msgstr ""
"However, the Vaibhashikas and others accept that they are not connected to "
"the mind."

msgctxt "086846e81c0a40ecbed3b8eb2603e8ce"
msgid "འདི་␣ར་ ནི་ ཁམས་ གསུམ་ འཁོར་བ་ དང་ མྱང་འདས་ གསུམ་ གྱི་ ཆོས་མ་ ལུས་པ་"
msgstr ""
"In this [system], all the phenomena of the three realms of samsara and "
"nirvana without exception"

msgctxt "ef5cd9437d614f9191c8b6879987b7db"
msgid "ཀུན་ གྱི་ བཟང་ངན་ སྣང་བ་ ནི་ རང་ གི་ སེམས་ ཡིན་ ཏེ །"
msgstr "All the appearances of good and bad are your own mind."

msgctxt "86f68101ca6944bfa1bca805afda69ad"
msgid "སྣང་ མི་ སྣང་ དུ་ འཛིན་པ་ རང་ གི་ སེམས་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr "The grasping of appearance and non-appearance is one’s own mind."

msgctxt "3c603b123a48451dbef9e8421abd856d"
msgid "འོ་ན་ སྣང་ཡུལ་ ཡོད་པ་␣ས་ སེམས་ ཡིན་ ནམ་ མེད་པ་␣ས་ ཡིན །"
msgstr ""
"Well then, is it because there are appearing objects that there is the mind,"
" or is it because there are no appearing objects that there is the mind?"

msgctxt "c259265b9e634d67a2143f950c9bdeaf"
msgid "དང་པོ་ ལྟར་ ན་ ཡུལ་ ལྟར་ ཡོད་པ་ བཞིན་"
msgstr "In the first case, just as the object exists,"

msgctxt "c34ac91f4e1c4b81822f68aa69f90180"
msgid "སེམས་ ཀྱང་ དེ་␣ར་ ཐལ་བ་␣འམ་"
msgstr "It would absurdly follow that the mind would also be."

msgctxt "0c382658f6844dfebd687921a4843638"
msgid "སེམས་ བཞིན་ དུ་ ཡུལ་ ཀྱང་ མཐོང་ཆོས་ སུ་ མི་ རུང་བ་␣ར་ འགྱུར་ རོ ། །"
msgstr ""
"Like the mind, the object would also not be suitable to be a visible "
"phenomenon."

msgctxt "c8c2d987d52e4fd8b86f7f25b7319ab4"
msgid "གཉིས་པ་ ལྟར་ ན་␣འང་ དོན་ཡོད་པ་ ལྟར་ འགྱུར་ རོ་ སྙམ་ ན་"
msgstr ""
"In the second case, if one thinks that it would be like the existence of an "
"object,"

msgctxt "e71f006866254c3ea0450e0211548dae"
msgid "སྣང་བ་ ཕྱི་དོན་ དུ་ གྲུབ་པ་ མེད་པ་␣ས་ ཡིན་ ཀྱང་"
msgstr "Then, although appearances are not established as external objects, "

msgctxt "146588e641ac47ff95a02b244b756f14"
msgid "བག་ཆགས་ འཁྲུལ་བ་ རྨི་ལམ་ གྱི་ སྣང་བ་ ལྟར་"
msgstr "They are confused latencies like the appearances of dreams,"

msgctxt "521354ee06c247e28280c7faa98f4d80"
msgid "ཕྱི་ ནང་ གང་ཡང་ མ་ ཡིན་"
msgstr "which are neither external nor internal,"

msgctxt "7988da70aee9431e8515d76cb67735c0"
msgid "གང་ དུའང་ མ་གྲུབ་པ་"
msgstr "Nor established as anything at all. "

msgctxt "bd52b37820ec496995a3becb251d67a2"
msgid "རང་བཞིན་ མེད་པ་␣ར་ སྨྲ་བ་␣ས་ སྐྱོན་ དེ་དག་ མེད་ དོ ། །"
msgstr ""
"They are said to be without intrinsic nature, and so these faults do not "
"exist."

msgctxt "fdb388eab1e444cbae5209e81ba3e8bb"
msgid "དེ་ལྟར་ ཡང་སློབ་ དཔོན་ འཕགས་པ་␣ས་ རྡོ་རྗེ་␣འི་ བསྟོད་པ་ ལ་␣ས །"
msgstr "According to the Vajra[pani] Praise by the master Arya [Nagarjuna]:"

msgctxt "d4eeca0589874d2aa22a8100efeafa17"
msgid "སེམས་ རྟོགས་པ་␣ས་ ནི་ བྱང་ཆུབ་ སྟེ །"
msgstr "Realizing the mind is enlightenment,"

msgctxt "005e24a5a5534c22ae094c1d9c83d425"
msgid "སེམས་ ནི་ འགྲོ་བ་ ལྔ་པོ་ ཡིན ། །"
msgstr "The mind is the five types of migrators,"

msgctxt "586547b972a846339dc41e8e0d79431d"
msgid "བདེ་ དང་ སྡུག་བསྔལ་ མཚན་ཉིད་ དག  །"
msgstr "The characteristics of happiness and suffering,"

msgctxt "40511b086dbf4ddea5d1eb23f7f509ce"
msgid "སེམས་ལས་ མ་གཏོགས་ ཅུང་ཟད་ མེད །"
msgstr "There is nothing else besides the mind."

msgctxt "23a18214db3f44368b94f44f1cca5fd9"
msgid "ཅེས་ དང་ །"
msgstr "And"

msgctxt "993cf58a50924d96a74c3dcb17c65f1c"
msgid "གུར་ ལ་␣ས །"
msgstr "According to the Dome:"

msgctxt "893b3948634449fbbf094b9e1d0c2d31"
msgid "ཡུལ་ དང་ དབང་པོ་␣འི་ བྱེ་བྲག་ རྣམས ། །"
msgstr "All the particular objects and sense faculties,"

msgctxt "8a5e32f4f90243178f6e5d55ea0e0765"
msgid "རྣམ་པ་ ཐ་དད་ མ་ མཆིས་ ཏེ་␣༑"
msgstr "[They] are not different in type,"

msgctxt "c8a49961ba5e448fa9d34edf529aef5a"
msgid "གཟུགས་ སོགས་ སྣང་བ་␣ར་ གྱུར་པ་ ནི །"
msgstr "But the appearance of forms and so forth,"

msgctxt "490c2bebe5214ac5a724373023ac4325"
msgid "རང་སེམས་ སྣང་བ་ ཁོ་ན་␣འོ ། །"
msgstr " It is just the appearance of one’s own mind."

msgctxt "1297ee6b70f1444b8fb6b90fdc15a4ec"
msgid "ཞེས་པ་␣ས་"
msgstr "Thus,"

msgctxt "7ad2ddff86504ce5b5bf3d462e03f643"
msgid "སྣང་བ་␣འི་ ཡུལ་ ལུས་སེམས་ གསུམ་"
msgstr "The three appearances of object, body, and mind, "

msgctxt "7b8cf8029a7448179fc6b09c4a2acb29"
msgid "སེམས་ལས་ གཞན་ དུ་མ་ དམིགས་ ཤིང༌ །"
msgstr "They are not observed as anything other than mind."

msgctxt "0106eabaa1974d15aa8731da964f2def"
msgid ""
"དེ་␣ས་ བསྒྲུབས་པ་␣འི་ དགེ་སྡིག་ གི་ འབྲས་བུ་ ཡང་ སེམས་ ལ་ སྣང་བ་ ཡིན་ ནོ ། །"
msgstr ""
"The results of virtue and non-virtue accomplished by that also appear to "
"mind."

msgctxt "f151e3e18cde446388ec9f852bb04671"
msgid "དེ་ལྟར་ སློབ་དཔོན་ ཟླ་བ་␣ས །"
msgstr "Likewise, the master Candra[kirti] says:"

msgctxt "f43608a16b0f4013a0944e5fca760d70"
msgid "སེམས་ཉིད་ ཀྱིས་ ནི་ སེམས་ཅན་ འཇིག་རྟེན་ དང༌ །"
msgstr "The mind itself lays the sentient beings, the world and "

msgctxt "d271246a49374c52828d9db9eff41c13"
msgid "སྣོད་ ཀྱི་ འཇིག་རྟེན་ ཤིན་ཏུ་ སྣ་ཚོགས་ འགོད ། །"
msgstr "The container worlds in great diversity."

msgctxt "309ffe368c1848588c2ae2204c9b4a57"
msgid "འགྲོ་བ་ མ་ ལུས་ ལ་␣ས་ ལ་␣ས་ སྐྱེས་པ་␣ར་ གསུངས ། །"
msgstr "All migrators are said to be born from karma,"

msgctxt "34ca1b29051d4a549a121f1945a306b7"
msgid "སེམས་ སྤང་ ནས་ ནི་ལ་␣ས་ ཀྱང་ ཡོད་ མ་ ཡིན །"
msgstr "When the mind is abandoned, karma no longer exists."

msgctxt "514f8b1c6fd74d04b155667f9bf2a4c0"
msgid "གལ་ཏེ་ གཟུགས་ ཡོད་ མོད་ ཀྱི་ དེ་ ལ་ ནི ། །"
msgstr "Even in case if the form exists, "

msgctxt "d2909569805f4225a32d44296e71b9e5"
msgid "སེམས་ བཞིན་ བྱེད་པ་པོ་ ཉིད་ ཡོད་ མ་ ཡིན ། །"
msgstr "It does not have an actor such as mind."

msgctxt "645aa52baa334eff9ac36c18b8160cc8"
msgid "དེ་␣ས་ ནི་ སེམས་ལས་ གཞན་པ་␣འི་ བྱེད་པ་པོ ། །"
msgstr "Therefore, the actor other than the mind"

msgctxt "45106f2e9c6b440387e4cd1856954507"
msgid "བཟློག་པ་␣འི་ གཟུགས་ ནི་ བཀག་པ་ མ་ ཡིན་ ནོ ། །"
msgstr "The opposite of the form is not negated."

msgctxt "1ac6cc2d6c2a45f8bb653cf4729c3548"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "52abde07c18e407faa97aa7261ee8b8f"
msgid ""
"རྡོ་␣༽༽་␣ད་ལྟ་␣འི་ བདེ་སྡུག་ སྔོན་ གྱི་ དགེ་སྡིག་ གི་ འབྲས་བུ་ སྨིན་པ་ ཡིན་ "
"ཅིང་"
msgstr ""
"Vajra: It is said that present happiness and suffering are the ripened "
"fruits of previous virtue and negative action,"

msgctxt "4786baac2bd0405ebfd989f968873c5d"
msgid "ད་ལྟ་ གང་ བསགས་པ་ ཕྱི་མ་ ལ་␣ས་ ད་ལྟ་ འབྲས་བུ་ མི་ འབྱུང་ ཟེར །"
msgstr ""
"Whatever is accumulated now will produce results in the future, not in the "
"present."

msgctxt "04b6bebca61f4af9895d0f975e8a52b6"
msgid ""
"འདི་␣ར་ ནི་ རྒྱུ་ དགེ་སྡིག་ གི་ ལ་␣ས་ ལ་ འབྲས་བུ་ བདེ་སྡུག་ མྱོང་བ་␣འི་ "
"སྣང་བ་ ཐམས་ཅད་"
msgstr ""
"In this [system], all appearances of experiencing happiness and suffering as"
" the result of virtuous and negative actions are"

msgctxt "d1a4051237fb4518b3b50c90a9be0a3b"
msgid "ཀུན་གཞི་ ལ་ འཁྲུལ་བ་␣འི་ བག་ཆགས་ བཞག་པ་"
msgstr "The latencies of delusion placed in the omni-base [consciousness]."

msgctxt "ce9dcf9fd33f4503900e54fef8315370"
msgid "དེ་སྐད་ ཅིག་ གི་ བསམ་པ་ དེ་␣འི་ རང་ གི་ སྣང །"
msgstr "It appears itself by having thoughts for a moment."

msgctxt "95112d3bacc94001b442ebe06594d7db"
msgid ""
"གཟུགས་ ཡིན་པ་␣ས་ འཁྲུལ་སྣང་ སྟེ་ བག་ཆགས་ མ་ཟད་ རིང་ ལ་སྟོང་ མི་ སྲིད་པ་"
msgstr ""
"Because of being the form, they are the appearances of confusion, thus it is"
" impossible for them to be empty as long as the latencies are not exhausted."

msgctxt "b1181b46d8e645c9a08501ebb5987cb6"
msgid ""
"མཁྲིས་ནད་ མ་ འབྱང་བ་␣ར་ དུ་ དུང་ལ་ སེ་␣ར་ འཛིན་ མི་ ལྡོག་པ་ བཞིན་ ནོ ། །"
msgstr ""
"Until the jaundice is cured, apprehending of yellow conch will not be "
"reversed."

msgctxt "b1b228883b0f4a9983c57734289a6670"
msgid "དེ་ལྟར་ ཡང་ མདོ་ དྲན་ ཉེར་ ལ་␣ས །"
msgstr "Likewise, according to the Application of Mindfulness Sutra:"

msgctxt "875a91b005b14bc9942ade17b41b2b44"
msgid "འཇིག་རྟེན་ དག་ ན་ ཇི་ལྟར་ སྣང་བ་ ཀུན ། །"
msgstr "All that appears in the worlds,"

msgctxt "92973a6239734be6b2c635ef8e152e73"
msgid "ཐམས་ཅད་ རང་ གི་ ལ་␣ས༌་␣ལ༌ཉེ་ བར་ བྱུང༌ །"
msgstr "All of them arise from one's own karma."

msgctxt "6a308a5b692f4664ba931ebd10a9ac6e"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "d30e48defc534b82bbfde9e9efb5c9d2"
msgid "དེ་␣འང་ འདུས་བྱས་ སྐད་ཅིག་མ་ ཡིན་པ་ ནི །"
msgstr "Furthermore, the momentariness of composite [phenomena] means"

msgctxt "5704de270b2e4fb591b754fff0343a33"
msgid "རྒྱུ་རྐྱེན་ གྱི་ ཆོས་ རྣམས་ ཆོས་ཅན་ སྐད་ཅིག་མ་ ཡིན་ ཏེ །"
msgstr "That the phenomena of causes and conditions are momentary."

msgctxt "2ee3c763552f4cb5834eeeba7cdc7796"
msgid "རྒྱུན་ གྱི་ འཇུག་པ་␣འི་ ཕྱིར །"
msgstr "Because they are engaged in a continuum."

msgctxt "284a12af2808412ebba3e70a6d8510f6"
msgid "དཔེར་ན་ ཕྲེང་བ་ རེ་རེ་བ་ མེད་པ་␣འི་ བརྒྱ་ མི་ འབྱུང་བ་ བཞིན་ ནོ ། །"
msgstr "For example, a hundred cannot emerge without each of the beads. "

msgctxt "c55a9a6fcf194a4f9fe74caacca02f9f"
msgid ""
"སྣང་ གཟུགས་ ནི་ ཕྱག་རྒྱ་ ཆེན་པོ་␣འི་ ཆོས་ཉིད་ འདི་ བསམ་པ་␣འི་ རང་གཟུགས་ ཡིན་"
" ལ་"
msgstr ""
"The appearing form is the natural form of thought of the reality of "
"mahamudra."

msgctxt "00f8e8f7657442ee9057cfa1a385a07b"
msgid "ཆོས་ཅན་ བསམ་པ་␣འི་ རང་གཟུགས་ ལ་ ནི་ གསུམ་ སྟེ །"
msgstr "The subject, the natural form of thought is of three. "

msgctxt "361fa6636975476c857c221b14abb947"
msgid ""
"ད་ལྟ་␣འི་ བསམ་པ་␣འི་ རང་གཟུགས་ དང་ ཚེ་ འཕོས་པ་ དང༌ །  ཚེ་ འཕོས་ ཀྱང་ ལུས་ "
"འགྱུར་པ་␣འི་ བསམ་པ་ སྐད་ཅིག་མ་␣འི་ རང་གཟུགས་ སོ ། །"
msgstr ""
"The present natural form of thought, the transmigration of life, and the "
"momentary natural form of thought of the changing body even after the "
"transmigration of life."

msgctxt "5a96a7ccf3fa40fb9be6c7cb347e3639"
msgid "དང་པོ་ ནི་"
msgstr "The first is"

msgctxt "2fa6d3c388db42479ab917341b56a644"
msgid ""
"དེ་␣འང་ རང་རྒྱུད་ ལ་ དགེ་ མི་དགེ་␣འི་ རྣམ་རྟོག་ གང་ སྐྱེས་པ་␣འི་ "
"འབྲས་བུ་␣འམ་ ས་བོན་"
msgstr ""
"The result or seed of any virtuous or non-virtuous discursive thoughts that "
"arise in one’s own continuum."

msgctxt "950ce45bb1154d1fb024d7d0e15005ad"
msgid "དེ་ དང་ རིགས་ མཐུན་པ་ ཞིག་ རྟོག་པ་"
msgstr "A conceptuality that is similar type of it"

msgctxt "2df04dcacbb54da99f3df834116e531d"
msgid ""
"དེ་␣འི་ རང་གཟུགས་ སུ་ འགྲུབ་པ་ ནི་ ཞེ་སྡང་ གིས་ དམར་ ལམ་ གྱི་ སོང་བ་ དང །"
msgstr ""
"To be produced in the natural form that is gone in the red path of hatred "
"and"

msgctxt "da2c5ee553194fc882ba4efa852b8618"
msgid "བྱམས་ སོགས་ ཀྱི་ བདེ་ལྡན་ གྱིས་ འགྲོ་བ་ ལྟ་བུ་ སྟེ་"
msgstr "It is like migrators who are happy with love and so forth."

msgctxt "c676bdd34509427bb438a29b55958706"
msgid ""
"བྲམ་ཟེ་ ཏོ་ རྒྱ་␣འི་ ནེ་ ཚོ་␣འི་ ཁྱི་ དཀར་པོ་ དུང་ ལྟ་བུ་␣འི་ གཏམ་རྒྱུད་ "
"བཞིན་ ནོ ། །"
msgstr ""
"It is similar to the story of the brahman Torgyal's white dog of Netso which"
" resembles a conch shell."

msgctxt "34e66e646b5f41cda28b469859227fba"
msgid "གཉིས་པ་ ནི་ སྔར་ དགེ་རྩ་ དཔག་མེད་ བསྒྲུབ་ ཀྱང་"
msgstr ""
"The second is that although one has previously accomplished countless roots "
"of virtue,"

msgctxt "fa13031ede12466585a65e4d82af4a37"
msgid ""
"འཆི་ཁ་␣ར་ མི་དགེ་བ་␣ས་ མཚམས་ སྦྱར་ ན་ སོང་ དུ་ སྐྱེ་བ་ ཆོས་རྒྱལ་ "
"མྱ་ངན་མེད་པ་ དང་ །"
msgstr ""
"If one connects with non-virtue at the time of death, one will be reborn in "
"bad migrations like the dharma king Ashoka and"

msgctxt "45de681b413649bfa10e4c49670b8bb9"
msgid "དགེ་བ་␣ས་ མཚམས་ སྦྱར་ ན་ འཕགས་རྒྱལ་ གྱི་ རྔོན་པ་ ལྟ་བུ་ བཞིན་ ནོ ། །"
msgstr ""
"If one connects with virtue, one will be like the hunter of the Ujjain "
"[city]."

msgctxt "832bfaec4803471392eb17eaa1125365"
msgid "གསུམ་པ་ ནི །"
msgstr "The third is"

msgctxt "408f88ce07b64d8d8dcffcb0d06cd09f"
msgid "ལུས་ འགྱུར་བ་ དགེ་ཚུལ་ ཀླུ་␣ར་ གྱུར་པ་␣འི་ གླེང་ གཞི་ བཞིན་ ནོ ། །"
msgstr ""
"This is like the story of the novice whose body changed and became a naga."

msgctxt "bcf185f8c2d8434299e0ff9f5b6d6467"
msgid "དེ་ལྟར་ སེམས་ དང་ །  ལ་␣ས་ དང་ །"
msgstr "Thus, the mind, karma, and "

msgctxt "232c068e303f47ae979b2dcde61203a1"
msgid "ལ་␣ས་ ཀྱི་ འབྲས་བུ་␣ས་ རྟེན་འབྲེལ་ ལ་␣ས་ འབྱུང་བ་ ནི་"
msgstr "The result of karma arising from interdependence is"

msgctxt "0ce831c693ba48f8bf1a5fefdbb7c039"
msgid "མོ་མཁན་ དང་ འདྲ་བ་␣འི་ སེམས་ ལ་ སྣང་བ་␣འི་ གཟུགས་ ཡིན་ ནོ ། །"
msgstr "Like a fortune-teller, the form that appears to the mind."

msgctxt "c12cf6eb2a5447e3b7ab5e1aaeaf348a"
msgid "འདི་ གོ་ ན་ མཐོང་ཆོས་ སྐད་ཅིག་ ཏུ་ འབྱུང་བ་ ལ་ མཁས་པ་ དང༌ །"
msgstr ""
"If one understands this, one will become skilled in the fact that the "
"visible world arises moment by moment,"

msgctxt "49da4c6d19cc4a8f917361f4eea36420"
msgid "སྐད་ཅིག་ ལ་ དགེ་ མི་དགེ་␣འི་ བསམ་པ་ མི་རྟག་པ་␣ར་ ཤེས་པ་ དང༌ །"
msgstr ""
"And one will understand that virtuous and non-virtuous thoughts are "
"impermanent in every moment,"

msgctxt "616c2b027b50490cb955587a8ed08186"
msgid "ལུས་ མི་རྟག་པ་␣ར་ འགྱུར་བ་ ཤེས་པ་␣ས་"
msgstr ""
"And thus understand that the body is impermanent and subject to change."

msgctxt "d040e2eebd3d471a8af32337c31d251d"
msgid "སྐྱོན་ སྤོང་ ཡོན་ཏན་ བསྒྲུབ་པ་ ལ་ ཚེགས་ མེད་པ་␣ར་ འོང་བ་ ཡིན་ ཏེ །"
msgstr ""
"Therefore, one will easily abandon faults and accomplish good qualities."

msgctxt "137e1c14304f4aee9de470abbcab874e"
msgid "ཕར་ཕྱིན་ མངོན་རྟོགས་ རྒྱན་ ལ་␣ས །"
msgstr ""
"According to the transcendent perfection of the Ornament of Manifest "
"Realization:"

msgctxt "3719fc09db384f97a76f177ab41fc464"
msgid "ཇི་ལྟར་ སྐྱེས་པ་␣འི་ ཟོ་ཆུན་ རྒྱུད །"
msgstr "Just as how a watermill is produced in continuity,"

msgctxt "950a049a739c4c7d83a83dabc96a31ca"
msgid "རྡོག་ ཐབས་ གཅིག་ གིས་ བསྐྱེད་པ་ ན ། །"
msgstr "When it is produced with one step,"

msgctxt "a3dbca97fe84438bbc70dd3ef8736284"
msgid "ཐམས་ཅད་ གཅིག་ ཅ་␣ར་ འགུལ་བ་ ལྟར །"
msgstr "Everything is simultaneously moved,"

msgctxt "e817cb0dad6d4db9a7be05c43575e9ba"
msgid "སྐད་ཅིག་ ཡེ་ཤེས་ དེ་བཞིན་ ནོ ། ༑"
msgstr "The instantaneous wisdom is like that."

msgctxt "21d6fd726023465a912215772c195178"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "1ded63f024e2495e83830939a2598b12"
msgid "རྗེ་ འཇིག་རྟེན་ མགོན་པོ་␣ས །"
msgstr "Lord Jigten Gonpo says:"

msgctxt "90686f81dfa94e498ef94332d3a4445e"
msgid "རྗེ་ ཕག་མོ་ གྲུ་པ་␣འི་ སྣང་བ་"
msgstr "Lord Phagmo Drupa's appearances,"

msgctxt "d0e23893c6134efe948c9dbb82111713"
msgid "རང་སེམས་ ཀྱི་ ཁྲོད་ ནས་"
msgstr "From within one's own mind,"

msgctxt "7f454f5140fe456c930bf6fadea36630"
msgid "ང་ འབུས་ བསམ་པ་␣འི་ རང་གཟུགས་ འདི་ རྙེད་པ་ ཡིན་ གསུངས །"
msgstr ""
"It is said that the natural forms of thought such as “I am a bug” is found."

msgctxt "020d601816af43fdb512ccb9abea8033"
msgid ""
"དེ་␣འི་ ཕྱིར་ ན་ རྡོ་རྗེ་␣འི་ གསུངས་ འདི་␣ས་ སྣང་བ་ རང་རང་ སེམས་ གསལ་པོ་␣ར་ "
"བསྟན་པ་ ཡིན་ ནོ །"
msgstr ""
"Therefore, this vajra statement clearly teaches that appearances are one's "
"mind."

msgctxt "fc0664371be3459391ad4d9a80035906"
msgid "རྡོ་␣༽༽  གཤིས་ ལ་ མི་ གནས་ ཀྱང་ བལྟས་པ་␣ས་ འགྱུར་ ཏེ །"
msgstr ""
"Vajra: Although it does not abide in the intrinsic nature, it changes "
"through being examined,"

msgctxt "935c3acf5742416e97e72b9ac5f1d4e8"
msgid "གཤིས་ མ་གྲུབ་པ་ དང་"
msgstr "It is said because the intrinsic nature is not established and"

msgctxt "1f84ceb8a1b141a39d656ca8be967dd2"
msgid "འཁྲུལ་སྣང་ ཡིན་པ་ དང་"
msgstr "It is confused appearances and "

msgctxt "f3f5013392d24c2f995ff409a7236528"
msgid "རང་བཞིན་ མ་ངེས་པ་␣འི་ ཕྱིར་ ཞེས་ ཟེར་ རོ །"
msgstr "Its nature is not ascertained."

msgctxt "9e9b027efdba47bfa4543c064a627852"
msgid "འདི་␣ར་ རྒྱུ་འབྲས་ ཀྱི་ གཤིས༌་␣ལ་ རྟེན་འབྲེལ་ ལ་ མི་ གནས་ ན་"
msgstr ""
"In this [system], if the interdependence is not ascertained in the intrinsic"
" nature of cause and effect,"

msgctxt "5c40867657cd4bfe9b80ff22a7485db9"
msgid "བལྟས་པ་␣ས་ འགྱུར་ མི་ སྲིད་ དེ་"
msgstr "It is impossible to change by examining it,"

msgctxt "1258e643d4d64342a41d30e3c91bfb0e"
msgid "གནས་ དང་ གནས་མིན་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ དང་ འགལ་བ་␣འི་ ཕྱིར་ དང་ །"
msgstr ""
"It contradicts [what is] appropriate or inappropriate of the omniscient "
"wisdom, and"

msgctxt "2d6e83a0aa904456864492750aad4d5f"
msgid "རྒྱུ་འབྲས་ རྟེན་འབྲེལ་ གྱི་ གཤིས་ དང་ འགལ་བ་ དང༌ །"
msgstr "It is contrary to the nature of interdependence of cause and effect."

msgctxt "8739ae51d1ef4f258f0bab7646e97871"
msgid "ཆོས་ ཀྱི་ གྲགས་པ་␣འི་ ཚད་མ་␣ས་ ཀྱང་ མི་ འགྲུབ་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"This is because it is not established even by [the Compendium of] Valid "
"Cognition of Dharmakirti."

msgctxt "a4b5aa45df6b4f5ba4cdf946eb1347d2"
msgid "གལ་ཏེ་ འགྱུར་ ན་ སྡུག་བསྔལ་ བདེ་བ་␣ར་ བལྟས་པ་␣ས་"
msgstr "If it changes, then suffering is viewed as happiness."

msgctxt "3a5c9254301e41ba820d5d9c762c0328"
msgid "དེ་␣ར་ འགྱུར་ རིགས་ ན་␣འང་ མངོན་སུམ་ དང་ འགལ་ ཞིང་"
msgstr "Even if it can change, this would contradict direct perception and "

msgctxt "cdca0a9d47514b2980b597537a4899e4"
msgid "མི་ འགྲུབ་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Thus it is not established."

msgctxt "495a1be366954a669502da178023f7a3"
msgid "རྫུ་འཕྲུལ་ ཏིང་འཛིན་ གྱི་ སྟོབས་ ལ་␣ས་"
msgstr "With the miraculous power of concentration,"

msgctxt "6e042e0812d84cb8805b0ef00cf7b11b"
msgid "སྐུ་ སྟོད་ ལ་␣ས་ མེ་ འབར་བ་ སོགས་ དང་"
msgstr "Fire blazing from the upper part of the body and so forth, and"

msgctxt "4c0c9217c35e422292e7e089f068b277"
msgid "ནམ་མཁའ་ དངོས་པོ་␣ར་ སྒྲུབ་པ་ སོགས་ ནི་"
msgstr "Establishing space as a thing and so forth, are "

msgctxt "20ecf84da0b5448bbb0cfac9e1a8c12d"
msgid "རྒྱུ་ འདོད་ཡོན་ སྤོང་ ཞིང་"
msgstr "The cause sense pleasures are abandoned"

msgctxt "d5e853dc636f4ff6b1651334c986d04a"
msgid "བསམ་གཏན་ བསྒྲུབ་པ་␣ས་"
msgstr "As concentration is accomplished,"

msgctxt "08103f9ef71448908611589559d33741"
msgid "དེ་དག་ འབྱུང་བ་ གཤིས་ ལ་ གནས་པ་"
msgstr "The occurrence of these abide in the nature,"

msgctxt "7dd700d3ed17454d9e95c4aa06ea53fc"
msgid "རྒྱུ་ བསྒྲུབས་པ་␣ས་ ཐོབ་པ་ ལ་␣ས་"
msgstr "This is attained because of the accomplishment of the cause"

msgctxt "94c0aaf0ba3041ccbad9e5de7799574a"
msgid "གཞན་ དུ་ བལྟས་པ་␣ས་ འགྱུར་ ན་"
msgstr "If it were to become by examining others, "

msgctxt "d938aa42c4b1406bbe103591f7ed6163"
msgid "སྤང་བླང་ ལ་ ལྟོས་ མི་ དགོས་པ་␣འི་ ཕྱིར་ རོ །"
msgstr "Then it does not need to depend on abandonment or adoption."

msgctxt "acc314fe3c60401c95f8dfe864a773a2"
msgid "རྡོ་␣༽༽  མཚན་ཉིད་ མི་ ལྡན་པ་␣འི་ བླ་མ་␣ས་ ཀྱང་ ཡོན་ཏན་ སྐྱེ་ ནུས་ ཏེ་"
msgstr ""
"Vajra: It is said that even a guru who does not possess characteristics can "
"give rise to good qualities."

msgctxt "ac6db0cdc6a4422a9fd6d214f928c866"
msgid ""
"ཀུན་དགའ་བོ་ རྒྱུན་ཞུགས་ ལ་ སློབ་པ་␣ས་ དགྲ་བཅོམ་པ་ བྱུང་བ་ བཞིན་ ནོ་ ཞེས་ "
"ཟེར་ རོ །"
msgstr "Like Ananda, who was trained as a stream-enterer and became an arhat."

msgctxt "fcf949aa8c8a4200b46917a23bd4ebcb"
msgid ""
"འདི་␣ར་ ནི་ མཚན་ཉིད་ དང་ མི་ ལྡན་པ་␣འི་ བླ་མ་␣ས་ ཡོན་ཏན་ སྐྱེད་ མི་ ནུས་ ཏེ་"
msgstr ""
"In this [system], a guru without possessing characteristics cannot give rise"
" to good qualities because"

msgctxt "0e44290c472e4b58840ec23d8a43c151"
msgid "རང་ཉིད་ མ་ སྨིན་པ་␣ར་ གཞན་ སྨིན་ མི་ ནུས་པ་␣འི་ ཕྱིར །"
msgstr "Without maturing oneself, one cannot bring others to maturity."

msgctxt "6ad1380361544987b9c1596a7947c472"
msgid ""
"དཔེར་ན་ འཕོང་ མི་ ཤེས་པ་␣འི་ སློབ་དཔོན་ གྱིས་ གཞན་ ལ་ དེ་ སྟོན་ མི་ ཤེས་པ་ "
"བཞིན་ ནོ ། །"
msgstr ""
"It is like a master who does not know how to shoot [arrows] and cannot teach"
" it to others."

msgctxt "91a4e141b7e7468587ada8d2887df608"
msgid "དེ་ལྟར་ ཡང༌ །"
msgstr "Likewise,"

msgctxt "baa49b5c26ed4a55be6f6c60859e9daf"
msgid "ཆེད་ དུ་ བརྗོད་པ་␣ར །"
msgstr "According to the Udanavarga:"

msgctxt "a2fc491cd8e04d28b8da1798292c7852"
msgid "དམན་པ་ བརྟེན་པ་␣ས་ མི་ དག་ རྣམ་པ་␣ར་ འགྱུར །"
msgstr "By relying on an inferior, one becomes completely impure,"

msgctxt "256b09921bd24dc5959adf3c4604d7c6"
msgid "ཐད་ཀ་␣ར་ བབས་པ་ བརྟེན་པ་␣ས་ སོ་ ན་ གནས ། །"
msgstr "By relying on a direct descendent, one remains as before,"

msgctxt "847d40e4f33046cfa78d8c1448d0afc4"
msgid "གཙོ་བོ་ བརྟེན་པ་␣ས་ དམ་པ་ ཐོབ་པ་␣ར་ འགྱུར ། །"
msgstr "By relying on the chief, one attains the excellence"

msgctxt "37331ae9518840e395b8645e747ca6a9"
msgid "དེ་ཕྱིར་ བདག་པ་␣ས་ གཙོ་ གྱུར་ བརྟེན་པ་␣ར་ བྱ ། ཞེས་ དང་ །"
msgstr "Therefore, one should rely on the chief by oneself."

msgctxt "8392b63470b04da0a2292a2cd8bfe38c"
msgid "སྡུད་པ་␣ར ། སློབ་མ་ བཟང་པོ་ བླ་མ་␣ར་ གུས་ ལྡན་ དེ་དག་ གིས ། །"
msgstr ""
"According to the Condensed [Prajnaparamita In Verse]: The good disciples who"
" have devotion to the guru."

msgctxt "f021d7664ef74daa93a19d76e8ea531b"
msgid "བླ་མ་ མཁས་པ་ རྣམས་ ལ་ རྟག་ ཏུ་ བརྟེན་པ་␣ར་ བྱ ། །"
msgstr "[They] should always rely on learned gurus."

msgctxt "65176eb0dde240ff86c80a2f75a3b4e4"
msgid "ཅི་ཕྱིར་ ཞེ་ན་ མཁས་པ་␣འི་ ཡོན་ཏན་ དེ་ལས་ འབྱུང༌ ། །"
msgstr ""
"Well then, if it is asked why? The qualities of learned ones arises from "
"this."

msgctxt "4af87f7da21e4c10928c9688038af1c0"
msgid "དེ་ལྟ་␣འི་ མཚན་ཉིད་ ཕར་ཕྱིན་ ཐེག་པ་␣ར །"
msgstr "The definition of this in the Perfection Vehicle."

msgctxt "ed0ed2710ec0492691700433ba0a3a6d"
msgid "བཤེས་གཉེན་ དུལ་བ་ ཞི་བ་ ཉེར་ཞི་བ ། །"
msgstr "The spiritual friend who is tame, peaceful, and totally pacified,"

msgctxt "4a7d0c4afa4d4c5391bee298a73ebc8b"
msgid "ཡོན་ཏན་ ལྷག་པར་ བརྩོན་ བྱ་ ལུང་ གིས་ ཕྱུག  །"
msgstr ""
"Who is rich in scriptural authority and pursue diligently in excellent "
"qualities,"

msgctxt "93d36feae049430389961d77edd1a377"
msgid "དེ་ཉིད་ རབ་ཏུ་ རྟོགས་ ལ་ སྨྲ་མཁས་ ལྡན ། །"
msgstr "Who has realized thusness, who is skilled in speech, "

msgctxt "85efb369f44d4545916d1064af16f8ff"
msgid "བརྩེ་བ་␣འི་ བདག་ཉིད་ སྐྱོ་ངལ་ སྤང་ ལ་ བརྟེན ། །"
msgstr "Who is affectionate, and who has given up physical and mental fatigue"

msgctxt "4e4d2f34561049eb988ca88b6b20eed4"
msgid "རྟག་པ་␣ར་ དགེ་བ་␣འི་ བཤེས་གཉེན་ ནི ། །"
msgstr "The eternal spiritual friends are"

msgctxt "2a9329ed234e4d5594bc777850ac957f"
msgid "ཐེག་ཆེན་ དོན་ ལ་ མཁས་པ་ དང༌ ། །"
msgstr "Skilled in the meaning of the Great Vehicle,"

msgctxt "4f306bc38c93407484dba3b59970f368"
msgid "བྱང་ཆུབ་ སེམས་དཔ་␣འི་ རྟུལ་ ཞུགས་ མཆོག  །"
msgstr "And [they] have the supreme discipline of a bodhisattva."

msgctxt "aa3ad46283714616ba0c7e04af4f594a"
msgid "ཅེས་ སོ ། །"
msgstr "As said."

msgctxt "e215ff5e97dd487c89f081cf48a0db18"
msgid "སྔགས་ བླ་མེད་ ལ་␣ས ། དབང་ བཞི་ བསྐུར་བ་␣འི་ བླ་མ་ ནི །"
msgstr ""
"According to The Highest Yoga Tantra: The guru who confers the four "
"empowerments is as "

msgctxt "2e9f42a8ab1e47989f97b29c0836d69f"
msgid "ཞེས་ སོགས་ དང༌ །"
msgstr "And so on."

msgctxt "61beceabd0aa46e0b71c2861873bf399"
msgid "དུས་འཁོར་ ལ་␣ས །"
msgstr "According to the Kalachakra [Tantra]:"

msgctxt "ec76e1e079e840a986111a434c39aa6e"
msgid ""
"སངས་རྒྱས་ ཞལ་ འདི་ གང་ གི་ ཐུགས་ དང་ ཞལ་ལ་ གནས་པ་␣ར་ གྱུར་པ་ དེ་ ནི་ "
"དཔལ་ལྡན་ བླ་མ་␣འོ ། །"
msgstr ""
"This face of the Buddha, whose mind is and that which remains in the face is"
" the glorious guru."

msgctxt "45db018092dc47b4b12c90869f4738b5"
msgid "ཞེས་པ་ དེ་དག་ དང་ ལྡན་པ་ ནི་"
msgstr "Thus, those who possess these [qualities]"

msgctxt "16c33c92d4d447e4a5fa8b74e44b8c26"
msgid "བླ་མ་␣འི་ མཆོག་ ཡིན་པ་␣ས་ བརྟེན་པ་␣ར་ བྱ་ ཞིང་ ༈"
msgstr "Are the excellent gurus, one should rely on [them]."

msgctxt "d5919803234149c4b352641d6fa9ee31"
msgid "དེ་ལས་ གཞན་པ་ དག་ གི་ ཁྱད་པར་ བྱ་ དགོས་ ཏེ །"
msgstr "One must distinguish the other from that."

msgctxt "bd931903770d4fbca649dafd54b26971"
msgid "དོན་དམ་ བསྙེན་པ་ ལ་␣ས །"
msgstr "According to the Approaching Paramartha:"

msgctxt "4a38c5c645004cf0895e3e9beff2989e"
msgid "རྩོད་ ལྡན་ དབང་ གིས་ བླ་མ་ སྐྱོན་ དང་ ཡོན་ཏན་ འདྲེན །"
msgstr ""
"Due to having a dispute, it draws the faults and qualities of the guru."

msgctxt "c0932cfee69b4cf7bf97659e40be686d"
msgid "རྣམ་པ་ ཀུན་ ཏུ་ སྡིག་ དང་ བྲལ་བ་ ཡོད་ མ་ ཡིན ། །"
msgstr "There is no way to be completely free of degeneration."

msgctxt "fddee41394f04b5181c82c3c8807bed0"
msgid "དེ་ཕྱིར་ ཡོན་ཏན་ ལྷག་པ་ ཡང་ ནི་ དཔྱད་ བྱས་ ཏེ ། །"
msgstr "Therefore, after examining the special good qualities,"

msgctxt "152adff963b04ee7aa1b7c16e7114fad"
msgid "བུ་ རྣམས་ ཀྱིས་ ནི་ དེ་ ལ་ བརྟེན་པ་␣ར་ བྱ་བ་␣འོ ། ༑"
msgstr "Sons should rely on them."

msgctxt "90912bd82a8d4bddbeb69b4addb25850"
msgid "ཞེས་ སོ ། །"
msgstr "As said."

msgctxt "30f1b7fc7f3743b8af7d43fb7bd68af6"
msgid ""
"ཡོན་ཏན་ མེད་པ་␣ས་ གཞན་ ཡོན་ཏན་ ལ་ འགོད་པ་␣འང་ རང་ཉིད་ ཀྱིས་ མ་ ཡིན་ ཏེ །"
msgstr ""
"Without having good qualities, setting others in good qualities is not by "
"oneself."

msgctxt "a9eb3f0ba4284d60917a8cbe7cde1c62"
msgid "སངས་རྒྱས་ ཀྱི་ མཐུ་␣འི་ ཕྱིར །"
msgstr "It is because of the power of the buddhas."

msgctxt "bf0b8b79e25342d980d7da6ea38483be"
msgid "ཕག་པ་ སྡུད་པ་ ལ་␣ས །"
msgstr "According to the Condensed [Prajnaparamita In Verse]:"

msgctxt "af5cb818d64f437fa2fc799882648a90"
msgid "རྒྱལ་བ་␣འི་ ཉན་ཐོས་པ་ དག་ ཇི་སྙེད་ ཆོས་སྟོན་ དང༌ །"
msgstr "All the Dharma that the conqueror's hearers teach,"

msgctxt "17eb286c61864c32b4cbebc3e5c6b3a6"
msgid "འཆད་ དང་ རིགས་པ་ དག་ དང་ ལྡན་པ་␣ར་ བརྗོད་པ་ དང་ ། །"
msgstr "Explained and expressed with reasoning,"

msgctxt "71517ac84dfc4e9fbc641da01920ae3e"
msgid "མཆོག་ འཕགས་ བདེ་བ་ བྱེད་ དང་ དེ་ ཡི་ འབྲས་ ཐོབ་པ ། །"
msgstr "The excellent noble bliss and its result will be attained."

msgctxt "e2d525d86a1e47399babdc48af697584"
msgid "དེ་དག་ ཀུན་ ཀྱང་ དེ་བཞིན་ གཤེགས་པ་␣འི་ སྐྱེས་བུ་␣འི་ མཐུ ། །"
msgstr "All of these are the personal powers of Tathagata."

msgctxt "76c1f08a5aae4f30886a29362ade4ee6"
msgid "ཅི་ཕྱིར་ ཞེ་ན་"
msgstr "If asked why it is so?"

msgctxt "dcd6a383514b42e88c361efc54ee0262"
msgid "རྒྱལ་བ་␣ས་ ཆོས་ ཚུལ་ གང་ བསྟན་པ ། །"
msgstr "Whatever the Dharma taught by the conqueror,"

msgctxt "620c2f9672444fbaab71142a0a2f8dca"
msgid "དེ་ ལ་ མི་མཆོག་ སློབ་མ་␣ར་ གྱུར་པ་␣ས་ མངོན་ བསླབས་ ཤིང་ ། ༑"
msgstr "The best of people, having become his disciples, train in it."

msgctxt "b89fe93b60364d0997635834725b17a0"
msgid "མངོན་སུམ་ བྱས་ ནས་ བསླབ་པ་ ཇིབཞིན་ སྟོན་ བྱེད་ དེ ། །"
msgstr "And having actualized them, teach according to the training."

msgctxt "1a68be83b3214204acc2bf153ac71771"
msgid "སངས་རྒྱས་ མཐུ་␣ས་ བྱེད་ རང་ གི་ སྟོབས་ ཀྱི་ མཐུ་␣ས་ མ་ ཡིན །"
msgstr ""
"This is done by the power of the Buddha, not by the power of one's own "
"strength."

msgctxt "6b5cfe0f200a4907ba3cafe358e9957d"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "2d78dd427ac44c5fb817ddb27af302d7"
msgid ""
"རྡོ་␣༽༽  ལྷན་སྐྱེས་ ཀྱི་ ཡེ་ཤེས་ ཐོས་བསམ་ སྒོམ་ གསུམ་ གཏན་ཚིག་ ལྔ་␣ས་ གཞིག་ "
"ན་"
msgstr ""
"Vajra: It is said that when the co-emergent wisdom, hearing, contemplating, "
"and meditating are examined by  the five logical axioms,"

msgctxt "38b9ddfc8c7a4cdf8156201eb09a722e"
msgid "རྟོགས་པ་␣ར་ འདོད་པ་ དང་ གཞན་ ཡང་ མ་ངེས་པ་␣འི་ ཐབས་ མང་ ཟེར །"
msgstr ""
"Some are accepted as realization and there are many other non-definitive "
"methods."

msgctxt "01973969aa8246ef95ff526872bb4121"
msgid "འདི་␣ར་ ནི་ རྟོགས་པ་ སྐྱེད་ ཐབས་ གཙོ་བོ་ མེད་ མི་ རུང་བ་ ནི་"
msgstr ""
"In this [system], the main method that is indispensable for generating "
"realization is"

msgctxt "9a20c4c33c3c48d5a067a82497aa0b84"
msgid "དྭངས་བ་␣འི་ དད་པ་ མོས་གུས་ ཁོ་ན་␣ར་ ངེས་ ཏེ་"
msgstr "Definite only to pure confidence and devotion."

msgctxt "62def57f5b4d451587d66168f6452625"
msgid "དཀར་པོ་␣འི་ ཆོས་ ཐམས་ཅད་ ཀྱི་ རྟེན་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr "It is the support of all good qualities."

msgctxt "f5109491c9334380b7381aa4dc45e167"
msgid "དཀོན་ བརྩེགས་ ལ་␣ས །"
msgstr "According to the Heap of Jewels:"

msgctxt "7a95951c8be2499f87642e0d0cf3d650"
msgid "དད་པ་ མེད་པ་␣འི་ མི་ རྣམས་ ལ ། །"
msgstr "For those people without confidence,"

msgctxt "2d604688910f4abe98d8ee0f75932755"
msgid "དཀར་པོ་␣འི་ ཡོན་ཏན་ མི་ འབྱུང་ སྟེ ། །"
msgstr "The white qualities will not occur,"

msgctxt "983aa90502f845c5bc943d86bfe77434"
msgid "ས་བོན་ མེ་ ཡིས་ ཚིགས་པ་ ལ་␣ས ། ༑"
msgstr "From seeds burnt by fire"

msgctxt "0217c6964e7f4d9880b2f316a1a0fd06"
msgid "མྱུ་གུ་ སྔོན་པོ་ ཇི་བཞིན་ ནོ ། །"
msgstr "Just like green sprouts."

msgctxt "8a707cc14c96445a828aca0b1b545531"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "f4636d53eec0438e81a5cca0605c7f05"
msgid "ཆོས་ བཅུ་པ་␣འི་ མདོ་ ལ་␣ས །"
msgstr "According to the Ten Dharma Sutra:"

msgctxt "e8a583922d09450bbe2822abc6d82158"
msgid "གང་ གི་ འདྲེན་པ་ ངེས་འབྱུང་བ ། །"
msgstr "That which lead to the definite emergence"

msgctxt "f6d6f7d0c2d0421381a4528dc44b84a2"
msgid "དད་པ་ ཐེག་པ་␣འི་ མཆོག་ ཡིན་ ཏེ ། །"
msgstr "The best vehicle is confidence,"

msgctxt "5be9b8e9c2794f879712a279a4d36035"
msgid "དེ་ཕྱིར་ བློ་ དང་ ལྡན་པ་␣འི་ མི་␣ས ། །"
msgstr "Thus those people with rational mind,"

msgctxt "582677f0bb254cfeab28a74c69e795b6"
msgid "དད་པ་␣འི་ རྗེས་སུ་ འབྲང་བ་ བརྟེན །"
msgstr "Follow confidence and supported."

msgctxt "c96fbc54fd89435585e56d57d11c3b27"
msgid "ཅེས །"
msgstr "And."

msgctxt "62afe5dde75a4d3ab01a6b8d45c972fd"
msgid "ལམ་ གྱི་ ཆོས་ ཐམས་ཅད་ དྭངས་བ་␣འི་ དད་པ་ མོས་གུས་ ལ་ རག་ ལས་ཤིང་"
msgstr "All the dharmas of the path depend on pure confidence and devotion,"

msgctxt "c21d35f2839b4542808fb2c7585d10e6"
msgid "མཐར་ཐུག་ གི་ དོན་ ཡང་ དེ་ལས་ ཡིན་ ཏེ །"
msgstr "and the ultimate meaning also comes from that."

msgctxt "0d095d3573e94fcebddef0b66016ab13"
msgid "རྒྱུད་ བླ་␣ར །"
msgstr "According to The Highest Continuum:"

msgctxt "938a3b40630944da8cdd425a3cdfc7c4"
msgid "རང་བྱུང་ ཉིད་ ཀྱི་ དོན་དམ་ ནི་␣༑ །"
msgstr "The absolute self-arising is"

msgctxt "8d0c759b1d924f90b173e54f25d1c1bc"
msgid "དད་པ་ ཉིད་ ཀྱིས་ རྟོགས་ བྱ་ ཡིན ། །"
msgstr "To be realized by confidence itself."

msgctxt "c5c3544a959a425f8bb5b8ba730c039e"
msgid "ཉི་མ་␣འི་ དཀྱིལ་འཁོར་ འོད་འབར་བ ། །"
msgstr "The blazing light of the sun’s disk "

msgctxt "777498133ce742bb858c3f5a22921ada"
msgid "མིག་ མེད་པ་ ཡིས་ མཐོང་བ་ མེད ། །"
msgstr "Is not seen by those without eyes."

msgctxt "cedca50b46484f2a9a233fce9f991b87"
msgid "ཅེས་པ་␣ས་ ཆོས་སྐུ་␣ར་ འདུ་ཤེས་པ་␣ས་ མོས་གུས་ སྐྱེས་ ན །"
msgstr "Thus, if you generate devotion by perceiving the dharmakaya,"

msgctxt "bcdf7cdfe2f04314a6ea7489954ec4c3"
msgid "ཏིལླི་པ་␣ས །"
msgstr "Tilopa said:"

msgctxt "fd73b0e9a859463dbbe6696b4078c159"
msgid "མི་ བརྗེད་ གཟུངས་ ཐོབ་ ནཱ་ རོ་པ་␣ས ། །"
msgstr "Naropa, who has attained the retainer of forgetfulness,"

msgctxt "c1c3f404141e4409a1286451e4c00fe1"
msgid "བཅུ་གཉིས་ བར་ དུ་ ང་ མཉེས་ བྱས ། །"
msgstr "[He] pleased me for twelve years."

msgctxt "f17ff7c3724f478a8ccac2291a18d5d5"
msgid "ང་ ཡི་ རྟོགས་པ་ ཁོ་ ལ་ ཡོད ། །"
msgstr "He has my realization. "

msgctxt "a29c68165c3c4f01b774b29fb7873cf1"
msgid "ཅེས་པ་ ལྟར་ འབྱུང་བ་ ཡིན་ ནོ ། །"
msgstr "It occurred just as [he] said."

msgctxt "37914b668b014888b7cc9a12bced3ff6"
msgid "དད་པ་ མེད་ ན་ ཅིར་ འགྱུར་ སྙམ་ ན ། །"
msgstr "If one wonders what would happen if you had no confidence,"

msgctxt "0f462336fe604c24893efd00482d304b"
msgid "བྱང་ཆུབ་ ཐོབ་ མི་ སྲིད་ དཔེར་ན །"
msgstr "It is impossible to attain enlightenment, just as"

msgctxt "13580f21dab540bbadadb4846b8eed5d"
msgid "མཚོ་ གཏིང་ གི་ རྡོ་བ་ སྐམ་ ལ་ མི་ འབྱུང་བ་ བཞིན་ ནོ །"
msgstr "Stones in a deep lake will never dry."

msgctxt "40d5996cb3664a4580b7969ed35dc853"
msgid "རྡོ་␣༽༽  ལྟ་བ་␣འི་ མཐར་ཐུག་ དབུ་མ་ ཆེན་པོ་ འདོད་ མོད །"
msgstr ""
"Vajra: Although the ultimate view is accepted as the great middle way."

msgctxt "cc7c274d7cd44c7c9621bbc168bc9db0"
msgid "དེ་དག་ ནི་ ཡང་དག་པ་␣འི་ ལྟ་བ་ རྟོགས་པ་ དང་ ལྡན་པ་ མིན་ ཏེ །"
msgstr "They do not have the realization of the genuine view."

msgctxt "871b4e5827bf49b4bbcfdb194d3638eb"
msgid ""
"བློ་␣ས་ བཞག་པ་␣འི་ ཕྱིར་ ཡེ་ སྙིང་ གིས་ སྐྱེ་ མེད་ ཅེས་ དང་ སྟོང་ ཞེས་ དང༌ །"
msgstr ""
"Because it is posited by the mind, the primordial essence is called unborn "
"and empty"

msgctxt "750613796c194bce8526fab2d2155c33"
msgid "བདག་མེད་ ཅེས་ དང༌ །"
msgstr "no-self and"

msgctxt "933a4dbd05c944478ffcf850b9d30f78"
msgid ""
"སྟོང་པ་ཉིད་ དམན་པ་␣འི་ ཡིད་ ཀྱིས་ གང་ སྒོམ་པ་ དེ་ ནི་ འདི་ ལ་ བདག་ "
"བསྒོམ་པ་␣འོ ། །"
msgstr ""
"Whatever meditation on emptiness by a lesser mind is a meditation on self "
"here."

msgctxt "55fbb2a4970c44a7b5b4e17a64719537"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "647e2004e54047b49c709ee2e535f208"
msgid "རྩ་ཤེ་␣ར་ ལ་␣ས །"
msgstr "According to the Root Stanzas of the Middle Way:"

msgctxt "ccb55b12d7794342a94d8258abe638d1"
msgid "གང་ གི་ ཐུགས་ བརྩེས་ ཉེར་ བཟུང་ ན །"
msgstr "Hold closely by compassionate mind,"

msgctxt "77dd95dd3a184c949426c5b99fe3d568"
msgid "ལྟ་བ་ ཐམས་ཅད་ སྤོང་བ་␣འི་ ཕྱིར་␣༑ །"
msgstr "To abandon all the views,"

msgctxt "ff398fd31c6a4317b794233ffa09cf5e"
msgid "དམ་པ་␣འི་ ཆོས་ ནི་ སྟོན་ མཛད་པ །"
msgstr "[You] taught the holy dharma,"

msgctxt "5554ff2fccd341d3874f8f2046932581"
msgid "གོོོོ་ ཏམ་ དེ་ ལ་ ཕྱག་ འཚལ་ ལོ ། །"
msgstr "I pay homage to you, Guatama."

msgctxt "cef6786b83f543938ba9f9c0a086e394"
msgid "ཞེས་ སོ །། །"
msgstr "As said."

msgctxt "2518f2012e364fbab1f9e8e40ba8a73c"
msgid "དེ་␣འི་ ཕྱིར་ དོན་དམ་པ་␣ར་ བལྟ་ བྱ་ ལྟ་ བྱེད་ བྲལ་བ་␣ས་"
msgstr ""
"Therefore, since in the ultimate sense, there is no seer and nothing that is"
" seen,"

msgctxt "2b7ade984c4c4713bbc52e1c0b8f7e0b"
msgid "ལྟ་བ་ མི་ འདོད་ ཀྱང༌ ། །"
msgstr "Though the view is not accepted,"

msgctxt "fe4368a027f243ad800295d236322149"
msgid "ཀུན་རྫོབ་ ཙམ་ དུ་ དཔོན་སློབ་ ཀྱི་ རྟེན་འབྲེལ་ ཚོགས་པ་ ལ་␣ས་"
msgstr ""
"On the merely relative level, through the interdependent gathering between "
"the master and disciple,"

msgctxt "f8845be6eb2f48218ca12d9995f3ce73"
msgid ""
"ཆོས་ ཐམས་ཅད་ རང་སེམས་ དང་ དེ་ ལ་ ཆོས་སྐུ་ སྤྲོས་བྲལ་ དུ་ རྟོགས་པ་␣འི་ ལྟ་ "
"རྟོགས་ དབྱེ་␣ར་ མེད་ དམ །"
msgstr ""
"All phenomena are as one’s own mind, and the inseparable view and "
"realization of the realization of dharmakaya is free from elaboration."

msgctxt "5961bd64eff24d6f8e9dffa00cfa2811"
msgid "ཡུམ་ ལ་␣ས །"
msgstr "According to the Mother [Prajnaparamita Sutra]:"

msgctxt "789cdceeab564f03b2de61ad3d818b24"
msgid "སེམས་ ལ་ སེམས་མ་ མཆིས་ ཏེ །"
msgstr "Minds do not exist in the mind because,"

msgctxt "1cef66d4339d4e8f8073cbb54b92daa7"
msgid "སེམས་ ཀྱི་ རང་བཞིན་ ནི་ འོད་གསལ་བ་␣འོ ། །"
msgstr "The nature of the mind is luminosity."

msgctxt "7386264b860440769e8d8cc001f9170e"
msgid "ཞེས་པ་␣ས་ སྣང་སྲིད་ ཡེ་ཤེས་ སུ་ འཆར་བ་␣ར་ བྱེད་པ་"
msgstr ""
"Thus, the whole of appearance and existence appear as primordial wisdom."

msgctxt "28865c534e594dd2aab3194083f9392a"
msgid ""
"དེ་ ནི་ ལྟ་བ་␣འི་ མཆོག་གྱུར་ རྟོགས་པ་ དང་ སོ་སོ་␣ར་ ཐ་ མི་ དད་ དུ་ ལྡན་པ་ ལ་"
" བཞེད་ དོ ། །"
msgstr ""
"This is accepted as an excellent view endowed with and not separate from "
"realization."

msgctxt "0b65f709a76c4de2aeb100dae14c909b"
msgid "གནས་ལུགས་ རྟོགས་པ་ ལ་"
msgstr "To realize the actuality,"

msgctxt "a0f392ce6840477c8204927a8253d57f"
msgid "དབུ་ ཕྱག་ རྫོགས་ གསུམ་ ཁོ་ན་ མཐོ་བ་ ཡིན་པ་␣ར་ འདོད་ ཀྱང༌ །"
msgstr ""
"Although it is accepted that the three- Madhyamaka, Mahamudra, and Dzogchen "
"are considered the highest."

msgctxt "122359257f5e42cf9b315a842df27733"
msgid "འདི་␣ར་ ནི་ ཆེན་པོ་ དེ་ གསུམ་ གྱིས་ གནས་ལུགས་ ལ་མ་ རེག་པ་ ཡིན་ ཏེ །"
msgstr "In this [system], these three greatnesses do not touch the actuality."

msgctxt "ceb525b9fa9f40e0b221695508e55bd5"
msgid "མདོ་ ཏིང་འཛིན་ རྒྱལ་པོ་ ལ་␣ས །"
msgstr "According to The King of Meditative Concentration Sutra:"

msgctxt "dee2fe33d7864a6aba31ad9281cac970"
msgid "ཡོད་ དང་ མེད་ ཅེས་བྱ་བ་ མཐའ་ ཡིན་ ཏེ །"
msgstr "So-called existence and non-existence are extremes, "

msgctxt "41038e14b9cb4b1cb055c648ae4bf364"
msgid "དེ་བཞིན་ གཙང་ དང་ མི་གཙང་ འདི་ ཡང་ མཐའ ། །"
msgstr "Likewise, purity and impurity are also extremes,"

msgctxt "a4697c084ce1461a82ea0f0e8acc6bed"
msgid "དེ་ཕྱིར་ མཐའ་ འདི་དག་ ནི་ རྣམ་ སྤང་ ནས ། །"
msgstr "Therefore, having abandoned these extremes,"

msgctxt "35a103ee7bc047c287327b34c4d19143"
msgid "མཁས་པ་␣ས་ དབུས་ ལ་␣འང་ གནས་པ་␣ར་ མི་ བྱ་␣འོ ། །"
msgstr "The wise never even abide in the middle."

msgctxt "8c0480b5db454e05bb0be6d30e082407"
msgid "ཞེས་ དང་ །  ཕལ་ཆེན་ ལ་␣ས །"
msgstr "And. According to the Avatamsaka [Sutra]:"

msgctxt "9810c3d997074c84ba68c793fcc5ae91"
msgid "ཇི་ལྟར་ བར་ སྣངཤིན་ ཏུ་␣x"
msgstr "Like how it appears..X"

msgctxt "0a20da5e4ddf46dea596486b6718603b"
msgid "དེ་བཞིན་␣x"
msgstr "Likewise, X"

msgctxt "b681c49a751540c696a3c2f02f30eda2"
msgid "ཡིད་ དང་སེམས་ ཀྱིས་ ཡུལ་ དུ་ ཤེས་ མ་ ཡིན །"
msgstr "The mind and knower do not know objects."

msgctxt "e82350719b9a47bdb120d8210f8633f9"
msgid "ཅེས་པ་ བཞིན་ བློ་ དང་སེམས་ ཚིག་ གིས་ གཏན་ ལ་ མི་ ཕབ་བོ ། །"
msgstr "As it is said, the mind and knower cannot be determined by words. "

msgctxt "c86be79e71c448919dc962f8d1666ffa"
msgid "འོ་ན་ ཅི་ ཞེ་ན །"
msgstr "Well then, if it is asked why?"

msgctxt "05b305baf8a64f25b98a12d28499604f"
msgid "སྨྲ་ བསམ་བརྗོད་ མེད་ ཤེས་རབ་ ཕ་རོལ་ ཕྱིན །"
msgstr ""
"Beyond expression, beyond thought, beyond description, Prajnaparamita."

msgctxt "409e91d6933047c0a17d9d6f24ae88ad"
msgid "མ་ སྐྱེས་ མི་ འགག་ ནམ་མཁ་␣འི་ ངོ་བོ་ ཉིད །"
msgstr "Unborn and unceasing, the essence of space,"

msgctxt "3fec82c6d3c04b98ad28a643f05e222f"
msgid "སོ་སོ་ རང་རིག་ ཡེ་ཤེས་ སྤྱོད་ཡུལ་བ ། །"
msgstr "It is the sphere of the wisdom of the individual self-knowing,"

msgctxt "2bd80f11cc22479cb961085bb47579d8"
msgid "དུས་གསུམ་ རྒྱལ་བ་␣འི་ ཡུམ་ ལ་ ཕྱག་ འཚལ་ ལོ ། །"
msgstr "Homage to the mother of the conquerors of the three times."

msgctxt "665189895fa04d98b306769c003dbde4"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "8c2ee9b1b93b4895abcbe3e1e0ce8794"
msgid "ཆོས་རྒྱལ་ སྲོང་ བཙན་ གྱིས ། །"
msgstr "Choegyal Songtsen says:"

msgctxt "4b3a97e10f90499aad338c3ea8270769"
msgid "བསམ་པ་ ཐམས་ཅད་ བློ་ ཡིན་ གྱི ། །"
msgstr "Since all thoughts are the mind,"

msgctxt "dcf1991ec7db4197ba7940eb799d9a03"
msgid "བློ་ ཡི་ བྱེད་པ་ ཞོག་ ལ་ ཐོང༌ ། །"
msgstr "Place aside the activity of the mind,"

msgctxt "706b929cd53f41d9bc7ad1e01d98f20c"
msgid "ཞོག་ ཅེས་བྱ་བ་␣འང་ ཚིག་ ཡིན་པ་␣ས ། །"
msgstr "Since \"place aside\" is also a word, "

msgctxt "a4b854c09df84a7c91ec518de35735ce"
msgid "ཚིག་ གི་ འཛིན་པ་ བོར་ ལ་ཐོད །"
msgstr "Put aside the grasping of words."

msgctxt "fea0b5e030734b97babe19d31616b7ec"
msgid "ཞེས་ དང༌ །  ཏེ་ལོ་པ་␣ས །"
msgstr "Thus, Tilopa said:"

msgctxt "afb1b3f993904f3c93e530ed69bcbc44"
msgid "བློ་ ཡི་ ཆོས་ ཀྱིས་ བློ་འདས་ དོན་ མི་ རྟོགས །"
msgstr ""
"The phenomena of the mind do not realize the meaning of those that "
"transcendent over the rational mind,"

msgctxt "77321ff1b4994b74b6ea8e8a1e303e7f"
msgid "བྱས་པ་␣འི་ ཆོས་ ཀྱི་ བྱར་མེད་ སངས་ མི་ རྒྱ །"
msgstr ""
"The non-action of the produced phenomena does not become enlightenment."

msgctxt "7f292c7f65e04ce99a692c9458101f3c"
msgid "ཞེས་པ་␣ས་ ཚིག་ གིས་ སྨྲ་␣ར་ མེད །"
msgstr "Therefore, it is not expressed by words,"

msgctxt "46eb1f38a15c4b9ca0e71f23965a17bc"
msgid "བརྗོད་པ་␣ས་ གཏན་ ལ་ མི་ ཕེབ །"
msgstr "It is not established by expression,"

msgctxt "6927188551304fe1bc8290da6834536d"
msgid ""
"དཔེ་␣ས་ མཚོན་ དུ་ མེད་པ་␣འི་ འཁོར་འདས་ གཉིས་ མེད་ ཀྱི་ དོན་ རྟོགས་པ་ དེ་ "
"ཡིན་ ནོ ། །"
msgstr ""
"It is the realization of the meaning of the non-duality of samsara and "
"nirvana that cannot be illustrated by examples."

msgctxt "df25007d9ad2481686f3867bc048f17c"
msgid "མིང་ དུ་ བཏགས་པ་ གསུམ་པོ་ ནི་"
msgstr "The three things that are named are"

msgctxt "35f69c9ebcd3419fa401b895a1600db3"
msgid "ཟླ་བ་ སྟོན་པ་␣འི་ འཛུབ་ མོ་ བཞིན་ ནོ་␣༑ །"
msgstr "Like the fingers of Dawatonpa."

msgctxt "f2579ac77aba4705a555f3c328eea365"
msgid "དེས་ན་ འདི་ ལ་ དཀར་པོ་ ཆིག་ཐུབ་ ཅེས་ བཏགས་པ་ ལ་␣ས་"
msgstr "Therefore, this is called an all-curing single white [panacea]."

msgctxt "b62b4f9f02df48ef996606163230aea7"
msgid ""
"འགའ་ཞིག་ གསུམ་ དུ་ འགྱུར་བ་␣འི་ ཐལ་བ་ འཕེན་པ་ ནི་ བློ་གྲོས་ རྩིང་ སྟེ །"
msgstr "Some people imply an absurd consequence of becoming three."

msgctxt "f0a047cc61df45e09405e186a203e411"
msgid "དེ་ལྟར་ ན་ མཐར་ཐུག་ གཉིས་ མེད་ བྱ་བ་ ཡོད་པ་␣འི་ ཆོས་ ཞིག་"
msgstr ""
"In that case, ultimately, a phenomenon that has the action of non-duality"

msgctxt "ad0fe696d46c4e998250617f1764c071"
msgid "གཏན་ མི་ རྙེད་པ་␣ར་ འགྱུར་ རོ ། །"
msgstr "Would never be found."

msgctxt "68434048f0194062a95d59d9bc4043cb"
msgid "དེ་བས་ན་ རྟོགས་པ་␣འི་ མཆོག་ གོ  །"
msgstr "Therefore, this is the supreme realization."

msgctxt "cb70e80c425e4f0bacfd63028f06d228"
msgid "རྡོ་␣༽༽  གནས་ལུགས་ ཐོས་བསམ་ སྒོམ་ གསུམ་ གྱི་ རྟོགས་པ་␣ར་ འདོད་ མོད །"
msgstr ""
"Vajra: Although it is accepted that the actuality is realized through "
"hearing, contemplation, and meditation."

msgctxt "a5f9987458794c329e2c7b27c59ee3e1"
msgid "འདི་␣ར་ ནི་ ཐོས་བསམ་ སྒོམ་པ་␣འི་ སྟོང་ཉིད་ ནི་ ཤོ་␣ར་ གོལ་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], the hearing, contemplation, and meditation of emptiness is"
" a point at which one becomes lost and goes astray."

msgctxt "a8e72491c1b64f86b1d119b4ef36056f"
msgid "རིག་པ་␣ས་ གཞལ་ བློ་␣ས་ བརྟགས་ ཚིག་ གིས་ གཏན་ ལ་ ཕབ་པ་ དེ་"
msgstr ""
"That which is evaluated by intelligence, analyzed by the mind, and "
"determined by words, "

msgctxt "1be69dcd592145f6b92dd5944e3949db"
msgid "སྟོང་ཉིད་ ཀྱི་ དོན་སྤྱི་ བློ་ཡུལ་ དུ་ བྱས་པ་ ལ་␣ས་ མཚན་ཉིད་ མིན་པ་␣ས་"
msgstr ""
"The generic image of emptiness is taken as the object of the mind but not "
"its characteristic."

msgctxt "adc0fc6c49f94f8899c83f349e091b5a"
msgid "མཚན་ཉིད་པ་ མཐར་ཐུག་ ལྟ་ རྟོགས་ དབྱེ་␣ར་ མེད་པ་"
msgstr ""
"This is because it is said that the dialecticians, without any "
"differentiation of the ultimate view and realization,"

msgctxt "a07ea68b24294f2faf5f6e8462d99296"
msgid "དེ་␣འི་ ཤོ་␣ར་ ས་ དང་ གོལ་ས་ ཡིན་པ་␣ར་ གསུངས་པ་␣འི་ ཕྱིར །"
msgstr "Is a point at which one becomes lost and goes astray."

msgctxt "f61e8d4a3c884ab1bfb1deb6cf702ba1"
msgid "མགོན་པོ་ བྱམས་པ་␣ས །"
msgstr "Lord Maitreya says:"

msgctxt "d612f1a30f814269ae116e92c908ba41"
msgid "ཕྲ་ ཕྱིར་ ཐོས་པ་␣འི་ ཡུལ་ མིན་ ཏེ ། །"
msgstr "Because it is subtle, it is not an object of hearing,"

msgctxt "ca81dae0507146d6ab765d5481b741bf"
msgid "དོན་དམ་ ཕྱིར་ ན་ བསམ་པ་␣ས་ མིན ། །"
msgstr "Because it is absolute, it is not [an object] of mind,"

msgctxt "7f21f8a73d7f4ac39d684b2ec62c05f8"
msgid "ཆོས་ཉིད་ ཟབ་ ཕྱིར་ འཇིག་རྟེན་པ་␣འི ། །"
msgstr "Because the true nature of phenomena is profound, "

msgctxt "35ac67c5146d4fb6b234eab4965fe8cc"
msgid "སྒོམ་པ་ ལ་སོགས་ ཡུལ་ མ་ ཡིན །"
msgstr "It is not an object of worldly meditation, and so forth."

msgctxt "e78cffc19d9e4191b84b69f92dd76fae"
msgid "ཅེས་ དང༌ །"
msgstr "And."

msgctxt "291b0abbef1b4b1b8bda912ac727c56c"
msgid "འབྲི་གུང་ ཆོས་རྗེ་ རིན་པོ་ཆེ་␣ས །"
msgstr "Drigung Choje Rinpoche said: "

msgctxt "c8f1f1e0c4f74804b096eb04a322941b"
msgid "རང་སེམས་ མི་ སྒོམ་ སེམས་ ཀྱི་ ཡུལ་མི་ བསྒོམ ། །"
msgstr ""
"Without meditating on one's own mind, one will not meditate on the object of"
" the mind,"

msgctxt "88ffa857ecda4e27b3c93352d9153e77"
msgid "སྒོམ་ དུ་ མེད་པ་ ཡང་ ནི་ མི་ སྒོམ་ སྟེ ། །"
msgstr "Do not meditate on what is not meditation."

msgctxt "ae49e39dc6034a75b2523f236bb70557"
msgid "མ་ བསྒོམ་པ་ ཡི་ བསྒོམ་ ཞིག་ འོང་བ་ ཡི ། །"
msgstr "When meditation comes from without meditation."

msgctxt "ffdf28551e484b10a434001d78a8ed23"
msgid "རེ་བ་ དེ་ཡང་ བསྒོམ་པ་␣ར་ མི་ བྱ་␣འོ །"
msgstr "Do not meditate on that hope also."

msgctxt "c126d2898df147dd9068778a9266c62c"
msgid "ཞེས་པ་␣ས་ མདོ་␣ར་ བསྡུ་ ན་ སྟོང་པ་␣ར་ ཤོ་␣ར་ གོལ །"
msgstr "In conclusion, one will stray into emptiness,"

msgctxt "cc342fb549254c5ebd6c9387ec4dd7ae"
msgid "སྣང་བ་ ཤོ་␣ར་ གོལ །"
msgstr "stray into appearance,"

msgctxt "f631eba316cc4c709842f5a4acc2a73f"
msgid "རྒྱུ་འབྲས་ ཀྱི་ རྟོག་པ་␣ར་ ཤོར་བ་␣འོ ། །"
msgstr "and stray into the conceptuality of cause and effect."

msgctxt "f233c72a74e14ffd95abb062bb50c6ad"
msgid "རྡོ་␣༽༽  ཆོས་ཉིད་ གཏན་ ལ་ ཕབ་ ནས་ ཡུལ་ དུ་ བྱེད་པ་ ལྟ་བ་"
msgstr ""
"Vajra: After determining the nature of phenomena, the view that takes it as "
"its object,"

msgctxt "84794251bade43e39bbfe228ebba04d8"
msgid "དེ་␣འི་ སྟེང་ ནས་ ཞི་གནས་ སྒྲུབ་པ་"
msgstr "Based on that, accomplishing the calm abiding,"

msgctxt "616d9979316a4b95aee5fd6c8b70dcd2"
msgid "སྒོམ་པ་␣འམ་ གདམ་ངག་ ལྟར་ བསྒོམ་པ་␣ས་"
msgstr "By meditating or by meditating according to the instructions,"

msgctxt "09c8277553414b868feb32f034e09f6e"
msgid "བདེ་ གསལ་ མི་ རྟོག་ གི་ ཉམས་ སྐྱེས་པ་ སྒོམ་པ་ དང༌ །"
msgstr ""
"The meditation on the experience of bliss, clarity, and non-conceptuality "
"that has arisen and"

msgctxt "2a5a001b328c43ab8f540fe044d61fea"
msgid "དེ་ལས་ བྱུང་བ་␣འི་ དོན་སྤྱི་ ནི་ ལྟ་བ་␣ར་ བྱེད་ དོ །"
msgstr "The generic image that arises from that is the view."

msgctxt "6dd72b944fc94b6385633a1e20c78811"
msgid "འདི་␣ར་ ནི་ དཔོན་སློབ་ ཀྱི་ རྟེན་འབྲེལ་ ལ་␣ས་ བྱུང་བ་␣འི་"
msgstr ""
"In this [system], the genuine view that arises from the interdependence of "
"master and disciple,"

msgctxt "e23571b7779649f3b9b89941cafc57a8"
msgid "ལྟ་བ་ ཡང་དག་ རྟོགས་པ་ དབྱེ་␣ར་ མེད་པ་ གསུམ་ གྱིས་"
msgstr "Through the three inseparable realizations,"

msgctxt "ebdbd959117b4908b55255f9c6d0bde0"
msgid ""
"མ་ རེག་པ་␣འི་ རྟོགས་པ་ དེ་ ལ་ འདྲིས་ ཤིང་ རྒྱུན་ མ་ ཆད་ གོམ་པ་␣ར་ བྱེད་པ་ "
"ནི་"
msgstr ""
"Familiarizing oneself with this realization that has not yet been contacted "
"and habituating uninterruptedly is"

msgctxt "9c8a7ca344924b1495a5513891dd9ae4"
msgid "སྒོམ་པ་ མཐར་ཐུག་ སྟེ །"
msgstr "The ultimate meditation."

msgctxt "be116658e4fd4a3f8c46553c673221a4"
msgid "བདེ་མཆོག་ རྩ་རྒྱུད་ ལ་␣ས །"
msgstr "According to the Root Tantra of Cakrasamvara:"

msgctxt "c9993148e00c409b97ea72e96aa5b5fe"
msgid "ཡིད་ ནི་ ནང་ དུ་ ཆུད་ གྱུར་ ན ། །"
msgstr "If the mind is brought within,"

msgctxt "f81505356b0047ee99ff828ea42f57a9"
msgid "གང་ འདོད་པ་ ཡི་ དངོས་གྲུབ་ ཐོབ ། །"
msgstr "One will attain whatever actual accomplishment one desires."

msgctxt "f4dc904cb82e414a82bbb0934f8a430c"
msgid "ཅེས་ དང་ །"
msgstr "And."

msgctxt "446ebe297f064093aab127f5f1dace45"
msgid "མགོན་པོ་ འབྲི་གུང་པ་ ཆེན་པོ་␣ས ། །"
msgstr "The great Lord of Drigungpa says:"

msgctxt "da8728ff57424fb9a4864ff9afe06286"
msgid "བརྩོན་འགྲུས་ ཆེན་པོ་␣འི་ གོ་བ་ ནི ། །"
msgstr "The understanding of the great perseverance is"

msgctxt "52406d992f514867b64c5fb746a23d85"
msgid "དྲན་པ་ རྒྱུན་ ཆད་ མེད་པ་ ཡིན །"
msgstr "Uninterrupted mindfulness."

msgctxt "b451a6fe990c4dfe9d83c000dc8062ff"
msgid "ཅེས་ དང་ །"
msgstr "And."

msgctxt "60e9beb2f05647c0863e7c03ce7a3341"
msgid "དུས་གསུམ་ སངས་རྒྱས་ ཀྱི་ གཞུང་ལམ་ དེ །"
msgstr "The main path of the buddhas of the three times,"

msgctxt "77abaf40d1004561a83278b85d4fd2c6"
msgid "དུས་རྒྱུན་ ཆད་ མེད་པ་␣ར་ མ་ ཤེས་ ན ། ། །"
