msgstr "Then, the winds from both nostrils"

msgctxt "fe1c84236c934a879560f63b55233593"
msgid "ལྕགས་ཀྱུ་ བཞིན་ དུ་ དགུག་པ་␣ར་ བྱ ། །"
msgstr "Draw in like an iron hook,"

msgctxt "5c38f0f8e127486f9d20e35d0b6f9417"
msgid "དེ་ཡང་ འཇམ་ ལ་ རིང་བ་␣འོ ། །"
msgstr "That too, gently and long."

msgctxt "b982cbb81473400f83153dc3bd39d901"
msgid "དེ་ ཡིས་ རླུང་ ནི་ རང་གནས་ ཚུད ། །"
msgstr "By that the winds will enter their own places,"

msgctxt "b12a076de3e14d58b7970e1cfc2e1394"
msgid "དྲག་ན་ རྩ་ གནས་ གཞན་ དུ་ དབྱེ་␣ར ། །"
msgstr "If strong, they divert to other channel locations."

msgctxt "45cc763982374eb5adfa3b0548d12bb8"
msgid "དེ་ ནི་ རྔུབ་པ་␣འི་ རླུང་ སྦྱོར་ ཡིན་␣༑ ༑"
msgstr "This is the prana practice of inhalation."

msgctxt "c8c02e55449644588007232be921a911"
msgid "རླུང་ ནི་ གཡས་གཡོན་ གཉིས་ ན་མ་␣ར ། །"
msgstr "The winds are on the right and left, moving downward,"

msgctxt "7736063489c348f48a2e65885bb454ab"
msgid "ལུག་ རྒྱུད་ རྒྱུ་མ་ ཕུ་␣ས་ བཏབ་ བཞིན ། །"
msgstr ""

msgctxt "b7abb8a7183147899edc4be839ab3c7c"
msgid "ཧ་ ར་ར་ ནི་ སོང་ ནས་ ཀྱང་ ། །"
msgstr "Although Harara went away,"

msgctxt "6f780b9ea42e4e1cb5510950f5e5ef6a"
msgid "དབུ་མ་␣འི་ ནང་ དུ་ ཞུགས་པ་␣ར་ བསམ ། །"
msgstr "Thought that they entered the central [channel]."

msgctxt "0271b606deb045feb4b2fa1a4e96ee69"
msgid "དེ་ ནི་ འགང་བ་␣འི་ རླུང་ སྦྱོར་ རོ ། །"
msgstr "That is the prana practice of filling."

msgctxt "6ec4a469b8ab46f8acac0f41c6e87fe7"
msgid "དེ་ནས་ ཕོ་བ་␣ར་ རླུང་ བཅུག་ ལ་␣༑ །"
msgstr "Then, the winds are brought into the stomach,"

msgctxt "3496f67c3be24651a8eb0ae6d1166b4c"
msgid "ཐུབ་ ཀྱང་ དྲག་ ཏུ་ མནན་པ་␣ར་ བྱ ། །"
msgstr "Even if one can, it should be suppressed strongly."

msgctxt "26af829af72b42cc9759b342fa40107a"
msgid "མི་ ཐུབ་ དུས་ སུ་ ཅུང་ཟད་ རྔུབ ། །"
msgstr "When one is not able to [hold], inhale a little."

msgctxt "7da11c1e753f4fd98e51cf4061dfc65f"
msgid "དེ་␣ས་ ཀྱང་ མ་ ཐུབ་ སྣ་ གཉིས་ ནས ། །"
msgstr "If that is not able to, from the two nostrils,"

msgctxt "46c2d15cff704f12a5869a3e214fd439"
msgid "སེ་གོལ་ གཏོགས་པ་␣འི་ ཚད་ ཙམ་ ཞིག  །"
msgstr "With the span of a finger snap,"

msgctxt "b7f248efadf74d8f95c406cf4c7eb382"
msgid "ཕྱི་རུ་ བཏང་ ལ་ ལྷག་མ་ བསྡམས ། །"
msgstr "Release outside and restrain the rest."

msgctxt "cee0a4dcb4804a6a93031abd5d4806e3"
msgid "དེ་ ནི་ གཞིལ་བ་␣འི་ རླུང་ སྦྱོར་ རོ ། །"
msgstr "That is the prana practice of removing,"

msgctxt "74e2a11dd90d4ac2bf1f54289834c4eb"
msgid "བསྡམས་པ་␣ས་ མ་ ཐུབ་ གཏོང་ དུས་ སུ ། །"
msgstr "When unable to restrain during realising, "

msgctxt "b684cb97c6244d08b729e8e73f7e18ec"
msgid "དངོས་ སུ་ སྣ་བུག་ གཉིས་ ན་ ཡར ། །"
msgstr "Upward directly from both nostrils,"

msgctxt "cfc5fcfc6aaf4506aef29abbe667a426"
msgid "ཆ་ གཅིག་ ཙམ་ གཅིག་ དལ་བར་ བཏང༌ ། །"
msgstr "One side of it was released slowly."

msgctxt "087fa9226ce94c0fb961b47a9960ec35"
msgid "དམིགས་པ་ དབུ་མ་␣འི་ ནང་ ལ་ ཡར ། །"
msgstr "Visualize upward to the central [channel], "

msgctxt "d3d379f1b83a4288b496a83091be386f"
msgid "རྩལ་པོ་ཆེ་ ཡིས་ མདའ་ འཕང་ བཞིན །"
msgstr "Like shooting an arrow by the Great Strength."

msgctxt "5071736f476940379744dc49bc27721d"
msgid "ཚངས་པ་␣འི་ སྒོ་ ནས་ ནམ་མཁའ་ ལ ། །"
msgstr "Through the door of Brahma to the sky,"

msgctxt "94e0d79ec1af43f387d9532cdad304b9"
msgid "སྔོ་ ནི་ ཕྱུར་ཕྱུར་ འགྲོ་བ་␣ར་ བསམས ། །"
msgstr "Thinking that green plants heave up,"

msgctxt "46a2895a5377428aaf41a01c81a0b161"
msgid "མདའ་ ལྟར་ འཕངས་བ་␣འི་ རླུང་ སྦྱོར་ རོ ། །"
msgstr "That is the prana practice like throwing an arrow."

msgctxt "74b9a0fad817411ab66ba3478b445a6d"
msgid "ཞེས་ དེ་ བཞི་པོ་ ཟབ་པ་␣ར་ འདོད་ ཀྱང་ །"
msgstr "Thus, although these four are accepted to be profound."

msgctxt "137d273f5796445ba17a1a86ce03e7c3"
msgid "འདི་␣ར་ ནི་ རླུང་ མི་ འཛིན་པ་␣ར་ མ་ བཅོ་␣ས་"
msgstr "In this [system], without holding the wind, without altering"

msgctxt "306109c05b5b4b9098339d4c79c385eb"
msgid "ལྷུག་པ་␣ར་ འཇོག་པ་ ཉིད་ གནད་ ཟབ་པ་␣ས །"
msgstr "Resting loosely is the essential point."

msgctxt "e97b74295a20419a934153682cb4bb3f"
msgid "རླུང་ སེམས་ ཐ་དད་ མེད་པ་␣ས་"
msgstr "Since there is no difference between wind and mind,"

msgctxt "ab49b15723bd46ee83e6ef6dc7b325f7"
msgid "རླུང་ ལ་ རྩོལ་ འབུང་ འདོན་པ་␣འི་ རྩ་␣ར་ རྩི་␣ར་ གཡོ་འགུལ་ མང་པོ་ ལ་"
msgstr ""
"Many subtle movements of channels with effort breathing and exhalation,"

msgctxt "890f16ece0094114bbb16f1019a72ca9"
msgid "འཁྲུལ་ འཁོར་ སྐད་ དུ་ བཏགས་ ནས་ བྱས་ ཀྱང་"
msgstr "Although it is done by naming it as the yogic exercises,"

msgctxt "c092b814a2cd4606984d73ee5b0be7e6"
msgid "སེམས་ དངོས་པོ་␣འི་ གནས་ལུགས་ མ་ མཐོང་ ན་"
msgstr "If the actuality of the thing is not seen by the mind, "

msgctxt "9a1aa2c2a68e463d895ee34cbbe37d03"
msgid "གནས་སྐབས་ ལྟར་ སྣང་"
msgstr "It appears as if it were temporary."

msgctxt "7c8c7f02cbbd4893ac7e7cef5ceb7273"
msgid "ཀུན་རྫོབ་པ་␣འི་ ཡོན་ཏན་ ཕྲན་བུ་ སྐྱེ་སྲིད་ ཀྱང་"
msgstr "Although some good qualities of the relative may arise, "

msgctxt "401faa0d399b4c8eb8156240a8bd3f27"
msgid "མཐར་ཐུག་ གི་ ས་ཆོད་ ཆེ་བ་␣འི་ གོ་ ཆོད་པོ་ མི་ འབྱུང་བ་␣ས །"
msgstr "It will not be useful in the final decisive stage."

msgctxt "1186c5861f01452ea76894486bf1a98b"
msgid ""
"རླུང་ སེམས་ དབྱེ་␣ར་ མེད་ ཀྱི་ རྟོགས་པ་␣འི་ ཡེ་ཤེས་ བསྐྱེད་པ་␣འི་ རླུང་ གི་ "
"གནད་ འཆིང་བ་ མ་ བྱས་ བྱར་མེད་ དུ་"
msgstr ""
"The essential points of the winds that generate the wisdom of realizing the "
"inseparability of the winds and mind are bound and inevitable."

msgctxt "9eff996b7eca45608ed254fc6b69aae0"
msgid "ཉམས་ སུ་ ལེན་པ་ ནི་ བཤད་རྒྱུད་ རྡོ་རྗེ་ ཕྲེང་བ་ ནས་ གསུངས་པ་ ལྟར་"
msgstr "The practice is as stated in the Vajra Garland Explanatory Tantra."

msgctxt "7faa14a5118b4e1aa532675d8544e32c"
msgid "ཉམས་ སུ་ ལེན་པ་ གནད་ ཆེ་ སྟེ་"
msgstr "The practice is crucial."

msgctxt "5da66fe9a66647ad83dc8fcfb4670016"
msgid "ཚུལ་ ནི་ གཏུམ་མོ་ གསུམ་ ཁྲིད་ དུ་ རྟོགས་པ་␣ར་ བྱོས་ ཤིག"
msgstr "The mode should be realized through the three teachings of tummo."

msgctxt "54d04fb0c20b42a2a81c511291d18c95"
msgid "༑་␣ལྷན་␣༽༽  འཕོ་བ་ ནི་ ཧཱུཾ་ ངམ་ ཡིག་འབྲུ་ གང་རུང་ ལ་ བརྟེན་ ནས་"
msgstr "Addendum: Transference is based on either the HUM or the syllable."

msgctxt "a176de1d6f78462d99d92d6ac09b1869"
msgid "བླ་མ་␣འམ་ ཡི་དམ་ གྱི་ ཐུགས་ཀ་␣ར་ འཕོ་བ་ ཡིན་ ཟེར་ ཡང་"
msgstr ""
"It is said that it is transferred into the heart of the guru or the personal"
" deity."

msgctxt "783e8804dcb64c3eadef04b3dfd012a2"
msgid "དེ་ ནི་ རིམ་གྱིས་པ་␣འི་ དབང་ དུ་ བྱས་ ཀྱི །"
msgstr "This is in terms of the gradual stage."

msgctxt "2330c4de34f94c1ea0aabcc877aaed66"
msgid ""
"འདི་␣ར་ མཐར་ཐུག་ ནི་ རྣམ་ཤེས་ དང་ བླ་མ་ དང་ འོད་གསལ་ ཆོས་སྐུ་ གསུམ་ དབྱེ་␣ར་"
" མེད་ དུ་ གྱུར་པ་ ནི་ འཕོ་བ་␣འི་ མཆོག་ སྟེ །"
msgstr ""
"In this [system], the ultimate is the inseparability of consciousness, guru,"
" and the luminious dharmakaya, that is the supreme transference."

msgctxt "2fbd4b670e6142bbb41b9f3b951e54e8"
msgid "འཕོ་ བྱ་ འཕོ་ བྱེད་ ཀྱི་ རྟེན་ དང་ བྲལ་བ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"This is because they are devoid of a basis for something to be transferred "
"and a transferer."

msgctxt "af732c8457ca4899b205f862aa4b1f88"
msgid "དེ་ལྟར་ ཡང་ འཕོ་ རྒྱུ་ བྱུང་ ན་ རྣལ་འབྱོར་ མིན །"
msgstr "Likewise, If the cause of transference occurs, it is not yoga."

msgctxt "9652cd4237aa4ed9a06f6fbc69d42b31"
msgid "ཞེས་ གསུངས་པ་␣འི་ ཕྱིར་ ན་"
msgstr "Thus, it is said that"

msgctxt "4729000fccd14303b4fc186360fc884e"
msgid "རྣལ་འབྱོར་ རབ་ ཀྱི་ འཕོ་བ་␣འོ །"
msgstr "This is the transference of the highest yogi."

msgctxt "30b287e1a2264fdd8e311538995c885c"
msgid "རྡོ་␣༽༽  རྟོགས་པ་␣འི་ བོགས་ འདོན་པ་ ལ་"
msgstr "Vajra: It is said that to gain the most benefit from the realization"

msgctxt "92f13fc3ef1a4c7d80b3aebd9017bf3a"
msgid "རིགས་པ་ བརྟུལ་ཞུགས་ ཀྱི་ སྤྱོད་པ་ སྣ་ཚོགས་པ་␣ས་"
msgstr "By the various types of yogic discipline that are based on reasoning,"

msgctxt "d6bd0295ed544889872b57553596a871"
msgid ""
"རབ་བྱུང་ གི་ རྟགས་ དོར་ ནས་ རྣལ་འབྱོར་ གྱི་ ཆ་ལུགས་ ཕྱག་རྒྱ་ མ་ ཁྲིད་ ནས་"
msgstr ""
"Discarding the signs of ordination and taking the costume of a yogi, without"
" instructing the mudra"

msgctxt "9285f3a961ba462cb91cc0d1f93bd2ca"
msgid "དུར་ཁྲོད་ དང་ ཚོང་འདུས་ སོགས་ རྒྱུ་ ཞིང་ གླུ་གར་ བྱེད་ དགོས་ ཟེར །"
msgstr ""
"And wander in charnel grounds, markets, and so forth, singing and dancing."

msgctxt "a7e2e302cb2b4233bc7b83604c9d2dbd"
msgid ""
"འདི་␣ར་ རིགས་ ཤིང་ འོས་པ་␣འི་ སྤྱོད་པ་ ཁྱད་པར་ དུ་ འཕགས་པ་ ནི་ ཚུལ་ཁྲིམས་ "
"རིན་པོ་ཆེ་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], the most excellent conduct that is appropriate and proper "
"is the precious discipline."

msgctxt "e2a6828b56de47f580eda099f2369ad3"
msgid "སྤང་བྱ་ ཉོན་མོངས་ དང་ རྣམ་རྟོག་ བརྟུལ་ ནས་"
msgstr ""
"Having tamed the afflictions and discursive thoughts that are to be "
"abandoned,"

msgctxt "3114e6b8e20745598bb42781afe6834f"
msgid "ཡེ་ཤེས་ ཀྱི་ སྟོབས་ ལ་ ཞུགས་པ་␣འི་ སྤྱོད་པ་"
msgstr "The conduct engaging in the strength of primordial wisdom"

msgctxt "52461f8eb2454d56be772094fe0b5481"
msgid "སངས་རྒྱས་ ཀྱི་ གནས་ དང་ གནས་མིན་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ ཀྱིས་ བཅས་པ་␣འི་"
msgstr ""
"The Buddha's omniscient wisdom that knows what is appropriate or "
"inappropriate,"

msgctxt "e2bd28690aac41dd9811e96b1d0c28c8"
msgid "དགག་སྒྲུབ་ ཀྱི་ བསླབ་པ་ འདི་ ཡིན་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "This is the training of negation and assertion."

msgctxt "5879ac085d7d447092a701c2a1244c35"
msgid "དམ་པ་ དང་པོ་ ལ་␣ས་ ཀྱང༌ །"
msgstr "Also, from the first excellent one,"

msgctxt "7301e849b6ae4a658f0232afc4308d44"
msgid "རྡོ་རྗེ་ འཛིན་པ་ མཆོག་ དགེ་སློང་ དུ་ གསུངས་པ་ དང༌ །"
msgstr "The supreme vajra holder is said to be a monk and"

msgctxt "15511db564d54e1fa81a8b1645f10d85"
msgid "བསྟན་པ་ འཛིན་སྐྱོང་ སྤེལ་བ་ ལ་␣འང་"
msgstr "In upholding, preserving, and spreading the teachings,"

msgctxt "dc453126cdb14ea293e890c608ec17ea"
msgid "འདི་ཉིད་ མཆོག་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr "Because this is an excellent one."

msgctxt "914a9cee2a6f42289548db95b203632d"
msgid "དཔེར་ན་ འཕགས་པ་ ཀླུ་སྒྲུབ་ དང༌ །"
msgstr "For example, the noble Nagarjuna and"

msgctxt "a957bc4dd3ad4bb080a9605c8fb9e721"
msgid "མཉམ་མེད་ དྭགས་པོ་ ལྷ་རྗེ་ བཞིན་ ནོ ། །"
msgstr "the peerless Dagpo Lhaje."

msgctxt "299b608c82d14d3dbd1a82da4e5ce552"
msgid "དེང་སང་ འགའ་ཞིག་ བརྟུལ་ཞུགས་ ཀྱི་ སྤྱོད་པ་ ཡིན་པ་␣ར་"
msgstr "These days, some people as a conduct of yogic discipline,"

msgctxt "adf721e88b034b77b5c60bf6aa9177cc"
msgid "ཁ་␣ས་ འཆེ་བ་␣འི་ རུས་རྒྱན་ གྱི་ རྒྱན །"
msgstr "[They] adorned with a faux bone ornament."

msgctxt "82de66e200824ef3ab3fd4e04da55f14"
msgid "ཁྱི་ ལྤགས་ དཀྲིས །"
msgstr "Wrapped in dog skin."

msgctxt "e8d8e995bc9f45ba973e976aa5e29f71"
msgid "རྒྱུ་འབྲས་ ཁྱད་ དུ་ གསོད་ ཅིང་"
msgstr "[They] disregard cause and effect,"

msgctxt "7de96d251c134669b916823e0906610e"
msgid ""
"ལུས་སྲོག་ ཐད་ ལ་ འཁོར་བ་␣འི་ རྟོགས་ལྡན་ སྤྱོད་པ་ ལྷ་ ཀླུ་ ཐམས་ཅད་ དཀྲུག་ "
"ཅིང་"
msgstr ""
"For their bodies and lives, [they] disturb all the gods, nagas, and the "
"conduct of the realized ones of samsara."

msgctxt "6bfb311c62f947488d4fb95ef05515af"
msgid "ཕཊ་ སྒྲ་ དང་ ཧཱུྃ་ སྒྲ་␣ས་ ལུང་པ་ འགེངས །"
msgstr "The sounds of PHAT and HUM fill the valley."

msgctxt "fdbded50a39742bc81e0b2d8764c2b47"
msgid "མིག་ ཧྲིག་ཧྲིག་ དུ་བ་␣ར་ སྣང་ དུ་ བལྟ །"
msgstr "[They] stare into the open space with unblinking eyes."

msgctxt "d2921fd4f4954393ab270a1612b00f40"
msgid "ཁ་ ནས་ ཆོས་ ཐམས་ཅད་ སྟོང་པ་ ཆེན་པོ་␣འོ་ ཟེར་ ནས་"
msgstr "From their mouth, [they] say, “All phenomena are great emptiness."

msgctxt "01db4f5a9f744c94a919e0e174366422"
msgid "དོན་མེད་ ཁྱི་ ལྟར་ འཁྱམས་པ་ རྣམས་ ཀྱི་"
msgstr "Those who wander like dogs meaninglessly, "

msgctxt "7c3b47c1fe244811bda41b8567a360ee"
msgid "སྤྱོད་པ་ བརྟུལ་ཞུགས་ ལ་␣ས་ ཆེས་ འཕགས་པ་␣འི་ ཕྱིར་"
msgstr "Because their conduct is far superior to the yogic discipline."

msgctxt "2dbf2535665249b4a5586cb33e3fd634"
msgid "ཚུལ་ དེ་ལྟར་ དགོས་ སོ ། །"
msgstr "It is required in this way."

msgctxt "1ea5f2b723924990a827906ed53b51e8"
msgid "རྡོ་␣༽༽  རྣལ་འབྱོར་ བཞི་␣འི་ མཐར་ཐུག་ སྒོམ་ མེད་རྟོགས་པ་ ན་"
msgstr ""
"Vajra: When one realizes non-meditation, the ultimate [stage] of the four "
"yogas,"

msgctxt "1344a74dd00f4106bcbb47884c34e0bc"
msgid "མཉམ་བཞག་ ཆེན་པོ་ བྷུ་ སུ་ ཀུ་ སྟེ་"
msgstr "The great meditative equipoise is Bhusuku,"

msgctxt "d0f9171dd1a2452e85f45947066a3b30"
msgid "ཟ་ཉལ་ འཆག་ གསུམ་ གྱི་ འདུ་ཤེས་ ཙམ་ མ་གཏོགས་"
msgstr "Which is the mere perception of eating, sleeping, and wandering."

msgctxt "4868e7ad8a6c4e6b853a8d24b3170a89"
msgid "བདེ་སྡུག་ མཐོ་དམན་ གང་ ལ་␣འང་ ཞུམ་ ཁེངས་མེད་པ་"
msgstr ""
"Whether happiness and suffering, high and low, without becoming discouraged "
"or arrogant, "

msgctxt "d7dc6bb232d9446d8d243f2c25b61b48"
msgid "ཤིང་ལོ་ རླུང་ ཁྱེར་ བཞིན་ དུ་ སྤྱོད་ དགོས་ ཟེར་ ཡང་"
msgstr ""
"Although it is said that one should enjoy these like the wind blowing the "
"leaves of a tree."

msgctxt "c4f7bfaad7fb4dea9ae7a089f423fb6f"
msgid ""
"འདི་␣ར་ དེ་␣འི་ སྟེང་ དུ་ ཆོས་ ཚུལ་ཁྲིམས་ དང་ སྒྲུབ་པ་ དང་ ཚད་ མེད་པ་␣འི་ "
"སྙིང་རྗེ་ གསུམ་ མི་ ལྡན་ ན་"
msgstr ""
"In this [system], in addition to that, if one does not have the three- "
"dharma, moral conduct, and accomplsiment and immeasurable compassion,"

msgctxt "b9f99def4eaf4cff916325a366438d1e"
msgid "ཉན་རང་ དང་ ཁྱད་པར་ མེད་པ་␣ས་"
msgstr "Since there is no difference between shravakas and pratyekabuddhas,"

msgctxt "29e291c599c8489da37522c0a347016e"
msgid ""
"དང་པོ་ རང་རྒྱུད་ ལ་ ཡོད་པ་␣འི་ ལག་མཐིལ་ གྱི་ སྤུ་ཉག་ ལྟ་བུ་␣འི་ ཉེས་པ་ "
"ཤིན་ཏུ་ ཕྲ་བ་␣འང་ སྤང་ དགོས་ ཏེ་"
msgstr ""
"First, one must eliminate even the most subtle faults that exist in one's "
"own mindstream, such as the hairs on the palm of the hand."

msgctxt "78c25c52095c49ebbe6aebb62b2f91f2"
msgid "ཡོན་ཏན་ མི་ ཐོབ་པ་␣འི་ ཕྱིར །"
msgstr "Because one does not attain good qualities."

msgctxt "d3bfcd21eae24ef6b02c77884a5a90b7"
msgid "སློབ་དཔོན་ འཕགས་པ་ རྫ་བུམ་ ལ་ ཆགས་པ་␣ས་"
msgstr "Master Arya because of being attached to a clay vase,"

msgctxt "eb720664f5be4ad6be1af73530bc9a92"
msgid "གནོད་སྦྱིན་ མ་གྲུབ་པ་ དང་ །"
msgstr "The yakshas are not accomplished and"

msgctxt "0151b67ab8f3486f97ba7309c8182c9f"
msgid "ཆོས་མཆོག་ ཉིད་ ཀྱི་ བརྩམས་པ་␣འི་ ཚད་མ་␣ར་ མཉེས་པ་␣ས་"
msgstr ""
"[He] was being delighted with the authoritativeness of the compositions of "
"the supreme Dharma."

msgctxt "acc9a62d9d5b404d83d037a12d5a4cfa"
msgid "ཤིང་ སྐམ་ ལ་␣ས་ མེ་ཏོག་མ་ སྐྱེས་པ་ བཞིན་ ནོ ། །"
msgstr "It is like a flower not growing on a dry tree."

msgctxt "a24bb547692e4538be781944341d0248"
msgid "གཉིས་པ་ རང་རྒྱུད་ ལ་ འཕགས་པ་ རྣམས་ ཀྱི་ བྲལ་བ་ དང་"
msgstr ""
"The second is the freedom of the noble ones in one's own continuum and "

msgctxt "ee4f76b86a714eeaa9d7ab895450e769"
msgid "རྣམ་སྨིན་ གྱི་ ཡོན་ཏན་ ཚད་ མེད་པ་ དག་ སྒྲུབ་ དགོས་ ཏེ །"
msgstr "One must accomplish the immeasurable qualities of complete ripening."

msgctxt "c2aee18da8c3413194cdbb884e7469dd"
msgid "རྒྱུ་རྐྱེན་ མེད་པ་␣ར་ མི་ འབྱུང་བ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Because they do not occur without causes and conditions."

msgctxt "9212ce4fc973456395c66c7753a19227"
msgid "གསུམ་པ་ རང་ཉིད་ གཅིག་པུ་ ཞི་བདེ་ འདོད་པ་␣འི་ སེམས་ སྤངས་ ནས་"
msgstr ""
"The third is to abandon the mind that desires peace and happiness for "
"oneself alone and "

msgctxt "2f25c0bc13104f6fa5ba7b99a60827e3"
msgid "ཚད་ མེད་པ་␣འི་ སྙིང་རྗེ་ གཞན་དོན་ མཐར་ཐུག་ ཏུ་ བྱེད་ དགོས་ ཏེ །"
msgstr ""
"Immeasurable compassion must be made for the ultimate benefit of others."

msgctxt "d3e55f9751e14976af427b13316913d8"
msgid "སྟོང་ཉིད་ སྙིང་རྗེ་ དང་ བྲལ་ ན་ དམན་པ་␣ར་ འགྱུར་བ་␣འི་ ཕྱིར །"
msgstr "If one separates from emptiness and compassion, one becomes inferior."

msgctxt "5012928765dc44038cd2f1f047416bb3"
msgid "དེ་ གསུམ་ གཅེས་པ་ ཡིན་ ནོ ། །"
msgstr "Thus, these three are to be cherished."

msgctxt "0ef727766ef94d4688b0f5071d149379"
msgid ""
"ལྟ་ སྒོམ་ སྤྱོད་པ་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ་␣འི་ ཚིག་རྐང་ ཉི་ཤུ་ ལྷན་ཐབས་ "
"ཚིག་རྐང་ ལྔ་ བཅས་ ཀྱི་ འགྲེལ་བཤད་ བྱེད་པ་␣འི་ སྐབས་ ཏེ་ དྲུག་པ་␣འོ །"
msgstr ""
"This concludes the sixth section, a commentary on the twenty vajra verses "
"and the five verses of addendums, summarizing the essential points of view, "
"meditation, and conduct."

msgctxt "4614041febf443daa0ccd6f1a56488c2"
msgid "རྡོ་␣༽༽  གཞན་ བཞེད་ ལྟར་ ན །"
msgstr "Vajra: According to other's acceptance,"

msgctxt "cda912b247d74ff7bd8b0257d5492f1f"
msgid "སངས་རྒྱས་ ཀྱི་ ས་␣ར་ ཆོས་སྐུ་ ཇི་ལྟ་ མཁྱེན་པ་"
msgstr ""
"On the level of a buddha, dharmakaya that knows things just as they are,"

msgctxt "cfcf5b0183bb473e95a42dbc4c470f9c"
msgid "བྲལ་བ་␣འི་ ཡོན་ཏན་ རྣམས་ དོན་དམ །"
msgstr "All the good qualities of freedom are absolute."

msgctxt "609c83bd571d4d0fb68c176a080af0a8"
msgid "གཟུགས་སྐུ །"
msgstr "Rupakaya,"

msgctxt "f81e86e1f930415690eb913022f965f3"
msgid ""
"ཇི་སྙེད་ མཁྱེན་པ་␣འི་ རྣམ་སྨིན་ གྱི་ ཡོན་ཏན་ ཀུན་རྫོབ་ ཏུ་ འདོད་པ་ དང་ །"
msgstr ""
"The qualities of the complete ripening of the entire knowledge of "
"omniscience are accepted as relative."

msgctxt "7d8b92c2d9a448428bda8ee94859cc33"
msgid "ཡང་ རྡོར་ གཅོད་ ལ་␣ས །"
msgstr "Also, according to the Vajra Cutter:"

msgctxt "38521652b609496787207baf24ce9ae9"
msgid "གང་དག་ ང་ ལ་ གཟུགསུ་ མཐོང་ །།"
msgstr "Those who see me as a form,"

msgctxt "da03da14e44747a1af3e05d41a9da766"
msgid "གང་དག་ ང་ ལ་ དགྲ་␣ར་ ཤེས་ ན ། །"
msgstr "Those who know me as an enemy,"

msgctxt "8df21ba8f20b4d6f9f1eb6edf78d6182"
msgid "ལོག་པ་␣འི་ ལམ་ དུ་ ཞུགས་པ་ དེ ། །"
msgstr "Those who enter the wrong path,"

msgctxt "194fd25d1ae74214a831e0ce65072364"
msgid "སྐྱེས་བུ་ དེ་དག་ ང་ མི་ མཐོང་ ། །"
msgstr "These people do not see me."

msgctxt "3a02c041f0c840489efa37605af75678"
msgid "ཞེས་པ་␣ས་ ཆོས་སྐུ་ དོན་དམ་པ་ འབའ་ཞིག་ ཡིན་ ཟེར་བ་ དང༌ །"
msgstr "Thus, it is said that the dharmakaya is only the absolute and"

msgctxt "eeed47d5c325486887bacece48aa3ae9"
msgid "ཡང་ རྟོགས་ བྱ་ དབྱིངས་ དང་"
msgstr ""
"Furthermore, the expanse [of the emptiness] that is to be realized and "

msgctxt "2014729b3eb54918bdb01fabfa214321"
msgid "རྟོགས་ བྱེད་ ཀྱི་ བློ་ འདྲེས་ གང་ཡོད་པ་␣ས་"
msgstr "The mind that realizes it, wherever there is a mixture of them,"

msgctxt "ded9e74c4a234d64b6c2a6398474e26e"
msgid ""
"ཆོས་སྐུ་ ལ་ ཡང་ ཀུན་རྫོབ་ ཀྱི་ ཆ་ཤས་ ཅུང་ཟད་ ཡོད་ ཟེར་བ་ སོགས་ སྣང་ ཡང་ །"
msgstr ""
"It also appears that some people say that dharmakaya also has a slight "
"aspect of the relative."

msgctxt "257dde062d4e4f9ab129285c6bea832a"
msgid "འདི་␣ར་ འབྲས་བུ་ སངས་རྒྱས་ ཀྱི་ ས་ ན་"
msgstr "In this [system], On the level of the resultant buddhahood,"

msgctxt "35e0468cf836499eb0bd48653a080141"
msgid ""
"བདེན་ གཉིས་ ཀྱི་ སྤྲོས་པ་ རྣམ་པ་␣ར་ དབྱེ་བ་␣ར་ བྱ་བ་␣འི་ ཆོས་ ཙམ་ མེད་ དེ་"
msgstr ""
"There is not even a phenomenon to be differentiated from the elaborations of"
" the two truths."

msgctxt "161f6fb1619c453d90fa9446f65e5ee7"
msgid "དོན་དམ་ དང་ ཀུན་རྫོབ་ ནི་ གཅིག་ ལ་ གཅིག་ ལྟོས་ ནས་ བཞག་པ་␣ས་"
msgstr ""
"The absolute and the relative are placed in dependence upon one another."

msgctxt "bba24c248d074d959584e549c6e54c35"
msgid "འབྲས་བུ་ གཉིས་ མེད་"
msgstr "The result is the non-dual"

msgctxt "6b326d64cb564cff903df287889c3be5"
msgid "མཉམ་པ་ཉིད་ དུ་ གྱུར་པ་␣ས་ ན་"
msgstr "When it becomes equality,"

msgctxt "46bc37e19ff141a49a0aad9a354c4b53"
msgid "དོན་དམ་པ་ ལ་ ལྟོས་པ་␣འི་ ཀུན་རྫོབ་ མེད་ ཅིང་ །"
msgstr "There is no relative that depends upon the absolute."

msgctxt "f189d01e8b674bdb884cbe656a34602f"
msgid "དེ་ ལ་ ལྟོས་པ་␣འི་ དོན་དམ་ མེད་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "This is because there is no absolute that depends on that."

msgctxt "c40a4768349b4c24ac1a5dff14a8ea3b"
msgid "དེ་ལྟར་ ཡང་ མཚན་ བརྗོད་ ལ་␣ས །"
msgstr ""
"Likewise, according to the [Sutra] Expressing The Names [of Manjushri]:"

msgctxt "eb8e9c71f14c43059a837024bb478a4b"
msgid "གཉིས་ མེད་ གཉིས་ སུ་ མེད་པ་␣ར་ སྟོན ། །"
msgstr "Non-dual is taught to be without dual."

msgctxt "abcf763edff5484aa0c5d50a6f6078b4"
msgid "ཡང་དག་ མཐའ་ ལ་ རྣམ་པ་␣ར་ གནས །"
msgstr "Completely dwell in the true extremes."

msgctxt "2d79622322ec47408bfb9c7555bd40db"
msgid "ཞེས་ དང་ །"
msgstr "And."

msgctxt "262575042f654d6b82084770c9a8f090"
msgid "བཤད་རྒྱུད་ རྡོར་ ཕྲེང་ ལ་␣ས །"
msgstr "According to the Vajra Garland Explanatory Tantra:"

msgctxt "637f57f8ff35472fb2f105efcd14753b"
msgid "ཀུན་རྫོབ་ དང་ ནི་ དོན་དམ་ དག  །"
msgstr "The relative and the absolute,"

msgctxt "b43febab787f45fe93c8b53ab6970c6b"
msgid "རྟོག་པ་ གཉིས་ དང་ ཡང་དག་ བྲལ ། །"
msgstr "Truly free from the two conceptualities."

msgctxt "4303c08950bd45e49d18c0e5e3fef3e1"
msgid "གང་ དུ་ ཡང་དག་ འདྲེས་ གྱུར་པ ། །"
msgstr "Wherever that are truly mixed,"

msgctxt "9cd782d57bd243be9cc6c9f62aee789a"
msgid "དེ་ ནི་ ཟུང་ དུ་ འཇུག་པ་␣ར་ བཤད །"
msgstr "That is explained as engaging in union."

msgctxt "25bc171bfb114a2eb141d3626a20a8a7"
msgid "ཅེས་ དང །"
msgstr "And."

msgctxt "a9cf001c6a624c0d9b48bed1a508eb25"
msgid "རྩ་ཤེ་␣ས་ ལ་␣ས །"
msgstr "According to the Root Stanzas of the Middle Way:"

msgctxt "489a9b0f05ec4d59a14da3ad0dd3219e"
msgid "གང་ གི་ རྟེན་ ཅིང་ འབྲེལ་བ་␣ར་ འབྱུང༌ ། །"
msgstr "That which occurs in dependent-related arising,"

msgctxt "215b17ec50574ed6985bb6330c15e0c5"
msgid "འགག་པ་ མེད་པ་ སྐྱེ་ མེད་པ ། །"
msgstr "It is unceasing and unborn."

msgctxt "d3b33559a3b94efe9829b6176f6ad81d"
msgid "ཆད་པ་ མེད་པ་ རྟག་ མེད་པ ། །"
msgstr "There is no nihilation and no permanence,"

msgctxt "bca29d9cdb8f4118992293fda2106e81"
msgid "འོང་བ་ མེད་པ་ འགྲོ་མེད་པ ། །"
msgstr "There is no coming or no going."

msgctxt "47131d3c5b394e938b7450cbd0fb5c07"
msgid "ཐ་དད་ དོན་ མིན་ དོན་ གཅིག་ མིན །"
msgstr "[They] are not distinct, nor are [they] the same."

msgctxt "3b1bfc3c1ac442f89abbff5d7cd6eccb"
msgid "ཞེས་ དང་ །"
msgstr "And."

msgctxt "20fbe50fb3ba4b8c973dab2e0fdff0ff"
msgid "ཤེར་ སྙིང་ལས །"
msgstr "According to The Heart of Wisdom Sutra:"

msgctxt "71a9f9bd6cd2406890ae3ac04b7bfad0"
msgid "གཟུགས་ སྟོང་པ་␣འོ་␣༑"
msgstr "Form is empty,"

msgctxt "b0ce5a73852940c3a6e67aaf276f3a7d"
msgid "༑་␣སྟོང་པ་ཉིད་ གཟུགས་ སོ་␣༑ །"
msgstr "Emptiness is form."

msgctxt "8718ef893b8040c7b5d12c925622ed99"
msgid "ཞེས་ སོགས་ མཐའ་ཡས་པ་␣ས་ གཉིས་ ཆོས་ ཐམས་ཅད་ ལ་␣ས་ འདས་པ་ ཡིན་ ནོ །"
msgstr "Because by infinite others, it is beyond all dualistic phenomena."

msgctxt "46eefd87b44f427d8b3e628a39641fa9"
msgid "རྡོ་␣༽༽  བརྟེན་པ་ ཡེ་ཤེས་ ལ་ ཟླ་གྲགས་ སོགས་ ཐལ་འགྱུར་བ་ འགའ་ཞིག་"
msgstr ""
"Vajra: To the supported wisdom, Chandrakirti and some proponents of the "
"Prasangika [Madhyamaka] system,"

msgctxt "37a54ae0a11c49499583c62bc523dde3"
msgid ""
"རྒྱུན་མཐ་␣འི་ རྡོ་ཏིང་ གི་ སྤངས་ བྱ་ ཕྲ་བ་ སྤང་བ་ ཡན་ཆད་ སྤང་བྱ་ ཡོད་པ་␣ས་"
msgstr ""
"There are things to be eliminated, up to and including the abandonment of "
"the subtle objects of abandonment of the vajra-like meditative stabilization"
" at the end of the continuum."

msgctxt "bc694a1aa26a412b93fc026d8d71d51c"
msgid "གཉེན་པོ་ ཡེ་ཤེས་ ཀྱང་ ཡོད་ དེ་"
msgstr "The remedy wisdom is also present."

msgctxt "59115100083b44a38496619da583c176"
msgid "ཤིང་ ཡོད་ ཚེ་ མེ་ལྕེ་ ཡོད་པ་ བཞིན་ ནོ ། །"
msgstr "Like when there is wood, there is fire."

msgctxt "b2ee1a9160924775991418e738a60506"
msgid "དེ་ལྟར་ ཡང །"
msgstr "That as well,"

msgctxt "653b6a2a45324a508c16de6cc22ba07d"
msgid "ཤེས་བྱ་␣འི་ བུད་ཤིང་ སྐམ་པོ་ མ་ལུས་པ ། །"
msgstr "Since all the dry firewood of knowlable none excluded"

msgctxt "53c223e0ebd745fabc380c794adb2b1f"
msgid "བསྲེགས་པ་␣ས་ ཞིང་ དེ་ རྒྱལ་ རྣམས་ ཆོས་སྐུ་ དེ ། །"
msgstr "Is burned up, that field is the dharmakaya of the conquerors."

msgctxt "216d7c045b8a423b896d3ed66e162250"
msgid "དེ་ ཚེ་ སྐྱེ་བ་ མེད་ ཅིང་ འགག་པ་ མེད ། །"
msgstr "During that, it is unborn and unceasing."

msgctxt "056e82aa1d3b4aad95c26a651d0eaad7"
msgid "སེམས་ འགགས་པ་ དེ་ སྐུ་ ཡིས་ མངོན་སུམ་ མཛད །"
msgstr "The cessation of the mind is actualized by the kaya."

msgctxt "a950b35ee7474630b637749019527bc3"
msgid "ཅེས་ དང །"
msgstr "And,"

msgctxt "7cafb611e76d4d3689c9fda613ff72f2"
msgid "ཤེར་ སྙིང་ལས །"
msgstr "According to The Heart of Wisdom Sutra:"

msgctxt "5f3910d6879848e382836f8eae8a7eb1"
msgid "ཡེ་ཤེས་ མེད་ ཅེས་པ་␣ས་ སོ ། །"
msgstr "It is said that there is no primordial wisdom."

msgctxt "864a38f977da47dca9ad68fb296b0f25"
msgid "ཡོད་པ་␣ར་ གསུངས་པ་ ནི་ གཞན་དབང་ ཡིན་ ཟེར་ རོ ། །"
msgstr ""
"It is said that the statement that says it exists is the other-powered "
"[character]."

msgctxt "989fa7fa21c045119ce7a936ca598b2b"
msgid "ཡང་ ལེགས་ལྡན་ སོགས་ རང་རྒྱུད་པ་ རྣམས་ ནི་"
msgstr "Also, Bhavaviveka and other proponents of the autonomy system, say:"

msgctxt "2ea0ab18a5864bc4bada361391154a37"
msgid "མཐར་ཐུག་ ཡེ་ཤེས་ ནི་ ནམ་མཁའ་ ལ་ འདོམ་ གྱི་ གཞལ་བ་␣འམ་"
msgstr "The ultimate wisdom is like measuring the sky by fathom or"

msgctxt "6d191332e4bd487c817d11d09ae73a4c"
msgid "མཚོན་ གྱི་ རི་མོ་ འབྲི་བ་ བཞིན་ ནོ ། །"
msgstr "Drawing a picture with a weapon."

msgctxt "300044d2d5b64e79861d0ab2d56c7a0e"
msgid "ཡེཤེས་ དེ་ ཐོས་ ནས་ ཐེ་ཚོམ་ ཟོས་པ་ ཙམ་ གྱིས་ ཀྱང་"
msgstr "Merely hearing about this wisdom and having doubts about it."

msgctxt "6be368844c8a4d8f80afb427422b3efe"
msgid "འཁོར་བ་ ནུས་ མེད་ དུ་ གཏོང་ སྟེ །"
msgstr "It will render samsara powerless."

msgctxt "bb2388c0fdb34b978583af68b77db694"
msgid "བཞི་བརྒྱ་པ་␣ར །"
msgstr "The Four Hundred Verses [on the Middle Way]:"

msgctxt "f844124c742a49979b33a745a721848f"
msgid "གང་ཞིག་ ཆོས་ འདི་ ཐོས་པ་␣འམ །"
msgstr "Whoever hears this Dharma or"

msgctxt "9683aa66d3154baaaf46466a2e337ea5"
msgid "ཐོས་ ནས་ ཐེ་ཚོམ་ ཟོས་པ་␣ས་ ཀྱང༌ ། །"
msgstr "Having a doubt after hearing this,"

msgctxt "6daaedf28fd64e1fbd01b6729d42aa56"
msgid "སྲིད་པ་ ཧྲུལ་པོ་␣ར་ གཏོང་བ་␣ར་ བྱེད །"
msgstr "It will make samsara to tear and tatter."

msgctxt "dcd45bb7504a4fb6b260996681b78155"
msgid "ཅེས་ སོ ། །"
msgstr "As said,"

msgctxt "1cca4821f98d4f80b4c63a3e3b79c77d"
msgid "རྡོ་␣༽༽  མྱ་ངན་ འདས་པ་ ལ་␣ས་ ཆེས་ ལྷག་པ་␣འི་ ཆོས་ གཅིག་ ཡོད་ ན་"
msgstr "Vajra: If there is a single phenomenon that is greater than nirvana,"

msgctxt "60323704c4384ee789c46ca7751d51ab"
msgid ""
"ཡང་ སྒྱུ་མ་ ལྟ་བུ་ གསུངས་པ་␣ས་ སངས་རྒྱས་ ཀྱང་ སྒྱུ་མ་ ལྟ་བུ་ ཞེས་ འག་␣ར་ "
"སོགས་ ཀྱིས་ ཟེར་ རོ ། །"
msgstr ""
"Also, because when it is like an illusion, some say that even the Buddha is "
"like an illusion."

msgctxt "a54d6782830047eea55a9edf03380797"
msgid "སངས་རྒྱས་ ཆོས་ཅན་"
msgstr "Take the subject the Buddha,"

msgctxt "62cb1e02ba6d4a3a9ece58102ef4b1f5"
msgid "ཁྱོད་ སྒྱུ་མ་ ལྟ་བུ་␣འི་ ཆོས་ ལ་␣ས་ ཀྱང་ ཡང་དག་པ་␣ར་ འདས་པ་ ཡིན་ ཏེ་"
msgstr "He has genuinely transcended from the illusory-like phenomena."

msgctxt "f3f026d25858435e8d0d21b2638b8ceb"
msgid ""
"འཁོར་འདས་ ཀྱི་ ཆོས་མ་ ལུས་པ་ སྤྲོས་པ་ དང་ བྲལ་བ་␣འི་ ངོ་བོ་␣ར་ "
"སངས་རྒྱས་པ་␣འི་ ཕྱིར་ དང་ ༑"
msgstr ""
"Because [he] is enlightened from all the phenomena of samsara and nirvana "
"none excluded, in the essence of free from elaboration."

msgctxt "9422a03ce1f8442cb664a7ee5f9cbac2"
msgid "སྒྱུ་མ་ ནི་ འཁྲུལ་ཤེས་ མི་རྟག་པ་ ཡིན་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"This is because an illusion is a confused consciousness that is impermanent."

msgctxt "211bb57b23134f2faa9bf95fb67c946a"
msgid "དེ་ལྟར་ ཡང་ ཆོས་ ཀུན་ སྒྱུ་མ་␣ར་ ཐུགས་ སུ་ ཆུད །"
msgstr "Likewise, [he] has realized all phenomena as illusions."

msgctxt "d4910135e86f4ef186ab2e77b2bba36a"
msgid "སྒྱུ་མ་ ཉིད་ ཀྱང་ མཆིས་ མ་ ལགས ། །"
msgstr "The illusion itself does not exist."

msgctxt "439c64ef80d048109fc4f13f6debce14"
msgid "སྒྱུ་མ་␣འི་ ཆོས་ ལ་␣ས་ རྣམ་གྲོལ་བ ། །"
msgstr "Completely liberated from illusory phenomena."

msgctxt "b6f8d858b6ac4908aab079a51c7511c3"
msgid "མི་ རྟེན་ ཁྱོད་ ལ་ ཕྱག་ འཚལ་ ལོ ། །"
msgstr "I pay homage to you, the one who is not dependent."

msgctxt "1514ddc556494d52b7cfbb5fa9e43a5b"
msgid "ཞེས་ ཡེ་ཤེས་ སྣང་བ་ རྒྱན་ ལ་␣ས་ གསུངས་པ་␣ས་"
msgstr "The Ornament of the Light of Wisdom says:"

msgctxt "44fbe493c17f4d2996ea704ef1898498"
msgid "བློ་ ལ་␣ས་ འདས་པ་ ཡིན་ ནོ ། །"
msgstr "It is beyond the mind."

msgctxt "5ed441e4b1fc4aab990f25f5ddf96658"
msgid "འོ་ན་ སྒྱུ་མ་ ལྟར་ གསུངས་པ་ ཅི་ ཞེ་ན །"
msgstr "One may ask, \"Well then, why is it said to be like an illusion?\""

msgctxt "95486545b39b4147abb68e05de1f9446"
msgid "དེ་ ནི་ སྒྱུ་མ་ ལ་␣ས་ འདས་པ་␣ར་"
msgstr "This is beyond illusion and"

msgctxt "29f62fadfea640c08385619f9782466a"
msgid "མ་ རྟོགས་པ་␣འི་ སེམས་ཅན་ སྒྱུ་མ་ དང་ རྨི་ལམ་ བཞིིན་"
msgstr ""
"The sentient beings without realization are like illusions and dreams."

msgctxt "5fa08f9c6d3e4d11886e56c38cf86253"
msgid "ཁམས་ གསུམ་ དུ་ འཁོར་བ་ རྣམས་ ཀྱི་ ངོ་␣ར་ གསུངས་ སོ ། །"
msgstr ""
"This is said from the perspective of those who circle in the three realms."

msgctxt "ea2d85d737114ade84d0b6d1fe13ac83"
msgid "རྡོ་␣༽༽  ཚད་མ་␣འི་ བློ་ མངོན་སུམ་ དང་ རྗེས་དཔག་ གཉིས་"
msgstr ""
"Vajra: The two valid cognitions are direct and Inferential [valid "
"cognizers]."

msgctxt "60f8235756fb48698f96f4e5d9b18e67"
msgid ""
"ཚད་ མིན་ གྱི་ བློ་ ཐེ་ཚོམ་ ཡིད་དཔྱོད །  ལོག་ཤེས །  བཅད་ཤེས །  སྣང་བ་ "
"མ་ངེས་པ་ དང་ ལྔ་་ སྟེ་"
msgstr ""
"The five invalid cognitions are doubt, presumption, wrong cognition, "
"subsequent cognition, and inattentive cognition."

msgctxt "7c771ef74b114202946a0d77335d0eb3"
msgid "བདུན་ དུ་ གསུསངས་པ་␣ས ༑"
msgstr "As they are said to be seven."

msgctxt "9904a58d62ea40749298f9f014d5fb02"
msgid ""
"ཐོ་ རང་ རྣམ་པ་ ཐམས་ཅད་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ བརྙེས་པ་␣འི་ སྐད་ཅིག་ དང་པོ་ "
"ཕན་ཆད་"
msgstr ""
"Upto the first moment of attaining the primordial wisdom that knows all the "
"aspects of dawn,"

msgctxt "6e96d68bd7f64f3a9ab3a177cdc9a2c0"
msgid "ཐུགས་ ཚད་མ་ ཡིན་ ལ་"
msgstr "The mind is valid cognition."

msgctxt "1721fbfa61104dfaa2ccb29b922a2a64"
msgid "གཉིས་པ་ ཕྱིན་ཆད་ བཅད་ཤེས་ སྒྲོ་འདོགས་ ཆོད་པ་ ཡིན་པ་␣ས་"
msgstr ""
"From the second [moment], it is subsequent cognition that eliminates "
"exaggeration."

msgctxt "b1c65020ce7d4f778777518a6f6fff55"
msgid "ཚད་མ་␣ར་ མི་ འགྱུར་ ཟེར་བ་ དག་ ཀྱང་ ཡོད་ དོ །"
msgstr "There are also called [one] who becomes a valid [person],"

msgctxt "5f26b4b76962466cb1248f0dcc9d2da8"
msgid "འདི་␣ར་ སངས་རྒྱས་པ་␣འི་ དུས་ རྣམས་"
msgstr "In this [system], the times of buddhas"

msgctxt "5b6809bc60d9494ba0f8777ca1307293"
msgid "རྟག་ ཏུ་ ཚད་མ་␣ར་ བཞུགས་པ་ ཡིན་ ཏེ །"
msgstr "[They] always dwell in valid cognition."

msgctxt "a0f2af9ec69348d6bc76b027b0a0d0c3"
msgid "དེ་བཞིན་ གཤེགས་པ་ འཇིག་རྟེན་ ན་མཉམ་པ་ མེད་པ་ དང་"
msgstr "Because the Tathagata is peerless in the world and "

msgctxt "bdba5fd5ac4c4e07ab3852ee07d6bc14"
msgid "མི་ བསླུ་བ་ ཡིན་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "And is non-deceptive."

msgctxt "280945db37124dedb670483e542952ff"
msgid "དེ་ལྟར་ ཡང་ ལག་ ན་ རྡོ་རྗེ་ དབར་ བསྐུར་བ་␣འི་ རྒྱུད་ ལ་␣ས །"
msgstr "According to the Vajra Bearer Empowerment Tantra:"

msgctxt "4affe5e3bd5842cf9cc3c205d5287f99"
msgid ""
"དེ་བཞིན་ གཤེགས་པ་ ལྷ་ དང་ བཅས་པ་␣འི་ འཇིག་རྟེན་ གྱི་ ཚད་མ་ མི་ བསླུ་བ་␣འོ "
"། །"
msgstr ""
"The Tathagata is a valid [person] and non-deceptive of the world and its "
"gods."

msgctxt "c18007938267400ab25c44a7d1f38068"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "6d1361b6511148059f5cc19326d757b2"
msgid "གསེར་འོད་ དང་ ལྟུང་བཤགས་ ཡོད་ དེ །"
msgstr "There are the golden light and laying aside downfalls."

msgctxt "a597c1f041384fbdb197f247ead75954"
msgid "མདོ་ སྡུད་པ་ ལ་␣ས །"
msgstr "According to the Sutra of Condensed [Prajnaparamita In Verse]:"

msgctxt "f753cf7830974bafb74c457bb25c266c"
msgid "ཡེཤེས་ མེད་ ན་ ཡོན་ཏན་ འཕེལ་ མེད་ བྱང་ཆུབ་ མེད ། །"
msgstr ""
"Without primordial wisdom, there is no development of good qualities, and "
"there is no enlightenment."

msgctxt "b01ff9b8c5c7402dbda7c8830e74adce"
msgid "རྒྱ་མཚོ་ འདྲ་བ་␣འི་ སངས་རྒྱས་ ཆོས་ ཀྱང་ མེད་པ་␣ར་ གྱུར །"
msgstr "The ocean-like Buddhadharma will also become non-existence."

msgctxt "6688e4a92e8645f18c929fc869eaa626"
msgid "ཞེས་ དང །"
msgstr "And."

msgctxt "729b41a6ff504564968d8646c0ff2c0d"
msgid "མདོ་སྡེ་ རྣམས་ ནས །"
msgstr "From the Sutra sections:"

msgctxt "3f9c3b8ac5e24b889b58905a116e11da"
msgid ""
"ཉིན་མཚན་ དུས་ དྲུག་ ཏུ་ འཇིག་རྟེན་ ལ་ ཡེ་ཤེས་ ཀྱི་ གཟིགས་པ་ འཇུག་པ་␣ར་ "
"གསུངས་པ་ དང༌ །"
msgstr ""
"It is said that the vision of primordial wisdom enters the world all the six"
" times of day and night,"

msgctxt "4e472afdda7343c6ae66372d19d52356"
msgid ""
"མ་ འདྲེས་པ་ བཅོ་བརྒྱད་ ལ་␣ས་ ཡེ་ཤེས་ ཀྱི་ བསྡུས་པ་ གསུམ་ དུ་ གསུངས་པ་␣འི་ "
"ཕྱིར་ ཡོད་ དོ་"
msgstr ""
"It is said that from the eighteen unsharings, the three  are summarized in "
"primordial wisdom."

msgctxt "04d335643d894b3ba511aa48f1b82baf"
msgid "ཞེས་ སྨྲ་ ཡང་ །"
msgstr "Although it is said."

msgctxt "22393ae7587e422699ec4744e0344159"
msgid ""
"རང་ལུགས་ ལ་ སངས་རྒྱས་ ཀྱི་ ས་␣ར་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ གཉིས་ སུ་ མེད་ ཅིང་"
msgstr ""
"In our own system, the primordial wisdom of knowing of the buddha is non-"
"dual."

msgctxt "a9fcbed690864dec83fbae4eb1551f88"
msgid "སྤྲོས་པ་␣འི་ མཐའ་ ཐམས་ཅད་ དང་ བྲལ་བ་"
msgstr "It is free from all the extremes of elaboration."

msgctxt "0e60ae497e8440c691fb0d69bd5a0601"
msgid "ཟབ་མོ་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་␣འི་ འཁོར་ལོ་␣ར་ བཞུགས་པ་ ཡིན་ ཏེ །"
msgstr "[He] is seated in the inconceivable profound wheel."

msgctxt "101bc3e511d84c018630c1585ada1b2f"
msgid "ཡོད་མེད་ དུ་ འདོད་པ་ ནི་ གཉིས་ སྣང་ གི་ བློ་ ཡིན་ ལ་"
msgstr ""
"The acceptance of existence or non-existence is a mind of dual appearances."

msgctxt "f4a36f6e1ea24152acc96bc67a412488"
msgid "མཐའ་ ཐུག་ གི་ ཡེ་ཤེས་ སུ་ མ་ཟད་"
msgstr "This is because it is not only that the final wisdom,"

msgctxt "6ae74ff8940443509b52dd1c99d7d3d8"
msgid "ལམ་ གྱི་ དོན་དམ་ ཡང་ བློ་␣འི་ ཡུལ་ མིན་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "But also the absolute of the path is not an object of the mind."

msgctxt "214776bb5e5c48778bcfae66651196e1"
msgid "དེ་ལྟར་ ཡང་ མཚན་ བརྗོད་ ལ་␣ས །"
msgstr ""
"Likewise, according to the [Sutra] Expressing The Names [of Manjushri]:"

msgctxt "eaf9a2de5d8d4de6aa2c34d52f0a70d4"
msgid "གཉིས་ མེད་ ཡེ་ཤེས་ ཚུལ་ འཆང་བ ། །"
msgstr "By holding the way of non-dual primordial wisdom."

msgctxt "0777a1dd980647118c82be6d55a81b7d"
msgid "རྣམ་པ་␣ར་ ཤེས་པ་␣འི་ ཆོས་ཉིད་ འདས །"
msgstr "Transcend the nature of phenomena of consciousness."

msgctxt "58ffc14921e34604ad7ebe64eab1b400"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "dff9210f053a45d795a0319764e0ff2e"
msgid "སྤྱོད་འཇུག་ ལ་␣ས །"
msgstr "According to the Engaging in the Bodhisattva's Conduct:"

msgctxt "7b2eb5df42a24c14a97e6d332019baf2"
msgid "དོན་དམ་ བློ་ ཡི་ སྤྱོད་ཡུལ་ མིན ། །"
msgstr "The absolute [truth] is beyond the reach of the mind."

msgctxt "418afc6a623b4742a7c19b92940e7ff8"
msgid "བློ་ ནི་ ཀུན་རྫོབ་ ཡིན་པ་␣ར་ འདོད །"
msgstr "The mind is accpeted as the relative."

msgctxt "315bd21886de4b049b2f716f10c57e29"
msgid "ཅེས་ སོ །"
msgstr "As said,"

msgctxt "86d66deaec2a48ab944fda020d251420"
msgid "དེས་ན་ ཆོས་ ཐམས་ཅད་ ཀྱི་ གནས་ལུགས་ ཇི་ལྟ་བ་ མཁྱེན་པ་ དང༌ །"
msgstr "Therefore, knowing the actuality of all phenomena just  as it is and"

msgctxt "dacbb7f74c2f46fb98adfaeaaceea95a"
msgid "སྟོང་ཉིད་ རྒྱུ་འབྲས་ སུ་ འབྱུང་བ་␣འི་ ཆོས་ ཐམས་ཅད་ ཀྱི་"
msgstr "All phenomena arising of emptiness as cause and effect,"

msgctxt "dda62ddf442d4975afc93a499ac84c72"
msgid "གཞི་ ལམ་ འབྲས་བུ་␣འི་ རྟེན་འབྲེལ་ ཇི་སྙེད་ མཁྱེན་པ་"
msgstr "knowing all the interdependence of ground, path, and result."

msgctxt "ef422899fc8d494fb40e7412a8d1c09c"
msgid "དེ་ གཉིས་ ཡོད་མེད་ སྤྲོས་པ་ ཐམས་ཅད་ ལ་␣ས་ གྲོལ་བ་ ཡིན་ ནོ ། །"
msgstr ""
"These two are free from all elaborations of existence and non-existence."

msgctxt "5859658f5d654cd3a576f06b15b6449a"
msgid "ཡོད་མེད་ དུ་ འདོད་པ་ ནི་"
msgstr "Accepting it as existence and non-existence is"

msgctxt "d096ca0051814c4d98fff324fa85c163"
msgid "རྟག་ཆད་ དང་ བདེ་འགྲོ་␣འི་ ལམ་ དང་ ངན་འགྲོ་ ལས་མ་ འདས་ ཏེ །"
msgstr ""
"It does not transcend the paths of permanence and nihilation, the paths of "
"happy migrations and bad migrations."

msgctxt "bda2cca2a03d4a519ad3c42c593d6a3e"
msgid "ཏིང་འཛིན་  རྒྱལ་པོ་ ལ་␣ས །"
msgstr "According to The King of Meditative Concentration [Sutra]:"

msgctxt "aef47db201c4475eb7cd088dc7ad1821"
msgid "ཡོད་ དང་ མེད་ ཅེས་བྱ་བ་ མཐའ་ ཡིན་ ཏེ །"
msgstr "So-called existence and non-existence are extremes."

msgctxt "1b93b575cbee4a6d8e8a54c1ffb7ffc9"
msgid "དེ་བཞིན་ གཙང་ དང་ མི་གཙང་ འདི་ ཡང་ མཐའ ། །"
msgstr "Likewise, purity and impurity are also extremes,"

msgctxt "e508afd0bfaa410f99afeeb49839a934"
msgid "དེ་ཕྱིར་ མཐའ་ འདི་དག་ ནི་ རྣམ་ སྤངས་ ཏེ །"
msgstr "Therefore, having abandoned these extremes,"

msgctxt "453b3526f02843e2a9a4c725e56b7d53"
msgid "མཁས་པ་␣ས་ དབུས་ ལ་␣འང་ གནས་པ་␣ར་ མི་ བྱ་␣འོ ། ༑"
msgstr "The wise never even abide in the middle."

msgctxt "49a2fc5572234431a155a7ce36021d53"
msgid "ཞེས་ དང་ །"
msgstr "And."

msgctxt "06b3b9b5f8954c27b5df99b6a1db1378"
msgid "སློབ་དཔོན་ འཕགས་པ་␣ས །"
msgstr "Master Arya said:"

msgctxt "5f84f1bcc0784334b6aa7f1f3817ccf1"
msgid "ཡོད་ ཅེས་བྱ་བ་ རྟག་པ་␣ར་ ལྟ ། །"
msgstr "To say \"it exists\" is a view of permanence,"

msgctxt "2d9ad2f63425405793f56d449405dea4"
msgid "མེད་ ཅེས་བྱ་བ་ ཆད་པ་␣ར་ ལྟ ། །"
msgstr "To say \"it is non-existence\" is a view of nihilation."

msgctxt "573361314fff4636bd4834f528076d18"
msgid "དེ་ཕྱིར་ ཡོད་  དང་ མེད་པ་ གཉིས ། །"
msgstr "Therefore, in two, existence and non-existence,"

msgctxt "695fd3165601431fa1d303c145328000"
msgid "མཁས་པ་␣ས་ གནས་པ་␣ར་ མི་ བྱ་␣འོ ། །"
msgstr "The wise should not abide."

msgctxt "f75d75f193ca4533a34369df3459b295"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "4770187a65354c83ab24456fe6fc9d83"
msgid "དེས་ན་ ཆད་པ་ ལྔ་ དང་ བྲལ་བ་ སྟེ །"
msgstr "Therefore, to be free from the five [extremes] of nihilation are:"

msgctxt "ea3ac20b62f9412998bd8f328038263f"
msgid "སྟོང་ཉིད་ དབུ་མ་ ཐལ་འགྱུར་བ་␣འི་ རྒྱ་ཆད །"
msgstr "The vast nihilation of the Prasangika Middle Way emptiness,"

msgctxt "3980df351d5b4462927576506dbef16b"
msgid "ཉན་ཐོས་པ་␣འི་ བཅོམ་ ཆད །"
msgstr "The defeating nihilation of the Shravakas,"

msgctxt "ebf0e18362b44c8088d83bf426b3016d"
msgid "མུ་སྟེགས་ ཆད་ལྟ་བ་␣འི་ ཤི་ཆད །"
msgstr "The dead-end nihilation of Tirthikas,"

msgctxt "db08480f0c2f4977ae6f9b836a1a426b"
msgid "བློ་␣ས་ བྱས་ ཀྱི་ སྟོང་པ་ ཕྱལ་ ཆད །"
msgstr "The empty nihilation produced by conceptual thought,"

msgctxt "ce92ce98ef0d45859801f8cabd882019"
msgid "རྫོགས་ཆེན་པ་␣འི་ གདོད་ ནས་ ཡེ་ ཆད །"
msgstr "The primordial nihilation of Dzogchen,"

msgctxt "aa25942807d74aaa85953487b1d8be4a"
msgid "དེ་ ལྔ་ ནི་ བློ་␣ས་ གཞལ་བ་␣འི་ ཆོས་ ལས་མ་ འདས་ ཏེ །"
msgstr ""
"These five do not transcend phenomena that are merely measured by a rational"
" mind."

msgctxt "3ea0db36502445968a3f7157c22ff4b7"
msgid "དོན་དམ་ བློ་ ཡི་ སྤྱོད་ཡུལ་ མིན་ སོགས་ ཀྱིས་ ཤེས་པ་␣ར་ ནུས་ སོ ། །"
msgstr ""
"It can be known by the [verse], the absolute [truth] is beyond the reach of "
"the mind and so on. "

msgctxt "8709ac8057b54fd7b3c3580b9221ee2c"
msgid "དེས་ན་ བློ་␣ས་ དཔག་པ་ ལ་␣ས །"
msgstr "Thus, from the mental assessment,"

msgctxt "2a7174f8b3c54bdf98bc8987e765a43a"
msgid "ཚད་མ་␣ར་ གཟིགས་པ །"
msgstr "It is seen as a valid cognition."

msgctxt "201a0cc2f0f44d70ad1d6e3d45661755"
msgid "མཁྱེན་པ་␣ར་ གཟིགས་པ་ ཞེས་ དང༌ །"
msgstr "It is seen as a knowledge and "

msgctxt "dc20cf6500fd4446bd8d8d8eaad78fae"
msgid "སློབ་དཔོན་ ཕྱོགས་གླང་ གིས །"
msgstr "Master Dignaga said:"

msgctxt "a19873df5a2d4d19b3232d0a44f86ec4"
msgid "ཚད་མ་␣ར་ གྱུར་པ་ འགྲོ་ ལ་ ཕན་ བཞེད་པ །"
msgstr "[One] who becomes a valid [person] and wishes to help migrators,"

msgctxt "f8b95181c427402391930a78b76cf0cf"
msgid "སྟོན་པ་ བདེ་གཤེགས་ སྐྱོབ་ ལ་ ཕྱག་ འཚལ་ ལོ ། །"
msgstr "Homage to the teacher, the Sugata."

msgctxt "edd130c245f14ebf9ca5a417c005b5a6"
msgid "དེས་ན་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་␣འི་ གནས་ ལ་ སྐུར་བ་ འདེབས་པ་"
msgstr "Thus, denigration to the inconceivable places [or subjects]."

msgctxt "1e8bce600dba4ef090d67a6fdb5063d2"
msgid "འདི་ ལྟ་བུ་ ལ་ རྣ་བ་ བགབ་པ་␣ར་ བྱ་␣འོ ། །"
msgstr "One should cover their ears. "

msgctxt "e75c1646243a4259ad754593b02dc4ee"
msgid "རྡོ་␣༽༽  ས་ དང་པོ་ ཡན་ ལས་སྒྲིབ་ དང༌ །"
msgstr "Vajra: The [abandonement] of obscurations from the first level and"

msgctxt "f7b228f7a8964feb9b073f36893531ef"
msgid "ས་ བདུན་ ལ་ ཉོན་སྒྲིབ །"
msgstr ""
"The seven levels are the [abandonement] of afflictional obscurations, "

msgctxt "12610d5981c14515b8c4e039ecfa01a8"
msgid "རྒྱུན་ མཐརཤེས་ སྒྲིབ་ སྤོང་བ་␣འམ །"
msgstr ""
"The abandonement of the knowables obscuration at the end of the continuum."

msgctxt "6d4b37cf0a654c93ae6357c982f44bee"
msgid "མཐོང་ལམ་ གྱིས་ ཉོན་མོངས །"
msgstr "The path of seeing eliminates the afflictions."

msgctxt "3b8ca37ef9ff4700935f611ea35275c8"
msgid "སྒོམ་ལམ་ སྒོམ་ སྤངས་ ཏེ །"
msgstr "That to be abandoned by the path of meditation."

msgctxt "f1813e5239404376af2652daa621c39c"
msgid "མོས་པ་ བྲལ་བ་␣འི་ ངོ་བོ་␣ར་ སངས་རྒྱས་པ་ ན་"
msgstr ""
"When one becomes enlightened in the essence of freedom from adherence,"

msgctxt "b5fd4be62b684c3896e5b69b9b712687"
msgid "མཉམ་བཞག་ སྟོབས་ ཆེ་བ་␣ས་ རྗེས་ཐོབ་ ཆད་ དེ །"
msgstr ""
"The post-attainment is nihilitated by the great power of meditative "
"equipoise."

msgctxt "fd45c07d8b814c5daff23b650ea050bf"
msgid "རྟེན་ སྐུ་བསོད །"
msgstr "The supporting body, merit,"

msgctxt "4c41f178fdc34c6992b05c024234d3fc"
msgid "བརྟེན་པ་ ཡེ་ཤེས་ མཛད་འཕྲིན་ རྣམས་ ཀྱང་ མེད་ དེ །"
msgstr ""
"And supported wisdom, as well as the deeds and activities, are also absent."

msgctxt "d2cc122814964a2da26fe079684aa5cf"
msgid "མེ་ ཆེ་␣ར་ འབར་ ན་ དུ་བ་ ཆད་པ་ བཞིན་ ནོ །"
msgstr "Just as smoke is nihilitated when a great fire blazes."

msgctxt "262db71bf24548a58be46a9c54393483"
msgid "ཅི་ཕྱིར །"
msgstr "Why is this?"

msgctxt "e7b125ee5cd04c2c86b669e76bf14705"
msgid "གསང་བ་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་␣འི་ མདོ་ ལ་␣ས །"
msgstr "According to the Inconceivable Secret Sutra:"

msgctxt "b7f437c19ef84ab39e571af33dde036f"
msgid "ཐུགས་ ཀྱི་ གསང་བ་␣འི་ སྐབས་"
msgstr "At the point of the secret of the mind,"

msgctxt "76ab38854904494a80a284b5d40370f5"
msgid "འདུ་ཤེས་ མེད་པ་␣འི་ ལྷ་␣ར་ དཔེ་ མཛད་པ་ ཡང་ དོན་ འདི་ ཡིན་ ནོ །"
msgstr ""
"The example of the deity without perception is also the meaning of this."

msgctxt "bccb093fafbf4569af8b78bf458b7b42"
msgid "རྣམ་རྟོག་ མེད་ བཞིན་ དུ་ སྔར་ ཚོགས་ བསགས་པ་␣ས་"
msgstr ""
"While without discursive thoughts, because of previously accumulating merit,"

msgctxt "4523a555ac5a4c18a163e2f52c287123"
msgid "ནམ་མཁའ་ ལྡིང་ གི་ མཆོད་སྡོང་ དང་"
msgstr "The offering post of the garuda and"

msgctxt "1b655e02877541cab8aac28f1b17f3ad"
msgid "ནོར་བུ་ དཔག་བསམ་ ཉི་མ་ བཞིན་"
msgstr "Like a wish-fulfilling jewel or the sun."

msgctxt "3390edd0dce44121b9cc399f0ae9d02a"
msgid "གདུལ་བྱ་␣འི་ བློ་ ངོ་␣ར་ སྣང་བ་ མི་ འགལ་ ཟེར་ རོ ། །"
msgstr ""
"It is said that there is no contradiction in terms of appearing to the minds"
" of disciples."

msgctxt "569bb807832949868fec76a6ba44f782"
msgid "འདི་␣ར་ ནི་ སྤང་བྱ་ སྒྲིབ་པ་ ཐམས་ཅད་ དང་ བྲལ་བ་␣འི་ འབྲས་བུ་␣ས་"
msgstr ""
"In this [system], the result of being free from all obscurations that are to"
" be abandoned"

msgctxt "d1b528594e314d04af3d27de6425e835"
msgid ""
"སྤྲོས་བྲལ་ ཇི་ལྟ་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ དང་ རྟེན་འབྲེལ་ ཇི་སྙེད་ མཁྱེན་པ་␣འི་"
" ཡེ་ཤེས་ ཀྱི་ ཐུགས་ ཅན་"
msgstr ""
"The primordial wisdom that knows things just as they are free from "
"elaboration and the primordial wisdom that knows the entire knowledge of "
"omniscience of dependent origination."

msgctxt "59b64aa67e504667afa74f1cd98a3a47"
msgid "རྣམ་ རྟོགས་ ཐམས་ཅད་ དང་ བྲལ་བ་ བཞེད་ དེ་"
msgstr "Which are free from all discursive thoughts."

msgctxt "f53a7f6b8a6949589f5516a18ef783a9"
msgid "སྐུ་གསུང་ཐུགས་ ཀྱི་ ཕྲིན་ལས་ ཐམས་ཅད་ ཀྱི་ སྔོན་ དུ་ འགྲོ་ ཞིང་"
msgstr ""
"The enlightened activities of body, speech, and mind go before all and"

msgctxt "00e83e7106b14b0aa128cbe4e79f1baa"
msgid "རྗེས་སུ་ འབྲང་བ་ དང༌ །"
msgstr "Follow and "

msgctxt "3a6ff075aa014034b7fdecbb2e6453d5"
msgid ""
"དུས་གསུམ་ ལ་མ་ ཆགས་ མ་ ཐོག་པ་␣འི་ ཡེ་ཤེས་ ཀྱི་ གཟིགས་པ་ འཇུག་པ་␣ར་ "
"གསུངས་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"This is because it is said that it engages in the observation of the "
"primordial wisdom that is unattached and unimpeded in the three times."

msgctxt "df8ca7464e3a4d0e8044dd95d5d93ea4"
msgid "དེ་ལྟར་ ཡང་ །"
msgstr "Likewise,"

msgctxt "5bd5184bfcfd4b8d90fb211320714896"
msgid "ནད་ ཐམས་ཅད་ ཞི་བ་␣ར་ བྱེད་པ་␣འི་ གཟུངས་ ལ་␣ས །"
msgstr "According to the Retainer that Pacifies All Illnesses:"

msgctxt "24e2ef9e41a3484d8e51690e288d429f"
msgid "འདི་ ལ་ སངས་རྒྱས་ ནི་ སེམས་ཅན་ གྱི་ མཆོག་ གོ  །"
msgstr "Here, the Buddha is the supreme of the sentient beings."

msgctxt "4bd5083a66044a7f876a511e15df853e"
msgid "དཔའ་བོ་␣ས །"
msgstr "Heroes"

msgctxt "54d323cc8d394849b0ac940d8c0515bd"
msgid "རྣམ་རྟོག་ མི་ མངའ་ ཅིར་ ཡང་ ས་ལེ་␣ར་ མཁྱེན །"
msgstr "Do not possess discursive thoughts and know everything clearly."

msgctxt "32552230125549e3ac226f685ea52165"
msgid "ཅེས་ དང་ །"
msgstr "And,"

msgctxt "13497b1cbd93454480c3661c98f367fd"
msgid "མཚན་ བརྗོད་ ལ་␣ས་ ༑"
msgstr "According to the Expressing the Names [sutra]:"

msgctxt "8e9ad49de19b4d55b4ecd46b4b664bce"
msgid "ཡེ་ཤེས་ སྣང་བ་ ལམ་མེ་བ །"
msgstr "The light of primordial wisdom is brilliant."

msgctxt "ea7a883097874eb5ae2b6ddf12218342"
msgid "ཞེས་ སོ་␣༑ །"
msgstr "As said"

msgctxt "49a8c6aff1054c7aa58dc7bd8bcb12b3"
msgid "སངས་རྒྱས་ ཐུགས་ ཀྱི་ འཇུག་པ་ ཆད་པ་␣ར་ འདོད་པ་ དེ་ ཆོས་ཅན །"
msgstr ""
"Take the subject, the acceptance that the discontinuance of the engagement "
"of the Buddha’s mind,"

msgctxt "5ea2dfc153f84810955c90f905466fd2"
msgid "མཁྱེན་ གཉིས་ དང་ ཐུགས་ མི་ཟད་པ་ རྒྱན་ གྱི་ འཁོར་ལོ་ རྒྱུན་ ཆད་ དུ་ཐལ །"
msgstr ""
"It follows that the continuum of the two [enlightened] knowledges and the "
"wheel of the inexhaustible ornament of the mind is discontinuous."

msgctxt "796b98124a2e42b08df3b79ac425c69f"
msgid "འགགས་པ་␣འི་ ཕྱིར་ བེམ་པོ་ བཞིན་ ནོ ། །"
msgstr "Because it has ceased, like matter."

msgctxt "40955ec8c95b4394bd325abe72d9e1a5"
msgid "དེ་ལྟར་ ཡང་ རིན་ཆེན་ འབར་བ་␣འི་ རྒྱུད་ ལ་␣ས །"
msgstr "Thus, according to the Precious Blazing Tantra:"

msgctxt "904686d215a6426bb00b8c510247d579"
msgid "ཐམས་ཅད་ སེམས་ ལ་ གནས་པ་␣ས་ ན ། །"
msgstr "If everything abides in the mind,"

msgctxt "43a8c1a6758e45d59e2d2a46e3f8fea9"
msgid "སེམས་ མེད་ སངས་རྒྱས་ མ་ ཡིན་ ཏེ །"
msgstr "The mindless is not the Buddha,"

msgctxt "81c09aafe80f4746adbd1d43419b043d"
msgid "ངམ་གྲོག་␣ས་ ལ་སོགས་ བེམ་བོ་␣འོ ། །"
msgstr ""

msgctxt "fc2e6a4fe5b04060a9a92cbd6a2141e7"
msgid "སེམས་ཉིད་ སངས་རྒྱས་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr "Because the mind itself is the Buddha."

msgctxt "b281c1be1a2b44268db98cd256afaf25"
msgid "ཞེས་ སོ་␣༑ ༑"
msgstr "As said."

msgctxt "570f0715fe434cf1ac864704c8cc223b"
msgid "འོ་ན་ མེད་པ་␣ར་ གསུངས་བ་ མཐའ་ཡས་པ་␣ས་ ཅི་ ཞེ་ན །"
msgstr ""
"Well then, if it is asked \"why is it infinitely stated that it does not "
"exist?\""

msgctxt "0e079c31832646fc8cbcfb6869300127"
msgid "དེ་ ནི་ རྣམ་རྟོག་ གཉིས་ སུ་ འཛིན་པ་␣འི་ སེམས་ མེད་ གསུངས་ ཀྱི །"
msgstr ""
"It says that the absence of the mind that apprehends the two discursive "
"thoughts."

msgctxt "8071c8888ac445b8bc9fa3fd646666ed"
msgid ""
"སྒྲིབ་པ་ ཐམས་ཅད་ བྲལ་བ་␣འི་ ཡེ་ཤེས་ ཀྱི་ ཐུགས་ མེད་ ཅེས་ གསུངས་པ་ མིན་པ་␣འི་"
" ཕྱིར་ རོ ། །"
msgstr ""
"It does not say that there is no mind of primordial wisdom free from all "
"obscurations."

msgctxt "12f66ebf2e6646f5a133f60702cb6eda"
msgid "སྣང་བ་ མེད་པ་␣ར་ གསུངས་པ་ ཡང་"
msgstr "The statement that appearances do not exist is also"

msgctxt "8e80608381354d0597c34acd04c4dead"
msgid "ཕྱི་དོན་ དུ་ གྲུབ་པ་ མེད་པ་␣ས་ ཡིན་ ནོ་␣༑ ༑"
msgstr "Because they are not established as external objects."

msgctxt "2f844729dc294191b18cdf8e276b5b23"
msgid "རྡོ  ༽༽  ཆོས་སྐུ་ སྟོང་པ་ཉིད་ མ་ རྟོགས་ ཀྱང་"
msgstr "Vajra: Even though dharmakaya is not realized as emptiness,"

msgctxt "f19d597fab3942229a782f2de0b9d723"
msgid "རང་བཞིན་ གྱིས་ སེམས་ཅན་ རྣམས་ ལ་ ཡོད་པ་␣ས་"
msgstr "Because it is present as intrinsic nature in sentient beings"

msgctxt "6f896181254b4d548ab68cb76bfa014e"
msgid "ཚེས་ གཅིག་ གི་ ཟླ་བ་ ཉ་␣ར་ འཕེལ་བ་ བཞིན་"
msgstr ""
"Like the moon of the first day [of the month] waxes until it is at its "
"fullest."

msgctxt "83dc62702b99454d9af0314cfa72887f"
msgid "ས་བཅུ་ རྒྱུན་མཐ་␣འི་ བར་ འཕེལ་བ་␣ས་"
msgstr "It will grow until the end of the continuum of the tenth level."

msgctxt "b73d948c0bff47769a8210d5a6987300"
msgid "རྒྱུ་རྐྱེན་ གཉིས་ ཆོས་ ཐམས་ཅད་ ལ་␣ས་ འདས་ ཏེ་"
msgstr "When [one] transcends all phenomena of cause and condition and "

msgctxt "899a657df9654c7dbacfef4f534687d7"
msgid "བྱང་ཆུབ་པ་ ན་ སྐྱོན་ཡོན་ གང་ཡང་ མེད་ ཟེར་ རོ །"
msgstr ""
"And is enlightened, it is said that there are no faults or good qualities."

msgctxt "2192d55f194849b0a7221fb19ede4b5b"
msgid "འདི་␣ར་ ནི་ ཆོས་སྐུ་␣འི་ ཡོན་ཏན་ ལོངས་སྐུ་ དང་ སྤྲུལ་སྐུ་ ནི་"
msgstr ""
"In this system, the qualities of the Dharmakaya are the sambhogakaya and the"
" nirmanakaya,"

msgctxt "f33cba657a794118a398da94cd5c28c3"
msgid "དེ་␣འི་ མཛད་པ་␣འི་ ཕྲིན་ལས་ དང་ བཅས་པ་ སྟེ་"
msgstr "Together with their deeds and enlightened activities."

msgctxt "fd67dbc32ad248018cffc770f0ed7b08"
msgid "དེ་དག་ ཆོས་སྐུ་␣ར་ མངའ་བ་ ཡིན་ ཏེ །"
msgstr "They are endowed with the dharmakaya."

msgctxt "583a1a381ce740968d41398b4e7775cc"
msgid "རྗེ་བཙུན་ བྱམས་པ་␣ས །"
msgstr "The venerable Maitreya said:"

msgctxt "313a9a04da7e48ea8cc7c9425a298819"
msgid "རང་དོན་ གཞན་དོན་ དོན་དམ་ སྐུ་ རང་ ནི ། །"
msgstr "The absolute body, for the sake of self and the sake of others,"

msgctxt "2030d6eb40f54383a396a22593733fb3"
msgid "དེ་ ལ་ བརྟེན་ ནས་ ཀུན་རྫོབ་ སྐུ་ ཉིད་ དེ །"
msgstr "In dependence upon that, the relative body itself,"

msgctxt "2c9023c077f4496ca2da775e68a7cc51"
msgid "ཞེས་ སོགས་ གསུངས་པ་␣འི་ ཕྱིར་ རོ་␣༑ ༑"
msgstr "And so forth."

msgctxt "272f7d288335429780bd3eb7362887c4"
msgid "དེ་ལྟར་ ན་ སྐུ་གསུང་ཐུགས་ མི་ཟད་པ་ རྒྱན་ གྱི་ འཁོར་ལོ་"
msgstr ""
"Thus, the wheel of the inexhaustible ornaments of body, speech, and mind is"

msgctxt "8ad89ac2dfe1413c9a1a75ced80bdf30"
msgid "སེམས་ཅན་ གྱི་ ཁམས་ དང་ མཉམ་པ་"
msgstr "Equal to the realms of sentient beings."

msgctxt "9bf09c0a59b443d0a65d6ff9ee98a888"
msgid "ཕྱི་མ་␣འི་ མཐ་␣འི་ མུ་␣ར་ ཐུག་ གི་ བར་ དུ་ འབྱུང་བ་ ཡིན་ ནོ ། །"
msgstr "It will continue until the end of the latter one."

msgctxt "986714c32bbb4e0ab1479946017f7972"
msgid "དེ་ལྟར་ མིན་པ་ སངས་རྒྱས་པ་ མཐར་ཐུག་"
msgstr "If this is not the case, and at the final level of buddhahood,"

msgctxt "22d7f0512e2e495ea0ec4e0ab201ba97"
msgid "ཆོས་སྐུ་␣འི་ ས་␣ར་ ཡོན་ཏན་ ཕྲིན་ལས་ མེད་ ན་"
msgstr ""
"If there are no good qualities and enlightened activities of dharmakaya,"

msgctxt "0b8eb3180ff8443298928203fa00ebba"
msgid "རྒྱུན་ ཆད་ དེ་ ཕྲིན་ལས་ མི་ འཇུག་ ཅིང་"
msgstr ""
"The continuum would be interrupted, and enlightened activity would not be "
"engaged."

msgctxt "8cd1c094c5d04c16a2cd45ee64a53908"
msgid "ཆད་ལྟ་བ་ དང་ ཁྱད་མེད་པ་␣ར་ འགྱུར་ རོ་␣༑"
msgstr "This would become no different from the view of nihilism."

msgctxt "04aeaeb381e24b98b5155ed4a5738a52"
msgid "རྡོ་␣༽༽  སངས་རྒྱས་ རྣམས་ འབྲས་བུ་␣འི་ སྔོན་ དུ་"
msgstr "Vajra: It is said that the buddhas, before the result,"

msgctxt "5a4472172db6466489a94cd97b97184b"
msgid "རྒྱུ་ བྱང་ཆུབ་ ཏུ་ ཐུགས་བསྐྱེད་ དེ་"
msgstr "Arise the causal mind of enlightenment and"

msgctxt "9eee78cb4fa24228b823956e3090b7a7"
msgid "འབྲས་བུ་ མཐ་␣ར་ ཕྱིན་པ་ ན་"
msgstr "When the result is completed,"

msgctxt "a86d6f283d0a4064b936cee1895f59e8"
msgid "རྒྱུ་ལ་ མི་ འཇུག་པ་␣ས་ ཐུགས་བསྐྱེད་ ཡོད་ ཟེར །"
msgstr ""
"They do not engage in the cause, because they have the mind [for "
"enlightenment]."

msgctxt "27bdc2fc1b3942d7a284caf2e8c0c9be"
msgid "དེ་ ཆོས་ཅན་"
msgstr "Take that as the subject,"

msgctxt "7dc400053cfa42a69a50bdc58c33ae1f"
msgid ""
"འབྲས་བུ་ མཐར་ཐུག་ རྣམ་པ་ ཐམས་ཅད་ མཁྱེན་པ་ སངས་རྒྱས་ ཀྱི་ ས་ ན་␣འང་ "
"ཐུགས་བསྐྱེད་ ཡོད་ དེ །"
msgstr ""
"The ultimate result, the knower of every aspect, the mind [for "
"enlightenment] is also present at the level of buddhahood."

msgctxt "0e8350288d514804bf79b456e6a3c78a"
msgid ""
"བྱང་ཆུབ་ ཀྱི་ སེམས་ མཐ་␣ར་ ཕྱིན་པ་␣འི་ སྐུ་གསུང་ཐུགས་ མི་ཟད་པ་ རྒྱན་ གྱི་ "
"འཁོར་ལོ་ རྒྱུན་ མི་ ཆད་པ་␣འི་ ཕྱིར །"
msgstr ""
"This is because the wheel of the inexhaustible ornaments of body, speech, "
"and mind of the final bodhicitta is uninterrupted."

msgctxt "b02bbac072834cafbcc265ae069eb3a1"
msgid ""
"དཔེར་ན་ ཉི་མ་␣འི་ དཀྱིལ་འཁོར་ ལ་ འོད་ཟེར་ རྒྱུན་ མི་ ཆད་པ་ བཞིན་ ནོ ། །"
msgstr ""
"For example, it is like the sun's disk, which has uninterrupted light rays."

msgctxt "b7845e5e9ee847fead920532e34a177e"
msgid "དེ་ལྟར་ ཡང་ བྱང་ཆུབ་ སེམས་ འགྲེལ་ ལ་␣ས །"
msgstr "Likewise, according to A Commentary on Bodhicitta:"

msgctxt "074b15235b254fcb936e941e4fddb37b"
msgid "བྱང་ཆུབ་ སེམས་ ཀྱི་ རང་བཞིན་ སྐུ ། །"
msgstr "The body of the nature of bodhicitta,"

msgctxt "9dadda497ac5482fa807e7f7358a1a00"
msgid "དཔལ་ལྡན་ རྡོ་རྗེ་ འཆང་ ལ་ འདུད །"
msgstr "The glorious Vajradhara, to you I bow."

msgctxt "4c1d1ea8989e49809f49f10b7e7ab6c3"
msgid "ཅེས་པ་␣ས་"
msgstr "Thus,"

msgctxt "3e2e861923f84c4ab30a33afc6521a41"
msgid "གཞན་དོན་ དུ་ ཐུགས་བསྐྱེད་པ་ འཁོར་བ་ མ་ སྟོང་ གི་ བར་ དུ་ འབྱུང་ ཞིང་"
msgstr ""
"The arousing of the mind of enlightenment for the sake of others will "
"continue until samsara is emptied."

msgctxt "d1c05c811f1e486989e2e78014a6c0db"
msgid "མྱ་ངན་ ལས་མི་ འདའ་ སྟེ །"
msgstr "[He] will not pass into nirvana because."

msgctxt "8594b456114d4925b01ec9a9937f69f4"
msgid "ཡབ་ སྲས་ མཇལ་བ་ ལ་␣ས །"
msgstr "According to the Meeting of the Father and Son:"

msgctxt "52db63ddd2ec41dc8cdac719f9f73c3b"
msgid "དཔའ་བོ་ ཆེན་པོ་ ཐབས་མཁས་ ཏེ ། །"
msgstr "The great hero, skilled in means,"

msgctxt "7ebe8e0f14f742cc9731b04555ededa5"
msgid "བྱེ་བ་ བརྒྱད་ཅུ་␣ར་ རྒྱལ་བ་ ཉིད ། །"
msgstr "The very conqueror of eight hundred million."

msgctxt "ddd1da0681304b479e48848b0bc1a548"
msgid "སངས་རྒྱས་ ཉིད་ དུ་ བསྟན་ གྱུར་ ཀྱང་ ། །"
msgstr "Although he was shown to be a buddha,"

msgctxt "ba6cdf1dd40343a2ba13363972510955"
msgid "ད་དུང་ ཆོག་པ་␣འི་ འདུ་ཤེས་ གསལ ། །"
msgstr "[He] Still clearly has the perception of contentment."

msgctxt "108d601676cb41b0a351340c41d47d3d"
msgid "དཔའ་བོ་ ཆེན་པོ་ རྣམ་པ་␣ར་ འཕྲུལ ། །"
msgstr "The great hero is the emanation."

msgctxt "ad87694465f14a57b04742415dd84bc4"
msgid "བྱང་ཆུབ་ མཆོག་ ཏུ་ ཐུགས་ ཀྱང་ འཇུག  །"
msgstr "[He] also enters into the mind of supreme enlightenment."

msgctxt "7c1de73a082047a69f1f23e4f03d790d"
msgid "ཅེས་ དང་ །"
msgstr "And."

msgctxt "adb50e71e8904dfe82c7b684193852a0"
msgid "དབུ་མ་ འཇུག་པ་ ལ་␣ས །"
msgstr "According to the Entrance to the Middle Way:"

msgctxt "0a72574cec8442c3a7a0392d4909573a"
msgid "བདེ་བ་␣ར་ གཤེགས་པ་ མ་ ལུས་ ཕྱོགས་ ཞིང་ སངས་རྒྱས་ མཐའ་དག་ ན ། །"
msgstr "In all the buddha realms of all the sugatas,"

msgctxt "c8a681694d4248e6925acd4146cb32d9"
msgid "ཕྲ་རབ་ རྡུལ་ གྱི་ རྡུལ་ རྣམས་ བདོག་པ་␣ར་ གྱུར་པ་ ཇི་སྙེད་པ །"
msgstr "As many as there exist finest particles,"

msgctxt "82f0cf323cb1496c8d97be169f54bbba"
msgid "བྱང་ཆུབ་ མཆོག་རབ་ དམ་པ་␣ར་ གཤེགས་པ་␣འི་ བསྐལ་པ་␣འང་ དེ་སྙེད་ དེ །"
msgstr "That many are the eons of supreme enlightenment;"

msgctxt "1720c3cd68e84b91b0b75a55ee9e477a"
msgid "འོན་ཀྱང་ ཁྱོད་ ཀྱི་ གསང་བ་ འདི་ ནི་ བསྙད་ བགྱི་ མ་ ལགས་སོ ། །"
msgstr "Yet your secret can still not be explained."

msgctxt "70c39cd26fd5448bb0d3b43b485dfef4"
msgid "རྒྱལ་བ་ ཇི་སྲིད་ འཇིག་རྟེན་ མཐའ་དག་ མཆོག་ ཏུ་ རབ་ ཞི་བ་␣ར །"
msgstr "Victors as long as the world has not attained,"

msgctxt "513bf6e0733742c184700c0427deefb8"
msgid "འགྲོ་བ་ མིན་ ཅིང་ ནམ་མཁའ་ རྣམ་ འཇིག་ འགྱུར་ མིན་ དེ་སྲིད་ དུ །"
msgstr "Will not be gone, until all the space destruct,"

msgctxt "c5c32c50c409456097a48021975519e4"
msgid "ཤེས་རབ་ ཡུམ་ གྱིས་ བསྐྱེད་པ་ ཁྱོད་ ལ་ ཐུགས་ བརྩེ་ མ་མ་ ཡི ། །"
msgstr "Born from wisdom-mother's love to you,"

msgctxt "10fba32db18c48ce90e76628521b1378"
msgid "ཚུལ་ ལུགས་ བྱེད་པ་␣ས་ རབ་ཏུ་ ཞི་བ་␣ར་ འགྱུར་བ་ ག་ལ་ མངའ ། །"
msgstr "In this way, having become the highest peace, how could one remains,"

msgctxt "c7e08866d2c5466ab1aca30574e07139"
msgid "གཏི་མུག་ སྐྱོན་ གྱིས་ འཇིག་རྟེན་ ཁ་ཟས་ དུག་ བཅས་ ཟ་བ་ ཉིད ། །"
msgstr "For beings who consume the worldly poisoned food of ignorance,"

msgctxt "078bdd90db0a4cbaa405dd8f2e98b93f"
msgid "སྐྱེ་བོ་ ཉིད་ ཀྱི་ ནང་མི་ དེ་ ལ་ ཁྱོད་ བརྩེ་ ཇི་ལྟ་བ ། །"
msgstr "Just as your compassion extends to your family members,"

msgctxt "684297f18c8b485996af81661d05f125"
msgid ""
"དེ་ལྟར་ དུག་ ཟོས་ ཉེན་པ་␣འི་ བུ་ ལ་མ་ ཡི་ སྡུག་བསྔལ་ མིན་པ་␣ར་ འགྱུར་ མ་ "
"ལགས་␣༎"
msgstr ""
"Just as a mother feels such pain when her dear child has taken poison,"

msgctxt "c8c0bf7fc710430f9582b80ea3907a7d"
msgid "དེས་ན་ མགོན་པོ་ མཆོག་ ཏུ་ རབ་ ཞི་␣ར་ གཤེགས་པ་␣ར་ གྱུར་ མ་ ལགས ། །"
msgstr "Thus, guardians will not pass into supreme peace."

msgctxt "20adcd390b3b4dcd8e18379e49f9054b"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "012a96f68d064c44b9d5220cd689c4c1"
msgid "སྡུད་པ་ ལ་␣ས །"
msgstr "According to the Condensed [Prajnaparamita In Verse]:"

msgctxt "17633856018d4efe844ae570929edc38"
msgid "མ་ ཞིག་ ན་བ་␣ར་ གྱུར་པ་ བུ་ ནི་ མང་ ཡོད་པ ། །"
msgstr "A mother with many sons has become sick,"

msgctxt "09cc50cff0fc4a988e460458241ee4da"
msgid "དེ་ ཀུན་ ཡིད་ མི་ བདེ་ ཞིང་"
msgstr "All of them are unhappy and "

msgctxt "1fe93391526a472bbbc32c3532f2cebb"
msgid "དེ་ ལ་ རིམ་གྲོ་ བྱེད ། །"
msgstr "Serve as her attendant."

msgctxt "47515d25dd8f417badc46d17f415cd5a"
msgid "དེ་བཞིན་ ཕྱོགས་ བཅུ་␣འི་ འཇིག་རྟེན་ ཁམས་ ཀྱི་ སངས་རྒྱས་ ཀྱང༌ ། །"
msgstr "Likewise, the buddhas of the world realms in the ten directions,"

msgctxt "d5ffc8a36e5e4e35a8c9411c88f52de8"
msgid "ཡུམ་ གྱུར་ ཤེས་རབ་ དམ་པ་ འདི་ ལ་ དགོངས་པ་ མཛད །"
msgstr ""
"Have given their attention to this supreme wisdom that becomes as their "
"mother."

msgctxt "a76509d1ff2f4c079808f472d515f619"
msgid "ཅེས་པ་␣ས །"
msgstr "Thus,"

msgctxt "5cc3dabd99c748d98339875677e56a08"
msgid "སངས་རྒྱས་ ཀྱི་ ས་ ན་ ཐུགས་བསྐྱེད་"
msgstr "Aroused the mind [for enlightenment] on the level of buddhahood."

msgctxt "9d36fa1e28d244879e036b1750c3d4d8"
msgid "མངོན་ རྒྱན་ ལ་␣ས །"
msgstr "According to the Ornament of Manifest Realization:"

msgctxt "ea0e0a6336a34efba640b2bb7e71ebc0"
msgid "ཆོས་ ཀྱི་ དགའ་སྟོན་ སྒྲ་སྙན་ ལྟ་བུ་ དང༌ ། །"
msgstr "The Dharma festival is like a melodious sound."

msgctxt "e369eae8e5c9402994500cc52eff6911"
msgid "བགྲོད་ གཅིག་ ལམ་ ཆུ་བོ་ ལྟ་བུ་ དང༌ །"
msgstr "The path that one traverses is like a river and"

msgctxt "3f1eb38c8e334747bab19bc6cbbe7f67"
msgid "ཆོས་སྐུ་ སྤྲིན་ ལྟ་བུ་ གསུམ་ དུ་ གསུངས་པ་ དང༌ །"
msgstr "The dharmakaya is like a cloud. It is taught in three [kinds]."

msgctxt "df1d6e7d966b456ba3b846ff985a4549"
msgid "མངོན་ རྒྱན་ ལ་␣ས །"
msgstr "According to the Ornament of Manifest Realization:"

msgctxt "0b937d40dd204d0bba70c1c055bf5dbd"
msgid "སྒྲིབ་པ་ སྤངས་པ་␣འི་ སེམས་བསྐྱེད་ སོགས་ བཤད་ ཅིང་ །"
msgstr ""
"It explains the generation of mind of awakening that abandons the "
"obscurations, and so forth."

msgctxt "8bb223c113ec4508b04afd1977f9ec4f"
msgid "གསང་འདུས་ གཉིས་ མེད་ རྣམས་ ལ་␣ས །"
msgstr "According to all the Non-dual Gathered Secret:"

msgctxt "9ca9187278d642b6b81064ff9b2d5a3a"
msgid "བྱང་ཆུབ་ སེམས་ ནི་ མི་ཟད་ ཕྱིར ། །"
msgstr "Because bodhicitta is inexhaustible, "

msgctxt "80b3960b3e59427da03b9597a3a2ba77"
msgid "དེ་ཕྱིར་ ཕྲིན་ལས་ རྒྱུན་ མི་ ཆད །"
msgstr "Thus, the enlightened activity is uninterrupted."

msgctxt "63d2db56d5d0431ea891af11cef3fca9"
msgid "ཅེས་ སོ །"
msgstr "As said."

msgctxt "c343b15626da4fe699dcdc5b5614fd04"
msgid ""
"ལྷན་␣༽༽  སངས་རྒྱས་ མྱ་ངན་ འདས་ ན་ བུད་ཤིང་ ཟད་པ་␣འི་ མེ་ བཞིན་ དུ་ འདོད་པ་ "
"དང་"
msgstr ""
"Addendum: It is accepted that when a buddha has passed into nirvana, it is "
"like a fire whose firewood is exhausted."

msgctxt "614e941042dd4871b05f8ca424fe3beb"
msgid "སྐུ་␣འི་ གདུལ་བྱ་ ཟད་ ནས་ གསུང་ གི་ གདུལ་བྱ་␣ར་ བསྟན་ ཏེ་"
msgstr ""
"When the disciples of the body have been exhausted, the disciples of the "
"speech are taught."

msgctxt "83787a6ab2f94eeaa0252043ccbc6838"
msgid "འོག་མིན་ དུ་ གཤེགས་ ཏེ་ བཞུགས་པ་␣ས་"
msgstr "[He] went to Akanistha and dwelled there."

msgctxt "e305ab03711343fa8a6a310a847025c3"
msgid "བསོད་ནམས་ བསགས་པ་␣འི་ ངོ་␣ར་"
msgstr "To those who had accumulated merit,"

msgctxt "ef895dc927ee4deca73567b961efc446"
msgid "ལན་ རེ་ སྣང་བ་ ཡིན་ ཟེར་ རོ ། །"
msgstr "It is said that [here] he appeared once."

msgctxt "d8cf8dee8a8a452ea1dbdbcace908c7c"
msgid ""
"འདི་␣ར་ བྱང་ཆུབ་ ཀྱི་ སེམས་ གཉིས་ ཀྱི་ རང་བཞིན་ གྱི་ གཟུགས་སྐུ་ སངས་རྒྱས་ "
"དེ་"
msgstr ""
"In this [system], the buddha of the rupakaya is the intrinsic nature of the "
"two types of bodhicitta."

msgctxt "a1e0292526514634a518e55d14fc5583"
msgid ""
"སྐུ་གསུང་ཐུགས་ མི་ཟད་པ་ རྒྱན་ གྱི་ འཁོར་ལོ་ མཐའ་ ཐམས་ཅད་ དང་ བྲལ་བ་ ཡིན་ ཏེ "
"།"
msgstr ""
"The wheel of the inexhaustible ornaments of body, speech, and mind is free "
"from all the extremes."

msgctxt "a6010f691f4e4806a35dbab1518401d0"
msgid "ལྗོན་ ཞུས་ ལ་␣ས །"
msgstr "According to the Sutra of Requisition by Jonpa:"

msgctxt "bda985dc5b594c1f98df4534b8d3b640"
msgid "རྒྱུ་ལ་ བརྟེན་པ་␣འི་ མཁས་པ་ བཅོམ་ལྡན་འདས ། ༑"
msgstr "The Blessed One is the expert who relies on the cause."

msgctxt "0e3f41a27b3f4de18a81ca916050dee4"
msgid "མཐའ་ གཉིས་ ལྟ་བ་ རྟག་ ཏུ་ མི་ མངའ་བ །"
msgstr "Never having the views of the two extremes."

msgctxt "ceec88f3060c4c34aa43034c86c29c18"
msgid "ལ་␣ས་ ཀྱི་ རྣམ་སྨིན་ འབྲས་བུ་ ཁོ་ན་ གསུངས ། །"
msgstr "For the complete ripening of karma, the result of thusness is said."

msgctxt "7d83a918814744adae74b956b329c0e7"
msgid "ལྟ་བ་␣འི་ མུན་ བྲལ་ ཁྱོད་ ལ་ ཕྱག་ འཚལ་ ལོ ། །"
msgstr "You are free from the darkness of the views, I pay homage to you,"

msgctxt "cbb5d0de9caa4a6f87e23cbad6843ad9"
msgid "ཞེས་ དང་ །"
msgstr "And."

msgctxt "ff736a999e604b7b8aec38f300df0e16"
msgid "མདོ་ རྒྱན་ ལ་␣ས །"
msgstr "According to the Ornament of the Sutra Section:"

msgctxt "6a8dc75835b14bf1bae5d89951d2ef7b"
msgid "འཛིན་པ་ མི་ མངའ་ ཉེ་␣ས་ མི་ མངའ ། །"
msgstr "[You] possess no grasping, possess no fault,"

msgctxt "94835fe296584a4a9187cb858dc318fd"
msgid "རྙོག་པ་ མི་ མངའ་ མི་ གནས་པ ། །"
msgstr "[You] possess no turbidity, without dwelling,"

msgctxt "d01ee46941fb4eff831d4009ed6c16fa"
msgid "མི་ གཡོ་ ཆོས་ རྣམས་ ཐམས་ཅད་ ལ །།"
msgstr "[You are] unmoving, in all phenomena "

msgctxt "f5951fcd31d44f328ac44ee4a275e793"
msgid "སྤྲོས་མེད་ ཁྱོད་ ལ་ ཕྱག་ འཚལ་ ལོ ། །"
msgstr "With elaboration, I pay homage to you."

msgctxt "12e695ee356641d6b7eca6a801c615ba"
msgid "ཞེས་པ་ བཞིན་ ཡིན་ ནོ །"
msgstr "It is as said. "

msgctxt "cd372c4e89df4c22a46f3a637382ea29"
msgid ""
"རྡོ་␣༽༽  ཆོས་སྐུ་ སྟོང་པ་ གཟུགས་སྐུ་␣འི་ ཡོན་ཏན་ ཕྲིན་ལས་ ཐམས་ཅད་ དང་ "
"འབྲེལ་བ་ མེད་ ཅིང་"
msgstr ""
"Vajra: It is said that the emptiness of dharmakaya is not connected to any "
"of the good qualities and enlightened activities of the rupakaya."

msgctxt "24743b669c724411a7550de91fb5205b"
msgid "གདུལ་བྱ་ འདི་ ལྟ་བུ་␣ས་ འདུལ་བ་␣ར་ བྱེད་ སྙམ་པ་␣འི་ ཐུགས་ མེད་ ཀྱང་ །"
msgstr "There is no thought that I will tame such and such disciple."

msgctxt "c705b3db2844418eaf5fb977ac659dbf"
msgid ""
"མི་ཟད་པ་ རྒྱན་ གྱི་ འཁོར་ལོ་␣ས་ གཞན་ སྣང་ ལ་ རྣམ་འཕྲུལ་ ཙམ་ དུ་ འབྱུང་ "
"ཟེར་བ་ དང་"
msgstr ""
"The wheel of the inexhaustible ornament says that a mere manifestation "
"occurs in others' appearances."

msgctxt "27c27488a79e43c9a65aab9ad1e00931"
msgid "ཡང་འཇུག་པ་ མི་འཆད་པ་␣ར་ བཟང་བ་ འབའ་ཞིག་ ཏུ་ འབྱུང་བ་␣ར་ འདོད་ ཀྱང༌ །"
msgstr ""
"Also, it is accepted that the engagement is uninterrupted and that only "
"excellence occurs."

msgctxt "16995fa96051409594e739596aaa52c0"
msgid ""
"འདི་␣ར་ ཐུགས་ ནི་ ཐ་ན་ རྟག་ཆད་ ཀྱི་ ལྟ་བ་ ཚུན་ཆད་ ལ་ ཡང་ འབྱུང་བ་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], thoughts occur even in the views of permanence and "
"nihilation."

msgctxt "4ec8c186ced842ff83e04b1246c084a5"
msgid "གདུལ་བྱ་␣འི་ རྣམ་རྟོག་ དང་"
msgstr "The discursive thoughts of disciples and"

msgctxt "07536f75016443de839cc8730a050939"
msgid "ཡིད་ ཀྱི་ འཇུག་པ་␣འི་ བྱེ་བྲག་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་ ཅི་ སྙེད་པ་"
msgstr ""
"For as many inconceivable particulars of mental engagement as there are,"

msgctxt "2372acfeb5b44f02b439e36829c4ea7d"
msgid "དེ་སྙེད་ དུ་ འདུལ་ བྱེད་ ཐུགས་ ཀྱི་ འཇུག་པ་ ཡང་ འབྱུང་བ་␣འི་ ཕྱིར །"
msgstr "So as the engagement of the disciplines' minds occurs."

msgctxt "f31ebddac1974d139a8a6c0c7ca35f75"
msgid "མྱ་ངན་ འདས་ མདོ་ ལ་␣ས ། །"
msgstr "According to the Nirvana Sutra:"

msgctxt "18a0734cb0344d4f8ea3f9ecd8f76915"
msgid "ལོང་བ་ མ་ ལགས་ ལོང་བ་ ལྟར ། །"
msgstr "Like a blind, but not blind."

msgctxt "388d39b2c9a34cee9afe089a8ddfbae8"
msgid "ཞ་བོ་ མ་ ལགས་ ཞ་པོ་ ལྟར ། །"
msgstr "Like a cripple, but not crippled."

msgctxt "72b6a948bcaa47ab9b40b1f985223ac0"
msgid "བྱིས་པ་ མ་ ལགས་ བྱིས་ ཚུལ་ གྱིས ། །"
msgstr " In a childish way, but not a child."

msgctxt "0d18eb9cc8f14031a9bb0cd6c01bbe4d"
msgid "སེམས་ཅན་ རྣམས་ ནི་ སྨིན་པ་␣ར་ མཛད །། །"
msgstr "[He] ripens the sentient beings."

msgctxt "0d601d57b95b4e5ca2755197d24a1ec9"
msgid "བརྒྱ་བྱིན་ ཚངས་པ་␣འི་ ཆ་བྱད་ ཀྱིས ། །"
msgstr "Although Kaushika, in the costume of Brahma,"

msgctxt "0514a22ffa0544d28227624239c70f51"
msgid "སེམས་ཅན་ རྣམས་ ཀྱི་ དོན་ མཛད་ ཀྱང༌ ། །"
msgstr "Performs for the sake of sentient beings,"

msgctxt "871456afdcef4732b2cad0c75fb6f692"
msgid "འཇིག་རྟེན་ རྣམས་ ཀྱིས་ རྟོགས་ མི་ ནུས །"
msgstr "The worldly people are unable to realize this."

msgctxt "4f1c5bbe369a46f0a57c77c063d7f181"
msgid "ཞེས་ དང་ །"
msgstr "And."

msgctxt "d4fd0e44498641228e54554e8921ee1e"
msgid "གསང་བ་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་ ལ་␣ས །"
msgstr "According to the Inconceivable Secret Sutra:"

msgctxt "ca89730ab1fc49db935f38356ba727a5"
msgid "སངས་རྒྱས་ ཀྱི་ ཐུགས་"
msgstr "The mind of the Buddha"

msgctxt "2f7171dec55b45b69de645252310f1ef"
msgid "སེམས་ ཀྱི་ དམིགས་པ་ དང་ ཡང་ བྲལ་ ལ །"
msgstr "Is free from the observation of the mind."

msgctxt "4262104574a64043a5f49b35e0ec642b"
msgid ""
"སེམས་ཅན་ ཐམས་ཅད་ ཀྱི་ སེམས་ ཀྱི་ དཔྱོད་པ་ དང་ བསམ་པ་ ཡང་ རབ་ཏུ་ ཤེས་ སོ ། །"
msgstr ""
"It also utterly knows the thoughts and analyses of the minds of all sentient"
" beings."

msgctxt "f139d33756c8404d817c5ef7124dd947"
msgid "ཞེས་ གསུངས་པ་␣ས །"
msgstr "As it is said."

msgctxt "0058feb3fc45426ab2b8d6ec88678b7e"
msgid ""
"འཇིག་རྟེན་ ཐ་མལ་པ་␣འི་ གཏམ་ དང་ ཆད་པ་ དང་ རྟག་པ་ ལས་རིམ་ གྱིས་ གོང་ དུ་ "
"ཁྲིད་ དེ །"
msgstr ""
"[He] gradually leads [sentient beings] beyond the talk of ordinary worldly "
"people, beyond nihilism and permanence."

msgctxt "f77e4c0ae57343718ad70d3d35474f91"
msgid "མཐ་␣ར་ ནང་པ་␣འི་ ལམ་ ལ་ དྲངས་ ཏེ་"
msgstr "Finally, [sentient beings] are drawn onto the Buddhist path."

msgctxt "727c39f1d7a74a109d37366733930a4e"
msgid ""
"རྣམ་མཁྱེན་ ལ་ འགོད་པ་␣ར་ མཛད་པ་␣འི་ ཐབས་མཁས་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་␣འི་ གནས་ "
"ཡིན་ ནོ །"
msgstr ""
"This is the inconceivable skillful means of setting [them] to omniscience."

msgctxt "709803845b3b4642b3002fa5dbd8ba53"
msgid ""
"རྡོེ་␣༽༽་␣གདུལ་བྱ་ འདུལ་བ་ ལ་ སྤྲུལ་པ་ མཆོག་ གི་ དོན་ བྱེད་པ་ ལ་␣ས་ གཞན་ "
"དམན་པ་ མཱི་ བྱོན་ ཟེར་བ་␣འི་ ཚུལ་ དེ་ ཁོ་ན་ མ་ ཡིན་ ཏེ །"
msgstr ""
"Vajra: To tame disciples, the supreme emanations act for the sake of others."
" Other than that, the statement that the inferior will not come is not only "
"the case."

msgctxt "686b68e478b14342935cfd383b5ebc00"
msgid ""
"འདི་␣ར་ ལྟར་ བེམ་པོ་ དང་ མུ་སྟེགས་ དང་ བདུད་ དང་ ཉོན་མོངས་ སོགས་ ཤེས་བྱ་␣ར་ "
"སྲིད་ ཚད་ ཀྱིས་ སངས་རྒྱས་ ཀྱི་ བྱ་བ་ བྱེད་པ་␣འི་ ཕྱིར །"
msgstr ""
"According to this [system], all the knowable objects, such as matter, "
"tirthikas, demons, afflictions, and so forth, perform the activities of "
"buddhas."

msgctxt "fb7be21ad9a14095852ccd43e4bccdd5"
msgid "དྲི་མ་ མེད་པ་␣ར་ གྲགས་པ་␣འི་ མདོ་ ལ་␣ས །"
msgstr "According to the Vimalakirti Sutra:"

msgctxt "1d7346d7b0be4be6a5e51919ed4ffb1b"
msgid ""
"ཀུན་དགའ་བོ་ གང་དག་ ན་ སངས་རྒྱས་ ཀྱི་ མཛད་པ་ བྱེད་པ་␣འི་ སངས་རྒྱས་ ཀྱི་ ཞིང་ "
"རྣམས་ ཀྱང་ ཡོད་ དོ ། །"
msgstr "Ananda, there are buddhafields where the Buddha performs his deeds."

msgctxt "02c054330cbc4af5bd8f6e90081f0c9a"
msgid "དེ་བཞིན་ དུ་ སྦྱར་ ཏེ་ འོད་ དང༌ །"
msgstr "Likewise, light and "

msgctxt "aa87c75d388e421ca20a7c69a0ff9a79"
msgid "བྱང་ཆུབ་ ཀྱི་ ཤིང་ དང་ཁ་ ཟས་ དང་ །"
msgstr "The tree of enlightenment, food, and,"

msgctxt "3e24122b391340b99cb3d54d41c2f16b"
msgid "ཆུ་ དང་ །  བསྐྱེད་ མོས་ ཚལ་ དང༌ །"
msgstr "The water, the pleasure grove, and"

msgctxt "06d93ca0dc8b469cab69027c9b86f5f3"
msgid "གཞལ་མེད་ ཁང་ དང་ ཁང་པ་ བརྩེགས་པ་ དང་"
msgstr "The immeasurable mansions, multistoried buildings and "

msgctxt "8317d70c5ae44f4bad4d5d7c0720701e"
msgid "སྤྲུལ་པ་ དང་ ནམ་མཁའ་ དང༌ །"
msgstr "The emanations, sky and"

msgctxt "fc76fb2b585e4afd8e6161bb0d629b23"
msgid "བར་སྣང་ དང །  རྨི་ལམ་ དང༌ །  གཟུགས་བརྙན་ དང་ །"
msgstr "The unobstracted space, dreams, reflections, and "

msgctxt "e86cb79668a54752afa5fc17fb170dfd"
msgid "ཆུ་ཟླ་ དང༌ །  བྲག་ཆ་ དང༌ །  སྒྱུ་མ་ དང༌ །"
msgstr "The water moon, echo, illusion, and"

msgctxt "d43625b2ff6f4c17aec7a7504edfbfc0"
msgid "སྨིག་རྒྱུ་ དང་ །  ཡི་གེ་␣ར་ སྟོན་པ་ དང༌ །  བརྗེད་པ་ མེད་པ་ དང་ །"
msgstr "Mirage, teaching in writing, unforgetfulness, and"

msgctxt "3069c19f1faa48ecb403bf2f81403454"
msgid "ལོངས་སྤྱོད་ དང་ །  བདུད་ བཞི་པོ་ དང༌ །"
msgstr "Possessions, the four demons and "

msgctxt "5f2e9762d02c451c877486cf5ef4f482"
msgid ""
"ཉོན་མོངས་པ་␣འི་ སྒོ་ སྟོང་ཕྲག་ བརྒྱད་ཅུ་ རྩ་ བཞི་ དག་ གིས་ སངས་རྒྱས་ ཀྱི་ "
"མཛད་པ་ བྱེད་ དོ ། །"
msgstr ""
"The eighty-four thousand doors of the afflictions perform the deeds of the "
"Buddha."

msgctxt "d8b30f20f1f04f3b9f7b7f5651317c72"
msgid "ཅེས་ དང༌ །"
msgstr "And."

msgctxt "ca9aa53b77504402afb650896d5bbcf7"
msgid "བྱང་སེམས་ ཐབས་ ཀྱི་ སྤྱོད་ཡུལ་ རྣམ་པ་␣ར་ འཁྲུལ་པ་ བསྟན་པ་ ལ་␣ས །"
msgstr ""
"According to The Display of Miracles in Skillful Methods that is the Sphere "
"of Activity of the Bodhisattvas:"

msgctxt "38c0e841b1ce4c0aac18c312f3aa31ef"
msgid "འཇམ་དཔལ་ སངས་རྒྱས་ ཀྱི་ ཞིང་ འདི་ ན་"
msgstr "Manjushri, in this buddha realm,"

msgctxt "a173f7c08ef640fb9748a4de18ebb062"
msgid "གཞན་ མུ་སྟེགས་ ཅན་ ཀུན་ ཏུ་ དཔྱོད་པ་བ་ གང་དག་ སྣང་བ་"
msgstr "The appearance of the other tirthikas who analyze,   "

msgctxt "bffbd0a6d754429a99c6379b48464981"
msgid ""
"འདི་ ཡང་ དེ་བཞིན་ གཤེགས་པ་␣འི་ བྱིན་རླབས་ དང་ ཐབས་མཁས་ བསམ་ གྱིས་ མི་ "
"ཁྱབ་པ་␣ར་ རིགས་པ་␣ར་ བྱ་␣འོ ། །"
msgstr ""
"This, too, should be seen as the inconceivable blessing and skillful method "
"of the tathagatas."

msgctxt "21c02e3852fc43ebac3348eb14d3ee56"
msgid "དེ་ ཅིའི་ཕྱིར་ ཞེ་ན །"
msgstr "If asked why it is so."

msgctxt "ba642607cf464bdca1af256af1e9493b"
msgid ""
"འདི་དག་ ནི་ རྣམ་པ་␣ར་ ཐར་པ་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་␣འི་ སྒོ་ ལ་ གནས་པ་ དང་"
msgstr ""
"They abide in the skillful methods of the inconceivable gateways to "
"emancipation and "

msgctxt "a2179a505d27487cacb606964c8d4e1a"
msgid "ཕ་རོལ་ ཏུ་ ཕྱིན་པ་ ལ་ ངེས་པར་ འབྱིན་པ་ ལ་"
msgstr "To be certain in leading to transcendental perfection,"

msgctxt "2ece7e06059940dabefd5c5a7b876048"
msgid "ཐབས་མཁས་པ་␣ས་ སྣེར་ བརྩེ་བ་ ཤ་སྟག་ གོ  །"
msgstr "Soley love on the top of the skillful method."

msgctxt "0f1b0c7f05e64d2eabb57be1e7459aaf"
msgid "དཀོན་མཆོག་ གསུམ་ ཡིད་ ལ་ བྱ་བ་ མ་ བཏང་བ་"
msgstr "[They] never give up the three jewels from [their] minds,"

msgctxt "dd6c5df46f664384b05b971ff7e74465"
msgid ""
"སེམ་ ཅན་ ཡོངས་སུ་ སྨིན་པ་␣ར་ བྱ་བ་ ལ་ དམ་པ་␣འི་ ཕ་རོལ་ ཏུ་ སོན་པ་ ཤ་སྟག་ གོ "
" །"
msgstr ""
"They have all reached the sublime perfection in ripening all sentient "
"beings."

msgctxt "61501c8634c244f9927b47974b16a97e"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "00aa0e2e52d94de187ae24b7e0e29c11"
msgid "དེ་བཞིན་ དུ་ བློ་གྲོས་ རྒྱ་མཚོ་␣ས་ ཞུས་པ་ དང༌ །"
msgstr "Similarly, the Sutra of Requisition by Sagaramati and"

msgctxt "6ccc431860cb4ddaa509b938718864fb"
msgid "ཆོས་ ཀུན་འགྲོ་བ་ སོགས་ མདོ་ མང་པོ་␣ར་"
msgstr "The Transmigration of All Phenomena and in many other sutras,"

msgctxt "7d3f0629fc1c45ab979ff02fbf5d01a7"
msgid "མཐའ་ཡས་པ་␣ར་ གསུངས་ ཤིང་"
msgstr "It is taught infinitely."

msgctxt "07652e2b09e94d1697b3f4a8a7991595"
msgid "འདོད་ཆགས་ དང༌ །  ཞེ་སྡང་ །  གཏི་མུག་ གིས་ བྱ་བ་ བྱས་པ་ རིམ་བཞིན །"
msgstr ""
"The functions of desire, aversion, and delusion are performed progressively."

msgctxt "8955f670f7294e208fdf93b66fa063b8"
msgid "དགེ་སློང་ བསྟན་པ་␣འི་ བློ་གྲོས་ དང་ ༑"
msgstr "The monk Tenpe Lotro and "

msgctxt "d585fedb10de4459af98b8f827072f89"
msgid "སོ་␣ར་ འཕྲེང་ སངས་རྒྱས་ བཅོམ་ལྡན་འདས་ མཐོང་ ན་ དགའ་བ་ ཅན་ དང་ །"
msgstr ""
"Angulimala, when seeing the Buddha, the Blessed One, was delighted, and"

msgctxt "ab2ceb8195ca4ad4b5138a13fdc357ab"
msgid "འོད་སྲུང་ རྫོགས་བྱེད་ ལྟ་བུ་ ཡིན་ ནོ །"
msgstr "It is like Purana Kasyapa."

msgctxt "b7fee49ac7ca46bbbe6f54154db90aa8"
msgid "དེ་ལྟར་ ཡང་ཡང་ དག་སྦྱོར་བ་␣འི་ རྒྱུད་ ལ་␣ས །"
msgstr "Likewise, according to the Tantra of Emergence from Samputa:"

msgctxt "8d16d537dd044a4e90fb2c54ce642e8f"
msgid ""
"རྡུལ་ དང༌ །  མུན་པ །  སྙིང་སྟོབས་ ཀྱང་ སེམས་ཅན་ གྱི་ དོན་ བྱེད་ དོ་ ཞེས་ སོ "
"། །"
msgstr ""
"Dust, darkness, and determination also work for the sake of sentient beings."

msgctxt "9512543b36db42bd93b1b2ced947ab2e"
msgid "དེ་ལྟར་ ཐམས་ཅད་ ཀྱིས་ བྱ་བ་ བྱེད་ ཀྱང་"
msgstr "In this way, even though all of these perform their work,"

msgctxt "e1d03bde366340b6a65badeee1c53362"
msgid "དུས་ ལ་མ་ བབས་པ་␣ར་ མི་ འགྱུར་ ཏེ །"
msgstr "It will not become till the time arrives."

msgctxt "077c52c8003c4020916d4bd9739b76e8"
msgid "ཆོས་ ཀུན་འགྲོ་ བར །"
msgstr "In the Transmigration of All Phenomena:"

msgctxt "d37ce74ec1444cc899bd5c50e0a303e0"
msgid "དཔེར་ན་ མེ་ ནི་ ཤིང་ ཐམས་ཅད་ ལ་ གནས་ མོད་ ཀྱི །"
msgstr "For example, fire is indeed present in all kinds of wood."

msgctxt "334664be3b264fff83bb6b9d0e85519e"
msgid "རྐྱེན་ དང་ རྩོལ་བ་ མ་ཚང་ ན་ མི་ འབར་ ཞིང་ དགོས་པ་ རྣམས་ མི་ བྱེད་ དོ །"
msgstr ""
"If the conditions and effort are not complete, it will not blaze and will "
"not perform its functions."

msgctxt "fe6b9d6080634427bad4c903d528f5d7"
msgid "དེ་བཞིན་ དུ་ སངས་རྒྱས་ རྣམས་ ཤེས་བྱ་ ཐམས་ཅད་ ལ་ གནས་ མོད་ ཀྱང་ །"
msgstr "Similarly, although buddhas are present in all knowables,"

msgctxt "1b6b8a025ba94b3d9a293c2827505b6a"
msgid "དད་པ་ སོགས་ རྐྱེན་ མ་ཚང་ ན་ མི་ འབྱུང་ ཞིང་ བྱ་བ་ མི་ མཛད་ དོ ། །"
msgstr ""
"If the conditions of faith and so forth are not complete, they will not "
"arise or perform their functions."

msgctxt "ae59bb47b23149b182d46b52a8aa65b9"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "01e4b143d19c4ec3952eb0c8866820ee"
msgid ""
"རྡོ་␣༽༽  སངས་རྒྱས་ རྣམས་ ནི་ ཞིང་ དག་པ་ དང་ མ་ དག་པ་ དབྱིབས་ ཀྱང་ "
"སྣ་ཚོགས་པ་␣འི་ ཞིང་ ཐ་དད་པ་ དེ་␣ར་ སངས་ རྒྱ་བ་ ཡིན་ ཟེར་ ཡང༌ །"
msgstr ""
"Vajra: It is said that buddhas attain enlightenment in different kinds of "
"pure and impure realms, that are also distinct in shape."

msgctxt "572ac40262d14b21814b9f1347cfe0fb"
msgid ""
"འདི་␣ར་ ནི་ ཆོས་དབྱིངས་ མ་ལུས་པ་ ཀུན་ ཏུ་ འཚང་ རྒྱ་ དགོས་པ་␣ར་ བཞེད་ དེ་"
msgstr ""
"In this [system], it is accepted that one must become awakened in all "
"expanse of dharmas."

msgctxt "76fb2de66de5489f962a38117ed33eb8"
msgid ""
"བདེ་བ་␣ར་ གཤེགས་པ་ ཆོས་ ཐམས་ཅད་ མངོན་པར་ རྫོགས་པ་␣ར་ བྱང་ཆུབ་པ་ ཡིན་པ་␣འི་ "
"ཕྱིར་ རོ ། །"
msgstr ""
"Because the Sugata has manifestly and completely awakened to all dharmas."

msgctxt "dc9dffd53afd450fad85f5176c8ed850"
msgid "དེ་ལྟར་ ཡང་ རྒྱ་ ཆེ་␣ར་ རོལ་པ་ ལ་␣ས །"
msgstr "According to The Play in Full [sutra]:"

msgctxt "5210db319421465eaaa75288bf496ba6"
msgid "ཚངས་པ་ ངས་ ཡོངས་སུ་ ཆད་པ་␣འི་ རྣམ་པ་␣ས་"
msgstr "Brahma, I, by a limited aspect,"

msgctxt "de3bc1db182347bfbe71e7b103038989"
msgid "ཚད་ དང་ ལྡན་པ་␣ར་ སངས་རྒྱས་པ་ མ་ ཡིན་ གྱི །"
msgstr "Have not become awakened."

msgctxt "d2223bd647e64eacb51ffa23963eedf3"
msgid "ཚངས་པ་ ང་ ནི་ ཚད་ མེད་ ཅིང་ རིས་ སུ་ མ་ ཆད་པ་␣འི་ རྣམ་པ་␣ས་"
msgstr "Brahma, I, with immeasurable and without limited aspect,"

msgctxt "7a044c0b67d140778cdec1fae5ec97bc"
msgid "ཆོས་ ཐམས་ཅད་ མཉམ་པ་ཉིད་ དུ་ མངོན་པར་ རྫོགས་པ་␣ར་ བྱ་␣འོ ། །"
msgstr "Become awakened in the sameness of all phenomena."

msgctxt "b4393fa52cbb4818a6207f9ed4c88c4b"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "f171a3c1294a440f8d2e1564fa482a99"
msgid "ཡུམ་ ལ་␣ས་ ཆོས་ ཐམས་ཅད་ མངོན་པར་ རྫོགས་པ་␣ར་ སངས་རྒྱས་ སོ ། །"
msgstr ""
"According to the Mother [Prajnaparamita Sutra], all phenomena will become "
"perfectly and completely awakened."

msgctxt "03b933650e6241c7b77131d41d6fd49b"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "013bdf7f59ee4479927d5fd0ac860625"
msgid "ཡུམ་ ལ་␣ས་ ཆོས་ ཐམས་ཅད་ མངོན་པར་ རྫོགས་པ་␣ར་ སངས་ རྒྱ་བ་␣ར་ འདོད་པ་"
msgstr ""
"In the Mother [Prajnaparamita Sutra], it is accepted that all phenomena will"
" become perfectly and completely awakened."

msgctxt "63fe504dc2394cc4a1ea151efcd698e8"
msgid "ཤེར་ཕྱིན་ ལ་ བསླབ་པ་␣ར་ བྱ་␣འོ ། །"
msgstr "[You] should train in the Perfection of Wisdom."

msgctxt "70b236099e3e49589e085c8c88e913d8"
msgid "ཞེས་ དང་ ཕལ་ཆེན་ ལ་␣ས །"
msgstr "And according to the Avatamsaka [Sutra]:"

msgctxt "4ec59816cb3143d5ae5eb2665d2e9ac3"
msgid "སྟོང་གསུམ་ འདི་ཉིད་ དུ་"
msgstr "In this very third order chiliocosm,"

msgctxt "d3c6704a171d4893b53fc758fcb2edaf"
msgid "གླིང་བཞི་ བྱེ་བ་ ཕྲག་ བརྒྱ་␣ར་ སངས་རྒྱས་པ་␣ར་ གསུངས་ ཤིང་ །"
msgstr ""
"It is said that one billion will become awakened in the four continents."

msgctxt "4b91da5cf25d4eb59bada3e65b4b510a"
msgid "གཞན་ ཡང་ དཔའ་བ་␣ར་ འགྲོ་བ་ དཀོན་མཆོག་ འབྱུང་གནས །"
msgstr "Furthermore, the heroic one is Ratnakara,"

msgctxt "f9568460f08d498689c8507c545bfd28"
msgid "སོ་␣ར་ འཕྲེང་ ལ་ ཕན་པ་ སོགས་ མཐའ་ཡས་པ་␣ར་ གསུངས་ སོ ། །"
msgstr ""

msgctxt "77857015d5844ffaaceff59df0681992"
msgid "དེ་ ན་མ་ གྲུབ་ ན་ ཚོགས་ མཐའ་ཡས་པ་␣འི་ འབྲས་བུ་␣ས་"
msgstr "If it is not accomplished, by the result of limitless accumulations"

msgctxt "1c9869136d6843dcb4387ecf33d85421"
msgid "འཁོར་ལོ་␣ས་ བསྒྱུར་བ་ ལ་␣ས་ ཆུང་བ་␣ར་ འགྱུར་ ཏེ་"
msgstr "It will become less than a monarch."

msgctxt "0efc9394da2b4b2b82cf75479c8c65e2"
msgid "ཕལ་ཆེན་ ལ་␣ས་ འཇིག་རྟེན་ ཁམས་ རྒྱ་མཚོ་ བཅུ་␣འི་ གྲངས་ ཀྱི་"
msgstr ""
"Buddha Avatamsaka Sutra Section says in the world systems equal to the "
"number of atoms in ten oceans, "

msgctxt "5b0932b601604b8fad862e33d828e845"
msgid ""
"རྡུལ་ དང་ མཉམ་པ་ ལ་ དབང་ བྱེད་པ་␣འི་ འཁོར་ བསྒྱུར་ ཡོད་པ་␣ར་ གསུངས་པ་␣འི་ "
"ཕྱིར་ རོ ། །"
msgstr "The universal monarchs will rule."

msgctxt "df35161cae454ff3a8ddaef3eabfabb8"
msgid "དེ་བས་ན་ སེམས་བསྐྱེད་པ་␣འི་ གནད་"
msgstr "Therefore, this is the essence of generating bodhicitta."

msgctxt "927d16a1e9e942e8b929e2ba31ccd881"
msgid "ཕྱིས་ ཐམས་ཅད་ དུ་ སངས་རྒྱས་པ་ ཡིན་ ནོ །"
msgstr "Later, he became awakened in all of them."

msgctxt "b7dd006e07ec4327987d612688999786"
msgid "རྡོ་␣༽༽་␣སྤྲུལ་སྐུ་ སྐྱེས་སྟོབས་ ལ་␣ས་ བྱུང་བ་ མཆོག་ དང༌ །"
msgstr "Vajra: The nirmanakaya is supremely arising from the power of birth."

msgctxt "fedac915103d4793a4311e40e187f74e"
msgid "མཆན་ མཛད་པ་␣༡༢ །"
msgstr "Annotation: the twelve deeds,"

msgctxt "7c95b3bb20f74bfab6f8469a69c61c06"
msgid ""
"དམན་པ་ ཉན་རང་ དང༌ །  བཟོ་ དང༌ །  སྒྱེ་བ་ རི་བོང་ སོགས་ སྟེ་ བཞི་ བསྒོམས་པ་ "
"ལ་␣ས་ བྱུང་བ་"
msgstr ""
"The lesser ones are shravakas and pratyekabuddhas, artisans, sacks, rabbits,"
" etc. It occurs by meditating on the four."

msgctxt "bf55a725426d4fdfbe810f0422501904"
msgid ""
"བསྟན་པ་␣འི་ བློ་གྲོས་ བརྟུལ་བ་␣འི་ སྨད་ ཚོང་ མ་ ལྟ་བུ་ དེ་དག་ རྒྱུ་ མེད་ "
"ཀྱང་"
msgstr ""
"It is like the tamed prostitutes of Tenpe Lotro, even though they have no "
"cause,"

msgctxt "8e8d78c636d64d78b5fc2164dae52472"
msgid "རྣམ་འཕྲུལ་ ཙམ་ དུ་ འབྱུང་ ཞིང་"
msgstr "They merely arise as a manifestation."

msgctxt "028a17a8f9614678b48ba748f83f24e2"
msgid "དགེ་ མི་དགེ་␣འི་ འབྲས་བུ་ མི་ དགོས་ ཟེར་བ་ དག་ ཆོས་ཅན །"
msgstr ""
"Take the subject, those who say that virtuous and non-virtuous effects are "
"not required."

msgctxt "be4905e7fcb94cc19dfcfd451abcea23"
msgid "རྒྱུ་ མེད་པ་␣འི་ སྤྲུལ་པ་ མི་ སྲིད་པ་␣ར་ ཐལ །"
msgstr "It follows that a causeless emanation is not possible."

msgctxt "37232549df65420b9a9c12afa72f6039"
msgid "གང་ ལ་མ་ ལྟོས་པ་␣འི་ ཆོས་ མི་ འགྲུབ་པ་␣འི་ ཕྱིར །"
msgstr ""
"Because a phenomenon that does not depend on anything is not established."

msgctxt "c93cf46fe30a4f22afe75463c34e6dca"
msgid "རི་བོང་ གི་ རང་བཞིན་ ནོ ། །"
msgstr "It is of the nature of a rabbit."

msgctxt "8fc86522844b4014a09ec7b1f2129d95"
msgid "མ་ གྲུབ་ ན་"
msgstr "If it is not established,"

msgctxt "a370a1907c1e457bab4dab9e99a901ce"
msgid "ཕུར་བུ་པ་␣འི་ འདོད་པ་ ཁ་␣ས་ ལོངས་ ཤིག  །"
msgstr "Accept the assertion of Brhaspati."

msgctxt "60fc14f22a23427ca4be3419810b5eca"
msgid "དེ་ལྟར་ ཡང༌ །"
msgstr "Likewise,"

msgctxt "cb21093478774847a72abfcc49bb3345"
msgid "རྒྱུ་ལ་ བརྟེན་་ པ་␣འི་ མཁས་པ་ བཅོམ་ལྡན་འདས ། །"
msgstr "The Blessed One, you are an expert in relying on causes."

msgctxt "c6d81ca08a704e1dbebf0fbcde1b0898"
msgid "མཇའ་ གཉིས་ ལྟ་བ་ རྟག་ ཏུ་ མི་ མངའ་ ཞིང༌ ། །"
msgstr "Never having the views of the two extremes."

msgctxt "f4a1e0f7b6394f95be38074afdfb2535"
msgid "ལ་␣ས་ ཀྱི་ རྣམ་སྨིན་ འབྲས་བུ་ དེ་དག་ གསུངས ། །"
msgstr "The complete ripening of karma, the result of thusness is taught."

msgctxt "9165524f0b4049e89eff47e82d30bc38"
msgid "མ་སྐྱེས་དགྲ་␣འི་ འགྱོད་ བསལ་ ལ་␣ས །"
msgstr "According to The Elimination of Ajatashatru’s Regret:"

msgctxt "c5fd87d6a2714eea81f4a627be53965c"
msgid "ཆོས་ ཐམས་ཅད་ རྒྱུ་␣འི་ རྗེས་སུ་ འགྲོ་བ །"
msgstr "All phenomena follow their causes."

msgctxt "14465e20d5ec482cb3e72d2dab70beec"
msgid "ཞེས་ དང་ འདུལ་བ་␣འི་ དུས་ ལ་ བབ་པ་ ན །"
msgstr "And when the time comes to subdue,"

msgctxt "e1cb55eebb124095942b51b6b0b3cda9"
msgid "ཏིང་ངེ་འཛིན་ འདི་ ཞེས་ བྱ་བ་ ལ་ སྙོམས་པར་ ཞུགས་ སོ །"
msgstr "Remain in an equanimity called meditative concentration."

msgctxt "28b3767f5ff94446857eed8e393548d9"
msgid "ཞེས་པ་ དེ་"
msgstr "This is so-called "

msgctxt "668a2c9c88334673a2fd974b6012f554"
msgid "རྒྱུ་ བསྒྲུབ་པ་ ཡིན་ ཅིང་ སྤྱིར་ ཆོས་ ཐམས་ཅད་ སྤྲུལ་པ་ ཡིན་པ །"
msgstr ""
"It is the accomplishment of the cause. In general, all phenomena are "
"emanations."

msgctxt "85f1665fe7d44d1b8aa196ff8ebf55dd"
msgid "ཡུམ་ ལ་␣ས །"
msgstr "According to the Mother [Sutra]:"

msgctxt "a007078dbda24a348f35ff8f457dbd7e"
msgid "རབ་འབྱོར་ ཁ་ཅིག་ ནི་ ཉོན་མོངས་པ་␣འི་ སྤྲུལ་པ་␣འོ ། །"
msgstr "Subhuti, some are the emanations of the afflictions."

msgctxt "1cb98c49e5e8461fbcc6c2aabc695657"
msgid ""
"དེ་བཞིན་ དུ་ ལ་␣ས་ དང་ །  ཉན་ཐོས་ དང་ །  རང་རྒྱལ་ དང་ །  སངས་རྒྱས་ ཀྱི་ "
"སྤྲུལ་པ་␣འོ ། །"
msgstr ""
"Likewise, [they] are the emanation of karma, the shravakas, pratyekabuddhas,"
" and buddhas."

msgctxt "b2b3f13b36d749ef81857fc9683720e9"
msgid "གསུངས་པ་␣ས །"
msgstr "As it is said."

msgctxt "6f258424a05742a79c8d8de307fd2f71"
msgid "ཁྱེད་ ལྟར་ ན་ ཐམས་ཅད་ རྒྱུ་ མེད་ དུ་ཐལ་ བར་ འགྱུར་ རོ ། །"
msgstr "According to you, it absurdly follows that everything is causeless."

msgctxt "24c87e72251e4a5bb9f09006812eaec9"
