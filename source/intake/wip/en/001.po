msgstr "The nature of the mind, the aggregates and"

msgctxt "b26c76cf54704cad82fa90b1e02605a8"
msgid "དེ་ རྒྱུ་␣འི་ ལོག་ ཕྱིར་ བདེ་བ་ ཉིད ། །"
msgstr "It is all bliss because of the reversal of their cause."

msgctxt "e488e49f0ffa41f9949eef6ef2bcf559"
msgid "ཅེས་པ་␣ས་ མཚན་ཉིད་ བཞི་ ལྡན་ གྱི་ ཆོས་སྐུ་ དེ་ཉིད་"
msgstr "Thus, the dharmakaya endowed with the four characteristics is "

msgctxt "65f07dd8c468466184858bc28167f3b7"
msgid "མཚན་ དང་ དཔེ་བྱད་ ཀྱིས་ བརྒྱན་པ་ ལོངས་སྐུ །"
msgstr "Sambhogakaya adorned with the major and minor marks."

msgctxt "fb107224c2944e248b819e3909db34cf"
msgid ""
"དེ་ གཉིས་ དབྱེ་␣ར་ མེད་པ་␣ར་ སེམས་ཅན་ གྱི་ དོན་ མཛད་པ་ སྤྲུལ་སྐུ་ ཡིན་པ་␣འི་"
" ཕྱིར་ རོ ། །"
msgstr ""
"The inseparable of these two is the nirmanakaya which performs the benefit "
"of sentient beings."

msgctxt "3f03d6b4c1fd45b6911bbfefe6bb4009"
msgid "དེ་ལྟར་ ཟླ་ སྒྲོན་ ལ་␣ས །"
msgstr "According to the Moon Lamp [sutra]:"

msgctxt "85b6222791c1459f818ff8ed826983c8"
msgid "སྐུ་ ནི་ ནམ་མཁ་␣འི་ མཚན་ཉིད་ དེ ། །"
msgstr "The kaya has the characteristic of space,"

msgctxt "a2754fdb07c84402a6f3f281271c9152"
msgid "སངས་རྒྱས་ ཞིང་ ཡང་ དེ་ འདྲ་ སྟེ ། །"
msgstr "Also, the buddha-field is likewise; "

msgctxt "5f0950030d264f8691ddf87238b832fc"
msgid "སྟོབས་ དང་ རྣམ་ཐར་ བསམ་གཏན་ དང་ ། །"
msgstr ""
"The strengths, the complete liberation, and the་meditative absorptions,"

msgctxt "4fc44dd1c17e4f65a7e442622425662f"
msgid "དེ་དག་ ཐམས་ཅད་ མཚན་ཉིད་ གཅིག  །"
msgstr "All of these have the same characteristic."

msgctxt "cef54bf7ca064a3ba09b31ea8170d6ed"
msgid "ཅེས་ སོ །"
msgstr "As said."

msgctxt "755d77a22d7f47dab7074d872decceeb"
msgid "དེས་ན་ ལྡོག་པ་ ཙམ་ ལ་␣ས་ ཐ་དད་ མེད་ དོ །"
msgstr "Therefore, they are not distinct but a mere reverse."

msgctxt "56197c2ff7fe4e32aa381c5bcd2e6ef5"
msgid "རྡོ དུས་ གསུམ་ གྱི་ སངས་རྒྱས་ རྣམས་"
msgstr "Vajra: The buddhas of the three times,"

msgctxt "f3cae9adb5af4b5ebaca9538e76c7e17"
msgid "མཛད་པ་ མཛད་ ནས་ བུད་ཤིང་ ཟད་པ་␣འི་ མེ་ བཞིན་"
msgstr ""
"Having performed their deeds, like a fire whose firewood is exhausted,"

msgctxt "465f974c5241491dbe5e742dd4026329"
msgid "མྱ་ངན་ ལ་␣ས་ འདས་ ཏེ་"
msgstr "After passing into nirvana."

msgctxt "b0ad475f9368402696dba6e9fc08c0a1"
msgid "འོག་མིན་ ཆོས་དབྱིངས་ ཀྱི་ ཕོ་བྲང་ ན་ བཞུགས་པ་ ཡིན །"
msgstr "[They] dwell in the Akanishtha palace of Dharmadhatu."

msgctxt "c4baed9076294d8aae5ea08be7ec2313"
msgid "ཟེར་ ཡང༌ །"
msgstr "Although it is said."

msgctxt "5e15330be1404cf1acb8c59ef37032fd"
msgid ""
"འདི་␣ར་ ནི །  དུས་གསུམ་ གྱི་ སངས་རྒྱས་ ཐམས་ཅད་ སེམས་ཅན་ རྣམས་ ཀྱི་ ཁམས་ "
"རྒྱུད་ ལ་ བཞུགས་པ་ ཡིན་ ཏེ །"
msgstr ""
"In this [system], all the buddhas of the three times reside in the "
"continuums of the constituents of sentient beings."

msgctxt "245879c4e35145a2bc75485fcad46420"
msgid "དང་པོ་ ཐུགས་བསྐྱེད་པ་ ནས་ དམ་པ་␣འི་ ཆོས་ གནས་ ཀྱི་ བར་"
msgstr ""
"From the first generation of the mind [for enlightenment] until the abiding "
"of the holy Dharma,"

msgctxt "852fd10cce2e42edb4e141b7c531fcf0"
msgid "མཐའ་ཡས་པ་␣འི་ སེམས་ཅན་ གྱི་ དོན་ བསྒྲུབས་ ནས་"
msgstr "After having accomplished for sake of limitless sentient beings,"

msgctxt "f7d4e852cc694e0f9aedbc5b203555a1"
msgid "ད་ ཐུགས་ལས་ ཆུང་ངུ་␣ར་ བཞུགས་པ་ མི་ སྲིད་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"It is impossible for [him] to remain in a state of very small mind now."

msgctxt "58bf31470cf74621a370ad9e4fe59880"
msgid "དེ་ལྟར་ ཡང་ གཏན་ ལ་ ཕབ་པ་ དང༌ །  ཟླ་བ་ སྒྲོན་མེ་ ལ་␣ས །"
msgstr ""
"Therefore, it is also determined and according to the Moon Lamp [sutra]:"

msgctxt "c91ea05360a540db8d260638f1d9f04b"
msgid "མྱ་ངན་ ལ་␣ས་ འདས་པ་ ལ་ མི་ གནས་པ་"
msgstr "[They] do not dwell in nirvana,"

msgctxt "4298b0438f5d4a5eaea1a51063879e8f"
msgid "ཡང་དག་པ་␣འི་ མཉམ་པ་ཉིད་ ལ་ གནས་པ །"
msgstr "But dwell in the genuine state of equality."

msgctxt "b4fd0b9382bf4c26a4ce10c7325012f6"
msgid "སེམས་ཅན་ ཐམས་ཅད་ ལ་ གཟིགས་པ་␣འི་ ས་ ལ་ བཞུགས་པ་ སྟེ །"
msgstr "[They] dwell on the level of seeing all sentient beings."

msgctxt "4b52ce316c044ffb9fd431d4ecc941e1"
msgid "ཞེས་པ་␣ས །"
msgstr "Thus,"

msgctxt "03db7934788343438d5736196bf6df30"
msgid "དུས་གསུམ་ གྱི་ དེ་བཞིན་ གཤེགས་པ་ ཐམས་ཅད་ མ་ཚང་བ་ མེད་པ་"
msgstr "All the tathagatas of the three times, without incomplete,"

msgctxt "f2c86ad21ca54f3c85b5806162f18270"
msgid "སེམས་ཅན་ རེ་རེ་␣འི་ ཁམས་ རྒྱུད་ ལ་ བཞུགས་པ་ ནི་"
msgstr "Being present in the continuum of each sentient being’s constituent."

msgctxt "f707d533b6e744e0b671f75e9c5955b4"
msgid "སེམས་ཅན་ དོན་ ལ་␣ས་ མཛད་པ་ གཞན་ མེད་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"This is because there is no activity other than benefiting sentient beings."

msgctxt "9cbab26337a044da9c79baae4d00d069"
msgid "ཚུལ་ ཇི་ལྟར་ བཞུགས་ ན །"
msgstr "How it dwells is:"

msgctxt "60f9f728876647a396c4a8858741c023"
msgid "རྫོགས་ སངས་ སྐུ་ ནི་ འཕྲོ་ ཕྱིར་ དང་ །"
msgstr "Since the complete buddhakaya radiates,"

msgctxt "0d467be9357046e79b629c2d85bf1174"
msgid "དེ་བཞིན་ཉིད་ དབྱེ་␣ར་ མེད་ ཕྱིར་ དང༌ ། །"
msgstr "Since thusness is inseparable,"

msgctxt "a5cf2162cc5443eca166d1dbd7f8263d"
msgid "རིགས་ ཡོད་ ཕྱིར་ ན་ ལུས་ཅན་ ཀུན །"
msgstr "Because of having the lineage [of the Buddha], all embodied [beings],"

msgctxt "447a614a6be24550a2a205235e7fabd4"
msgid "རྟག་ ཏུ་ སངས་རྒྱས་ སྙིང་པོ་ ཅན །"
msgstr "Always possess the essence of Buddha."

msgctxt "c3a6ed2dd8584730afa587f291a5955b"
msgid "སངས་རྒྱས་ ཡེ་ཤེས་ སེམས་ཅན་ ཚོགས་ ཞུགས་ ཕྱིར ། །"
msgstr ""
"Since buddha primordial wisdom enters into the assemblies of sentient "
"beings,"

msgctxt "b9216db435be4adcb6376c52921bd3f2"
msgid "རང་བཞིན་ དྲི་མེད་ དེ་ ནི་ གཉིས་ མེད་ དེ །"
msgstr "Since its stainless intrinsic nature is non-dual,"

msgctxt "f45f0e5779254b27a584de9aafa4d991"
msgid "སངས་རྒྱས་ རིགས་ ལ་ དེ་ འབྲས་ ཉེར་ བརྟགས་ ཕྱིར ། །"
msgstr "Because the buddha family is named after its result,"

msgctxt "376dc21113864192862a0e8d79157866"
msgid "འགྲོ་ ཀུན་ སངས་རྒྱས་ སྙིང་པོ་ ཅན་ དུ་ གསུངས །"
msgstr "All beings are said to possess the buddha essence."

msgctxt "0b7882e0cb3048b7a7c131653a5fdd32"
msgid ""
"ཞེས་པ་ འདི་ ཆོས་ ཀྱི་ རྗེ་ སངས་རྒྱས་ ཐམས་ཅད་ སེམས་ཅན་ གྱི་ རྒྱུད་ ལ་ "
"བཞུགས་པ་ ལ་ བཞེད་ ཅིང་"
msgstr ""
"Thus, the Dharma Lord accepts that all the buddhas are present in the "
"continuum of sentient beings."

msgctxt "e2ee7baf787640a7b32283a9ecd8d0a6"
msgid "རྟོག་གེ་བ་ རྣམས་ དང་ ནི་ མི་མཐུན་པ་ ཡིན་ ནོ ། །"
msgstr "However, this is not concordant with sophists."

msgctxt "da3d6781d4ac4a3086dbb1a576abb477"
msgid "དེ་ཕྱིར་ སྒོ་གསུམ་ སྤྱོད་པ་ ངན་པ་ སྤང་བ་␣ར་ བྱ་ སྟེ །"
msgstr "Therefore, one should abandon the three doors of bad conduct."

msgctxt "f4f84c1060f141bca02f95854f156808"
msgid "མ་ སྤངས་ ན་ ཐུགས་ ཁྲེལ་བ་␣ར་ འགྱུར་བ་ དང་ །"
msgstr "If one does not abandon them, one's mind will become ashamed and"

msgctxt "321d9e2a32544077b28cb085bf9921a2"
msgid ""
"སྤང་ ན་ དགྱེས་ ནས་ འཕྲིན་ལས་ ཀྱི་ འཇུག་ སྒོ་ ཡོད་པ་␣ར་ འགྱུར་བ་␣འི་ ཕྱིར་ རོ"
" ། །"
msgstr ""
"If one abandons, one will be glad and have the entrance-way to enlightened "
"activities."

msgctxt "f1e82e42c7b6430288ee10787f49a4b0"
msgid ""
"འབྲས་བུ་ སངས་རྒྱས་པ་␣འི་ གནད་དོན་ རྣམས་ བསྡུས་ སྟེ་ རྡོ་རྗེ་ ཚིག་རྐང་ "
"བཅུ་དྲུག་ ལྷན་ཐབས་ ཚིག་རྐང་ གཅིག་ བཅས་ ཀྱི་ སྐབས་ ཏེ་ དེ་ལྟར་ ན་ ཚོམ་ བདུན་ "
"ཡོངས་སུ་ རྫོགས་པ་␣འི་ འགྲེལ་བཤད་ ལེགས་པ་␣ར་ བྱེད་པ་␣འོ ། །"
msgstr ""
"This concludes the seventh section, a commentary on the sixteen vajra verses"
" and the one verse of the addendum, summarizing the essential points of the "
"resultant state of buddhahood. Thus, the explanation of all seven sections "
"is completed."

msgctxt "a26c4942ba4044af8e86ce53b35d8296"
msgid "གཞུང་ གི་ མཇུག་ བསྡུ་བ་ ནི །"
msgstr "The conclusion of the text."

msgctxt "fc17b660e89f474eb6369969e774db50"
msgid "ཇི་ལྟར་ འཇིག་རྟེན་ གྱི་ ཁམས་ འདི་ ན་"
msgstr "Like how in this realm of the world,"

msgctxt "ce8077bc4e9c49d79e003ccb30f73f4d"
msgid "ཕ་ ཡི་ བུ་ ཞིག་ ལ་ ལོངས་སྤྱོད་ ཕལ་པ་␣འི་ འབྱོར་བ་"
msgstr "A father’s son, with the riches of ordinary possessions,"

msgctxt "32fc917a8df2409dbb7abf0c03cffbdb"
msgid "གཞན་ ལ་ གྲགས་པ་␣འི་ རྫས་ མང་པོ་ དང་ །"
msgstr "Substantial entities that are renowned to others, and"

msgctxt "7658e580f96a4f0a94b31bcf71f1179d"
msgid "ཟབ་ དགུ་ ཚོགས་ སུ་ བཤད་ ན་ ཡང་ །"
msgstr "Even if the nine profound collections are explained,"

msgctxt "daea96628cec486a9129df48cf746e6f"
msgid "ཉམས་ སུ་ མ་ མྱོང་ སྨྲས་པ་ མེད་ ཅེས་པ་ ལྟར་"
msgstr "As it is said, “Nothing is stated without experiencing.”"

msgctxt "3f56093dcd024418bf9da9bfe1f93950"
msgid "ཚད་མ་ བཞི་␣འི་ སྒོ་ ནས་ ངེས་ཤེས་ ཁྱད་པར་ཅན་ ལྡན་པ་␣ར་ གྱུར་ ཀྱང་"
msgstr ""
"Even having a special conviction through the door of the four valid "
"cognitions,"

msgctxt "63094e6d4c83408ea010219c3e38d238"
msgid "སུ་␣ས་ དེ་ ཆུད་ གསོན་པ་␣ར་ བྱེད་ ན་"
msgstr "Whoever wastes it,"

msgctxt "316cf51713994b35919f1be9135ac32f"
msgid "གཞན་ གྱིས་ སྨད་པ་␣འི་ གནས་ སུ་ ཡིན་པ་␣ར་ གྱུར་ ན །"
msgstr "Will become a place of criticism by others."

msgctxt "94584894172e4d959b5722709f589aa1"
msgid ""
"དེ་བ་␣ས་ ཀྱང་ གཅེས་པ་ ཕ་ ཡི་ ཁྱད་ནོར་ གཞན་ ལ་ མེད་པ་␣འི་ ནོར་བུ་␣འི་ རིགས་ "
"དག་"
msgstr ""
"Moreover, the special riches cherished by a father and other types of jewels"
" that other people do not have,"

msgctxt "ecd5982801fe44e684ecfdf10c1d2fff"
msgid "སྔོན་ སུ་␣ས་ ཀྱང་ མ་ ཐོས་པ་"
msgstr "That which is not heard by anyone before."

msgctxt "f0dd420a4c794d57963c79d57ea4a817"
msgid "དེ་ རང་ཉིད་ ཀྱིས་ མི་ འཛིན་པ་␣ར་ འདོད་ ན་"
msgstr "If one does not wish to hold it,"

msgctxt "65405e15e54b4e81b3e0afee318ea507"
msgid "དེ་ ནི་ སྨད་པ་␣ར་ བྱེད་པ་ ལྟ་ཅི་ སྨྲོས །"
msgstr "Thus, criticism does not need to be expressed."

msgctxt "a5be25df984a4b2bbecc7acf51e91a5f"
msgid "དཔེ་␣ར་ བསྟན་པ་ དེ་བཞིན་ དུ་ མཚུངས་མེད་"
msgstr "For example, the teaching is likewise peerless,"

msgctxt "c454561e4a144fef802fdf5dc5132a49"
msgid "ཆོས་ ཀྱི་ རྒྱལ་པོ་ འཇིག་རྟེན་ གསུམ་ གྱི་ མགོན་པོ་ ཡིས་ འཁྲུངས་ ཏེ་"
msgstr "From Dharma Lord Jigten Sumgon, "

msgctxt "4bd4dd4b68ef476bb431d9496b609353"
msgid "དོན་ མཐའ་དག་ མངོན་དུ་ མཛད་པ་␣འི་ ཁྱད་པར་ གྱི་ ཆོས་ འདི་དག་"
msgstr "These special dharmas that manifest all meanings are born."

msgctxt "b6a7300c512e4a3eadf7b5d73e70cda1"
msgid "གངས་ཅན་ འདི་␣ར་ སྔོན་ཆད་ མ་ གྲགས་པ་ ཞིག་"
msgstr "This is something not known before in this Land of Snow,"

msgctxt "ef9eaedf7010404dbc79edfb6fe21f22"
msgid "ཕྱི་དུས་ འཇིག་རྟེན་ མགོན་པོ་␣ས་ འདི་ལྟར་ གསལ་བ་␣ར་ མཛད་པ་"
msgstr "Later Jigten Gonpo made it clear in this way."

msgctxt "3e2782c6ed9f45f8973763da43fd294e"
msgid "རྗེས་ འབྲངས་ སྲས་ ཀྱིས་ མི་ འཛིན་པ་ ནི་"
msgstr "The follower sons who do not hold it is"

msgctxt "b573884205d94905833588e6307e36c3"
msgid "དེ་ དང་ ཚུལ་ མཚུངས་པ་ ཡིན་ ནོ ། །"
msgstr "similar in that manner."

msgctxt "5db7bf9d8df648f1aebdf890293c922a"
msgid "རྒྱུ་མཚན་ དེ་␣འི་ ཕྱིར་ རིགས་པ་ དང་ ལྡན་པ་"
msgstr "For this reason, those endowed with a rational mind,"

msgctxt "d500b2f2bd024fa6bb511b374929f2ba"
msgid "ཕ་ ཡི་ གདུངས་ འཚོབ་པ་␣ར་ འདོད་ ན་"
msgstr "If [they] want to fill up their father’s lineage,"

msgctxt "d412339e813443bfa64ae89ebf662268"
msgid "རྗེའི་ ཞལ་ ནས་ སུ་␣འི་ ཆོས་ ལ་ ཡང་ མི་ སྨོད །"
msgstr "The Lord said, “No one’s dharma is to be criticized;"

msgctxt "ddc9032d0d5045778afdf9590ae3dcfc"
msgid "གང་ ལ་ ཡང་ མ་སྨད་པ་␣ས་ ཆོས་ ལ་ བརྟེན་པ་␣འི་ གཡང་ས་ མེད །"
msgstr ""
"Because of not blaming anything, there is no cliff that depends on the "
"Dharma."

msgctxt "1055d67305364f329dd8caf454ac636b"
msgid "སུ་␣འི་ ཆོས་ ཀྱི་ རྗེས་སུ་ མི་ འབྲང་"
msgstr "Because of not following any Dharma,"

msgctxt "2b94a442f96f46268043d8313252bf1d"
msgid "གང་ གི་ རྗེས་སུ་ མ་ འབྲངས་པ་␣ས་"
msgstr "Or not following anyone."

msgctxt "c97d71aa36b549f2a87bd1b6d2e3c083"
msgid "ལོག་པ་␣ར་ ཞུགས་པ་␣འི་ ཉེས་པ་ མི་ འབྱུང་ ཞེས་ གསུངས་པ་ ལྟར །"
msgstr "It is said that the fault of engaging in wrongdoing does not occur."

msgctxt "b402d7cf395446ca8d5186946212e1ca"
msgid ""
"རིགས་ འཆོལ་བ་␣ས་ གཞན་ གྱི་ གྲུབ་མཐའ་ དང་ གང་ཟག་ ལ་ སྨོད་པ་␣ར་ མི་ བྱེད་པ་"
msgstr "Because of a mixed lineage, do not disparage other tenets and people."

msgctxt "e9a2103624524c9e8ad0b5cb095041ad"
msgid "ཁམས་ གསུམ་ ཆོས་ ཀྱི་ རྒྱལ་པོ་ ཆོས་རྗེ་ རིན་པོ་ཆེ་"
msgstr "The Dharma Lord of the three realms, Choje Rinpoche, "

msgctxt "ecae6db4c6fc47f88b3cfedbf39b37d9"
msgid "སྲིད་པ་ གསུམ་ ན་ གྲགས་པ་ དང་ ལྡན་པ་"
msgstr "Who is renowned in the three existences."

msgctxt "c4dc6bf6d39041b194bdbfb9fb85cf36"
msgid ""
"དེ་ ཡི་ བཞེད་པ་␣འི་ ཐུགས་དགོངས་ དུས་གསུམ་ སངས་རྒྱས་ ཀྱི་ བསྟན་པ་ མཐའ་དག་ གི་"
" སྙིང་པོ་␣ར་ གྱུར་པ་␣འི་ ཁྱད་ཆོས་ རྣམས །"
msgstr ""
"The distinctive features of his thoughts of acceptance are the essence of "
"all the teachings of the buddhas of the three times."

msgctxt "a61e069506ba4d17a97ac8186be6d5a8"
msgid "མདོ་ ལ་␣ས །"
msgstr "According to the sutra:"

msgctxt "2be4fd53254d4aa99066f90b45f440f5"
msgid "མེ་ ཚོགས་ སྤུ་གྲི་␣འི་ སོ་ ཡང་ བརྒལ་ ནས་ ནི ། །"
msgstr "Even if it needs walking through fire or a razor's edge,"

msgctxt "6e40073c04f64e929b105bcc3812444b"
msgid "ཕྱི་མཐ་␣ར་ ཐུག་ གི་ བར་ དུ་ བཟུང་བ་␣ར་ བགྱི །"
msgstr "[I] will uphold it until the end of time."

msgctxt "1715002716c9436e835174696c44d15e"
msgid "ཞེས་པ་ ལྟར་ ནན་ཏན་ ཆེན་པོ་␣འི་ སྒོ་ ནས་ འཛིན་པ་ ཞིག་ བྱུང་ ན་"
msgstr ""
"As it is said if one holds [the holy dharma] with tremendous assiduousness,"

msgctxt "846bdc54c3f04314be2eeff778716980"
msgid "ངོ་མཚར་ ཤིན་ཏུ་ ཆེ་བ་ ཡིན་ ནོ ། །"
msgstr "That is greatly marvelous."

msgctxt "66245e0559344cb88997d0a5c0a279c0"
msgid "བསྟན་པ་ གང་ གིས་ འཛིན་པ་␣འི་ ཆོས་མཛད་"
msgstr "The Dharma activities of the one who holds the teachings. "

msgctxt "8407e7b264c748d297d46a156d99238f"
msgid ""
"སྐྱེས་བུ་ དམ་པ་ རྣམས་ ནི་ འབངས་ ཕལ་པ་␣འི་ བུ་ སྟོང་ གི་ ནང་ དུ་ འཁོར་ལོ་␣ས་ "
"བསྒྱུར་ རྒྱལ་ གྱི་ རིགས་རུས་ ལ་␣ས་ འཁྲུངས་པ་␣འི་ མཚན་ལྡན་ གྱི་ སྲས་ དེ་ ནི་"
msgstr ""
"Sublime beings are like the son having the marks of those who were born in "
"the family line of a universal monarch, among a thousand sons of commoners, "

msgctxt "a7d1789caf1f46bc9e9b02b048baf5fa"
msgid "ཡོན་ཏན་ དུ་མ་␣འི་ སྒོ་ ནས་ ཁྱད་པར་ འཕགས་པ་ བཞིན་ དུ་"
msgstr " Being superior with many good qualities, "

msgctxt "0c03b8fcafe3469e9c173b3806dedde0"
msgid "བསྟན་པ་␣འི་ སྒོར་ ཞུགས་"
msgstr "Enter into the gate of the teachings."

msgctxt "ad2a1009e7e74d46ab01125522767dbe"
msgid "ཀུན་ གྱི་ ནང་ ན་ ཡོན་ཏན་ དུ་མ་␣ས་ མཛེས་ ཤིང་"
msgstr "Among all, with many good qualities, [they] are beautiful and"

msgctxt "34ad5611683c4b4781d06bf33386f643"
msgid "ལྷག་པ་ ཡིན་ ནོ །"
msgstr "superior."

msgctxt "49bad86c1c674cf7a84f6cf3d58e2848"
msgid "དེ་␣འང་ གང་ གིས་ ལྷག་པ་ ཡིན་ སྙམ་ ན །"
msgstr "If one wonders, what makes them superior?"

msgctxt "36d77409333d45ab84a3b286c746ce5f"
msgid "ཐུན་མོང་ མ་ཡིན་པ་ གཞི་ བདེ་བ་␣ར་ གཤེགས་པ་ དམ་པ་␣འི་ སྙིང་པོ་ དང་"
msgstr ""
"The uncommon basis is the state of bliss, the essence of the sublime ones, "
"and"

msgctxt "d7cf68a88db649a78a1946eefc4abbb0"
msgid ""
"དེ་ མངོན་དུ་ བྱེད་པ་␣འི་ ཐབས་ལམ་ གྱི་ རིམ་པ་ རབ་འབྱམས་ ཐུབ་པ་␣འི་ བཀའ་ "
"མཐའ་དག་ གམ །"
msgstr ""
"All the infinite instructions of the Able One on the stages of the path of "
"methods for actualizing it or"

msgctxt "a9dde874ec264e07a31987c460a9797a"
msgid ""
"ཡང་ན་ གཉིས་ ཆོས་ ཐམས་ཅད་ ལ་␣ས་ འདས་པ་␣འི་ སྟོང་ཉིད་ ཕྱག་རྒྱ་ ཆེན་པོ་ དང་ །"
msgstr ""
"It is the emptiness that is beyond all dualistic phenomena, mahamudra, and"

msgctxt "129fbb7c55714e2ebd4ff7b746dcf5e2"
msgid "དེ་ རྒྱུ་འབྲས་ སུ་ འབྱུང་བ་"
msgstr "That occurs as cause and effect,"

msgctxt "ed56d13e422745a88c7c16f401fbd7df"
msgid "འཁོར་འདས་ ཀྱི་ རྟེན་འབྲེལ་ ཀུན་ ལ་མ་ རྨོངས་པ་␣ས་"
msgstr ""
"Because of not being confused about the entire interdependence of samsara "
"and nirvana."

msgctxt "c2e1b6a65a5242b7a2fa79b6fa346bca"
msgid "དེ་ཕྱིར་ ཕྱི་རོལ་ རྒོལ་བ་ ངན་པ་␣འི་ ཝ་ ཚོགས་ ཀྱིས ། །"
msgstr "Therefore, the skulk of foxes of the bad non-Buddhist opponents,"

msgctxt "d86f6ebf48b44544bf964232c0b384a9"
msgid "གངས་ཅན་ སེང་གེ་ ལྟ་བུ་␣ར་ ཉམས་ ང་ །"
msgstr "Even intimidate the lion of the Snow Land,"

msgctxt "17ecce39c1004df2ac52e611380c04fe"
msgid "བག་ཚ་ བ་སྤུ་ ཙམ་ ཡང་ མེད་ དོ །"
msgstr "There is not even a hair of anxiety."

msgctxt "4d9e0583c6b64d4b92756273d4bceb1c"
msgid "རིགས་ དང་ དབང་པོ་ དང་ མཐུན་པ་␣ར་ རྗེས་ འབྲང་ ཀྱི་ འཁོར་ དང་"
msgstr "To the retinues of followers of the same class and faculties, and "

msgctxt "90171b31960246899ff2eaefe2fb08fb"
msgid ""
"རིགས་ཅན་ སྣ་ཚོགས་པ་␣འི་ གདུལ་བྱ་ སོ་སོ་ ལ་མ་ འདྲེས་པ་␣འི་ ཆོས་  ཀྱི་ ཁྱད་པར་"
" ལེགས་པ་␣ར་ བསྟན་པ་"
msgstr ""
"To each of the various classes of disciples, the distinctive features of the"
" Dharma are excellently taught."

msgctxt "e4adea6fbe2a4e1cb640ad19e29e51ce"
msgid ""
"དམན་པ་ ཉན་རང་ དང་ བྱང་ཆུབ་ མཆོག་ གི་ ལམ་ ལ་མོ་␣ས་པ་ ཇི་ལྟ་བ་␣འི་ བྱེ་བྲག་ "
"གི་ རིམ་པ་ ཕྱེས་ ཏེ་"
msgstr ""
"The paths of the lesser shravakas and pratyekabuddhas and the path of "
"supreme enlightenment are differentiated according to the particular stages "
"of adherence."

msgctxt "31fed210655141b3ad000f1bc29e00ca"
msgid "བསྟན་པ་␣ས་ བྱང༌ཆུབ་ གསུམ་ ལ་ འགོད་པ་␣ར་ བྱེད་ ཅིང་"
msgstr ""
"The teaching will arrange [them] to the three types of enlightenment and"

msgctxt "ca40b625a429429f88c581aea038cbe5"
msgid ""
"སྙན་པ་ དང་ གྲགས་པ་␣འི་ སྒྲ་ ཆེན་ འབྲུག་སྒྲ་ བཞིན་ དུ་ ཕྱོགས་ བཅུར་ "
"སྒྲོགས་པ་␣ར་ བྱེད་ དོ ། །"
msgstr ""
"The great sound of its fame and renown resounds in the ten directions like "
"thunder."

msgctxt "3ca0f2a24553479fb40b74d2428c8cf3"
msgid "དེ་ལྟར་ བརྗོད་བྱ་ ཆོས་ཐུན་ མཉམ་པ་ཉིད་"
msgstr "In that way, the subject matter is equal to phenomena,"

msgctxt "3a9a8f8039fe466ca86a39ba101c41aa"
msgid "སྦྲང་རྩི་ རོ་ གཅིག་པ་ ལྟར་ ཟབ་ ཅིང་"
msgstr "And is profound like the same taste as honey."

msgctxt "1877462fe5a54359b8f3a39b6dcea2d8"
msgid "རྗོད་ བྱེད་ མདོ་ རྒྱུད་ དང་ བསྟན་བཅོས་ རྒྱ་ ཆེ་ བླ་ ན་ མེད་པ་␣འི །"
msgstr ""
"The means of expression are the vast and unsurpassable sutras, tantras, and "
"treatises."

msgctxt "088df43e7f9445bc84496a3f409e582d"
msgid "དགོངས་པ་ རྒྱ་མཚོ་ ཆེ་ ལྟར་"
msgstr "[His] intent is like a great ocean"

msgctxt "2a355b23801e4ca0acdb71e30f8d821e"
msgid "ཤིན་ཏུ་ ཡངས་པ་␣ར་ གྱུར་པ་ ལ་␣ས །"
msgstr "Became very vast."

msgctxt "902ac40142c841e5beda550308be27a3"
msgid "སྐྲ་␣འི་ རྩེ་མོ་ བླངས་པ་␣འི་ ཆུ་ ཐིག་ ཙམ་ ཞིག་ སྨྲས་པ་"
msgstr "From that, [I] stated a drop of water taken by a hair tip."

msgctxt "255ee316a01e4c6ca21453a4b2c23b1c"
msgid ""
"འདི་ ནི་ བསོད་སྙོམས་ ཀྱི་ འཚོ་བ་␣འི་ བན་དེ་ ལྡོམ་བུ་པ་ ཤེས་རབ་ འབྱུང་གནས་ "
"བདག་ གིས་ བྲིས་ ཞེས་ སོ ། །"
msgstr "I, Sherab Jungne, a mendicant living on alms, wrote this."

msgctxt "97661bfccb3e44d08e9780d531cae7e2"
msgid "འཁོར་གསུམ་ གང་ དུ་ གང་ཞིག་"
msgstr "Whoever in the three spheres,"

msgctxt "92b4e813c0ca4cd4a2fe9369c9bf053a"
msgid "ཇི་ལྟར་ བསྔོ་བ་␣འི་ ཆོས་ མི་ དམིགས་རྣམ་པ་␣ར་ དག་པ་"
msgstr "As the dedication of Dharma is non-apprehensible and utterly pure."

msgctxt "0970174fffc349bcbe1b4bbcac739e2c"
msgid "གངས་ ཀྱི་ རི་ ལྟར་ དཀར་བ་␣འི་ དགེ་བ་ འདི་␣ས ། །"
msgstr "By this virtue, which is as white as a snow mountain,"

msgctxt "e0d578a814584d229bc436ab64d90d0d"
msgid "རིན་ཆེན་ རྒྱལ་བ་␣འི་ བསྟན་པ་ ཕྱོགས་ བཅུ་ མུ་མེད་པ་"
msgstr ""
"The precious teachings of the conqueror will [flourish] in ten directions "
"without limits,"

msgctxt "6a7ca62003c14dab9728effb3fc1ad77"
msgid "ཕྱི་མ་␣འི་ མཐ་␣འི་ བར་ དུ་ རྒྱས་པ་ དང༌ །"
msgstr "Until the end of time and"

msgctxt "24b45ef8c4ac4e5eb7c7a2bf30b5eaef"
msgid "དེ་␣འི་ མཐུ་␣ས་ འཇིག་རྟེན་ འཁོར་བ་␣འི་ རྩ་བ་"
msgstr "By the power of that, the root of samsara,"

msgctxt "ac073bec93764abc847f508b2d269ddd"
msgid "མི་ ཤེས་པ་␣འི་ གཏི་མུག་"
msgstr "The delusion of not knowing,"

msgctxt "f80ba238843748e7a6952ad6db7a298d"
msgid "གློ་བུར་པ་␣འི་ དྲི་མ་ དང་ རྣམ་པ་␣ར་ བྲལ་ ཞིང༌ །"
msgstr "Will be separated along with its adventitious stain."

msgctxt "7ec0bc4ac15a4336a34648a65458f9ce"
msgid "མཐ་␣ར་ ཕྱིན་པ་␣འི་ སངས་རྒྱས་ སྐུ་གསུམ་ དང་"
msgstr "The ultimate three buddha kayas and "

msgctxt "5eac976a087942dc9add4aba867528a0"
msgid "ཡེ་ཤེས་ ལྔ་␣འི་ བདག་ཉིད་ མྱུར་ དུ་ ཐོབ་པ་␣ར་ ཤོག་ ཅིག་ ཅེས་པ་␣འོ ། །"
msgstr "five wisdoms, May all swiftly attain in these nature."

msgctxt "d4fc672194ac4f85aa819e6bdf94efa9"
msgid "ཞེས་པ་ བཤེར་ འབྱུང་ གིས་ མཛད་པ་␣འི་ གཞུང་ རྩ་བ་ དེ་ཉིད་"
msgstr "This root text composed by Sherab Jungne is [compiled]"

msgctxt "bc7b5e0cee3b45e7a8c048f62d288ad5"
msgid ""
"འབྲི་གུང་ གདན་ རབ་ རྗེ་བཙུན་ དཀོན་མཆོག་ རིན་ཆེན་ ཕྲིན་ལས་ རྣམ་རྒྱལ་ དཔལ་ "
"འཟང་པོ་␣ས་"
msgstr ""
"By the succession of Drigung, the venerable Konchok Rinchen Trinle Namgyal "
"Pal Zangpo, "

msgctxt "1a20246ee0c04fd9a8cf85f3d677ed31"
msgid "ཚིག་ བཅད་ དུ་ ལྡེབས་པ་ ལ་␣ས་"
msgstr "In the verses. "

msgctxt "b5cb72a5e9e8484f99076fba7f36d973"
msgid "སླར་ ལྷན་ཐབས་ བཅས་ དཀྱུས་ སུ་ བསྒྲིགས་ ནས་"
msgstr "Later, it was arranged into sections and "

msgctxt "38c4139228b243aaa121093c33e7ce5d"
msgid "མཆན་ གྱིས་ བཀྲལ་བ་"
msgstr "Elucidated with annotations."

msgctxt "ba81de9a22a848b6a06719ebf7cb2daa"
msgid ""
"སྔོན་བྱོན་ སྐྱེས་ཆེན་ དམ་པ་ བཅུ་ཕྲག་ རིགས་པ་␣འི་ གནས་ ལ་ མཁས་པ་ ཤཱཀྱའི་ "
"དགེ་སློང་ དཔལ་འབྱོར་ རིན་པོ་ཆེ་␣ས་ མཆན་ ཐོར་བུ་␣ར་ སྡེབས་པ་ ལ་ གཞི་ བྱས་ ཏེ་"
msgstr ""
"Based on the fragmented notes compiled by the Shakya monk Paljor Rinpoche, a"
" scholar of the various fields of knowledge."

msgctxt "a5ddf198fb564888b9ffab951dfdbbe8"
msgid ""
"སྙིགས་དུས་ ཀྱི་ ལྡོམ་བུ་བ་ འབྲི་ སྤྲུལ་ རྟོགས་ལྡན་ དཀོན་མཆོག་ ཐུབ་བསྟན་ "
"བསྟན་པ་␣འི་ རྒྱལ་མཚན་ གྱིས་"
msgstr ""
"The Drigung emanation Togden Konchok Thupten Tenpai Gyaltsen, a mendicant of"
" this degenerate age,"

msgctxt "5256a9abbfb54f5583b4615697a35f61"
msgid "མང་ཡུལ་ ལ་དྭགས་ སྒང་ སྔོན་ བཀྲཤིས་ ཆོས་རྫོང་ དུ་"
msgstr "At the Gangnon Tashi Chozong Monastery,"

msgctxt "4bac813634b44dea88d2d90a0db41c29"
msgid "འབྱུང་བ་ བཞི་ ལྡན་"
msgstr "Endowed with the four elements,"

msgctxt "dd610cf5589f499c825748d974f7c1cf"
msgid "ས་མོ་ བྱ་ལོ་␣འི་ དུས་འཁོར་ གྱི་ གསོ་དཔྱད་ རྒྱ་རྩིས་ ཀྱི་ སྟོན་ ར །"
msgstr ""
"In the autumn of the Earth-Female-Bird Year of the wheel of time of the "
"Chinese astrological and medicine year,"

msgctxt "f3d443b1a3a647a6a77f0ded647b47d7"
msgid "སྐར་རྩིས་ རྒྱ་གར་ གྱི་ དབྱར་ ཐ་ གྲོ་ཞིན་"
msgstr "In the summer month of the Indian astrological system,"

msgctxt "3c5019ac64e148b889ef558f76cb4968"
msgid "ཟླ་བ་ མར་ངོ་␣འི་ ཚེས་  ༡༣  ལ་ བྲིས་པ་ དགེ་ལེགས་ འཕེལ །།"
msgstr ""
"This is written on the thirteenth day of the waning moon—may virtue and "
"goodness increase."
