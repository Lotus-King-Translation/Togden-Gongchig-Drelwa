msgctxt "d1231fe402d54a1fad9d602c16f9a834"
msgid "ཞེས་ དང༌ །"
msgstr "And"

msgctxt "675c2d56e65b42b6acd6352caf656bb1"
msgid "རྗེ་བོ་␣ས །"
msgstr "Jowo says:"

msgctxt "1b2312377d064b4b9062aceb9f861135"
msgid "དང་པོ་␣འི་ སངས་རྒྱས་ བྱུང་ ཆེན་ ལ་␣ས ༑ །"
