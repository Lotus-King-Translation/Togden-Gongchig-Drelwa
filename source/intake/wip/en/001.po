"There is no thought of attraction to virtue and aversion to non-virtue."

msgctxt "f65133fa3add4c2e893d569721cbaed1"
msgid "དེ་ཡང་ གང་ཟག་ ལྟ་ རྟོགས་ དང་ ལྡན་པ་ དེ་␣ས་ བསྒྲུབས་པ་␣འི་ སྤྱོད་པ་ ནི་"
msgstr ""
"Furthermore, the conduct accomplished by a person who has the view and "
"realization is"

msgctxt "0f667ef703d8444da9c4ab002108eeba"
msgid "དོན་སྙིང་པོ་␣ར་ གྱུར་པ་"
msgstr "is the essential meaning."

msgctxt "e81c2b10ff0842878d8ae329ff6201ae"
msgid ""
"བསླབ་པ་ རིན་པོ་ཆེ་ གསུམ་ ཆགས་སྡང་ མེད་པ་␣འི་ སྒོ་ ནས་ སྤྱོད་ དགོས་པ་ ཞིག་ གོ"
"  ༑"
msgstr ""
"One must practice the three precious trainings without attachment or "
"aversion."

msgctxt "fcc6f9e5f53947628d7a7d87c96e50aa"
msgid "རྡོ་␣༽༽  ལྟ་ སྒོམ་ སྤྱོད་ གསུམ་ ཐ་དད་ དུ་ འདོད་པ་ མང་ མོད་ ཀྱང༌ །"
msgstr "Vajra: Many accept that view, meditation, and conduct are distinct."

msgctxt "0f8fc6408481453db6a5045d24c48801"
msgid ""
"འདི་␣ར་ ནི་ ལྟ་ སྒོམ་ སྤྱོད་ གསུམ་ སོ་སོ་␣ར་ ཐ་དད་ མེད་པ་␣ར་ གཅིག་པ་ བཞེད་ "
"དེ་"
msgstr ""
"In this [system], it is accepted that view, meditation, and conduct are not "
"distinct but the same."

msgctxt "f5d54d791e4e49f4acc1b5c29e0ef72e"
msgid "ལྟ་བ་ རྟོགས་པ་ ལྡན་པ་ སྒོམ་པ་␣ར་ བྱེད་ ཅིང་"
msgstr "It is the meditation of the view that has been realized."

msgctxt "99379dc63560464b946c30689c02b133"
msgid "དེ་ དང་ མི་འགལ་བ་␣ར་ ཁྱད་པར་ དུ་ བྱེད་པ་ ཡིན་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "This is because it is especially distinguished as non-contradicting."

msgctxt "92c403bdec114b3ebbaa477508a53f32"
msgid "དེ་ གསུམ་ ཀ་ རང་བཞིན་ མེད་པ་␣ར་ ཉམས་ སུ་ ལེན་ དགོས་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"This is because all three of these must be practiced as a devoid of self-"
"nature."

msgctxt "dfb6cb546d82417899638b0409504b46"
msgid "དེ་ལྟར་ ཡང་ །"
msgstr "Likewise,"

msgctxt "f2cd0bf67cef4268961b27aff9c83db0"
msgid "ལྟ་ སྒོམ་ སྤྱོད་ གསུམ་ གཅིག་ ན་ སྐུ་གསུམ་ འདུ་ འབྲེལ་ མེད །"
msgstr ""
"If view, meditation, and conduct are one, the collection of the three kayas "
"is unrelated."

msgctxt "64326fe62285406d9c1fa5131e21b747"
msgid "ཅེས་ སོ །"
msgstr "As said."

msgctxt "efc9f34159404c9ba712737267d6a027"
msgid ""
"རྡོ གཉིས་ མེད་ ཕྱག་ ཆེན་ དང་ སྤང་བླང་ དགག་སྒྲུབ་ ཀྱི་ ཚུལ་ཁྲིམས་ གཉིས་ མི་ "
"གཅིག་ སྡེ་ འགལ་བ་␣འོ་ ཟེར །"
msgstr ""
"Vajra: It is said that the non-dual mahamudra and the moral conduct of the "
"abandonment and adoption, negation, and assertion, are not the same and they"
" are contradictory."

msgctxt "ebb16f8028cb43ea9ae52e2190a26a9f"
msgid "འདི་␣ར་ ནི་ ཕྱག་ ཆེན་ དང་ ཚུལ་ཁྲིམས་ གནད་ གཅིག་པ་"
msgstr ""
"In this [system], Mahamudra and moral conduct are essentially the same."

msgctxt "bf343316b2934781bb88ec160d4dcba5"
msgid "སྟོང་ཉིད་ རྒྱུ་འབྲས་ སུ་ འབྱུང་བ་ འདི་"
msgstr "This arising of emptiness as cause and effect,"

msgctxt "e0f80d29f70d4e549c75c86d64050a32"
msgid "གཞན་ ལ་ མེད་པ་␣འི་ ཁྱད་པར་ གྱི་ ཆོས་ ཡིན་ ཏེ་"
msgstr "It is a distinctive feature not found in others."

msgctxt "b67cf8b257d94e269d657c0edd634c3f"
msgid "སེམས་ཉིད་ རྟོགས་ ན་"
msgstr "If one realizes the mind itself,"

msgctxt "03c044d3ede94fcab523b445df084ca8"
msgid "ཆགས་སྡང་ དང་ བྲལ་བ་ དང་"
msgstr "One is free from attachment and aversion and"

msgctxt "e36bd72a05374ad5bc424d1c4682a6cd"
msgid "ཚུལ་ཁྲིམས་ ཀྱིས་ ཀྱང་ དེ་ སྤོང་ ཞིང་"
msgstr "Moral conduct also eliminates that."

msgctxt "77737fcf64cd400296d19c1b2539413a"
msgid "དེ་␣འང་ གཞི་ ཆོས་ཉིད་ ལ་ རག་ ལས་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "This is because it depends on the basis, the nature of phenomena."

msgctxt "c11e7b1265624fae98200c850cd90aaf"
msgid "ཕྱག་རྒྱ་ ཆེན་པོ་␣འི་ མངོན་རྟོགས་"
msgstr "The manifest realization of the mahamudra,"

msgctxt "462c4004060849d9ab53e2655a23b219"
msgid "གཞི་ ཚུལ་ཁྲིམས་ ལ་ བརྟེན་ དགོས་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "Because it also depends on the basis-moral conduct and "

msgctxt "e1d66a54485d4307b7112391254134c9"
msgid "དུག་ གསུམ་ སྤོང་བ་ གནས་སྐབས་ དང་"
msgstr "The temporary elimination of the three poisons and "

msgctxt "d839c88d9c8f406abf769e79d15de9d6"
msgid "མཐར་ཐུག་ གི་ ཡོན་ཏན་ སྒྲུབ་པ་␣འི་ བྱེད་ལས་ གཅིག་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "The ultimate accomplishment of good qualities has the same function."

msgctxt "6a1b22a4011b4b4bb7045e4d231f25eb"
msgid "གཤིས་ བབས་ སྟོང་ཉིད་ དང་ གཅིག་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "This is because the natural state is identical to emptiness."

msgctxt "7af744f7dbe04faeb334aac5014ab108"
msgid "དེ་ལྟར་ ཡང༌ །"
msgstr "Likewise,"

msgctxt "6890f3910a344334a9049c4913362b6b"
msgid "གལ་ཏེ་ སངས་རྒྱས་ ཁམས་ མེད་ ན །"
msgstr "If there is no element of buddha,"

msgctxt "8129c62486a34baf9786f383b17e4bff"
msgid "སྡུག་ ལ་ སྐྱོ་བ་␣ར་ མི་ འགྱུར་ ཞིང༌ །"
msgstr "There would be no disenchantment with suffering, "

msgctxt "6a00472b10314548b3845c76af2803db"
msgid "མྱ་ངན་ འདས་ ལ་ འདོད་པ་ དང༌ །"
msgstr "No wish for nirvana and,"

msgctxt "287a77fb0346403e82dccafd0f1409ea"
msgid "དོན་གཉེར་ སྨོན་པ་␣འང་ མེད་པ་␣ར་ འགྱུར །"
msgstr "No aspiration to seek for it."

msgctxt "8ddc3c0ea1314dd79d5aeb982b145323"
msgid "སློབ་དཔོན་ འཕགས་པ་␣ས ༑"
msgstr "Master Arya said:"

msgctxt "a133b1b597164d70b64730a5781e7011"
msgid "ཁྲིམས་ ནི་ རྒྱུ་ དང་ མི་ རྒྱུ་␣འི་ ས་ བཞིན་ དུ །"
msgstr "It is said that discipline is, just like animate and inanimate earth,"

msgctxt "994d63e8a1734d9ca53ead6f0cf77287"
msgid "༑། ཡོན་ཏན་ ཀུན་ གྱི་ གཞི་ རྟེན་ ཡིན་པ་␣ར་ གསུངས །"
msgstr "The foundation of all good qualities."

msgctxt "a63a260c645b468b8922bf4d02df1bef"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "2a40a678f20d4af5ada6dfb8af12e092"
msgid "སོ་སོ་ སྐྱེ་བོ་ རྣམས་ དང་ གསུང་སྐྱེས་ དང་ །"
msgstr "Individual beings and those born from speech and,"

msgctxt "7d2d07596e9447b3bc50e6e4a5fe341b"
msgid "རང་ བྱང་ཆུབ་ ལ་ བདག་ཉིད་ ངེས་ རྣམས་ དང༌ །"
msgstr "Those who are definite in the practice of the self-enlightenment,"

msgctxt "743aa6c8acca4791a41b63c3cb82db29"
msgid "རྒྱལ་སྲས་ རྣམས་ ཀྱི་ ངེས་པར་ ལེགས་པ་ དང༌ ། །"
msgstr "The definite goodness of the children of the conquerors,"

msgctxt "a1e9a59f305c4ea6acb29d22e4318956"
msgid "མངོན་མཐོ་␣འི་ རྒྱུ་ ནི་ ཚུལ་ཁྲིམས་ ལ་␣ས་ གཞན་ མེད །"
msgstr ""
"The cause of the excellent rebirth is discipline, and there is no other."

msgctxt "46023e9fd43743deb94b2ca9895666fd"
msgid "ཅེས་ དང༌ །"
msgstr "And."

msgctxt "ed862a77cedf4d129390f07c25a5a593"
msgid "ཚུལ་ཁྲིམས་ ཀྱིས་ ནི་ ཞི་བ་ འདོད་ རྣམས་ འཕགས་པ་␣ར་ འགྱུར །"
msgstr ""
"Those who wish for peace will become a noble one through moral conduct."

msgctxt "e4fea116d6c3495ca7dccdfbf22c3b4d"
msgid "ཞེས་ དང་ །"
msgstr "And."

msgctxt "c8384c2a63304f87a83f222c744ce79e"
msgid "ཏིང་ རྒྱལ་ ལ་␣ས །"
msgstr "According to the King of Meditative Concentration [Sutra]:"

msgctxt "16f50423500c49ef869edb93807f596d"
msgid "ཏིང་འཛིན་ རྒྱལ་པོ་ སྟོང་པ་ འདི་ བསྒོམ་པ་␣ས ། །"
msgstr "By meditating on this king of meditative concentration, emptiness,"

msgctxt "498a689593f04bd98c8d2c302ff736bf"
msgid "ཚུལ་ཁྲིམས་ དག་པ་␣འི་ མགོ་ ལ་ དེ་ འདུག་ སྟེ ། །"
msgstr "It is on the heads of those who have pure moral conduct."

msgctxt "ddfac9887a1f4c6195993beaa4d06927"
msgid "ཆོས་ རྣམས་ རང་བཞིན་ སྟོང་པ་␣ར་ མཉམ་ གཞག་ ནས །།"
msgstr ""
"By placing meditative equipoise on empty of the intrinsic nature of all "
"phenomena,"

msgctxt "2f82f31654b14798979eacfdc501f315"
msgid "བྱིས་པ་ མེ་ རེག་ བརྩོན་པ་␣ས་ མི་ ཤེས་ སོ །"
msgstr "Children who pursue to touch a fire, do not understand this."

msgctxt "9941e16ea3d84640811e770fd22d6ce1"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "60121ec649e848dd9f96a70681951ffc"
msgid "མདོ་␣ར་ བསྡུ་ ན །"
msgstr "In conclusion,"

msgctxt "041ae3971b644547a6e4bc8d4fb1809f"
msgid "གཉིས་ཀ་ ཉོན་མོངས་ ཀྱི་ དབེན་ ཀྱང་"
msgstr "Although both are devoid of afflictions,"

msgctxt "9d4a9c1be43a4b588fe72e92fc56bf1d"
msgid "དཀར་པོ་␣འི་ ཆོས་སྤྱོད་ རྒྱུན་ མི་ བཅད །"
msgstr "Uninterrupted continuity of white Dharma practice."

msgctxt "da331dfa6fec4a9d8e87493d9e9418d6"
msgid "མར་ ངན་སོང་ ལ་ དོགས་པ་ མེད་ ཀྱང་"
msgstr "Although there is no doubt of the bad migrations,"

msgctxt "d0a187ea79df4b47b0ba33984b5eefbb"
msgid "སྡིག་པ་ ཕྲ་བ་␣ས་ གཅིག་པ་ ཡིན་ ནོ །"
msgstr "Since the negative actions are subtle, they are the same."

msgctxt "360dae0f32d54566a33bc223cdb5ed5c"
msgid ""
"རྡོ་␣༽༽  ཕྱག་ ཆེན་ ནམ་མཁའ་ དང་ འདྲ་བ་␣ས་ དགེ་ མི་དགེ་␣ར་ བཞག་ ཏུ་ མེད་ ཅིང༌ "
"།"
msgstr ""
"Vajra: It is said that mahamudra is like space, thus it cannot be placed as "
"virtuous or non-virtuous."

msgctxt "7ca69927d3b247cbb66ac9db7cb59d0e"
msgid "སྐྱོན་ཡོན་ མེད་པ་␣འི་ སྟོང་ཉིད་ ཡིན་ ཟེར །"
msgstr "It is emptiness without faults or good qualities."

msgctxt "287d326eeb834f0ba2529983510b885e"
msgid "འདི་␣ར་ ནི་ ཕྱག་ ཆེན་ ནི་"
msgstr "In this [system], Mahamudra is"

msgctxt "04bb9b722d0e4a648fd311b94e259f19"
msgid ""
"གཞི་ ལམ་ འབྲས་བུ་ གསུམ་ ཐམས་ཅད་ དུ་ ཡོན་ཏན་ ཀུན་ གྱི་ བདག་ཉིད་ དུ་ བཞུགས་ "
"ཏེ་"
msgstr "The essence of all qualities in all three, ground, path, and result."

msgctxt "84ab4dace28d4cc08d8d87991c2736e2"
msgid "གཞི་ དུས་ སུ་ སྡུག་བསྔལ་ ལ་ སྐྱོ་བ་"
msgstr "At the time of the ground, there is disenchantment with suffering."

msgctxt "032c1b612e7c47fb8e7015d094ef4dae"
msgid "མྱང་འདས་ ལ་ འདོད་འདུན་ སྐྱེ་བ་ ཁམས་ ཀྱི་ མཐུ་ ཡིན་ ཏེ །"
msgstr ""
"Arising of desire and aspiration for nirvana is the power of the element."

msgctxt "4bea8fd2931a41b6935a449273e346c3"
msgid "རྒྱུད་བླ་མ་ ལ་␣ས །"
msgstr "According to The Highest Continuum:"

msgctxt "c3d87fe2669d436ba7cc7ef39b9f5066"
msgid "གལ་ཏེ་ སངས་རྒྱས་ ཁམས་ མེད་ ན །"
msgstr "If there is no element of buddha,"

msgctxt "87c9ab9af2b94b749586f48380626338"
msgid "སྡུག་བསྔལ་ ལ་ སྐྱོ་བ་␣ར་ མི་ འགྱུར་ ཞིང༌ །"
msgstr "There would be no disenchantment with suffering,"

msgctxt "39b4233658d64742b20d6298194511ce"
msgid "མྱ་ངན་ འདས་ ལ་ འདུན་པ་ དང༌ །"
msgstr "No aspiration for nirvana and,"

msgctxt "05f1bcdaa0fc4b5a9600566984c8df24"
msgid "དོན་གཉེར་ སྨོན་པ་␣འང་ མེད་པ་␣ར་ འགྱུར །"
msgstr "No aspiration to seek for it."

msgctxt "36a5827ebc6d48d4ab4c1541f2c173ba"
msgid "ཞེས་ སོ ། །"
msgstr "As said."

msgctxt "d08461e15e8e411fadb54879853df26d"
msgid "གཞི་ དེ་ཉིད་ ལ་ བླ་མ་␣ས་ ངོ་ སྤྲད་ དེ་ གོམ་པ་␣ར་ བྱེད་པ་ ལ་ ལམ་ ཟེར་"
msgstr ""
"The guru's introduction to the ground itself and familiarizing it is called "
"the path."

msgctxt "27855b0beed94d1bbf88429da618c4c0"
msgid "དགེ་རྩ་ གང་ བྱེད་ ཀྱང་ དེ་␣འི་ མཐུ་␣ས་ དཔག་མེད་ དུ་ འགྱུར་ རོ ། །"
msgstr "Whatever roots of virtue one makes will have immeasurable power."

msgctxt "e90514feb66c4fafab30931e9ad4e526"
msgid "ཡུམ་ ལ་␣ས །"
msgstr "According to the Mother [Prajnaparamita Sutra]:"

msgctxt "0eed56b78e2b48028c88e281894f7344"
msgid ""
"མེ་ཏོག་ གཅིག་ གམ་ གདུགས་ གཅིག་ གིས་ འཇིག་རྟེན་ གྱི་ ཁམས་ ཐམས་ཅད་ ཁྱབ་པ་␣ར་ "
"འདོད་པ་␣ས་"
msgstr ""
"One flower or one parasol is considered to cover all the realms of the "
"world."

msgctxt "7512309a9edf4cc3b064be4cb400392a"
msgid "ཤེས་རབ་ ཀྱི་ ཕ་རོལ་ ཏུ་ ཕྱིན་པ་ ལ་ བསླབ་པ་␣ར་ བྱ་␣འོ ། །"
msgstr "One must train in the perfection of wisdom."

msgctxt "9e3cbcaaed96497690cf0b60843a183e"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "0946849c6eff46a68ffba2a39db3a8bd"
msgid "འབྲས་བུ་ དུས་ སུ་ ཆོས་སྐུ་ ཡོན་ཏན་ མཛད་པ་ དང་ བཅས་པ་"
msgstr ""
"At the time of the result, the truth body endowed with the qualities and "
"enlightened activities,"

msgctxt "4f40f6e223a64683bae1ced405f57b6d"
msgid "རྒྱུན་ མི་ ཆད་པ་ འབྱུང་བ་␣ས་ ཡོན་ཏན་ གྱི་ བདག་ཉིད་ དུ་ གནས་ སོ ། །"
msgstr ""
"Since it arises continuously without interruption, it abides by the nature "
"of good qualities."

msgctxt "c9c1a47b6e324056a7de991b7c3d9725"
msgid "མདོར་ན་ གཞི་ ལམ་ འབྲས་བུ་ ཐམས་ཅད་ དུ་"
msgstr "In brief, in all the ground, path, and result, "

msgctxt "3847a27c76b748778f10e40d6a8fb7a5"
msgid "སྐྱོན་ཡོན་ བསལ་ གཞག་ མེད་པ་␣ར་ གནས་ ཏེ །"
msgstr "there is no elimination or placing of faults or good qualities."

msgctxt "4403ff0291c045b5bd0771ec2a94ee24"
msgid "རྒྱུད་བླ་མ་ ལ་␣ས །"
msgstr "According to The Highest Continuum:"

msgctxt "f056fec0e2474e34934c73e8bfd48551"
msgid "འདི་ ལ་ བསལ་ བྱ་ ཅི་ཡང་ མེད །"
msgstr "There is nothing to eliminate here."

msgctxt "8d8a7b32cd6646c997e274b5056bb9ce"
msgid "བཞག་པ་␣ར་ བྱ་བ་ ཅུང་ཟད་ མེད །"
msgstr "There is nothing to be placed."

msgctxt "4f9b76508ca54fbc881d8f7acfae7e0b"
msgid "ཡང་དག་ ཉིད་ ལ་ ཡང་དག་ ལྟ །"
msgstr "Truly see the authentic state,"

msgctxt "cacb41406f12459489dfe4aa851327e8"
msgid "ཡང་དག་ མཐོང་ ནས་ རྣམ་པ་␣ར་ གྲོལ །"
msgstr "By seeing the authentic state, completely liberated"

msgctxt "31fa032745604496b6ff2d83ac41de04"
msgid "ཅེས་ སོ །"
msgstr "As said."

msgctxt "fb45d39539544d9a9ba5a97aefd7a4a5"
msgid "༼༼་␣༡ ༽༽  རྡོ་␣༽༽་␣འགའ་ཞིག་ མཉམ་པ་␣ར་ བཞག་པ་ ལ་␣ས་"
msgstr "Vajra: Some say that from meditative equipoise"

msgctxt "8a2993de71c54dee9f0cb4b0608feeb0"
msgid "ཡོན་ཏན་ མི་ འབྱུང་ རྗེས་ཐོབ་ ལ་␣ས་ འབྱུང་ སྟེ །"
msgstr "the good qualities do not arise but they arise from post-attanment."

msgctxt "d3a5f1743119497d8f583c36ba2132b4"
msgid "ཇོ་བོ་␣ས །"
msgstr "Jowo says:"

msgctxt "a48bc7d34797467d954efa062205c4cd"
msgid "གལ་ཏེ་ མཉམ་བཞག་ སེམས་ བརྟན་ ན ། །"
msgstr "If the mind is stable in meditative equipoise,"

msgctxt "5bcd3cb98e72481aa13744b842d7345d"
msgid "ལུས་ངག་ དགེ་བ་ གཙོ་␣ར་ མི་ བྱ །"
msgstr "The physical and verbal virtues are not the most important."

msgctxt "898786c2c6c04cbe99ad9367a2b20127"
msgid "ཞེས་པ་ དང་ །"
msgstr "And."

msgctxt "aa635b54b7c640088c85c901eb08178b"
msgid "མཉམ་ གཞག་ ནམ་མཁའ་ ལྟ་བུ་ ཡིན་པ་␣ས་ སོ་␣༑ །"
msgstr "The meditative equipoise is like space."

msgctxt "4319d776c69f4bfe8edab521c62ae71f"
msgid "ཟེར་ ཡང་ །"
msgstr "Although it is said,"

msgctxt "cecf85ad4d504f28a2987bb369550498"
msgid "དེ་ལས་ འདི་␣ར་ རང་ ཕྱག་ ཆེན་ ལ་ དགེ་ མི་དགེ་ གཉིས་ཀ་␣ས་ སྒྲིབ་ སྟེ །"
msgstr ""
"In this [system], mahamudra is obscured by both virtue and non-virtue."

msgctxt "61cef551219c4f7d96d3adc8b33fd842"
msgid "འདུ་བྱེད་ ཡིན་པ་␣འི་ ཕྱིར་"
msgstr "Because it is formative."

msgctxt "7a7db1c30507444e86421ec950e55e66"
msgid "རྩ་ཤེ་␣ར་ ལ །"
msgstr "According to the Root Stanzas of the Middle Way:"

msgctxt "869629c909984cf5b451ed5d1da3192b"
msgid "འཁོར་བ་␣འི་ རྩ་བ་ འདུ་བྱེད་ དེ །"
msgstr "The root of cyclic existence is formatives."

msgctxt "754624bbccbc48daad29d8d359ec7bd2"
msgid ""
"ཅེས་པ་␣ས་ སྤྲིན་དཀར་ ནག་ གཉིས་ཀ་␣ས་ ཉི་མ་ སྒྲིབ་པ་␣ར་ ཁྱད་པར་ མེད་པ་ བཞིན་ "
"ནོ་ ཟེར །  འདི་␣ར་ ནི་ དགེ་བ་␣འི་ ངོ་བོ་␣ས་ གཞི་ ལམ་ འབྲས་བུ་ གསུམ་ དུ་ ཕྱག་"
" ཆེན་ ལ་ སྒྲིབ་ མི་ སྲིད་ དེ་"
msgstr ""
"It is said that it is like white and black clouds that have no difference in obscuring the sun.\n"
"In this [system], the essence of virtue cannot obscure mahamudra in the ground, path, and result."

msgctxt "8cf286c305c9419ebcca3b11b62b29ea"
msgid "མཚོ་ དང་ མཚོ་␣འི་ རླབས་ བཞིན་ དུ་"
msgstr "Like a lake and its waves."

msgctxt "fb3a5dce98ae41338034ef3188f7c9d7"
msgid "ཐབས་ བྱང་ཕྱོགས་ སོ་ བདུན་ སོགས་"
msgstr ""
"The method such as the thirty-seven factors harmonious with enlightenment "
"and so on."

msgctxt "b0bf782a82f548e2be5ec278cc96b322"
msgid ""
"དེ་ རང་ ལ་␣ས་ བྱུང་ ཞིང་ དེ་␣འི་ ངོ་བོ་ གོང་ ནས་ གོང་ དུ་ འཕེལ་བ་␣ར་ བྱེད་ "
"ཅིང་"
msgstr "It arises from itself and its essence increases more and more."

msgctxt "604433282dc9450788fec3c61c7c28fe"
msgid "སྐྱབས་  སུ་ འགྲོ་བ་ ལ་སོགས་པ་␣ས་ སངས་རྒྱས་པ་␣འི་ དུས་ སུ་"
msgstr "At the time of enlightenment by going for refuge and so forth,"

msgctxt "8a52f8365f61423aa66a2f238743f50b"
msgid "དཀོན་མཆོག་ གི་ འཁོར་ལོ་ འབའ་ཞིག་ ཏུ་ འབྱུང་ ངོ༌ །"
msgstr "It occurs exclusively as the wheel of the three jewels."

msgctxt "4ae913b944ae44ed8fc64de6b060e198"
msgid "གཞི་ ལམ་ གྱི་ དགེ་བ་ བྱས་ ཚད་"
msgstr "The virtue that is created on the ground and path,"

msgctxt "080baeef047244c39768b810a15408cf"
msgid "མཐར་ཐུག་ སངས་རྒྱས་ ཀྱི་ དུས་"
msgstr "At the time of the ultimate enlightenment,"

msgctxt "de387233b15843e7b943edb6d25cbad0"
msgid "ཕྲིན་ལས་ བསམ་ གྱི་ མི་ ཁྱབ་པ་␣ར་"
msgstr "With the inconceivable enlightened activity,"

msgctxt "9e21b7ae04c047b3881417cca7385df1"
msgid ""
"སེམས་ཅན་ གྱི་ ཁམས་ རྒྱུན་ མི་འཆད་པ་␣ར་ འཇུག་པ་␣ར་ བྱེད་པ་ ཡིན་པ་␣འི་ ཕྱིར་ "
"རོ །"
msgstr "Which uninterruptedly engages the realms of sentient beings."

msgctxt "83587a673ce24df18fa2eea91b3ee2ba"
msgid "བཞེད་ ལ་ མཉམ་བཞག་ སྐབས་ ལ་"
msgstr "It is accepted that during the time of meditative equipoise,"

msgctxt "b2d7a68e93f9402ca139e6348a37dc2a"
msgid "ཡོན་ཏན་ ཐམས་ཅད་ འབྱུང་ སྟེ་"
msgstr "All the good qualities arise"

msgctxt "82b3f2bea7124ee3ac2bbd6f6ef1fbab"
msgid "མཐོང་ལམ་ ཐོབ་ ནས་ ཡོན་ཏན་ བརྒྱ་ ཕྲག་ བཅུ་གཉིས །"
msgstr ""
"After attaining the path of seeing, twelve hundred good qualities arise."

msgctxt "1e816b82ccd040b4b5508b0cdd195512"
msgid "ས་ གཉིས་པ་␣ར་ སྟོང་ཕྲག་ བཅུ་གཉིས་"
msgstr "On the second level, twelve thousand [good qualities arise]."

msgctxt "bc5e602c2af04753ba0ef01e04bc810c"
msgid "ས་ བཞི་པ་␣ར་ བྱེ་བ་ བརྒྱ་ ཕྲག་ བཅུ་གཉིས །"
msgstr "On the fourth level, twelve billion [good qualities arise]."

msgctxt "88a3e1347f0748aa9893c0800d46a1b8"
msgid "ས་ ལྔ་པ་␣ར་ བྱེ་བ་ སྟོང་ཕྲག་ བཅུ་གཉིས །"
msgstr ""
"On the fifth level, one hundred twenty billion [good qualities arise]."

msgctxt "f3616512129d4294b0360f209802787a"
msgid "ས་ དྲུག་པ་␣ར་ བྱེ་བ་ འབུམ་ཕྲག་ བཅུ་གཉིས །"
msgstr ""
"On the sixth level, twelve hundred thousand billions [good qualities arise]"

msgctxt "72af803628b145b8a0b2021f0559a92d"
msgid "ས་ བདུན་པ་␣ར་ ཁྲག་ཁྲིག་ འབུམ་ཕྲག་ བཅུ་གཉིས །"
msgstr "On the seventh level, twelve quadrillion [good qualities arise]."

msgctxt "ae9a8c10432e4f2986fa7ed2f62db1fa"
msgid "ས་ བརྒྱད་པ་␣ར་ སྟོང་ ཆེན་ འབུམ་ཕྲག་ གཅིག་ གི་ རྡུལ་ གྲངས་ བཅུ་གཉིས །"
msgstr ""
"On the eighth level, twelve particles of one hundred thousand of the great "
"empty."

msgctxt "6e1b5e056b434f84a80d839b4ac59b72"
msgid "ས་ དགུ་པ་␣ར་ སྟོང་ ཆེན་ འབུམ་ཕྲག་ བཅུ་␣འི་ རྡུལ་ གྲངས་ བཅུ་གཉིས །"
msgstr ""
"On the ninth level, twelve particles of ten hundred thousand of the great "
"empty."

msgctxt "70c17fb845a748b0aabeadfb83d12145"
msgid "ས་བཅུ་པ་␣ར་ བརྗོད་ དུ་ མེད་པ་␣འི་ རྡུལ་ གྲངས་ ཀྱི་"
msgstr "On the tenth level, by inexpressible number of particles"

msgctxt "a3876fdb696345d8a4265fb6110f876d"
msgid "སངས་རྒྱས་ ཀྱི་ ཞལ་ ལྟ་བ་␣ས་ སངས་རྒྱས་ ཀྱི་ བྱིན་རླབས་ ཤེས་པ །"
msgstr ""
"By gazing at the faces of the buddhas, one knows the blessings of the "
"buddhas."

msgctxt "5b5bc77e26f246278d2b6281a1008fcb"
msgid "ཞིང་ཁམས་ སུ་ འགྲོ་བ །"
msgstr "[One] goes to the pure fields."

msgctxt "ee19b5709f654c70ae354d31d81a4fcc"
msgid "ཏིང་འཛིན་ ལ་ འཇུག་ ཅིང་ ལྡང་བ །"
msgstr "Entering and arising from meditative concentration,"

msgctxt "b0af57308d31483c843f4ab0e2a70b8a"
msgid "ཞིང་ གཡོ་བ །  ཞིང་ སྣང་བ །  ཆོས་ ཀྱི་ སྒོ་ འབྱེད་པ །"
msgstr ""
"The movement of the field, the appearance of the field, and the opening of "
"the gate of the Dharma."

msgctxt "5c1cff05ddf14b279e5cfd20a1d87fd6"
msgid "སེམས་ཅན་ སྨིན་པ །"
msgstr "The ripened sentient beings,"

msgctxt "5d8a6f3229e54a61bf52bf967ae7cd77"
msgid "དུས་ སྐལ་པ་␣ར་ གནས་པ །"
msgstr "Remain in the time for aeon."

msgctxt "c7846084d5ad447c920c8f0a7bb88ea2"
msgid "སྔོན་ གྱི་་་ གནས་ ལ་ ཡེ་ཤེས་ ཀྱི་ གཟིགས་པ་ འཇུག་པ །"
msgstr "Having a vision of wisdom that penetrates the previous lives."

msgctxt "ec4588de97734eaca26e95acdc6e602d"
msgid "ལུས་ སྟོན་པ །"
msgstr "It shows the body."

msgctxt "8cc725990d044cd8993df776bb7689ee"
msgid "ལུང་ རིག་ འཁོར་ གྱིས་ བསྐོར་བ་ སྟོན་པ །"
msgstr ""
"It shows that a retinue, scriptural authorization, and reasoning surround "
"it."

msgctxt "3cb926825bad4712a2a2504a0fa9f43c"
msgid "མཉམ་བཞག་ ཇེ་ ཆེ་␣ར་ སོང་བ་ ལ་ བརྟེན་ ནས་"
msgstr "In dependence upon increasing the meditative equipoise,"

msgctxt "e19e63be614a47daa00b5d85bda71403"
msgid "ཡོན་ཏན་ ཡང་ ཇེ་ ཆེ་␣ར་ འཕེལ་ ཏེ་"
msgstr "The good qualities also increase greatly."

msgctxt "2d86e39527bc4dfda3c619bb9a6244e8"
msgid "ས་བཅུ་␣འི་ མཐ་␣ར་ ཡོན་ཏན་ བསམ་ མི་ ཁྱབ་པ་ དང་"
msgstr ""
"At the end of the tenth level, the good qualities are inconceivable and"

msgctxt "f52636b6d3d54200baf6d92f3dbaca83"
msgid "སངས་རྒྱས་ ནས་"
msgstr "After enlightenment"

msgctxt "09854a9aae3540a7946108fecfa58a18"
msgid "འཕྲིན་ལས་ ཀྱིས་ སེམས་ཅན་ སྨིན་གྲོལ་ བྱེད་པ་ དང་"
msgstr ""
"Sentient beings are brought to ripening and emancipation by enlightened "
"activities. "

msgctxt "9b218448f2da4c799a7f041c756cc642"
msgid "བཅས་པ་ མཉམ་ གཞག་ ལ་␣ས་ བྱུང་བ་ ཡིན་ ནོ ། །"
msgstr "These arise from meditative equipoise."

msgctxt "3a955c56751b439db023a8e737651aef"
msgid "རྗེ་ ཕག་གྲུ་␣ས །"
msgstr "Lord Phagmo Drupa said:"

msgctxt "431f73f79dd6412da69c63a63daf1789"
msgid "བྱང་ཆུབ་ སེམས་དཔའ་ ས་བཅུ་ དག  །"
msgstr "The bodhisattvas of the tenth level,"

msgctxt "48991b00a18041e8beff0829301f923e"
msgid "སྐྱེ་ མེད་ དུ་ གནས་པ་ ཡོན་ཏན་ ཡིན །"
msgstr "Abiding in the unborn is a good quality."

msgctxt "4d9c9afeed364aec82efa32bf1ec896a"
msgid "ཞེས་ སོ ། །"
msgstr "As said."

msgctxt "cb0bf7b23cb5468c8e146ba91f6040f2"
msgid "དེ་ལྟར་ མིན་ ན་སོ་ སྐྱེ་ འོག་མ་ རྣམས་ ལ་ ཡོན་ཏན་ འབྱུང་བ་ དང་ ༑"
msgstr ""
"If it were not like this, it would be like the good qualities arise in lower"
" individualized beings but"

msgctxt "39bde50e575745c085de5c5991b0562f"
msgid "སངས་རྒྱས་ ལ་ མི་ འབྱུང་བ་␣ར་ རིགས་ ཏེ་"
msgstr "not in buddhas."

msgctxt "68346a574702497592d4531e0af42ea2"
msgid "སོ་སྐྱེ་ རྣམས་ རྗེ་ ཤེས་ ཁོ་ན་ ཡིན་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""

msgctxt "6102f14240ff449e901c8a4801adc0ea"
msgid ""
"སངས་རྒྱས་ དུས་ རྟག་ ཏུ་ མཉམ་པ་␣ར་ མ་ བཞག་པ་ མི་ མངའ་བ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Buddhas never have non-meditative equipoise."

msgctxt "129a0f0c4a834bfe97c87d3c07b3c16f"
msgid "དེ་␣འང་ སངས་རྒྱས་ དང་ ས་བཅུ་པ་␣འི་ བྱང་སེམས་ ཀྱི་ ཡོན་ཏན་"
msgstr "The qualities of the buddhas and the bodhisattvas of the tenth level,"

msgctxt "dd4451140cec4eeba6cc79bac5ea7a7b"
msgid ""
"རྒྱ་མཚོ་ དང་བ་ ལང་ རྨིག་ རྗེས་ ཀྱི་ ཆུ་ ལྟར་ ཁྱད་ ཡོད་པ་␣ར་ གསུངས་པ་␣ས་ བསལ་"
" ལོ་␣༑།"
msgstr ""
"Are like the ocean and the water in a cow’s hoofprint. This statement "
"clearly shows that there is a difference."

msgctxt "706c8e971dc04bc1b8ba449768a7d137"
msgid ""
"རྡོ་␣༽༽  ཆོས་སྐུ་ ཕྱག་རྒྱ་ ཆེན་པོ་ རྟོགས་ ན་ རྒྱུ་མ་ བསྒྲུབས་ ཀྱང་ ཡོན་ཏན་ "
"ཐམས་ཅད་ འབྱུང་ ཟེར །"
msgstr ""
"Vajra: It is said that if you realize the dharmakaya mahamudra, all good "
"qualities will arise even without accomplishing the cause."

msgctxt "3d10aaece08d4d2096fd18ce218892d9"
msgid ""
"འདི་␣ར་ ནི་ རྒྱུ་ ནི་ མ་ བསྒྲུབ་པ་␣ར་ ཡོན་ཏན་ ཐམས་ཅད་ འབྱུང་ མི་ སྲིད་ དེ་"
msgstr ""
"In this [system], Without accomplishing the cause, it is impossible for all "
"good qualities to arise."

msgctxt "6aecdea04ce64058aa1d5f886bf72d36"
msgid ""
"ཚོགས་ གཉིས་ མ་ བསགས་པ་ ལ་␣འང་ ཡོན་ཏན་ འབྱུང་བ་␣ར་ ཐལ་བ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"This is because it absurdly follows that the good qualities would arise even"
" to those who have not gathered the two accumulations."

msgctxt "3ef78f4376e44c1996de808590cc79fe"
msgid "དེ་ལྟར་ ཡང་ དཀོན་མཆོག་ བརྩེགས་པ་ ལ་␣ས །"
msgstr "According to the Heap of Jewels:"

msgctxt "6ab50228ee784629bd222f7716d37207"
msgid "ས་ ནི་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་␣འི ། །"
msgstr "The ground is inconceivable."

msgctxt "4e85a5a8e99e42198a431add74689f46"
msgid "དགེ་བ་␣འི་ ལ་␣ས་ ཀྱི་ རྒྱུ་རྐྱེན་ གྱིས །།"
msgstr "By the cause and condition of virtuous karma,"

msgctxt "d42b3d52013f412d8536f9314b0f36c5"
msgid "རྨོངས་པ་ རབ་ཏུ་ སྤངས་པ་ ཡིིས ། །"
msgstr "Abandon delusion utterly,"

msgctxt "9732d722ea33469eb93e8d6951a52a65"
msgid "འོད་ཟེར་ སྣ་ཚོགས་ འགྲུབ་པ་ ཡིན །"
msgstr "Accomplish various rays of light."

msgctxt "8585b0baec2b4267a5e59c16727ca14c"
msgid "ཅེས་ སོགས་ མཐའ་ཡས་པ་␣ར་ གསུངས་ སོ །"
msgstr "Likewise, there are infinite such statements."

msgctxt "a1a8b2e38e9b4718b0f68bde9eaed8b7"
msgid "མཉམ་བཞག་ ལ་ ཡོན་ཏན་ འབྱུང་བ་ དང་"
msgstr "The arising of good qualities in meditative equipoise and "

msgctxt "e25a700846df4136a2640597dabe258b"
msgid "རྒྱུ་མ་ བསྒྲུབ་པ་␣ར་ མི་ འབྱུང་བ་ གཉིས་ མི་འགལ་བ་␣ར་"
msgstr ""
"Non-arising of it without establishing the cause are not contradictory."

msgctxt "7f7fc5653ef341bf98782f81bb40f03b"
msgid "དེ་␣འི་ ངང་ ལ་␣ས་ ཐ་དད་ མེད་པ་␣ར་ བསྒྲུབ་པ་␣ས་"
msgstr "Thus, through this, it is established that there is no distinction."

msgctxt "83d3fe22e97b4736997c4d2b8810bb02"
msgid "རྗེས་ཤེས་ སུ་ མི་ འགྱུར་ ཏེ །"
msgstr "It will not become a subsequent cognition."

msgctxt "bfb0ee0d79574d928ca66f11caf484ab"
msgid "སྡུད་པ་ ལ་␣ས །"
msgstr "According to the Condensed [Prajnaparamita In Verse]:"

msgctxt "d9180153155242db8c2f9434db76acb7"
msgid ""
"བདག་ ནི་ མཉམ་པ་␣ར་ བཞག་ ཅེས་པ་␣འམ་ ལང་ ཞེས་ རློམ་སེམས་ མེད་ ཅེས་པ་␣ས་ སོ །"
msgstr ""
"Therefore, one should be free of the conceit, “I am in meditative equipoise”"
" or “I am arising.”"

msgctxt "49cc1363ede140bcaa073b421893e503"
msgid ""
"ལྷན་␣༽༽  འགའ་ཞིག་ བྲལ་བ་␣འི་ འབྲས་བུ་␣འི་ ཡོན་ཏན་ ལ་ རྒྱུ་ མི་ དགོས་ ཟེར་ "
"ཡང་"
msgstr ""
"Addendum: Some say that the good qualities of the disconnection results do "
"not need a cause."

msgctxt "05be7d80bdfe474e852ba788e1068fa6"
msgid "འདི་␣ར་ བྲལ་འབྲས་ ཐམས་ཅད་ རྒྱུ་ དང་ བཅས་པ་ ཡིན་ ཏེ །"
msgstr ""
"In this [system], all the disconnection results are associated with its "
"causes."

msgctxt "7c3a41dbe8774006a8ef6d8aefc1d14d"
msgid "རྒྱུ་ མེད་པ་␣འི་ འབྲས་བུ་ གཤིས་ ལ་ མི་ སྲིད་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "This is because results without causes are naturally impossible."

msgctxt "d1137d3ce29d4689b98cd86f109187b7"
msgid "དེ་ལྟར་ ཡང་ །"
msgstr "That as well."

msgctxt "4bf668f4371e44039460453a156871ef"
msgid "བུ་མོ་ རིན་ཆེན་ གྱིས་ ཞུས་པ་␣འི་ མདོ་␣ར །"
msgstr "According to the Sutra of Requisition by Daughter Ratna:"

msgctxt "cb144b649eff4ee799d562ea66675b4b"
msgid "བུ་མོ་ བྱང་ཆུབ་ སེམས་དཔ་␣འི་ སྤྱད་པ་ སྤྱོད་པ་ ན་"
msgstr "Girl! When you practiced bodhisattva conduct,"

msgctxt "9c33a8450b8a40c5bbe422aca417c363"
msgid "ཐེག་པ་ དམན་པ་ འདི་ ནི་ གནས་མིན །"
msgstr "This Lesser Vehicle is not the place."

msgctxt "9e56ae3fc86346cbad62db0691d3bac4"
msgid "སྐབས་མེད་ བསྟན་པ་␣འི་ སྟོབས་ དང་ ལྡན་པ་"
msgstr "Possessing the power of teaching on no occasion,"

msgctxt "dabe45d10e004dda9b869380b37308cf"
msgid ""
"སངས་རྒྱས་པ་␣འི་ དུས་ ན་ གནས་ དང་ གནས་མིན་ མཁྱེན་པ་␣འི་ སྟོབས་ ཐོབ་པ་␣ར་ "
"འགྱུར་ རོ །"
msgstr ""
"During the enlightenment, the primordial wisdom of knowing [what is] "
"appropriate and [what is] inappropriate will be attained."

msgctxt "5cf1b5a877634a0c9d19fba161247314"
msgid "ཞེས་ སོགས་ གསུངས་ སོ །"
msgstr "It is said so forth."

msgctxt "d0a75d1380e64175a43254795784b125"
msgid "རྡོ་␣༽༽  ཆོས་ ཐམས་ཅད་ རང་སེམས་ ལས་མི་ གཞན་པ་␣ས་"
msgstr ""
"Vajra: It is said that all phenomena are not other than one's own mind "
"because"

msgctxt "7053d840f2be45b387d080972df28097"
msgid "དེ་␣འི་ ཆོས་ཉིད་ ལམ་ གྱིས་ རྟོགས་ ན་"
msgstr "If the path realizes the true nature of phenomena,"

msgctxt "9550becca0444c0aaba8a1a8aa9483a8"
msgid ""
"དགེ་ མི་དགེ་ ལས་འབྲས་ སོགས་ སྣ་ཚོགས་པ་␣འི་ སྣང་བ་ ཐམས་ཅད་ སྣང་མེད་ སྟོང་ཉིད་"
" དུ་ རྟོགས་ ཏེ །"
msgstr ""
"By realizing all the various appearances of virtuous and non-virtuous karma "
"and its effects as non-appearing emptiness,"

msgctxt "2f85209faaa84715966e128628d9fe8f"
msgid "རྒྱུ་འབྲས་ ཀྱི་ རྟེན་འབྲེལ་ མེད་པ་ ནམ་མཁའ་ བཞིན་ ནོ་ ཟེར་ རོ །"
msgstr ""
"The absence of an interdependent relationship between cause and result is "
"like space."

msgctxt "28118400bc3047d7afeb2dd9c41f1eec"
msgid "འདི་␣ར་ ནི་ སྟོང་ཉིད་ རྟོགས་པ་␣འི་ ཚེ་ ན་"
msgstr "In this [system], When emptiness is realized,"

msgctxt "7473ee623a7a49dc82329138f6730022"
msgid "དེ་ དང་ དབྱེ་␣ར་ མེད་པ་␣ར་ རྒྱུ་འབྲས་ ཀྱི་ རྟེན་འབྲེལ་ ཉིད་"
msgstr ""
"The interdependent relationship of cause and effect is inseparable from it,"

msgctxt "cd5a08ac73b4499096e7911f75b3d580"
msgid "སྒྱུ་མ་␣འི་ སྣང་བ་ བཞིན་ འགོག་␣ས་པ་ མེད་པ་␣ར་ འབྱུང་བ་␣ས་"
msgstr ""
"It ceases and becomes non-existence like the appearances in an illusion."

msgctxt "cb375418ec37455a928236297ebf8367"
msgid "སྟོང་ཉིད་ ཀྱིས་ རྒྱུ་འབྲས་ མི་ ཁེགས་ ཏེ །"
msgstr "Emptiness does not negate cause and effect."

msgctxt "cd49b9b934f7474e9181293326d41938"
msgid "དཔེར་ན་ ནམ་མཁའ་ ལ་␣ས་ བྱུང་བ་␣འི་ འཇའ་ཚོན་"
msgstr "For example, a rainbow that occurs in the sky,"

msgctxt "7bd9ad70e21345c0b27d9774a3688030"
msgid "ནམ་མཁའ་ དེ་ དང་ དབྱེ་␣ར་ མེད་ དུ་ འཆར་བ་␣འི་ ཚེ་"
msgstr "When it appears indivisibly with that sky,"

msgctxt "ea5357fdaaa6485db1ff7ff1438aedbb"
msgid "ནམ་མཁ་␣ས་ འཇའ་ཚོན་ མི་ ཁེགས་པ་ བཞིན་ ནོ ། །"
msgstr "Likewise, the sky cannot block the rainbow."

msgctxt "97b312da83a84b74a9c521da6f094760"
msgid "དེ་ལྟར་ ཡང་ ཏིང་འཛིན་ རྒྱལ་པོ་ ལ་␣ས །"
msgstr ""
"That as well, according to The King of Meditative Concentration [Sutra]:"

msgctxt "fe6e67570f614c62abaabe328e099472"
msgid "ཆོས་ཉིད་ ལ་␣ས་ ཀྱི་ རྣམ་སྨིན་ མེད་ ཤེས་ ཀྱང་ །"
msgstr ""
"Even knowing the absence of the complete ripening of karma of the true "
"nature of phenomena,"

msgctxt "f1540819a2754a4d9d622e93d1bed384"
msgid "དགེ་ དང་ མི་དགེ་␣འི་ ལ་␣ས་ ནི་ ཆུད་ མི་ ཟ ། །"
msgstr "The results of virtue and non-virtue do not go to waste,"

msgctxt "cd5d216615f34d559df21c937d054b03"
msgid "ཞི་བ་␣ར་ གནས་པ་ རང་རྒྱལ་ ཐེག་པ་ དེ །"
msgstr "The pratyekabuddha vehicle that abides in peace."

msgctxt "0011ed6122c745278a56134172efb25b"
msgid "ཉན་ཐོས་ རྣམ་པ་␣ར་ གྲོལ་བ་␣འི་ སྒྲ་ ཕྱིར་ འབྲང༌ ། །"
msgstr "Follow the path of liberation like the Hearers."

msgctxt "f8792914d005456fa2496ad569e50bcb"
msgid "ལྗོན་པ་␣ས་ ཞུས་པ་␣འི་ མདོ་ ལ་␣ས །"
msgstr "According to the Sutra of Requisition by Jonpa:"

msgctxt "c911ccc290764f0f95b48ce43eb22bc1"
msgid "རྒྱུ་ལ་ བརྟེན་པ་␣འི་ མཁས་པ་ བཅོམ་ལྡན་འདས ། །"
msgstr "The Blessed One, you are skilled in relying on causes,"

msgctxt "cb977e8bee7b48f790adf1b0d608f3e0"
msgid "མཐའ་ གཉིས་ ལྟ་བ་ རྟག་ ཏུ་ མི་ མངའ་བ །"
msgstr "Never possessing the views of the two extremes,"

msgctxt "ca8420bd9f254beba549cef0bc8692b6"
msgid "ལ་␣ས་ ཀྱི་ རྣམ་སྨིན་ འབྲས་བུ་ ཁོ་ན་ གསུངས ། །"
msgstr "[You] taught exclusively the complete ripening of karma,"

msgctxt "49b423d5115f40d19e778e4033453c81"
msgid "ལྟ་བ་␣འི་ མུན་ བྲལ་ ཁྱེད་ ལ་ ཕྱག་ འཚལ་ ལོ ། །"
msgstr "Homage to you! You are free from the darkness of views."

msgctxt "167e2a7670544f0eb5ad80b3b2cb9e55"
msgid "ཞེས་ སོ ། །"
msgstr "As said."

msgctxt "053862b2b5fb47bd9ea061ceae0ede52"
msgid "རྗེ་བཙུན་ གྱིས་ སྒམ་པོ་པ་ ལ་ འགྲོ་ ཆོས་ སུ་ གསུངས་པ །"
msgstr "Jetsun said to Gampopa, the dharma for beings."

msgctxt "9c3d82d7bbd24000a6b0efb8ee294f0e"
msgid "ཡར་ སངས་རྒྱས་ ལ་ རེ་བ་ མེད་ ཀྱང་"
msgstr "Even if there is no hope of attaining high enlightenment,"

msgctxt "f69ceda34a7f4d7db767ce1152441ca6"
