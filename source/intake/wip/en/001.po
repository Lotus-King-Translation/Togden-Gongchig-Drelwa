msgctxt "8c3a655c5e364ea9a3b18f66e5cba0a3"
msgid "སྡུག་བསྔལ་ ལྷན་སྐྱེས་ སུ་ འཆར །"
msgstr "Suffering will appear as co-emergence."

msgctxt "1a4886fdcc4e445e95768671031e582c"
msgid "དེ་ མ་ ཤར་ ན་"
