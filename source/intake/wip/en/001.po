msgctxt "4e717f5da6fd452f95c5e6e807721b61"
msgid "སྐད་ཅིག་ གསུམ་པ་ གང་ སྐྱེས་པ །"
msgstr "Whatever arises in the third moment."

msgctxt "a57a26751c22464ca556e6464a9aa697"
msgid "དོན་ མཐོང་ མ་ ཡིན་ འབྲས་ ཅན་ གྱིས ། །"
msgstr "Those who have the result do not see the meaning."

msgctxt "bea11124ba82497f8d7f68cace93a95d"
msgid "སྦགས་པ་ ཡིས་ ནི་ བུ་རམ་ བཞིན །"
msgstr "It is soiled like molasses."

msgctxt "00f82a54247d40fea922a8960d7a62c7"
msgid "ཞེས་ དེ་ལྟར་ དཔེ་ དོན་ ལ་␣ས་ རེ་རེ་ འདོད་ ཅིང༌ །"
msgstr "Thus, each of the examples and their meanings are accepted."

msgctxt "29497f4e9946480d9551e70f22433386"
msgid "ཟག་བཅས་ ཀྱི་ བདེ་བ་ ཡིན་པ་␣ས་"
msgstr "Since it is bliss with outflows."

msgctxt "aca9999a318e4dd5906d6eb7bbe47b17"
msgid "རྩ་ལྟུང་ ལྔ་པ་␣ས་ མི་ གོས་པ་␣ར་ འཇུག་ དགོས་ ཟེར་ རོ ། །"
msgstr ""
"It is said that one must engage without being stained by the fifth root "
"downfall."

msgctxt "3b72db14fd9a43d096c7473d50bdda9d"
msgid ""
"འདི་␣ར་ ནི་ དུས་ སམ་ སྐབས་ དེ་ བཞི་␣ར་ རྩ་བ་␣འི་ དམ་ཚིག་ གནང་བ་␣འི་ "
"སྐབས་མེད་ དེ །"
msgstr ""
"In this [system], there is no occasion to permit the root pledges during "
"these four occasions or times."

msgctxt "2fabe7e43f26438f8cba8044917b65e2"
msgid "དེ་␣འི་ རྒྱུ་མཚན་ བྲམ་ཟེ་ ཆེན་པོ་␣ས །"
msgstr "The reason for this is stated by the Great Brahman:"

msgctxt "31337af62f674aa1bf9fa2f06ab7b389"
msgid "ཁ་སང་ ཕན་ཆད་ དགེ་སློང་ མིན ། །"
msgstr "[I] was not a monk until yesterday."

msgctxt "188b5819f4024466a69103f529b72aee"
msgid "དེ་རིང་ ཚུན་ཆད་ དགེ་སློང་ ཡིན ། །"
msgstr "From today on, I am a monk."

msgctxt "c41caec8be54444294fb1b0772d2a77d"
msgid "ཅེས་པ་ ལྟར་"
