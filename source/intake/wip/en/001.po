"བཟུང་ མཐ་␣ར་ སྐྱོན་བྲལ་ ཡོན་ཏན་ རྫོགས་པ་␣འི་ སངས་རྒྱས་ ཐོབ་པ་ མན་ཆད་ "
"ཡང་དག་པ་␣འི་ ཤེས་པ་␣ས་ འགྲུབ་ སྟེ །"
msgstr ""
"Up to the attainment of buddhahood free of all flaws and possessing all good"
" qualities are accomplished by genuine cognition. "

msgctxt "4b21923c57dd4b1a93dfe45884f18231"
msgid ""
"སྟོབས་ བཅུ་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ དེ་ཡང་ དག་ གི་ ཤེས་པ་ ཡིན་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"The primordial wisdom that knows the ten strengths is genuine cognition. "

msgctxt "808c727ad2414be9a8252c0af21dbcd8"
msgid "རྡོ་␣༽༽  ལ་ལ་ དག་ གིས་"
msgstr "Vajra: some said,"

msgctxt "d2dc4075b8014c7bb79df5aac98a9d22"
msgid "རྟོག་གེ་ ཚད་མ་ ནི་ གྲུབ་མཐའ་ དན་པ་ སུན་ འབྱིན་ བྱེད་"
msgstr ""

msgctxt "31a28b77517c4f998ebd7e228b10ac1c"
msgid "ལས་འབྲས་ བུ་ མེད་ དེ་ རྗེ་བོ་␣ས །"
msgstr "There is no karma and result because the Jowo says:"

msgctxt "512ef7fae431423d9dd3b40b670df40a"
msgid "མངོན་སུམ་ རྗེས་དཔག་ དགོས་པ་ མེད་ ༑"
msgstr "\"Direct perception and inference have no purpose,"

msgctxt "e3f041777eef4a72b2ce9c97ef0786bb"
msgid "མུ་སྟེགས་ རྒོལ་བ་ བཟློག་པ་␣འི་ ཕྱིར །"
msgstr "In order to refute the arguments of the tirthikas,"

msgctxt "21444adf50d24c6ba02cec170a9708c5"
msgid "མཁས་པ་ རྣམས་ ཀྱིས་ བྱས་པ་ ཡིན །"
msgstr "It is made by the learned ones.\""

msgctxt "2cc8b38f35184259ba63dc097ca7622c"
msgid "ཞེས་ འགའ་ཞིག་ ཟེར་ རོ ། །"
msgstr "As said by some [people]."

msgctxt "1db44ab12b284e7eafbabb9b1be57f07"
msgid "འདི་␣ར་ ནི་ ཚད་མ་␣འི་ འབྲས་བུ་ ཟབ་མོ་ སྟོང་པ་ཉིད་ སྟོན་ ཏེ་"
msgstr ""
"In this [system], the profound emptiness is taught as the result of valid "
"cognition."

msgctxt "9515bc662646472885b61fd6226f5044"
msgid "དེ་␣འང་ ཚད་མ་ ལ་ གཞལ་བྱ་ ཡུལ །"
msgstr ""
"Moreover, valid cognition includes three methods, an object of evaluation,"

msgctxt "c207a2a7923d440497fdf368b493698e"
msgid "འཇལ་བྱེད་ བློ །"
msgstr "an evaluator rational mind,"

msgctxt "b16bb13c0e0b4664aa425db214c44a33"
msgid "དེ་ རྟོགས་ བྱེད་ཐབས་ གསུམ་ དུ་ འདུ་ ཞིང་"
msgstr "and a realizer of it."

msgctxt "2354adc67b7c40bdb7f78721a3a86852"
msgid "ཡུལ་ དང་ ངོ་བོ་␣འི་ སྒོ་ ནས་ དངོས་ དང་ དངོས་མེད །"
msgstr "In terms of object and essence, there are three: thing and non-thing,"

msgctxt "da6159f11f374516ac0c861b3d4e0d59"
msgid "འདུ་ བྱས་ འདུ་ མ་ བྱས །"
msgstr "Compounded and uncompounded,"

msgctxt "e9c3121eab0441b7951a8298227fd10e"
msgid "ལྐོག་གྱུར་ ཤིན་ཏུ་ ལྐོག་གྱུར་ གསུམ་"
msgstr "Hidden and most hidden."

msgctxt "e2bae93d567a4886b0bf9ea89e2cfacc"
msgid "འཇལ་བྱེད་ བློ་རིག་ ཤེས་ གསུམ་ དོན་ གཅིག་ ཅིང་"
msgstr ""
"The evaluators such as the rational mind, rigpa, and consciousness are "
"synonymous."

msgctxt "03b6e43127c44787aafd3e63785d2b78"
msgid "དེ་␣འང་ མངོན་ གསུམ་ རྗེས་དཔག་ གཉིས །"
msgstr ""
"Moreover, there are two [types of evaluators]: direct perception and "
"inference."

msgctxt "e0bdcef4e1e14591b7167656b66b6a1e"
msgid "མངོན་སུམ་ ལ་ དབང་ ཡིད་ རང་རིག་ རྣལ་འབྱོར་ མངོན་སུམ །"
msgstr ""
"Direct perception includes sense, mental, self-knowing, and yogic [direct "
"perceptions]."

msgctxt "15f59d68bb7a4a12b1ea15e57845a905"
msgid "རྗེས་དཔག་ ལ །  དངོས་ སྟོབས་ གྲགས་པ་ ཡིད་ ཆོས་ གསུམ་"
msgstr ""
"There are three inferences: inference by the power of fact, inference which "
"is renowned, and inference by trust."

msgctxt "7992bae4af7843958d66919f621cf3af"
msgid ""
"རྟོགས་ བྱེད་ འགལ་ འགྲེལ་ དགག་སྒྲུབ་ སྤྱི་བྱེ་ བྲག་ གཅིག་ ཐ་དད་ སེལ་འཇུག  །"
msgstr ""
"Realizer, contradiction-relation, negation-assertion, generality-particular,"
" singularity-plurality, eliminative engagement-"

msgctxt "756c037c173245bca15b4c68e08c53f2"
msgid ""
"སྒྲུབ་འཇུག་ གཞན་སེལ །  མཚན་ མཚོན །  རྫས་ ལྡོག  ། རྗེས་དཔག་ གཉིས་ དང་ བཅས་པ་ "
"ནི་ ཚད་མ་␣འི་ བརྗོད་བྱ་ སྟེ །"
msgstr ""
"assertive engagement, other-elimination, definition and definiendum, "
"substance and isolation, and two inferences, are the subject matter of the "
"valid cognition. "

msgctxt "63c6db260d7948d0950a2128cc9bfe17"
msgid "རང་དོན་ རྗེས་དཔག་ ཚུལ་ གསུམ་ ཚང་བ་␣འི་ རྟགས་ ཏེ །"
msgstr ""
"The inference for oneself that completes the three modes of a [correct] "
"reason:"

msgctxt "66ec01fd9ed74ce2be597f7209c3fde5"
msgid "བདེན་པ་␣ར་ འཛིན་པ་␣འི་ དངོས་པོ་ ཆོས་ཅན །"
msgstr "Take the subject, things apprehending as true."

msgctxt "38fe4eb521ec4a1a9453b64874217375"
msgid "བདེན་པ་␣འི་ སྐྱེ་བ་ མེད་ དེ །"
msgstr "It is the absence of the true arising."

msgctxt "36033fa4cc7c40d4b75f989a5d1be3b9"
msgid "གཅིག་ དང་ དུ་མ་ ཕྲལ་བ་␣འི་ ཕྱིར །"
msgstr "Because it is parted from singularity and plurality. "

msgctxt "3165c5f5d66448ae9aea9c07c5acf85a"
msgid "དཔེར་ན་ གཟུགས་བརྙན་ བཞིན །"
msgstr "For example, an image reflection."

msgctxt "1b60066afe044db4805e35ff600631ab"
msgid ""
"ཞེས་པ་␣ས་ རང་བཞིན་ མ་གྲུབ་པ་␣འི་ གནས་ཚུལ་ སྟོང་ཉིད་ སྟོན་པ་ ཡིན་ ནོ ། །"
msgstr ""
"This shows emptiness, the circumstance of having no existing nature [of "
"their own]."

msgctxt "02d2e41b26c24b3cb2b64a28fa3942dc"
msgid "དེ་སྐད་ དུའང་ རྣམ་འགྲེལ་ ལ་␣ས །"
msgstr "As said in the Full Commentary to [the Compendium of Pramana],"

msgctxt "5177ad9c7a694fb487e5aa42a29f6a5e"
msgid "གང་ གི་ དངོས་པོ་ རྣམ་དག་ ན །"
msgstr "If the things are analyzed with whichever [reasonings],"

msgctxt "ed981e46ac8e4fa4945625ce9f2c8323"
msgid "དེ་ཉིད་ དུ་ ནི་ དེ་ དངོས་མེད །"
msgstr "Its suchness is the absence of the [true] things,"

msgctxt "040acc51d31446e8bd4e0bd09df411a8"
msgid "གང་ གི་ ཕྱིར་ ན་ དེ་དག་ ལ ། །"
msgstr "Why is it that way? Because they are,"

msgctxt "60198c0695ca41908d280c56bcad8797"
msgid "གཅིག་ དང་ དུ་མ་␣འི་ རང་བཞིན་ མེད །"
msgstr "Lacking the [true] nature of singularity and plurality."

msgctxt "cdf53b0cd1b04427bcc28b831f3460e2"
msgid "ཅེས་ དང་ །"
msgstr "And."

msgctxt "27f76522c98345d19da0f5d3485d9dec"
msgid "རྟོག་པ་␣འི་ དྲྭ་བ་ རྣམ་ བསལ་ ཅིང༌ ། །"
msgstr "Eliminating the webs of conceptualities,"

msgctxt "2e62e6052f2e450aa95db73654e6ccd4"
msgid "ཟབ་ ཅིང་ རྒྱ་ ཆེ་␣འི་ སྐུ་ མངའ་བ ། །"
msgstr "Possessing a profound and vast body"

msgctxt "07d627db42f44b95896822b6a2a82f7f"
msgid "ཀུན་ ཏུ་ བཟང་པོ་␣འི་ འོད་ཟེར་ དག  །"
msgstr "The pure light rays of Samantabhadra,"

msgctxt "bca5ac6e1c95433a8a9ca111931d0149"
msgid "ཀུན་ ནས་ འཕྲོ་ ལ་ ཕྱག་ འཚལ་ ལོ་␣༑ །"
msgstr "Radiate to all, homage [to him]."

msgctxt "02858f9c30234c368d07f52be2885984"
msgid "ཞེས་པ་␣ས །"
msgstr "As said."

msgctxt "2e881feaf7234bacb01894fe12336d39"
msgid "ཚད་མ་ ལ་ འབྲས་བུ་ ཡོད་པ་ གྲུབ་ སྟེ་ །"
msgstr "It is established that valid cognition does have results."

msgctxt "ed684f43dcf44e8fbb4b78e181221dae"
msgid ""
"རྣལ་འབྱོར་ མངོན་སུམ་ དེ་ མཐོང་ ལ་␣ས་ གྱི་ བདེན་པ་ ཡིན་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"Because the yogic direct perception is the truth of the path of seeing."

msgctxt "7fec14daf3ec430ab32137a3f17ebf56"
msgid "རྡོ་␣༽༽  སྤྱིར་ སེམས་ཅན་ ཐ་མལ་པ་ དང་ གྲུབ་མཐ་␣ས་ བློ་བསྒྱུར་བ་ གཉིས །"
msgstr ""
"Vajra: In general, there are two [types of people]:  common sentient beings "
"and those whose minds are modified by tenets."

msgctxt "59b019b5b4aa41029e88a38297681251"
msgid "ཕྱི་མ་␣ར་ ཕྱི་རོལ་པ་␣འི་ ལྟ་བ་ བསྡུ་ ན་ རྟག་ཆད་ གཉིས །"
msgstr ""
"The latter has two by including permanent and nihilist views of non-"
"Buddhists."

msgctxt "1ee1f167db9f4d94b60a6afd5e16d16e"
msgid "ནང་པ་␣ར་ ཐེག་དམན་ དོན་ སྨྲ་ སྡེ་གཉིས །"
msgstr ""
"In Buddhists, the two schools of the Lesser Vehicle advocate external "
"objects."

msgctxt "a8f9fe1f5c3541658d462e55bc104169"
msgid "ཐེག་ཆེན་ སེམས་ ཙམ་ དབུ་མ་ གཉིས་ ལ་␣ས་"
msgstr "The Mind Only and Middle Way [schools] of the Great Vehicle."

msgctxt "ae15d023dc26472f80e26ed3b083e3a4"
msgid "ཕྱི་རོལ་པ་␣འི་ གྲུབ་མཐའ་ དེ་དག་ རྒྱ་གར་ ན་ ཡོད་ བོད་ ལ་ མེད་ ཟེར །"
msgstr ""
"Some said that those of the tenets of non-Buddhists are in India and not in "
"Tibet."

msgctxt "99ec5c61aa394819a5548f36e459a81a"
msgid "འདི་␣ར་ ཇི་སྲིད་ གྲུབ་མཐའ་ ཁ་ བཟང་ངན་ གྱི་ འཛིན་ ཡོད་པ་"
msgstr ""
"In this [system], as long as there is a grasping of the good and bad sides "
"of tenets,"

msgctxt "1b92eac8e2134e1caade83d1234c9a53"
msgid "དེ་སྲིད་ དུ་ ལྟ་ངན་ དེ་ ཐམས་ཅད་ རང་རྒྱུད་ དུ་ཡོད་པ་ ཡིན་ ཏེ་"
msgstr "until then, all of these bad views exist within one's own continuum."

msgctxt "cdaaacd7cc1b45c8b1c5ab25af8d1697"
msgid "ང་ ནི་ ཕ་ འདི་␣འི་ བུ་ ཡིན་ ཞེས་ གྲུབ་ གྲུབ་ ཏུ་ འཛིན་པ་"
msgstr "I am the son of this father, grasping as already existing."

msgctxt "0363406e6b35449a9f8c0d8640bfff6e"
msgid ""
"རྟག་ལྟ་ རྒྱུ་འབྲས་ ཀྱི་ སྐྱོན་ཡོན་ དགེ་སློང་ ནག་པོ་ ལ་ བྱ་རོག་ ཞར་ མ་ བཞིན་ "
"ནོ ། །"
msgstr ""
"The permanent view, the faults and good qualities of the cause and effect, "
"to Bhikshu Kala is like a blind crow."

msgctxt "64563353b41145aaa0d304ba1efae419"
msgid ""
"བྱས་པ་␣ས་ བྱ་རོག་ ཞར་ མ་␣འི་ སྐྱེ་བ་ ལྔ་ བརྒྱ་ ལེན་པ་␣ར་ གསུངས་པ་ དང༌ །"
msgstr ""
"It is said that if one does this, [they] would born as blind crows for five "
"hundred lifetimes."

msgctxt "c5ac6da8b662470bb380038948f3cd02"
msgid ""
"སངས་རྒྱས་ ཀྱི་ མཚན་ དང་ ཆོས་ ཐོས་པ་ ཙམ་ གྱི་ ཡོན་ཏན་ དཔག་མེད་ འབྱུང་བ་␣ར་ "
"གསུངས་པ་ རྣམས་ ལ་"
msgstr ""
"It is said that unfathomable good qualities would arise by merely hearing "
"the names of Buddha and the Dharma, to all these statements"

msgctxt "94765f2847ab423681441465600dee7c"
msgid "དེ་ཙམ་ ཅི་ ཡིན་ སྙམ་ ནས །"
msgstr "Just by thinking, what is that? "

msgctxt "926bf80c206949cba3d8c0a5e0fae3d0"
msgid "ཡིད་ མི་ ཆེས་པ་ ཆད་ལྟ་ ཡིན་པ་␣ས་ མུ་སྟེགས་ བྱེད་ རང་ཉིད་ ཡིན །"
msgstr "Oneself is tirthikas because not believing is a nihilist view."

msgctxt "1d424fc4c32b44bdbd419309ba6f961b"
msgid ""
"གཉིས་པ་ ཉན་ཐོས་ ནས་ མ་བུ་ ཆེན་པོ་␣འི་ བར་ གྱི་ གྲུབ་མཐ་␣ར་ དེ་ འཛིན་ གྱི་ "
"བར་"
msgstr "Second, holding from shravaka to the great mother-son tenet,"

msgctxt "89ac85a35b0d4494b48af7ba4cd1616d"
msgid "ཡང་དག་ དོན་ ལ་ རྨོངས་པ་ ནང་ གི་ མུ་སྟེགས་ ཡིན་ ཏེ །"
msgstr "Insider tirthikas are those who are unaware of true reality."

msgctxt "c7f8969079ea41dd8ac0ad1101d22017"
msgid "དགེ་བ་␣འི་ རྩ་བ་ འཛིན་པ་␣འི་ མདོ་␣ར །"
msgstr "According to the Upholding the Roots of Virtue Sutra:"

msgctxt "091ae9e492e24c21bc952cd1187f31e9"
msgid ""
"བསྐལ་པ་ བྱེ་བ་ ཚུལ་ཁྲིམས་ བསྲུངས་ བྱས་ ཤིང་ ཡུན་རིང་ སོཊ ། རྩད་ ནག་པ་␣ས །"
msgstr ""

msgctxt "d76bf8970b7a47c5ad47d10d9fac6d4f"
msgid "མཆོག་ ལ་ སྐྱབས་ སོང་ འགྲོ་ ལ་ ཕན་ བརྩོན་ ཡང༌ །"
msgstr ""
"Go for refuge in the Excellences and pursue diligently for the benefit of "
"migrators."

msgctxt "cc9b8d66c9ae44c88fb32a7be8e169a4"
msgid "གང་ཟག་ རྡུལ་ དང་ སྐད་ཅིག་ རྫས་ སྨྲ་ དང༌ །"
msgstr "Proposing persons as particles and moments as substances."

msgctxt "74bd11ead0244026b31a979a391428db"
msgid "འཇིག་ དང་ སྟོང་ དང་ དོན་དམ་ མཚན་མ་␣ར་ བཀྲ་ ། །"
msgstr "Disintegration, empty, and absolute are cleared with signs."

msgctxt "20067c8af618405fb5375c2a4d1c682b"
msgid "ཡང་དག་ དོན་ ལ་ གང་ གི་ མུ་སྟེགས་ ཡིན །"
msgstr "Regarding the true reality, Who is a tirthika?"

msgctxt "0deabe59e6bb4b428117ee16155db0c8"
msgid "ཅེས་ སོ །"
msgstr "As said."

msgctxt "1f07441ce6d047eb995a473d66d6ae43"
msgid ""
"རྡོ་␣༽༽  ལོག་ལམ་ མུ་སྟེགས་པ་␣འི་ ལྟ་སྤྱོད་ སྒྲུབ་པ་ ཐམས་ཅད་ སྤང་བྱ་ འབའ་ཞིག་"
" ཡིན་ ཏེ་"
msgstr ""
"Vajra: All the accomplishments of wrong paths, views, and conduct of the "
"tirthikas are only to be abandoned."

msgctxt "42e51cfac29a40c29d5e3892e5604d07"
msgid "ལོག་པ་␣འི་ ལམ་ ལ་ བསྒྲུབ་བྱ་ མེད་པ་␣འི་ ཕྱིར་ རོ་ ཞེས་ ཟེར་ མོད །"
msgstr ""
"Some [people] said that there is nothing to be accomplished in the wrong "
"path."

msgctxt "401f40c2feba4fd59c024e38f5c553d5"
msgid ""
"འདི་␣ར་ ནི་ མུ་སྟེགས་པ་ ལ་␣འང་ གཤིས་ ཀྱི་ དགེ་བ་␣འི་ བསྒྲུབ་བྱ་ མང་ ཏེ་"
msgstr ""
"In this [system], The followers of tirthika also possess many natural "
"virtues to be accomplished."

msgctxt "f11874ad977044d7a8fe55f64938751b"
msgid "དེ་དག་ ལ་ སྙིང་རྗེ་ ཡོད་ ལ་␣ས་"
msgstr "They have compassion and "

msgctxt "f41f9f88a5234b649ea9144eaf1653f8"
msgid ""
"སྲོག་གཅོད་ སོགས་ མི་དགེ་བ་ བཅུ་ ལ་␣ས་ དགུ་ དངོས་ སུ་ སྤོང་བ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"From the ten non-virtues such as killing, they abandon nine explicitly."

msgctxt "9d0e34b1946d475385ac76be1db6c500"
msgid "དབྱར་ ག་ ནས་ གསོ་སྦྱོང་ དགག་དབྱེ་ རྣམས་ དང་པོ་␣ས་ སོ ། །"
msgstr ""
"The first is the summertime [ceremonies] of healing and purification, "
"releasing the restrictions, and so forth."

msgctxt "75e0c37c65c14616b5b4b829601cf271"
msgid "ནང་པ་ ལ་ མེད་པ་␣ས་ སངས་རྒྱས་ ཀྱིས་ དགེ་སློང་ དག་"
msgstr "These were not in Buddhists, the Buddha said, \"Monks,"

msgctxt "ebf52889a57e4cb19ed74da21ddf2caa"
msgid "མུ་སྟེགས་ ཀྱི་ འཕྱ་བ་ ནི་ ཐོག་ ཏུ་ འབབ་པ་ ཡིན་པ་␣ས་"
msgstr "Since the criticism of tirthikas will fall on [you]."

msgctxt "cf27b069184a46178c46757f6336121c"
msgid "ཕྱིན་ཆད་ འདི་ རྣམས་ བྱ་␣འོ ། །"
msgstr "Henceforth, these must be practiced.\""

msgctxt "50b4bdd29ba54be699883053b4626895"
msgid "གསུངས་ ཏེ་ བཅས་པ་ མཛད་པ་ དེ་ སྒྲུབ་ དགོས་པ་␣འི་ ཕྱིར་"
msgstr "The speech that was made in association with it must be accomplished."

msgctxt "16da805baed7441a97083fa734e97ecd"
msgid ""
"གཤིས་ ཀྱི་ དགེ་བ་ ལེགས་པ་ ཞིག་ མུ་སྟེགས་ སམ་ དུད་འགྲོ་␣འི་ རྒྱུད་ ལ་ ཡོད་ "
"ཀྱང་ ལེན་ དགོས་ ཏེ་ ༑"
msgstr ""
"Any good natural virtue that a tirthika or animal may have must be accepted."

msgctxt "1f0eb3313f6a40f3bfe493a30054159c"
msgid "མཐའ་ ཡས་ ཡོན་ཏན་ དཔག་མེད་ ཀྱང་ ། །"
msgstr "Though the infinite good qualities are unfathomable,"

msgctxt "05a364d60636493882f923b3f0e7651a"
msgid "གཞན་ གྱི་ ཡོན་ཏན་ ཆུང་ངུ་ ལེན ། །"
msgstr " Even the smallest good quality of others should be accepted."

msgctxt "e4720cdce6a6468bb5bee3b124ce3b24"
msgid "དེ་ལྟར་ ཡུན་ དུ་ སྤྱད་པ་ ཡིས ། །"
msgstr "Following such a conduct for a long time,"

msgctxt "67d352df82034152a81d8c532797afcb"
msgid "མྱུར་ དུ་ ཐམས་ཅད་ མཁྱེན་པ་␣ར་ འགྲོ ། །"
msgstr "[One] will swiftly go to the [level of] omniscience."

msgctxt "0cbd3c2652b140daabcc7745f0c7a7b6"
msgid ""
"གཤིས་ ཀྱི་ ཉེས་པ་ ཞིག་ མཐོ་བ་ བླ་མ་␣འི་ ཐུགས་རྒྱུད་ དུ་ཡོད་ ཀྱང་ དོར་ དགོས་ "
"ཏེ །"
msgstr ""
"Seeing a natural fault, even if it is in the guru's mental continuum, is to "
"be abandoned."

msgctxt "6352ccee8bf7417ba7ecd2e41f3e8fb0"
msgid "ཏཱ་ལ་␣འི་ རྒྱུད་ ལ་␣ས །"
msgstr "According to the Tantra of Tala:"

msgctxt "79abf61dca7349e19f418d2361ff6e5e"
msgid "དགེ་སློང་ དག་ གམ་ མཁས་ རྣམས་ ཀྱིས ། །"
msgstr "Monks and the learned ones,"

msgctxt "b4ac2024dc114bba8750b926a0843e9f"
msgid "སྲེག་ བཅད་བརྡར་བ་␣འི་ གསེར་ བཞིན་ དུ །"
msgstr "Like gold is [tested] by burning, cutting, and rubbing, "

msgctxt "59e2f8d9b5c94e20b2dc338e04b10de4"
msgid "ལེགས་པ་␣ར་"
msgstr "[Likewise, examine my words] thoroughly."

msgctxt "393d29b9e4d041988a5f6a56e0b90e7c"
msgid "ཞེས་ སོ་␣༑།"
msgstr "As said. "

msgctxt "24ec3c866f0f4a77acbfb9747dc66f8f"
msgid ""
"ལྷན་␣༽༽  ལ་ལ་ དག་ མུ་སྟེགས་ བོན་ གྱི་ ཐུབ་པ་ ཆེན་པོ་ ལྟ་བུ་ ཐོབ་པ་␣ར་ མི་ "
"ནུས་ ཀྱང་"
msgstr ""
"Addendum: Some said that, while tirthikas are not able to attain like Great "
"Able One of Bon, "

msgctxt "7d15ac448b0f47d5b82be2b88224a3e7"
msgid "ཆོས་ཉིད་ ཀྱི་ བདེན་པ་ མཐོང་བ་ ཡོད་ ཟེར །"
msgstr ""
"It is said that there are [those] who see the true nature of phenomena."

msgctxt "9656c42cbf5b4abf8aea1b5a86beb58c"
msgid "འདི་␣ར་ ནི་ མུ་སྟེགས་ བོན་ གྱི་ གྲུབ་མཐའ་ འཛིན་པ་ ཆོས་ཅན །"
msgstr ""
"In this [system], take the subject tirthikas who hold the tenet of Bon."

msgctxt "887f417d45814382851a64f4bef5fe53"
msgid "བདེན་པ་ མཐོང་བ་␣འི་ སྐབས་མེད་ དེ་"
msgstr "There is no occasion to see the truth."

msgctxt "529f0155ceac4ef696e507b1ce47e5ea"
msgid "ལོག་ལམ་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr "Because it is a wrong path. "

msgctxt "303222fa69f84a2ba3d53b4b97c23f90"
msgid ""
"དེ་␣འང་ མཆོག་ གསུམ་ ལ་ སྐྱབས་ སུ་ མི་ འཛིན་ འཕགས་ལམ་ དང་ བྲལ་བ་␣འི་ བདེན་པ་ "
"མི་ མཐོང་ སྟེ །"
msgstr ""
"The truth cannot be seen without taking refuge in the three Excellences and "
"separating from the noble paths."

msgctxt "1c33b14138ef4b51bed04492bb10be66"
msgid "ཕྲན་ ཚེག་ ལ་␣ས །"
msgstr "The Finer Points of Discipline:"

msgctxt "b119db92e68442078692ab92b561b1ea"
msgid "རབ་ བཟང་ གང་ཡང་ འཕགས་པ་␣འི་ ལམ་ ཡན་ལག་ བརྒྱད་པ་ མི་སྣང་བ་"
msgstr "Subhadra does not see any of the eight-fold noble path"

msgctxt "9b0d4623feca4eda99d02b13012d5f2c"
msgid "དེ་ ལ་ དགེ་སྦྱོང་ ཡང་ མེད་ དོ ། །"
msgstr "There is no training in virtue as well."

msgctxt "fbef9da99c6743d4b3979025f49baa2a"
msgid "ཅེས་ དང༌ །"
msgstr "And."

msgctxt "37cae8559bfb4f2496d614491dc51103"
msgid "ཆོས་སྐྱོབ་ ཀྱིས །"
msgstr "Dharma Protector said,"

msgctxt "c2b6cb64e7b64daa9a705a5b5763bde5"
msgid "ནམ་མཁའ་ ལ་ ནི་ བྱ་རྗེས་ བཞིན ། །"
msgstr "Like the trace of a bird in the sky,"

msgctxt "13dc9cd9af274f72b71ffe8103e6a883"
msgid "ཀུན་ ཏུ་ རྒྱུ་ལ་ དགེ་སྦྱོང་ མེད །"
msgstr "The wandering mendicants have no training in virtues."

msgctxt "d90e7789343c4e84b9b92ada630c3ea4"
msgid "ཅེས་ དང་ ཤེས་ སྤྲིང་ ལ་␣ས །"
msgstr "And, according to A Letter to a Friend:"

msgctxt "c2624a9571ca45139dcddfb2d133d234"
msgid "གང་ཟག་ ལོག་པ་␣ར་ ལྟ་བ་␣འི་ ལེགས་བྱས་ ཀྱང་ །"
msgstr "Persons with wrong views, even [their] good actions"

msgctxt "b3dc83c46ddf46509f8faeda4847174c"
msgid "ཐམས་ཅད་ རྣམ་པ་␣ར་ སྨིན་པ་ མི་ཟད་ ལྡན །"
msgstr "Will have overwhelming complete ripening [of karma]."

msgctxt "1b0a0e70d9c34bb1b022ba3e2d0ca21c"
msgid "ཞེས་ སོ །"
msgstr "And."

msgctxt "a83fadf031464542b18a6cfcbb15e415"
msgid "དེ་བཞིན་ དུ་ བརྡོལ་བོན་ འགྱར་ བོན་ བསྒྱུར་བོན་ རྣམས་ ཀྱང་ རོ །"
msgstr "Likewise, Dol Bon, Gyar Bon, and Gyur Bon."

msgctxt "0abba85512c94c03a93c12e15b7aede4"
msgid "ལྷན་␣༽༽་␣ཡང་ དགའ་ ཞིག་ གིས་"
msgstr "Addendum: Again some people said,"

msgctxt "23ebfdd305bd415da584f7790a88106d"
msgid "བདེན་ མཐོང་ ལྟ་ཅི་ ཐར་པ་ ཆ་ མཐུན་ ཙམ་ ཡང་ མེད་ ཟེར་ ལ །"
msgstr ""
"There is not even a partial concordance with emancipation, let alone seeing "
"the truth."

msgctxt "9886ec842b664a448a185563271afca9"
msgid ""
"འདི་␣ར་ ནི་ དེ་དག་ ཐར་པ་␣འི་ ཆ་ དང་ མཐུན་པ་␣འི་ དགེ་བ་ འགའ་ཞིག་ ཡོད་ ཀྱང་ "
"རུང་ སྟེ་"
msgstr ""
"In this [system], it is possible that there are some virtues which partially"
" concordant with emancipation."

msgctxt "f8b0c7352c4646e884506d2c96dbc7a1"
msgid ""
"དེ་␣འང་ ཆ་ མཐུན་ ནི་ མཐོ་རིས་ ཀྱི་ བདེ་བ་␣ར་ དམིགས་པ་␣འི་ ལ་␣ས་ བསོད་ནམས་ ཆ་"
" མཐུན །"
msgstr ""
"A partial concordance is concordant with meritorious karmas that aspire for "
"the bliss of the higher levels."

msgctxt "a0b2c929c23c4390bb16aa49d5cf9877"
msgid "མྱང་འདས་ ལ་ དམིགས་པ་␣འི་ ཐར་པ་ ཆ་ མཐུན །"
msgstr "A partial concordance with emancipation that aspires for nirvana."

msgctxt "c005645ea92e41278e651e4950890f8e"
msgid "ངེས་འབྱེད་ ཆ་ བཞི་ འཇིག་རྟེན་པ་␣འི་ བསྒོམ་པ་ ལ་␣ས་ སྐྱེས་པ་"
msgstr ""
"The four factors conducive to discernment arise from worldly meditation. "

msgctxt "1ca85d6e55884deea6bf23451f2e3eea"
msgid "ཆོས་ཉིད་ སྟོང་པ་ གསལ་བ་ དང་པོ་␣ར་ རྟོགས་པ་ དྲོད་ དེ་ འཕེལ་བ་ རྩེ་མོ །"
msgstr ""
"To illuminate the true nature of phenomena as empty, first, the realization "
"of Warmth [stage] develops to Peak [stage]."

msgctxt "1c1b0cb4617845008fe457fb0390f5d0"
msgid "དེ་ བརྟན་པ་ བཟོད་པ་ དེ་"
msgstr "By stabilizing it, then Patience."

msgctxt "e4e531880126423a910dd0ecff6c913d"
msgid "རབ་ ཀྱི་ མཐར་ཐུག་ ཆོས་མཆོག་ སྟེ་ གསུམ་ ལ་␣ས་"
msgstr "The Highest Dharma is the outmost ultimate. Out of these three, "

msgctxt "fc37dd7a38164ccf872c273579dc5739"
msgid "ཐར་པ་ ཆ་ མཐུན་ སྙིང་རྗེ་ དང་ དབྱར་གནས་ སོགས་ སྔར་ བཤད་པ་ ལྟར་ རོ །"
msgstr ""
"Those with a partial concordance with emancipation, such as compassion and "
"the summer retreat, are the same as previously explained."

msgctxt "b46bd03422db4a0986511b5f86d13f36"
msgid ""
"རྡོ་␣༽༽  ཕྱི་ ནང་ གི་ ཁྱད་པར་ ཕྱག་རྒྱ་ བཞི་ དང་ ལྟ་བ་ དང་ སྤྱོད་པ་ དང་ "
"སྙིང་རྗེ་ དང་ བདག་ འཛིན་ ཡོད་མེད་ ཀྱི་ འབྱེད་པ་ མི་མཐུན་པ་ མང་ དུ་ སྣང་ མོད "
"།"
msgstr ""
"Vajra: Though it appears that there are many discordances between Buddhists "
"and non-Buddhists in the four mudras, view, conduct, compassion, and "
"differentiation of the existence of self-grasping. "

msgctxt "23ff2389078540fc9e95713e4d77e16c"
msgid "འདི་␣ར་ ནི་ ཕྱི་ ནང་ ཁྱད་པར་"
msgstr ""
"In this [system], the difference between Buddhists and non-Buddhists is"

msgctxt "35fe0cb0da364ab290410e3bc52f8741"
msgid "སངས་རྒྱས་ ཆོས་ དགེ་འདུན་ ལ་ སྐྱབས་ སུ་ འགྲོ་བ་␣ས་ འབྱེད་པ་ སྟེ་"
msgstr "differentiated by seeking refuge in the Buddha, Dharma, and Sangha."

msgctxt "782a4fc8a238466a8ca86e5bec4f14bf"
msgid "གཞན་ གང་ གིས་ མིན་ ནོ །"
msgstr "Not by any other means."

msgctxt "84684d67fb57463ba9bec789b46bea1a"
msgid "། དེ་དག་ གིས་ མི་ ཕྱེད་ དེ་"
msgstr "None of them distinguish it. This is because"

msgctxt "5bc0e7e1c11840d78954d8d909cdaa73"
msgid "ཆད་ལྟ་␣ས་ འདུས་བྱས་ མི་རྟག་པ་ དང་ །"
msgstr "The view of nihilism, the impermanence of composite and "

msgctxt "11688c9abcfe4eff8549e21672552df9"
msgid "འཁོར་བ་ སྡུག་བསྔལ་ དུ་ མཐོང་བ་ དང་ །"
msgstr "Seeing Samsara as suffering and "

msgctxt "c74b32a69f01485f8a6992cda15682ff"
msgid "སྟོང་པ་ ཆལ་ ཆད་ དུ་ ལྟ་བ་ དང་"
msgstr "Viewing empty as meaningless and "

msgctxt "a2fbb08e1d89495ea734f1bdf850e2d2"
msgid "ལུང་ མ་ བསྟན་ བཅུ་␣འི་ ཡ་གྱལ་ མཐའ་ ཡོད་མཐའ་ མེད་པ་␣ས་ དབུ་མ་ དང༌ །"
msgstr ""
"One of the ten unprophesied [things] is the middle way, because of the "
"existence or non-existence of limits."

msgctxt "67946c67af7045cba7c04007dc15d5dc"
msgid "དགེ་ བཅུ་ སྤྱོད་པ་ དང་ །"
msgstr "Conduct of the ten virtues and"

msgctxt "d3f8b7ccb3ea4fc881e0257b76e87ace"
msgid ""
"སྙིང་རྗེ་␣ས་ རྐང་པ་␣ར་ དྲིལ་གཡེར་ འདོགས་པ་ རྣམས་ ཕྱི་རོལ་པ་ ལ་ ཡོད་པ་␣འི་ "
"ཕྱིར་ དང་"
msgstr ""
"Out of compassion, the tying of ankle bells around the feet exists in non-"
"Buddhists."

msgctxt "5dd93e07e4ed46a9a1b53bed16b505d5"
msgid "ནང་པ་␣ར་ ཡང་ བྲམ་ཟེ་ རྒྱལ་བ་␣འི་ དྲོད་ ཀྱི་ མེ་ ལྔ་ བརྟེན་པ་ དང་ །"
msgstr ""
"Buddhists, too, rely on the warmth of the Brahmin conqueror's five fires."

msgctxt "2b5e3549149e4cdeacc02ff8a686a62d"
msgid "གནས་མ་ བུ་␣འི་ སྡེ་ བས་"
msgstr "In the Vatsiputriya school,"

msgctxt "e8ebfb24abdf4f69915d6bc59e456155"
msgid "བདག་ རྫས་ གྲུབ་ ཏུ་ འདོད་པ་ སོགས་ ཡོད་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "There are those who accept self as being substantially established."

msgctxt "e1540425e95945dcabe2360d9aa753a1"
msgid "འོ་ན་ ཅི་ ཞེ་ན་␣༑"
msgstr "Well then, if it is asked why?"

msgctxt "f178934b6b194fdb9f89f24f572ebf97"
msgid "ཇོ་བོ་␣ས་ སྐྱབས་འགྲོ་␣འི་ ཕན་ཡོན་ དུ་"
msgstr "Jowo said the benefits of seeking refuge "

msgctxt "a6f65110963c45a0a782ed9ef846bf25"
msgid "ནང་པ་␣ར་ ཚུད་པ་␣ར་ འགྱུར་བ་ ཞེས་པ་␣ས་"
msgstr "One will become a Buddhist."

msgctxt "7f75977b71a545a88bd9ccfec3ac3de2"
msgid "དེ་ ཡོད་ ན་ རྒྱུ་མཚན་ གནག་རྫི་ ལྟ་བུ་␣འང་ ནང་པ་ ཡིན །"
msgstr "Therefore, with it, even a herder is a Buddhist,"

msgctxt "db1d602a837947ddb32ee6c828400369"
msgid "མེད་ ན་ པཎྜི་ཏ་ ལྟ་བུ་ ཡང་ཕྱི་ རོལ་པ་ ཡིན་པ་ དེ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "And without it, even a Pandita is a non-Buddhist."

msgctxt "5c43cfa486c944d789e3cfcf68d8deb6"
msgid "ལྷན་␣༽༽  ཕྱི་པ་␣ར་ སྡོམ་ དང་ སྙིང་རྗེ་ མེད་ དེ་"
msgstr ""
"Addendum: Though it is said that the non-Buddhists have no vow and "
"compassion because"

msgctxt "ac54622f7602444cb7efea9a9e824ed4"
msgid "ལྟ་ བསྒོམ་ སྤྱོད་པ་ འབྲས་བུ་ ལོག་པ་␣འི་ ཕྱིར་"
msgstr "of wrong view, meditation, conduct, and result. "

msgctxt "bf086c74a73940fea3cda0a136d5ab62"
msgid "ནང་པ་␣ས་ སྤང་པ་␣ར་ བྱ་བ་ འབའ་ཞིག་ ཡིན་ ཟེར་ ཡང༌ །"
msgstr "All of these are solely to be abandoned in Buddhism."

msgctxt "908f421ed32f40cbb6668e706be9dd7b"
msgid "འདི་␣ར་ སྡོམ་ དང་ སྙིང་རྗེ་ ཙམ་ ཕྱི་རོལ་པ་ ལ་␣འང་ ཡོད །"
msgstr "In this [system], The non-Buddhists have vows and compassion as well."

msgctxt "7c65f3d52e954a81ab8e6536fd27f5d5"
msgid "དེ་ སྲོག་གཅོད་ སྤོང་བ་␣ར་ རྐང་པ་␣ར་ དྲིལ་བུ་ འདོགས་པ་ སྦྱིན་ལེན་ ན་"
msgstr ""
"As [they] tie bells to the feet to abandon killing, during giving and "
"receiving,"

msgctxt "c8d2059f1c31492886545e2464a79c92"
msgid "ཆུ་ མི་ འཐུང་བ་ འདོད་ཆགས་ སྐྱེས་ ཀྱི་ དོག་ ན་ འགྲོགས་ སྟེ་ འདུག་པ །"
msgstr ""
"If [one] is skeptical that desire can arise without drinking water, then "
"[one] remains in its company."

msgctxt "403ea3caa887472393b9c529ef5c48db"
msgid "རྫུན་ བསྲུང་བ་␣ར་ མི་སྨྲ་བ་ སྟེ་"
msgstr "Not speaking to refrain from lying."

msgctxt "fbdf4bc2403f4512949ca216a43f4f5a"
msgid ""
"བརྟུལ་ཞུགས་ ཀྱིས་ མི་དགེ་བ་ སྤོང་ ཞིང་ དགེ་བ་ སྤྱོད་པ་ དང་ སྙིང་རྗེ་ དེ་ལྟར་"
" ཡོད་པ་␣ས་ སོ །"
msgstr ""
"Non-virtues are abandoned by the yogic discipline, while virtues, behavior, "
"and compassion exist. "

msgctxt "667b2ef0a9544cb88a78af6b8d1457f6"
msgid "རྡོ་␣༽༽  ཐེག་པ་ ཆེ་ཆུང་ གི་ ཁྱད་པར་"
msgstr "Vajra: The differences between the Lesser and Great Vehicles. "

msgctxt "258933467c8848069f0bb527e979700e"
msgid ""
"རིགས་ལམ་ འབྲས་བུ་ ལྟ་སྤྱོད་ སྙིང་རྗེ་ སེམས་ཅན་ གྱི་ དོན་ རྣམས་ ཡོད་མེད་ "
"མཆོག་ དམན་ གྱིས་ འབྱེད་ ཟེར །"
msgstr ""
"It is differentiated by excellent and inferior, or the existence and absence"
" of lineage, path, result, view, conduct, and compassion for the sake of "
"sentient beings."

msgctxt "f60291e8d650471793003153888e76dd"
msgid "འདི་␣ར་ ནི་ ཐེག་པ་ ཆེ་ཆུང་ གི་ ཁྱད་པར་ སེམས་བསྐྱེད་ ཡིན་ ཏེ །"
msgstr ""
"In this [system], the difference between the Lesser and Great Vehicles is "
"the generation of the mind [for enlightenment]."

msgctxt "4c0b7583161d4878be64cc5f7c3d9464"
msgid "གཞན་དོན་ འཁོར་བ་␣ར་ གནས་ ཀྱང་ ནི ། །"
msgstr "For the sake of others, even stay in samsara."

msgctxt "3a3dad295dc2452395a6226d7b70ffe0"
msgid "སྙིང་རྗེ་ ཅན་ དག་ཅི་ སྟེ་ སྐྱོ་␣༑"
msgstr "The compassionate ones feel sad."

msgctxt "bf3f0044eefc43d18b77e10ae4a335a4"
msgid "འདི་ ནི་ བྱང་ཆུབ་ སེམས་ སྟོབས་ ཀྱིས ། །"
msgstr "With the power of bodhicitta, "

msgctxt "19523f28310a469e90dc647798815c22"
msgid "སྔོན་ གྱི་ སྡིག་པ་ ཟད་ བྱེད་ ཅིང་ ། །"
msgstr "The negative actions of the past will be exhausted."

msgctxt "7f805ed801004fc0a59eaf4c194a8042"
msgid "བསོད་ནམས་ རྒྱ་མཚོ་ བསྡུད་ བྱེད་ ཕྱིར །"
msgstr "The ocean of merit will be gathered."

msgctxt "398f6468ed8c4793bbd812355f4144f5"
msgid "ཉན་ཐོས་ རྣམས་ ལ་␣ས་ མཆོག་ ཏུ་ བཤད ། །"
msgstr "It is more supreme than shravakas."

msgctxt "ad66492b3354478d954abcbd3b4b0433"
msgid "དེ་བ་␣ས་ སྐྱོ་ངལ་ ཀུན་ སེལ་བ་␣འི"
msgstr "It will dispel all the physical and mental fatigue. "

msgctxt "c5a9e9b375d64de3a7ee22f836344d3f"
msgid "བྱང་ཆུབ་ སེམས་ ཀྱི་ རྟ་ ཞོན་ ནས ། །"
msgstr "By riding the horse of bodhicitta,"

msgctxt "c96a50ba6a3949e881efe51ee25322f9"
msgid "བདེ་ ནས་ བདེ་བ་␣ར་ འགྲོ་བ་ ལ ། །"
msgstr "Go from bliss to even more bliss,"

msgctxt "c9245a6a44c94c6d883075bcc90cd897"
msgid "སེམས་ཤེས་ སུ་ཞིག་ སྒྱིད་ ལུགས་ འགྱུར་ ༑ །"
msgstr "Which smart people would become sluggish."

msgctxt "e1872828492149918452def42082e58d"
msgid "ཞེས་ གསུངས་པ་ འཞིན་ སྙིང་རྗེ་␣ས་ གཞན་དོན་ ཕྱིར་དུ་"
msgstr "As previously stated, compassion for the sake of others"

msgctxt "72acdbb0a6f341df9e3e289441897825"
msgid ""
"བྱང་ཆུབ་ འདོད་པ་␣འི་ སེམས་བསྐྱེད་ ཀྱིས་ འབྱེད་པ་ ལ་␣ས་ གཞན་ གྱིས་ མིན་ ནོ །"
msgstr ""
"It is differentiated by the generation of mind of awakening that wishes for "
"enlightenment and not by others."

msgctxt "25065c1fbb5a4f1d9dd140b01e0c79ac"
msgid "རྡོ་␣༽༽  མདོ་ དང་ སྔགས་ ཀྱི་ ཁྱད་པར་"
msgstr "Vajra: The differences between sutra and mantra."

msgctxt "705edce6df7b438a99e50d668882677f"
msgid "ལམ་ བདེ་བ་ དུས་ མྱུར་བ་"
msgstr "Blissful path, swift in duration,"

msgctxt "de5c22d5c3024dc0ad916f1743af67b2"
msgid "འབྲས་བུ་ ལམ་ བྱེད་ དེ་ ལམ་ དང་ འཇུག་པ་"
msgstr "The training path to the result engages the path."

msgctxt "3f785a801e2345f0b7381dbcad866dcc"
msgid "འབྲས་བུ་ བདེ་བ་␣ས་ འབྱེད་ ཟེར་ ཡང་"
msgstr "Though happiness is said to differentiate the result."

msgctxt "c04de8db0e404d929ae1dee3b937cceb"
msgid "འདི་␣ར་ ནི་ དབང་ གིས་ ཡིན་ ཏེ་ འཇམ་དཔལ་ རྩ་རྒྱུད་ ལ་␣ས །"
msgstr ""
"In this [system], It is [differentiated] by empowerment because according to"
" The Manjushri Root Tantra:"

msgctxt "6e10c0db553e44258656cb9d0ba0cd36"
msgid "གང༌ཞིག་ དཀྱིལ་འཁོར་ མ་ མཐོང་བ་␣ར །"
msgstr "Those who have not seen the mandala,"

msgctxt "8459f5da6bb04977b9d92291dbac42c1"
msgid "རྣལ་འབྱོར་པ་ ནི་ དངོས་གྲུབ་ འདོད །"
msgstr "Yogins yearn for an actual accomplishment,"

msgctxt "b7a3911cdd604be0954fe0664aec8279"
msgid "མཁའ་ ལ་ ཁུ་ཚུར་ གྱིས་ བརྡེག་ དང་ །"
msgstr "It is like striking a fist at the sky or"

msgctxt "aa64f131c52249ef8cae628f53d72532"
msgid "སྨིག་རྒྱུ་␣འི་ ཆུ་ ནི་ འཐུང་ དང་ མཚུངས །"
msgstr "Drinking mirage water."

msgctxt "e8deda3d568b4d23a0c5fa4dd095f194"
msgid "ཞེས་པ་ དབང་ བཞི་ དང་ །"
msgstr "Thus, the four empowerments and"

msgctxt "6595d61b248d4cc8ad6f9784531d3573"
msgid "དེ་ལས་ ཀྱང་ དུམ་ དབང་ གིས་ འབྱེད་པ་ ཡིན་ ཏེ་"
msgstr ""
"From these, [sutra and mantra] are differentiated by the vase empowerment."

msgctxt "25e26dab93d4469ea3dfc7422577070d"
msgid "གཞན་ རྣམས་ མཚན་ཉིད་ ལ་␣འང་ ཡོད་"
msgstr "Others are also in the definition. "

msgctxt "dc34000065e245409faafa7a0b7488a4"
msgid "གསེར་མདོག་ དང་ ཆོས་ འཕགས་ ན་རེ་ རྟག་ ཏུ་ དུ་ བཞིན་ ནོ །"
msgstr ""
"Hemavarṇa and the bodhisattva Dharmodgata said, \"It is always like this.\""

msgctxt "3a113be1cc384318a05fc31402620795"
msgid ""
"ལྷན་␣༽༽  མཚན་ཉིད་ ཐེག་པ་␣ས་ གྲས་ མེད་ གསུམ་ གྱིས་ སངས་རྒྱས་པ་␣ར་ འདོད་ མོད །"
msgstr ""
"Addendum: The vehicle of characteristics accepts that [one] will become a "
"buddha in three incalculable [great aeons]."

msgctxt "548a90def303406b8ab1bc63e135a47b"
msgid "འདི་␣ར་ ནི་ ཚེ་ གཅིག་ གིས་ འཚང་རྒྱ་བ་␣ར་ ཡོད་ དེ །"
msgstr ""
"In this [system], it is accepted that one can become a buddha in one "
"lifetime."

msgctxt "47fdde3ee92042efaa249677f6c9644a"
msgid "བསོད་ནམས་ དང་ བརྩོན་ འགྲུས བླ་ མ་ མཚན་ལྡན་ སོགས་ ཚོགས་པ་ ཚང་ ན་"
msgstr ""
"If the gathering of merit, perseverance, and a qualified guru is complete, "

msgctxt "87d023589ef9486c8aa5f0a35496a213"
msgid "ཚེ་ གཅིག་ འཚང་ རྒྱ །"
msgstr "[One] will become a buddha in a single lifetime.  "

msgctxt "bad96c7920ed466d87306b0b4e5b6f75"
msgid "མ་ ཚོགས་ ན་ གསང་སྔགས་ ཀྱིས་ ཀྱང་ སངས་ མི་ རྒྱ་ སྟེ་␣༑"
msgstr ""
"If they are not gathered, [one] will not become a buddha even in secret "
"mantra."

msgctxt "0b3a22967036473280d28f6f7692a827"
msgid "ཞུས་ ལན་ ཚིག་ བཅད་ མ་ལ་␣ས །"
msgstr "According to the Question and Answer in Verses:"

msgctxt "e1718955f7414bd7bd0442edfb087616"
msgid "འདི་ ཡང་ སྟོན་པ་ ཉིད་ ཀྱི་ བཀའ །"
msgstr "This is the instruction of the teacher himself."

msgctxt "343ecdb8e02e472e81a3a3d4b34585a7"
msgid "སེམས་བསྐྱེད་ གཅིག་ གིས་ སངས་རྒྱས་པ་␣ར ། །"
msgstr ""
"To become a buddha by a single generation of the mind [for enlightenment]."

msgctxt "eecd21d0ced24a86a73e7a3fcdb03607"
msgid "འདོད་པ་␣ས་ ཕ་རོལ་ ཕྱིན་པ་ ལ ། །"
msgstr "To those who have the perfection of aspiration."

msgctxt "873fcdda79cf45e597edf2b007676c98"
msgid "བསླབ་པ་␣ར་ བྱ་ ཞེས་ གསུངས་པ་ དང་ ། །"
msgstr "It is said that one should be trained [in this way]."

msgctxt "201222cc7c7a437fa8688789bf8ba3a6"
msgid "ལོ་ ནི་ བཅུ་གཉིས་ ནང་རོལ་ དུ །"
msgstr "Within a period of twelve years,"

msgctxt "f01098c556bd40d1813c5225603f358e"
msgid "ནོར་བུ་ བཟང་པོ་␣ས་ ཀུན་བཟང་ ཐོབ ། །"
msgstr "Norbu Sangpo attained Samantabhadra."

msgctxt "6353b6ccbc6c49339554d840c9d12aa7"
msgid "བྱང་ཆུབ་ སེམས་དཔའ་ རྟག་ ཏུ་ ངུ་ ། །"
msgstr "The bodhisattva Sadaprarudita,"

msgctxt "8ece4bd0c52f49d190c5e753a9c6e701"
msgid "ཚེ་ འདི་␣ར་ ས་བཅུ་ ཕ་རོལ་ ཕྱིན ། །"
msgstr "In this life, [you will] perfect the ten levels."

msgctxt "18079a3b15b0460fba9d83f9a93e14c3"
msgid "དེ་ཕྱིར་ ཕར་ཕྱིན་ ཐེག་པ་ ཡང༌ ། །"
msgstr "Therefore, the Perfection Vehicle"

msgctxt "f41781581b234425970b137f9065df16"
msgid "ཚེ་ གཅིག་ སངས་རྒྱས་ བཞེད་པ་ ལགས །"
msgstr "It is accepted that you will become a buddha in one lifetime."

msgctxt "0a6210733d004124aa4a2117ed118d5d"
msgid "ཅེས་ སོ །"
msgstr "As said."

msgctxt "c0a5297833e9401982f2592fe6873d36"
msgid ""
"ལྷན་␣༽༽  གཞན་ ཤེས་ ལ་ སྔགས་ མཚན་ཉིད་ གཉིས་ ཀྱི་ སངས་རྒྱས་ དེ་␣ས་ "
"གསུངས་པ་␣འི་ ཆོས་"
msgstr ""
"Addendum: The knowledge of others is the Dharma taught by the Buddha in both"
" the mantra and characteristic [vehicles]"

msgctxt "6dd490c0f15a4f938012438b762d8524"
msgid "དེ་ ཉམས་ སུ་ ལེན་པ་␣འི་ དགེ་འདུན་ གསུམ་པོ་ ཐ་དད་ ཡིན་ ཟེར་ ཡང༌ །"
msgstr "The three types of Sangha who practice it are said to be distinct."

msgctxt "0c65bc610ab84b55b0d1cd92796d9a77"
msgid ""
"འདི་␣ར་ ཆོས་ དང་ ཉམས་ལེན་ གྱི་ འགྲོས་ སམ་ བབ་ ཀྱིས་ འབྲས་བུ་ སངས་རྒྱས་ གཅིག་"
" ཡིན་ ཏེ་"
msgstr ""
"In this [system], the result of the way or nature of the Dharma and practice"
" is the same buddhahood."

msgctxt "e9902ad7cc8643d088ca0b4d09e36eb7"
msgid ""
"སངས་རྒྱས་ ཐོབ་པ་␣ར་ བྱེད་པ་ ལ་ ས་བཅུ་ གཅིག་ དང་ བཅུ་གསུམ་ གཉིས་ སུ་ གསུངས་ "
"ཀྱང་"
msgstr ""
"Though it is said that there are eleven levels and thirteen levels to attain"
" buddhahood,"

msgctxt "b2c7155fc7804a84920f396c0c62bdd3"
msgid "མཚོན་ ལུགས་མ་ གཏོགས་ དོན་ ལ་ ཁྱད་མེད་ དོ །"
msgstr ""
"Apart from the way it is presented, there is no difference in meaning."

msgctxt "9ab61323620a4f549c7a78559bd00be2"
msgid ""
"སྔགས་ ཀྱིས་ ལུས་ རྩ་␣འི་ མདུད་ བཅུ་གསུམ་ གྲོལ་ རྒྱུ་ ཐ་མལ་ གྱི་ རླུང་ "
"ཉི་ཁྲི་ ཆིག་སྟོང་ དྲུག་ བརྒྱ་ འགག་པ་ དང་ སྦྱར་ ཏེ་"
msgstr ""
"The untying of the thirteen knots of body channels by mantra is connected to"
" the cessation of the twenty-one thousand six hundred winds in "
"individualized [beings]."

msgctxt "2237963cf81f4177bdb39a55d4728acf"
msgid "འཕོ་བ་ བཅུ་གཉིས་ གཙོ་བོ་␣ར་ བྱས་པ་ ལ་ ས་བཅུ་ གཉིས་ ཏེ་"
msgstr ""
"The twelve stages are chiefly the production of the twelve transferences."

msgctxt "46f29f86dd7d4111afae64a7c7e3e2b1"
msgid "རྩ་ རླུང་ ལ་ བརྟེན་པ་ མ་ དག་པ་␣འི་ རྟེན་འབྲེལ་ སྦྱངས་པ་ དང་ །"
msgstr ""
"The impure interdependence based on the channels and winds is purified and"

msgctxt "6a5811aa21d140a2b6ce48f5717f1aa7"
msgid "རྡོ་རྗེ་ འཛིན་པ་␣འི་ ས་ དང་ བཅུ་གསུམ་ མོ །"
msgstr "The vajra holder's level is the thirteenth."

msgctxt "f2b86d9587824ed09b7f133bace6c6bc"
msgid "ཕར་ཕྱིན་པ་␣ས་ སྒྲིབ་ བཅུ་ སྤངས་ ཤིང་ ཕར་ཕྱིན་ བཅུ་ རྫོགས་པ་␣ས་"
msgstr ""
"Those who have transcendently perfected have eliminated the ten obscurations"
" and completed the ten perfections."

msgctxt "1abf1e2bef6547c8a8c7edf4a17f10be"
msgid ""
"ས་བཅུ་ མཐ་␣ར་ ཕྱིན་ ནས་ བཅུ་གཅིག་ པ་སངས་ རྒྱས་ ཀྱི་ ས་␣ར་ འདོད་པ་␣ས་ ན་ "
"ས་␣ས་ བགྲོད་པ་ དང༌ །"
msgstr ""
"After completing the ten levels, they traverse from the level of desire to "
"the eleventh, the level of buddhahood."

msgctxt "2d9b50dd431448529b30637b2a314f5a"
msgid "ཉམས་ལེན་ བསླབ་ གསུམ་ དགེ་བ །"
msgstr "The practice is the virtue of the three trainings."

msgctxt "089c9eee7cad449ca5d26ef74720a82c"
msgid "ཉོན་མོངས་ འདུལ་བ་ ཐེག་ཆེན་ ཡིན་པ །"
msgstr "The Great Vehicle is for subduing the afflictions."

msgctxt "9cc0fc78ab7249a295c7fcfa5116bafe"
msgid "བགྲོད་པ་ གཅིག་པ་␣འི་ ལམ་ ཡིན་པ་ རྣམས་"
msgstr "All of the same traversal paths."

msgctxt "d34f138d564244beb29494fae8817be7"
msgid "སྔགས་ མཚན་ཉིད་ གཉིས་ཀ་ གཅིག་པ་ ཡིན་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Both the mantra and the characteristics are the same."

msgctxt "941a70012b1a407d90c4b27f265d791a"
msgid ""
"རྡོ་␣༽༽  སྔགས་ མཚན་ཉིད་ གཉིས་ གཞི་ ལམ་ འབྲས་བུ་ གསུམ་ གྱི་ གང་རུང་ རེས་ "
"སངས་རྒྱས་ ཐོབ་པ་ ཡིན་ ཟེར །"
msgstr ""
"Vajra: Some said that one can attain buddhahood through any one of the three"
" means-the ground, the path, or the fruition of the two: the mantra and the "
"characteristics."

msgctxt "a7dca729bd4742dcb54bfb1ab7ba376f"
msgid ""
"འདི་␣ར་ ནི་ དེ་ གཉིས་ གང་ ལ་ གང་ མེད་ རྫོགས་ བྱང་ ཐོབ་པ་␣ར་ མི་ སྲིད་ དེ་"
msgstr ""
"In this [system], Complete enlightenment is impossible without either of "
"these two."

msgctxt "be5de7ab6b834fb4a3be50da7ecd8a11"
msgid "རགས་པ་␣འི་ སྤང་བྱ་ མཚན་ཉིད་ ཀྱིས་ སྤོང །"
msgstr ""
"The coarse objects of abandonment are eliminated through the "
"characteristics."

msgctxt "c1743c612f694ff38426732779806cf3"
msgid "ཕྲ་བ་ སྔགས་ ཀྱིས་ སྤོང་བ་␣ས་"
msgstr "The subtle [objects of abandonment] are abandoned by the mantra."

msgctxt "8f970fd8d8b443a58687725b51d0f683"
msgid "སྔགས་ ལ་ མཚན་ཉིད་ མེད་ ན་ རག་པ་ མི་ སྤོང་ ཞིང་"
msgstr ""
"If the mantra is an absence of characteristics, the coarse [afflictions] "
"cannot be abandoned."

msgctxt "466666e308f74d868ce1b307ab201951"
msgid "སློབ་དཔོན་ རྒྱལ་བོ་ དང་ ནཱ་ རོ་པ་ ལྟ་བུ་␣ས་ ཀྱང་"
msgstr "Even the masters such as Gyalpo and Naropa,"

msgctxt "e0830da0ac284fef89721887d9241293"
msgid ""
"སངས་རྒྱས་ མི་ ཐོབ་ སྟེ་ རགས་པ་ མ་ སྤང་བ་␣འི་ སངས་རྒྱས་ མི་ སྲིད་པ་␣འི་ ཕྱིར "
"།"
msgstr ""
"Will not be able to attain buddhahood, because it is impossible to become a "
"buddha without abandoning the coarse [objects of abandonment]."

msgctxt "8802e23baaed434b919a95aac47a4c62"
msgid "མཚན་ཉིད་ ལ་ སྔགས་ མེད་ ན་ ཕྲ་བ་ མི་ སྤོང་ ཞིང་"
msgstr ""
"If the characteristics lack the mantra, the subtle cannot be abandoned."

msgctxt "c951e43a2dba4806919219e16a16d94a"
msgid "ནོར་ བཟང་ དང་ རྟག་ ཏུ་ ངུ་ ལྟ་བུ་␣ས་ ཀྱང་ སངས་རྒྱས་ མི་ ཐོབ་ ཏེ །"
msgstr ""
"Even those such as Sudhana and Sadaprarudita will not attain buddhahood."

msgctxt "2cff6f41c52f4964aefa1c36ceb9e128"
msgid "ཇོ་བོ་␣ས །"
msgstr "Jowo Atisha stated:"

msgctxt "7fd2a57418174229a58c6acbe822e19c"
msgid "གསང་སྔགས་ ཕ་རོལ་ ཕྱིན་པ་ ལ ། །"
msgstr "In the transcendental perfections of the secret mantra,"

msgctxt "4dd4b2b5dbc64c62b3e49443ce587978"
msgid "བརྟེན་ ནས་ བྱང་ཆུབ་ བསྒྲུབ་པ་␣ར་ གསུངས ། །"
msgstr "It is said that enlightenment is accomplished by relying on it."

msgctxt "cd4b5eda3b1240c491ef2e03ed47af97"
msgid "ཅེས་པ་␣ས་ སོ །"
msgstr "As just said."

msgctxt "8a9f55866df4459588395d87526e374f"
msgid ""
"རྡོ་␣༽༽  གཞན་ འདོད་ ལ་ སྡོམ་ གསུམ་ རིམ་བཞིན་ ལུས་ངག་ གི་ མི་དགེ་བ་ བདུན་ དང་"
" །"
msgstr ""
"Vajra: Others claim that the three vows represent the abandonment of the "
"seven non-virtues of body and speech, "

msgctxt "61000cd6e7494580a82467bd6d0cbe1c"
msgid "ཡིད་ ཀྱི་ གསུམ་ དང་ །"
msgstr "The three of mind and "

msgctxt "432214b521114058a46e3583ced18e03"
msgid "ལོག་ལྟ་ སྤོང་ ཞིང༌ །"
msgstr "the wrong views respectively. "

msgctxt "04f35b2be8874b199844a54dafbe181f"
msgid "དེ་ཡང་ གཙོ་བོ་␣ར་ བདུན་ ལ་ འདོད་ཆགས །"
msgstr "Moreover, mainly, desire in the seven,"

msgctxt "10165aad9d214f8c9881b15ed93d29c8"
msgid "གསུམ་ ལ་ ཞེ་སྡང །"
msgstr "Anger in the three, "

msgctxt "0161285181f14ef5aa0b8dc05f170b33"
msgid "ཕྱི་མ་␣འི་ སྐབས་ སུ་ གཏི་མུག་ སྤོང་བ་␣ས་"
msgstr "Ignorance during the final are all abandoned."

msgctxt "1861193d90d441e787edd973a1302fb1"
msgid "སོ་སོ་␣ར་ གསུམ་ དུ་ བྱུང་བ་ ཡིན་ ཞེས་ ཟེར །"
msgstr "It is said that [they] occur individually."

msgctxt "756b10f768d04257a31eb72ab39fce7c"
msgid "འདི་␣ར་ ནི་ སྡོམ་ གསུམ་ སྤང་བྱ་ མི་དགེ་ བཅུ་ སྤོང་བ་␣འི་ ཕྱིར་"
msgstr ""
"In this [system], the three vows are for the abandoning of the ten non-"
"virtues."

msgctxt "90a249bb831f4afd94c896146a521aea"
msgid "གནད་ དམ་ སྡོག་ ནི་ གཅིག་ སྟེ་"
msgstr "The key point and the binding are the same because,"

msgctxt "46acdf7473ac4bdfb5d8f51761038b2e"
msgid "མི་དགེ་ བཅུ་ སྡོམ་པ་ གསུམ་ ཆ་␣ར་ དུ་ སྤང་བྱ་ ཡིན་པ་"
msgstr "The ten non-virtues are to be abandoned in all of the three vows."

msgctxt "1a121fb151994eddb703e672dffedb1f"
msgid "སོ་ཐར་ གྱི་ སྐབས་ སུ་ ལུང་ རྣམ་འབྱེད་ ལ་␣ས །"
msgstr "During individual emancipation, the full analytical scripture says:"

msgctxt "c12a3e05af344c79a77424c0b5b14e79"
msgid "ལུས་ ཀྱི་ སྡོམ་པ་ ལེགས་པ་ ན །"
msgstr "If the actions of body are good,"

msgctxt "b6bc8ecb4a444cff9c5a6933efddfcad"
msgid "སོགས །།"
msgstr "And so on."

msgctxt "a27535da3d884e2c8db78f7b8e4056b9"
msgid ""
"ཅེས་ བྱང་སེམས་ ཀྱིས་ ཀྱང་ ཕུང་པོ་ གསུམ་པ་ སོགས་ ལ་␣ས་ དེ་ལྟར་ གསུངས་ ཤིང༌ །"
msgstr "This is also taught by the bodhisattvas in the Three Heaps [Sutra]."

msgctxt "d15f3632072245eab90de5b2d8ac266a"
msgid ""
"སྔགས་ ལ་␣འང་ གསང་བདག་ གིས་ བཅོམ་ལྡན་འདས་ ལ་ དམ་ཚིག་ གང་ ལགས་ ཞུས་པ་␣ས །"
msgstr ""
"Guhyapati asked the Blessed One, \"What are the commitments of the secret "
"mantra?\""

msgctxt "a41e7c8b3bfa467da8d469d026e1eb5c"
msgid "མི་དགེ་བ་ བཅུ་ སྤོང་བ་␣འོ ། །"
msgstr "It is the abandoning of the ten non-virtues."

msgctxt "e9c722539a994d0588608f721ea20a35"
msgid "ཞེས་ དང་ །"
msgstr "As said and."

msgctxt "7bc2bf0b292a41758b4bbcc745643789"
msgid "བཅོམ་ལྡན་འདས་ ནི་ བདུད་ བཅོམ་པ་ ཡིན་ ན །"
msgstr "If the Blessed One has defeated the demons,"

msgctxt "6e913eb580c7440c991aaa55f79bccde"
msgid "དུག་ གསུམ་ ཉོན་མོངས་པ་ སྤོང་ དགོས་ ཏེ །"
msgstr "[He] must have abandoned the three poisons of the afflictions."

msgctxt "e3ac3178e8564c2186b4e4d8e8f15a7b"
msgid "ཉོན་མོངས་ བདུད་ ནི་ བཅོམ་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "Because [he] has defeated the demons of the afflictions."

msgctxt "433607c145594e318f2fa0e3ac00f7e8"
msgid "སྲོག་གཅོད་ ལྟ་བུ་ གཅིག་ སྤོང་བ་"
msgstr "Abandoning one thing such as killing,"

msgctxt "878340c0d54f456fbb19c8554e5f0e1a"
msgid "མི་ཆོས་ བཅུ་དྲུག་ གི་ དང་པོ་"
msgstr "It is the first of the sixteen [pure] human conduct."

msgctxt "7ec590fb2fb84ebf8e3dba0d641acd29"
msgid "སོ་ཐར་ གྱི་ རྩ་ བཞི་␣འི་ ཡ་གྱལ །"
msgstr "One of the four root [vows] of individual emancipation."

msgctxt "48f806bcc45a4dcfa941b70b4de56513"
msgid "བྱང་སེམས་ ཀྱི་ སྨོན་སེམས་ སྐྱེ་བ་␣འི་ རྒྱུ །"
msgstr "The cause for the arising of the aspiring mind of enlightenment."

msgctxt "8e8eb7dca7be4808b15578db43576248"
msgid "སྐྱེ་ ནས་ འཇུག་ སྡོམ་ གྱི་ ངོ་བོ ། །"
msgstr "After its arising, it is the essence of engaging mind."

msgctxt "68f606993e36475dbb5d13525868ff2f"
msgid "སྔགས་ སུ་ བཀའ་ འདས་ ཀྱི་ ལྟུང་བ་ འབྱུང་བ་␣ས་"
msgstr "In the mantra, downfalls occur for transgressing the Buddha-word."

msgctxt "43799e63d2ce41efaee57107f9549200"
msgid "ཚུལ་ འདི་␣ས་ མི་དགེ་བ་ ཀུན་ ལ་ མཚུངས་པ་␣ར་ གནད་ གཅིག་ ཏུ་ འོང་ ངོ༌ །"
msgstr "In this way, it is the same case for all non-virtues."

msgctxt "b5767b95df0a4084a6d8f7f11f84d69a"
msgid ""
"ལྷན་␣༽༽  འགའ་ཞིག་ སོར་སྡོམ་ སྤང་ གཉེན་ གྱི་ ཚུལ་ དུ་ཡོད་པ་ སྣ་ རེ་ ཉམས་ ན་ "
"ངན་སོང་ དུ་ འགྲོ་"
msgstr ""
"Addendum: some people said that if any one remedy to abandoning degenerates "
"in the vows of individual emancipation, [one] will go to bad migrations."

msgctxt "5ee1fa75e614488bb23fbbfbcfee127a"
msgid "བྱང་སེམས་ ལ་ མི་དགེ་བ་ བདུན་"
msgstr "For bodhisattvas, the seven non-virtues"

msgctxt "80617b50b8104d4facd0c03a9af65ecf"
msgid "གནང་ སྔགས་ ཀྱིས་ བཀག་པ་ དེ་ རྣམས་ ལམ་ དུ་ བྱེད་པ་␣ས་"
msgstr "That are prohibited in the secret mantra, are taken as the path."

msgctxt "8da85e05889a44efbae34fefcf0d9ee8"
msgid "གོང་ ནས་ གོང་ དུ་ ཡངས་ སུ་ སོང་བ་ ཡིན་ ཟེར །"
msgstr "It becomes wider as [they] advance higher."

msgctxt "69a8ef12ad2d44e99cc3f4eecf63eb2c"
msgid "འདི་␣ར་ ནི་ སོ་ བྱང་ སྔགས་ ཀྱི་ སྡོམ་ གསུམ་ དེ་ཡང་"
msgstr ""
"In this [system], it is established that the vows of individual liberation, "
"bodhisattva, and mantra. "

msgctxt "aeeacac73ab5469f98d4a6b7b9e792d4"
msgid "གོང་ ནས་ གོང་ དུ་ དོག་ ཏུ་ འགྲོ་བ་ བསྒྲུབ་ ཏེ་"
msgstr "It becomes narrower as [one] goes higher."

msgctxt "279054a0e99c47959a4a31f80febf39e"
msgid "སོ་ཐར་ གྱི་ སྤང་བྱ་ རག་པ་ ཆེ་ལོང་ ཙམ་ བཅས་པ་"
msgstr ""
"With sufficient coarse objects of abandonment of individual emancipation."

msgctxt "bec1a8c4d96b49f58917dff444decb2f"
msgid ""
"ཉིས་ བརྒྱ་ ང་ གསུམ་ རང་ གཅིག་པུ་␣འི་ དོན་ ཡིན་པ་␣ས་ སླ་བ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"Since the two hundred fifty-three [vows?] are only for individuals, they are"
" easy."

msgctxt "f51fad6ddf694dc8bbc34e105f0e29ae"
msgid "བྱང་སེམས་ ཀྱིས་ ཕྲ་བ་ སྤོང་བ་␣ར་"
msgstr "Bodhisattvas abandon the subtle."

msgctxt "b069330caf844a43990100c59ab073b4"
msgid "བྱང་སེམས་ ཀྱི་ སྡེ་སྣོད་ དུ་ ཞིབ་ ཏུ་ བཅས་ ཏེ་"
msgstr "It is given in detail in the bodhisattva pitaka that"

msgctxt "0fc6b11865864475a26761472e68a85e"
msgid "གཞན་དོན་ ཁོ་ན་ ལ་␣ས་ རང་དོན་ སྐད་ཅིག་ ཙམ་ སྐྱེས་ ན་ ཉམས་པ་␣ར་ འགྱུར་བ་"
msgstr ""
"Aside from for the sake of others only, if one's own aim arises even for a "
"moment, one will degenerate."

msgctxt "32e8642e172e4f8fb6eaa9954a0a7af8"
msgid "སྔར་ བས་ བསྲུང་ དཀའ་བ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "It is harder to protect than before."

msgctxt "b77694febc7b47359d6409755ee97302"
msgid "སྔགས་ ཀྱིས་ ཤིན་ཏུ་ ཕྲ་བ་␣འི་ བག་ཉལ་ སྤོང་བ་"
msgstr "The mantra abandons the very subtle latent tendencies."

msgctxt "b7d110ae3fa14b9c830ffb222bfdcc94"
msgid "རྒྱུད་སྡེ་ རྣམས་ ལ་␣ས་ འབུམ་ སྡེ་ སོགས་ གསུངས་ ཤིང་"
msgstr ""
"[Buddha] taught the One Hundred Thousand [Verse] section and so on in the "
"tantra sections."

msgctxt "fc8d8310fd4d4be7afba3e562254ca82"
msgid ""
"སྔ་མ་␣འི་ སྟེང་ དུ་ ལུས་ངག་ ཡིད་ ཀྱི་ བྱ་ བྱེད་ ཐམས་ཅད་ ལྷ་␣འི་ ང་རྒྱལ་ "
"ལ་␣ས་ སྐད་ཅིག་ ཙམ་ ཡང་ མ་ བྲལ་བ་␣ར་ དགོས་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"This is because, in addition to the previous [one?], all activities of the "
"body, speech, and mind must never be disconnected from the pride of the "
"deity, even for a single moment."

msgctxt "aba449f0e0664c44b6372c3fe21ca7d0"
msgid "རྡོ་␣༽༽  ཆོས་ ཀྱི་ འཁོར་ལོ་ བསྐོར་བ་␣འི་ དོན་ སྡོམ་ གསུམ་ ཡིན །"
msgstr ""
"Vajra: The meaning of the turning of the wheel of the Dharma is the three "
"vows."

msgctxt "2eb31933e2be4d29b855b86ea6858a57"
msgid "དེ་ གསུམ་ དུ་ འོང་བ་␣འི་ རྒྱུ་མཚན་ སྤང་བྱ་ དང༌ །"
msgstr ""
"The reason for the coming of these three is because the objects of "
"abandonment,"

msgctxt "eddc81ec0fde41438f1a2a70c8825bfd"
msgid "བསྒྲུབ་བྱ་ དང་ ཐོབ་ བྱ་འབྲས་ བུ་ མི་མཐུན་པ་␣ས་"
msgstr "Accomplishment, and attainment, and the results are not concordant."

msgctxt "1b2edf154bc64e7db161d859cfed9558"
msgid "ལེན་ ན་སོ་ སོ་␣ར་ ལེན །"
msgstr "If taken, take it individually. "

msgctxt "4db26c974c6847ab952be9935bab71d8"
msgid "གནས་ ན་ གཅིག་ ཏུ་ གནས །"
msgstr "If dwelled, dwell in one."

msgctxt "e4cb49a53d404133b72c52393086faff"
msgid "བསྲུང་ ན་ འཆོལ་བ་␣ར་ བསྲུང་བ་"
msgstr "If protected, protect it in mixed."

msgctxt "f0b439ec32514dd6b49aedeacf94ced5"
msgid "ཐ་དད་ ཀྱིས་ ཁྱད་ འབྱེད་ ཟེར །"
msgstr "It is said that [they are] differentiated by distinction."

msgctxt "dc87378ef396475086e63e4a41c1f569"
msgid "འདི་␣ར་ ནི་ སྤང་བྱ་ མི་དགེ་ བཅུ་"
msgstr "In this [system], the ten non-virtues are to be abandoned "

msgctxt "76300b8e71c14e93a6d4596ad3a58ad2"
msgid "བསྒྲུབ་བྱ་ དགེ་བ་ བཅུ་ ཡིན་པ་␣ས་"
msgstr "and the ten virtues are to be accomplished."

msgctxt "12390aa7e4604ffb8a16d4cb0f7d70f9"
msgid "ཐ་དད་ དུ་ བྱ་བ་ ཅུང་ཟད་ མེད་ དོ་␣༑ །"
msgstr "There is not the slightest distinction to be made."

msgctxt "a903b0ec810b4c2d9778e869b2c3767a"
msgid "འོ་ན་ གསུམ་ དུའང་ བཞག་ རྒྱུ་ མེད་ ཅེ་ན །"
msgstr ""
"Well then, if one says, there are no three [wheels/vows?] to be posited."

msgctxt "10886d458e4d47be91a3d762b82ad10d"
msgid "དཔེར་ན་ རྒྱན་ གྱི་ ངོ་བོ་ གཅིག་ ལ་"
msgstr "For example, to the single entity of an ornament"

msgctxt "5329a711a3f44e2bb81360b550e272c3"
msgid "འབངས་ དང་ བློན་པོ་ རྒྱལ་པོ་ གསུམ་ གྱིས་ སོ་སོ་␣ར་ བཏགས་ ན་"
msgstr "If the king, ministers, and people each of them label it,"

msgctxt "0388cdef82414702bbc97d8cdaca7e57"
msgid "འདོགས་ མཁན་ དེ་␣འི་ དབང་ གིས་ གསུམ་ དུ་ འབྱུང་བ་ ལྟར །"
msgstr "It emerges into three due to the designators."

msgctxt "eb93a755497640fa9f3a9e48a88fd1ec"
msgid "སྡོམ་པ་␣འི་ ངོ་བོ་ ཉམས་ སུ་ ལེན་ རྒྱུ་ལ་ ཁྱད་པར་ མེད་ ཀྱང་"
msgstr ""
"Even though there is no difference in the essence of practicing the vows."

msgctxt "5d022661ae7741948a58666529251ad8"
msgid "ཉམས་ སུ་ ལེན་ མཁན་ བདག་པོ་ གསུམ་ ལ་སོ་ སོ་␣ར་ འཕོས་པ་␣ས་"
msgstr "Because the practitioners transmigrate into three individual masters,"

msgctxt "da8ab20bc8f34a6f9dc0b4ba84082eca"
msgid "བྱེ་བྲག་ གིས་ སྡོམ་པ་ གསུམ་ དུ་ འོང་ སྟེ་"
msgstr "Thus, there are three particulars of the vows."

msgctxt "018fe6248f214c94a187bbb4049b072d"
msgid ""
"འདི་ ནི་ གསང་བདག་ གིས་ དམ་ཚིག་ ཕྱི་མ་ ཞུས་པ་ ལ་ བརྟེན་ ནས་ གསུངས་པ་␣འི་ དོན་"
" དེ་ ཡིན་ གསུངས་ སོ །"
msgstr ""
"This is due to Guhyapati's request for the latter sacred commitment, and it "
"is said that this is the meaning of the teachings."

msgctxt "642eca1bc2964b2fb6cf93bb4e2cde1c"
msgid ""
"རྡོ་␣༽༽  གཞན་ ཤེས་ ལ་ དེ་བཞིན་ གཤེགས་པ་␣འི་ སྙིང་པོ་ ཡོད་པ་␣ར་ གསུངས་པ་ དེ་"
msgstr ""
"Vajra: Others' knowledge of the teaching of the existence of "
"tathagatagarbha."

msgctxt "edf67ca31b8f492fab80979eb0db21c2"
msgid ""
"དགེ་ མི་དགེ་ ལུང་ མ་ བསྟན་ གང་ དུ་ མི་ གཏུབས་པ་␣འི་ ནམ་མཁའ་ ལྟ་བུ་ ཞིག་ ཡིན་"
" ཟེར་ རོ །"
msgstr ""
"They said it is like the sky, which is not classified into virtue, non-"
"virtue, or neutral."

msgctxt "3db767d23da14eb7b7dd4a0cc521990b"
msgid ""
"འདི་␣ར་ རང་བཞིན་ རྣམ་དག་ ལ་ བྲལ་ སྨིན་ འབྲས་བུ་␣འི་ ཡོན་ཏན་ དང་ ལྡན་པ་␣ར་ "
"གྲུབ་ སྟེ །"
msgstr ""
"In this [system], it is established that the intrinsically pure nature "
"possesses the resultant qualities of being freed and ripened."

msgctxt "4fdb94eda7664b1ca3690e886aacf55a"
msgid "ཉེས་པ་ བློ་བུར་བ་ ཡིན་པ་"
msgstr "The faults are adventitious"

msgctxt "c65ede216468460cbc9f0ed5b9edaac5"
msgid "སྙིང་པོ་␣འི་ མདོ་␣ར་ དཔེ་ དགུ་␣ས་ བསྟན་པ་ དང་ ༈"
msgstr "And there are shown in the Essence Sutra using nine examples. "

msgctxt "4e4d9b86c2bf4491863e40352cc2bfd1"
msgid "ཕལ་པོ་ ཆེ་␣ར་ སྟོང་གསུམ་ དར་ཡུག་ གི་ དཔེ་ དང་ །"
msgstr ""
"In the Avatamsaka [Sutra], there is an example of three thousand bolts of "
"silk."

msgctxt "de33ac5a6b6e4c15b06549bd5cd86c10"
msgid "གཟུང་ དབང་ ཞུས་ མདོ་␣ར་ ནོར་བུ་ སྦྱོང་བ་␣འི་ དཔེ་␣ས་ བསྟན་ ཏེ །"
msgstr "According to the Sutra of Requisition by [King] Dharanishvara Sutra:"

msgctxt "28760694d6a945e6ac6cc0a9923767eb"
msgid "ཡོན་ཏན་ ཞི་ དུས་ ན་ ཇི་ལྟར་ ཡོད་པ་ མངོན་དུ་ བྱ་བ་␣ར་ གསུངས་  ཏེ་␣༑"
msgstr ""
"It is said that the good qualities present at the time of pacification will "
"manifest in the same way."

msgctxt "79cb505aad22475d893b3fee3c90098f"
msgid "རྒྱུད་ བླ་␣ར །"
msgstr "According to the Highest Continuum:"

msgctxt "b41311077bc5452dbd49f827eec214cc"
msgid "འདི་ ལ་ བསལ་ བྱ་ ཅི་ཡང་ མེད །"
msgstr "There is nothing to eliminate here."

msgctxt "422a93571bd546cc8cb1104daae38891"
msgid "སོགས་ དང་ །"
msgstr "And so on."

msgctxt "779d28b556de4e9f90bc0ddf9513c8cd"
msgid "ཉེས་པ་ བློ་བུར་ དང་ ལྡན་ དང་ །"
msgstr "Possesses the faults that are adventitious."

msgctxt "b14a479b42b544a5b1f3b05c9df011e6"
msgid "སོགས་ དང་ །"
msgstr "And so on."

msgctxt "ad961c549941411a9158fb5f2f0c4aef"
msgid "སེམས་ ཀྱི་ རང་བཞིན་ འོད་གསལ་ གང་ཡིན་པ །"
msgstr "The intrinsic nature of the mind is luminosity."

msgctxt "ad8df22950f2475aaa639a772874bfd8"
msgid "སོགས་ དང༌ །"
msgstr "And so on."

msgctxt "432ae7fd8209432482f7f8ff602c63c9"
msgid "དཔལ་ ཕྲེང་ གི་ མདོ་ ལ་␣ས །"
msgstr "According to the Glorious Garland Sutra:"

msgctxt "49e1b3935822474a94ee1dd71be60882"
msgid "དེ་བཞིན་ གཤེགས་པ་␣འི་ སྙིང་པོ་ ནི་ བྲལ་ ཤེས་པ །"
msgstr "The tathagatagarbha is freed,"

msgctxt "bf3ad6042e81471ab2e7f5fc093a2475"
msgid "དབྱེ་␣ར་ མེད་པ་ ཉོན་མོངས་པ་␣འི་ སྦུབས་ ཀྱིས་ སྟོང་པ །"
msgstr "Inseparable, empty of the sphere of the afflictions, "

msgctxt "2f3feda26c2f4ae39ff7a09d415de67b"
msgid "བྲལ་ མི་ ཤེས་པ་ རྣམ་པ་␣ར་ དབྱེ་␣ར་ མེད་པ་"
msgstr "That which is not freed and indivisible."

msgctxt "80cd1a0d6a194f7d8f85ebef743b76b4"
msgid ""
"སངས་རྒྱས་ ཀྱི་ ཆོས་ གངྒཱའི་ ཀླུང་ གི་ བྱེ་མ་ སྙེད་ འདས་པ་␣འི་ ཡོན་ དང་ "
"ལྡན་པ་␣འོ ། །"
msgstr ""
"The Buddha's aspects are endowed with all good qualities beyond as many as "
"there are grains of sand in the river Ganges."

msgctxt "08b86095f5164fad81f056f4b1dd326e"
msgid "ཞིང་ རྣམ་པ་␣ར་ མི་ རྟོག་པ་␣འི་ གཟུངས་ ལ་␣ས་"
msgstr "According to the Retainer of Non-discursive Thought:"

msgctxt "f437b5f72d164b1eb08dde98cac00960"
msgid "རང་ ཁྱིམ་ བྱི་ གཏོར་ དང་ འདྲ་བ་␣ར་ གསུངས་ སོ ། །"
msgstr "As said it is like a rat is scattering one's home. "

msgctxt "f9508905d12a483482c93989842cda19"
msgid ""
"དེ་ལྟར་ མིན་ ན་ མཐོང་ལམ་ མཐོང་ ནས་ དེ་ཡན་ བོག་ དབྱུང་ དུ་ མེད་པ་␣ར་ འགྱུར་ "
"རོ ། །"
msgstr ""
"If it is not like this, [one] cannot expel above the Path of Seeing after "
"seeing it."

msgctxt "164c3d34d96b4dda95ed81dbb4a679e8"
msgid "རྡོ་␣༽༽་␣བྱང་ཕྱོགས་ སོ་ བདུན་ ལམ་ ཁོ་ན་␣འི་ ཆོས་ ཡིན་ ཟེར་བ་ དང༌ །"
msgstr ""
"Vajra: Some said that the thirty-seven factors harmonious with enlightenment"
" are the aspects of the path only and "

msgctxt "1ea69bfcc41d4beab3204791d033cf5c"
msgid "འགའ་ཞིག་ སྡོམ་པ་␣ར་ ལུས་ དྲན་པ་ ཉེ་བར་ བཞག་ གི་ ཁྲོ་ མ་␣འོ །"
msgstr ""
"The wrathful female deity of the close placement of mindfulness of the body "
"in the vows."

msgctxt "2f437ea839c34fa7aec5f6bf41613d10"
msgid "ཞེས་པ་␣ས་ འབྲས་བུ་␣འི་ ཆོས་ ཡིན་ ཟེར་"
msgstr "Thus, it is said that they are the aspects of the result."

msgctxt "7236f6beff524270bcb0650001f97df9"
msgid "འགའ་ཞིག་ དེ་ གཉིས་ཀ་ ཡིན་ ཟེར །"
msgstr "Some said that they are both. "

msgctxt "a6c61eccc0bf408cb3098b17095062ab"
msgid "འདི་␣ར་ ནི་ གཞི་ ལམ་ འབྲས་བུ་ གསུམ་ ཀར་ ཁམས་ ཡོན་ཏན་ དང་ ལྡན་པ་"
msgstr ""
"In this [system], the ground, path, and result are endowed with good "
"qualities of the realm."

msgctxt "b188d26593b64a80a3d807e004479840"
msgid "དེ་ཉིད་ དང་ དབྱེ་␣ར་ མེད་པ་␣ར་ ཡོད་ དེ །"
msgstr "They are inseparable from it."

msgctxt "1a95f4bd2aac4ad682328725544cda99"
msgid "དེ་␣ས་ བརྗོད་ བླ་མ་ ལ་␣ས །"
msgstr "According to The Highest Continuum:"

msgctxt "4e25abcb52a44f50adce78931b2fb96d"
msgid "བྱང་ཆུབ་ ཕྱོགས་ ནི་ སུམ་ཅུ་ བདུན ། །"
msgstr "The thirty-seven factors that lead to enlightenment."

msgctxt "c0984c85bddd4a41b63413720fd662ca"
msgid "ཆོས་ ཀྱི་ རྣམ་པ་␣ར་ དག་པ་ ཡིན །"
msgstr "Phenomena are completely pure."

msgctxt "02534cb07ecf49909420749d7f1e682f"
msgid "ཞེས་པ་ དང༌ །"
msgstr "As said and."

msgctxt "933531b3e661434bbbaaee5f7b9c88e8"
msgid "འབྲས་བུ་␣འི་ ཆོས་ ཐམས་ཅད་ གཞི་ ལ་ ཡོད་པ་ མངོན་དུ་ བྱས་པ་␣ར་ གསུངས་ ན་"
msgstr ""
"If it says that all the aspects of the result in the ground are manifested."

msgctxt "a923f897cf524c1f8a56f665aa9f2349"
msgid "ཀུན་སྤྱོད་ སྡོམ་པ་ ལྷ་ སོ་ བདུན་ དུ་ གསུངས་པ་ དང༌ །"
msgstr "The vows of conduct are said to be thirty-seven deities and "

msgctxt "5f225c86ea6d41029771fe3698341323"
msgid ""
"མདོ་སྡེ་␣ར་ སངས་རྒྱས་ ལ་ བྱང་ཆུབ་ ཀྱི་ ཡན་ལག་ བདུན་ གྱིས་ ཕྱུག་པ་␣ར་ "
"གསུངས་པ་␣ས་"
msgstr ""
"The sutra section says that the Buddha is rich in the seven limbs of "
"enlightenment."

msgctxt "59925ceca55542c6b6357cb77f711003"
msgid "བྱང་ཕྱོགས་ སོ་ བདུན་ བཞི་ བདེ་གཤེགས་ སྙིང་པོ་␣ར་ ཡོད་པ་ ངེས་ སོ །"
msgstr ""
"The four of the thirty-seven factors harmonious with enlightenment are "
"certainly present in the sugatagarbha."

msgctxt "99c2c27742754a94a7a18651e7d11172"
msgid "ལྷན་␣༽༽  བྱང་ཕྱོགས་ སོ་ བདུན་ གནས་སྐབས་ བདུན་ དུ་ གསུངས་པ་"
msgstr ""
"Addendum: The thirty-seven factors harmonious with enlightenment are taught "
"in seven [sections] on this occasion."

msgctxt "1e5923449b7e440e8656967e3be409c9"
msgid "ལམ་ གྱི་ ཆོས་ མིན་ གྱི་ སངས་རྒྱས་ ཀྱི་ ས་ ནི་ དེ་␣འི་ ཕ་རོལ་ ན་ ཡོད །"
msgstr ""
"The level of buddhahood is not a phenomenon of path, but it is beyond that."

msgctxt "e3bb0adc92a34d66bebf23654fc18fed"
msgid "ཚོགས་ལམ་ འབྲིང་པོ་␣ར་ དྲན་པ་ ཉེར་ བཞག་ ལ་དོན་ མེད་ ཟེར །"
msgstr ""
"It is stated [by others] that applications of mindfulness are meaningless on"
" the middling path of accumulation."

msgctxt "8b81800d459946c281dd55e001ea322d"
msgid ""
"འདི་␣ར་ ནི་ མཐར་ཐུག་ གི་ ས་ ཚུན་ཆད་ ཚོགས་ལམ་ གསུམ་ ངོ་བོ་␣ས་ བགྲོད་པ་ ཡིན་ "
"ཏེ །"
msgstr ""
"In this [system], one traverses the three paths of accumulation in essence "
"up to the ultimate ground because"

msgctxt "ebd3d90137d242f5904ad3ae8f292f84"
msgid "སངས་རྒྱས་ མ་ ཐོབ་ བར་ དུ་ ཚོགས་ གཉིས་ བསགས་ དགོས་པ་ དང༌ །"
msgstr ""
"The two accumulations must be gathered till one attains buddhahood and"

msgctxt "ff8f88b97720448a9a22ce873ba92cfb"
msgid "ཚོགས་ལམ་ གྱི་ དྲན་པ་ ཉེར་ བཞག་ དེ་"
msgstr "The application of mindfulness on the path of accumulation is "

msgctxt "8f152d07b61247359a9de94e2d7b24c9"
msgid "སྦྱོར་ལམ་ དུ་ དྲན་དབང་ དྲན་ སྟོབས་"
msgstr "The power of mindfulness of the path of connection."

msgctxt "3338afdb454042659da43d9d683714c4"
msgid "མཐོང་ལམ་ དུ་ དྲན་པ་ ཡང་དག་ བྱང་ཆུབ་ ཀྱི་ ཡན་ལག་"
msgstr ""
"On the path of seeing, it becomes the enlightenment limb of authentic "
"mindfulness."

msgctxt "0a259e3cf3174b3398104e0e7a4030fb"
msgid "བསྒོམ་ ལམ་ དུ་ ཡང་དག་པ་␣འི་ དྲན་པ་"
msgstr "On the path of cultivation, it is authentic mindfulness."

msgctxt "db1723f0f46c42669ca187ba943307c8"
msgid "མཐ་␣ར་ ཕྱིན་ ལམ་ དུ་ དྲན་པ་ ཉམས་ མེད །"
msgstr "On the final path, it is unimpaired mindfulness. "

msgctxt "41b728f437844d60b234c9cb4e4504fa"
msgid "དྲན་པ་␣ས་ དབང་ བསྐུར་ དྲན་པ་␣ས་ མ་ འདྲེས་པ་ གསུམ་ དུ་ འབྱུང་བ་"
msgstr ""
"Bestowed empowerment through mindfulness, the emergence of three "
"distinctions through mindfulness."

msgctxt "056808eeff2347c2838ddca3106d70a9"
msgid ""
"དེ་ རིམ་བཞིན་ སངས་རྒྱས་ ཀྱི་ མ་ འདྲེས་པ་ དང་ སྐབས་ བརྒྱད་ ཀྱི་ རྣམ་མཁྱེན་ "
"དང་ བྲལ་བ་␣འི་ ཡོན་ཏན་ ཡིན་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"This is because they are the distinct [qualities] of the Buddha, the "
"omniscience of the eight parts, and good qualities of freedom successively."

msgctxt "147b022eac3e4d9ab3c3fade57e88cbb"
msgid ""
"རྡོ་␣༽༽  ཞི་གནས་ ཀྱི་ གཞི་མ་ ཚད་ མེད་ རྣམ་ བཞི་␣འམ་ ཚང་ གནས་ བཞི་␣ས་ "
"ཚངས་པ་␣འི་ རྒྱལ་པོ་ ཐོབ་ ཕྱིར་"
msgstr ""
"Vajra: The basis of calm abiding is the four immeasurables, or four abodes, "
"which bring the attainment of the king of Brahma."

msgctxt "fabf92c1e3194ff69f6b45e63be9ae16"
msgid "འཇིག་རྟེན་པ་␣འི་ ལམ་ ཡིན་ ཟེར །"
msgstr "It is said to be a worldly path."

msgctxt "1e1c10dfe3354637bf9eef73fd5d25c5"
msgid "འདི་␣ར་ ནི་ དེ་␣འང་ གཞི་␣ར་ ཡོད་པ་"
msgstr "In this [system], this also has a basis."

msgctxt "d02d93da99d3467890b93dc8d70b3302"
msgid "ལམ་ དུ་ བྱེད་པ་ ངེས་དོན་ འཁོར་ལོ་␣ར་ མ་ཟད་"
msgstr ""
"It acts as the path of the definitive wheel [of the Dharma], not only that, "

msgctxt "10b9e66edd894cff96f30e54bf54415e"
msgid ""
"སྔགས་ སུ་␣འང་ གཞན་ ལ་ ཕན་པ་␣འི་ སེམས་ ནི་ བྱམས་པ་ ཡིན་ ཞེས་ སོགས་ དང༌ །"
msgstr ""
"In the Mantra as well, the mind that benefits others is loving-kindness."

msgctxt "7ce1a2b3a58745b5b005ffc080790a08"
msgid "འབྲས་བུ་␣འི་ སྐབས་ ན་␣འང་"
msgstr "At the time of the result,"

msgctxt "9d2e60ce23af4ff78cf6a435c4d14d16"
msgid "དེ་དག་ གི་ ངོ་བོ་␣ར་ སངས་རྒྱས་པ་␣ར་ གསུངས་ ཏེ །"
msgstr "It is said that one enlightens to buddhahood in their essence."

msgctxt "907023365cc14d499ef5b6dcc5deea77"
msgid "རྒྱ་ ཆེ་␣ར་ རོལ་པ་ ལ་␣ས །"
msgstr "According to the Extensive Sport [Sutra]:"

msgctxt "1ef91fe9a3544583b8d80db5720f23de"
msgid "གང་ གི་ དོན་ སྟོབས་ བཅུ་པོ་ ལ ། །"
msgstr "For the sake of what with the ten powers"

msgctxt "12ac27572c774ee5a1c8f999e163b2b1"
msgid "སེམས་ཅན་ རྣམས་ ལ་ བསྒོམ་པ་ ཡིན ། །"
msgstr "Cultivated for all sentient beings."

msgctxt "02255fd99ca147dbaa2a883ea7903c50"
msgid "བྱམས་པ་␣འི་ སྟོབས་ ཀྱི་ རྒྱལ་ གྱུར་པ །"
msgstr "Obtained victory through the power of loving-kindness."

msgctxt "8273ee147c954d71b45bab7932d95cc8"
msgid "ཞེས་པ་␣ས་ སངས་རྒྱས་ ཀྱི་ ངོ་བོ་ དེ་ བཞི་པོ་ ཉིད་ དོ །"
msgstr "Thus, these are the four essences of the Buddha."

msgctxt "6bbad09c97e241dd8f2573ae711f87d7"
msgid "རྡོ་␣༽༽  གཞན་ འདོད་ ནི །"
msgstr "Vajra: Others accept that,"

msgctxt "7fe597ce59dd44538b65d388cb215fd1"
msgid "རིགས་ ནི་ ངེས་ དང་ མ་ ངེས་ དང༌ ། །"
msgstr "The kind is certain or uncertain and"

msgctxt "517fe1c1f8a1492a9733fbc87edbb565"
msgid "རྐྱེན་ རྣམས་ ཀྱིས་ ནི་ མི་ འཕྲོག་ དང །"
msgstr "It will not be stolen by conditions and"

msgctxt "583da95493414b79a6d35a0b0dc1aa55"
msgid "འཕྲོག་མ་ ཉིད་ དེ་ སོཊ །"
msgstr "That which is stolen and so on."

msgctxt "d93df24866544d7aa2eb4bc4d6e0a742"
msgid "ཅེས་པ་␣ས་ རྒྱུ་ རིགས་ ཐ་དད །"
msgstr "Thus, the types of causes are different."

msgctxt "dbb49ffbb779491494b162f68b3b3a46"
msgid "ལང་ གཤེགས་ ལ་␣ས །"
msgstr "According to the Descent to Lanka Sutra:"

msgctxt "93f1809aa45e4bb3ac17280482863a72"
msgid "ལྷ་ ཡི་ ཐེག་ དང་ ཚངས་པ་␣འི་ ཐེག་ སོགས །"
msgstr "The vehicle of the gods and the vehicle of Brahma."

msgctxt "28994520e0d043f7b5f76ebae9b6a4ee"
msgid "ཅེས་པ་␣ས་ ལམ་ ཐ་དད་པ་␣ས་ འབྲས་བུ་␣འང་ ཐ་དད་ ཟེར །"
msgstr ""
"Thus, since the paths are distinct, the results are likewise distinct. "

msgctxt "2d455558a86d438284df5373f143915d"
msgid "འདི་␣ར་ ནི་ ཡང་དག་པ་␣ར་ ངེས་པ་ ནི་ ཐེག་ གསུམ །"
msgstr "In this [system], the three vehicles are genuinely certain. "

msgctxt "2eaad7b931374b2b8a99a364d6786316"
msgid "ལོག་པ་␣ར་ ངེས་པ་ འདོད་ ཆེན་པ །"
msgstr "Certain to wrong [view], the greedy [one],"

msgctxt "e1f486f18ff54b9a95e82eb2b9dd28ce"
msgid "མ་ངེས་པ་ གཅིག་ ཏུ་ མ་ མཆོད་པ་ གསུམ་ ལ་␣ས །"
msgstr "The one who is uncertain, from these three who do not worship."

msgctxt "719c37650b974a95b6f1d406772f1d53"
msgid ""
"ལོག་ སྲེད་ ཅན་ ལྷ་ སྦྱིན་ དང་ ལེགས་ སྐར་ ལྟ་བུ་␣ར་ ཡང་ དཀར་བ་␣འི་ ས་བོན་ "
"ཡོད་ དེ །"
msgstr ""
"Even Devadatta and Sunaksatra who hold the wrong views and cravings have "
"white seeds because"

msgctxt "280359df36ae42d59c56fc93f049808f"
msgid "རྒྱུད་ བླ་␣ར །"
msgstr "According to the Highest Continuum:"

msgctxt "3b16f4e12b8a47f0a6639fc1ddfd4e8a"
msgid "རྫོགས་ སངས་ སྐུ་ ནི་ འཕྲོ་ ཕྱིར་ དང་ །"
msgstr "The body of the Complete Buddha is the radiance and "

msgctxt "ff973bc66c644d18b39c89ff9cd91946"
msgid "སོགསདང་ །"
msgstr "And so on."

msgctxt "6931879c64614ff99cc5b505be75dc87"
msgid "ཟླ་ སྒྲོན་ ལ་␣ས །"
msgstr "According to the Moon Lamp sutra:"

msgctxt "a9ee0a2762da4558a76af4f466e05ff3"
msgid "བདེ་གཤེགས་ སྙིང་པོ་␣ས་ འགྲོ་ ཀུན་ ཡོངས་ ལ་ ཁྱབ །"
msgstr "The sugatagarbha pervades all beings."

msgctxt "d980be8ef2f145378571878775cd5cd0"
msgid "སོཌ་ དང་ །"
msgstr "And so on."

msgctxt "cdcd5c2b28e8430fbcebace2b0befb85"
msgid "བསྡུས་པ་ ལ་␣ས །"
msgstr "According to the Summarized [sutra]:"

msgctxt "1441c9cf5f82485eaa2ee03075e1705b"
msgid "འདས་པ་␣འི་ དེ་བཞིན་ཉིད་ གང་ མ་ བྱོན་ དེ་བཞིན་ཉིད །"
msgstr "The suchness of the past and the suchness of what is yet to come,"

msgctxt "88736fe8454d4248a85f7b1ec583f2aa"
msgid "སོཊ་ དང །"
msgstr "And so on."

msgctxt "af77cd60a65248ffa3b7c5cf4b36b79e"
msgid "མངོན་ རྒྱན་ ལ་␣ས །"
msgstr "According to The Ornament of Manifest Realization:"

msgctxt "21889c043e1143b6a4e65586310fb080"
msgid "ཆོས་ ཀྱི་ དབྱིབས་ ལ་ དབྱེ་␣ར་ མེད་ ཕྱིར ། །"
msgstr "Because the shapes of phenomena have no divisions,"

msgctxt "022265522575430ab38c74421c112a97"
msgid "རིགས་ ནི་ ཐ་དད་ རུང་ མ་ ཡིན །"
msgstr "The distinct kind is not suitable."

msgctxt "d6d7dcaa8167477baae6f55892273adf"
msgid "ཞེས་པ་␣ས་ རིགས་ གཅིག  །"
msgstr "Thus, it is the same kind."

msgctxt "b29f8d742d7d4f9a8ea77ca8f8ad3cab"
msgid "སངས་རྒྱས་ རྣམས་ སེམས་ སྐྱེད་པ་ ནས་ བཟུང་"
msgstr "Ever since the buddhas have arousen bodhichitta,"

msgctxt "c6e443d0c13f4e8f8870c773549861e9"
msgid "མཛད་པ་ སེམས་ཅན་ ཐམས་ཅད་ སངས་རྒྱས་ ཀྱི་ ས་␣ར་ འགོད་པ་␣འི་ དོན་ དང༌ །"
msgstr ""
"The purpose of [their] deeds is to elevate all sentient beings on the level "
"of the buddhas."

msgctxt "b399ee544f1a42e383078f20bd6582f2"
msgid "དཔེ་མཁྱུད་ མི་ མངའ་བ་ དང༌ །"
msgstr "[They] possess no tight-fisted with the teaching,"

msgctxt "2bc1470b01f04c1e872cbdf6939e6639"
msgid "ཉེ་རིང་ མེད་པ་ དང །"
msgstr "The absence of near and far,"

msgctxt "cf5e2763005c4ce4a2de21af8837a51c"
msgid "བསྲུང་བ་ མེད་པ་ གསུམ་ བརྙེས་པ་ དང༌ །"
msgstr "And nothing to protect, are the three achievements. "

msgctxt "f7bcd7e60b824c95a511f64397b9ac9c"
msgid "འདུ་ཤེས་ སྣ་ཚོགས་ མི་ མངའ་བ་␣འི་ ཕྱིར །"
msgstr "Because [they] possess no various perceptions."

msgctxt "6cf9f6d5d5344cfcbf065b3c2f8101f9"
msgid "ལམ་ ཡང་ ཐེག་ཆེན་ དུ་ གཅིག་ སྟེ །"
msgstr "The path is also one within the Great Vehicle."

msgctxt "a1654aa5261f46688428ddae8d2b8f30"
msgid ""
"བྱང་སེམས་ སྤྱོད་ཡུལ་ ཐབས་ ཀྱི་ རྣམ་པ་␣ར་ འཕྲུལ་པ་ བསྟན་པ་␣འི་ མདོ་ ལ་␣ས ། །"
msgstr ""
"According to the Sutra on the Manifestation of Skillful Methods, the Sphere "
"of Bodhisattvas Activity:"

msgctxt "7cb31a3cc00549949a9d10e01e87da14"
msgid "འདྲེན་པ་ སེམས་ཅན་ རྣམས་ ལ་ མཉམ་པ་␣འི་ ཐུགས ། །"
msgstr "Guide! [you have] a balanced mind toward all beings."

msgctxt "a58f5be054bf4d9f988f837437f414ec"
msgid "ང་ ལ་ ཐ་དད་ འདུ་ཤེས་ ནམ་ཡང་ མེད ། །"
msgstr "I never had the perception of distinct."

msgctxt "3bacaf8869c34f24890c044392d3ec0b"
msgid "ཐེག་པ་ དམན་པ་ གཞན་ ལ་ ངེས་ བསྟན་ ན ། །"
msgstr "If one shows the Lesser Vehicle to others,"

msgctxt "abf87cdf9a8c48439e7729216107a794"
msgid "དེ་ ལ་ ང་ ནི་ སེར་སྣ་␣འི་ སྐྱོན་ དུ་ འགྱུར ། །"
msgstr "I would become the fault of miserliness to this,"

msgctxt "f1ff68f476ef49e592671ccf6bab4bb5"
msgid "ང་ ཡི་ མྱ་ངན་ འདས་ གཅིག་ ཐེག་པ་ གཅིག  །"
msgstr "There is one nirvana of mine, one vehicle."

msgctxt "cc2e674566124add81f108ae0ed3661f"
msgid "ཅེས་པ་ དང་ །"
msgstr "And."

msgctxt "b783ab221a074414b9f9ac2d253057c5"
msgid "པད་དཀར་ ལ་␣ས །"
msgstr "According to the White Lotus:"

msgctxt "001c6ea4541549ecbc65d2e72a20c498"
msgid "ཤཱ་རི་␣འི་ བུ་ སངས་རྒྱས་ ཀྱི་ ཐེག་པ་ ཐམས་ཅད་ མཁྱེན་པ་ གཅིག་ སྟེ །"
msgstr "Sariputra! The vehicle of the Buddhas is only the all-knowing."

msgctxt "7e2dc8b55d854fe48ece91d558bf3a05"
msgid "གཉིས་ སམ་ གསུམ་ མམ་ ཞེས་ བྱ་བ་ མེད་ དེ །"
msgstr "There is no such as two or three."

msgctxt "2fac2167cd9a48b7a67926ef773c6a33"
msgid "ཅེས་ དང་ །"
msgstr "And,"

msgctxt "05b9fb2e5f1e4505901e295e3b7e3aab"
msgid "དགོངས་འགྲེལ་ ལ་␣ས །"
msgstr "According to the Commentary on the Intent:"

msgctxt "dc74f931228a4866a088d6ff4b6c894b"
msgid "ཐེག་པ་ ཆེ་ དང་ ཐེག་པ་ དམན་པ་ ལ་␣ས །"
msgstr "In the Great and Lesser Vehicles,"

msgctxt "db8e0cfad9564506b23b4a8789508a03"
msgid "རང་བཞིན་ སྣ་ཚོགས་ ཆོས་ རྣམས་ གང་ བསྟན་པ ། །"
msgstr "The teaching of the various intrinsic natures of phenomena"

msgctxt "7cdb09cd00ff459b943f663f13037d4d"
msgid "དེ་དག་ ཉིད་ ནི་ ཚུལ་ གཅིག་ ཡང་ བསྟན་ ཏེ །"
msgstr "These were also taught as having the same mode."

msgctxt "5030dfe2d1c34ec8a6c360377f3c3f29"
msgid "དེ་ཕྱིར་ ཐེག་པ་ སྣ་ཚོགས་ ང་ མི་སྨྲ །"
msgstr "Therefore, I do not express a diversity of vehicles."

msgctxt "249295b4baaa493b9c4178448c96d655"
msgid "ཞེས་པ་␣ས་"
msgstr "Thus,"

msgctxt "f393ce6372b640919540bc5ea32148e9"
msgid "ཉན་ཐོས་ བྱང་ཆུབ་ གཞོལ་ ཞིང་ འབབ་ སྟེ །"
msgstr "Shravakas and Bodhisattvas pursue diligently."

msgctxt "f9c5928aa0d24581ae5aecf141d8860a"
msgid "པད་དཀར་ ལ་␣ས །"
msgstr "According to the White Lotus:"

msgctxt "d7a62c05f4374e198becac6523510e04"
msgid "དེད་དཔོན་ ཐབས་ ལ་ མཁས་པ་ གྲོང་ཁྱེར་ གྱི་ དཔེ་ བསྟན་པ་ བཞིན་ ནོ ། །"
msgstr "It is like the example of a city for a skilful sea captain."

msgctxt "3a5c5b2bea42436da17049238bbe1016"
msgid "འབྲས་བུ་ ཡང་ གཅིག་ སྟེ་ མཚན་ བརྗོད་ ལ་␣ས །"
msgstr ""
"The result is also the same because according to the Expressing The Names "
"[sutra]:"

msgctxt "a312bd7d3e1748b68b3daba54db49c17"
msgid "ཐེག་པ་ གསུམ་ གྱི་ ངེས་ སོགས ། ཅེས་ སོ ། །"
msgstr "The three vehicles of the definitive and so on. As said."

msgctxt "e3dfd56e887643ec980b34382aa1a7f6"
msgid "དེ་␣འི་ ཕྱིར་ ཆོས་ ལ་ རིས །"
msgstr "Therefore, bias in the Dharma."

msgctxt "d594b1e7ba564880b0a17ca456cb9cd7"
msgid "གང་ཟག་ བཟང་ངན །"
msgstr "Good and bad persons,"

msgctxt "3602ebaf7abd41618015f6688318f15d"
msgid "སེམས་ཅན་ ལ་ བརྙས་པ །"
msgstr "Abusing sentient beings."

msgctxt "eceb51bddfd7451e831f17933466523a"
msgid "བྱང་ཆུབ་ ཏུ་ མི་ བསྔོ་བ་ སྟེ་ བཞི་པོ་ འདི་ མི་ འབྱུང་ དེས་ན །"
msgstr ""
"Absence of dedication to enlightenment. Thus, these four will not occur."

msgctxt "1370bb67878847aeaf5a1be09df55117"
msgid "ཐེག་པ་ ཐམས་ཅད་ རྒྱུ་ རིགས་ གཅིག་པ་␣ས་ ཐེག་པ་␣འང་ དེ་ལྟར་ གཅིག་ གོ  །"
msgstr ""
"Because all vehicles are of the same kind of cause, and thus there is only "
"one vehicle."

msgctxt "6966abc9e93947d0b67659461eea6f72"
msgid "རྡོ་␣༽༽  གཞན་དག་ ཉན་རང་ དང་ མཆོག་ གསུམ་ མི་ བདེན་ ཞེས་"
msgstr ""
"Vajra: Others said shravakas, pratyekabuddhas, and the three jewels are not "
"true. "

msgctxt "9198354174184507a324707fde0b8c4c"
msgid "རིགས་ ཆད་ ལོག་པ་␣ར་ ལྟ་བ་␣འི་ སྲེད་པ་ ཅན་ སངས་རྒྱས་ མི་ ཐོབ་པ་ དང་"
msgstr ""
"The broken lineage, endowed with the wrong views and cravings, will not "
"attain buddhahood and "

msgctxt "bf141b903ee547ca9e397d55fc5999ee"
msgid "ཉན་ཐོས་ གཏན་ གེགས་ སུ་ བཤད་ ན་ ཡང་"
msgstr "Even if they are told that the shravakas are a perpetual obstruction."

msgctxt "d4c17f4d73e140e79a7ee19dd09033e7"
msgid "འདི་␣ར་ ཉན་རང་ ལོག་ལྟ་ ཅན་ རྣམ་མཁྱེན་ འགྱུར་ ཏེ །"
msgstr ""
"In this [system], shravakas, pratyekabuddhas, and those with wrong views "
"will become omniscient."

msgctxt "ad72ffcac4f0480582d49afa2105be45"
msgid ""
"གཞི་ བདེ་གཤེགས་ སྙིང་པོ་ ཡོན་ཏན་ དང་ ལྡན་པ་ རྒྱུད་ ལ་ ཡོད་པ་␣འི་ ཕྱིར་ དང་"
msgstr ""
"This is because of the presence of the ground, the sugatagarbha endowed with"
" all qualities, in [one's] continuum."

msgctxt "8da40c01ba0a428b941bba73901c5bdf"
msgid "ཐེག་པ་ ཐམས་ཅད་ རིགས་ གཅིག་ ཡིན །"
msgstr "All vehicles are of one kind."

msgctxt "6b3fb2f369a7485994872e018e5c4653"
msgid "ལྷན་␣༽༽  དེ་ལྟར་ རྒྱས་པ་␣ར་ བཤད་པ་ ནི་"
msgstr "Addendum: In this way, a detailed explanation is "

msgctxt "455446d492d545e1b4fd3cc7c0f5d9f1"
msgid "རྒྱུ་ དང་ ལྡན་ ཕྱིར་ ཉན་རང་ སངས་རྒྱས་ སྟེ་"
msgstr "Because the shravakas and pratyekabuddhas possess the cause."

msgctxt "02ac5e2861bb4ea88edbee2caae8bcdc"
msgid "བྱང་ཆུབ་ ཆེན་པོ་ རཐོབ་པ་␣ར་ འགྱུར་ ཏེ་"
msgstr "The great enlightenment will be attained."

msgctxt "8529310876034c18b8bc860ef70f090e"
msgid "རྐུ་ ཐབས་ སུ་ སེམས་བསྐྱེད་པ་␣ས་"
msgstr "By generating the mind [for enlightenment] in disguise."

msgctxt "eb71d1a847164792b23e10c85f7deb08"
msgid "བྱང་ཆུབ་ ཆེན་པོ་␣ར་ ཐོབ་པ་␣ར་ ངེས་ སོ །"
msgstr "It is certain that [one] will attain great enlightenment."

msgctxt "072d1ff39cbd46a29d7b13489c86e916"
msgid "མྱང་འདས་ ཀྱི་ ངལ་ སྟེགས་ ཙམ་ ལས་མ་ གསུངས་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "Because it is only taught as a resting place of nirvana and "

msgctxt "126b45629c2040f89b54d782e46ecd15"
msgid "སངས་རྒྱས་ ཀྱི་ ཐུགས་རྗེ་ འོད་ཟེར་ གྱིས་ བསྐུལ་བ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "The light rays of the Buddha's compassion encourage [them] and"

msgctxt "f4491d40fbb14d528ccf0e8dfc5e419f"
msgid "རྣམ་གྲོལ་ གྱི་ ངོ་བོ་ ཟླ་ དད་ མེད་པ་␣ར་ གསུངས་པ་␣འི་ ཕྱིར་ ཏེ་"
msgstr ""
"Because it is said that there is no distinction in the essence of complete "
"liberation."

msgctxt "2b6fa768173e4f1fbb0187416bac06cf"
msgid ""
"བྱང་སེམས་ སྤྱོད་ཡུལ་ ཐབས་ ཀྱི་ རྣམ་པ་␣ར་ འཁྲུལ་པ་␣ར་ བསྟན་པ་␣འི་ མདོ་ ལ་␣ས །"
msgstr ""
"According to the Sutra on the Manifestation of Skillful Methods, the Sphere "
"of Bodhisattvas Activity:"

msgctxt "c655c3e493404c63825e885dc9b1ca4a"
msgid "དཔེར་ན་ མེ་སྟག་ ཆུང་ངུ་ འཕེལ་ གྱུར་ ན ། །"
msgstr "An example of a little spark as if it grows."

msgctxt "2b612079e6eb413e9ff754088aad1533"
msgid "མེ་ལྕེ་ ཆེ་ཆེ་␣ར་ འབར་ ཞིང་ མཆེད་པ་ ལྟར ། །"
msgstr "Like it blazes into a bigger flame,"

msgctxt "2c5d98513728496ead6152937ab30608"
msgid "ཉན་ཐོས་ ཡེ་ཤེས་ མེ་ ཡི་ མེ་སྟག་ ཀྱང་ ། །"
msgstr "Though the shravaka primordial wisdom is a spark of fire,"

msgctxt "00dfba0084dd47df81e82f442745bc5c"
msgid "དེ་ཉིད་ སངས་རྒྱས་ ཡོན་ཏན་ མེ་ལྕེ་ སྐྱེ །"
msgstr "That itself generates the flames of the Buddha's qualities."

msgctxt "101c4b8f8e6b46a1a034eab26667689a"
msgid "ཞེས་ སོ ། །"
msgstr "As said."

msgctxt "eaec4449e37042ddbd289e33491eee2d"
msgid "ལོག་ སྲེད་ ཅན་ ཡང་ དུས་ རིང་བ་␣ར་ དགོངས་པ་ ལ་␣ས་"
msgstr ""
"Even those with cravings, after giving thoughts [on it] for a long time, "

msgctxt "89f9d8758bca4a09897a2921a7eb4b14"
msgid "འདུས་བྱས་ ཀྱི་ བློ་ དེ་ བྲལ་བ་ ན་ འཇུག་པ་␣ར་ འགྱུར་ ཏེ །"
msgstr "When their compositional minds are free, [they] will engage in it. "

msgctxt "77cd6f3049d0472e84a31a9d08f454f9"
msgid "ལེགས་ སྐར་ སངས་རྒྱས་ བར་ གསུངས་པ་ བཞིན་ ནོ ། །"
msgstr "Like Sunakshatra, who is said to become a buddha."

msgctxt "b51978a4d96245e3945c44f75e7130ef"
msgid ""
"ཆོས་ ཀྱི་ འཁོར་ལོ་␣འི་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ་ ཚིགས་ རྐང་ སུམ་ བཅུ་པ་ "
"ལྷན་ཐབས་ ཚིགས་ རྐང་ བཅོ་ལྔ་␣འི་ འགྲེལ་བཤད་ ཀྱི་ སྐབས་ ཏེ་ དང་པོ་␣འོ ། །"
msgstr ""
"This concludes the first section, a commentary on the thirty vajra verses "
"and the fifteen verses of addendums, summarizing the essential points of the"
" Dharma wheel."

msgctxt "09de03364286405a9d179f8d50aa06a9"
msgid "རྡོ་␣༽༽  གཞན་དག་ ན་རེ །"
msgstr "Vajra: Others said,"

msgctxt "6f4742e0d70445ba99994a764efdfa53"
msgid ""
"དགེ་ མི་དགེ་ གང་ གིས་ ཀྱང་ དབང་མ་ བྱས་པ་␣འི་ འབྱུང་ ཆེན་ བཞི་ ཁམས་ "
"བཅོ་བརྒྱད་ ལུང་ མ་ བསྟན་ དུ་ གསུངས་ མོད །"
msgstr ""
"The four major elements and the eighteen elements are neutral and are not "
"controlled by virtue or non-virtue."

msgctxt "55215049bfed41a1b6d1d737a7df7ac1"
msgid "འདི་␣ར་ ནི་ དགེ་སྡིག་ གཉིས་ ལ་ཐག་ བཅད་ ན་"
msgstr ""
"In this [system], when it is decided as either virtue or negative action,"

msgctxt "c9c6bbd65a1f4fee945b453c58e8bdbd"
msgid "དེ་ གཉིས་ ལ་␣ས་ ལུང་ མ་ བསྟན་ བྱ་བ་ གཞན་ ཞིག་ མེད་ དེ་"
msgstr "Apart from these two, there is no other such as neutral."

msgctxt "b2259875ddc24987bfd40bc26460df75"
msgid "སློབ་དཔོན་ འཕགས་པ་␣ས །"
msgstr "Master Arya said:"

msgctxt "5dba172b24d249068015969316f4d9f4"
msgid "འདོད་ཆགས་ ཞེ་སྡང་ གཏི་མུག་ གསུམ ། །"
msgstr "The three of desire, aversion and delusion,"

msgctxt "a80bddd13f80442d9a24d8ad0c89f6b0"
msgid "དེ་␣ས་ བསྐྱེད་ ལ་␣ས་ ནི་ མི་དགེ་བ །"
msgstr "The actions that develop from these are non-virtuous."

msgctxt "aca54baa3c934ca48a0f2c5c104a59ca"
msgid "མ་ ཆགས་ མི་ སྡང་ གཏི་མུག་ མེད ། །"
msgstr "Without desire, without anger, and without delusion."

msgctxt "af5189078f654e92840849dee84bace5"
msgid "དེ་␣ས་ བསྐྱེད་ ལ་␣ས་ ནི་ དགེ་བ་␣འོ ། །"
msgstr "The actions that develop from these are virtuous."

msgctxt "6169f67dcbeb4b37a785ba51d95ddca0"
msgid "ཞེས་ གསུངས་པ་␣ས་"
msgstr "As said."

msgctxt "cbd7d221d7e94b4d97b0a1ea5be94cb1"
msgid "ཕུང་པོ་ གསུམ་པ་ ཞིག་ མེད་ དོ ། །"
msgstr "There is no third aggregate."

msgctxt "15561613026049c49d63930afe396a3c"
msgid ""
"སངས་རྒྱས་ ཀྱིས་ གསུངས་པ་␣འི་ ལུང་ མ་ བསྟན་ ནི་ ལྷན་སྐྱེས་ ཀྱི་ མ་རིག་པ་ ལ་ "
"གསུངས་ ཏེ །"
msgstr ""
"The neutral taught by the Buddha is referred to as co-emergent ignorance."

msgctxt "f5309e67e49c406b933e359517d64d82"
msgid ""
"སྤང་བྱ་ ཤེས་སྒྲིབ་ གཏི་མུག་ ལ་␣ས་ གྱུར་པ་ ཉི་ཁྲི་ ཆིག་སྟོང་ གི་ ཁོངས་ སུ་ "
"འདུ་བ་␣ས་"
msgstr ""
"The obscuration to knowables is one of the twenty-one thousand delusions "
"that must be abandoned."

msgctxt "f5d68a178d194f46bf9e263a507a509c"
msgid "དཔེར་ན་ ཁྱོ་ཤུག་ གཉིས་ བུ་མོ་ དང་ གསུམ་ ཡོད་ ཀྱང་"
msgstr ""
"For example, though there are three, a married couple and a daughter. "

msgctxt "195dc799c28b4532acb699e705710508"
msgid "ཕོ་མོ་␣ར་ འདུས་ ན་ གཉིས་ ལ་␣ས་ མེད་པ་ བཞིན་"
msgstr ""
"There are no more than two when they are grouped into male and female."

msgctxt "8dc1519941b34a3c843031c388970534"
msgid "ལུང་ མ་ བསྟན་ མི་དགེ་བ་␣འི་ ཕྱོགས་ སུ་ འདུ་␣འོ །"
msgstr ""
"Thus, the unstated [actions] are included in the category of non-virtues."

msgctxt "3910a54aeebe4f01ad3a9593e0926dd1"
msgid "རྡོ་␣༽༽  མངའ་བདག་ སྟག་ ཚ་ ན་རེ །"
msgstr "Vajra: The lord Taktsa said,"

msgctxt "a995d5286ff24d7b9382ea078fb97c8b"
msgid ""
"ཕྱི་རོལ་ གྱི་ ཡུལ་ ཇི་སྲིད་པ་ དང་ མཉམ་པ་␣འི་ གྲངས་ བཞིན་ རྟོག་པ་␣འང་ དེ་ཉིད་"
" ཅིག་ ཆ་␣ར་ དུ་ སྐྱེ་ ཟེར་ ཡང་ །"
msgstr ""
"It is stated that thoughts arise in a number equal to as many external "
"objects at once."

msgctxt "b190f2ec25a741a4b97c92b4d0753118"
msgid ""
"དེ་ ཆོས་ཅན་ རྟོག་པ་ གཉིས་ སམ་ མང་པོ་ དུས་ གཅིག་ ཅ་␣ར་ དུ་ འཇུག་པ་ མི་ སྲིད་ "
"དེ་"
msgstr ""
"Take that as the subject, it is impossible for two or more conceptualities "
"to engage at once."

msgctxt "4e9f66c63d304153851a822f695e7130"
msgid ""
"དེ་ལྟར་ ན་ དགེ་ མི་དགེ་␣འང་ ལྷན་ཅིག་ སྐྱེ་ རིགས་ ན་␣འང་ ཕན་ཚུན་ སྤང་ འགལ་ "
"ཡིན་པ་␣འི་ ཕྱིར །"
msgstr ""
"In that way, logic dictates that virtue and non-virtue can arise "
"simultaneously, but they are mutually opposing contradictions."

msgctxt "ba40fe31fecb40e182590090a53f1315"
msgid "དཔེར་ན་ ཚ་གྲང་ གི་ རེག་བྱ་ བཞིན །"
msgstr "For example, the tangible objects of cold and hot."

msgctxt "c1593202e0e64f62a67f37b1ea5c76a9"
msgid "དཔལ་ ཕྲེང་ གིས་ ཞུས་པ་ ལ་␣ས །"
msgstr "According to the Glorious Garland [Sutra]:"

msgctxt "c081d416f24f4385b6f77c7b8af57340"
msgid "དགེ་བ་␣འི་ སེམས་ ཀྱང་ སྐད་ཅིག་མ ། །"
msgstr "The virtuous mind is also momentary."

msgctxt "d7618e36e25d4def830c5df507177764"
msgid "མི་དགེ་␣འི་ སེམས་ ཀྱང་ སྐད་ཅིག་མ །"
msgstr "The non-virtuous mind is also momentary."

msgctxt "0fc8d2af6b494e7daf07dfb29306ebc4"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "94c974b7809341cd8aaabf19562da20e"
msgid "གཞན་ ཡང་ཕྱི་ དོན་ འདོད་ ན་"
msgstr "Besides this, if external objects are accepted,"

msgctxt "e9fec87a907045a4ac9470694422e925"
msgid "མདོ་སྡེ་པ་ གཟུངས་ འཛིན་ གྲངས་ མཉམ་ དང༌ །"
msgstr ""
"The Follower of Sutra's [school] equal number of apprehender and apprehended"
" and "

msgctxt "0f2504cb9d8b40c28e5835e3bbc06579"
msgid "མེད་ ན་ སེམས་ ཙམ་ རྣམ་ བདེན་ ལ་ འགོག་པ་␣འི་ རིགས་པ་ འཇུག་ སྟེ །"
msgstr ""
"If not, the reasoning that refutes the True Aspectarian Mind Only [School] "
"would follow."

msgctxt "e18de5a8c3b74ced9360a8fc402ca324"
msgid "དབུ་མ་ རྒྱན་ ལ་␣ས །"
msgstr "According to the Ornament of the Middle Way:"

msgctxt "090d81a5d74e47f18c7c1b0bb6925d60"
msgid "དེ་ལྟ་ ཡིན་ ན་ དཀ་␣ར་ ལ་སོགས །"
msgstr "If that is the case, then the white and so on,"

msgctxt "60b09be0c1a14ce386758e314bbdaa0c"
msgid "སོགས་ དང་ རྡུལ་ཕྲན་ བདག་ཉིད་ དཀ་␣ར་ སོགས་ དང༌ །"
msgstr "So forth and the nature of minute particles is white, etc., and"

msgctxt "c1b5948b98b44644ab3219a4c5424c8a"
msgid "ཇི་སྟེ་ རྣམ་པ་␣འི་ གྲངས་ བཞིན་ དུ །"
msgstr "If it is similar to the number of aspects."

msgctxt "3f6de7fbf8d5428da6c6e3d0fab927e2"
msgid "སོགས་ དང༌ །"
msgstr "And so on. "

msgctxt "e05c9fae701d4e6186c71779d162e2e6"
msgid "གལ་ཏེ་ སྣ་ཚོགས་ དེ་ གཅིག་ ན །"
msgstr "If the various types are the same."

msgctxt "f9288428b4c44ce98961842b81367a55"
msgid "ཞེས་ སོགས་ ཀྱིས་ གནོད་ ཅིང་"
msgstr "And so on, defeat it."

msgctxt "6b2ad2e710e34b6fbe68edc2660133c4"
msgid "གང་ཟག་ གཅིག་ ཤེས་རྒྱུད་ དུ་མ་␣ར་ ཐལ་བ་␣ས་ སོ །"
msgstr "It absurdly follows that a person with many mindstreams."

msgctxt "71556f7a727f4fe98413d3e0e419505e"
msgid "རྡོ་␣༽༽་␣གཞན་ དུ་ སེམས་ གཞི་ ལ་␣ས་ སེམས་བྱུང་ འབྱུང་བ་␣ར་ འདོད་ དེ །"
msgstr ""
"Vajra: others accept that mental events emerge from the basis of mind."

msgctxt "af9ed7bd1b2444a986cb8af254226c31"
msgid "དབུས་ མཐ་␣ར །"
msgstr "According to the [Differentiating] Middle and Extremes:"

msgctxt "9497d4861faa4c18b72eabd4b57b6a87"
msgid "དེ་ ལ་དོན་ མཐོང་ རྣམ་པ་␣ར་ ཤེས །"
msgstr "Consciousness is that which sees fact in that."

msgctxt "c7ba83d1c46f47069f83d01663ed47fb"
msgid "དེ་ ཡི་ ཁྱད་པར་ ཅེས་པ་␣ས །"
msgstr "The special features of this [are that it arises from mind] and so."

msgctxt "bd2e29f79d2c4702936df790a93f9921"
msgid "སྒྲོ་འདོགས་ ཆོད་པ་␣འི་ དོན་ ལ་ སེམས་ དང་"
msgstr "The purpose of the mind is to eliminate exaggeration and"

msgctxt "741bdfef2644433d89172d689faa932c"
msgid "དེ་ནས་ རྟོག་དཔྱོད་ བྱེད་པ་␣ས་"
msgstr "then, to do analyses."

msgctxt "2c6ca8f4f00547b6ba038df583e23854"
msgid "དེ་␣འི་ ཁྱད་པར་ གྱི་ ཆོས་སེམས་ བྱུང་ དུ་ བཤད་ མོད །"
msgstr "Its distinctive features are said to be mental events."

msgctxt "780907ccc9e443ec93e2c9680e1d92ae"
msgid "འདི་␣ར་ སེམས་ལས་ སེམས་བྱུང་ འབྱུང་བ་ གཞིར་བཞག་"
msgstr ""
"In this [system], the arising of the mental events from the mind is the "
"foundation."

msgctxt "eeadc4f758bd4a3395fb2bea2b839494"
msgid "དེ་ལས་ ཀྱང་ སེམས་ ནི་ འབྱུང་བ་ འགྲུབ་ སྟེ །"
msgstr "From that as well, it is established that the mind emerges because"

msgctxt "89a899bd39de421da7eaaa5ea2e37f64"
msgid "དཔེར་ན་ བདག་ ཐེག་ཆེན་པ་ བྱ་ སྙམ་པ་ སེམས །"
msgstr ""
"For example, the mind is that which thinks I will become a follower of the "
"Great Vehicle."

msgctxt "395ea73ff2e4481ea4dafa2e5949bb78"
msgid "དེ་ ལ་ བརྟེན་ ནས་ སེམས་བསྐྱེད་པ་ སེམས་བྱུང༌ །"
msgstr ""
"The generation of the mind [for enlightenment] by relying on that is a "
"mental event."

msgctxt "c66c5aadda6847a0bd680d193bd39eb3"
msgid "དེ་␣ས་ ཐེག་ཆེན་ གྲུབ་པ་ གོང་ གི་ སེམས་ དེ་ གྲུབ་པ་␣ས་"
msgstr ""
"This will accomplish the Great Vehicle because the previous mind is "
"accomplished."

msgctxt "89279d28cdb64cc0990afd82e47fac39"
msgid "སེམས་ ཏེ་ མདོར་ན་ ཡུལ་ ལ་ གཏོད་པ་␣འི་ སྐད་ཅིག་ དང་པོ །"
msgstr "In brief, the mind is the first moment that focuses on an object."

msgctxt "2d548e269ded476d91d61db7382e378a"
msgid ""
"སེམས་ དང་ དེ་␣འི་ ཁྱད་པར་ ལ་ དཔྱོད་པ་ གཉིས་པ་ སེམས་བྱུང་ དེ་ ཟིན་པ་ སླར་ "
"སེམས་ སྐྱེ་ སྟེ །"
msgstr ""
"The mind arises again by grasping the second mental event that analyzes the "
"mind and its features."

msgctxt "b1f5109ad6a7474198dc94a7a8b18794"
msgid "སྐད་ཅིག་ གི་ ཕྲེང་བ་ ཡིན་པ་␣ར་ གསུངས་པ་"
msgstr "This is called the garland of moments."

msgctxt "8244895ef60449d3a1e29623fc613c31"
msgid "དེ་␣འི་ ཕྱིར་ འདི་␣འང་ ཡོད་པ་␣ར་ སྒྲུབ་བོ །"
msgstr "Therefore, it is established that this also exists."

msgctxt "1692d6201b2a405f80476cc9f4fb385e"
msgid "རྡོ གཞན་ དག་ ན་རེ །"
msgstr "Vajra: Others said,"

msgctxt "2747d8378e8947c69d84d20ca4a8034d"
msgid "འཁོར་བ་␣ར་ འཁོར་བ་ ནི་ སེམས་ ཡིན་ ཏེ །"
msgstr "It is the mind that cycles in cyclic existence."

msgctxt "c26304c8209e4a8db50b23767fdf0880"
msgid "སྡུག་བསྔལ་ དང་ རྣམ་སྨིན་ དེ་␣ར་ བརྟེན་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr ""
"Therefore, the suffering and the complete ripening are dependent on this."

msgctxt "9a4a3b719078446b84029a04ef918960"
msgid "ལུས་ བེམ་པོ་ ཡིན་པ་␣འི་ ཕྱིར་ ཞེས་ ཟེར་ རོ །"
msgstr "Because it is said that the body is matter."

msgctxt "f6727c86cd444b21a5bcf5afed76e184"
msgid "འདི་␣ར་ ནི་ འཁོར་བ་␣འི་ རྒྱ་མཚོ་␣ར་ ལུས་ ཉིད་ འཁོར་བ་␣ར་ བཞེད་ དེ །"
msgstr ""
"In this [system], It is accepted that the body itself cycles in the ocean of"
" cyclic existence."

msgctxt "eafe0aaca1f7451b9104b60b817d2f9e"
msgid ""
"དེ་ འཁོར་བ་␣འི་ གཞི་ རྟེན་ ཐོག་མེད་ བག་ཆགས་ ཀྱི་ ས་བོན་ རྣམས་ ཀྱིས་ གང་བ་␣ར་"
" གནས་ ཤིང༌ །"
msgstr ""
"That is the basis of samsara which is filled with seeds of beginningless "
"latency."

msgctxt "2abbc1993e0f4fedb6533aeb4b8fa190"
msgid "དེ་དག་ རྐྱེན་ དང་ ཕྲད་པ་␣ས་ རྟོག་པ་ སྣ་ཚོགས་ སྐྱེ་ ཞིང་"
msgstr "When these meet the conditions, various conceptualities would arise."

msgctxt "93ed85ced82a40bb839ade90465ca6b3"
msgid "དེ་␣ས་ ཕྱི་མ་␣འི་ ལུས་ འགྲུབ་པ་␣འི་ ཕྱིར །"
msgstr "That will produce the body of the next life."

msgctxt "9ca728cff34047eeb8688cf982ca1528"
msgid ""
"དཔེར་ན་ རྒྱ་མཚོ་ ཆེན་པོ་ སྲོག་ཆགས་ རྣམས་ ཀྱི་ རྟེན་གནས་ སུ་ གྱུར་པ་ བཞིན་ ནོ"
" ། །"
msgstr ""
"In the same manner, the vast ocean becomes a place of support for all living"
" beings."

msgctxt "7b2568e4c31e48e993b5141fbd80cdf4"
msgid "འོ་ན་ གཟུགས་ མེད་ བཞི་ སོགས །"
msgstr "Well then, the four formless [realms] and so on,"

msgctxt "673ed3b4398d4ca1aa6feeac30893af6"
msgid "དངོས་ ལུས་མེད་པ་␣ར་ ཇི་ལྟར་ འཁོར་ སྙམ་ ན །"
msgstr "If [one] wonders how they cycle in samsara without an actual body?"

msgctxt "6663bfbb62da4d2aaa0c1b1063610277"
msgid ""
"གཟུགས་ མེད་ ན་ རྣམ་རིག་ མིན་པ་␣འི་ གཟུགས་ དང་ རྨི་ལམ་ ན་ བག་ ཆག་ གི་ དང་ །"
msgstr ""
"In the formless realms, there are imperceptible forms and latency in dreams "
"and "

msgctxt "047d69560ed14b1fb64341e914bfe1f1"
msgid ""
"སྲིད་པ་ བར་དོ་␣ར་ ཡིད་ ལུས་ ཡོད་པ་␣ར་ གསུངས་པ་␣འི་ ཕྱིར་ ལུས་ འཁོར་བ་␣འོ །"
msgstr ""
"The body is samsara because it is said that there is a mental body in the "
"intermediate state of existence. "

msgctxt "d0de567a85a1442882c44647793b14ea"
msgid "ལྷན་␣༽༽  ཁོ་ན་ རེ །"
msgstr "Addendum: someone said,"

msgctxt "111fd165b55f4618a6c09cbf8f783d78"
msgid "འཁོར་བ་ མཐའ་ ཡོད་ དེ་ གས་␣ར་ སྐྱེ་ མེད་པ་␣ས་ དང་ །"
msgstr "There is an end to samsara because there is no new birth and "

msgctxt "5cd8662b799e4ecfb7f0d4878a9e27dd"
msgid "འགའ་ཞིག་ མཐའ་མེད་ དེ་ ཟོ་ཆུན་ ལྟར་ དུ་ གསུངས་པ་␣འི་ ཕྱིར་ ཟེར །"
msgstr ""
"Some [people] said there is no end because it is said to be like a "
"waterwheel. "

msgctxt "14c0ed6724964f1d828253f5501548f9"
msgid "འདི་␣ར་ ནི་ འཁོར་བ་␣འི་ གཞི་ གཤིས་ གྲུབ་པ་ མེད་ ཅིང་"
msgstr "In this [system], the basis of samsara does not exist innately."

msgctxt "441ae81d236048b0a1dd427553dbcb18"
msgid "སྣང་བ་␣འི་ ཆོས་ རྣམས་ རྟེན་འབྲེལ་ ཡིན་པ་␣ས་"
msgstr "Because all appearing phenomena are interdependent."

msgctxt "02f74b585f7442018ac14c8c2053c391"
msgid "སྐྱེ་འགག་␣ས་ གནས་ གསུམ་ སོགས་ སྤྲོས་པ་ ཐམས་ཅད་ བྲལ་བ་␣འི་ ཕྱིར་"
msgstr ""
"Because arising, ceasing, abiding and others are free from all the "
"elaborations."

msgctxt "da4992d92fb0420d9e19c2a143fd6af1"
msgid "འཁོར་བ་ ཐོག་མཐའ་ དབུས་ མེད་པ་␣ར་ བཞེད་ དེ །"
msgstr ""
"It is accepted that cyclic existence is without a beginning, middle, or end."

msgctxt "525c1b4d8c6b4ffca2617eb868f070f0"
msgid "གང་ཞིག་ རྐྱེན་ ལ་␣ས་ སྐྱེས་པ་ དེ་ མ་ སྐྱེས །"
msgstr "Whatever is born of conditions is unborn."

msgctxt "fd9a35cb92bf45bbb704b55d58b3ead0"
msgid "སོགས་ ཅེས་ སོ །"
msgstr "And so on. "

msgctxt "fe9161127b3547c5be211e0b89234213"
msgid ""
"རྡོ་␣༽༽  རྟེན་འབྲེལ་ ནི་ སངས་རྒྱས་ ཀྱི་ ཆོས་ བསྟན་པ་ ཐམས་ཅད་ ཀྱི་ སྙིང་པོ་ "
"ཡིན་ ཅིང་"
msgstr ""
"Vajra: Interdependence is the essence of all the teachings of the Buddha."

msgctxt "249475c385604baebd3c88f2790b706b"
msgid "འདི་␣འི་ དོན་ ལེགས་པ་␣ར་ ཁོང་ དུ་ ཆུད་ ནས་ བྱང་ཆུབ་ བརྙེས་པ་"
msgstr ""
"By thoroughly comprehending the meaning of this, enlightenment will be "
"attained."

msgctxt "caa826bab4454a7394d40b192d20b212"
msgid "གྲོང་ཁྱེར་ ལྟ་བུ་␣འི་ མདོ་␣ར །"
msgstr "According to the City-like sutra:"

msgctxt "039523aaa8cf43a685874bf0cf8c472a"
msgid "དགེ་སློང་ དག་ ང་ བྱང་ཆུབ་ ཀྱི་ སྙིང་པོ་ ལ་ འདུག་པ་␣འི་ ཚེ་"
msgstr "Monks, when I was staying at the essence of enlightenment, "

msgctxt "d413dbceebbb450ba2d3dfa399ac8be1"
msgid "རྟེན་ ཅིང་ འབྲེལ་བ་␣ར་ འབྱུང་བ་ འདི་ སྔོན་ དུ་ བྱས་པ་␣ས་"
msgstr "Because [I] first put an effort into this dependent-related arising,"

msgctxt "a30cfe82e8364dac8f803b5c4c998493"
msgid "ང་ བླ་ ན་ མེད་པ་␣འི་ བྱང་ཆུང་ ཏུ་ སངས་རྒྱས་ སོ ། །"
msgstr "I became a buddha in unsurpassed enlightenment."

msgctxt "b3f49b685f94474d8d00bb19c3aa9f23"
msgid "ཞེས་པ་ འདི་ ལ་"
msgstr "And to this. "

msgctxt "4f7c738848424662a7843ccb7aeba431"
msgid ""
"ཕྱི་ རྒྱུ་ས་ བོན་ རྐྱེན་ འབྱུང་ ལྔ་ དུས་ ཀྱི་ འགྱུར་བ་ དྲུག་ ཚོགས་པ་␣ས་ "
"འབྲས་བུ་འབྱུང་བ་ དང༌ །"
msgstr ""
"The result occurs by the accumulation of the outer cause, the seeds, the "
"conditions, the five elements, and the six changing times."

msgctxt "7c6dbf5aaebf48b1a50c3c888f4d9b1a"
msgid ""
"ནང་ རྒྱུ་མ་ རིག་པ་ རྐྱེན་ ཁམས་ དྲུག་ ལ་ བརྟེན་ ནས་ རྒ་ཤི་␣འི་ བར་ "
"ལུགས་འབྱུང་ དང་ དེ་ ལྡོག་པ་ ལུགས་ལྡོག་ སྟེ་"
msgstr ""
"Based on the inner cause as ignorance, and conditions as the six "
"constituents, the forward order is up to aging and death, while the reverse "
"order is the reversal of these."

msgctxt "40cef5ffdc7b44e796d22ac5e61e2db7"
msgid "དེ་ གཉིས་ བདག་མེད་ བཞིན་ དུ་ འབྲས་བུ་འབྱུང་ ཞིང་"
msgstr ""
"Although both of these are lack of self, [they] still produce results."

msgctxt "f738306a844849dba221f6712f272cf7"
msgid "རྟག་ཆད་ དང་ བྲལ་བ་␣ས་ རྟེན་འབྲེལ་ མདུང་ ཁྱིམ་ ལྟ་བུ་ སྟེ་"
msgstr ""
"Because of being free from permanence and nihilation, [they] are "
"interdependent like a bundle of reeds."

msgctxt "74fb7bb70b1f466da8463febce308c9d"
msgid "དེ་དག་ ལས་མ་ རིག་པ་ ནི་ བཅུ་གཉིས་ ཀྱི་ ཡ་ རྒྱལ་ གཅིག་ ཡིན་ ཟེར །"
msgstr ""
"From these, it is said that ignorance is one of the twelve [links of "
"dependent relationship]."

msgctxt "01dd374298404f64ba55bbdc753f804e"
msgid ""
"འདི་␣ར་ ནི་ རྟེན་འབྲེལ་ བཅུ་གཉིས་ མ་རིག་ ཁོ་ན་␣འི་ གཡོས་ སམ་ འཕྲུལ་ ཏེ་ "
"མ་རིག་ ཡོད་ ན་"
msgstr ""
"In this [system], the twelve links of dependent relationship are moved or "
"tricked by ignorance alone. "

msgctxt "eabb5aa3b91f4b2fbd43456470174d00"
msgid "རྒ་ཤི་␣འི་ བར་ ཡོད་ དུ་ཡོད་པ་␣ས་ དང༌ །"
msgstr "It exists up to ageing and death when it is present and"

msgctxt "577ca07e5b074c5f958196c76c28233a"
msgid ""
"མ་རིག་ འགག་ ན་ རྒ་ཤི་␣འི་ བར་ དུ་ འགག་པ་␣ས་ ཀྱང་ མ་རིག་པ་␣འི་ གཡོས་ ཏེ །"
msgstr ""
"When ignorance ceases, up to ageing and death will be ceased, because this "
"is the movement of ignorance."

msgctxt "f3979e4863854dc6a9b3a11fd9d0bf92"
msgid "སྡུད་པ་ ལ་␣ས །"
msgstr "According to the Condensed [Prajnaparamita In Verse]:"

msgctxt "ae21b9aa3f94490a8cbacd56d2723491"
msgid "སེམས་ཅན་ ཐ་མ་ འབྲིང་ དང་ མཆོག་གྱུར་ ཇི་ ཞེས་པ་ ཡིན་ ཅིང་ །"
msgstr "Any sentient being, no matter how inferior, middling, or superior."

msgctxt "52234748f2704262b0ad1865d5902e01"
msgid "མ་རིག་པ་ སྒོམ་ བྱུང་ ཟག་མེད་ ཀྱི་ ཤེས་རབ་ ཀྱིས་ སུན་ ཕྱུང་ ན་"
msgstr ""
"If [one] defeats ignorance with the undefiled wisdom gained through "
"meditation,"

msgctxt "e0e05cae7a1847b093d26dea39a42278"
msgid "ཟག་མེད་ ཀྱི་ ཡོན་ཏན་ ཐམས་ཅད་ ཐོབ་ སྟེ །"
msgstr "All the undefiled qualities will be attained."

msgctxt "f5b9887f67ef46e787a75398740c917a"
msgid "ཡེ་ཤེས་ ཚུལ་ སྒོ་ ཐབས་ དང་ རྩ་བ་ ཇི་སྙེད་པ །"
msgstr " All the doors of method and root as a mode of wisdom."

msgctxt "ee8a94103395483f8c53c601b62eaf80"
msgid "ཞེས་ སོགས་པ་␣ས་"
msgstr "And so on. "

msgctxt "359d3c29449a4450be143d329b820994"
msgid "དམིགས་ མཚན་ དུ་ འཛིན་པ་␣ས་ མ་རིག་པ་ སྟོབས་ སུ་ གྱུར་ ཅིང་ །"
msgstr ""
"Ignorance becomes powerful because of grasping at the mark of observation, "

msgctxt "754db6cff71f453f8d2047e715b2cf77"
msgid "བཅུ་གཅིག་པོ་ ལ་ རང་དབང་ མེད་པ་␣ས་ སོ །"
msgstr "The eleven have no independence."

msgctxt "55757d1963ff4576af5e9ea2908dd8ba"
msgid "རྡོ་␣༽༽  གཞན་ ཤེས་ ལ །"
msgstr "Vajra: In the knowledge of others,"

msgctxt "650b321c3f6b49aa87b185b2bc70ef3d"
msgid "རྟེན་འབྲེལ་ བཅུ་གཉིས་ ནི་ གསུམ་ དུ་ འདུ་ སྟེ །"
msgstr ""
"The twelve links of dependent relationship can be grouped into three "
"[categories]."

msgctxt "9ea37e79acab4931abe5c2cfeb1e4380"
msgid "དང་པོ་ བརྒྱད་པ་ དགུ་ ཉོན་མོངས་ གཉིས་པ་ བཅུ་པ་ ལ་␣ས་ ཡིན་ ཏེ །"
msgstr ""
"The first, eighth, and ninth are afflictions, while the second and tenth are"
" karma."

msgctxt "1e6d9c6f86c84ef99c49ebc9f2866de0"
msgid "ལྷག་མ་ རྣམས་ ནི་ སྡུག་བསྔལ་ ལོ །"
msgstr "The remaining are suffering."

msgctxt "3c26bd334616490b849d6ad30f53fe3b"
msgid "ཞེས་པ་␣ས་"
msgstr "Thus,"

msgctxt "9a507c9fb6e54b09a063fe09003ff625"
msgid "རིམ་བཞིན་ ལྷག་ སྔ་མ་ ད་ལྟ་ ཕྱི་མ་ གསུམ་ ལ་␣ས་ རྫོགས་ ཟེར །"
msgstr ""
"Subsequently, the remaining ones are said to be completed from the three- "
"the previous [ones], present [ones], and latter [ones]."

msgctxt "c1c5a335b3014f1283bd4e518cf7875e"
msgid "འདི་␣ར་ བཅུ་གཉིས་པོ་ དེ་ཡང་"
msgstr "In this [system], the twelve [links] are"

msgctxt "b5e6cf18bf8f4ab2a7e377ed937d8bcc"
msgid "རིམ་བཞིན་ ལྷག་ སྔ་མ་ ད་ལྟ་ ཕྱི་མ་ གསུམ་ ལ་␣ས་ རྫོགས་ ཟེར །"
msgstr ""
"Subsequently, the remaining ones are said to be completed from the three- "
"the previous [ones], present [ones], and latter [ones]."

msgctxt "9b955332d693457ab9b6b72c2747ac6c"
msgid "འདི་␣ར་ བཅུ་གཉིས་པོ་ དེ་ཡང་"
msgstr "In this [system], these twelve [links]"

msgctxt "30b69dbb5391472bb2799008e09b9c71"
msgid "སྐད་ཅིག་ གཅིག་ ལ་ ཚང་བ་␣ར་ འབྱུང་བ་␣འང་ ཡོད་ དེ་"
msgstr ""
"There are also occasions when [all the twelve links] complete a single "
"moment."

msgctxt "ea1419e744d9402d80b18388477ecf1e"
msgid ""
"ཞེ་སྡང་ རྟོག་པ་ སྐྱེས་པ་ མ་རིག་པ་␣འི་ དབང་ ལ་␣ས་ སྦྱོར་བ་ མགོ་ ཙམ་པ་ "
"ཉོན་མོངས་པ་␣འི་ དུམ་བུ་ དངོས་གཞི་ འདུ་ བྱས་ ཏེ །"
msgstr ""
"The arising of aversion and conceptuality is merely an initial preparation "
"under the force of ignorance, and compounding is the actual section of "
"affliction."

msgctxt "ded7d8aa20784f9594e245d22258027d"
msgid "སྤྱོད་པ་ ལ་␣ས་ ཀྱི་ དུམ་བུ །"
msgstr "Conduct is the section of action."

msgctxt "fcad44134a4a4c58bf0c65593b656eac"
msgid "རྗེས་ ཐིམ་པ །"
msgstr "Subsiding into imprint,"

msgctxt "0d85b55dbc5d4772b79fb6acf5727acd"
msgid "སྡུག་ འསྔལ་ གྱི་ དུམ་བུ་ སྟེ་"
msgstr "Is the section of suffering."

msgctxt "413b5233f54843b6a6ca8100d15230ae"
msgid ""
"རྟོག་པ་ གཅིག་ སྐྱེས་པ་ ནས་ འགགས་པ་␣འི་ བར་ ལ་ ཚང་བ་␣ར་ འབྱུང་བ་␣ར་ འགྲུབ་བོ "
"།"
msgstr ""
"Thus, it is established as a complete emergence that all moments from the "
"arising to the cessation of a single conceptuality."

msgctxt "85d4dd510e97432a98cdbb9db3c51935"
msgid ""
"རྡོ་␣༽༽  འཇིག་རྟེན་ གྱི་ ཚད་ དང་ བྱུང་ཚུལ་ ཆགས་ གནས་ འཇིག་ སྟོང་ མི་ གཅིག་པ་"
" དུས་འཁོར །"
msgstr ""
"Vajra: The Kalachakra depicts the varying sizes of the world [systems] and "
"how they occur, such as formation, abiding, and destruction."

msgctxt "977462b6f4c74166be2874d225217348"
msgid "རྟ་མགྲིན་ གཤམ་པ་ བཀོད་པ །"
msgstr "Hayagriva is arranged below."

msgctxt "0fc77fe80191493f93aa8ec6351a0067"
msgid "འདུལ་བ་ གདགས་པ །"
msgstr "Designation of Vinaya"

msgctxt "fe4f4a8efd644d098375572c284e3780"
msgid "དྲན་ ཉེར་ སོགས་ ལ་␣ས་ དུ་མ་ འབྱུང་བ་"
msgstr "Many emerge from mindfulness and so on."

msgctxt "6864f724ad2d42cdb67681ecbd46e097"
msgid "སྙན་ངག་ ལྟར་ བཤད་པ་ དང་ གནས་ལུགས་ ལྟར་ བཤད་པ་ གཉིས་ སུ་ ཡོད་ ཟེར །"
msgstr ""
"It is said that there are two ways of expositions: expostulate like poetry "
"and expostulate like reality."

msgctxt "129a51d388014eaf8d8c719c0cac97d7"
msgid "འདི་␣ར་ ནི་ སེམས་ ནི་ ཐ་དད་ དབང་ གིས་ སྣང་བ་ ཡང་ཐ་ དད་ དེ །"
msgstr "In this [system], appearances are distinct because of distinct minds."

msgctxt "e032e649ec8b4c239b3ec417837259ab"
msgid "དོན་དམ་པ་␣ར་ སྣོད་བཅུད་ གང་ཡང་ མ་ གྲུབ་ མོད །"
msgstr "In the absolute sense, neither the container nor its content exist."

msgctxt "ab184f0d78bf491a8b44b87c19d7d070"
msgid "ཚུ་རོལ་ མཐོང་བ་␣འི་ ངོ་␣ར་ བག་ཆགས་ ཀྱི་ ཁམས་ དང་"
msgstr "The realm of latency on the face of seeing it on this side and "

msgctxt "959dff8fb9464897a725054db614b29a"
msgid ""
"ཆོས་ ཐ་དད་པ་␣ས་ སྒྲུབ་པ་␣འི་ སྣང་བ་ བསོད་ནམས་ བསགས་ ཚུལ་ གྱི་ བྱེ་བྲག་ གིས་ "
"ཏེ །"
msgstr ""
"The appearance of diversely established phenomena is due to the particular "
"ways of merit accumulation. "

msgctxt "61d17e0e16734e7685effe8b84d86dbc"
msgid "རྡོ་རྗེ་ གུར་ ལ་␣ས །"
msgstr "According to the Vajra Dome:"

msgctxt "c1ebf97c26c643b09e761ac5443b40b8"
msgid "ཡུལ་ དང་ དབང་པོ་␣འི་ བྱེ་བྲག་ རྣམས །"
msgstr "The particulars of the object and the faculties."

msgctxt "b5cb9a444a7a4ba2b906344c7bae57c9"
msgid "རྣམ་པ་ ཐ་དད་ མ་ མཆིས་ ཏེ །"
msgstr "There are no distinct aspects."

msgctxt "2ee52a0b7d08414f97a8076a02403859"
msgid "གཟུགས་ སོགས་ སྣང་བ་␣ར་ གྱུར་པ་ ནི ། །"
msgstr "The appearance of form and so on."

msgctxt "9f4d7f81b3ea499ab33fb40d02dd14c6"
msgid "རང་སེམས་ ཁོ་ན་␣ར་ སྣང་བ་␣འོ ། །"
msgstr "It only appears to the mind."

msgctxt "41b32a38954546219e753f3d6866f470"
msgid "ཞེས་ དང་ །"
msgstr "And"

msgctxt "a997830c9fdc48e0bb53380a557c0d11"
msgid "དྲིམ་ མེད་པ་␣ར་ གྲགས་པ་␣འི་ མདོ་ ལ་␣ས །"
msgstr "According to the Vimalakirti sutra:"

msgctxt "a22edcb1d2ba4351ab6e3401bd08426b"
msgid "ལྟ་བ་ ཐུན་མོང་བ་ གཅིག་ ལ་"
msgstr "In a single common view"

msgctxt "b2c37f451876483994ac56dcd86d9604"
msgid "ཤཱ་རི་␣འི་ བུས་ རང་རོང་ ཅན་ དུ་ མཐོང་ ཞིང་"
msgstr "Shariputra saw it was uneven."

msgctxt "ed9908d1b411458bbf9c0cc6cc520232"
msgid ""
"ཚངས་པ་ རལ་བ་ ཅན་ གྱིས་ རྣམ་པ་␣ར་ དག་པ་␣འི་ ཞིང་ དུ་ མཐོང་བ་␣ར་ གསུངས་པ་ དང༌ "
"།"
msgstr "It is said that Brahma Ralpachen saw it as a pure sphere."

msgctxt "2c634548e83144c3af5225f2847b79a8"
msgid "སྤྱོད་འཇུག་ ལ་␣ས །"
msgstr "According to the Engaging in the Bodhisattva's Conduct:"

msgctxt "33906de383284df4b6a53f44880d8255"
msgid "ལྕགས་ བསྲེག་ ས་གཞི་ སུ་ ཡིས་ བྱས །"
msgstr "Who created the molten iron base? "

msgctxt "f52d4bc9e4e14f8aacf19f9c588c7027"
msgid "སོགས་ གསུངས་པ་␣ས་ ཆུ་ ལ་ འགྲོ་བ་ དྲུག་ གིས་ མཐོང་བ་ བཞིན་ ནོ །"
msgstr "And so forth. This is similar to the water seen by the six migrators."

msgctxt "28040b3e89934e00aa2ad4b776618fc4"
msgid ""
"རྡོ་␣༽༽  བདེ་སྡུག་ རྣམས་ སྔོན་ གྱི་ ལ་␣ས་ ཁོ་ན་␣ར་ ལས་ཤིང་ རྐྱེན་ གྱིས་ "
"བསྒྲུབས་ ཀྱང་ ལ་␣ས་ དེ་ མི་ འགྱུར་ ཟེར །"
msgstr ""
"Vajra: [Others] said that happiness and unsatisfactoriness are only because "
"of [ones] previous karma, and [it] may be produced by conditions, this karma"
" will not change."

msgctxt "cb4a8e725426446cb77c776eb4ee112e"
msgid "འདི་␣ར་ ནི་ དེ་␣ར་ མ་ངེས་པ་"
msgstr "In this [system], there is no definite in that."

msgctxt "e56fb1a50d254f3795af2af93c749890"
msgid ""
"ད་ལྟ་ ཉིད་ དུ་ ལ་␣ས་ གང་ བསྒྲུབས་ འབྲས་བུ་␣ར་ ལོངས་སྤྱོད་པ་␣འང་ ཡོདདེ །"
msgstr ""
"There is also enjoying of results concurrent with whatever actions one "
"produces."

msgctxt "c98075ef57184805bb22e17043210de6"
msgid "ཆོས་ ཀུན་ རྐྱེན་ ལ་ བརྟེན་པ་ དང༌ །"
msgstr "All phenomena depend on conditions and,"

msgctxt "fa63bc9d47c640bebbd48a4e5862e7cc"
msgid "སྐད་ཅིག་མ་ ཡིན་པ་␣འི་ གནད་ ཀྱིས་"
msgstr "Because of essentially being momentary. "

msgctxt "93ead7fdefc043aba596b05a1b08b82e"
msgid "ད་ལྟ་ བླ་མ་ དང་ རྒྱལ་པོ་ ལྟ་བུ་ མཉེས་པ་␣འི་ ལ་␣ས་ བསྒྲུབ་ ན་"
msgstr ""
"At present, if [one] performs actions that please others, such as a guru or "
"a king,"

msgctxt "88578415796442bd8e818efc28162d07"
msgid "གདམ་ ག་ དང་ བྱ་དགའ་ ཐོབ་ ཅིང་"
msgstr "[One] will receive a choice and a reward."

msgctxt "f741067cbe6e488abfc63e057b57708a"
msgid "མ་ མཉེས་ ན་ དེ་ལས་ ལྡོག་པ་ དེ་"
msgstr "When [one] acts in an unpleasant way, the reverse occurs."

msgctxt "99fcfe891ada4435a9f3e74c45b4aa72"
msgid ""
"སྔོན་ལས་ ཁོ་ན་␣ར་ མི་ ལྟོས་པ་␣ར་ མཉེས་ མ་ མཉེས་ ཀྱི་ ཁྱད་པར་ ཡིན་པ་␣ར་ "
"གྲུབ་བོ །"
msgstr ""
"This establishes that it is not only dependent on previous karma but it is a"
" difference between pleasant or unpleasant action."

msgctxt "0f650184e3414f72a0a750d40e8363b5"
msgid ""
"ཐམས་ཅད་ སྔོན་ལས་ ཡིན་ ན་ རྒྱུ་␣ར་ སྨྲ་བ་␣འི་ ཞེ་འདོད་ ཡིན་པ་␣ས་ དོར་བ་␣ར་ "
"བྱོས་ ཤིག"
msgstr ""
"If everything is due to previous karma, because this is the stance of the "
"cause-proponent, [one] should discard it. "

msgctxt "d5294b761e2345e3b4cf1ac4d94be349"
msgid "རྡོ་␣༽༽  གཞན་དག་ ན་རེ །"
msgstr "Vajra: Others said."

msgctxt "b413f8e2b3c54544b1db620d61ab06b5"
msgid "བསྐལ་པ་ ཡར་ འཕེལ་ མར་ འགྲིབ་ རང་བཞིན་ བབས་ ཀྱིས་ འབྱུང་ སྟེ་"
msgstr "The aeons wax and wane in their natural state."

msgctxt "64bbfe8d05b44665a7f77a6093d532b7"
msgid "འཕེལ་བ་ ན་ ཐབས་ གང་ གིས་ ཀྱང་ མི་ འགྲིབ །"
msgstr "It is by no means waning when it waxes."

msgctxt "e3b374d670e84f95885988521bfbd8a5"
msgid "འགྲིབ་པ་ ན་ ཐབས་ གང་ གིས་ ཀྱང་ མི་ འཕེལ་ ཟེརཡང་ །"
msgstr "It is by no means waxing when it wanes. Though it is said so."

msgctxt "ebafd29718834c87bb533240029e93d7"
msgid "འདི་␣ར་ དུས་ ཀྱི་ འཕེལ་འགྲིབ་ ད་ལྟར་ ཡང་ བྱ་␣ར་ ཡོད་པ་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], the waxing and waning of time can also be done at present "
"because"

msgctxt "0f8d15e619f441889a0135b9557eda6c"
msgid ""
"དེ་␣འི་ རྒྱུ་ དགེ་ མི་དགེ་ ཞེས་ བྱ་བ་ ལོ་ བརྒྱད་ ཁྲི་␣འི་ ས་ ནས་ བརྒྱད་ "
"བཅུ་␣འི་ བར་ དུ་ འགྲིབ །"
msgstr ""
"The causes of these are known as virtue and non-virtue, which wane from a "
"ground of eighty thousand to eighty years."

msgctxt "2bada7d9963a4b16a0dd2f6f2aff6b80"
msgid "དེ་ ཚེ་ རང་ རེ་␣འི་ སྟོན་པ་ གདོལ་བ་ སྟོབས་ཆེན་ དུ་ སྐྱེ་བ་ བཞེས་ ན་"
msgstr ""
"If [one] accepts that at that time, our teacher will take birth as Great "
"Strength Candala."

msgctxt "1245d0bc78084ac79d323b50a54db725"
msgid ""
"སུ་␣ས་ སེམས་ཅན་ གྱི་ སྲོག་ བཅད་ ན་ ངས་ དེ་␣འི་ སྲོག་གཅོད་ ཅེས་ བསྒྲགས་ ཏེ་"
msgstr "\"Whoever kills a sentient being, I will kill them.\" was proclaimed. "

msgctxt "b9550637bd0a42b7b357d84d15551156"
msgid "རིམ་གྱིས་ ཆོས་ འཅུ་ དྲུག་ ལ་ བཀོད་པ་␣ས་"
msgstr "He gradually placed them in the sixteen dharmas."

msgctxt "ec947eadf5234082a2f4c31c58308a50"
msgid "ལྔ་ བརྒྱ་␣འི་ བར་ དུ་ འཕེལ་བ་␣ར་ གསུངས་པ་"
msgstr "It is said that this will increase to five hundred years."

msgctxt "888ac8bd689b4b2b81be159588fd47a5"
msgid "ཆུ་ལུད་ དྲོད་གཤེར་ ཚོགས་པ་␣འི་ ས་བོན་ གྱི་ མྱུ་གུ་ བཞིན་ ནོ །"
msgstr ""
"It is like the sprout of a seed from an accumulation of water, manure, heat,"
" and moisture."

msgctxt "9323dd147887486f89edcc98a0af4a0a"
msgid "རྡོ་␣༽༽  ཁོ་ན་ རེ"
msgstr "Vajra: Someone said,"

msgctxt "cc4026babe214cf792da673b7f6da3cf"
msgid "ད་ལྟར་ གྱི་ དུས་ སུ་ སྐྱེས་ ནས་ མྱོང་ གྱུར་ དང་"
msgstr "In the present time, [karma] to be experienced in the next birth and "

msgctxt "eb1555778fe64c139e5f1a29754d44c7"
msgid "ལན་ གྲངས་ གཞན་ ལ་ མྱོང་ འགྱུར་ མ་གཏོགས་ མཐོང་ཆོས་ བྱུང་ ཟེར་ རོ །"
msgstr ""
"It is said that apart from the [karma] to be experienced in other lifetimes,"
" [karma] to be experienced in this lifetime occurs."

msgctxt "a93502c1c6594e8493e65d1524437091"
msgid "སྐབས་ འདི་ ན་"
msgstr "At this point,"

msgctxt "b7e515b66a814645a202eee514bc6d54"
msgid "ཚེ་ འདི་␣ར་ རང་ ལ་ མཐོང་ཆོས་ གཙོ་བོ་␣ར་ འབྱུང་ སྟེ །"
msgstr ""
"[Karma] to be experienced in this lifetime occurs chiefly in this life."

msgctxt "42f36688c0924e7ead8b633f7f267625"
msgid "མ་སྐྱེས་དགྲ་␣ས་ མཐོང་ཆོས་ གང་ ལགས་ ཞུས །"
msgstr "Ajatashatru asked, \"What is that to be experienced in this lifetime?\""

msgctxt "cae82e10d2394718b3e4572bb7117b5d"
msgid "ཁྱོད་ ཀྱི་ འབངས་ ཐ་ཆད་ ཞིག་ ང་ ལ་␣ས་ རབ་ཏུ་ བྱུང་ སྟེ་"
msgstr "Some of your worst people who took ordination from me."

msgctxt "2d7ecb22f52b46c5b574967ffae04deb"
msgid "ཁྱོད་ ཀྱི་ ས་␣ར་ ཕྱིན་ ན་ ཐ་ཆད་ བྱ་␣འམ་ གསུངས་པ་␣ས །"
msgstr "\"If they go to you, will they be the worst?\" as said. "

msgctxt "c1393e2ea8a14e46ae0d12e893a47b1f"
msgid "དེ་ འདྲ་ ལྟ་ཅི་ བདག་ གིས་ ཕྱག་ དང་ བསྙེན་བཀུར་བ་ ཡིན་ ཞུས་པ་␣ས །"
msgstr ""
"\"How could it be? I have paid homage and respectfully honored.\" [He] "
"replied."

msgctxt "a53ecf1f0738400f80136776a6f20039"
msgid "དེ་ མཐོང་ཆོས་ ཡིན་ གསུངས་"
msgstr "\"This is that which experiences in this lifetime,\" said [the Buddha]."

msgctxt "d9e250ebf0854ad58d3cf0e22ecdbc99"
msgid "དེ་ལྟར་ དེང་སང་ ལ་␣འང་ ཕལ་ཆེར་ རབ་ཏུ་ བྱུང་བ་ དང༌ །"
msgstr "Thus, even these days, most of those who have taken ordination and"

msgctxt "22309df1d3914d2f8f0e0742106bb308"
msgid "བྱང་ཆུབ་ ཀྱི་ སེམས་བསྐྱེད་པ་ དང་"
msgstr "Generated the mind for enlightenment and "

msgctxt "83c75b7968634b16bcfb82396cada98e"
msgid ""
"སྔགས་ ལ་ ཞུགས་པ་ དག་ མཐོང་བ་␣འི་ ཆོས་ ལ་ སྤྱོད་པ་␣ར་ མངོན་སུམ་ གྱིས་ གྲུབ་བོ"
" །"
msgstr ""
"Entered the mantra, their engagement with the experiences in this lifetime "
"is established by direct perception."

msgctxt "37b8713fb4af4f84ad09b6b95fa1f2dc"
msgid "རྡོ་␣༽༽  དགེ་ བཅུ་␣འི་ ཁ་␣ར་"
msgstr "Vajra: In addition to the ten virtues,"

msgctxt "9935be4292844be297143bf6baf070d5"
msgid "ཕ་མ་ དགེ་སྦྱོང་ བྲམ་ཟེ་␣ར་ ཤེས་པ་ བཞི་"
msgstr ""
"Recognizing mother, father, virtuous practitioners, and brahmins are the "
"four."

msgctxt "82f49f3bb3604c61be768056d1167c48"
msgid "རྒན་ ལ་ རིམ་གྲོ་ སྦྱིན་ གཏོང་ སྟེ་ བཅུ་དྲུག་ མི་ཆོས་ ཡིན །"
msgstr ""
"Respecting elders and practicing generosity, these sixteen are human "
"conduct."

msgctxt "e1bbcfc17a6c4eb998a209246542f364"
msgid "ལྷ་ཆོས་ དེ་ལས་ གཞན་ ཏེ །"
msgstr "Divine conduct differs from these because"

msgctxt "ab615bc9c94d42068714483f801f7bc9"
msgid "མི་ཆོས་ མཁས་པ་ ལྷ་ཆོས་ ཡིན ། །"
msgstr "Being skilled in human conduct is divine conduct."

msgctxt "b51c6a338dea421e9223c23022010183"
msgid "མཐུན་འཇུག་ མཁས་པ་ ཟོལ་ཟོག་ ཡིན་"
msgstr "The wise who conform are fake."

msgctxt "7bd2c1139afc4c81938186f8943ea763"
msgid "ཅེས་ གསུངས་ སོ་ ཟེར །"
msgstr "And that is stated."

msgctxt "f445d487a1084422aec08ae5a93d7082"
msgid "འདི་␣ར་ ནི་ ལྷ་ཆོས་ སྡོམ་པ་ གསུམ་ ཀ་␣འི་ སྐབས་ སུ་"
msgstr "In this [system], In all the three vows of divine conduct, "

msgctxt "0d69e59279724e1299c0cbbb434725c1"
msgid "གཞན་དོན་ དུ་ འཁོར་བ་ འདའ་ འདོད་ ཀྱི་ བསམ་པ་␣ས་"
msgstr "The thought of wishing to transcend samsara for the sake of others"

msgctxt "4376e30e17a54eeaa726d1b184b89154"
msgid "སྒྲུབ་ དགག་ དེ་ལས་ གཞན་ མེད་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "Other than attainment and negation, there is nothing."

msgctxt "deb0c26a1c1e4ceb8f557ad9b726b8a0"
msgid ""
"འདི་ དང་ ལྡན་ ན་ མི་ཆོས་ ཀྱི་ ཡོན་ཏན་ ཕྲ་མོ་ ནས་ མཆོག་ གི་ དངོས་གྲུབ་ བར་ "
"འབྱུང་བ་␣ར་ གཅིག་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"If one possesses it, it is the same from emerging of the subtle qualities of"
" human conduct to the supreme accomplishment. "

msgctxt "20fbd613692b49f3a3780ff8530596f1"
msgid "མི་ ལྡན་ ན་ ཉེ་␣ས་ ཚོགས་ སྡུག་བསྔལ་ འབྱུང་བ་␣ར་ གཅིག་པ་␣འི་ ཕྱིར །"
msgstr ""
"If one does not possess it, it is the same as the emerging of the "
"accumulation of faults and suffering. "

msgctxt "58721578e24a4b099d92ce77989dc1ce"
msgid "སློབ་དཔོན་ འཕགས་པ་␣ས །"
msgstr "Master Arya said:"

msgctxt "705261db2183415896e3ff52d10f024c"
msgid "མི་ ཡི་ ཆོས་ལུགས་ ལེགས་སྤྱད་ ནས །"
msgstr "Practicing the conduct of humans in an excellent manner. "

msgctxt "e4f37523f4234e00b4a7fa9190afddf9"
msgid "ལྷ་ཡུལ་ སོགས་ གསུངས་པ་␣ས་"
msgstr "The realm of divines and so forth, as said."

msgctxt "872147211f374612b420dc58920a3108"
msgid ""
"མི་ཆོས་ བཅུ་དྲུག་ ལྷ་ཆོས་ དང་ གནད་ དམ་དོན་ གཅིག་ སྟེ་ མཚུངས་པ་␣ར་ གྲུབ་བོ །"
msgstr ""
"It therefore establishes that, in essence or meaning, the sixteen human "
"conducts are the same as the divine conducts."

msgctxt "0100f644d445489cb8e2021033a9a758"
msgid "རྡོ་␣༽༽  བསྟན་པ་␣འི་ གནས་ཚད་ གསུང་རབ་ རྣམས་ ནས་ དུ་མ་ ཞིག་ གསུངས་ ཀྱང་"
msgstr ""
"Vajra: Although the doctrine's duration is mentioned numerous times in the "
"canons. "

msgctxt "063830d1df5d4f028646163589256828"
msgid "འབུམ་ ཊིཀཱ་པ་␣ས་ བསྟན་པ་ ལྔ་ བརྒྱ་ ཕྲག་ བཅུ་ ལ་␣ས་"
msgstr ""
"According to the commentary on the One Hundred Thousand Verses: the doctrine"
" will last ten periods of five hundred years each."

msgctxt "16c567b8eecc4dc696903bde59cb72d4"
msgid "དང་པོ་ གསུམ་ རིམ་བཞིན་ དགྲ་བཅོམ་ དང་ ཕྱིར་ མི་ འོང་ དང་ །"
msgstr "The first three are the period when arhats, non-returners, and  "

msgctxt "f956172ec34745f4b592231e541cef79"
msgid "ལན་ཅིག་ ཕྱིར་ འོང་ རྒྱུན་ཞུགས་ འབྲས་བུ་ ཐོབ་པ་␣ར་ དེ་␣འི་ དུས །"
msgstr "Once-returners respectively attain the fruits of stream-entry."

msgctxt "8faddf44045c4b4b8afeeb238bf9a89c"
msgid "བར་པ་ གསུམ །"
msgstr "The three intermediates are"

msgctxt "44028b85effa4a46b91c18430f6403cd"
msgid ""
"ཤེས་རབ་ དང་ །  ཏིང༌ངེ༌འཛིན་ དང་ །  ཚུལ་ཁྲིམས་ ལྡན་པ་␣ས་ སྒྲུབ་པ་␣འི་ དུས །"
msgstr ""
"The period of accomplishment because of being endowed with wisdom, "
"concentration, and discipline."

msgctxt "910fa68d821f44d1b36d807b11994ed8"
msgid ""
"ཕྱི་མ་ གསུམ་ མངོན་པ་ དང་ །  མདོ་སྡེ་ དང་ །  འདུལ་བ་␣འི་ དུས་ ཏེ་ ལུང་ གི་ "
"དུས །"
msgstr ""
"The latter three are the period of the Abhidharma, sutra, and Vinaya, or the"
" period of scripture."

msgctxt "e00e68f7df384c258c86d6e0e5b0616e"
msgid "དེང་སང་ མདོ་སྡེ་␣འི་ དུས་ ལ་ ཡོད་པ་␣ས་ འབྲས་བུ་ མི་ སྐྱེ་ ཟེར་ རོ ། །"
msgstr ""
"It is said that no fruit would arise because the present time is the "
"Abhidharma period."

msgctxt "5958ceef4ac24aca994d55e470cb5fa0"
msgid ""
"འདི་␣ར་ ནི་ དཀོན་མཆོག་ གསུམ་ རྟག་པ་␣འི་ གནད་ ཀྱིས་ ཉམས་ སུ་ ལེན་པ་ ཡོད་ ན་"
msgstr ""
"In this [system], if there is [one who] practices the three jewels in the "
"essence of eternity."

msgctxt "1f6f59421fd24d6b819923b8f6ae2a35"
msgid "འབྲས་བུ་ ཐོབ་པ་ རྒྱུན་ མི་ ཆད་པ་ འབྱུང་ སྟེ །"
msgstr ""
"The attainment of the fruit will occur continuously without interruption."

msgctxt "3a324e8865164ccea0f93c0355552800"
msgid "ཟླ་བ་ སྙིང་པོ་␣འི་ མདོ་␣ར །"
msgstr "According to the Moon of the Essence sutra:"

msgctxt "04760727944b4f2497bbd38b5be860d6"
msgid ""
"བསྟན་པ་ ནུབ་ ཁ་␣ར་ རྒྱལ་པོ་ དཔུང་ མར་ ཅན་ གྱི་ རིང་ ལ་ དགྲ་བཅོམ་པ་ དེས་པ་ "
"དང་"
msgstr ""
"At the time of the decline of the doctrine, during the reign of King "
"Pungmarchen, the arhat Surata and "

msgctxt "46c46c42d7134c85a9fbb508c97b8a1e"
msgid "ཁྲོ་ མ་ དུས་ མཇུག་ ལ་␣ས་ ཚེ་ལོ་ བཅུ་པ་␣འི་ དུས་"
msgstr ""
"From the final period of the wrathful female deities, during the period of "
"the ten-year life span,"

msgctxt "a541bb4378314442bf0bbd325868ce0f"
msgid ""
"རྒྱལ་པོ་ རྡོ་ རྟ་ཅན་ གྱི་ རིང་ ལ་ དགྲ་བཅོམ་ གཉིས་ འབྱུང་བ་␣ར་ གསུངས་ ཤིང༌ །"
msgstr ""
"It is said that there will be two arhats during the reign of King Dotachen."

msgctxt "c20fcd36c76d413598f402158346bbc3"
msgid ""
"མ་ སྒྲུབ་ ན་ སངས་རྒྱས་ བཞུགས་ ཀྱང་ མི་ ཐོབ་པ་ ལྷ་ སྦྱིན་ དང་ ལེགས་ སྐར་ "
"བཞིན་ ནོ ། །"
msgstr ""
"If [one] does not practice, even if the Buddha is alive, one will not attain"
" [liberation] like Devadatta and Sunakshatra."

msgctxt "136f72fcf8884347b4905eac93ae8e48"
msgid "གསེར་འོད་ ལ་␣ས་ ཀྱང །"
msgstr "Also, the Golden Light says:"

msgctxt "ffc328e23e1944aeb6eb01e5178b1e62"
msgid "སངས་རྒྱས་ མྱ་ངན་ ཡོངས་ མི་འདའ །"
msgstr "The Buddha will not pass into final nirvana."

msgctxt "92b2ea98cf58436e90cd02cdbd35380d"
msgid "གྲོལ་བ་ རྒྱུན་ མི་ ཆད་པ་␣ར་ འཁོར་བ་ མ་ སྟོང་ གི་ བར་ དུ་ འབྱུང་ ངོ་ །༽"
msgstr ""
"This is the uninterrupted liberation that continues until samsara is "
"emptied."

msgctxt "86a24822f6514feea9a6d243d715b862"
msgid ""
"དུས་བཞི་␣ར་ བཞག་པ་ ཤས་ ཆེ་ཆུང་ ངམ་ གཙོ་ཕལ་ ཙམ་ ལས་འབྲས་ ཐོབ་ རྒྱུན་ ཆད་ མེད་"
" དོ །"
msgstr ""
"The attainment of the result is placed uninterruptedly in the four times, "
"except for the greater and lesser or stronger and weaker dominance."

msgctxt "f637b05e46cb483c9ae51958b65ae449"
msgid ""
"རྡོ་␣༽༽  བསླབ་ གསུམ་ ལ་␣ས་ ཚུལ་ཁྲིམས་ བསླབ་པ་ སྔོན་ དུ་ འགྲོ་བ་␣ར་ འདོད་ དེ "
"།"
msgstr ""
"Vajra: It is accepted that the training of discipline comes first out of the"
" three trainings."

msgctxt "714cc20009fc4de7b1bdd54d39b42b17"
msgid "ཞི་གནས་ རབ་ཏུ་ ལྡན་པ་␣འི་ ལྷག་མཐོང་ གིས་ སོགས །"
msgstr "The special insight with excellent calm abiding, and so on."

msgctxt "71b52d7dc3544dda812c7124fdf8af05"
msgid "ཅེས་པ་␣ས་ གོ་རིམ་ ངེས་ཅན་ ཡིན་ ཟེར །"
msgstr "Thus, it is said that this is a definite order."

msgctxt "d40dfb1a53b84023ace2f05d2f9a4563"
msgid "འདི་␣ར་ ནི་ དེ་ ཁོ་ན་␣ར་ ངེས་ ཏེ་"
msgstr "In this [system], this is exclusively definite that"

msgctxt "3e2518ecace940528f4a162d39491e18"
msgid "ལྔ་ སྡེ་ བཟང་པོ་ ཡེ་ཤེས་ ཁོང་ དུ་ ཆུད་པ་␣ས་ བསྙེན་པ་␣ར་ རྫོགས་པ་ དང༌ །"
msgstr ""
"The five excellent [companions] gained full ordination by mastering wisdom "
"and "

msgctxt "c3985ab323f7425c859b66ad2b58aaed"
msgid ""
"ཁྱིམ་བདག་ གཙོ་བོ་␣འི་ བུ་ གྲགས་པ་ ཁྱིམ་པ་␣འི་ ཆ་བྱད་ དུ་ འདུག་ བཞིན་པ་␣ར་ "
"དགྲ་བཅོམ་པ་ ཐོབ་ ནས་"
msgstr ""
"The renowned son of the main head of the house, while residing in a "
"householder's attire, attained arhathood and "

msgctxt "9256beeb20c34de9b7cd0f43dfbc1c6e"
msgid "ཕྱིས་ རབ་ཏུ་ བྱུང་བ་ ལྟ་བུ་ སྟེ །"
msgstr "Later, he became a monk."

msgctxt "ad36e34ce621453d90f00d00e5c60fce"
msgid "དབྱེ་ ན་ གཞི་ ལ་␣ས །"
msgstr "When this is differentiated, from the ground:"

msgctxt "9df096dfb8cb4bad933549f72a5bcc94"
msgid "རྒྱན་ གྱི་ རྒྱན་ བཞིན་ དུ་ ནི་ སོགས་ དང །"
msgstr "Similar to the ornament's ornament and so on."

msgctxt "61e13dc317474dcaadda4455a4dce6e0"
msgid "སྡུད་པ་ ལ་␣ས །"
msgstr "According to the Condensed [Prajnaparamita In Verse]:"

msgctxt "cb0bd7aba9fb4616b9cdf28c6740f454"
msgid "སྦྱིན་པ་ སྦྱིན་པ་␣འི་ སྔོན་ དུ་ འགྲོ་བ་ ཤེས་རབ་ སྟེ །"
msgstr "Generosity, generosity is preceded by wisdom."

msgctxt "7f5e8ee0fe2f4bcb852a3e4a15ff3aaf"
msgid "སོགས་ གསུངས་པ་␣ས །"
msgstr "And so on, is said. "

msgctxt "2309f63bec6a4d1bad842450064e453d"
msgid "ཤེས་རབ་ བསླབས་པ་ ཐོག་མ་␣ར་ འགྲོ་བ་␣འང་ ཡོད་ དོ །"
msgstr "Furthermore, the training of wisdom also goes at first."

msgctxt "98984ddb0aff45898515166ce12f6f7d"
msgid ""
"རྡོ་␣༽༽  མདོ་སྔགས་ ལམ་ གྱི་ རིམ་པ་ སྔགས་ ལ་ རིམ་ ལྔ་ སྦྱོར་ དྲུག་ སོགས་ དང་ "
"མཚན་ཉིད་ རིམ་པ་ གསུམ་ ཡོད་པ་␣ས་"
msgstr ""
"Vajra: The stages of the path in the sutra and mantra. There are the five "
"stages, the six preparations, and so on, as well as the three stages of the "
"characteristic in the mantra. "

msgctxt "fe8eed9318864f5f9d963222f3ec1119"
msgid ""
"སྔོན་ དུ་ འཆི་བ །  མི་རྟག་པ །  ལ་␣ས་ རྒྱུ་འབྲས །  འཁོར་བ་␣འི་ ཉེས་དམིགས །  "
"བསྐྱེད་རིམ་ རྣམས་ ལོ་ བཅུ་གཉིས་ རེ་ བསྒོམས་ ནས །"
msgstr ""
"First, meditate for twelve years on death, impermanence, the causes and "
"results of karmic actions, the disadvantages of samsara, and the generation "
"stage."

msgctxt "f966703d6d4743d1bd4a56a7f3510610"
msgid "དེ་ རྗེས་ བཅུ་གཉིས་ རྫོགས་རིམ་ བསྒོམ་པ་ ཡིན་"
msgstr "After that, meditate on the twelve completion stages."

msgctxt "46ab46b1cb9a4346bfae1384b369fd01"
msgid "ཅེས་ བཀའ་ གདམས་པ་ འགའ་ཞིག་ གིས་ ཟེར་ རོ ། །"
msgstr "This is what some Kadampas say."

msgctxt "199898febca349cba3178f367930f007"
msgid ""
"འདི་␣ར་ ནི་ ལམ་རིམ་ ཐམས་ཅད་ ཐུན་ གཅིག་ གི་ སྟེང་ དུའང་ ཉམས་ སུ་ ལེན་ དགོས་ "
"ཏེ །"
msgstr ""
"In this [system], one must practice all the stages of the path in one "
"session because"

msgctxt "b2127b5d01824b088db9fbb6ec0b694e"
msgid "སྔ་ཐུན་ དང་པོ་␣ར་ མི་རྟག་པ་ ཐུན་ གཅིག་ མ་ བསྒོམ་ ན་"
msgstr ""
"During the first session, if one does not meditate on impermanence for one "
"session,"

msgctxt "75c74de74ce24e179de5bbf29d209873"
msgid "འཇིག་རྟེན་ རང་ གར་ འཁྱམས་ འགྲོ་བ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "[One] will wander the world casually and"

msgctxt "0b87bc3c28344a2794a8a99ef5e39f5d"
msgid ""
"དེ་ རྗེས་ ལ་␣ས་ རྒྱུ་འབྲས་ འཁོར་བ་␣འི་ ཉེས་དམིགས་ ཐུན་ གཅིག་ མ སྒོམ་ ན་"
msgstr ""
"After that, if [one] does not meditate on the causes and results of karmic "
"actions, and the disadvantages of samsara,"

msgctxt "f1826f9406284b16b9e4e1744e8f6cfa"
msgid "ཉེས་པ་ ལ་␣ས་ བཙན་པ་␣ར་ མི་འགྱུར་བ་␣འི་ ཕྱིར་ དང །"
msgstr "[One] will not be able to protect [oneself] from the faults."

msgctxt "254049470e7949b08790c454c80479bb"
msgid "དེ་ རྗེས་ བྱམས་ སྙིང་རྗེ་ བྱང་ཆུབ་ ཀྱི་ སེམས་མ་ བསྒོམ་ ན་"
msgstr ""
"After that, if [one] does not meditate on loving-kindness, compassion, and "
"bodhicitta,"

msgctxt "16b528633d9a490a8ade5b44372fb443"
msgid "དོན་ དུ་ མི་འགྱུར་བ་␣འི་ ཕྱིར་ དང་"
msgstr "[One] will not become purposeful and"

msgctxt "65a451059d0d486f853a01c7d82a468d"
msgid "དེ་ རྗེས་ མཚན་ཉིད་ ལྟར་ ན་ བདག་མེད་ གཉིས་ སྔགས་ ལྟར་ ན་"
msgstr ""
"After that, the two selflessnesses according to the characteristics, "
"according to the mantra"

msgctxt "747d52a029cd4afe82fa6fcdfa4d5b42"
msgid "བསྐྱེད་རྫོགས་ གཉིས་ དངོས་གཞི་ མེད་ ཐབས་མེད་པ་ དང་"
msgstr ""
"In the two stages of generation and completion, the actual basis is "
"indispensable, and"

msgctxt "2c7afe2943f74a15ace47c07898aa69f"
msgid "དགེ་རྩ་ བྱང་ཆུབ་ ཏུ་ བསྔོ་བ་ དང་ བཅས་པ་ མེད་ ན་ ཆུད་ ཟ་བ་␣འི་ ཕྱིར །"
msgstr ""
"Without having the dedication of the roots of virtue to enlightenment, they "
"are wasted."

msgctxt "fa36032f725446e4900fea2654c95718"
msgid ""
"དེ་ལྟར་ ཐུན་ གཅིག་ གི་ སྟེང་ དུ་ ཉམས་ སུ་ ལེན་ ན་ ཇོ་བོ་ རྗེའི་ དགོངས་པ་ "
"ཡིན་ ནོ །"
msgstr ""
"If [someone] practices in that way in a single session, that is the intent "
"of Jowo Je [Palden Atisha]."

msgctxt "13e59852a5e04443ac2c06a8882e4cd9"
msgid "རྡོ་␣༽༽  ཞིང་ གཅིག་ ལ་ སངས་རྒྱས་ གཅིག་ ལས་མི་ འབྱུང་བ་"
msgstr "Vajra: In a single realm, only one Buddha emerges."

msgctxt "31ee9e5b91d34d8c848adbe818935d11"
msgid "དགོངས་ འདུས་ དང་ བོན་ འབུམ་ ན་ འདོད་ འདོད་པ་␣ས་"
msgstr ""
"As it is accepted in the Gathered Intents and Bon's One Hundred Thousand "
"[verses]."

msgctxt "d5c07aa414bb42c79e49ad29b717b0f3"
msgid "དེ་ལྟར་ ཡིན་པ་ འགའ་ཞིག་ གིས་ ཟེར་ ཡང་"
msgstr "Moreover, some say that this is true."

msgctxt "a299510a517e4c6b9ef4834dff00168b"
msgid "སངས་རྒྱས་ ནི་ གྲངས་མེད་ བྱོན་པ་ ཡོད་ དེ་"
msgstr "Countless buddhas arrive because"

msgctxt "f977e5abec4e4b88b7dc799ad608e86a"
msgid ""
"སངས་རྒྱས་ རྣམས་ ཀྱི་ སྐུ་གསུང་ཐུགས་ ཀྱི་ ཟད་པ་ རྒྱན་ གྱི་ འཁོར་ལོ་␣འི་ "
"རྣམ་འཕྲུལ་ མཐའ་ ཡས་ ཤིང་ ཐུག་པ་ མེད་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"The exhaustion of the buddhas' body, speech, and mind is the manifestation "
"of the wheel of ornament, that is infinite and endless."

msgctxt "5a03ad80ddf94f448d6a676b27dd5e1e"
msgid ""
"རྡུལ་ གཅིག་ གི་ ཁྱོན་ ལ་ རྡུལ་ སྙེད་ ཀྱི་ སངས་རྒྱས་ ཀྱི་ མཛད་པ་ སྟོན་པ་␣ར་ "
"གསུངས་པ་␣འི་ ཕྱིར་ དང །"
msgstr ""
"It is said that the buddhas can show as many deeds as there are particles in"
" a single particle."

msgctxt "930bb645385d486d8e22fe25924c91e6"
msgid "རང་ རེ་␣འི་ སྟོན་པ་␣ས་ འདུས་པ་ རིན་པོ་ཆེ་ དང་"
msgstr "Our teacher taught the precious Gathered and "

msgctxt "735985ae01274391a07859c12c5363d7"
msgid "པདྨ་ དཀར་པོ་ གསུངས་པ་␣འི་ དུས་"
msgstr "During the teaching of the White Lotus "

msgctxt "42305e792bd84a9d901f02a2375df341"
msgid "སངས་རྒྱས་ དཔག་ ཏུ་ མེད་པ་␣ར་ འབྱོན་པ་␣ར་ གསུངས་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "It is said that countless buddhas have arrived."

msgctxt "e80ac4c0d8164bc39ae02c6b30fdd843"
msgid "དགོངས་ འདུས་ ཀྱི་ ལུང་དོན་ མཛད་པ་"
msgstr "The scriptural meaning of the Gathered Intents."

msgctxt "e80f577448204003871e4db596e9e14c"
msgid "ཞིང་ དེ་␣ར་ མཐ་␣ར་ ཕྱིན་པ་ ལ་ དགོངས་ ཤིང་"
msgstr "The intent is to reach the ultimate level of that realm."

msgctxt "f4dc9a75a84e4b0593d127cc705779f6"
msgid "བོན་ ལུང་ ནི་ ལུང་ དུ་ མི་ འགྲུབ་བོ ། །"
msgstr "The Bon scripture is not established as a scripture."

msgctxt "a11aae085fad40048a84b681e7f3c991"
msgid "རྒྱུད་ གཉིས་ མེད་ རྣམས་ ལ་␣ས་ ལྷ་ སྦྱིན་ དང་ བདུད་ དང་ །"
msgstr "In the non-dual tantras, Devadatta, demons, and "

msgctxt "f60ec9d23f404cbc96e4d83d2d2d2657"
msgid "འཁོར་ རྣམས་ སངས་རྒྱས་ ཡིན་པ་␣ར་ གསུངས་ སོ །"
msgstr "their retinues are said to be buddhas."

msgctxt "df709fbc74864c6abb1b18390c4059a2"
msgid ""
"རྟེན་འབྲེལ་ གནད་བསྡུས་ རྡོ་རྗེ་ ཚིགས་ རྐང་ བཅོ་ལྔ་ ལྷན་ཐབས་ ཚིགས་ རྐང་ གཅིག་"
" གི་ འགྲེལ་བཤད་ ཀྱི་ སྐབས་ ཏེ་ གཉིས་པ་␣འོ ། ༈"
msgstr ""
"This concludes the second section, a commentary on the fifteen vajra verses "
"and one verse of the addendum, summarizing the essential points of "
"interdependence."

msgctxt "9968324f8faf46eba0046ba58899af67"
msgid "གཞན་དག་ ན་རེ་"
msgstr "Others said:"

msgctxt "7093b379269f4ef28d4a0210e4a7331d"
msgid "འདུལ་བ་␣འི་ སྡེ་སྣོད་ སོ་སོ་␣ར་ ཐར་པ་ ཞེས་པ་"
msgstr "The Vinaya Pitaka is individual emancipation,"

msgctxt "5f21aaeb894e4681b4b42e850aaf6655"
msgid ""
"རང་ཉིད་ ཁོ་ན་ ཐར་པ་␣འི་ དོན་ ཡིན་པ་␣ས་ ཐེག་དམན་ ས་␣ར་ འདོད་པ་ མང་ མོད །"
msgstr ""
"Many people accept it as the stages of the Lesser Vehicle because it is "
"concerned only with the emancipation of oneself."

msgctxt "97251b4bdf474f678ed1030bf319899c"
msgid "འདི་␣ར་ ནི་ དམ་ཆོས་ འདུལ་བ་ ཐེག་པ་ ཐུན་མོང་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], the holy dharma of the Vinaya is common to all vehicles "
"because"

msgctxt "ca6a829eda9043b8830039f9d33a2317"
msgid ""
"གནས་སྐབས་ འཁོར་བ་␣འི་ བདེ་སྐྱིད་ ཀྱང་ སོ་ཐར་ སྡོམ་པ་␣ར་ བརྟེན་ ནས་ བྱུང་ "
"སྟེ་"
msgstr ""
"Even the temporary happiness of samsara occurs depending on the vows of "
"individual emancipation."

msgctxt "a6ba66655f634dcda0d00e995706924c"
msgid "ཚུལ་ཁྲིམས་ ཀྱིས་ ནི་ བདེ་འགྲོ་␣ར་ འགྲོ་ ཞེས་ དང་ །"
msgstr "Through discipline, one will go to the happy migrations."

msgctxt "d4b3ed17ff514e7b9175a5058c98a55e"
msgid "ཞི་བ་ ཉན་རང་ མི་ལུས་ ལ་ བརྟེན་ དགོས་ ཤིང་"
msgstr "The peaceful shravakas and pratyekabuddhas must rely on a human body."

msgctxt "4f435ae20e204c64b5af069897116b8b"
msgid "ལུས་ དེ་␣འང་ ཚུལ་ཁྲིམས་ ལ་ རག་ ལས་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "That body also depends on discipline."

msgctxt "6d440eb14e1847febaac0c858b0598ae"
msgid ""
"མཐར་ཐུག་ སངས་རྒྱས་ ཀྱི་ ཡོན་ཏན་ སྟོབས་ སོགས་ ཚུལ་ཁྲིམས་ ཀྱི་ འབྲས་བུ་ གསུངས་"
" ཏེ །"
msgstr ""
"It is said that the ultimate qualities of Buddha such as powers and so on "
"are the results of discipline."

msgctxt "8e03c291700e40e0becc582d523ccc96"
msgid "སྡུད་པ་ ལ་␣ས །"
msgstr "According to the Condensed [Prajnaparamita In Verse]:"

msgctxt "29ad19eddbd94fb8befb06282205285c"
msgid "ཚུལ་ཁྲིམས་ ཀྱིས་ ནི་ ཞི་བ་ འདོད་ རྣམས་ འཕགས་པ་␣ར་ འགྱུར ། །"
msgstr "Those who want peace will become superior ones through discipline."

msgctxt "800d984cfe8b4ffeb60713ac4039cb7e"
msgid "སྟོབས་ བཅུ་␣འི་ སྤྱོད་ཡུལ་ གནས་ ཀྱང་ ཚུལ་ཁྲིམས་ ཉམས་པ་ མེད །"
msgstr ""
"Although [they] dwell in the sphere of the ten powers, [their] discipline "
"never degenerates."

msgctxt "592b6e01394648698e055b1314666930"
msgid "ཅེས་པ་ ཐོག་མ་␣ར་ མཐོ་རིས་ ཀྱི་ ཡོན་ཏན་ བར་ དུ་ ཉན་རང་ གི་ བྱང་ཆུབ །"
msgstr ""
"First the qualities of the higher realms and then the enlightenment of "
"shravakas and pratyekabuddhas in the middle."

msgctxt "fb22de71b2324924af847b85bdefc6c6"
msgid "མཐར་ཐུག་ བྱང་ཆུབ་ ཆེན་པོ་␣འི་ བར་ ཚུལ་ཁྲིམས་ ལ་␣ས་ བྱུང་བ་ ནི་␣༑"
msgstr "Finally, the great enlightenment is the result of discipline."

msgctxt "40562c135c3d441b849dc5c4d67174f4"
msgid "བཤེས་ སྤྲིང་ ལ་␣ས །"
msgstr " According to A Letter to a Friend:"

msgctxt "aa5f89a6418e42dd9f278b8c4e169009"
msgid "ཁྲིམས་ ནི་ རྒྱུ་ དང་ མི་ རྒྱུ་␣འི་ ས་ བཞིན་ དུ །"
msgstr "Discipline is like the earth for everything moving or unmoving."

msgctxt "22db95a77c9c4bc3b8fc0604ac4869f0"
msgid "ཡོན་ཏན་ ཀུན་ གྱི་ གཞི་ རྟེན་ ལགས་པ་␣ར་ གསུངས །"
msgstr "It is said that it is the foundation for all qualities."

msgctxt "0b82cd4fd21841c89f83b2b9194afca2"
msgid "ཞེས་པ་ དང༌ །"
msgstr "And"

msgctxt "d383cf1f060a4a2bbe03d5c49c90a40b"
msgid "ཐུན་མོང་ དུ་ སྲོག་གཅོད་པ་ ལྟ་བུ་ གཅིག་ ལ་ མཚོན་ ན །"
msgstr "In case of a joint enterprise killing,"

msgctxt "ceae62a306a14ff68b91570ff09beba0"
msgid "འཇིག་རྟེན་པ་␣འི་ མི་དགེ་བ །"
msgstr "Worldly non-virtues,"

msgctxt "dd11a8df9b004a17b1c62fb7fb7e005e"
msgid "ཉན་རང་ གི་ ཕས་ ཕམ །"
msgstr "The defeats of shravakas and pratyekabuddhas."

msgctxt "cd426b7a830349448b5b1c6786d85ce2"
msgid "བྱང་སེམས་ ཀྱི་ རྩ་བ་ ལྟ་བུ །"
msgstr "Like the root of bodhicitta."

msgctxt "1c0f06458cdb41209da6fd6791eeb6a8"
msgid "སྔགས་ སུ་ བཅུད་ རྣམས་ ལྷ་␣ར་ གསུངས་ ན་"
msgstr "In the mantra, when all contents are said as deities,"

msgctxt "5b18ebdac95a4bf488edd56e657aa3b7"
msgid "ལྟུང་བ་ དེ་བ་␣ས་ ཆེ་བ་ མེད་པ་␣ས་"
msgstr "There is no greater downfall than this."

msgctxt "a087b983b1844f3393ccc0b8392d376a"
msgid "དེ་ལྟར་ ཐུན་མོང་ དུ་ གྲུབ་བོ །"
msgstr "In that way, it is established in common."

msgctxt "acec9d45aa98457d99d51ef48df1c884"
msgid "སོ་ཐར་ གྱི་ སྒྲ་དོན་ པྲ་ ཏི་ མོཀྵ་ ཞེས་པ་"
msgstr "The etymology of the term pratimoksha,"

msgctxt "f6ace8d64bdb4fb0be55d9fecca3530f"
msgid "དྲི་མེད་ བཤེས་ ཉེན་ གྱི་ འགྲེལ་བ་ བམ་པོ་ ལྔ་ བཅུ་པ་ ལ་␣ས །"
msgstr "From the fifth volume of the commentary by Vimalamitra:"

msgctxt "596f39930c72475badf3e797e30896d7"
msgid "སོ་སོ་␣ར་ ཐར་པ་ ཞེས་ བྱ་བ་ ནི་"
msgstr "The pratimoksha is "

msgctxt "17c7735e054647d1a11d796278629860"
msgid "དགག་སྒྲུབ་ ཀྱི་ བསླབ་པ་ སོ་སོ་␣ར་ མ་ འདྲེས་ ཕར་"
msgstr "The training of negation and assertion individually without mixing,"

msgctxt "e62de4c32aff49e2bd0a786972182ed8"
msgid ""
"ཉམས་ སུ་ བླངས་པ་␣ས་ ཐར་པ་ ཐམས་ཅད་ མཁྱེན་པ་ ཉིད་ མངོན་དུ་ བྱེད་པ་␣འི་ ཕྱིར་ "
"སོ་སོ་␣ར་ ཐར་པ་␣འོ །"
msgstr ""
"Through this practice, it brings the realization of liberation and "
"omniscience, thus it is individual emancipation."

msgctxt "1df2d765aa254fc0bfab6ccd9cfed1a5"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "be8ef59ed0574d16bdc75d12af4caa1d"
msgid "སོ་ཐར་ སྨྲོས་ ཙམ་ གྱིས་ ཐེག་དམན་ ཡིན་ ན་"
msgstr ""
"If it becomes the Lesser Vehicle by merely mentioning individual "
"emancipation,"

msgctxt "50b1b4cd03314b909349be17d53a17ab"
msgid "བྱང་སེམས་ དང་ སྔགས་ ཀྱི་ སྡེ་སྣོད་ ཀྱང་ དམན་པ་␣ར་ ཐལ་ ཏེ །"
msgstr ""
"It absurdly follows that the bodhisattva and mantra pitakas as the Lesser "
"[Vehicle]."

msgctxt "407cab4f4ab2420f881bcc55f3df536a"
msgid "དེ་ དང་ དེ་ལས་ སྨྲས་པ་␣ས་ སོ །"
msgstr "Since such and such has been said."

msgctxt "1ed6065ca62c4813808f4357223160ca"
msgid "དེ་ཕྱིར་ ལུང་ རྣམ་འབྱེད་ ལ་␣ས །"
msgstr "Therefore, the full analytical scripture says:"

msgctxt "d4364e599bf34ff3a894601ba2f05627"
msgid "ཇི་ལྟར་ འདི་ ན་ ཤིང་རྩ་ གཙོ་བོ་ སྟེ ། །"
msgstr "Just as the main [part] of a tree is its roots,"

msgctxt "8308b85ab9d242d0a727b0bc6c33c542"
msgid "རྣམ་པ་␣ར་ འཕེལ་ དང་ ཀུན་འཛིན་ གཉིས་ ཀྱི་ གཞི ། །"
msgstr "It is the foundation for both holding and growing."

msgctxt "6d5bca2391194408ac3a749b89401e4c"
msgid "དེ་བཞིན་ ཡོན་ཏན་ ཚོགས་ རྣམས་ ཀུན་ གྱི་ ཡང་ ། །"
msgstr ""
"In the same way, it is the [foundation] for the accumulation of all "
"qualities."

msgctxt "1ce5937460f9497a8bda5bff1bbb1926"
msgid "རྒྱུ་ དང་ རྩ་བ་ འདུལ་བ་ ཡིན་པ་␣ར་ གསུངས །"
msgstr "It is said that the vinaya is the cause and root."

msgctxt "87a40f0713094132ad1d82bc4cfd78ca"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "8642ced1a5fd4367af4e4d82568da944"
msgid "རྡོ་␣༽༽  ཐེག་དམན་ དུ་ འདོད་ མོད །"
msgstr "Vajra: Even though it is accepted as the Lesser Vehicle."

msgctxt "aebb7b710b0d45e1bd31c541b2b7be22"
msgid "ལྷག་པར་ དུའང་ ཐེག་པ་ ཆེན་པོ་␣ར་ གསལ་བ་␣ར་ བཞུགས་ ཏེ་"
msgstr "Especially, [they] clearly dwell in the Greater Vehicle."

msgctxt "838f3c540a904ee58270836f79b65bb8"
msgid "སངས་རྒྱས་ ཐོབ་བྱེད་ ཀྱི་ རྒྱུ་ དང་པོ་ སེམས་བསྐྱེད་པ་"
msgstr ""
"The first cause for attaining buddhahood is generation of the mind [for "
"enlightenment]."

msgctxt "f28cd32695d64086986edef21daaeb7f"
msgid "ལུང་ སྨན་ གཞི་ ལ་␣ས་"
msgstr "According to the scripture of the Basis of Medicine:"

msgctxt "3da16acd13ab414abe51580434957b02"
msgid "འོད་ལྡན་ དུ་ སྐྱེ་བ་ བཞེས་པ་ ན་ སངས་རྒྱས་ ཀྱི་ སྒྲ་ ཐོས་ ནས །"
msgstr ""
"Being born in the Luminous [realm], and after hearing the term Buddha."

msgctxt "6fcc94f818124af598eb1b2b285ec62c"
msgid "གཏོང་བ་ ལ་␣ས་ བྱུང་ བསོད་ནམས་ རྣམས་ ལ་␣ས་ བྱུང་ གང་ ལ །།"
msgstr "Those who have merits through the action of giving"

msgctxt "f191e37982f84bd4b8558d6e36c59848"
msgid "དེ་␣ས་ ནི་ འཇིག་རྟེན་ སངས་རྒྱས་ ཉིད་ ཐོབ་ ཅིང༌ ། །"
msgstr "This will attain buddhahood in the world."

msgctxt "751828ae2ce847d5a83cd0f594c70650"
msgid "འདོད་པ་␣འི་ རིམས་ནད་ ཀུན་ ལ་␣ས་ ཐར་བ་␣ར་ བྱ །"
msgstr "One will be set free from the spreading diseases of desire."

msgctxt "509ace3a06994944b95d947ea4acacb1"
msgid "ཞེས་ སེམས་བསྐྱེད་པ་ དེ་␣ར་ བཤད་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "This is the explanation of the generation of the mind and"

msgctxt "c92f99b8951a4f1eb0d1c1c4addab783"
msgid "བར་ དུ་ ལམ་ ཕྱིན་ དྲུག་ རྫོགས་པ་␣འི་ རིམ་པ་"
msgstr "The completing stage of the six perfections is in the middle. "

msgctxt "e6aa177c502944d4af98387cac179f5b"
msgid "སྐྱེས་ རབ་ ལྔ་ བརྒྱ་ ན་ མགོ་ དང་ རྐང་ལག་ གཏོང་བ་ སོགས་"
msgstr ""
"The giving of head, hands, feet, and so on in the five hundred lifetimes [of"
" the Buddha]."

msgctxt "de9f9e5f89bb40c6a8c20fc595db8966"
msgid "བྱ་ དཀའ་བ་␣འི་ སྤྱོད་པ་ སྤྱད་ ཚུལ་ དེ་␣ར་ འཞུགས་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr ""
"It contains how [he] engages in the deeds which are difficult to perform and"
" "

msgctxt "1c615ef8706d442cbf63cb97c1410e03"
msgid "མཐ་␣ར་ བསྔོ་བ་ སྨོན་ལམ་ དང་ གྲུབ་པ་␣འི་ འབྲས་བུ་␣འང །"
msgstr "In the end, dedication, aspiration, and the fruits of accomplishment."

msgctxt "d55c35347c92458b894f560759a2bf9e"
msgid "སྦྱིན་པ་ རྒྱ་ ཆེན་ སོགས །"
msgstr "Vast generosity and so on."

msgctxt "be47a0d65b9442a0a14200064e218532"
msgid "ཅེས་ དང་ མཛད་པ་ བཅུ་གཉིས་ དེ་ལས་"
msgstr "And these are shown in the twelve deeds and  "

msgctxt "456db421f14d4daeacba4aad113f8eba"
msgid "བསྟན་པ་␣འི་ ཕྱིར་ དང་ བསྟན་བཅོས་ ལ་␣ས་ ཀྱང་ བཀྲལ་བ་␣འི་ ཕྱིར་ རོ །"
msgstr "And elucidated in the treatises as well."

msgctxt "e8eab0f4ceb8464eab227c62bfa9891e"
msgid "ལྷན་␣༽༽  གཞན་དག་ ན་རེ །"
msgstr "Addendum: Others said,"

msgctxt "fa469341576749978d2d7c375d7fb394"
msgid ""
"སྤང་བྱ་ རེ་རེ་␣འི་ གཉེན་པོ་␣ར་ ཆོས་ཕུང་ དེ་ཉིད་ དུ་ གསུངས་པ་␣ས་ ཆོས་ཕུང་ "
"ཐ་དད་ ཡིན་ ཟེར །"
msgstr ""
"The Dharma heaps are distinct because the Dharma heaps are taught as the "
"antidotes to each of the objects of abandonment."

msgctxt "344a2df75ec145cf93541faf21614be3"
msgid ""
"འདི་␣ར་ ནི་ ཆོས་ ཀུན་ སོ་སོ་ ཐར་པ་ སོགས་ སྡོམ་ གསུམ་ རེ་རེ་␣ར་ ཡང་ འདུ་བ་␣ར་"
" གསུངས་ ཏེ །"
msgstr ""
"In this [system], [Buddha] taught that each of the three vows, such as the "
"pratimoksha vow, gathers all dharmas."

msgctxt "f5f2e4636ecf48e1bd072213bdabe5df"
msgid "དེ་␣འི་ རྒྱུ་མཚན་ སྤང་བྱ་␣འི་ གྲངས་ སུ་ གསུངས་པ་ མཐུན་ ཡང་"
msgstr ""
"The reason for this accords with the statement of the number of objects to "
"be abandoned."

msgctxt "7e21be4e501147e394b1039563b58459"
msgid "འདུ་ ཚུལ་ གསང་ བསམ་ ལ་␣ས །"
msgstr ""

msgctxt "2a4354ce92d54b729ab842b7df00a5e0"
msgid ""
"སངས་རྒྱས་ ཀྱིས་ གསུངས་པ་␣འི་ ཆོས་ རྣམས་ བསོད་ནམས་ ཡེ་ཤེས་ ཀྱི་ ཚོགས་ གཉིས་ "
"སུ་ འདུ་བ་␣ར་ བྱ་␣འོ ། །"
msgstr ""
"All the dharmas taught by the Buddha are gathered in the two accumulations "
"of merit and wisdom."

msgctxt "8037b198bca54267ad4ccdce57efa5a1"
msgid "ཞེས་ གསུངས་པ་␣ས་"
msgstr "As said."

msgctxt "f855fd90b1274155aa5e945e03dd9a3a"
msgid "ཐབས་ཤེས་ དེ་ གཉིས་ ཀྱིས་ སྡོམ་པ་ གསུམ་ ཀར་ ཁྱབ་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "These two, method and wisdom, pervade all three vows."

msgctxt "69b9d0530bab4d3089a459c3a330284c"
msgid "རྡོ་␣༽༽  འདུལ་འཛིན་ ལ་ལ་␣འི་ འདུལ་བ་␣འི་ དོན་"
msgstr "Vajra: The meaning of the vinaya by some vinaya holders."

msgctxt "3595005db00b497f9280a2f9660e7c22"
msgid ""
"དགག་སྒྲུབ་ ཏུ་ བཅས་པ་␣འི་ ཚུལ་ཁྲིམས་ ནི་ ཉན་ཐོས་ ཀྱི་ ཉམས་ སུ་ བླང་ བྱ་ "
"ཡིན་པ་"
msgstr ""
"The disciplines associated with negation and assertion are the practice of "
"the shravakas."

msgctxt "0dae65e467b64d6ab230e05bb4a4eb2a"
msgid "བོད་ ཀྱི་ འདུལ་འཛིན་ དག་ གིས་ ཟེར་ རོ །"
msgstr "This is said by the vinaya holders of Tibet."

msgctxt "90a4739e236d4d209416a9a950655303"
msgid ""
"འདི་␣ར་ ནི་ འདུལ་བ་ ཐམས་ཅད་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ ཀྱི་ ཡུལ་ འདི་ཉིད་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], all the vinayas are the object of omniscient wisdom "
"itself."

msgctxt "3c6ff4ba78d642b8a1647b6791192366"
msgid "དེ་␣འང་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ སྟོབས་ བཅུ་ ལ་␣ས་"
msgstr "Also from the ten strengths of omniscient wisdom,"

msgctxt "570bd9899446407fa5842f4dc885ff3c"
msgid ""
"གནས་ དང་ གནས་མིན་ སོགས་ དགུ་ ནི་ ཇི་སྙེད་པ་ ཐ་མ་ ཟག་ཟད་ མཁྱེན་པ་ ཇི་ལྟ་བ་ "
"སྟེ །"
msgstr ""
"The nine [strengths] such as [the strength of knowing] places and non-places"
" and so on are [the knowledge of] the things in their extent and the last "
"knowing the exhaustion of outflows is [the knowledge of] things as they are."

msgctxt "c84431a5ce704d01a113a7ae09285633"
msgid ""
"ཇི་སྙེད་ མཁྱེན་པ་␣འི་ སྟོབས་ དགུ་ ཀ་ དགག་སྒྲུབ་ ཀྱི་ ཚུལ་ཁྲིམས་ འདི་␣ས་ "
"བསྡུས་ ཤིང་"
msgstr ""
"The moral disciplines of negation and assertion contain all the nine "
"strengths of the knowledge of things to the entire knowledge of omniscience."

msgctxt "c4b6187f2a21442dba131afbd6bd9999"
msgid ""
"དེ་ལས་ ཀྱང་ ལ་␣ས་ དང་ལ་␣ས་ ཀྱི་ རྣམ་སྨིན་ མཁྱེན་པ་␣འི་ སྟོབས་ ལ་ འཇུག  །"
msgstr ""
"Further, it engages in the power to know karma and the complete ripening of "
"karma."

msgctxt "22cfdadc8fe741e0ba234dbb4ca5676f"
msgid "ཡེ་ཤེས་ དེ་␣འི་ གཟིགས་པ་␣ས་ བསླབ་པ་ བཅས་ ཏེ་ ཉམས་ སུ་ བླངས་པ་␣ས་"
msgstr ""
"Because of observing that wisdom, the associated trainings are practiced. "

msgctxt "ef7b47c854b14d30bbb61a4b39feb09f"
msgid ""
"སྟོབས་ བཅུ་ མངོན་དུ་ བྱེད་པ་␣འི་ ཚུལ་ འདི་␣ས་ སངས་རྒྱས་ ཁོ་ན་␣འི་ སྤྱོད་ཡུལ་"
" ཏེ །"
msgstr ""
"This way of manifesting the ten strengths is the scope of Buddha alone."

msgctxt "bcbeab9032cb4bcdbd8b8ff2c7e2cd09"
msgid "ལོ་པཎ་ རྣམས་ ཀྱིས་ འདུལ་བ་␣འི་ ཐད་ དུ །"
msgstr "In regard to the vinaya, the translators and scholars,"

msgctxt "63a649410e5b4682988d8b78acf07885"
msgid "ཐམས་ཅད་ མཁྱེན་པ་ ལ་ ཕྱག་ འཚལ་ ལོ ། །"
msgstr "Homage to the Omniscient One."

msgctxt "0e8da5300f0a4369af5f12d5f394acfc"
msgid "ཞེས་པ་ དང༌ །"
msgstr "And"

msgctxt "9d14739bd50d41b4aeb517c81a234247"
msgid ""
"དེ་ལྟར་ ཉམས་ སུ་ བླངས་ ན་ སྟོན་པ་ ཉིད་ ཀྱི་ བྱ་བ་ བྱེད་པ་␣ར་ གསུངས་ ཏེ །"
msgstr ""
"It is stated that if [you] practice in this manner, [you] will perform the "
"Buddha's actions."

msgctxt "167aeef522684294a7a61e4cca824028"
msgid "ང་ ནི་ མྱ་ངན་ འདས་ གྱུར་ ན ། །"
msgstr "After I passed into nirvana."

msgctxt "4edbc9b76fa74008b467c349d178d50b"
msgid "འདི་ ནི་ ཁྱོད་ ཀྱི་ སྟོན་པ་ ཞེས ། །"
msgstr "This is your teacher."

msgctxt "f093ff271cbb4df5b20e4c12744279e5"
msgid "རང་བྱུང་ ཉིད་ ཀྱིས་ གུས་ བཅས་པ་␣ར ། །"
msgstr "The self-arisen one with respect,"

msgctxt "97219bfcf5bd4a66a5d02d40013f8e83"
msgid "ནན་ཏན་ དགེ་སློང་ ཚོགས་ མདུན་ བསྟོད །"
msgstr "Praise assiduously in front of the assembled monks."

msgctxt "47f6b27c7aad44acb26fd54d6054715f"
msgid "ཅེས་ སོ ། །"
msgstr "As said. "

msgctxt "13f8e685d18f4573ac397383a491f868"
msgid "ཚུལ་ཁྲིམས་ ཐམས་ཅད་ མཁྱེན་པ་ འདི་ ཡིན་པ་ དེ་ལྟར་ ན །"
msgstr "All the moral disciplines are this knowledge. If it is like that,"

msgctxt "81fba3d96cce4bcc8357614defad558c"
msgid "དེ་ བསྲུང་བ་␣འི་ བཙུན་པ་␣ར་ ཡེ་ཤེས་ ཡོད་པ་␣ར་ འགྱུར་ རོ་ ཞེ་ན །"
msgstr ""
"If one says that the reverend who protects it possesses primordial wisdom."

msgctxt "63b159c119e04d6da88437ada575bf65"
msgid "མངོན་གྱུར་ དུ་ མེད་ ཀྱང་ རང་བཞིན་ དུ་ཡོད་ དེ །"
msgstr "Although it is not manifested, it exists by intrinsic nature."

msgctxt "3fd3efc388094473aa02cfce14c1427f"
msgid "དཔེར་ན་ མཚམས་མེད་ བྱེད་པ་␣འི་ མི་ལ་ དམྱལ་བ་པ་ བྱས་པ་ དང་ འདྲ་␣འོ །"
msgstr ""
"For example, it would be like a person who has committed the crimes of "
"immediate retribution and becomes a hell-being."

msgctxt "ea73166bf6bb4e2fb1f3929c1ec3b8f3"
msgid "རྡོ་␣༽༽  མཚམས་མེད་ སྒྲ་ མི་ སྙན་ སྤྲུལ་པ་ སྐྱེ་བ་  ༡  དང་ །"
msgstr ""
"Vajra: By the crimes with immediate retribution, the first is being born as "
"an incarnation in Kurava."

msgctxt "90ca7eb7e0f74ba0beef22a141fd7e17"
msgid "ཕ་མ་␣ས་ མ་ གནང་བ་ སོགས་ གནས་པ་␣འི་ དང་  ༢"
msgstr "The second is staying in those that are not permitted by parents."

msgctxt "8543f3fb9c924fa5ad08373c86adde2c"
msgid "ནད་པ་ ཡོན་ཏན་ ཐོབ་པ་␣འི་  ༣  དང༌ །"
msgstr "The third is that a sick person obtains good qualities."

msgctxt "9020a8b4f4cf4a52901798c4a3e5e93a"
msgid "གཞན་དོན་ དུ་ མི་ མཛེས་པ་ མཛེས་པ་␣འི་  ༤  དང༌ །"
msgstr ""
"The fourth is being beautiful for the sake of others but that is not "
"beautiful. "

msgctxt "dcf0cb8e6aed4265acb5b4517b27ae0a"
msgid ""
"བར་ཆད་ དེ་ བཞི་ ལ་␣ས་ སྐྱེ་བ་␣འི་ བར་ཆད་ གང་རུང་ གཅིག་ བྱུང་ ན་ སྡོམ་པ་ མི་ "
"སྐྱེ་ ཟེར །"
msgstr "If any of these four obstacles happens, the vows will not arise."

msgctxt "55dbde217566435a9fdc76ccff82ad1a"
msgid "འདི་␣ར་ ནི་ བར་ཆད་ ལྡན་ ལ་ སྡོམ་པ་ སྐྱེ་བ་␣ར་ ངེས་ ཏེ །"
msgstr ""
"In this [system], even having these obstacles, it is certain that the vows "
"will arise."

msgctxt "654f191c265a480aa78bb262bda9b348"
msgid ""
"དེ་དག་ དགེ་ སྦྱོད་ གི་ འབྲས་བུ་ སྐྱེ་བ་␣འི་ བར་ཆད་ ལ་␣ས་ སྡོམ་པ་ མིན་ ཏེ །"
msgstr ""
"They are not to prevent the obstacles to the arising of the result of "
"virtuous activity."

msgctxt "5a6313d44208413a97a1590904ca8a41"
msgid "རབ་ཏུ་ བྱུང་བ་␣འི་ གཞི་ ལ་␣ས །"
msgstr "According to the Basis of Ordination:"

msgctxt "03d767c96c5c4230b960951e9ea6bcc0"
msgid "ཁྱིམ་བདག་ ཞིག་ གི་ བུས་ མ་ བསད་པ་␣ར་ འགྱོད་ ནས་ རབ་ཏུ་ བྱུང །"
msgstr "A householder's son regretted murdering his mother and became a monk."

msgctxt "4ad6e99e66a84541b340c7e0feac96b1"
msgid ""
"སྡེ་སྣོད་ གསུམ་ ཤེས་ མཚམས་མེད་ བྱེད་པ་ མི་ སྐྱེ་བ་␣འི་ ཆོས་ཅན་ ཡིན་པ་␣ས་"
msgstr ""
"Those who know the three pitakas and have committed the crimes with "
"immediate retribution are the subject matter of not being arisen. "

msgctxt "e39e2f51bb02453da77829045984d4c8"
msgid "བཀྲོད་ ཅིག་ གསུངས་པ་␣ས་ བཀྲད །"
msgstr "After being asked to walk, [he] walked away."

msgctxt "cac783e72e57450880ad07b0bfcd0ba7"
msgid "རྒྱ་མཚོ་␣འི་ འགྲམ་ དུ་ ཕྱིན །"
msgstr "He went toward the ocean."

msgctxt "5ae7e13a2aa940cba3f67a00f0561d7e"
msgid "སློབ་མ་ བསྡུས་ ཆོས་ བཤད་པ་␣ས་ དགྲ་བཅོམ་པ་ མང་པོ་ བྱུང༌ །"
msgstr ""
"He gathered disciples and taught them the Dharma, and many of them became "
"arhats."

msgctxt "14b3fabcbd454a26a4eb7eb158086748"
msgid "ཚེ་ འཕོས་ ནས་ དམྱལ་བ་␣ར་ སྐྱེས་མ་ ཐག་"
msgstr "He died, and soon after his birth in hell,"

msgctxt "c329c5bf7b9a4f1f92f7318a0b31dbee"
msgid "མེ་ ལ་ བསྲོ་ཁང་ གི་ སྣང་བ་ བྱུང་བ་␣ར་ བརྟེན་"
msgstr "Because [he] had the appearance of fire like a steam house."

msgctxt "51b5c28d18ad4cff9237c1f775d9382d"
msgid "ལྷ་␣ར་ སྐྱེས་ ནས་ སངས་རྒྱས་ ལ་␣ས་ ཆོས་ ཐོས་པ་␣ས་"
msgstr "[He] was born as a god and listened to the teachings from the Buddha."

msgctxt "3e9c5c4962f64c978358b04a74a178fe"
msgid "འབྲས་བུ་ ཐོབ་པ་ རབ་ཏུ་ བྱུང་བ་␣འི་ ཕན་ཡོན་ ཡིན་ ཏེ །"
msgstr "The attainment of the result is the benefit of becoming a monk."

msgctxt "df12ef5ca1d14b80a8e1928039390244"
msgid "རྣམ་སྨིན་ སྐལ་ ཆེན་ དུ་ གསུངས་ ན་"
msgstr "When the complete ripening [of karma] is said to be a great aeon. "

msgctxt "abe1054268a847d284f2e8083c83c39d"
msgid "འདི་ སྐྱེས་མ་ ཐག་ ལྷ་␣ར་ འཕོས་པ་␣འི་ ཕྱིར་ རོ །"
msgstr "Soon after his birth, [he] was transmigrated to the god [realm]. "

msgctxt "5ca85453144e426a872760e9a53e4d0f"
msgid "འོ་ན་ མ་སྐྱེས་དགྲ་ སོགས་ མཚམས་མེད་ བྱས་པ་"
msgstr ""
"Well then, Ajatashatru and so on, who committed the crimes of immediate "
"retribution,"

msgctxt "4d811bb8698e405894088c6ad0d8cfb0"
msgid "བདེན་པ་ མཐོང་བ་␣ར་ གསུངས་པ་␣ས་ འགལ་ ལོ་ སྙམ་ ན །"
msgstr ""
"If one wonders that it contradicts the statement of seeing of the truth."

msgctxt "8aa39f10fb944c29b1868f8b7976094d"
msgid "དེ་དག་ སྔོན་ གྱི་ རྒྱུ་␣འི་ སྟོབས་ ཀྱིས་ རྐྱེན་ མཚམས་མེད་པ་␣ས་"
msgstr ""
"By the power of previous causes, there are boundless conditions for these."

msgctxt "7ed3fb2d27484f37b9f636fe58ce64b0"
msgid "བར་ དུ་ གཅོད་ མ་ནུ་␣ས་པ་ སྟེ་"
msgstr "Nothing is capable of interrupting."

msgctxt "f4865f3726e5419bbddc0f5f85561d3b"
msgid ""
"མ་སྐྱེས་དགྲ་␣ས་ སངས་རྒྱས་ བྱེ་བ་ ཕྲག་ བདུན་ཅུ་ རྩ་ གཉིས་ ལ་ མཆོད་པ་␣ར་ "
"གསུངས་པ་␣འི་ རྒྱུ་ ལྟ་བུ་␣འོ ། །"
msgstr ""
"It is said that Ajatashatru's offerings to seven hundred and twenty million "
"Buddhas are examples of such causes."

msgctxt "b5df2b0505174753be09262c9ef6a972"
msgid "སྒྲ་ མི་ སྙན་པ་␣འང་ རྐྱེན་ གྱིས་ བླངས་པ་ མེད་ ཀྱང་"
msgstr "Although the inhabitants of Kurava are not taken by conditions."

msgctxt "60318c97ec374d7d84331611b21584ff"
msgid "རང་བཞིན་ གཤིས་ ཀྱིས་ ནི་ ཡོད་"
msgstr "But there is by intrinsic nature."

msgctxt "d50ee6a4d7c346edb40fca456e8c9d81"
msgid ""
"དེ་ ལྷ་␣ར་ སྐྱེས་ ཤིང་ སངས་རྒྱས་ དང་ མཇལ༌་␣ཏེ༌་␣འབྲས་བུ་ ཐོབ་པ་␣ར་ "
"གསུངས་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"It is said that [he] was reborn as a god, met the Buddha, and attained the "
"fruit."

msgctxt "93e20d73b08f4cee88ffc3bffbd9180d"
msgid ""
"སྤྲུལ་པ་␣འང་ ཀླུ་ གཞོན་ནུ་ ལྟ་བུ་ ཚེ་ འདི་␣ར་ འབྲས་བུ་ མི་ ཐོབ་པ་ ལ་␣ས་"
msgstr ""
"Even in terms of emanations, such as the youthful naga, one does not attain "
"the result in this life."

msgctxt "39c88eb4cd54475284fc6d38f03f335d"
msgid "སྡོམ་པ་ མ་ སྐྱེས་པ་ ནི་ མིན་ ནོ་"
msgstr "However, this does not mean that the vows have not arisen. "

msgctxt "ab9c859131c6478c942e1823bb1000c2"
msgid "དེས་ན་ བར་ཆད་ ལྡན་ ན་␣འང་ སྡོམ་པ་ སྐྱེ་བ་␣ར་ སྒྲུབ་བོ །"
msgstr ""
"Thus, it is established that the vows can arise even if there are obstacles."

msgctxt "721b100884dd424d91179bfa404d7b32"
msgid "རྡོ་␣༽༽  གཞན་ གྱིས་ བཞེད་པ་ ནི །"
msgstr "Vajra: Others accept that,"

msgctxt "0c4d0e1b098a49b5b6ebcd2b62a55b6c"
msgid ""
"སྡོམ་པ་␣འི་ ངོ་བོ་ གཞན་ གནོད་ གཞི་ བཅས་ ལོག་པ་ སོགས་ ལེགས་པ་␣ར་ འདོད་པ་ མང་ "
"མོད །"
msgstr ""
"Many accept that the essence of the vows to others is wrongly associated "
"with a harmful basis as excellence."

msgctxt "c1e95a8ea0e44ee4a53ae2c5dcb87a98"
msgid ""
"འདི་␣ར་ ནི་ ངོ་བོ་ རྣམ་པ་␣ར་ རིག་བྱེད་ མིན་པ་␣འི་ གཟུགས་ དེ་དག་ ལ་␣ས་ བྱེད་ "
"སྨྲ་␣འི་ དེ་ བཞེད་ དེ་ །"
msgstr ""
"In this [system], Vaibhashika accepts this as the essence from the "
"imperceptible forms because"

msgctxt "3a06af83c9e14942962b243bb2f24679"
msgid "གཟུགས་ཕུང་ བཅུ་གཅིག་ ལ་␣ས་ རིག་བྱེད་ མིན་པ་ སྡོམ་པ །"
msgstr "From the eleven form aggregates, the imperceptible is a vow."

msgctxt "46493248d91149c2be3066643695ca41"
msgid "སྡོམ་ མ་␣འི་ བར་མ་␣འི་ གཟུགས་ གསུམ་ ལ་␣ས་ སྡོམ་པ་␣འི་ གཟུགས་ ཏེ །"
msgstr "The form of vow from the three middling forms of vows."

msgctxt "97359a15cf7043c3ab06185b2f03fabc"
msgid ""
"དེ་␣འང་ དངོས་གཞི་ རང་ དང་ མཁན་སློབ་ སོགས་ རྣམ་པ་␣ར་ རིག་བྱེད་ དང་ རིག་ མིན་ "
"གཉིས་ཀ་␣འི་ གཟུགས་ དང་"
msgstr ""
"The main part is oneself, the abbot and master, and so on, both perceptible "
"and imperceptible forms and "

msgctxt "1ab7e31e9c7348789149fb3055cd532c"
msgid ""
"སྐད་ཅིག་ གཉིས་པ་ རིག་ མིན་ གྱི་ གཟུགས་ཅན་ དུ་ ཁམས་ བཅོ་བརྒྱད་ ལ་␣ས་ ཆོས་ཁམས "
"།"
msgstr ""
"In the second moment of the imperceptible form, the element of dharmas from "
"the eighteen elements,"

msgctxt "e8fd6dceda7a4006a76537ef238be839"
msgid ""
"སྐྱེ་མཆེད་ བཅུ་གཉིས་ ལ་␣ས་ ཆོས་ ཀྱི་ སྐྱེ་མཆེད་ རྣམ་པ་ བསྟན་ དུ་ མེད་ ཅིང་"
msgstr ""
"From the twelve sense fields, the sense field of phenomena is not taught."

msgctxt "76a5405024e94e42867b482b0ef9571d"
msgid ""
"ཐོག་པ་ མེད་པ་ སྤང་བྱ་ སྤོང་བ་ ལ་ ཆུ་␣འི་ ཆུ་ལོན་ ནམ་ ཤཱ་ རག་ ལྟར་ གནས་ ཏེ་"
msgstr ""
"It will remain like a water dam or a dried apricot in discarding the object "
"of abandonment without obstacles."

msgctxt "8970c63dc316408aa361f6e288a81851"
msgid "མཛོད་ ལ་␣ས །"
msgstr "According to the Treasury of Abhidharma:"

msgctxt "4379f6fb7f554991bc42d336a9cda0d9"
msgid "དེ་ གསུམ་ རྣམ་རིག་ བྱེད་ མིན་ དང༌ །"
msgstr "These three are imperceptible and "

msgctxt "7d6f7f7da2514c6fa42d21ca7818cfe2"
msgid "འདུས་མ་བྱས་ དང་ བྱས་ རྣམས་ དང༌ །"
msgstr "The non-composite and the produced"

msgctxt "87b1063b6cdd4d8187911c96f86793ab"
msgid "ཆོས་ ཀྱི་ སྐྱེ་མཆེད་ ཁམས་ ཞེས་ བྱ །"
msgstr "They are called the elements of the sense field of phenomena. "

msgctxt "92e853b13e8448d4b41bbb13e4b981fc"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "74f22edde7f946d2ab82d56bf1e6f8c6"
msgid "དེ་ ཁོ་ན་ཉིད་ བཞེད་པ་␣འི་ གནད་ ཀྱང་"
msgstr "The essential point about accepting suchness is that"

msgctxt "0c40e45027464a73a715188188e8d463"
msgid "ཆོས་ ཐམས་ཅད་ བསམ་པ་ སྐད་ཅིག་མ་␣འི་ རང་གཟུགས་ ཡིན་པ་"
msgstr "All phenomena are the natural forms of momentary thought,"

msgctxt "d64ce2c9509b479688f91f443e4be137"
msgid "དགེ་ མི་དགེ་␣འི་ བསམ་པ་ གང་དེ་␣འི་ རང་གཟུགས་ སུ་ འགྲུབ་པ་␣ས་ ན་␣འོ ། །"
msgstr ""
"Any virtuous or non-virtuous thoughts are established as the natural forms "
"of those thoughts."

msgctxt "864e54f04fb54973b449c96b794d6969"
msgid "རྡོ་␣༽༽  གཞི་ བསམ་སྦྱོར་བ་ མཐར་ཐུག་ བཞི་ དང་ ལྡན་ ན་ རྫོགས་པ་ ཡིན་ ཏེ་"
msgstr ""
"Vajra: One will be complete if [they] have four [qualities]: basis, "
"aspiration, engagement, and ultimate."

msgctxt "8aa7bccf187742bcaafb2d508f873c5d"
msgid "དེ་␣འང་ འདུ་ཤེས་ གཙོ་བོ་ དང་ དངོས་པོ་ གཙོ་བོ་ གཉིས་ སུ་ བཤད་ མོད །"
msgstr ""
"That is also explained in two ways: perceptions as chief and things as "
"chief."

msgctxt "6f8919a6300f4a70b4207f247b50a8a0"
msgid "འདི་␣ར་ ནི་ ཆོས་ ཐམས་ཅད་ རྩ་བ་ སེམས་"
msgstr "In this [system], the roots of all phenomena is the mind,"

msgctxt "7068db59250b4c9eb8e1cf61975ce5bd"
msgid "དེ་␣ས་ བསྒྲུབས་པ་␣འི་ ལ་␣ས་"
msgstr "Karma produced by it, "

msgctxt "c159c8a9542042cdae9a7f412eb15580"
msgid "དེ་␣འི་ རྣམ་སྨིན་ དང་ གསུམ་ ལ་␣ས་"
msgstr "And its complete ripening [result]. Of these three,"

msgctxt "fa7b6636f9bd49cf8f5b7685bb2d1a6d"
msgid "སེམས་ འགག་␣ས་ ན་ ལ་␣ས་ དང་ རྣམ་སྨིན་ འགགས་པ་␣ར་ གསུངས་པ་␣ས་"
msgstr ""
"It is said that when the mind ceases, karma and its complete ripening cease."

msgctxt "0f774f9acd5b4b2590cec9aceacc818f"
msgid ""
"སེམས་ དགེ་ ན་ ལ་␣ས་ དང་པོ་ དང་ རྣམ་སྨིན་ ཡང་ དགེ་ སྟེ་ སྨན་ གྱི་ ས་བོན་ "
"བཞིན་ དང༌ །"
msgstr ""
"If the mind is virtuous, the beginning of karma and its complete ripening "
"are also virtuous, like the seeds of medicine."

msgctxt "f1ec6ed3da4743388f92988c5352e5f9"
msgid "དེ་ལས་ ལྡོག་ ན་ དུག་ གི་ ས་བོན་ བཞིན་ ནོ ། །"
msgstr "On the contrary, it is like the seeds of poison."

msgctxt "7b7131b193404c63ba3e294505e0c9e9"
msgid "དེ་␣འི་ ཕྱིར་ དེས་པ་␣ས་ ཞུས་པ་ ལ་␣ས །"
msgstr "Therefore, according to the questions by Surata:"

msgctxt "ec0c22dff36c44489815117c6513a300"
msgid "ས་བོན་ ཚ་བ་ རྣམས་ ལ་ ནི །"
msgstr "From spicy seeds."

msgctxt "7332a175e0cc4224b7bd9d9cab65f8db"
msgid "འབྲས་བུ་ ཚ་བ་ སྐྱེ་བ་␣ར་ འགྱུར ། །"
msgstr "Spicy results will be produced."

msgctxt "a87342da5f3f4768afee3e4b0ca0eaf0"
msgid "ས་བོན་ མངར་བ་ རྣམས་ ལ་ ནི ། །"
msgstr "From sweet seeds,"

msgctxt "78123f1b88cd4c108411f6d7d6747fbf"
msgid "འབྲས་བུ་ མངར་བ་ སྐྱེ་བ་␣ར་ འགྱུར །"
msgstr "Sweet results will be produced."

msgctxt "203abb1f1db44c6e8a9c06505f06c3e9"
msgid "ཞེས་ དང་ །"
msgstr "And."

msgctxt "99d6b6459b0f4aa69b26eeeb6ba8d576"
msgid "ཁྱོད་ ཀྱི་ ཐུགས་ འདུལ་ མཛོད་ ཅིག་ བཅོམ་ལྡན་ གྱིས །"
msgstr "Please tame your mind, the Blessed One said."

msgctxt "13ec2eb33c1c499e86e90aa1ec38c865"
msgid "སེམས་ ནི་ ཆོས་ ཀྱི་ སོཌ་ དང༌ །"
msgstr "Mind is the Dharma, and so on."

msgctxt "f3a5afd354f54638943701088c2ba731"
msgid "ལ་␣ས་ རྣམ་འབྱེད་ ལ་␣ས །"
msgstr "According to the full analysis of karma,"

msgctxt "df121f57e74d465ebeab8d4c6097cde3"
msgid "བྱས་ ལ་མ་ བསགས་པ་ སོགས་ བཞི་ གསུངས་"
msgstr ""
"[Karma] is said to be of four [types]: [karma] that is performed but not "
"accumulated, and so on."

msgctxt "5ed23948974f426cb098051aecde795d"
msgid "སེམས་ ལ་ རྨ་ བྱུང་ ན་ ཉེས་པ་ མེད་པ་␣ར་ གསུངས་པ་␣ས་"
msgstr "If a wound occurs in the mind, it is said that there is no fault."

msgctxt "2798d6b0681045619a8d8fab9819af0a"
msgid ""
"དེ་␣འི་ ཕྱིར་ ལྟུང་བ་ མཐའ་དག་ ལ་ ནི་ ཀུན་སློང་ བསམ་པ་ འདུ་ཤེས་ གཙོ་ སྟེ་"
msgstr ""
"Therefore, motivation, aspiration, and perception are the most important "
"[factors] in all downfalls."

msgctxt "4aba282096054386b60e9c78a17e1ef0"
msgid "དགེ་སློང་ དགོན་པ་བ་ ཚོགས་ཅན་ མི་ སྐབས་པ་ བཟང་མོ་ བཞིན་ ནོ །"
msgstr "Like the bhikshu Aranyaka and Bhadra."

msgctxt "fcd0c42c30f94e068e692f9187e1929f"
msgid ""
"རྡོ་␣༽༽  སོ་ཐར་ གྱི་ སྡོམ་པ་ ནི་ གཙོ་བོ་␣ར་ ལུས་ངག་ གི་ སྤོང་བ་ བདུན་ དང་"
msgstr ""
"Vajra: The vows of individual emancipation are said to the seven "
"abandonments of body and speech and,"

msgctxt "e94c763b5f5c4262b2d148807f2c16c8"
msgid "འཁོར་ ཡིད་ ཀྱི་ གསུམ་པོ་ དེ་ ཞོར་ ལ་ སྤོང་བ་␣ས་"
msgstr ""
"Inadvertently, the three [abandonments] of mind that accompanied them are "
"abandoned."

msgctxt "279306f61eba41cbaf8a2f284ec9e0f3"
msgid "སྤོང་ བདུན་ འཁོར་བཅས་ ཡིན་ ཟེར་བ་ དང་ །"
msgstr ""
"Thus, they are said to be the seven abandonments with their accompaniments."

msgctxt "285656195fd84a1ba1c90260095fac5d"
msgid "ཡིད་ ཀྱི་ གསུམ་ ནི་ བྱང་སེམས་ ཀྱི་ ཡིན་པ་␣ས་"
msgstr "Since the three [abandonments] of mind are those of bodhisattvas."

msgctxt "727293977c2449eb92f9212c1387063f"
msgid "སྤོང་ འདུན་ ཁོ་ན་ ལས་མི་ དགོས་ ཟེར་ རོ ། །"
msgstr "Thus, it is said that only the seven abandonments are needed."

msgctxt "9750ddd8ce2c42b5b1db2043a7891120"
msgid "འདི་␣ར་ ནི་ ཡིད་ ཀྱི་ གསུམ་ ནི་ དུག་ གསུམ་ ཡིན་ ཞིང་"
msgstr ""
"In this system, the three [abandonments] of the mind are the three poisons."

msgctxt "d52391da87724aaca19f60e49f202f06"
msgid ""
"དེ་␣ས་ བསྐྱེད་པ་␣འི་ ལ་␣ས་ སྡིག་པ་ ཡིན་པ་ དེ་ སོ་ཐར་ གྱིས་ སྤོང་ དགོས་ ཏེ །"
msgstr ""
"Because actions that arise from them are negative, thus they must be "
"abandoned by pratimoksha. "

msgctxt "d57c0938472f4d77ab04b3a05722054e"
msgid "ལུང་ རྣམ་འབྱེད་ ལ་␣ས །"
msgstr "According to the full analytical scripture:"

msgctxt "3ba4acd20f8f49c28b5494522a095dd6"
msgid "ངས་ འདོད་ཆགས་་་ འདོད་ཆགས་ དང་ བྲལ་བ་␣འི་ ཕྱིར་ །"
msgstr "Because I am free of desire."

msgctxt "c347677e60524de2b3402ea4431979b0"
msgid "སེམས་ རྣམ་པ་␣ར་ གྲོལ་བ་ དང་"
msgstr "The complete liberation of the mind and "

msgctxt "f4ce567316794a3f830a0e59f211085a"
msgid "ཤེས་རབ་ རྣམ་པ་␣ར་ གྲོལ་བ་␣འི་ ཆོས་ བསྟན་པ་ ཅེས་ སོགས་ དང་ །"
msgstr ""
"The Dharma teaching of the complete liberation of wisdom and so forth and"

msgctxt "7c57081d770d43268da53de1dd97a574"
msgid "སྡིག་པ་ ཅི་ཡང་ མི་ བྱ་ ཞིང །"
msgstr "Do not engage in any negative action,"

msgctxt "8a1e5abd9a364143a8306db2fd7cf8ca"
msgid "དགེ་བ་␣x"
msgstr "[Engage in the perfection of] virtue"

msgctxt "b50ac42e3b8e427da745202fd8db42b7"
msgid "རང་ གི་␣x"
msgstr "[Completely tame] one's own [mind]."

msgctxt "28a1337990ad4f688872dc26f98c7aed"
msgid "འདི་ ནི་  x"
msgstr "This is [the teaching of the Buddha]."

msgctxt "00194f261c184edca863cc19f51e0734"
msgid "ཅེས་ དང༌ །"
msgstr "And."

msgctxt "fa35713a81484204ad456e6443d89394"
msgid "ལུས་ ཀྱི་ སྡོམ་པ་ ལེགས་པ་ ན །"
msgstr "When the vows of the body are excellent,"

msgctxt "dd3c8402cbc94b46b757fbb8c96c5aff"
msgid "ངག་ གི  x"
msgstr "[The vows of] speech [are also excellent]."

msgctxt "339b275906be4a1cbb6fb2bd929bbdaa"
msgid "ཡིད་ ཀྱི་␣x"
msgstr "When the vows of mind are excellent."

msgctxt "9ca53ec651a045bca1edff24b52b7077"
msgid "ཐམས་ཅད་ དུ  x"
msgstr "In every way, [the vows are excellent]."

msgctxt "4939590a69a045b389875f4d76b1d46b"
msgid "ཞེས་ གསུངས་པ་␣ས །"
msgstr "As said."

msgctxt "0da4a00e75a54047b55843e0eaca6dbc"
msgid "ཡིད་ ཀྱི་ གསུམ་པོ་ སྡིག་པ་ མིན་པ་␣ར་ ཐལ །"
msgstr ""
"It follows that the three [abandonments] of the mind are not a negative "
"action."

msgctxt "0b5483a1ef5146e68f74a507af79a405"
msgid "ཁྱེད་ རང་ གིས་ བཞེད་པ་␣ས །"
msgstr "Because you accepted it."

msgctxt "6c67f785f466469aba86851b950e3e7e"
msgid "ངེས་འབྱུང་ གིས་ ཐོབ་པ་ དེ་ ཡིད་ མིན་པ་␣ར་ ཐལ །"
msgstr "It follows that attainment of definite emergence is not mind."

msgctxt "163e2878f48a4d62ad9b8d600a915f4c"
msgid "འདོད་ མི་ ནུས་ ཏེ །"
msgstr "[You] cannot accept that."

msgctxt "94998f1921274e409db203cad8795f6f"
msgid "མངོན་སུམ་ གྱིས་ བསལ་ ལོ ། །"
msgstr "Because it is eliminated by direct perception."

msgctxt "6e2d97fb053c449395bfbb7f4da0eacf"
msgid "དེས་ན་ ལུས་ ཀྱི་ སྤྱོད་ཚུལ་ བཟང་ ཡང་ མི་ ཕན་ ཏེ་"
msgstr "Even good physical behavior is not beneficial. "

msgctxt "8e74dcc7488a494aabaccaa96071cfe4"
msgid "ཐབ་ ཀྱི་ མེ་ བསད་ ན་ སྐར་ཁུང་ གི་ དུ་བ་ ཆད་པ་ བཞིན་"
msgstr ""
"Like when the hearth fire is extinguished, the window smoke discontinues."

msgctxt "76799229a81d42c9be9c212746b87ed2"
msgid "ཡིད་ བཀག་ ན་ ལུས་ངག་་་་ ཁེག་ ཅིང །"
msgstr "When the mind is stopped, the body and speech will be ceased."

msgctxt "e1ecdd4a47f041398895aa9efce0d126"
msgid "མ་ བཀག་ ན་ མི་ ཁེག་པ་"
msgstr "If [the mind is] not stopped, [they] will not cease."

msgctxt "8d806604f69d4cd38c686a618a3bcb24"
msgid "ཉེས་པ་␣ས་ བསྐྱེད་པ་␣ས་ འཁོར་ལོ་ བསྒྱུར་བ་␣འི་ རྒྱལ་པོ་ བཞིན་ ནོ །"
msgstr "Aroused by faults, just like a universal monarch."

msgctxt "20900d4248cb429aa1590bf512cf3990"
msgid "དེ་ཕྱིར་ ཡིད་ ཀྱི་ རྣམ་ གསུམ་ གཙོ་བོ་␣ར་ སྤོང་བ་ དགོས་ སོ །"
msgstr ""
"Therefore, the three types of the mind are the most important to abandon."

msgctxt "449a3fe4680e4c609f2c71515039b8ff"
msgid "རྡོ་␣༽༽  མཛོད་ ལ་␣ས །"
msgstr "According to the Treasury of Abhidharma:"

msgctxt "24226d447e0a4ebe86fdd0e206cf3c6e"
msgid "བསླབ་པ་ ཕུལ་ དང་ ཤི་འཕོས་ དང༌ ། །"
msgstr "Offering back the training and death and transferring, "

msgctxt "0b7a8849ac7a40afb654bfcd1b0649b9"
msgid "རྩ་བ་ ཆད་ དང་ མཚན་ འདས་ དང༌ །"
msgstr "The root is cut off and beyond signs, and"

msgctxt "3819f0785a5145d499825f017574cb7d"
msgid "མཚན་ གཉིས་ གཅིག་ ཆ་␣ར་ བྱུང་བ་ ན །"
msgstr "When the two signs occurred at the same time."

msgctxt "b38446e107b7464ab2ed7ca19a537010"
msgid "སོ་སོ་␣ར་ ཐར་པ་␣འི་ སྡོམ་པ་ གཏོད །"
msgstr "The vows of individual emancipation are imparted."

msgctxt "f310bc21fce34719a328facca0539eca"
msgid "ཞེས་པ་ ལྔ་ དང །"
msgstr "As the five and "

msgctxt "442656969f9c4997a4a7a61c00b2b183"
msgid "འདུལ་ ལུང༌་␣ལ ས །"
msgstr "According to the Vinaya scriptural transmission:"

msgctxt "3808de45b6174fc9b759525e5aec08c0"
msgid "མཚན་ ལན་ གསུམ་ འགྱུར་བ །"
msgstr "The signs change three times."

msgctxt "5e4088aeb0074df8afe940920fdbf9f9"
msgid "ཉི་ཤུ་ མ་ ལོན །"
msgstr "Has not reached twenty."

msgctxt "71a2a4bd98f84edeb6d5d459d80ac5e2"
msgid "བསྙེན་རྫོགས་ ཤེས་པ །"
msgstr "Aware of full ordination."

msgctxt "1ae5134956754a32b3dceb8ffe4be9bb"
msgid "དམ་ཆོས་ ནུབ་པ །"
msgstr "The holy Dharma declines. "

msgctxt "f93a62f06a4f4faa996a8f1d1073acc9"
msgid "རྩ་ལྟུང་ བྱུང་བ་ སྟེ་ དགུ་པོ་␣ས་ གཏོང་བ་␣ར་ གསུངས་ མོད །"
msgstr ""
"The occurrence of the root downfalls is said to be passed by these nine."

msgctxt "b616178f5d3245e784c950526f17995d"
msgid ""
"འདི་␣ར་ ནི་ གཏོང་བ་␣འི་ རྒྱུ་ དགུ་པོ་ དེ་ ཡི་ ནང་ ནས་ མི་ གཏོང་བ་ ཡང་ འག་␣ས་"
" ཞིག་ ཡོད་ དེ་"
msgstr ""
"In this [system], there are several non-passings among the nine causes of "
"passing."

msgctxt "1c4631014f5f442289efb41e57bb5238"
msgid "ལུང་ རྣམ་འབྱེད་ ལ་␣ས་ ཕུལ་བ་ མ་ ཉམས་པ །"
msgstr ""
"According to the full analytical scripture: the offering that is not "
"degenerated."

msgctxt "cc4c085af35c4e9d9ad32b8a39f0c1ec"
msgid "ཉམས་ ལ་མ་ ཕུལ་བ །"
msgstr "That which is degenerated and not offered."

msgctxt "b8062bc8b9b14887ad47e220382aa94d"
msgid "ཕུལ་ ཡང་ ཕུལ་ ལ་ ཉམས་ ཡང་ ཉམས་པ་ སྟེ་"
msgstr "That which is also offered as well as degenerated."

msgctxt "a52f3fc803534010b6cf2450af184e3e"
msgid "མུ་ གཞི་␣ར་ གསུངས་པ་ གསུམ་པ་␣ས་ གཏོང༌ །"
msgstr "It is said that there are four possibilities, passing by the third. "

msgctxt "3b488f2fe470466bab934962c68ef28c"
msgid "དབང་ རབ་ ཤི་འཕོས་པ་␣ས་ མི་ གཏོང་ སྟེ །"
msgstr "Those of the highest faculties do not pass because [they] die."

msgctxt "c7c0d4c434974ba1a42a89bae79c57d1"
msgid "སེམས་ སྐྱེ་བ་␣འི་ ཉོན་མོངས་པ་ བསྡམས་ ནས་"
msgstr "The mind restrains the afflictive emotions of birth."

msgctxt "4227db6d8c8b4aa08130cf6bdaad3a87"
msgid "ཡུལ་ གྱི་ རྗེས་སུ་ མི་ འབྲང་བ་␣ས་ ཚུལ་ཁྲིམས་ རབ་ཏུ་ གྱུར་པ་␣འི་ ཕྱིར །"
msgstr ""
"Because it does not follow objects, it becomes an excellent discipline."

msgctxt "6cebfb42293443bdb3d489f9438b5c88"
msgid "ཕལ་ཆེན་ ལ་␣ས །"
msgstr "According to the Avatamsaka [Sutra]:"

msgctxt "bd96eca066714f609c7465c27c68df96"
msgid "དགེ་ དང་ མི་དགེ་ རྣམ་སྨིན་ གོམས་ བྱས་ ན །"
msgstr ""
"When habituated to the virtues, non-virtues, and the complete ripening,"

msgctxt "0aff6e9decdb47df910e300f5d6369d8"
msgid "མི་ རྣམས་ ལ་ ནི་ འདྲེས་པ་ ཉིད་ དུ་ འགྱུར །"
msgstr "Then humans will become altered."

msgctxt "2dd7e3637e3142e39eac3b723889b541"
msgid "དེ་ལྟ་ བུ་ དག་ ཆེད་ དུ་མ་ བསྒྲུབ་ ཀྱང་ །"
msgstr "Though not accomplished in such a purity."

msgctxt "43a4de229ed448b5baddfc24b2211f4f"
msgid "སྲིད་པ་ གཞན་ ལ་ རྨི་ལམ་ བཞིན་ དུ་ སྤྱོད །"
msgstr "Engage in another existence like a dream."

msgctxt "df1e90093b104d42b7172c9fcc98647e"
msgid "ཅེས་ དང་ །"
msgstr "And"

msgctxt "4834b3b213e744b8a24da76be819648c"
msgid "ཁྲི་ རྐང་ གི་ གླིང་ གཞི་ ལ་␣ས །"
msgstr "According to the Continent of Supported Throne: "

msgctxt "cbc13ce0ad9243caa2fd7028076db17f"
msgid "དགེ་སློང་ དགོན་པ་བ་ ཞིག་ ཚེ་ འཕོས་ ནས་"
msgstr "After a monk who lived in a monastery passed away, "

msgctxt "22d4f91ab7184f329fbeb032d7f03833"
msgid "ལྷ་␣ར་ སྐྱེས་ འདོད་ཡོན་ སྟབས་ ཀྱང་"
msgstr "Though [he] was reborn as a god in the manner of sense pleasures."

msgctxt "3a2bcff7d0bf46d08f6f5378fc8f5722"
msgid "འདུ་ཤེས་ དང་ མ་ བྲལ་བ་␣ས་ དང་ དུ་མ་ བླང་བ་␣ར་ གསུངས་པ་␣འི་ ཕྱིར །"
msgstr ""
"But because he was not free from perception, it is said that [he] took "
"several times."

msgctxt "01f051f9d9854c26b3c633147f56e5aa"
msgid ""
"དབང་ འབྲིང་ ཐ་མ་ གཉིས་ ཀྱང་ ཕྱི་མ་␣འི་ འབྲས་བུ་ ལ་ ལྟོས་ ན་མ་ གཏོང་བ་ ཡིན་ "
"ནོ ། །"
msgstr ""
"Both the least and medium faculties, if they do not rely on the latter "
"result, then [they] are also not passed."

msgctxt "9be438df9b8c470e9925d777440bb522"
msgid "གལ་ཏེ་ ཤི་འཕོས་པ་␣ས་ གཏོང་ ན་"
msgstr "If they would pass because of death,"

msgctxt "6a083d5377034b1ea6d94c3b984d29ce"
msgid "བསྲུང་བ་␣ས་ ཅི་ བྱ་ སྟེ་ དགོས་ དུས་ མི་ ཕན་པ་␣ས་ སོ ། །"
msgstr ""
"What is the point of protecting it? It is useless at the time of need."

msgctxt "98d29393cf824b75a75d389e4e1a64d2"
msgid "བསྙེན་གནས་ ས་བོན་ བག་ཆགས་ ཀྱི་ ཆ་ ནས་ མི་ གཏོད །"
msgstr ""
"The one-day vows are not bestowed from the aspect of [sowing] the seeds of "
"latency."

msgctxt "cb5770e41767433498d12674bf07469c"
msgid "ཆོས་ ནུབ་པ་␣ས་ གཏོང་ མི་ གཏོང་ མ་ངེས་པ་ གསུམ་ ཀ་ ཡོད །"
msgstr ""
"Because the Dharma declines, there are three possibilities: passing, non-"
"passing, and uncertain."

msgctxt "241b77768dae4e9c899cfed32b3524c4"
msgid ""
"མི་ གཏོང་བ་ ནི་ འོད་སྲུང་ གི་ བསྟན་པ་ ལ་ བརྩོན་འགྲུས་ བྱས་པ་␣ས་ ཀུན་ཤེས་ "
"ཀཽཎྜི་ ནྱར་ གྱུར་པ་ བཞིན་ ནོ །"
msgstr ""
"Non-passing is the same as Kashyapa's perseverance in the teachings, as is "
"becoming Ajnata­kaundinya."

msgctxt "11494914bc3a4ece9e1d01220b15a81e"
msgid ""
"རྡོ་␣༽༽  གཞན་དག་ གིས་ རྩ་ལྟུང་ གཅིག་ བྱུང་ ན་ སྡོམ་པ་ ཐམས་ཅད་ ཞིག་པ་␣ར་ "
"འདོད་པ་ ཡོད་ མོད །"
msgstr ""
"Vajra: Others accept that if a root downfall occurs, all vows will be "
"broken."

msgctxt "ed88d073dc4a4d0c84f5915099959985"
msgid "འདི་␣ར་ ནི་ མཛོད་ ལ་␣ས །"
msgstr "In this [system], According to the Treasury of Abhidharma:"

msgctxt "b8a6e95c4f444b6eb32b1b97329504eb"
msgid "ཁ་ཆེ་ དག་ ནི་ བྱུང་བ་ ན །"
msgstr "There were some Kashmiris,"

msgctxt "bb334fad6d2d48f6b20554f7ec9ce1c0"
msgid "བུ་ལོན་ ནོར་ ཅན་ བཞིན་ དུ་ འདོད །"
msgstr "Who accept it like a debt of wealth."

msgctxt "2c711c4347424867b2a00b8c87b193b1"
msgid "ཅེས་པ་ བྱེ་ སྨྲ་␣འི་ འདོད་པ་␣ར་ ལྟུང་བ་ གཅིག་ བྱུང་ ཡང་"
msgstr "Vaibhasika accepts that even a downfall occurs"

msgctxt "58e28326175046f5ba9f8a6383f39424"
msgid "གཞན་ གསུམ་ མི་ གཏོང་བ་ འདི་ རྗེས་ ཀྱང་ བཞེད་ དོ །"
msgstr "The other three will not be passed, the latter is also accepted."

msgctxt "de46ba88dd6b4784bb40a6e20dc3f71f"
msgid "གལ་ཏེ་ གཅིག་ གིས་ ཐམས་ཅད་ ཉམས་ ན་"
msgstr "If one causes the degeneration of all others,"

msgctxt "017cfe1e338548788446a730a9fdb3df"
msgid "གཅིག་ བསྲུང་བ་␣ས་ ཐམས་ཅད་ སྲུང་བ་␣ར་ ཐལ་ ལོ ། །"
msgstr "Then it absurdly follows that protecting one protects all."

msgctxt "ae504ddd549843c3b24c43895a020ddd"
msgid ""
"འོ་ན་ ལུང་ ལ་␣ས་ གཅིག་ བྱུང་ ན་ དགེ་སྦྱོང་ དུ་ མི་ རུང་ གསུངས་པ་ ནི་ དེ་ "
"ཁོ་ན་␣འི་ ངོས་ ན་␣འོ ། །"
msgstr ""
"Well, then the scripture says that if one occurs, it is not suitable for "
"virtue training, is on the side of just itself."

msgctxt "dc7e10e6f11e4936b2e4ac29c96ef05b"
msgid "དེ་␣འི་ ཕྱིར་ ཕམ་པ་ བཞི་ ཉམས་པ་ ནི་ བུ་ལོན་ དགོས་པ་ ལྟར་ དང་"
msgstr ""
"Thus, the degeneration of the four defeats is like a need for debt and"

msgctxt "0501807b8fd445f6881e1256aabaa892"
msgid "ཉམས་པ་ ནི་ རང་ ལ་ ནོར་ ཡོད་པ་ ཅན་ བཞིན་ ནོ །"
msgstr "The degradation is similar to all of one's wealth."

msgctxt "0756305569454cd19788d8ee92416f5a"
msgid "རྡོ་␣༽༽  གཞན་དག་ ན་རེ །"
msgstr "Vajra: Others said."

msgctxt "8027525030ec411d9a1c2c5fa3957573"
msgid "ལྟུང་བ་ གཅིག་ བྱུང་ ན་ ངན་འགྲོ་␣ར་ ལྟུང་བ་ ཡིན་པ་␣ས་"
msgstr "When one downfall occurs, [one] will fall to the bad migrations."

msgctxt "84b7561aa49f4b84b7b7822bd52b4cf9"
msgid "སྣ་ རེ་གཉིས་ སྲུང་མ་ སྲུང་ མེད་ ཟེར་ རོ ། །"
msgstr "Thus, [they] said that protecting one or two is pointless."

msgctxt "b0c8a02510f64c638c6aec55d41c7b0a"
msgid "འདི་␣ར་ ནི་ སྣ་ གཅིག་ བསྲུང་བ་␣ས་ འབྲས་བུ་␣ས་ ཀྱང་ མྱ་ འདས་ ཐོབ་ སྟེ །"
msgstr ""
"In this [system], the result of protecting one type [of vows] is the "
"attainment of nirvana."

msgctxt "c23db004ac8a49ee93e154e74cee38d6"
msgid "མཆོག་ གསུམ་ ལ་ ཡིད་ རབ་ཏུ་ དྭངས་ བས་"
msgstr "Because the mind becomes very pure in the three jewels."

msgctxt "2a7642a1227844b597e8f8243c322eaf"
msgid "སྣ་ གཅིག་པོ་ དེ་ རྐྱེན་ གང་ གིས་ ཀྱང་ མིི་ འཇིག་པ་"
msgstr "This one type [of vows] will not be destroyed by any condition."

msgctxt "e61d346105144c4e867a9ec7f3b9e446"
msgid ""
"ཕྱི་བཤོལ་ མེད་ ཅིང་ སྲོག་ གི་ ཕྱིར་ཡང་ མི་ འདོར་བ་␣འི་ བརྟུལ་ཞུགས་ ལ་ འབད་པ་"
" ཞིག་ བྱུང་ ན་ མཐ་␣ར་ ཁྱོན་ ལ་␣ས་ འདའ་ སྟེ །"
msgstr ""
"If one puts effort into the yogic discipline without procrastination and "
"without discarding it even for one's own life, one will transcend from the "
"ultimate domains."

msgctxt "241453efd2cf4c16a7735eb3cdfcc7a3"
msgid "སྙིང་རྗེ་ པད་དཀར་ ལ་␣ས །"
msgstr "According to the Compassionate White Lotus:"

msgctxt "0e03f78102f34c4d8d8eda82f0651f50"
msgid "ང་ ཡི་ བསྟན་ ལ་ རབ་ཏུ་ བྱུང་བ་ བུ་␣འི་ ལག་པ་ ནས་ བཟུང་ སྟེ་"
msgstr "Become excellent in my teaching, by holding the son's hand."

msgctxt "98feb9d33c2741fdbc1a3b2cf2e2b128"
msgid "ཁྱིམ་ དུ་ རྒྱུ་བ་ རྣམས་ ཀྱང་ བསྐལ་པ་ བཟང་པོ་ འདི་ ལ་"
msgstr ""
"Also, all those who move to the household will, in this excellent aeon, "

msgctxt "bb4cfab955404b06be936dd76d2600e8"
msgid "གཅིག་ ཀྱང་ མ་ལུས་པ་ མྱ་ངན་ ལ་␣ས་ འདའ་བ་␣ར་ འགྱུར་ རོ ། །"
msgstr "Pass into nirvana without leaving anyone behind."

msgctxt "2f9591c66bec4379a12cfce3ffd93f0c"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "9aef3ed0991a42b997ad5cb5acc42414"
msgid "རྡོ་␣༽༽  གཞན་ ཤེས་ ལ །"
msgstr "Vajra: In the knowledge of others,"

msgctxt "3a42d6f662da4ff38036cc64af008ab0"
msgid "རྩ་ བཞི་ ངོ་བོ་␣འི་ ཆ་ ནས་ རང་བཞིན་ དང་ །"
msgstr "The four roots are natural in terms of their essence and"

msgctxt "d854fb7b398149598d51cdb5110d85fc"
msgid "ས་ རྐོ་ མེ་ རེག་ སོགས་ འདུ་ཤེས་ ཀྱི་ ཆ་ ནས་ བཅས་པ་ སྟེ་"
msgstr ""
"Also digging into soil, fire, contact, and so on are associated in terms of "
"perception."

msgctxt "e31d9c9959b747e8a5e9a4c96022752f"
msgid "རང་བཞིན་ ཨ་མྲ་␣འི་ ཚལ་ ལ་ བཅས་པ་ སྒྱིས་ འཚལ་ ལྟ་བུ་␣ས་ བསྲུངས་ ཏེ་"
msgstr "It is protected like the garden of a natural mango grove."

msgctxt "a4350a19bccc43c29fd2b535ab3a0cd5"
msgid "རང་བཞིན་ གཏན་ ནས་ བཀག་པ་ ཡིན་ ལ །"
msgstr "That is firmly prohibited by nature."

msgctxt "beb39b2a54b64875a5987fed0f6f6ffc"
msgid "བཅས་པ་ གནང་བ་␣འི་ སྐབས་ ཡོད་པ་␣ས་ ཐ་དད་ ཡིན་ ཟེར་ ཡང་ །"
msgstr ""
"It is said that they are distinct because there are occasions when the "
"associated [wrong-doing] is permitted."

msgctxt "62706c349dd84d0f90a408f3d181bc64"
msgid "འདི་␣ར་ ནི་ བཅས་པ་ དང་ རང་བཞིན་ གྱི་ ཁ་ན་མ་ཐོ་བ་ གནད་ གཅིག་ སྟེ་"
msgstr ""
"In this [system], the associated and natural wrong-doings essentially the "
"same."

msgctxt "e90ad3374e704bde93ae373dfcb62bf7"
msgid ""
"སངས་རྒྱས་ ཀྱི་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ ཀྱིས་ རྒྱུ་འབྲས་ རྟེན་འབྲེལ་ བསླུ་བ་ "
"མེད་པ་ འབྱུང་བ་␣ར་ གཟིགས་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr ""
"The omniscient wisdom of the Buddha observes the undeceiving dependent "
"relation of cause and effect and "

msgctxt "7a405bb0b79343f99c2253c5e508cdc4"
msgid "ཆོས་ ཐམས་ཅད་ ཀྱི་ ངོ་བོ་␣ར་ སངས་རྒྱས་པ་␣ས་"
msgstr "[Buddha] has enlightened in the essence of all phenomena."

msgctxt "445bfc7f15b8471fa05ac00b1b1b2781"
msgid "ཕྱྭ་ དང་ དབང་ཕྱུག་ ལྟར་ བྱེད་པོ་ མིན་པ་␣འི་ ཕྱིར་ དང་"
msgstr "[He] is not a creator like Ishvara or ཕྱྭ and "

msgctxt "2053ec605d4a4594b28e8249e454d54a"
msgid "བརྩེ་བ་ ཆེན་པོ་␣ས་ སེམས་ཅན་ ཐམས་ཅད་ ཐུགས་ སྙོམས་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "An equanimous mind toward all sentient beings with great compassion."

msgctxt "75c8d2d08df4422987774bbd5ae300ed"
msgid "བརྩོན་པ་ མི་ འདོར་བ་␣ས་ གནོད་པ་ སྤོང་ ཞིང་"
msgstr "By not giving up diligence, hurm is abandoned. "

msgctxt "8903c652791248bca524b4107f0c4b55"
msgid "ཕན་བདེ་ ལ་ སྦྱོར་བ་␣ར་ མཛད་པ་␣འི་ ཕྱིར་"
msgstr "Performed so to connect to benefit and ease."

msgctxt "f034c93f31154dcba5774a89caf11412"
msgid "རང་བཞིན་ དང་ བཅས་བ་ གང་ མ་ བསྲུངས་ ཀྱང་"
msgstr "Neither the natural nor the associated [wrong-doing] is protected."

msgctxt "02f37a1c73ae46b084a5760adaabe140"
msgid "གཤིས་ ལ་ ཇི་ལྟར་ ཡོད་པ་␣འི་ ཉེས་དམིགས་ འབྱུང་ སྟེ་"
msgstr "The disadvantages of how [it/thing] exists in nature have occurred."

msgctxt "fcbd60b9b3854c4dadf2590fadbb2bd6"
msgid ""
"རང་བཞིན་ གྱིས་ བཅས་པ་ ལ་ ཁྱབ་ བཅས་པ་␣ས་ རང་བཞིན་ ལ་ ཁྱབ་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"The natural [wrong-doing] pervades the associated [wrong-doing], and the "
"associated [wrong-doing] pervades the natural [wrong-doing]. "

msgctxt "066be7034ae4414cbb6f65a38d266692"
msgid "འོ་ན་ དུད་འགྲོ་␣ར་ མ་ བཅས་ ཤིང་ ཉེས་པ་ ཡང་ མ་ གསུངས་པ་␣ས་ ཅི་སྙམ་ ན །"
msgstr ""
"Well, if one wonders why animals are not associated with and there is no "
"mention of fault."

msgctxt "c754be0e4c584a8ab78db67102771215"
msgid "བཅས་པ་␣འི་ ཉེས་པ་ དུད་འགྲོ་␣ར་ སྐྱེ་ ཞིང་"
msgstr "The fault of the associated [wrong-doing] arises in animals. "

msgctxt "2f8b99ce3f6f40b297fedec202c0b7c8"
msgid "མྱ་ འདས་ ལ་ རྒྱབ་ ཀྱི་ ཕྱོགས་པ་ དེ་ ཡིན་ ཅིང །"
msgstr "It faces the backside of nirvana."

msgctxt "05e2dc9e45d54f64bb31836e49b78957"
msgid "སྤྱིར་ བཅས་ ཀྱང་ དམིགས་བསལ་ དུ་མ་ གསུངས༌པ་ ནི་"
msgstr ""
"Though [animals] are generally associated with, not mentioning it "
"specifically is due to"

msgctxt "4065ac3b8f5b4544b8cf04f88b52056d"
msgid "དཔེར་ན་ ཕས་ བུ་ འགའ་ཞིག་ ལ་ བྱ་བ་ མིན་པ་ བསླབ་ ཀྱང་"
msgstr "For example, when a father advises some of his sons on wrong actions."

msgctxt "28b7dfb0fbd04cabb8a74054480a45a1"
msgid "མི་ ཉན་པ་ ཞིག་ བྱར་མེད་པ་␣ས་ སྐྱུར་བ་ དང་ མཚུངས་ སོ །"
msgstr "Nothing to do with those who do not listen, it is like forsaken."

msgctxt "1aeca968e16f4d6094cd1b4a6592c91d"
msgid "ལྷན་␣༽༽  འདུལ་བ་ སྡེ་པ་ བཞི་ ལ །"
msgstr "Addendum: In the four schools of vinaya."

msgctxt "5e73e353ad5c40a6b852c5d3925a98f2"
msgid "མི་ འདྲ་བ་ རེ་རེ་ འདོད་པ་ ཡོད་ མོད །"
msgstr "Each has different positions."

msgctxt "330ae3e7c5ad4ae9920594407eb8ad00"
msgid ""
"འདི་␣ར་ ནི་ སྡེ་པ་ ཀུན་ གྱི་ འདུལ་བ་␣འི་ རྩ་བ་ ནི་ ལུང་སྡེ་བཞི་ ཁོ་ན་␣ར་ "
"ངེས་ ཏེ །"
msgstr ""
"In this [system], the root of vinaya of all the schools is certain to be "
"only the four sections of the scripture."

msgctxt "10f4f141c2974cb29b106a4cfc3fe1ee"
msgid ""
"སངས་རྒྱས་ ཀྱི་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ ཀྱི་ ལུང་སྡེ་བཞི་ བསྒྲུབ་པ་␣འི་ ཕྱིར །"
msgstr ""
"The omniscient wisdom of the Buddha accomplishes the four sections of the "
"scripture."

msgctxt "4096cbed48dc4bf5b4d838a5e485f6b3"
msgid "མ་ གྲུབ་ ན་ ཉན་ཐོས་ དང་ སངས་རྒྱས་ སྤངས་རྟོགས་ མཉམ་པ་␣ར་ ཐལ །"
msgstr ""
"If they are not accomplished, it follows that shravakas and the buddhas are "
"equal in abandonment and realization."

msgctxt "efcea724b4e94d5e8565a94efbc9f2ff"
msgid "ལུང་སྡེ་བཞི་ རེ་རེ་ བཅའ་ ཞུས་པ་␣འི་ ཕྱིར །"
msgstr ""
"Because each of the four sections of the scripture is requested to be set in"
" place."

msgctxt "c56ae694a222465ba5ae511739e515f1"
msgid "འདོད་ མི་ ནུས་ ཏེ །"
msgstr "[You] cannot accept that."

msgctxt "9d6acc654e094c4d8d4def73d1e20bf7"
msgid ""
"ས་བཅུ་པ་␣འི་ བྱང་སེམས་ ཀྱིས་ ཀྱང་ འཆའ་ མི་ ནུས་ ན་ གཞན་ གྱིས་ ལྟ་ཅི་ སྨྲོས །"
msgstr ""
"If even the bodhisattvas of the tenth level cannot set it in place, others "
"do not need to be expressed."

msgctxt "0799e9e2db654d5a99bed6d5796191b5"
msgid "གྲུབ་མཐའ་ བག་ རེ་ མི་མཐུན་པ་ མ་གཏོགས་"
msgstr "Apart from a few discordant tenet systems,"

msgctxt "ab5eff135f384215a913b8ba2cfaec31"
msgid "དགག་སྒྲུབ་ ཀྱི་ བསླབ་པ་␣ར་ གཞོལ་ ཞིང་ འབབ་པ་␣འི་ ཕྱིར །"
msgstr "It engages and falls in the training of negation and assertion."

msgctxt "304c880fec8e4310b3d5860b5509d6dc"
msgid "ལུང་ ལ་␣ས །"
msgstr "According to the scripture:"

msgctxt "12dd502700684255827198bc54ce0cb0"
msgid "ཇི་ལྟར་ འདི་ ན་ ཤིང་རྩ་ གཙོ་བོ་ སྟེ ། །"
msgstr "Just like the roots of a tree being the most important,"

msgctxt "bcf2454ef2ff4c99b5d69203f4f73d48"
msgid "རྣམ་པ་␣ར་ འཕེལ་ དང་ ཀུན་འཛིན་ གཉིས་ ཀྱི་ གཞི ། །"
msgstr ""
"It is the foundation for both complete expansion and that which holds "
"everything."

msgctxt "ff9eee1ad18c4091b696a5cfcc948225"
msgid "དེ་བཞིན་ ཡོན་ཏན་ ཚོགས་ རྣམས་ ཀུན་ གྱི་ ཡང་ ། །"
msgstr "Similarly, in the accumulation of all good qualities,"

msgctxt "db71022ab94a499e9d4dadeeab8b71bb"
msgid "རྒྱུ་ དང་ རྩ་བ་ འདུལ་བ་ ཡིན་ ཞེས་ གསུངས །"
msgstr "The vinaya is said to be the cause and root of this."

msgctxt "61553ad3b4114d40b0015a0d077cbd21"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "54c81c6ed9f1401d806b6879986162b7"
msgid "རྡོ་␣༽༽་␣བཅས་པ་ དང་ རང་བཞིན་ ཐ་དད་པ་␣ས་ སྡིག་ལྟུང་ ཡང་ཐ་ དད་ ཟེར་ རོ །"
msgstr ""
"Vajra: It is said that because the associated [wrong-doing] and the natural "
"[wrong-doing] are distinct, therefore the degrading acts and downfalls are "
"also distinct."

msgctxt "d326fd15583b40a3b70c7b2d2083912d"
msgid "འདི་␣ར་ ནི་"
msgstr "In this [system],"

msgctxt "008fab55f4404e88a816dd30957a8014"
msgid "སྡིག་ལྟུང་ ཐ་དད་ མེད་ ཅིང་ གཅིག་པ་ ཡིན་ ཏེ །"
msgstr ""
"The degrading acts and downfalls are not distinct but rather the same."

msgctxt "d6ed710e1fcf4a35b079285c5af8fb82"
msgid ""
"བཅས་ རང་ གཅིག་པ་ དང་ འགྲོ་བ་ སྤྱི་ ལ་ བཅས་པ་␣ར་ བཞེད་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"It is accepted that the associated and the natural are the same and "
"associated with migrators in general. "

msgctxt "8351f6ab9ce6446888244cec98603e6a"
msgid "སྡིག་ལྟུང་ གཉིས་ཀ་␣ས་ ངན་འགྲོ་␣ར་ འགྲོ་བ་␣ར་ མཚུངས་པ་␣འི་ ཕྱིར །"
msgstr ""
"In terms of producing bad migrations, both the degrading acts and downfalls "
"are similar."

msgctxt "f18d47ece77c4194879dcc5a6ca8ae48"
msgid "ལུང་ རྣམ་ འབྱེདལས །"
msgstr "According to the full analytical scripture:"

msgctxt "c602a7b5ce924a9daabaa7325ab508c2"
msgid "ལྟུང་བ་ ལྟུང་བ་ ཞེས་ བྱ་བ་"
msgstr "The downfalls are called a downfall."

msgctxt "c3badec887fb46908ff1a49d0da77dab"
msgid "སེམས་ཅན་ དམྱལ་བ་ དང་ དུད་འགྲོ་␣འི་ སྐྱེ་གནས་ དང་"
msgstr "The birthplaces of sentient beings, hell beings, animals and"

msgctxt "d7e2b1e5ea86492989efcd6b152a69f7"
msgid ""
"གཤིན་རྗེ་␣འི་ འཇིག་རྟེན་ དུ་ ལྟུང་བ་␣ར་ བྱེད་པ་␣འི་ དོན་ གྱིས་ ལྟུང་བ་␣འོ "
"། །"
msgstr ""
"They are downfalls because one falls into the world of the lord of the dead "
"due to these."

msgctxt "d4f7689a46594327b24fd51899fb0aa0"
msgid "ཞེས་པ་␣ས་ ཟན་ དང་ བཤོས་ ཀྱི་ མིང་ བཞིན་ ནོ །"
msgstr "Thus, this is like the name of grain meal and food."

msgctxt "f73d5e18db3748f2961b1bb91006f4a8"
msgid "ཁོ་ན་ ཕྲ་ རག་ ལ་␣འང་ ཁྱད་མེད་ དམ་ སྙམ་ ན །"
msgstr ""
"If one wonders whether there is no difference between exclusive, gross, and "
"subtle."

msgctxt "1d59b98c13a84ff2bd4dcdc6196ac917"
msgid "དེ་ ནི་ བཅས་ མ་ བཅས་ གཉིས་ཀ་␣འང་ ཉེས་པ་ ཆེ་ཆུང་ མཉམ་པ་ ཡིན་ ནོ ། །"
msgstr ""
"That is, the intensity of the fault is the same for associated and non-"
"connected [downfalls]. "

msgctxt "1e5e8b1353a74f06b551c30521bf3cac"
msgid "འོ་ན་ མི་ སྐྱེ་ མཚམས་མེད་ བྱས་པ་ སྐྱེ་བ་␣འི་ བར་ཆད་ དུ་ གསུངས་ ཤིང །"
msgstr ""
"Well then, it is said that the action of the non-arising of the [five] "
"immediates is an obstacle to the births."

msgctxt "4cc681b3d4e5426f8681e94a49094cba"
msgid "རབ་བྱུང་ ཕྱིར་བཅོས་ ཡོད་པ་␣ར་ སྙམ་ ན །"
msgstr "If one thinks that it can be altered by becoming a monk."

msgctxt "e16a8eb9599743b5826cda8e983db5a3"
msgid "དེ་␣འང་ ཡོད་ དེ་ མི་ སྐྱེས་ དགྲ་ བཟོད་པ་ ཐོབ་པ་ ལྟ་བུ་ ཡིན་ ནོ །"
msgstr ""
"That also exists because it is like the attainment of patience for non-"
"arising. "

msgctxt "2c7afe13be5a43d899e5ea5fdaa6833b"
msgid "སྡེ་␣༽༽  བཅས་པ་ རྐྱེན་ ལ་ ལྟོས་པ་␣ས་"
msgstr "Section: The associated [wrong-doing ] depends on conditions."

msgctxt "273774441c8a432391e09cd86037d7e4"
msgid "དང་པོ་ བཀག་པ་ ཕྱིས་ རྐྱེན་ ལ་ ལྟོས་ ཏེ་ གནང་ ན་ ཉེས་པ་ མེད་ ཟེར །"
msgstr ""
"The prohibition of the first is dependent on the later conditions, if it is "
"permitted, there is no fault."

msgctxt "5a7ecf3a8893427a9587032bfd9f5a6c"
msgid "འདི་␣ར་ ནི་ བཀག་པ་ ཡེ་ བཀག་ གནང་བ་ ཡེ་ གནང་ ཡིན་པ་ ནི་"
msgstr ""
"In this [system], the prohibition is primordial prohibition and the "
"permission is primordial permission."

msgctxt "500e1d58bf664040a5d94fc61506afb8"
msgid "སྤང་བླང་ དགེ་སྡིག་ གཉིས་ སུ་ ངེས་པ་ གང་ཞིག  །"
msgstr ""
"The abandonment and adoption are definite to two: virtue and non-virtue."

msgctxt "4b989f47ac3d48189641f18bc1a61b5a"
msgid "བདེ་སྡུག་ གཉིས་ འབྱུང་བ་␣འི་ ལ་␣ས་ ཡིན་པ་␣ས་"
msgstr "This is the karma that produces both well-being and suffering."

msgctxt "0ec67e12937c4cafa63cba32de455d31"
msgid "གནས་ དང་ གནས་མིན་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ ཀྱིས་ གཟིགས་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"The omniscient wisdom observes whether they are appropriate or "
"inappropriate."

msgctxt "abc069c1cbcc4d9daa131144be5627ae"
msgid "ཐུགས་ བརྩེ་ ཡང་འཇུག་ ལྡོག་ གི་ ཚུལ་ཁྲིམས་ འདི་ ལ་མ་ བརྟེན་ ན་"
msgstr ""
"If the compassionate mind is not dependent on the moral discipline of "
"engagement and disengagement."

msgctxt "7ff9ea24c15d46b58014be1b6c48f90d"
msgid "སྐྱོན་ སྤོང་ ཡོན་ཏན་ བསྒྲུབ་པ་␣འི་ ཐབས་ གཞན་ མེད་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"There is no other method of abandoning faults and accomplishing good "
"qualities."

msgctxt "c489a655b6084fc5942d968b068f9a12"
msgid "རང་བཞིན་ གཅིག་ ལ་ དགེ་ མི་དགེ་ གཉིས་"
msgstr "There are both virtues and non-virtues in a single nature."

msgctxt "a91d8675bbda454d8d7000b9b704292e"
msgid "གནང་བཀག་ གིས་ མི་འགྱུར་བ་␣ས་"
msgstr "It is not changed by permission and prohibition."

msgctxt "c49e12845a0f4c70bfa928d5018c1865"
msgid "སེམས་ ཉོན་མོངས་ ཅན་ ལས་མི་ དགེ་བ །"
msgstr "Non-virtues arise from an afflicted mind."

msgctxt "f4a7c5d7648d42b6b23ce21f601ebe0e"
msgid "འབྲས་བུ་ གནོད་པ་␣འི་ སྒོར་ གྱུར་པ་ ནི་ ཡེ་ བཀག་ དང་"
msgstr ""
"The result becoming the door to harm is the primordial prohibition and"

msgctxt "a9016896fd8041dfbc6a6e089f9a04d7"
msgid "དེ་ལས་ ལྡོག་པ་ ཡེ་ གནང་ ཡིན་པ་␣ས་ སོ ། །"
msgstr "The opposite of that is the primordial permission."

msgctxt "a0f91d57f11e4ec5bc4e9866a6444e78"
msgid "ནད་པ་␣ར་ སྨན །"
msgstr "A medicine for a sick person."

msgctxt "85ca73cb9fb84006849f836a097a9e81"
msgid "ཤཱ་རི་␣འི་ བུས་ དཔལ་ལྡན་ མོ་ལ་ ཆོས་ བསྟན་པ་ དང༌ །"
msgstr "Shariputra taught the Dharma to Palden Mo and."

msgctxt "d9109aebfad9401ba295c867fd664a68"
msgid "བུ་ མེད་ ཆུས་ ཁུར་བ་␣ར་ རོ་ ལེན་པ་ སོགས་ ནི་"
msgstr ""
"A woman who is being carried away by a river and taking corpses and so on is"

msgctxt "33ce0237fda04dadbbf674e46a0f6e61"
msgid "སྔར་ བཀག་པ་ དང་ ཕྱིས་ གནང་བ་ མི་དགེ་བ་ དང་ དགེ་བ་ ཐ་དད་ དོ །"
msgstr ""
"The non-virtues and virtues prohibited earlier and permitted later are "
"distinct."

msgctxt "eb11dfd8e4db4a3c8ec8933ec945046b"
msgid "ལྷན་␣༽༽  བཅས་ འགལ་ གྱི་ ལྟུང་བ་ མ་གཏོགས་"
msgstr "Addendum: Except for the faults of the associated contradiction,"

msgctxt "da29b5be4a0e473ab977c1f13044e9a7"
msgid "རྨི་ལམ་ དུ་ ཁུ་བ་ ཉམས་པ་ ལ་ཉེ་␣ས་པ་ མེད་ ཟེར་ ལ ། །"
msgstr ""
"It is said that there is no fault in experiencing seminal fluid in the "
"dream."

msgctxt "38ccc323cfba42299e13a8ff0559ad31"
msgid "འདི་␣ར་ ནི་ རྨི་ལམ་ དུ་ ནི་ ཉམས་ ཀྱང་"
msgstr "In this [system], experiences even occur in dreams."

msgctxt "f8adb2760393467dbdb3b1eab99d77b9"
msgid "ཕྲ་ རག་ གི་ ཁྱད་པར་ ལས་ཉེས་པ་ ནི་ འབྱུང་བ་"
msgstr "Aside from the difference in subtlety, there is a fault."

msgctxt "e8958a8d60a04af19113d737d4544bb4"
msgid "ཕྲ་ རག་ ཐམས་ཅད་ བསྟན་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "All of the subtleties are taught and "

msgctxt "2a351d76ff1149b5bc0832883258f7f9"
msgid "རྒྱུ་ ཀུན་གཞི་ ལ་ ཉོན་མོངས་པ་␣འི་ ས་ འོན་ གནས་པ་ དེ །"
msgstr ""

msgctxt "ed793eae81da4c3ab0e5c0b5ad38945b"
msgid "རྐྱེན་ རྨི་ལམ་ གྱི་ བུད་མེད་ ལ་ བརྟེན་ ནས་ ཉམས་པ་␣ས་"
msgstr "Because the condition of this experience is that of a dream woman."

msgctxt "e04cefa3231f4e13b5f909613cd8bdc5"
msgid "དངོས་ ཀྱི་ ཕམ་ ལྷག་ དང་ མཚུངས་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Thus, it is similar to the actual defeat."

msgctxt "b4f9905e42c9420098b2eef3754bcf96"
msgid "འོ་ན་ ཉེས་མེད་ དུ་ གསུངས་པ་ ཅི་ ཞེ་ན །"
msgstr "Well then, if [one] asks, \"Why is it said that there is no fault?\""

msgctxt "0960e1270db6456fb2636569156aebdf"
msgid "ཐབས་མཁས་པ་␣ས་ གནས་སྐབས་ སྒྲུབ་ མ་ནུ་␣ས་པ་ ལ་ གསུངས་ ཀྱི །"
msgstr ""
"It is stated in skillful means that it is temporarily unable to accomplish."

msgctxt "dc106e3146c647569432a7306a317515"
msgid "གཏན་ ནས་ ཉེས་མེད་ དུ་ གསུངས་པ་ ནི་ མིན་ ནོ ། །"
msgstr "But it does not say that there is no fault at all."

msgctxt "fd7f9be532e945ed92eded1600f1023e"
msgid "གལ་ཏེ་ ཉེས་མེད་ ཡིན་ ན་"
msgstr "If it is without fault. "

msgctxt "d869ff83b1814353942b2392e75e344f"
msgid ""
"ཉིན་ གཉིད་ དང་ སྲོད་ དང་ ཐོ་ རང་ ཉལ་བ་ བཀག་པ་␣འང་ ཉེས་མེད་ དུ་ཐལ་ ཏེ་ "
"མཚུངས་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"It absurdly follows that there would be no fault in prohibiting sleep during"
" the day, dusk, and dawn because it would be the same."

msgctxt "39c6e76553494d9384ee2b56c4c4276d"
msgid ""
"རྡོ་␣༽༽  བཅས་པ་ ནི་ རྗེས་ འབྲང་ གི་ སྲས་ དགེ་སློང་ དགེ་བསྙེན་ ཁོ་ན་ ལ་␣ས་ "
"འགྲོ་བ་"
msgstr ""
"Vajra: The associated [wrong-doing] is only in the followers; sons, fully "
"ordained monks, or lay vow holders."

msgctxt "cedf49d865f842d98a6c8ba2fc92b8df"
msgid "གཞན་ ལ་མ་ བཅས་པ་␣ར་ འདོད་ མོད །"
msgstr "It is accepted that the other migrators are not associated with it."

msgctxt "a23d939b67364a558fdcf647f8fda72a"
msgid "འདི་␣ར་ ནི་ བཅས་ རང་ གཅིག་པ་␣འི་ གནད་ ཀྱིས་ འགྲོ་བ་ སྤྱི་ ལ་ བཅས་ ཏེ །"
msgstr ""
"In this [system], because of the essence of being the associated and natural"
" [wrong-doing] as the same, they are associated with migrators in general."

msgctxt "7691d82e3bbf4ef6946a0bab0e5ecef0"
msgid "དང་པོ་ ཐུགས་བསྐྱེད་པ །"
msgstr "First, [the Buddha] generated the mind."

msgctxt "5781665824ad4411995b991bcde42cce"
msgid "བར་ དུ་ ཚོགས་ བསགས་པ །"
msgstr "In the middle, he gathered the accumulations."

msgctxt "4a2c1bddf8f04cb0a6f1d10aad9e0cad"
msgid "མཐ་␣ར་ སངས་རྒྱས་ ཏེ་"
msgstr "Finally, [he] became a buddha."

msgctxt "c1a19a14bde0459f81e17e84828f62fd"
msgid "ཆོས་ ཀྱི་ འཁོར་ལོ་ དང་ བཅས་པ་ རྗེས་ འབྲང་ ཁོ་ན་␣འི་ དོན་ མིན་པ་"
msgstr ""
"The wheel of the Dharma and others associated with it are not only for "
"followers."

msgctxt "c0fed62225da4dd39e24045141c7b36a"
msgid "མཐའ་ཡས་པ་␣འི་ སེམས་ཅན་ རྣམས་ ཀྱི་ དོན་ དུ་ ཡིན་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Because these are also for the sake of infinite sentient beings."

msgctxt "0dd8b9838d384644bf5bde3a280a1b71"
msgid "དེ་སྐད་ དུའང༌ །  རྒྱ་ རོལ་ ལ་␣ས །"
msgstr "It is also expressed in the Lalitavistara sutra as follows:"

msgctxt "9b9b8997a61f4546b2e9e11cc89e1ddb"
msgid "ཀུན་ ཏུ་ རྒྱུ་ ཉེར་ འཚོ་ ལ །"
msgstr ""

msgctxt "b70d68e344524083bc40ad99dd73852d"
msgid "ང་ ནི་ ཝ་ རཱ་ ཎ་ སཱིར །"
msgstr "I will go to Varanasi."

msgctxt "5513355bb20a49d6a2fa41f5316ca3b1"
msgid "འགྲོ་ གྲོང་ཁྱེར་ གསལ་ལྡན་ སོང་ ནས་ ནི །"
msgstr "To visit the city of Kasi,"

msgctxt "c9a6785bc60b4a87a163016e2c6db7bd"
msgid "ལོང་བ་ ལྟ་བུ་␣འི་ སེམས་ཅན་ ལ །"
msgstr "And to the sentient beings who are like blind,"

msgctxt "9f64c02d4f3c4891bc68730271df2778"
msgid "མཚུངས་ མ་ མེད་པ་␣འི་ འོད་ བྱ་␣འོ ། །"
msgstr "[I] will disseminate an unparalleled light to shine."

msgctxt "ddad29aba5aa4cd8b51d57312d9afc5b"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "2bd2a2fdd9814c71a782eaef0f29d351"
msgid "བརྩམས་པ་␣ར་ བྱ་ ཞིང་ དབྱུང་བ་␣ར་ བྱ །"
msgstr "[I] will compose and draw forth."

msgctxt "f404c7e4ac334a2a88ae769e56835fe3"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "a42f2065300d4e869d6e6f7317d9d413"
msgid "སྡིག་པ་ ཅི་ཡང་ མི་ བྱ་ ཞིང་ །"
msgstr "Do not engage in any negative action,"

msgctxt "1b8e980eb69d46b5b5073e9b409323ec"
msgid "སོགས་ སོ་␣༑ །"
msgstr "And so on."

msgctxt "74a683b7a6bb4fcabccb02f39554fa0f"
msgid "འོ་ན་ དགེ་སློང་ ལ་ དམིགས་ ཀྱིས་ བསལ་བ་ ཅི་ ཞེ་ན །"
msgstr ""
"Well then, if one asks: \"Why is there a special consideration for fully "
"ordained monks?\""

msgctxt "25f6dbe919734d1a8b53444e18623c62"
msgid "གཙོ་བོ་␣ར་ བསྟན་པ་ ཡིན་ ཏེ །"
msgstr "It is taught as the chief. "

msgctxt "e8694aaf376f4d84b84c350f8746147f"
msgid "འཁོར་ བསྒྱུར་ གྱིས་ འབངས་ ཐམས་ཅད་"
msgstr "The universal monarch to his people "

msgctxt "cb96c6a5e9ef48ea9d22a8e568e35d9e"
msgid "དགེ་ བཅུར་ བཀོད་པ་␣འི་ སྔོན་ དུ་"
msgstr "Before placing them to the ten virtues,"

msgctxt "7c7c5acbc6294fe69d9b604697b2405f"
msgid "རྒྱལ་སྲིད་ སྣ་བོ་ དག་ ལ་ བསྒོ་བ་ བཞིན་ ནོ ། །"
msgstr "Like giving orders to the leaders of the kingdom. "

msgctxt "3845296e4bd14fcbb8e377c571185048"
msgid "དེ་ལྟར་ ཡིན་ ན་"
msgstr "If it is like that."

msgctxt "b3eda79260fb44359ed0c7fda117ac3e"
msgid "དེ་བཞིན་ གཤེགས་པ་ དབང་ཕྱུག་ ལྟར་ བྱེད་པོ་ ཐལ་བ་ དང༌ །"
msgstr ""
"It absurdly follows that the Tathagata would be a creator like Ishvara. "

msgctxt "914ce8ed39f94c7d922456f88e5d89e2"
msgid "ཉེ་རིང་ ཅན་ དུ་ཐལ་ ལོ ། །"
msgstr "It absurdly follows that [he] would be partial."

msgctxt "db44aad5c09f41a6819a1c2dc7bcea20"
msgid "དེ་␣འི་ ཕྱིར་ ཆོས་ ཀྱི་ རྒྱལ་པོ་␣ས་ འགྲོ་བ་ སྤྱི་ ལ་ བཅས་པ་ ཡིན་ ནོ །"
msgstr "Therefore, the dharma king is associated with all beings in general."

msgctxt "b466c6b6553a48fc9b03bebf6589961b"
msgid "རྡོ་␣༽༽་␣བཅས་ རང་ ཐ་དད་ ལ་␣ས་"
msgstr ""
"Vajra: Apart from the associated and natural [wrong-doing] being distinct."

msgctxt "3d241e2c2f3d4ebb9d2756de552a93a9"
msgid "རབ་བྱུང་ གིས་ བསྲུང་ ན་ ཕན་ཡོན་ འབྱུང་ ལ་"
msgstr "Benefits occur when monks protect them."

msgctxt "4674ce5220594be8bbe6b5b8d3d26306"
msgid "གཞན་ གྱིས་ བསྲུངས་ ཀྱང་ ཕན་ཡོན་ མི་ འབྱུང་ ངོ་ ཞེས་པ་ དང༌ །"
msgstr ""
"And it is said that even if others protect them, no benefit will occur."

msgctxt "53e4638957074344bb72f62d00e6138f"
msgid "འདས་པ་␣འི་ ཉེས་དམིགས་ ཀྱང་ རབ་བྱུང་ ལ་ ཡིན་ གྱི་"
msgstr "The faults of going beyond apply to monks,"

msgctxt "d3d499bde447460f994f03b80a2f235a"
msgid "འགྲོ་བ་ གཞན་ ལ་ མི་ འབྱུང་ ངོ་ ཞེས་ སྨྲ་བ་␣ར་ བྱེད་ དོ །"
msgstr "But they will not occur to other migrators as [they] said."

msgctxt "70f7a09066b24bba93da94ca6fcaf5af"
msgid "འདི་␣ར་ ནི་ འགྲོ་བ་ གང་ གིས་ འདས་ ཀྱང་"
msgstr "In this [system], any migrator who goes beyond it."

msgctxt "3fee927366374e618019278073e54557"
msgid "ཉེས་པ་ དང་ བཅས་པ་␣ར་ འགྱུར་ ལ་"
msgstr "[They] will become associated with the faults."

msgctxt "0da2cac9f85f4263be03b332b43351f9"
msgid "དེ་ རྣམས་ ཀྱིས་ བསྲུང་བ་␣འི་ ཕན་ཡོན་ ཡང་ ནི་ ཀུན་ ལ་ འབྱུང་ སྟེ་"
msgstr "The benefits of their protection also occur to everyone."

msgctxt "4a87b9e3f6df45fd8e8f4cf6ca7c8646"
msgid "བཅས་ རང་ དང་ སྡིག་ལྟུང་ ཐ་དད་ མེད་པ་ དང་"
msgstr ""
"The associated as well as the natural [wrong-doing] and the degrading acts "
"as well as downfalls are not distinct."

msgctxt "7bcf319b65d94d8a9ea37261b47f6d22"
msgid ""
"འགྲོ་བ་ སྤྱི་ ལ་ བཅས་པ་ དང་ རྒྱུ་འབྲས་ ཀྱི་ རྟེན་འབྲེལ་ མི་ བསླུ་བ་␣འི་ "
"ཕྱིར་"
msgstr ""
"[They] are associated with migrators in general and the dependent relation "
"of cause and effect is undeceiving."

msgctxt "488d5f2fddf8479b82e02d1c08518379"
msgid "སྐྱོན་ཡོན་ འབྱུང་བ་ འཇིག་རྟེན་ གཞག་པ་ དང༌ །"
msgstr ""
"The occurrence of faults and good qualities are worldly established and"

msgctxt "8eba08cc38f84bca8f7d861712b97571"
msgid "དབྱེ་ ན་ གཞི་ ལ་␣ས །"
msgstr "The classification from the ground"

msgctxt "84367314076d4a3fa4c393c1004ca061"
msgid "བསྐལ་པ་ དང་པོ་␣འི་ མི་␣ས་ ས་ལུ་ སོགས་ འཇོག་ བྱས་པ་␣ས་"
msgstr "In the first eon, people stored rice and so on."

msgctxt "6c7cf8cbb3af4b719c2dfa93e97e7653"
msgid "ཕྱིས་ ཉེས་པ་ དུ་མ་ བསྐྱེད་པ་ དང་ །"
msgstr "Later, many faults arose and"

msgctxt "d4f19b1e42f24470970a7aa55eeec38e"
msgid "ཕྱི་རོལ་པ་␣འི་ དྲང་སྲོང་ ལྔ་ བརྒྱ་␣ས་"
msgstr "The five hundred non-buddhist rishis"

msgctxt "064e9d4d0ac5407da16caec9b7e7d3dc"
msgid "གཡང་གཞི་ སོགས་ ཡོ་བྱད་ ལྷག་པོ་ བཅངས་པ་␣ས་"
msgstr "By holding animal skin and other articles"

msgctxt "343c75a619734803a16debe18f9c7da6"
msgid "མངོན་ཤེས་ ཐོབ་པ་ ལ་ སྒྲིབ་པ་␣ར་ གསུངས་པ་ བཞིན་ ནོ ། །"
msgstr ""
"This is similar to the statement that it will obscure the attainment of the "
"higher perception."

msgctxt "d9420756135b45eda48779003de770fa"
msgid "ཕན་ཡོན་ ཡང་ ཀཱ་ ཤི་␣འི་ ནགས་ ཀྱི་ སེམས་ཅན་ ཆེན་པོ་ བཞི་␣ས་"
msgstr "The benefits are as the four great animals of the Kasi forest"

msgctxt "ce60def30bef44488acb5b1f27160a92"
msgid "གཏན་ཁྲིམས་ བསྲུངས་ ཤིང་"
msgstr "Protecting the firm discipline."

msgctxt "3b78498d7ea44f62855abc09ef256857"
msgid "གཞན་ ཡང་ བཀོད་པ་␣འི་ ཕན་ཡོན་ གྱིས་ ཚེ་ འཕོས་ ཚད་"
msgstr ""
"Besides, the benefits of being arranged include all of life's transferences."

msgctxt "52d4105e51b54258a1f86b436e3d46e5"
msgid "སུམ་ཅུ་རྩ་གསུམ་ དུ་ སྐྱེས་པ་␣ར་ གསུངས་ བཞིན་ ནོ ། །"
msgstr "[They] will be reborn in the [heaven] of the thirty-three as said."

msgctxt "4fa7b6e763714652a19507cd2bf02058"
msgid "དམིགས་བསལ་ མེད་པ་ ནི་ སྤྱི་ ལ་ བཅས་ ཀྱང་"
msgstr "Though there are no exceptions in general."

msgctxt "36e75515129840b18f8acde6df8c5195"
msgid "གཙོ་བོ་␣འི་ མིང་ ནས་ སྨྲོས་པ་ ལྟ་བུ་␣འོ ། །"
msgstr "It is like expressing from the main names. "

msgctxt "34fd81ecea484014acfa24e949ea91a1"
msgid "དེ་ལྟར་ མིན་ ན་ བདེ་གཤེགས་ ཉེ་ཞོ་␣འི་ ཕུང་པོ་␣ར་ འགྱུར་ རོ །"
msgstr "Sugata would become an imperfect aggregate if this were not the case."

msgctxt "76a56ecb19c6453eb81074fd8e8cc2ef"
msgid "རྡོ་␣༽༽་␣བཅས་ རང་ གཅིག་པ་␣ས་ དང༌ །"
msgstr "Vajra: The associated and natural [wrong-doings] are the same and "

msgctxt "64a365fb328d490a83f34e27f1d784af"
msgid "ཆོ་ག་ མེད་ ཀྱང་ སྲུང་བ་␣ས་ ཆོག་ སྙམ་པ་␣འམ །"
msgstr "Also thinking that protecting [the vows] without ritual is permitted."

msgctxt "22783064a58341409576d3776e5e2eeb"
msgid "རྟེན་ གྱི་ མདུན་ དུ་ རང་ གི་ དམ་བཅ་␣ས་པ་␣ས་"
msgstr "By promising your vows in front of a statue [of the Buddha] "

msgctxt "44904c37be3b48a99476807a732738f8"
msgid "ཐོབ་པ་␣ར་ འདོད་པ་␣འང་ བྱུང་ སྐད །"
msgstr "It is also accepted that the attainment has occured.  "

msgctxt "e52c0e97b78248949a25677c9c0babe1"
msgid "འདི་␣ར་ བསྟན་པ་␣ར་ འཇུག་པ་ ལ་ ཆོ་ག་ ལྷག་པར་ གལ་ཆེ་ སྟེ །"
msgstr ""
"In this [system], ritual is especially important for entering the teachings "
"because"

msgctxt "dd8259f433de4a5581f53b8dd468487b"
msgid "ཆོ་ག་ བསྟན་པ་␣འི་ དངོས་གཞི་ ཡིན་པ་␣ས་"
msgstr "Ritual is the main part of the teachings, "

msgctxt "e552887b9fb64818917354f4573bdad3"
msgid "དེ་ ཡོད་ ན་ བསྟན་པ་ གནས་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "If it is present, the teachings will remain and "

msgctxt "31370d6054294467a7b20506fa886a31"
msgid ""
"བསྙེན་བཀུར་ དང་ ཕྱག་རྟེན་ ཕུལ་བ་␣ས་ བསོད་ནམས་ ཀྱི་ ཚོགས་ རྫོགས་པ་␣འི་ ཕྱིར་ "
"དང༌ །"
msgstr ""
"By offering symbolic gifts and reverence, the accumulation of merit is "
"completed."

msgctxt "7443f170e45843a1968d37077aee78bc"
msgid "ལས་ཆོག་ ཕྱག་བཞེས་ ཀྱི་ རིམ་པ་ མཐོང་བ་␣ས་"
msgstr "By seeing the stages of the practical instruction that are permitted."

msgctxt "c7adbbe633ad41b8b8a4522c3c894567"
msgid "བྱ་བ་ དང་ བྱ་བ་ མ་ཡིན་པ་ ལ་ མཁས་པ་␣ར་ འགྱུར་བ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"This is because [one] will become an expert in distinguishing between what "
"to do and what not to do."

msgctxt "19feb8bd4c3746438065e1a6f16cb868"
msgid "མཁན་སློབ་ དགེ་འདུན་ རྣམས་ ཀྱི་ མདུན་ དུ་ བླངས་པ་␣ས་"
msgstr ""
"By taking [the vows] in front of the abbot, master, and the assembly of "
"monks."

msgctxt "54234401f6884a0e8b7390ba6f689da6"
msgid "ཁྲེལ་ཡོད་ ངོ་ཚ་ ཤེས་པ་␣འི་ ཕྱིར །"
msgstr "[One] will have a sense of shame and modesty."

msgctxt "e93bfd1c8215456d9aa73497f413fa43"
msgid "གསོལ་ གཞི་␣འི་ ལ་␣ས་ ཀྱི་ གང་ཟག་ ལ་ བརྟེན་ ནས་ ལེན་པ་ ཟབ་བོ ། །"
msgstr ""
"It is profound to take [the vows] in dependence upon  persons with the karma"
" of supplication."

msgctxt "3aaa167f8bd247b8beaf9ca250df1002"
msgid "དེ་སྐད་ དུའང་ ལུང་ ལ་␣ས །"
msgstr "In the scripture, it says:"

msgctxt "d1a9178286fe46a7a0f5720f8574fe58"
msgid "བཅོམ་ལྡན་ ཡོངས་སུ་ མྱ་ངན་ ལ་␣ས་ འདས་ ནས་"
msgstr "After the Blessed One has passed into the final nirvana."

msgctxt "99acc654b2f346c18b5d054f41f11d33"
msgid "སྟོན་པ་ གང་ ལ་ བགྱི་ ཞུས་པ་␣ས །"
msgstr "\"Who will be the teacher?\" [he] was asked."

msgctxt "b896c00e14484e6481388b82bceb7241"
msgid "སྟོན་པ་ སོ་སོ་␣ར་ ཐར་པ་ ལ་ གྱིས་ ཤིག  །"
msgstr "Make individual emancipation [your] teacher."

msgctxt "c542a65d781d453cb45911b6c30c4f4c"
msgid "ཅེས་པ་ དང་ །"
msgstr "And."

msgctxt "be9fe6d7c3864cb6ab7996ade81615d9"
msgid "ང་ ཡོངས་སུ་ མྱ་ངན་ ལ་␣ས་ འདས་ ནས་"
msgstr "After I have passed into the final nirvana."

msgctxt "7c1038e815b24e5da4160ed8ea72ac2f"
msgid "ཆོ་ག་ ཕུན་སུམ་ ཚོགས་པ་ བརྟེན་པ་␣ར་ བྱ་␣འོ ། །"
msgstr "[You] should rely on the perfect ritual ceremony."

msgctxt "99bd5a189f744dbc920ceeef518a1253"
msgid "ཞེས་ དང༌ །"
msgstr "And"

msgctxt "bf94e90457db4a8a86a35e32c27378f0"
msgid "ང་ ནི་ མྱ་ངན་ འདས་ གྱུར་ ན །"
msgstr "After I have passed into nirvana."

msgctxt "cd8ba587261b4411a6e08281410fcc44"
msgid "འདི་ ནི་ ཁྱེད་ ཀྱི་ སྟོན་པ་␣འོ །"
msgstr "This will be your teacher."

msgctxt "d3d4e6442f784e66bfa0b73210f6196b"
msgid "ཞེས་ སོགས་ སོ །"
msgstr "And so on."

msgctxt "1309aa872d0b43dbba2c54f8ea3e76fe"
msgid ""
"རྡོ་␣༽༽  དུག་ གསུམ་ ལ་␣ས་ འདོད་ཆགས་ དང་ ལྷག་པར་ ཞེ་སྡང་ ཉེས་པ་ ཆེ་བ་␣ར་ "
"གསུངས་ མོད །"
msgstr ""
"Vajra: It is said that among the three poisons, attachment and aversion are "
"the greater faults."

msgctxt "5d9f04cf3d7c4626b44a752c4a55ec5e"
msgid "འདི་␣ར་ ནི་ མི་ ཤེས་པ་ གཏི་མུག་ དེ་ ཉེས་པ་ གཞན་ ལ་␣ས་ ལྕི་ སྟེ །"
msgstr "In this system, unknowing ignorance is heavier than all other faults."

msgctxt "101cedab8d7e45229c7ca5faab660afc"
msgid "རྣམ་འགྲེལ་ ལ་␣ས །"
msgstr "According to the Full Commentary to [the Compendium of Pramana]:"

msgctxt "817b292f799e4449b15578f80b8dd6f1"
msgid "བདག་ ཡོད་ ན་ ནི་ གཞན་ དུ་ ཤེས །"
msgstr "When there is self, there is also a sense of other."

msgctxt "1d7c4901849440aebeb0a1850025c176"
msgid "བདག་གཞན་ ཆ་ ལ་␣ས་ འཇིག་ དང་ སྡང༌ །"
msgstr "From the aspects of self and other, come grasping and aversion."

msgctxt "99e6cee6b95047c485db696c30661f9b"
msgid "དེ་ གཉིས་ དག་ དང་ ཡོད་ འབྲེལ་ ལ་␣ས ། །"
msgstr "Being completely entangled in these,"

msgctxt "35110bfabcb34f789bfe7c9a74464ead"
msgid "ཉེས་པ་ ཐམས་ཅད་ འབྱུང་བ་ ཡིན །"
msgstr "All faults would occur."

msgctxt "1cee52a6f66946e49a88ced35b9b0253"
msgid "ཅེས་ དང་ །"
msgstr "And"

msgctxt "987c7e5b7f384f88b2136804efeb2f8d"
msgid "སྡུད་པ་ ལ་␣ས །"
msgstr "According to the Condensed [Prajnaparamita In Verse]:"

msgctxt "e8b582e8d4814b1aaaedc7ec1ef20c5a"
msgid "སེམས་ཅན་ ཐ་མ་ འབྲིང་ དང་ མཆོག་གྱུར་ ཇི་སྙེད་པ ། །"
msgstr "All sentient beings, whether inferior, intermediate, or superior."

msgctxt "ac609cdc60b64370828f886441543f51"
msgid "དེ་ ཀུན་ མ་རིག་ སོགས་ དང༌ །"
msgstr "All of this [occurs from] ignorance and so on."

msgctxt "3ec6d4e57cf94909ba6c6d65bd3e8f81"
msgid "ཉེ་བར་ འཁོར་ གྱིས་ ཞུས་པ་ ལ་␣ས །"
msgstr "From Upali's questions to [the Buddha]:"

msgctxt "59956e2430694731a66ca7841341122f"
msgid "འདོད་ཆགས་ ནི་ ཉེས་པ་ ཆུང་ ལ་ འབྲལ་ དཀའ །"
msgstr "Attachment is a lesser fault and it is difficult to remove."

msgctxt "3f65959df6da4f0cac04dfd16d4db015"
msgid "ཞེ་སྡང་ ནི་ ཉེས་པ་ ཆེ་ ལ་ འབྲལ་ དཀའ །"
msgstr "Aversion is a greater fault and it is difficult to remove."

msgctxt "344a605d3c3c45edadc4aac40a00286a"
msgid "གཏི་མུག་ ནི་ ཉེས་པ་ ཡང་ ཆེ་ ལ་ འབྲལ་ ཡང་ དཀའ །"
msgstr "Delusion is a greater fault as well as difficult to remove."

msgctxt "877eada7bb2d4c108c32fb582310479f"
msgid "ཞེས་ གསུངས་པ་␣ས་"
msgstr "As said."

msgctxt "fa52c2491ae74d1ba8a065ae29571b7f"
msgid "འདི་ ཡོད་ ན་ བདག་མེད་ ཀྱི་ དོན་ མི་ རྟོགས་པ་␣ས་"
msgstr "If this exists, the meaning of selflessness will not be realized."

msgctxt "15b3614365d34d909900e7af5c96120d"
msgid "དེ་ མ་ རྟོགས་ ན་ རྒྱུ་འབྲས་ ཀྱི་ རྟེན་འབྲེལ་ སྤང་བླང་ མི་ ཤེས་ ཤིང་"
msgstr ""
"Without this realization, one will not know what to abandon and adopt in the"
" interdependence of cause and effect."

msgctxt "bfe5e77fa9124c94a31c27ec6c2dfae5"
msgid "འབྲས་བུ་ ངན་སོང་ ལས་མི་ འདའ་བ་␣འི་ ཕྱིར་ རོ །"
msgstr "Therefore, one will not go beyond the result of the bad migrations."

msgctxt "e5cb26a13c704ee9bbbb53571563577f"
msgid ""
"རྡོ་␣༽༽  ངན་འགྲོ་␣འི་ གནས་ དམྱལ་བ་ དམན་པ་ དུད་འགྲོ་ མཐོ་བ་␣ར་ འདོད་ མོད་ ཀྱི"
" །"
msgstr ""
"Vajra: The hell [realm] is accepted as lower and the animal [realm] as "
"higher in the realms of bad migrations. "

msgctxt "aa42771d16b84f1ab9ec2f249801edb8"
msgid "འདི་␣ར་ ནི་ དུད་འགྲོ་ ཆོས་ཅན་"
msgstr "In this [sysem], take the subject animal."

msgctxt "ac7dafc242084da69b5664a84a75487d"
msgid "ཁྱོད་ གཏི་མུག་ ཆེ་བ་␣འི་ ཕྱིར་"
msgstr "Because it has a great delusion."

msgctxt "a67b6f0f7669410a931e8cd3b1758f9f"
msgid "ཁྱོད་ ཀུན་ ལ་␣ས་ དམན་པ་ ཡིན་པ་␣ར་ ཐལ་ ལོ །"
msgstr "It follows that it is the lowest of all."

msgctxt "9a7250a5aa2b4346abee4b4a11a1eaa6"
msgid "དེ་␣འི་ དོན་ ནི་"
msgstr "The meaning of this is that"

msgctxt "4a3f544a240a49f9a60789a9a386e9a6"
msgid "དམྱལ་བ་ དང་ ཡི་དྭགས་ སུ་ གནས་སྐབས་ སྡུག་བསྔལ་ ཆེ་ ཡང་"
msgstr ""
"Suffering is temporarily greater in the hell and hungry ghost [realms]."

msgctxt "cf5ade120cd149e9afb9bd7a1609b4d4"
msgid "ཡུན་ཐུང་ བས་ མཐོ་རིས་ སུ་ སྐྱེ་བ་ མང་ དུ་ གསུངས་ ཏེ །"
msgstr ""
"It is said that because of the short duration, many [beings] are born in the"
" higher realms."

msgctxt "e2fde8b9b4c14a33906c163ec21e911f"
msgid "གང་ ལ་ སྐྱེས །  རྒྱུ་ གང་ གིས་ སྐྱེས །  ཇི་ལྟར་ སྐྱེས་པ་ ཤེས་པ་␣ས་"
msgstr ""
"Knowing where [they] will be born, what causes will cause [their] birth, and"
" how [they] will be born."

msgctxt "c57e589ab3354c1493fd98a99baaa9e7"
msgid "དགེ་བ་␣འི་ བསམ་པ་ སྐྱེས་ ཏེ་"
msgstr "Because [they] will be born with virtuous thoughts."

msgctxt "6c1bb204dd0d4069a9e9236822a77563"
msgid "ཚེ་ འཕོས་པ་ མང་ དུ་ འབྱུང་བ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "There are many [beings] who have died. "

msgctxt "2d5643cc0784457e90498f7aec6fb558"
msgid "དུད་འགྲོ་ ནི་ རྨོངས་ ཤིང་ བླུན་པ་ གཏི་མུག་པ་␣ས་"
msgstr "Because the animals are ignorant, foolish, and deluded. "

msgctxt "dc20cb3482054fd59d5f115c1aa5984b"
msgid "དེ་ འདྲ་ གང་ཡང་ མི་ འབྱུང་ ཞིང་"
msgstr "None of this would occur."

msgctxt "f49e593eae5b47b8af9404f38af5b5e4"
msgid ""
"སྡུག་བསྔལ་ ལ་ སྔ་མ་ མ་ དག་པ་␣ར་ ཕྱི་མ་␣འི་ རྒྱུ་ ཉིན་ རེ་ བཞིན་ སྲོག་ ཆག་ "
"མང་པོ་ ཟ་␣ར་ འགྲོ་བ་␣ས་"
msgstr ""
"Being unable to purify earlier causes of suffering is the cause of future "
"suffering, which takes many lives every day."

msgctxt "c2f21bf2c0334f408d50a6e2628d9482"
msgid "ཐར་ དུས་ ཀྱང་ ཤིན་ཏུ་ རིང་བ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Because the period of emancipation is very long."

msgctxt "5cc46a22fd224501a21b210ab8e4c0ff"
msgid "དེ་སྐད་ དུའང༌ །"
msgstr "As it is also said:"

msgctxt "641de1b10eda48babb94660beb41111b"
msgid "དྲན་པ་ ཉེར་ བཞག་ ལ་␣ས །"
msgstr "According to the Application of Mindfulness:"

msgctxt "b006b016aa6346d6ac0efcac7f8c38a9"
msgid "སེམས་ཅན་ དམྱལ་བ་␣ར་ སྐྱེས་པ་ ནི་ སླ་ ཡི་ ༑"
msgstr "It is easy for sentient beings to be born in the hell realm. "

msgctxt "ed161c0655ac4c78bf67a7ba833311e0"
msgid "དུད་འགྲོ་␣འི་ སྐྱེ་གནས་ སུ་ སྐྱེས་པ་ ནི་ དེ་ལྟར་ མ་ ཡིན་ ནོ ། །"
msgstr ""
"However, this is not the case for being born in the birthplace of the "
"animal."

msgctxt "8a5218ab2b1c4ac9932fa03e52d9feda"
msgid "ཞེས་ གསུངས་པ་ ཡིན་ ནོ ། །"
msgstr "Thus, it is said."

msgctxt "c43bdd205f524ab687ef977fc3b4b40b"
msgid ""
"རྡོ་␣༽༽  བསླབ་པ་ བླང་པ་␣ས་ ཉེས་པ་ སྤྱད་པ་ ནི་ ལྕི་ ལ་ ཐོག་མ་ ནས་ མ་ ཐོབ་པ་ "
"ལ་ཉེ་␣ས་པ་ མེད་པ་␣ར་ འདོད་ མོད །"
msgstr ""
"Vajra: It is accepted that the fault is heavy for one who commits a wrong "
"action and has taken the course of training; yet, there is no fault if one "
"has never taken the course of training from the beginning."

msgctxt "fd76b136e7a243da9123b43aab92e2e9"
msgid "འདི་␣ར་ ནི་ ཉམས་པ་ ལས༌མ་ ཐོབ་པ་ ཉེས་པ་ ཆེ་བ་␣ར་ བཞེད་ དེ་"
msgstr ""
"In this [system], it is accepted that besides degeneration, there is a "
"greater fault for the one that has never been taken [the course of "
"training]."

msgctxt "0650e124ebe642b493b283298ada4642"
msgid "འཁོར་བ་␣འི་ གཉེན་པོ་ དགག་སྒྲུབ་ ཀྱི་ ཚུལ་ཁྲིམས་ ཡིན །"
msgstr "The discipline of negation and assertion is the antidote to samsara."

msgctxt "618d569e788f4842a4e9f90ddf4495e6"
msgid "དེ་ སྤྱད་ དཀའ་བ་␣འི་ གནད་ ཀྱིས་"
msgstr "Because of the difficulty of engaging in this,"

msgctxt "98018b21a6f543288464f6b716902dc7"
msgid "ལན་ གཅིག་ ཉམས་ ཤིང༌་␣སྡུག་བསྔལ་ ཉམས་ སུ་ མྱོང་ ཡང་"
msgstr "Even if degenerated once and experienced suffering"

msgctxt "399caa9e713e4311864d528308ba13a9"
msgid "ཐོག་མ་␣ར་ བསྲུང་ སེམས་ ངེས་འབྱུང་ གིས་ མཚམས་ སྦྱར་ ཏེ་"
msgstr ""
"First, connect through the attitude of protecting and definite emergence."

msgctxt "da160d69b5fc451bb352dc2f72c71420"
msgid "མཆོག་ གསུམ་ དང་ འབྲེལ་བ་␣འི་ ཕྱིར་"
msgstr "Therefore, connected to the three jewels. "

msgctxt "ad51752c2f2143d98d7fb2a78e3aa8cb"
msgid "སྤོང་ སེམས་ དགེ་བ་␣འི་ འབྲས་བུ་ ནི་ འབྱུང་ སྟེ །"
msgstr "The virtuous results occur from the mind of abandonment."

msgctxt "155df452d06944f985d49dec39d83502"
msgid "འཇམ་དཔལ་ གནས་པ་␣འི་ མདོ་ ལ་␣ས །"
msgstr "The Dwelling Place of Manjushri sutra says:"

msgctxt "45032376d1e942309e0ec22467bcad88"
msgid ""
"འཇམ་དཔལ་ གྱིས་ ཤཱ་རི་␣འི་ བུ་ ཁྱོད་ བསམ་གཏན་ གང་ བྱེད་ སོགས་ དྲིས་པ་␣ས་"
msgstr "Manjushri asked Shariputra, what meditative absorption do you do?"

msgctxt "d2b2703de9474a4bbf9265cac857baad"
msgid ""
"དགེ་སློང་ རྒྱ་ ཆེན་ ཆེ་␣ར་ འཁྲུགས་ ནས་ ལུས་ དེ་ཉིད་ དུ་ དམྱལ་བ་␣ར་ ལྟུང་ །"
msgstr ""
"The bhikshus were greatly ferrous and fell into hell in that very body."

msgctxt "4d0bc39307b84a4f9f941d2e9d9460b6"
msgid "ཤཱ་རི་␣འི་ བུས་ དགེ་སློང་ དེ་དག་ ཆུད་ བཟན་ ཏོ་ ཞེས་ སྨྲས་པ་␣ས །"
msgstr "Shariputra said, \"Those bhikshus have been wasted.\""

msgctxt "6bb5f970acc147e7bb96b1c62d26df30"
msgid "སངས་རྒྱས་ ཀྱིས་ ཁྱོད་ དེ་སྐད་ མ་ ཟེར །"
msgstr "The Buddha said, \"You do not say that.\""

msgctxt "6ee8cb342a7141b1bf06b9920174fc09"
msgid ""
"དེ་དག་ དམྱལ་བ་␣ར་ ཐང་ ཅིག་ རེག་ ནས་ དགའ་ལྡན་ དུ་ སྐྱེ་བ་␣ར་ འགྱུར་ རོ ། །"
msgstr ""
"They will touch the hell for a moment and will be reborn in the Tushita "
"heaven."

msgctxt "24f810ccd4134afdabee24ac275164f5"
msgid "ཞེས་ དང་ །"
msgstr "And."

msgctxt "b90200bc8571452490ea63fccd7e3474"
msgid "རེ་ཞིག་ མི་དགེ་བ་ ལ་ ཞུགས་ ཀྱང་ འགྱོད་པ་ ལྡོག་པ་␣ར་ འགྱུར་ ཏེ །"
msgstr ""
"Even temporarily engaging in non-virtue, one's regret will be reversed."

msgctxt "251644c2607a4164a72efb243a6b58e6"
msgid "བཤེས་ སྤྲིང་ ལ་␣ས །"
msgstr " According to A Letter to a Friend:"

msgctxt "3fd771c991814750abbbfbf01bb74d31"
msgid "གང་ཞིག་ སྔོན་ཆད་␣×"
msgstr "Those who were heedless in the past."

msgctxt "824d9454a67a42159381f9efaf368ad4"
msgid "ཕྱིས་ ནས་  ཟླ་བ་ སྤྲིན་␣×"
msgstr ""
"Later, they will become heedful. It is beautiful like the moon free from "
"clouds."

msgctxt "fdefc83b2d9943978417c43a73dc6fb3"
msgid "དགའ་བོ་ སོ་␣ར་ འཕྲེང་ ྾  ཅེས་ དང༌ །"
msgstr "Like Nanda, Angulimala, Darsaka and Sankara. And"

msgctxt "a461a49ca5cc474caa1d81a1c6e54edd"
msgid "ཡང༌་␣དབྱིག་གཉེན་ གྱིས་ མི་ ཤེས་ སྡིག་པ་ བྱས་པ་ ཤིན་ཏུ་ ལྕི །"
msgstr ""
"Furthermore, Vasubandhu stated that negative actions committed unknowingly "
"are immensely heavy."

msgctxt "02391aa63b5146d092a26544c149d6b0"
msgid "སོགས་ དང༌ །"
msgstr "And so forth."

msgctxt "e8ed4d74ef024c91bec2f3b622ddfd50"
msgid "འདུལ་བ་ ལ་␣ས །"
msgstr "According to the Vinaya:"

msgctxt "0748db0c4c3243a8aa72b3ec6f588f1d"
msgid "ལེགས་ སྐར་ གྱིས་ ལ་བ་ ནག་པོ་ གྱོན་ ནས་ ང་ ནི་ བ་ཀུ་ལ་␣འོ །"
msgstr "Sunaksatra dressed in black woolen clothes and said, I am Bakula."

msgctxt "86fb1864459e4d50b13b416a20aee113"
msgid ""
"ཞེས་ སངས་རྒྱས་ ལ་ བསྡིག་པ་␣ས་ བརྒྱ་བྱིན་ གྱིས་ འདི་འདྲ་␣འང་ འདུལ་བ་␣ར་ "
"ངེས་པར་ འབྱུང་ ངམ་ ཞུས་པ་␣ས །"
msgstr ""
"And threatened the Buddha. Indra asked, \"Will you be able to subdue even "
"this one certainly?\""

msgctxt "89808dafef424d65a3beeec4fe39001d"
msgid "ནམ་ཞིག་ ན་ དུས་ ཡོད་ གསུངས་པ་ སོགས་ ཀྱི་ ལེགས་པ་␣ར་ གྲུབ་བོ ། །"
msgstr ""
"It is perfectly established by the statement 'there will be a time' and so "
"forth."

msgctxt "1ab59593b9ad49308ac22f8301651114"
msgid ""
"སོ་ཐར་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ་␣འི་ གསུངས་ ཚིག་ ཉི་ཤུ་པ་ ལྷན་ཐབས་ ཚིག་ "
"གསུམ་པ་␣འི་ འགྲེལ་བཤད་ ཀྱི་ སྐབས་ ཏེ་ གསུམ་པ་␣འོ ། །"
msgstr ""
"This concludes the third section, a commentary on the twenty vajra verses "
"and the three verses of addendums, summarizing the essential points of "
"individual emancipation."

msgctxt "6eddbc6188034cb79947ef72fa610937"
msgid "རྡོ་␣༽༽  གཞན་ བཤེས་གཉེན་ ལ་ལ་␣ས་"
msgstr "Vajra: Other spiritual friends say:"

msgctxt "532a9c1ace4746fcb836ac7960c35883"
msgid "ཐེག་པ་ ཆེན་པོ་ ནི་ སྙིང་རྗེ་␣ས་ ཁྱད་པར་ དུ་ བྱས་པ་␣འི་"
msgstr "The Greater Vehicle is distinguished by compassion"

msgctxt "49b80d72b42544eabd871500687e2171"
msgid "སྙིང་རྗེ་ བྱང་ཆུབ་ ཀྱི་ སེམས་ ཡིན་ ཟེར་བ་ མང་ ངོ༌ ། །"
msgstr "Which is bodhicitta."

msgctxt "0d9da5299dce4b0989b5575b90e0fefb"
msgid "འདི་␣ར་ ནི་ བྱང་ཆུབ་ ཀྱི་ སེམས་ དང་ སྙིང་རྗེ་ གཉིས་ ཐ་དད་ ཡིན་ ཏེ་"
msgstr "In this [system], bodhicitta and compassion are distinct."

msgctxt "86f29e8a1934418ca39608247c97bb1e"
msgid ""
"སྙིང་རྗེ་ ནི་ ཁྲ་ དང་ སྤྱང་ཀི་ ཕྱི་རོལ་ མུ་སྟེགས་པ་ ནང་པ་␣འི་ ཉན་རང་ ལ་␣འང་ "
"ཡོད་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"Because compassion can be present in hawks, wolves, non-Buddhist tirthikas, "
"as well as Buddhist shravakas and pratyekabuddhas."

msgctxt "bf798776e8c1471f873d86791b9c9823"
msgid ""
"བྱང་སེམས་ ནི་ དེ་ལྟ་␣འི་ རྐྱེན་ དང་ རྒྱུ་ གཅིག་ གི་ མིན་པ་ དཔག་མེད་ གྱིས་ ཏེ"
" །"
msgstr ""
"Bodhicitta is not caused by any single present cause and condition but by "
"unfathomable [causes and conditions]."

msgctxt "e40ee9f3346e4678a3904379ad80fdf8"
msgid "དཀོན་མཆོག་  སྤྲིན་ ལ་␣ས །"
msgstr "According to the Cloud of Jewels Sutra:"

msgctxt "17f8b85e2f744f6d8083a3dc03151e2e"
msgid "རྒྱལ་ དང་ རྒྱལ་བ་␣འི་ ཆོས་ ལ་ དད་ གྱུར་ ཅིང་ །"
msgstr "Have faith in the conqueror and his teachings."

msgctxt "bc3f6c0d21bf454b9f42c4dd80ab38fb"
msgid "ཞེས་ སོགས་ སོ །"
msgstr "And so on."

msgctxt "ae57d25922b0431ca79893ce921c577a"
msgid "རྒྱུ་འབྲས་ ཀྱི་ ངོས་ ནས་ ཀྱང་ མི་ གཅིག་ སྟེ་"
msgstr "In terms of cause and effect, they are also not the same."

msgctxt "faa0856eee1b42908a478e0b25bcc6c7"
msgid "སྙིང་རྗེ་ སོགས་ ཀྱིས་ བསྐྱེད་པ་␣འི་ འབྲས་བུ་ མིན་པ་␣འི་ ཕྱིར །"
msgstr "It is not a result produced by compassion and so forth."

msgctxt "4a520e16054d42f0abb30130127d2119"
msgid "བྱེད་ལས་ ཀྱང་ མི་ གཅིག་ སྟེ་ སངས་རྒྱས་ ཐོབ་པ་␣ར་ བྱེད་པ་␣འི་ ཕྱིར །"
msgstr ""
"They are also not the same in terms of function, [it] acts as the attainment"
" of buddhahood."

msgctxt "4920bff090c14169a6475756aaa701b3"
msgid ""
"དམིགས་ཡུལ་ ཀྱང་ མི་ གཅིག་ སྟེ་ འཁོར་འདས་ གཉིས་ཀ་␣ར་ དམིགས་པ་␣འི་ ཕྱིར་ རོ "
"། །"
msgstr ""
"The object of observation is also not the same because it observes both "
"samsara and nirvana."

msgctxt "78b3ba067bbb41039962fe892d806dd0"
msgid ""
"དེས་ན་ སྙིང་རྗེ་ དང་ སྙིང་རྗེ་ ཆེན་པོ་␣འི་ ཁྱད་པར་ མ་ ཕྱེས་པ་ གྱི་ ན་␣ར་ "
"སྨྲས་པ་␣ར་ ཟད་ དོ །"
msgstr ""
"Thus, it is said without distinguishing between compassion and great "
"compassion."

msgctxt "86512d8cbfdb41468bf04b3bb3d96437"
msgid "རྡོ་␣༽༽  བྱང་སྡོམ་ ལ་ རྟེན་ སོ་ཐར་ མི་ དགོས་ ཏེ་"
msgstr ""
"Vajra: The bodhisattva vows do not require the support of pratimoksha."

msgctxt "ee4ba6cab1b84b8293bf44f9a0fbf263"
msgid "སོ་ཐར་ ནི་ གླིང་ གསུམ་ གྱི་ སྐྱེས་པ་ བུད་མེད་ ལ་␣ས་ གཞན་ ལ་ མི་ སྐྱེ་"
msgstr ""
"The pratimoksha [vows] can only arise in men and women of the three "
"continents."

msgctxt "7da60d2d158948ef98e0249a9929875e"
msgid "བྱང་སེམས་ ཀུན་ ལ་ སྐྱེ་བ་␣ར་ གསུངས་པ་␣འོ་ ཟེར །"
msgstr "It is said that bodhicitta arises in all."

msgctxt "cd1f79fb41674583860630218dcbb04e"
msgid ""
"འདི་␣ར་ ནི་ བྱང་ཆུབ་ སེམས་དཔ་␣འི་ སྡོམ་པ་ ལ་སོ་ ཐར་ གྱི་ རྟེན་ ཅན་ ཐོབ་པ་␣ར་"
" བཞེད་ དེ །"
msgstr ""
"In this [system], the bodhisattva vows can be attained by those with the "
"support of pratimoksha [vows]."

msgctxt "3b2242b02bb047399a22461290ba93e1"
msgid "བྱང་སྡོམ་ མ་ སྐྱེས་པ་ སྐྱེ་བ །"
msgstr "The bodhisattva vows to arise in those who have not arisen."

msgctxt "3d1b05a6f66d48cfb75277f4731a9df9"
msgid "སྐྱེས་པ་ གནས་པ །"
msgstr "To abide in [those who] have arisen."

msgctxt "ba6ae138200044fabf0ad152250f16c5"
msgid "གནས་པ་ གོང་ ནས་ གོང་ དུ་ བོག་ འདོན་པ་ སྟེ་"
msgstr "It is imparted and increased further and further by abiding."

msgctxt "a53f7d41228d453a9cf45784856d6823"
msgid "མཐར་ཐུག་པ་␣ར་ བྱེད་པ་␣འི་ རྟེན་ ཡིན་པ་␣འི་ ཕྱིར་"
msgstr "Because this is the support to attain the final."

msgctxt "79098e2ab157421686f391caf61b6b19"
msgid "མཁར་ གྱི་ རྨང་རྡོ་ བཞིན་ ནོ ། །"
msgstr "It is like the foundation of a castle."

msgctxt "cd6ae2cd339944d4bba4cff0bc60fb11"
msgid "དེ་སྐད་་  དུའང་ ཇོ་བོ་ རྗེས །"
msgstr "As it is also said by Jowo Je:"

msgctxt "4e183804eb764552bb4df08eca254e93"
msgid "སོ་སོ་␣ར་ ཐར་པ་ རིས་ བདུན་ གྱི ། །"
msgstr "The seven sections of the pratimoksha."

msgctxt "2730f9e336464c29bed21f0a3ead528b"
msgid "རྟག་ ཏུ་ སོགས་ དང༌ །"
msgstr "[Those who] always [possess the other vows] and so forth. "

msgctxt "3c1f87e511df49579ac6d2e45a633ded"
msgid "ཇི་ལྟར་ འདི་ ན་ ཤིང་རྩ་ གཙོ་བོ་ སྟེ །"
msgstr "Just as the main [part] of a tree is its roots,"

msgctxt "682cf4d8aec745fdaffe7ed8be4e4368"
msgid "རྣམ་པ་␣ར་ འཕེལ་ ྾"
msgstr "Thoroughly expanded x x"

msgctxt "9ff2bf42d5b943778e86bf79c63040ca"
msgid "དེ་བཞིན་ དམ་ཆོས་␣×"
msgstr "Likewise the holy Dharma x x"

msgctxt "d06e39c999c248e6abd5d2331fb3b370"
msgid "གཞི་ དང་ རྩ་བ་␣✖"
msgstr "Basis and root X X"

msgctxt "dbe40d2af3b54a118eb5fdf7a51bcf0a"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "338b6584b53441aea0312a36ba27fdca"
msgid "གལ་ཏེ་ སོ་ཐར་ གྱི་ རྟེན་ མི་ དགོས་ ན་"
msgstr "If the support of pratimoksha is not required."

msgctxt "9f0dda73eaa142a8a4068b60238be5c6"
msgid "སྔགས་ ལ་␣འང་ དེ་ མི་ དགོས་པ་␣ར་ ཐལ །"
msgstr "It follows that it is not required in the mantra as well."

msgctxt "e9bf75c2a180494fbc67b7ca809b8fb3"
msgid "ཐེག་ཆེན་ རྒྱུ་འབྲས་ གཉིས་ ལ་␣ས་ རྒྱུ་ལ་ མི་ དགོས་ ན་"
msgstr ""
"From the two, the cause and result of the Greater Vehicle, if the cause does"
" not require it."

msgctxt "b66f5ab4ad734f328ea67c2d40147e2f"
msgid "འབྲས་བུ་␣ར་ དགོས་པ་␣ར་ མི་ སྲིད་པ་␣འི་ ཕྱིར །"
msgstr "Then, its requirement in the result is impossible."

msgctxt "75841aafa31543bc813d134c1abd913c"
msgid "མདོ་ རྒྱུད་ ལ་␣ས །"
msgstr "According to the sutra and tantra:"

msgctxt "add32a82b37b40fb994fbe5159c9faa7"
msgid "སོ་ཐར་ བྱང་ཆུང་ སེམས་ ཞེས་ དང་ །"
msgstr "[The vows of] pratimoksha and bodhisattva,"

msgctxt "9f5d165947e54f04bd43e32f846343cf"
msgid "ཚུལ་ཁྲིམས་ ཀྱི་ ནི་ བསླབ་པ་ དང་ །"
msgstr "[They] are the training in moral discipline and "

msgctxt "7ac44331e1534fd69f8c587a87bd3faf"
msgid "ཞེས་ སོགས་ ཀྱིས་ བསལ་ ལོ །"
msgstr "This and others eliminate it."

msgctxt "958b6a576e934f088fc1c55e4cc3d9c6"
msgid "བྱང་སེམས་ བཞིན་ སོ་ཐར་ ཅི་རིགས་ སུ་ སྐྱེ་␣འམ་ སྙམ་ ན །"
msgstr ""
"If one wonders that the pratimoksha can arise in any being like the "
"bodhisattva."

msgctxt "eb374ba5dc5f4ceea9c4b15d7c972ea7"
msgid ""
"དེ་␣འང་ ཡོད་ དེ་ ཀཱ་ ཤ་␣འི་ ནགས་ ཀྱི་ སེམས་ཅན་ ཆེན་པོ་ བཞི་ ལ་སོགས་པ་ བཞིན་ "
"ནོ །༑"
msgstr ""
"That also exists, for example, the four great animals of the Kasha forest "
"and so on."

msgctxt "f5b7f51c036f44549a40b44b881ffbc6"
msgid "རྡོ་␣༽༽  གཞན་ བཞེད་ ལ །"
msgstr "Vajra: Others accept that,"

msgctxt "9d50b89a6e4c4d83ac0b5838e9c32d43"
msgid "བྱང་ཆུབ་ ཀྱི་ སེམས་ ཀྱི་ མཚན་ཉིད་ ནི་ མངོན་ རྒྱན་ ལ་␣ས །"
msgstr ""
"According to the Ornament of Manifest Realization: The characteristics of "
"bodhicitta are as follows"

msgctxt "fb5256b7f86f4a6db7aab17a5702ed73"
msgid "སེམས་བསྐྱེད་པ་ ནི་ གཞན་དོན་ ཕྱིར །"
msgstr "The generation of bodhicitta is for the sake of others."

msgctxt "15d3afd28ab84a5581e4d2266d7fda3d"
msgid "ཡང་དག་ རྫོགས་པ་␣འི་ བྱང་ཆུབ་ འདོད །"
msgstr "Aspire for the perfect and complete enlightenment."

msgctxt "d30411028eaf4878a13fdb55553aa730"
msgid "ཅེས་ སོ །"
msgstr "As said."

msgctxt "dbad94612bad4d5fa4b169a538c829b5"
msgid "དམིགས་པ་ ནི་ ཤེས་རབ་ ཀྱིས་ རྫོགས་ བྱང་"
msgstr "The observation is complete enlightenment by wisdom, "

msgctxt "cf476fca387d4ddba44b903e6d1afb6f"
msgid "སྙིང་རྗེ་␣ས་ སེམས་ཅན་ ཏེ་ འཁོར་འདས་ སོ ། །"
msgstr ""
"[The observation] to sentient beings by compassion as samsara and nirvana."

msgctxt "3450fa4c81d043a0b4af9eb8f3bc7d43"
msgid "གྲོགས་ སྨོན་ འདུན །"
msgstr "The companionship of aspiration"

msgctxt "c15715c5a4084718b441563739d1eabc"
msgid "དབྱེ་ གྲོགས་ ཀྱི་ མི་ཟད །"
msgstr "The inexhaustibility of different companions."

msgctxt "3ee5cea2e7bb44fdbdecdd637f698b37"
msgid "ས་མཚམས་ ཀྱི་ ཆོས་སྤྱོད་ སོགས་ བཞི །"
msgstr "The Dharma activities of the boundaries and so on. They are the four"

msgctxt "b9c22542576b49018cfbd01734c0903b"
msgid "ཡུལ་ གྱི་ ཀུན་རྫོབ་ དོན་དམ །"
msgstr "The objects of relative and absolute."

msgctxt "f6c85581edf14789a32b9f01d2116c53"
msgid "ངོ་བོ་␣འི་ སྨོན་ འཇུག་ ཕྲ་རགས་ བརྡ་ དང་"
msgstr ""
"The essence of the aspiring and engaging minds for enlightenment, subtle and"
" coarse,"

msgctxt "bf342b8ba4af453299acbb115ef4c4c1"
msgid "ཆོས་ཉིད་ ཀྱིས་ ཐོབ་པ་ གཉིས་ ཀྱི་ སྒོ་ ནས་ ཏེ་ བསྡུ་ ན་"
msgstr ""
"If the attainments are divided into two categories, they are attained by "
"symbol and the true nature of phenomena."

msgctxt "2b819d9d9e924cff836b8aed3a04437c"
msgid "སྨོན་ འཇུག་ ས་ དང་པོ་␣ར་ དོན་དམ་ སྟེ་ གསུམ་ ལ་␣ས །"
msgstr ""
"From these three, the aspiring and engaging minds for enlightenment, and the"
" absolute [truth] at the first level."

msgctxt "b27b61ff91a34593ba099e7c6905873d"
msgid "འཇུག་ སྡོམ་ ས་ ཐོབ་ ནས་ སྐྱེ་␣ར་ འདོད་ མོད །"
msgstr ""
"It is accepted that the vow of the engaging mind arises after the attainment"
" of the ground."

msgctxt "4ee7bee9c32c4a0eb5801c848a5f9b16"
msgid "འདི་␣ར་ ནི་ བྱང་སེམས་ ཀྱི་ སྡེ་སྣོད་ ཐམས་ཅད་ བསྡུས་པ་"
msgstr "In this [system], the compendium of all the bodhisattva pitakas is "

msgctxt "806a5af0f19346cd91aed8da5e5ddb7f"
msgid "བྱང་སེམས་ སྤྱོད་འཇུག  །"
msgstr "The Engaging in the Bodhisattva's Conduct."

msgctxt "7104c6d65f9d4281b0b57a4448bd5f07"
msgid "བསླབ་ བཏུས་ སོགས་ ཀྱི་ དོན་བསྡུས །"
msgstr "It is a summary of the Compendium Of Trainings and so forth. "

msgctxt "824938063331406496ae52601022571c"
msgid "ཙནྡྲ་ གོ་མི་␣འི་ སྡོམ་པ་ ཉི་ཤུ་པ་␣ར །"
msgstr "According to the Candragomin's Twenty Verses on the Bodhisattva Vow:"

msgctxt "d1e499061a2c47a89888244eb1a7e148"
msgid "རྙེད་ དང་ བཀུར་སྟི་␣ར་ ཆགས་པ་ ཡིས ། །"
msgstr "By becoming attached to gain and respect."

msgctxt "13aaf8f134f147d18d47125a6c18bbff"
msgid "བདག་ བསྟོད་ གཞན་ ལ་ སྨོད་པ་ དང༌ ། །"
msgstr "Praising oneself and disparaging others."

msgctxt "a695f074bef84014af9539817318249b"
msgid "སྡུག་བསྔལ་ མེད་པ་␣ར་ གྱུར་པ་ ལ ། །"
msgstr "To become the absence of suffering,"

msgctxt "deb52599a34c4a88b898b70c8c29ad9f"
msgid "སེར་སྣ་␣ས་ ཆོས་ནོར་ མི་ སྟེར་ དང་ ། །"
msgstr "Out of miserliness, not giving the wealth of the Dharma and"

msgctxt "cf683a9e72e6466f91b5d6d4711c7b2b"
msgid "གཞན་ གྱིས་ བཤད་ ཀྱང་ མི་ ཉན་པ་␣ར ། །"
msgstr "Not listening when others explain,"

msgctxt "4fcab8ccf25942ecb661a58aba39ac1e"
msgid "ཁྲོ་␣ས་ ནས་ གཞན་ ལ་ འཚོག་པ་ དང་ ། །"
msgstr "Hitting others in rage and"

msgctxt "5ba6898222a540a095942470c6e84d6b"
msgid "ཐེག་པ་ ཆེན་པོ་ སྤོང་ བྱེད་ ཅིང་ ། །"
msgstr "Abandoning the Greater Vehicle."

msgctxt "d8e111ea4bd44a9faf5ffde150978a92"
msgid "དམ་ཆོས་ འདྲ་␣ར་ སྣང་ སྟོན་པ་␣འོ ། །"
msgstr "A similar holy dharma is taught."

msgctxt "91b10a9039a34731ba98bcce1176411a"
msgid "ཞེས་ རྩ་ལྟུང་ བཞི་པོ་ འདི་␣ས་ དང་པོ་པ་ ལ་ འོང་ མི་ སྲིད་ དེ །"
msgstr "These four root downfalls are impossible to occur in the first one."

msgctxt "304a9101369b4b81889d947d001a9ed9"
msgid "མཐོང་སྤང་ བརྒྱ་རྩ་ བཅུ་གཉིས་ སྤང་པ་␣ས་"
msgstr ""
"The one hundred and twelve [afflictions] to be abandoned by the path of "
"meditation are abandoned."

msgctxt "ca09aad9c7084a7fbbb27fb54bf4a1f5"
msgid "འཇིག་ཚོགས་ ཀྱི་ ལྟ་བ་ དང་ བྲལ་ ཏེ་"
msgstr "After being free of the view of the transitory collection."

msgctxt "6a219c7db004468abcedbd1ea8acdd03"
msgid "བདག་ དང་ བདག་ གིར་ འདི་ལྟར་ བཞེད་པ་␣ས་"
msgstr "Thus, \"I\" and \"mine\" are accepted in this way."

msgctxt "2e7b94341d714407a6d12fd89ee5aaf3"
msgid "སོ་སོ་ སྐྱེ་བོ་ ལ་ ཡང་འཇུག་ སྡོམ་ སྐྱེ་བ་ ཡོད་ དོ །"
msgstr ""
"The vow of the engaging mind can also arise in an individualized being."

msgctxt "fa591d3b71014cc9a3271e050133ba7f"
msgid ""
"རྡོ་␣༽༽  འཇུག་ སྡོམ་ ནི་ སྡོམ་པ་ དགེ་བ་ ཆོས་ སྡུད་ སེམས་ཅན་ དོན་ བྱེད་ དེ་"
msgstr ""
"Vajra: The vow of the engaging mind is the vow of virtue, gathering Dharma, "
"and benefiting sentient beings."

msgctxt "833650b39fc54110ae4eb38216604095"
msgid "གསུམ་པོ་ མཐའ་དག་ མ་ གྲུབ་ ན་ འཇུག་ སྡོམ་ དུ་ མི་ འགྱུར་ ཟེར །"
msgstr ""
"It is stated that if all three are not accomplished, it will not become the "
"vow of the engaging mind."

msgctxt "d8f1915b79a6432a8f05d8c7a803c83c"
msgid "འདི་␣ར་ ནི་ དེ་ གསུམ་ མཐའ་དག་ རྫོགས་ ནས་"
msgstr "In this [system], after the completion of all three of these,"

msgctxt "ee4034cf03be4447959cee18b887daef"
msgid "ས་བཅུ་པ་␣ས་ ཀྱང་ མི་ ནུས་ ཏེ །"
msgstr "Even those at the tenth level are unable to do so."

msgctxt "77d0a62b3edf472c8485d03ecb481618"
msgid "སངས་རྒྱས་ ཉག་གཅིག་ གི་ སྤྱོད་ཡུལ་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr "Because it is the scope of the Buddha alone."

msgctxt "04fd361056c14ddd8814b45aad8043e7"
msgid "ནོར་ བཟང་ གིས་ བླ་མ་ རྣམས་ ས་བཅུ་པ་ ཡིན་ཡང་"
msgstr "Although the gurus of Sudhana were tenth-level bodhisattvas."

msgctxt "9d535baa50034537929dc95c3b106d06"
msgid "ཉམས་ སུ་ ལེན་ ཚུལ་"
msgstr "The way of practice"

msgctxt "26abd8b4513d4a1e9fe56ac3a8e05180"
msgid "ཟུང་ རེ་ ཚེ་ བརྟགས་ གཞན་ ཤེས་པ་␣ར་ ནུས་"
msgstr "It is rare that [one] can know it by analyzing it once."

msgctxt "54a09ea71cb7434b87da7f1c8273c80f"
msgid "རེ་ ཀན་ ཞེས་ གསུང་པ་ བཞིན་ ནོ ། །"
msgstr "Like, it is said."

msgctxt "39d6d48daee547e587d317f018cd7556"
msgid "དེས་ན་ སངས་རྒྱས་ ཐོབ་ འདོད་ ཀྱི་ སེམས་ སྨོན་པ་"
msgstr "Thus, the aspiring mind that wishes to attain buddhahood."

msgctxt "5c7657119f114523ba9b17431c054b2a"
msgid "དེ་␣འི་ ཆེད་ དུ་ སྒོ་གསུམ་ དགེ་བ་␣ར་ བཀོལ་བ་ འཇུག་ སྡོམ་ ཡིན་པ་␣ས་"
msgstr ""
"For that, putting the three doors [of action] into virtue is the vow of the "
"engaging mind."

msgctxt "217ec76b80d74afeb1ae0629bc2d571b"
msgid ""
"སྣ་ རེ་ཟུང་ ནུས་ ཚོད་ ལྕོག་ ཚོད་མ་ ཉམས་པ་␣ར་ ཉམས་ སུ་ ལེན་པ་ ཅི་རིགས་ ཀྱིས་ "
"ཀྱང་"
msgstr "Some practitioners practice as much as they can without degeneration."

msgctxt "2f257fbc670c4db4bad954f7146ad6f3"
msgid "སྨོན་སེམས་ ཀྱི་ དབང་ བྱས་ ནས་ བསྒྲུབ་པ་␣ས་"
msgstr "And accomplished by the power of the aspiring mind "

msgctxt "7c36f4901d4b4b7892b746314531272f"
msgid "འཇུག་པ་␣འི་ སྡོམ་པ་␣ར་ འཇུག་པ་ ཡོད་པ་␣ར་ འགྱུར་ རོ །"
msgstr "There will be engagement in the vow of the engaging mind."

msgctxt "90c69b47c17b4b5681480dc279fdc801"
msgid "ལྷན་␣༽༽  ས་ དང་པོ་ ཐོབ་ ནས་ ངན་འགྲོ་␣འི་ འཇིག་པ་ མེད་པ་␣ར་ འདོད་ མོད །"
msgstr ""
"Addendum: Though it is accepted that after attaining the first level, there "
"is no destruction of the lower realms."

msgctxt "7ea925b2ce454192a3858da133c59cd7"
msgid "འདི་␣ར་ ནི་ དང་པོ་ ཙམ་ དུ་མ་ ཟད་"
msgstr "In this [system], not only on the first level,"

msgctxt "c187bcfdbfa94bee8499befeaf239e96"
msgid ""
"དག་པ་␣འི་ ས་ ཐོབ་ ཀྱི་ བྱང་སེམས་ མི་དགེ་བ་␣འི་ རྟེན་འབྲེལ་ ཚོགས་ ནས་ "
"ངན་འགྲོ་␣ར་ སོང་བ་ ཡོད་ དེ་"
msgstr ""
"Some bodhisattvas who have attained the pure levels but gone to the lower "
"realms due to the accumulation of dependent-related arisings of non-virtues."

msgctxt "6244eeda8618421c8dea8d0a22ffcbfe"
msgid "རྒྱུ་ ཤེས་བྱ་␣འི་ སྒྲིབ་པ་ བག་ཉལ་ དང༌ །"
msgstr "The obscuration to knowables is the cause in a state of latency and "

msgctxt "ae77dc1ca0fd42449563042b676fd442"
msgid "རྐྱེན་ གཉིས་ ཚོགས་ ན་ འགྲོ་ སྟེ་"
msgstr ""
"When two conditions come together, [one] will go to [the lower realms]."

msgctxt "c3e144ec700841d1ad7b9b20cc92bdfe"
msgid "རྟེན་འབྲེལ་ གྱི་ གཤིས་ མི་འགྱུར་བ་␣འི་ ཕྱིར །"
msgstr "Because the nature of dependent-related arising is unchanging."

msgctxt "872806b8a0f54b8aab11f42a002d9e24"
msgid "གཞོན་ནུ་ ཆུ་སྐྱེས་ དང་ །"
msgstr "Youthful Water Born and"

msgctxt "4a6150a2f55d4495b88743576876d1b9"
msgid "རྒྱལ་པོ་ དཔལ་ བྱིན་ དང་ དུད་འགྲོ་␣ར་ སོང་བ་"
msgstr "King Shridatta and those who had gone to the animal [realm]"

msgctxt "5c15a5108dd448829c6720e918f549f5"
msgid "གླང་ དོམ་ སྤྲེའུ་␣འི་ བྱང་སེམས་ ལ་སོགས་པ་ བཞིན་ ནོ ། །"
msgstr "Such as the bodhisattva of the ox, the bear, the monkey, and so on."

msgctxt "822a1171e88b43e592684b239a1eaca0"
msgid "གཞན་ འགྲོ་བ་ དང་ མི་ མཚུངས་ ཏེ་␣༑"
msgstr "This is not similar to other migrators."

msgctxt "dc995b9def684cbba5ce212a2d92419a"
msgid "མདོ་ རྒྱན་ ལ་␣ས །"
msgstr "According to the Ornament of the Sutra Section:"

msgctxt "56926cecda3e4ca1be5f1ba940540893"
msgid "དེ་ ཡི་ ཆོས་ ཀུན་ ཅེས་ མ་ ལྟ་བུ་ དང༌ །"
msgstr "All of these phenomena are like an illusion and"

msgctxt "220319d5cff44f7e857fbb6183dec1f8"
msgid "སྐྱེ་བ་ སྐྱེད་ མོ་␣྾"
msgstr "[Realizing that] taking birth is [similar to visiting] a garden,"

msgctxt "685cc05664f5496db7b66899e53f192e"
msgid "འབྱོར་བ་␣འི་ དུས་ དང་␣×"
msgstr "In times of prosperity and times of degeneration,"

msgctxt "33c554a11a6c46ad9601623a8720aaa8"
msgid "ཉོན་མོངས་␣྾"
msgstr "[There is no fear of] affliction [and suffering]."

msgctxt "34c5be329b5e4dd1aba9836dca80a550"
msgid "ཅེས་ སོ །"
msgstr "As said."

msgctxt "e6d6c2739acc4ffda124969810636570"
msgid "དེས་ན་ འདི་ ལ་ ཐུགས་བསྐྱེད་པ་ དང་"
msgstr "Thus, generated the mind in this and"

msgctxt "639df5352b1a4768a2ccdff2da1d1738"
msgid "ཕྲིན་ལས་ རྒྱུན་ མི་ ཆད་པ་ དང༌ །"
msgstr "Uninterrupted enlightened activities and "

msgctxt "3bb6736aee53431db655c4c3b8d36f10"
msgid "རྟེན་འབྲེལ་ དང་ ཐུགས་ ཀྱི་ གསང་བ་␣ར་ གཞིག་ ན་ ངེས་པར་ འགྱུར་ རོ །"
msgstr ""
"It is certain that when one entirely comprehends the dependent-related "
"arising and the secret of the mind."

msgctxt "2836b20778654cab9a3e36ed183ba258"
msgid ""
"ལྷན་␣༽༽  ས་ དང་པོ་␣འི་ བདེན་པ་ མཐོང་ ནས་ ལྟུང་ མི་ སྲིད་པ་ རྒྱུ་མ་ "
"སྤྱད་པ་␣ར་ ཡིན་ ལ །"
msgstr ""
"Addendum: Once the truth of the first level has been seen, it is impossible "
"for one to fall down, because one has not yet engaged in the causes."

msgctxt "fa4b6741e6d14a108f1f582faddef4c8"
msgid "གལ་ཏེ་ རྒྱུ་ སྤྱད་པ་␣ར་ གྱུར་ ན་"
msgstr "If one engages in the causes."

msgctxt "cfdd3cd4f1494062b707207d209b7ffb"
msgid "ས་བཅུ་པ་ ཡང་ ལྟུང་པ་␣ར་ འགྱུར་ ཏེ་"
msgstr "Even those at the tenth level will fall."

msgctxt "4b67ddc007ac4d43a7868e206bddfe2b"
msgid "སངས་རྒྱས་ རྒྱུ་རྐྱེན་ གྱི་ རྗེས་སུ་ འབྲང་བ་␣འི་ ཕྱིར །"
msgstr "The Buddha follows after causes and conditions."

msgctxt "3de6608c48dc49558e627898c5d72a83"
msgid "མ་ གྲུབ་ ན་ རྒྱུ་རྐྱེན་ མི་འདོད་པ་"
msgstr ""
"If it is not established, then causes and conditions are not accepted."

msgctxt "3bda35d596de4b9ab5035bbe6c5d3e70"
msgid "རྟག་ཆད་ མཐ་␣ར་ བྱུང་བ་␣ར་ འགྱུར་ རོ །"
msgstr "The extremes of permanence and nihilation would occur."

msgctxt "073d1c9b9b17485f8e0d0c3a26dcf87b"
msgid "དེ་␣འི་ ཕྱིར་ རྒྱུ་ སྤྱད་ ན་ འབྲས་བུ་ མི་ ཁེགས་ སོ ། །"
msgstr ""
"Therefore, when one engages in the cause, the effect will not be ceased."

msgctxt "ffc790a99d46460eafb06152af086e81"
msgid "འདི་␣ར་ འགའ་ཞིག་"
msgstr "In this case, some said:"

msgctxt "916ad94b506d487d98fa5565c62729b9"
msgid "བྱང་སེམས་ སྡོམ་པ་ སྤང་བླང་ གཉིས་ ལ་␣ས་"
msgstr ""
"From the twofold bodhisattva vows: that which is to be adopted and that "
"which is to be abandoned."

msgctxt "1762813e98024bb0a872bdce8e52ae13"
msgid "སྤང་བྱ་␣ར་ དུག་ གསུམ་ གྱིས་ དཀོན་མཆོག་ མཆོད་ ན་"
msgstr ""
"When an offering is made to the [three] jewels with the three poisons to be "
"abandoned."

msgctxt "65d13621c90e42dd99aca0ea45a8b9da"
msgid "གྲུབ་པ་ སོགས་ ཉོན་མོངས་ ཅན །"
msgstr "The accomplishment and so forth are afflicted."

msgctxt "6203b17fb9f34626a320297c85ca0ab0"
msgid "ལེ་ལོ་ སྙོམ་ལས་ སོགས་ ཀྱིས་ མ་གྲུབ་པ་"
msgstr "It is not accomplished out of laziness and so on."

msgctxt "34a2f67273ca4c7fbd555d5c70353e83"
msgid "ཉོན་མོངས་ ཅན་ མིན་པ་ ན་"
msgstr "If it is not afflicted,"

msgctxt "26d47914b80245f0bdcd2fdc44965b4c"
msgid "ཚ་ སོགས་ རྐྱེན་ གྱིས་ མ་ནུ་␣ས་ ན་"
msgstr "If it is unable to do with the conditions such as heat and so on."

msgctxt "7a5b2d7d9d0a46d5b86c56732ca4b6ff"
msgid "ལྟུང་ མེད་ ཡིན་ ཟེར །"
msgstr "Then it is without downfall."

msgctxt "1560adedda394c2a8a1257744c2800a1"
msgid "དེ་ ཆོས་ཅན །"
msgstr "Take this as the subject."

msgctxt "43b8f916525b4a118060c21f4faddc98"
msgid "ལྟུང་ ལྟུང་ མེད་ གཉིས་ སུ་ ཐག་ བཅད་ ན་"
msgstr "If it is deemed to be a downfall or not."

msgctxt "af0674f5a2d14bfda477903e07925e9b"
msgid "ཉོན་མོངས་ ཅན་ མིན་པ་␣འི་ ལྟུང་བ་ མི་ སྲིད་པ་␣ར་ ཐལ །"
msgstr "It follows that it is impossible to have an unafflicted downfall."

msgctxt "e8768c6aaca24febb3e8452f5b61f36b"
msgid "དགེ་ མི་དགེ་ གཉིས་ སུ་ མ་ འདུས་པ་␣འི་ ཆོས་ མེད་པ་␣འི་ ཕྱིར །"
msgstr ""
"Because there is no phenomenon that is not included in either virtue or non-"
"virtue."

msgctxt "c83f82fa420343a293d71cae8c323744"
msgid "དཔེར་ན་ འཁོར་འདས་ གཉིས་ སུ་ བསྡུས་ ན་"
msgstr ""
"For example, if [everything] is condensed within the two: samsara and "
"nirvana."

msgctxt "ef23949695fc4803b84b932c677f0316"
msgid "ཕུང་ གསུམ་ མི་ སྲིད་པ་ བཞིན་ ནོ ། །"
msgstr "Then a third aggregate is impossible."

msgctxt "3e5d620ec75a45fc8e340cd2a01792b9"
msgid "ཡང་ དེ་ ཆོས་ཅན །"
msgstr "Also, take this as the subject."

msgctxt "7b0ebf95c2c94bd9a9849930afbccdea"
msgid "མི་དགེ་ ཉོན་མོངས་པ་ ཡིན་པ་␣ར་ ཐལ །"
msgstr "It follows that non-virtue is an affliction."

msgctxt "1824191c7ec84ae9bb3d281b73d15106"
msgid "ལྟུང་བ་ ཞེས་པ་ འོག་ ནས་ འོག་ ཏུ་ ལྟུང་པ་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr "Because the so-called downfall is a downward fall."

msgctxt "19cfb4956dc8445db6abf3d481830eb2"
msgid "ཉོན་མོངས་ ཅན་ མིན་པ་ དེ་ ཆོས་ཅན །"
msgstr "Take the subject that which is not an affliction."

msgctxt "0696583af9f940779fa283b491e5de3e"
msgid "ལྟུང་བ་ མིན་པ་␣ར་ ཐལ །"
msgstr "It follows that it is not a downfall."

msgctxt "43c3d1d680be440591cb57207ebe3d43"
msgid "རྒྱུ་ ཉོན་མོངས་ དང་ བྲལ་བ་␣འི་ ཕྱིར །"
msgstr "Because it is free from the afflictions that are its cause."

msgctxt "99052677da6441469301cd3904b02be4"
msgid "དཔེར་ན་ སངས་རྒྱས་ བཞིན་ ནོ །"
msgstr "For example, like the Buddha."

msgctxt "859ed70ca02a4729add219a708fec18e"
msgid "ལེ་ལོ་ སོགས་ ཆོས་ཅན །"
msgstr "Take the subject laziness and so forth."

msgctxt "cd79accada0d420a93915db7be9e9b26"
msgid "ཉོན་མོངས་ ཅན་ ཡིན་ ཏེ་"
msgstr "They are afflicted."

msgctxt "d982ea85d4ae496a8f6c19fb9f113a6b"
msgid "རྩ་ཉོན་ དང་ ཉེ་ཉོན་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr "Because they are the root afflictions and secondary afflictions."

msgctxt "81fe043567e749ac9fc6ff241cf6af1e"
msgid "མཁའ་འགྲོ་ སྡོམ་པ་␣འི་ རྒྱུད་ ལ་␣ས །"
msgstr "According to the Tantra of the Dakinis' Vows:"

msgctxt "f65cb81f74fc4c9abb66bea8fc897688"
msgid "མི་ ཤེས་པ་ དང་ བག་མེད་པ །"
msgstr "Not knowing and heedlessness,"

msgctxt "032ae87b8a444aea8d922c1cb3136889"
msgid "མི་ ནུས་པ་ དང་ ཉོན་མོངས་པ །"
msgstr "Incapability and affliction"

msgctxt "a964c3f783214e54a286078c77a6f904"
msgid "བརྗེད་ངས་ དྲན་པ་ མི་ གསལ་བ །"
msgstr "Forgetfulness and unclear recollection"

msgctxt "55f9908877444427adb90f80fe894b93"
msgid "འདི་ དྲུག་ དམ་ཚིག་ ཉམས་པ་␣འི་ རྒྱུ །"
msgstr "These six are the causes of deteriorating sacred commitments."

msgctxt "4f0138ae78c64adc8071ef3b94f66bb6"
msgid ""
"ཞེས་པ་␣ས་ ཉོན་མོངས་ ཅན་ མིན་པ་␣འི་ ལྟུང་བ་␣ར་ མི་ སྲིད་ ཅིང་ མ་ གྲུབ་བོ །"
msgstr ""
"Thus, the unafflicted downfall is both impossible and not established."

msgctxt "99fa808a3ccf4fd7ad376b7da85054f1"
msgid "རྡོ་␣༽༽  བྱང་སེམས་ རྣམས་ གཞན་དོན་ དུ་ དགེ་བ་␣ར་ གྱུར་པ་␣ས་"
msgstr ""
"Vajra: Bodhisattvas are transformed into virtuous actions for the sake of "
"others, "

msgctxt "2bee14d243244cb3b6ce1597bbeb35ee"
msgid "སྲོག་གཅོད་ སོགས་ ཉེས་པ་␣ར་ མ་ གྱུར་པ་"
msgstr "So they do not commit faults such as killing. "

msgctxt "4e99233c6ff048cfafbe5b48aa25598e"
msgid ""
"དེད་དཔོན་ སྙིང་རྗེ་ ཆེན་པོ་ དང་ བྲམ་ཟེ་ ཁྱེའུ་ སྐར་མ་ ལྟར་ རོ་ ཟེར་ རོ ། །"
msgstr ""
"Like captain Mahakarunika and the young brahmin Jyotipala as it is said."

msgctxt "bdd1b0862a6945d5847caa3a61eb52de"
msgid "འདི་␣ར་ ཉེས་པ་␣ར་ མི་ འགྱུར་ གནང་བ་ མེད་ དེ་"
msgstr "In this [system], there is no fault and no permission"

msgctxt "a28275bbf52848c5b435c9cb7cf38870"
msgid "བྱང་སེམས་ རྣམས་ བདག་ཉིད་ ཡལ་བ་␣ར་ དོར་ ནས་"
msgstr "Bodhisattvas having forsaken themselves"

msgctxt "52288714e0c949fa89a5c2c0ce41a921"
msgid "གཞན་དོན་ དུ་ བཟོད་པ་ ཐོབ་པ་"
msgstr "[They] have attained forbearance for others."

msgctxt "29e4836b47284d55a8d1c7ec46581fbe"
msgid "དམྱལ་བ་␣ར་ གནས་པ་␣ར་ ནུས་པ་ ལ་ གནང་བ་␣འི་ ཕྱིར །"
msgstr ""
"Because [they] are capable of remaining in hell and permission is granted. "

msgctxt "02db86bf7f544b28b178608420b4b31f"
msgid "འཕྲུལ་ དག་ བདེན་པ་␣འི་ མདོ་ ལ་␣ས །"
msgstr "According to The Pure Emanation- The Sutra of Truth:"

msgctxt "5817e7ea49f74ad4945bbd5c25a8afb8"
msgid "དབང་མེད་ ལ་␣ས་ ཀྱི་ རྣམ་སྨིན་ འབྱུང་བ་ ལ །"
msgstr "The occurrence of complete ripening of karma beyond [our] control,"

msgctxt "bca61636b1834e7fa93cf21d4a6378ed"
msgid "སངས་རྒྱས་ བཅོམ་ལྡན་འདས་ ནི་ མངའ་ མི་ མཛད །"
msgstr "The Buddha, the Blessed One, does not possess it. "

msgctxt "c1b9e186eae346e5b211bac59f9c6b2c"
msgid "ཅེས་ དང་ །"
msgstr "And."

msgctxt "fd00af2607e0468b9ef8cf5c5be45925"
msgid "གསང་ ཆེན་ ཐབས་མཁས་ ལ་␣ས །"
msgstr "The Great Secret of Skillful Means says:"

msgctxt "7d64418c3c8f453eb7d5b5545b01a8e5"
msgid "རབ་མཆོག་ རྒྱལ་པོ་␣ས །"
msgstr "The most supreme king said"

msgctxt "fd6fa0a459004e739e9c2cc7cd1c22de"
msgid "སེམས་ཅན་ གཅིག་ ལ་ དགེ་རྩ་ བསྐྱེད་ པའི ཕྱིར །"
msgstr "To develop the roots of virtue in one sentient being,"

msgctxt "1bcbef24f29841ca93ed500cfe879d12"
msgid "སེམས་ཅན་ རྣམས་ མ་འོངས་པ་␣ར་ འདི་ ལྟ་བུ་ འབྱུང་ ཞིང་"
msgstr "Sentient beings will be like this in the future."

msgctxt "96eb0614a3b042968997ebce070c4ebd"
msgid ""
"བྱུང་བ་ དེ་␣ས་ བསྐལ་པ་ འབུམ་ གྱི་ བར་ དུ་ དམྱལ་བ་␣ར་ གནས་པ་ ནི་ སླ་ ཡི་ "
"སེམས་ཅན་ གཅིག་པོ་"
msgstr ""
"This occurrence to remain in hell for one hundred thousand aeons is easy. "
"But only sentient beings"

msgctxt "340086fb2de84211858e5a752ac0af60"
msgid "དེ་␣འི་ དགེ་རྩ་ གཏོང་བ་ ནི་ དེ་ལྟ་ མིན་ ནོ ། །"
msgstr "Giving up the roots of virtue is not like that. "

msgctxt "bb014210d68343938c2b1d4141626bb1"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "727e91d912464b699f73d13312209153"
msgid "སྡོམ་པ་ ཉི་ཤུ་པ་ དང་ སྤྱོད་འཇུག་ གི་ ལུང་ བཀོད་ ནུས་པ་␣ས་ གསུངས་ ཀྱི །"
msgstr ""
"The words quoted in the Twenty Verses on Vows and the Engaging in the "
"Bodhisattva's Conduct:"

msgctxt "142df94b174b4fafbae40c03e8888a1a"
msgid "འབྲས་བུ་ མི་ འབྱུང་བ་ ནི་ མིན་ ཏེ །"
msgstr "It is not the case that the fruit will not occur,"

msgctxt "93264b7248d94a9fb51871e534fe10ae"
msgid "དེད་དཔོན་ སྙིང་རྗེ་ ཆེན་པོ་ ལོ་ སྟོང་ཕྲག་ མང་པོ་␣ར་ དམྱལ་བ་ མྱོང་ ནས་"
msgstr ""
"Because the captain Mahakarunika, after experiencing hell for many thousands"
" of years,"

msgctxt "f29467da17f047b2ba0ab6732f2fa598"
msgid "སངས་རྒྱས་པ་␣འི་ དུས་ སུ་␣འང་ སེང་ལྡེང་ ཟུགས་ ཏེ་"
msgstr "When he became a buddha, by holding acacia"

msgctxt "a6d161ce2810421495b63fb56ce491af"
msgid "འབྲས་བུ་འབྱུང་བ་␣འི་ ཚུལ་ བསྟན་པ་ བཞིན་ ནོ །"
msgstr "He showed how the results occurred."

msgctxt "cc55aec0966446d39ee523c74d491625"
msgid ""
"རྡོ་␣༽༽  བྱང་སེམས་ རྣམས་ ཐབས་མཁས་པ་␣ས་ མི་དགེ་བ་ ལ་ འཇུག་པ་␣ར་ འདོད་ མོད །"
msgstr ""
"Vajra: Though it is accepted that bodhisattvas engage in non-virtue "
"skillfully. "

msgctxt "5a1cbad051574e3295e709f894363b0e"
msgid ""
"དེ་ ཆོས་ཅན་ ཐབས་མཁས་པ་␣འི་ སྤྱོད་པ་ ལ་ མི་དགེ་བ་ ཡོད་པ་ མ་ཡིན་པ་␣ར་ ཐལ །"
msgstr ""
"Take that as the subject, it follows that there is no non-virtue in the "
"practice of skillful methods."

msgctxt "d91743f81e3d45a7a723ed3221aa324a"
msgid "དགེ་བ་ ལ་␣ས་ མཐོ་རིས་ ཐར་པ་ དང་ །"
msgstr "From virtue come the higher realms and emancipation."

msgctxt "7d63cdab614b45a8abc34c5adadeb4af"
msgid "མི་དགེ་བ་ ལ་␣ས་ འཁོར་བ་ ངན་སོང་ གི་ སྡུག་ འསྔལ་ འབྱུང་བ་␣ས་"
msgstr ""
"Non-virtue brings about the sufferings of the bad migrations of samsara,"

msgctxt "a44d1e8d8d4742efaf7ccd3938891ea0"
msgid "སེམས་ཅན་ སྨིན་གྲོལ་ མི་ ནུས་པ་␣འི་ ཕྱིར །"
msgstr "Therefore, sentient beings are unable to ripen or liberate."

msgctxt "9def8898ea0f47268214833eaa1c5236"
msgid "དཔེར་ན་ མུན་པ་ སང་ མི་ ནུས་པ་ བཞིན་ ནོ ། །"
msgstr "Just like one cannot clear away the darkness."

msgctxt "5fd751b424834840b17f881ae5ead1b8"
msgid "དེས་ན་ ཐབས་མཁས་ སྤྱོད་པ་ དགེ་བ་ ཁོ་ན་ ཡིན་ ནོ ། །"
msgstr "Thus, skillful practices are exclusively virtuous."

msgctxt "0b66e546ae654e299983dd5bc6e7ea4f"
msgid "ཤེས་བྱ་ ཐམས་ཅད་ བྱང་སེམས་ ཀྱི་ བསླབ་པ་␣ར་ གསུངས་ ཀྱང་"
msgstr "Although all knowables are said to be the training of bodhisattvas,"

msgctxt "804cd6f3500d4878afc3466afecd7972"
msgid "བླང་ བྱ་ འབའ་ཞིག་ ག་ལ་ ཡིན །"
msgstr "How could they be only something to be adopted?"

msgctxt "bfc90aba2b2944298bb8c7edf9fb46c4"
msgid "དུག་ སྤང་ རྒྱུ་ ཡིན་ཡང་ ངོ་མ་ ཤེས་ ན་"
msgstr "Although the poison should be abandoned, if it is not recognized"

msgctxt "b209bd06fafb4048bd5ec0fe455efbf6"
msgid "སྤོང་ མི་ ཤེས་པ་ བཞིན་ ནོ ། །"
msgstr "[one] will not know how to abandon it."

msgctxt "a0a6eaf195f846d7af1142b8b0b79a7f"
msgid ""
"ཤེར་ཕྱིན་ དང་ གསང་ ཆེན་ ཐབས་མཁས་ ལ་␣ས་ གསུངས་པ་␣འི་ ཐབས་མཁས་པ་␣ས་ སྤྱོད་ ན་ "
"ཉེས་པ་ མེད་ གསུངས་པ་"
msgstr ""
"The statement in The Perfection of Wisdom and the Great Secret of Skillful "
"Means that there is no fault in the practice of skillful means, "

msgctxt "f031bd9fdae74fcbb03248a6f3030283"
msgid "འདི་ ནི་ སྐྱེ་བ་␣འི་ ཆོས་ ལ་ བཟོད་པ་ ཐོབ་པ་␣ས་"
msgstr ""
"This is said regarding the attainment of the forbearance of the reality of "
"birth"

msgctxt "558bb87d0c244adbaf5d3f82968df3d0"
msgid "འབྲས་བུ་ བཀོད་ ནུས་པ་ ལ་ གསུངས་ སོ ། །"
msgstr "And the capacity to place the result."

msgctxt "900e7c7507d6454181405362039be56c"
msgid "དེས་ན་ སེང་གེ་ འཁྱོངས་ ས་␣ར་ ཝ་སྐྱེས་ འཁྱོངས་ ན་"
msgstr "Thus, when a fox tries to jump where a lion jumps"

msgctxt "633e26885b5045cabe22a30b0e5a5c81"
msgid "རྐེད་པ་ བྲལ་བ་␣ས་ གཟབ་ དགོས་ སོ །"
msgstr "It should be careful of the back sprain. "

msgctxt "3f60f603d0614666a276987c3a74386a"
msgid "རྡོ་␣༽༽  སྙིང་རྗེ་ ཆེན་པོ་␣ས་ གཞན་དོན་ དུ་ སྨོན་ལམ་ འདེབས་པ་ དང་"
msgstr ""
"Vajra: It is said that the great compassion aspires for the benefit of "
"others and"

msgctxt "90345edb20b44122869dd9f1bf4a4a15"
msgid "རང་གཞན་ བརྗེ་བ་␣ར་ བཤད་ དོ ། །"
msgstr "exchanging self and others."

msgctxt "3f03435623264d1dbeff1ba730f83474"
msgid "འདི་␣ར་ ནི་ རང་གཞན་ བརྗེ་བ་ དེ་"
msgstr "In this [system], in exchanging self and others"

msgctxt "ca2c6fba682b40fb8dc206d0565d9aca"
msgid "ཐབས་ལམ་ མཁས་ ན་ ཉེས་པ་␣ར་ འགྱུར་བ་␣འི་ སྐབས་ ཡོད་ དེ་"
msgstr "There is an occasion of fault in skillful means."

msgctxt "14067714e7bc4e5f8428734b45781eb7"
msgid "བཟོད་པ་ མ་ ཐོབ་ ན་ འཇམ་དཔལ་ གྱི་ ཞིང་ བཀོད་ ལ་␣ས །"
msgstr ""
"If [one] has not attained the forbearance. According to the Array of Virtues"
" of Manjushri's Buddha Realm:"

msgctxt "a137eafd05ae4067a4ba565f35b1361d"
msgid "ཆོས་ རྣམས་ ཐམས་ཅད་ རྐྱེན་ བཞིན་ དུ ། །"
msgstr "All phenomena are conditional."

msgctxt "2986788aa8ee4c9c8e1a6f6d38f37319"
msgid "འདུན་པ་␣འི་ རྩེ་ ལ་ རབ་ཏུ་ གནས །"
msgstr "It is also dependent on the tip of one's purposeful intent. "

msgctxt "6239b846faaa43e691ecda837d1b900a"
msgid "གང་ གིས་ སྨོན་ལམ་ ཅི་ བཏབ་པ ། །"
msgstr "Whatever aspirational prayers people offer."

msgctxt "8375ca8dabfb46d09fcd78d9fe27a5c6"
msgid "དེ་ འདྲ་␣འི་ འབྲས་བུ་ ཐོབ་པ་␣ར་ འགྱུར །"
msgstr "A similar result will be attained."

msgctxt "318ab23716a147dbb7b8b0beec2f1662"
msgid "ཞེས་པ་␣ས་ སྨོན་ལམ་ འགྲུབ་ ཅིང་"
msgstr "Thus, these aspirations will be accomplished."

msgctxt "db6e546010fd4340b3cb7da424047a94"
msgid "གྲུབ་ ན་ སྡུག་བསྔལ་ ཉེ་␣ས་ ཚོགས་ ཀྱིས་ ཚུལ་ ཟིལ་ གྱིས་ མནན་ ཏེ་"
msgstr ""
"If these are accomplished, suffering and the accumulation of faults will "
"suppress"

msgctxt "38a51b43dd3d4de4be2eae82a94f5ae9"
msgid "ལེགས་ སྤྱོད་ ཀྱི་ བར་ཆད་ དུ་ འགྱུར་བ་␣འི་ ཕྱིར །"
msgstr "It will become an obstacle to excellent practice."

msgctxt "acf8e798b2fc446d81311ac810ecc79d"
msgid "འཕགས་པ་ ཤཱ་རི་␣འི་ བུ་ བྱང་སེམས་ ས་ དྲུག་པ་ ཡིན་ ཀྱང་"
msgstr "Although the noble Shariputra was a bodhisattva of the sixth level."

msgctxt "ecfd0b11fb034e7fa2c992efe57bb7b4"
msgid "དུས་ ལ་མ་ བབས་པ་␣ར་ ལུས་ བྱིན་པ་␣ས་"
msgstr "Because he donated his body before it was right time."

msgctxt "fe8dcf9c49144f85842f21256459325c"
msgid "ཉན་ཐོས་ ཀྱི་ ས་␣ར་ ལྟུང་བ་␣འི་ རྐྱེན་ བྱས་པ་ བཞིན་ ནོ ། །"
msgstr "It is just as when it caused him to fall to the shravaka level."

msgctxt "734d35a64c8f44d79e3454eaea20a438"
msgid "དེས་ན་ ཚོགས་སྦྱོར་ དུ་ བསམ་པ་ རྒྱ་ཆེན་པོ་ བསྐྱེད་ ནས་"
msgstr ""
"Therefore, at the time of the [paths of] accumulation and connection, "
"generates a vast aspiration."

msgctxt "8c32d4522f664ff2a99f3f3067c24b35"
msgid "སྦྱོར་བ་ གཞན་དོན་ འགྲུབ་ ཚད་ ལྕོག་ ཚད་ བྱ །"
msgstr ""
"In terms of application, one should accomplish whatever is possible for the "
"benefit of others."

msgctxt "052e6e7f0f2e4cd79f91e545ed016a2c"
msgid "མཐོང་ལམ་ ནས་ ས་ འདུན་པ་␣འི་ བར་ སྤྱོད་པ་␣ར་ འཇུག །"
msgstr ""
"From the path of seeing up to the seventh level, one engages in the conduct."

msgctxt "07c253fd1f024314a9f137c83bcf4137"
msgid "ས་ བརྒྱད་པ་ ནས་ སྤྱོད་པ་ རླབས་པོ་ཆེ་ ལ་ འཇུག་པ་ ཡིན་ ནོ ། །"
msgstr ""
"From the eighth level onward, one engages in the conduct with great force."

msgctxt "1c02d9364ee443e0bc994e6a6bd89940"
msgid "དེ་ཕྱིར་ སྤྱོད་འཇུག་ ལ་␣ས །"
msgstr "Therefore, according to the Engaging in the Bodhisattva's Conduct:"

msgctxt "7198be7a81d64c719afbec52a49285c6"
msgid "དམ་པ་␣འི་ ཆོས་ ནི་ སྤྱོད་པ་␣འི་ ལུས ། །"
msgstr "This body, which is utilized for the holy Dharma,"

msgctxt "d0287c8b460e476e8860abe0859b99b4"
msgid "ཕྲན་ཚེགས་ ཆེད་ དུ་ གནོད་ མི་ བྱ །"
msgstr "Should not be harmed for a minor advantage."

msgctxt "069d28c51b0f4a9d8178310d217e49ea"
msgid "ཞེས་ སོགས་ གསུངས་ སོ ། །"
msgstr "And so on, said. "

msgctxt "336572e2c86a44a299814615bbf12472"
msgid "འོ་ན་ ཅི་ ཞེ་ན །"
msgstr "Well then, if one wonders what this means,"

msgctxt "5bc54ddd58a645019277454675ba0d87"
msgid "ན་ཚ་ སོགས་ སྡུག་བསྔལ་ སྐྱེ་ དུས་"
msgstr "When the sufferings of sickness and so on arise,"

msgctxt "96b07d7f37dd474eb96d7dfb4b8c5ad8"
msgid "ལམ་ དུ་ གཏོང་བ་ མཛའ་བོ་␣འི་ བུ་མོ་ ལྟ་བུ་ ཉམས་ སུ་ ལེན་ དགོས་པ་"
msgstr ""
"It must be passed into the path and practiced as if it were a dear friend."

msgctxt "0609d7b9782b44368252a1711e687122"
msgid "ཆོས་རྗེ་␣འི་ ཕྱག་བཞེས་ ཡིན་ ནོ །"
msgstr "This is the practical instruction of the Dharma lord."

msgctxt "3977abc8b959415585795bc65821cd65"
msgid "ལྷན་␣༽༽  ཐབས་ ཚོགས་ བསགས་པ་␣འི་ ཡུལ་"
msgstr "Addendum: the place of gathering the accumulation of methods"

msgctxt "7849ece1f894441aab8908ff2de35a42"
msgid ""
"མར་ སེམས་ཅན་ རྣམས་ ལ་ བུ་ དང་ ཆུང་མ་ གཏོང་བ་ སོགས་ བསགས་ དགོས་ ཟེར་ རོ ། །"
msgstr ""
"It is said that one must accumulate merit by giving away one's children and "
"spouse to sentient beings."

msgctxt "0a59be6ec3e5474cb246a435ecf40f3e"
msgid "དེ་ ནི་ བདག་ཅག་ གི་ སྟོན་པ་␣འི་ མཛད་པ་ ཡིན་པ་␣ས་ སྒྲུབ་ མི་ ནུས་"
msgstr ""
"Because this is the deed of our teacher, thus [we] cannot accomplish it."

msgctxt "c4fafeb746d34197ab78dfbd44c704e3"
msgid "གནས་སྐབས་ ཕན་ བྱེད་ ཀྱིས་ ཀྱང་ སངས་ མི་ རྒྱ་བ་"
msgstr "Even if it benefits [us] temporarily, it will not enlighten [us]."

msgctxt "e8385dc662cd45c99fde65237bff363e"
msgid ""
"དེས་ན་ ཉམས་ལེན་ རྨད་ དུ་ བྱུང་བ་ རྣལ་འབྱོར་ ཀུ་ ས་ ལི་␣འི་ ཉམས་ལེན་ ནང་ གི་ "
"ཚོགས་གསོག་ ཡིན་ ཏེ་"
msgstr ""
"Thus, the marvelous practice, the practice of kusali yoga, is the internal "
"accumulation of merit."

msgctxt "e45e3a348a464b7bbe2813bcbdcb3550"
msgid "ཞིང་ འཁོར་འདས་ དག་པ་␣ས་ ཁྱད་པར་ འཕགས་པ །"
msgstr ""
"The field is superior because it is the purity of samsara and nirvana."

msgctxt "511e27aac90e43419e008f1431df59e9"
msgid "བསམ་པ་ དོན་ གཉིས་ སྒྲུབ་པ་␣འི་ ཕྱིར་ ཁྱད་པར་ འཕགས་པ །"
msgstr "It is superior because it accomplishes the two wishes."

msgctxt "b16c0fb377f140778e9c900c126ea527"
msgid "དངོས་པོ་ གཅེས་པ་␣འི་ ལུས་ བདུད་རྩི་␣ར་ བསྒྱུར་ ཏེ་"
msgstr "The thing, the cherishing body is transformed into nectar."

msgctxt "fa5ad26c7556484089f81a2677297b6e"
msgid "ཟད་པ་ མེད་པ་␣ར་ ཕུལ་བ་␣ས་ ཁྱད་པར་ འཕགས་པ་ ཡིན་པ་␣འི་ ཕྱིར་ རོ །"
msgstr "Because inexhaustible offerings are made, it is superior."

msgctxt "e2a5eb3bea024a1c8d92887206970425"
msgid "ན་ཚ་ སོགས་ བྱུང་ དུས་ ཀུ་ ས་ ལི་␣འི་ ལམ་ གཏོང་"
msgstr "When illness and so forth occur, giving up the kusali path"

msgctxt "3e2e0f98befe47e0bb405e5692eae866"
msgid "འདི་ཁོ་ན་ ལ་␣ས་ གཞན་ གྱིས་ མི་ ཕན་པ་␣ས་"
msgstr "Apart from this, others will not help."

msgctxt "94f3cb8d8eff4be1b805428354a26cfc"
msgid "གེགས་ སེལ་ ཁྱད་འཕགས་ ཡང་ འདི་ ཡིན་ ནོ །"
msgstr "This is also a marvelous elimination of obstructions. "

msgctxt "12209c27a8164953b57b889bf5df8e2c"
msgid "རྡོ་␣༽༽  གང་ ལ་ གནོད་པ་ བྱས་ ཀྱང་ བདེ་ འབྲེལ་བ་ ཞེས་པ་␣ས་"
msgstr ""
"Vajra: It is said that though one causes harm to another, one can still be "
"connected to happiness."

msgctxt "0406a32b70a441898a810a2c6b644647"
msgid "བྱང་སེམས་ ལ་ གནོད་པ་ བྱས་པ་␣འི་ ཕྲིན་ལས་ འཇུག་ ཏེ་"
msgstr ""
"Harming bodhisattvas is an engagement in the enlightened activity because "

msgctxt "47d3bb76f34f45258a4ee04482745d04"
msgid "བདེ་བ་␣ར་ འབྲེལ་བ་ ཡིན་ ཟེར་ མོད །"
msgstr "it is connected to happiness. As [they] said this."

msgctxt "b4b0588b773843a9a573f7c233e0216f"
msgid "དེ་ ཆོས་ཅན་"
msgstr "Take this as the subject."

msgctxt "1b76c66a004649c0ad5eb81cf254106b"
msgid ""
"སེམས་དཔ་␣ར་ རྒྱུ་ གནོད་ བྱས་པ་␣འི་ འབྲས་བུ་ བདེ་བ་␣ར་ མ་ འབྲེལ་ ཞིང་ "
"མི་རིགས་པ་␣ར་ ཐལ །"
msgstr ""
"The cause, harming bodhisattvas is not connected happiness, thus it follows "
"illogically. "

msgctxt "f82ba00441a548c79317135a11d1c332"
msgid ""
"ཞེ་སྡང་ གིས་ ཀུན་ ནས་ བསླང་པ་ དེ་ སྡུག་བསྔལ་ གྱི་ ས་བོན་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr "Because that which is motivated by aversion is the seed of suffering."

msgctxt "772d4e4214a64882a538dc596d3ce196"
msgid "དཔེར་ན་ དྲུག་ གི་ ས་བོན་ འབྲས་བུ་ བཞིན་ ནོ ། །"
msgstr "For example, the results from the seeds of the six."

msgctxt "4ac22f1af88b47b4ad0ff46c287d9200"
msgid "དེ་སྐད་ དུའང་ སངས་རྒྱས་ མི་ སྤོང་བ་␣འི་ མདོ་ ལ་␣ས །"
msgstr "As it is also said in the Sutra of Not Forsaking the Buddha:"

msgctxt "9afb3d40c4634802ae379a3cd0bf6114"
msgid "སེམས་ཅན་ ཐམས་ཅད་ ཀྱི་ མིག་ ཕྱུང་བ་ བས་ ཀྱང་"
msgstr "Even if all sentient beings had their eyes extracted,"

msgctxt "c5f31cc45cfe4d7ba5363eb5cfb3779f"
msgid "སེམས་ ལ་ གཤེ་བ་ ཉེས་པ་ ཆེ་␣འོ ། །"
msgstr "Mental abuse is a great fault."

msgctxt "4076c3b5ca0343d09f22bda888fc0d4d"
msgid "ཞེས་པ་ དང་ །"
msgstr "And"

msgctxt "48c019a250b6482d8a9392abbc56c0af"
msgid "བུ་མོ་ ཡེ་ཤེས་ ལྡན་ གྱིས་ ཞུས་པ་␣ར །"
msgstr "In response to the young woman Yeshe Den's question."

msgctxt "a1f3217fcb934b418084a34b324863f3"
msgid "གཅིག་ ལ་ གཅིག་ གིས་ གནོད་སེམས་ བྱས་པ་ ན །"
msgstr "When people harbor ill will against one another, "

msgctxt "21de3e3c57664daa8fadfbf24753a73b"
msgid "སྦྱིན་པ་␣ས་ མི་ སྐྱོབ་ ཚུལ་ཁྲིམས་ མི་ སྐྱོབ་ སྟེ །"
msgstr ""
"Generosity will not protect, and moral discipline will not protect because"

msgctxt "412799a41f9244e6b5a1b41486b15337"
msgid "བསམ་གཏན་ མི་ སྐྱོབ་ སངས་རྒྱས་ མཆོད་པ་␣ས་ མིན །"
msgstr ""
"meditative absorption will not protect and offerings to the buddhas will "
"not. "

msgctxt "54533a9655104265ba2da3b178629f5e"
msgid "ཞེས་ དང༌ །"
msgstr "And"

msgctxt "e78f14c4bda340118e8ae076f7414e47"
msgid "སྤྱོད་འཇུག་ ལ་␣ས །"
msgstr "According to the Engaging in the Bodhisattva's Conduct:"

msgctxt "bbb0f15f67c44f57a885ef66abe3d1c4"
msgid "གང་ཞིག་ དེ་ འདྲ་␣འི་ རྒྱལ་སྲས་ སོགས་ དང་ །"
msgstr ""
"Whoever [has a bad intent against a benefactor] such as a Bodhisattva. And "
"so forth."

msgctxt "37bb7e26de2e41e38c62157e9d53a244"
msgid "དབུ་ འཇུག་ ལ་␣ས །"
msgstr "According to the Entrance to the Middle Way:"

msgctxt "bf6a8f194b28439493465f8915d1d372"
msgid "གང་ ཕྱིར་ རྒྱལ་སྲས་ རྣམས་ ལ་སོགས །"
msgstr "Therefore, [anger towards] the sons of the conqueror. And so forth."

msgctxt "4aceaba6eacd4b17a18409cbef7b455c"
msgid "བདེ་བ་ འབྲེལ་ ཞེས་པ་"
msgstr "It is said that it will be connected to happiness. "

msgctxt "fa30cd25a4084dc0b16915f3f753507e"
msgid ""
"འབྲས་བུ་ ཡ་ ཟུང་ ཞིག་ གནས་སྐབས་ ལན་ མི་ ལྡོག་པ་␣ས་ བརྩེ་བ་␣ར་ སྐྱོང་བ་␣ས་ "
"ཡིན་ ནོ །"
msgstr ""
"A part of the result is not returned temporarily, thus, it is protected with"
" affection."

msgctxt "991db81dcda34121a5d27ebf06998205"
msgid "རྡོ་␣༽༽  འཕེན་ རྫོགས་ མུ་བཞི་ ལ་␣ས་"
msgstr "Vajra: From the four possibilities of propelling and completing."

msgctxt "184dca5344744bd8a80c232557577c99"
msgid ""
"འཕེན་ བྱེད་ དགེ་སྡིག་ དང་ དགེ་བ་ སྟེ་ རྒྱུ་འབྲས་ ཐ་དད་ དུ་ འདོད་པ་ དེ་ "
"ཆོས་ཅན །"
msgstr ""
"The propelling virtue and negative actions, and regarding virtue, it is "
"accepted that its cause and effect are distinct. Take that as the subject."

msgctxt "ed39a4a859a04462a37639d5be7273ff"
msgid "མི་ སྲིད་པ་␣ར་ ཐལ །"
msgstr "It follows that it is impossible."

msgctxt "f1962a3b5c994fa5ad1cbfcbc59e5f03"
msgid ""
"དགེ་བ་བ་ དང་ མི་དགེ་བ་␣འི་ འབྲས་བུ་ སོ་སོ་␣ར་ འབྱུང་བ་ གནས་ དང་ གནས་མིན་ "
"མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ ཀྱིས་ གཟིགས་པ་␣འི་ ཕྱིར །"
msgstr ""
"This is because the primordial wisdom of knowing sees the individual "
"occurrence of virtuous and non-virtuous effects, as well as [what is] "
"appropriate and [what is] inappropriate."

msgctxt "01f41a85b6a847d1837fa434c30f2318"
msgid "ས་བོན་ སོ་སོ་ ལས་འབྲས་ བུ་ སོ་སོ་ འབྱུང་བ་ བཞིན་ ནོ ། །"
msgstr "In the same way that individual fruits arise from individual seeds."

msgctxt "d58cb78922724e9086b506df97acff1b"
msgid "དེ་བས་ན་ འཕེན་ བྱེད་ དགེ་བ་␣འི་ ཚོགས་ རྫོགས་བྱེད་ ཀྱང་ དགེ་བ །"
msgstr ""
"Therefore, the propelling [cause] is an accumulation of virtue and the "
"completing [result] is also virtue."

msgctxt "7113f4bbe5ba431a9c172f533f931370"
msgid "འཕེན་ བྱེད་ མི་དགེ་ ཡིན་ ན་ རྫོགས་བྱེད་ ཀྱང་ མི་དགེ་བ་␣ས་ རྫོགས་ ཏེ་"
msgstr ""
"When the propelling [cause] is non-virtuous, then the completing [result] is"
" also completed with non-virtues. "

msgctxt "cf0b735eac5447a89ce80d0cd11a5519"
msgid ""
"རྒྱུ་ དགེ་སྡིག་ གཉིས་ ལས་འབྲས་ བུ་ བདེ་ སྔུག་ སོ་སོ་␣ར་ འབྱུང་བ་ ཡིན་ ནོ །"
msgstr ""
"From the two virtuous and negative causes, the results of happiness and "
"suffering occur individually."

msgctxt "c3adc9d747c74809bce205a033e7ab35"
msgid "ལེགས་ སྐར་ དང་ མ་སྐྱེས་དགྲ་ ཡང་ རྒྱུ་ འཕེན་ བྱེད་ དང་པོ་ དད་གུས་ དང་ །"
msgstr ""
"Sunaksatra and Ajashatru as well, the propelling causes are first faith and "
"devotion, and "

msgctxt "3f0feb27231c4dd19248780a74fd1edc"
msgid ""
"མཚམས་མེད་ བྱས་པ་␣ས་ རྫོགས་བྱེད་ འབྲས་བུ་ ལེགས་ སྐར་ རེ་ཞིག་ ན་ ཐར་པ་ "
"ཐོབ་པ་␣ར་ གསུངས་པ་ དང༌ །"
msgstr ""
"The completing results of committing the crimes of immediate retribution, "
"though it is said that Sunaksatra for a short time would attain emancipation"
" and "

msgctxt "873514312b6b4bf9ac4a95af0f168ef1"
msgid "མ་སྐྱེས་དགྲ་ འབྲུམ་བུ་ མེ་དབལ་ ཐེབས་པ་ དང་"
msgstr "Ajashatru was struck by erysipelas and"

msgctxt "e176d413d49c40f4b17ae08167160c06"
msgid "ཚེ་ འཕོས་ ནས་ དམྱལ་བ་␣ར་ དར་ཅིག་ སྐྱེས་པ་␣ར་ གསུངས་པ་ བཞིན་ ནོ །"
msgstr ""
"It is said that after he passed away and was reborn for a short while in "
"hell."

msgctxt "edc183802eb347f1973ca3ced7ca344f"
msgid "རྡོ་␣༽༽  གཞན་དག་ ན་རེ་"
msgstr "Vajra: Others said,"

msgctxt "4221fdfc2dde46dda45273360bfd7f4e"
msgid "སེམས་ཅན་ བློ་␣ས་ གཏོང་ ཕན་ཡོན་ མི་ དྲན །"
msgstr "Sentient beings are forsaken, not remembering the benefits."

msgctxt "d625cbafb5e0497ca0190632fe784a6d"
msgid "ཚོགས་ གཉིས་ མི་ བསགས །"
msgstr "Does not collect the two accumulations."

msgctxt "4c9da2432b9e465ebe184f6c893c8eba"
msgid "སྦྱོང་ ལ་ མི་ བརྩོན་པ །"
msgstr "Not putting effort into the training."

msgctxt "78a4462470dd4792b67608108cf15820"
msgid ""
"ནག་པོ་␣འི་ ཆོས་ བཞི་ དང་ ཕམ་ འདྲ་␣འི་ ཉེས་པ་ གང་རུང་ གཅིག་ གིས་ བྱང་ཆུབ་ "
"ཀྱི་ སེམས་ འཆོར་བ་␣ར་ འདོད་ མོད །"
msgstr ""
"It is accepted that one loses bodhicitta through one of the four black "
"dharmas or the faults of one of the [four] defeats."

msgctxt "dca4ffbbee354311a154ae573598dbb3"
msgid ""
"འདི་␣ར་ བྱང་ཆུབ་ ཀྱི་ སེམས་ ནི་ བརྗེད་པ་␣ར་ གྱུར་པ་ ལ་␣ས་ འཆོར་བ་␣ར་ མ་ "
"གསུངས་ ཏེ་"
msgstr ""
"In this [system], it is stated that one forgets but does not lose "
"bodhicitta."

msgctxt "10b894425df5450da8ff6500cb61f9d2"
msgid "བསོད་ནམས་ ཐམས་ཅད་ སྡུད་པ་"
msgstr "It draws together all merit. "

msgctxt "9f0719a213514562a7eed25238fc3654"
msgid "ཏིང་ངེ་འཛིན་ གྱི་ མདོ་ ལ་␣ས་"
msgstr "According to The Sutra of Meditative Concentration:"

msgctxt "9d42e2ad14584348b1d46ac214473b5a"
msgid ""
"ལི་ ཙཱ་ བི་ དྲི་མ་ མེད་པ་ འདི་ སྔོན་ འཁོར་བ་ འཇིག་ གི་ བསྟན་པ་␣ར་ "
"སེམས་བསྐྱེད་ ཀྱང་"
msgstr ""
"Though Litsavi Vimala generated the mind of awakening during the time of "
"Krakucchandha"

msgctxt "f99efcb984e64add9edaeed89d96ea2e"
msgid "ནག་པོ་␣འི་ ཆོས་ བཞི་ སྤྱད་པ་␣ས་"
msgstr "By engaging in the four black dharmas."

msgctxt "39e5ee70b5ff4d4790cde8af20d35aca"
msgid "ད་བར་ བརྗེད་པ་␣ར་ འགྱུར་ ལ་ དེ་␣འི་ ཚེ་ སེམས་བསྐྱེད་པ་␣ས་"
msgstr ""
"[He] has forgotten until now, generated the mind of awakening at that time."

msgctxt "2afee9d09b434a07950a571f1e1c2f1c"
msgid "ངས་ ད་ལྟ་ ལུང་བསྟན་པ་ ཡིན་ ནོ་ ཞེས་ དང༌ །"
msgstr "I have prophesied now and."

msgctxt "58f5f81eaf8b4b1a9b4413ad4bc904b9"
msgid "དཀོན་ བརྩེགས་ སྡོང་ རྒྱན་ སོགས་ ལ་␣ས་ ཀྱང་"
msgstr ""
"According to the Heap of Jewels, The Supreme Stem Ornament, and so forth:"

msgctxt "0e800d68d958442dafedb0f1ae2e0afd"
msgid "བརྗེད་ ལ་␣ས་ འཆོར་བ་␣ར་ མ་ གསུངས་ སོ །"
msgstr "It is said that it has been forgotten but is not lost."

msgctxt "94792f9f19c342cca75709785ce38927"
msgid ""
"དེས་ན་ ཕལ་ ལ་␣ས་ རྡོ་རྗེ་ ཕ་ལམ་ དང་ འདྲ་བ་␣འི་ སེམས་ འདི་ ལུག་ར་ དང་ "
"འདྲ་བ་␣འི་ ལོག་ལྟ་ མ་གཏོགས་"
msgstr ""
"Thus, according to the Extensive [Sutra]: The diamond-like mind, except from"
" the wrong views like sheep and goats,"

msgctxt "70b43c29837245089a295dca557da2f6"
msgid "གཞན་ གྱིས་ མིའཆོར་ བར་ གསུངས་ ཤིང་"
msgstr "It is said that others will not lose it."

msgctxt "22e0a1b5c894496c8d68ec99f1bb2fcb"
msgid ""
"དེ་␣ར་ མ་ཟད་ སངས་རྒྱས་ ལ་ དགེ་རྩ་ ཅུང་ཟད་ རེ་ བསྐྱེད་པ་␣འང་ ཆུད་ མི་ ཟ་བ་ "
"དང་"
msgstr ""
"Not only that but even a small portion of the roots of virtue aroused in the"
" Buddha will not be wasted."

msgctxt "831408d3d71d4633b422c9636034a12e"
msgid "གཤེགས་ སྙིང་ རྟག་ བརྟན་ དུ་ཡོད་པ་␣ས་ དབང་ བྱས་པ་ དང༌ །"
msgstr ""
"Because the sugatagarbha is eternal and firmly present, it empowers and "

msgctxt "9a1ae26dbcde4f0abb12f0cec8e14f06"
msgid ""
"ཅི་རིགས་ ཀྱི་ འཇུག་ སྡོམ་ དུ་ འགྱུར་བ་␣འི་ ཕྱིར་ འཆོར་བ་ ནི་ མི་ སྲིད་ དོ །"
msgstr ""
"becomes any of the vows of engaging the mind. Therefore, it is impossible to"
" be lost."

msgctxt "303aa845cb1a4dd0b600c7800c15ccc2"
msgid ""
"རྡོ་␣༽༽  ཉོན་ ཤེས་ སྙོམ་ འཇུག་ གམ་ ལ་␣ས་ ཉོན་ ཤེས་སྒྲིབ་ གསུམ་པོ་ རིམ་བཞིན་ "
"མཐོང་ལམ་ དང་"
msgstr ""
"Vajra: It is said that the afflicted mind consciousness and equilibration or"
" karma, afflictive and knowable obscuration, these three are abandoned "
"progressively on the path of seeing and "

msgctxt "298370612a984489a413dea1febcb730"
msgid "བདུན་པ་ རིང་ དུ་ སོང་བ་ མན་ དང་ །"
msgstr "Till the seventh level, the Far-going [level] and"

msgctxt "1c0062292c5244cb83624f4534d8a9e0"
msgid "ས་བཅུ་␣འི་ རྒྱུན་མཐ་␣ར་ སོ་སོ་␣ར་ སྤོང་ ཟེར་ མོད །"
msgstr ""
"[They] are abandoned individually at the end of the continuum of the tenth "
"level."

msgctxt "f5b4d57219a34f85b15d68e4bf9d7815"
msgid ""
"འདི་␣ར་ ནི་ སྤང་བྱ་ གཅིག་ ལ་ རག་ ཕྲ་␣འམ་ ཆེ་ འབྲིང་ ཆུང་ གསུམ་ མངོན་རྟོགས་ "
"ཡོད་མེད་ ཀྱིས་"
msgstr ""
"In this [system], in a single object of abandonment, there are subtle and "
"coarse, or because of the existence or absence of the greater, middling, and"
" lesser manifest realizations."

msgctxt "67b3b62d1be24d448b9c2e769079baaf"
msgid "སོ་སོ་␣འི་ རྒྱུད་ ལ་ རག་པ་ རྟོགས་ལྡན་ ལ་ ཡོད་པ་ ཕྲ་བ་␣ར་ བཏགས་པ་ སྟེ་"
msgstr ""
"in an individual's continuum. In the realized individual, the coarse is "
"designated as subtle."

msgctxt "941efcb4cd6846df89616e6cdf4b04b4"
msgid "ཤེས་སྒྲིབ་ ཀྱང་ ཉོན་མོངས་ དུག་ གསུམ་ ཁོ་ན་ ཡིན་པ་"
msgstr ""
"The obscurations to knowables are exclusively the three poisonous "
"afflictions as it is mentioned in the "

msgctxt "496b8632c33a4908b3500232dfa3f6f9"
msgid "རྒྱ་ རོལ་ ལ་␣ས །"
msgstr "According to The Play in Full [sutra]:"

msgctxt "f6fbb99c9abe43bb89760d66eeb5d6b9"
msgid "སངས་རྒྱས་ ན་ བདུན་ ཕྲག་ གཅིག་ ལོན་པ་ ན །"
msgstr "When one week has passed after [I] have attained enlightenment,"

msgctxt "a4f223a15533400c9f54a7a3e8816797"
msgid "གཏི་མུག་ འབྱུང་བ་ འདོད་ དང་ ཁྲོ ། །"
msgstr "The arising delusion, desire, and anger, "

msgctxt "0d3c9b2d72734e35a0fb86f892c089f0"
msgid "དེ་དག་ འགྲོ་བ་␣འི་ དགྲ་ འདྲ་ སྟེ ། །"
msgstr "These are like the foes of living beings."

msgctxt "dddb796831db4d8e97debf0cfb58be83"
msgid "དེ་དག་ མ་ ལུས་ ངས་ འདི་␣ར་ བཤིག ། །"
msgstr "I have destroyed them completely here."

msgctxt "6940d85191fc49f58d977ecea19f098c"
msgid "ཅེས་ དང༌ །"
msgstr "And."

msgctxt "522b0d02880542ea9ed14edb54e5b0d8"
msgid "དཀོན་མཆོག་ སྤྲིན་ ལ་␣ས །"
msgstr "According to the Cloud of Jewels Sutra:"

msgctxt "11d11a8a42284afc8d74b5e7ef85181d"
msgid "བྱང་ཆུང་ སྙིང་པོ་␣ར་ བཞུགས་པ་ ན ། །"
msgstr "When [you] reside in the essence of enlightenment,"

msgctxt "17eb476306854234be2be51b992ad6ff"
msgid "འདོད་ཆགས་ ཞེ་སྡང་ གཏི་མུག་ དང་ ། །"
msgstr "Attachment, aversion, delusion and"

msgctxt "724ca26136534895b0e2e6e1b78e81cc"
msgid "དྲི་མ་ གཞན་ སྤོང་ རྣམ་ མང་པོ ། །"
msgstr "Many other stains are abandoned. "

msgctxt "883bd9042d064a90985e02c71dae884b"
msgid "ཁྱོད་ ཀྱི་ ཡེ་ཤེས་ མེ་ ཡིས་ བསྲེག  །"
msgstr "[They] are burned by the fire of your wisdom."

msgctxt "f9c5ad005e4a474fbaaccd0b298f487d"
msgid "ཅེས་ གསུངས་པ་␣ས་ དེ་␣འི་ ཕྱིར་"
msgstr "As it is said."

msgctxt "33a6ea4119f946c3a7c482892bea913f"
msgid "སྒྲིབ་པ་ རྣམ་ གསུམ་ ཉོན་མོངས་ སྒྲིབ་པ་␣ར་ གཅིག་པ་ ཡིན་ ནོ །"
msgstr ""
"The three kinds of obscuration are the same in terms of being afflictive "
"obscuration."

msgctxt "ac9f1701a71247c89f01c9a6db33b597"
msgid "རྡོ་␣༽༽  གཞན་དག་ ན་རེ །"
msgstr "Vajra: Others said,"

msgctxt "816eb6badfed42aa9b1ce318aa93fb22"
msgid ""
"ཆོས་ཉིད་ ཀྱི་ བདེན་པ་ ནི་ མུ་སྟེགས་ བྱེད་ ནས་ ཨ་ ཏི་ ཡོ་ག་␣འི་ བར་ དུ་ "
"གོང་མ་␣ས་ འོག་མ་ བཀག་ ནས་ རྟོགས་ པ་␣ར་ འདོད་པ་ དེ་ ཆོས་ཅན །"
msgstr ""
"Take the subject, the acceptance of the truth of the true nature of "
"phenomena as the realization by refuting the lower by the higher from "
"becoming tirthikas to the atiyoga. "

msgctxt "88170b7d092642a0a4e7e42b2e715dc1"
msgid "ཆོས་ཉིད་ མི་ རྟོགས་པ་␣ར་ ཐལ །"
msgstr "It follows that the true nature of phenomena is not realized. "

msgctxt "f33fe4bcf42c4521acb8999331a0af40"
msgid "བློ་␣ས་ བྱས་པ་ དང་ གཞལ་བྱ་ ཚད་མ་␣ར་ གྱུར་པ་␣འི་ ཕྱིར །"
msgstr ""
"Because products and the object of comprehension, become valid cognitions of"
" the mind."

msgctxt "d418f8cedc19428ca4131f782c90714d"
msgid "གྲུབ་མཐའ་ ཐམས་ཅད་ ལྟ་བ་ དང་ བློ་ ཡིན །"
msgstr "All philosophical systems are views and rational minds."

msgctxt "924d6f9f5bc84b5086dc01136079da54"
msgid "དེ་␣ས་ དོན་དམ་ ལ་ མི་ རིག་པ་ སྤྱོད་འཇུག་ ལ་␣ས །"
msgstr ""
"They do not see the absolute [truth] as the Engaging in the Bodhisattva's "
"Conduct says:"

msgctxt "3cde01f4024642f0a7cd10f67eab964e"
msgid "དོན་དམ་ བློ་ ཡི་ སྤྱོད་ཡུལ་ མིན །"
msgstr "The absolute [truth] is beyond the reach of the mind."

msgctxt "5d55e52de396460590312722ca73b55f"
msgid "སོགས་ དང་ །"
msgstr "And so forth."

msgctxt "c7b01556393244f7b9fb0d9dc7d35dec"
msgid "རྩ་ཤེ་␣ར་ ལ་␣ས །"
msgstr "According to the Root Stanzas of the Middle Way:"

msgctxt "daf0f0c00bc04f20abf6a59b889f35f2"
msgid "གང་ གི་ ཐུགས་ བརྩེས་ ཉེར་ བཟུང་ ནས །"
msgstr "Held by great compassion."

msgctxt "321b12c48de243eb86fcda533e811e59"
msgid "སོགས་ དང་ །"
msgstr "And so forth."

msgctxt "535d180f5b694ea0b091b597519799c8"
msgid "སྡུད་པ་ ལ་␣ས །"
msgstr "According to the Condensed [Prajnaparamita In Verse]:"

msgctxt "a700af76f54f4a3c9437eed5bcf21356"
msgid "ཇི་ལྟར་ འཛིན་པ་ དེ་ལྟར་ ཀུན་ ནས་ ཉོན་མོངས་ བསྟན །"
msgstr "The total affliction is taught in the way in which it is grasped. "

msgctxt "d3b8b586eb9545cc9ebd0aa354c4292a"
msgid "བདག་ དང་ བདག་ གིར་ མི་ དམིགས་"
msgstr "Without observing I and mine,"

msgctxt "6edadddae8a64069b759f398fad60b83"
msgid "རྣམ་པ་␣ར་ བྱང་བ་␣ར་ གསུངས་ ཞེས་ དང༌ །"
msgstr "Complete purification. As it is said and"

msgctxt "64d2d3d50841406d8dafced2cfa9dc09"
msgid "རྣམ་འགྲེལ་ ལ་␣ས །"
msgstr "According to the Full Commentary to [the Compendium of Pramana]:"

msgctxt "55d6f33c056d4fa88a5f1833a995f71a"
msgid "བདག་ ཡོད་ ན་ ནི་ སོགས །"
msgstr "When there is self, [there is also a sense of other.] and so forth."

msgctxt "808061c71e8a4428a409a0a01a17a5c5"
msgid "ཞེས་ གསུངས་པ་␣ས །"
msgstr "As it is said."

msgctxt "5b3638c8b6e74f749eb7823242ffbfbc"
msgid ""
"ཇི་སྙེད་ གྲུབ་པ་␣འི་ མཐ་␣ས་ དོན་དམ་པ་␣འི་ བདེན་པ་ མཐོང་བ་␣ར་ བསྒྲིབས་པ་ ཡིན་"
" ནོ །"
msgstr "All philosophical systems obscure seeing the absolute truth."

msgctxt "3dcbf125b2e444258ef906093026f9c7"
msgid "རྡོ་␣༽༽  ཉན་ཐོས་ ཀྱིས་ བདག་མེད་ མཐོང་བ་ མེད་པ་␣ར་ འདོད་པ་ དང༌ །"
msgstr ""
"Vajra: There are two acceptances that shravakas do not see selflessness and "

msgctxt "891d9041e8244f55911b1bec9e76fade"
msgid "ཡོངས་རྫོགས་ རྟོགས་པ་␣ར་ འདོད་པ་ གཉིས་ སུ་ བྱུང་ ཞིང༌ །"
msgstr "another acceptance is that [they] realize completely."

msgctxt "a390c4e3fb2140fbad73a218e6c3c288"
msgid "དེ་ཡང་ ཆ་མེད་ དོན་དམ་པ་␣ར་ ཕྱོགས་ཆ་ དང་"
msgstr ""
"Moreover, it is said that the partless absolute is་[undermined] by "
"directional parts and "

msgctxt "be9f839ac33e4e279bae597fb5cc9789"
msgid "སྐད་ཅིག་ གིས་ གནོད་པ་␣ས་ བདེན་པ་ མཐོང་བ་ མིན་ ནོ་ ཞེས་ ཟེར་ རོ །"
msgstr "momentariness, thus the truth will not be seen."

msgctxt "2ca3ccd4e820489bba6f8421c54c46c7"
msgid ""
"འདི་␣ར་ ནི་ ཉན་ཐོས་ ཀྱིས་ ཀྱང་ གནས་ལུགས་ ཕྱོགས་ གཅིག་ མཐོང་བ་ ཡོད་ དེ །"
msgstr "In this [system], even the shravakas have seen a side of actuality."

msgctxt "407d422fd80f4a519b6598ba1fd02209"
msgid "གནས་ལུགས་ རྟོགས་པ་␣འི་ ཤེས་རབ་ མེད་ ན་"
msgstr "Because if [they] have no wisdom that realizes the actuality,"

msgctxt "90d23c24fd9c4e0aa75ddd3b54163b25"
msgid "འཁོར་བ་ ལས་མི་ འདའ་བ་␣འི་ ཕྱིར །"
msgstr "[They] will not transcend samsara."

msgctxt "a59715e9fb444e14a49b5c501bcb7a5e"
msgid "དཔེར་ན་ ཕྱི་རོལ་པ་ བཞིན་ ནོ ། །"
msgstr "For example, like non-Buddhists. "

msgctxt "3ce6d46404ba48fead12d5bcfcd0a950"
msgid "དེ་ལྟར་ ཡང་ འཕགས་པ་ ས་བཅུ་པ་ ལ་␣ས །"
msgstr "Likewise, in the Ten Levels, Arya said:"

msgctxt "8674e5cbd63a40cf9fcda1440de0cc0c"
msgid ""
"བདུན་པ་ རིང་ དུ་ སོང་བ་ བློ་␣ས་ ཟིལ་ གྱི་ མནན་པ་␣ར་ གསུངས་པ་␣འང་ འདི་␣འི་ "
"ཤེས་བྱེད་ དུ་ གསལ་ ལོ་␣༑། །"
msgstr ""
"The statement that the seventh bhumi, the Far-going [level], is surpassed by"
" the mind is also a clear scriptural source of this."

msgctxt "ec8bffb4c9f94bcea0284d87d4eba7e1"
msgid ""
"དེ་ལྟར་ མིན་ ན་ ས་ དང་པོ་པ་␣འི་ བློ་␣ས་ ཟིལ་ གྱིས་ གནོན་པ་␣ར་ འགྱུར་ ཏེ །"
msgstr ""
"If this were not the case, the minds of the first level would have surpassed"
" them."

msgctxt "da0b7e2a49074cf59e5e1c795b4af4cf"
msgid "ཉན་ཐོས་ དག་ ལ་ མེད་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "Because shravakas do not possess it and "

msgctxt "9599aca053324ae78ccbbb48df4c4d58"
msgid "བྱང་སེམས་ རྣམས་ ལ་ ཡོད་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Because bodhisattvas do possess it."

msgctxt "dbbeff1519954ba5a31014cb64559b81"
msgid "སློབ་དཔོན་ གྱིས་ ཀྱང་ །"
msgstr "And the master says:"

msgctxt "f09bc63897ca4f6b96ff5a42afc67e71"
msgid "ཐེག་ཆེན་ ལ་ ནི་ སྐྱེ་ མེད་ བསྟན ། །"
msgstr "The absence of arising is taught to the Greater Vehicle. "

msgctxt "64216521f37d4c949758632f7a2cd3e4"
msgid "གཞན་ གྱི་ ཟད་པ་ སྟོང་པ་ཉིད ། །"
msgstr "The exhaustion of others is emptiness."

msgctxt "b3815e5124f641249f4fbcbf8cbfbce4"
msgid "ཟད་ དང་ མི་ སྐྱེ་ དོན་ དུ་ ནི ། །"
msgstr "Since exhaustion and non-arising are "

msgctxt "c405862d7742460da7aacac398b69130"
msgid "གཅིག་པ་ དེ་ཕྱིར་ བཟོད་པ་␣ར་ གྱིས །"
msgstr "The same, because of that, be patient."

msgctxt "b15ab9602d8641d8bed82f28de8dd694"
msgid "ཞེས་ དང་ །"
msgstr "And"

msgctxt "6f9b8e9a742b4ddbb0b22bba29833a0a"
msgid "བཅོམ་ལྡན་ དངོས་ དང་ དངོས་མེད་པ ། །"
msgstr "The Blessed One is a thing and a non-thing."

msgctxt "d864dfe459b54995bdbd6154a4f53eec"
msgid "མཁྱེན་པ་␣འི་ སོགས་ གསུངས་པ་ ཡིན་ ནོ ། །"
msgstr "The knowing of and so forth is said."

msgctxt "09b70abbe36f4343a7aad6da8fa78d00"
msgid "ཡོངས་སུ་ རྫོགས་པ་␣འང་ མིན་ ཏེ །"
msgstr "It is not completely perfect, because"

msgctxt "ae0e9d92e54a41189c22e663f012adff"
msgid "ཐེག་པ་ ཆེ་ཆུང་ གི་ ལམ་ དང་"
msgstr "The Greater and Lesser Vehicles' paths and "

msgctxt "729d753566c9473aa4ba2ecb018fa48e"
msgid "འབྲས་བུ་ ཡོན་ཏན་ རྒྱ་མཚོ་ དང་"
msgstr "results, their qualities are [said to be different] like oceans and "

msgctxt "e2c6a782e76d47f1886591a910c921a0"
msgid "རྨིག་ རྗེས་ ཀྱི་ ཆུ་␣འམ་ ནམ་མཁའ་ དང་"
msgstr "The water in a hoofprint, or the sky and "

msgctxt "9d6b726dc44a4c23b2e4235145360af8"
msgid ""
"ཡུངས་འབྲུ་ སྲིན་ གྱིས་ ཟོས་པ་␣འི་ ནང་ གི་ མཁའ་ ལྟར་ ཁྱད་ ཡོད་པ་␣ར་ "
"གསུངས་པ་␣འི་ ཕྱིར་ རོ །"
msgstr "The space inside a mustard seed eaten by a worm."

msgctxt "5bc7fed0c71d464c848459ed93858515"
msgid "རྡོ་␣༽༽  ཐེག་པ་ ཆེ་ཆུང་ གཉིས་ ལ་␣ས་ ཆུང་ངུ་ ནི་ ཤིན་ཏུ་ དམན་ ཏེ་"
msgstr ""
"Vajra: Of the two, the Greater and Lesser Vehicles, the Lesser Vehicle is "
"the utmost inferior."

msgctxt "361617d651e74d7a890679568d0c8562"
msgid "ཐེག་ བསྡུས་ ལ་␣ས །"
msgstr "According to A Summary of the Mahayana:"

msgctxt "9caa9b7429d3466f888860fe38b2bbf6"
msgid "དམྱལ་བ་␣ར་ འགྲོ་བ་ སངས་རྒྱས་ ལ ། །"
msgstr "In hell, migrators awaken to buddhahood."

msgctxt "2e420744c7724ae09bba5a56dd4d4602"
msgid "གཏན་ གྱི་ གེགས་བྱེད་ མ་ ཡིན་ ཏེ ། །"
msgstr "Thus, it is not a perpetual obstacle."

msgctxt "5c5f40c708474354a18c30570ea46b5d"
msgid "ཉན་ཐོས་ དང་ ནི་ རང་ སངས་རྒྱས ། །"
msgstr "Shravakas and pratyekabuddhas"

msgctxt "75cd7d03de744fbca7f65a5cd64ac8cf"
msgid "ས་ གཉིས་ དག་ ནི་ གཏན་ གྱི་ གེགས །"
msgstr "These two levels are perpetual obstacles. "

msgctxt "3d546f09d1be4beb900f53c8299475b8"
msgid "ཞེས་པ་␣ས་ ས་ དང་པོ་␣འི་ བདེན་པ་ མ་ མཐོང་བ་␣ས་ དམན་ ནོ་ ཟེར །"
msgstr ""
"Thus, it is said that [they] are inferior since [they] do not see the truth "
"of the first level."

msgctxt "12cf41c230834c75913203c8768b900d"
msgid ""
"འདི་␣ར་ ནི་ ས་ དྲུག་པ་ མན་ཆད་ ཀྱི་ མངོན་རྟོགས་ དེ་ ཉན་རང་ དང་ ཐུན་མོང་བ་ "
"ཡིན་ ཏེ་"
msgstr ""
"In this [system], the paths up to the sixth level are common to shravakas "
"and pratyekabuddhas."

msgctxt "640fb7e15f7a42588bba29ba3230d7e2"
msgid "ས་བཅུ་པ་␣འི་ མདོ་ ལ་␣ས །"
msgstr "According to the Sutra of the Tenth Level: "

msgctxt "5a89d76ed74741d684d5064e529ffb1c"
msgid "ས་ ལྔ་པ་␣ས་ བདེན་ བཞི་ རྟོགས་པ་␣ར་ གསུངས་ ཤིང་"
msgstr "It is said that [those] on the fifth ground realize the four truths."

msgctxt "b182f765176b4c3688e8993b1ef48a27"
msgid ""
"གསུངས་ རབ་ ཐམས་ཅད་ ནས་ ཉན་ཐོས་ ཀྱིས་ ཀྱང་ དེ་ རྟོགས་པ་␣ར་ གསུངས་པ་␣འི་ ཕྱིར "
"།"
msgstr "All the scriptures state that even shravakas can realize this."

msgctxt "b56547473b254451a20b0fcd3aa120b5"
msgid "ས་ དྲུག་པ་␣ས་ རྟེན་འབྲེལ་ བཅུ་གཉིས་ རྟོགས་པ་␣ར་ གསུངས་པ་ དང་"
msgstr ""
"The statement that the [bodhisattvas] at the sixth level realize the twelve "
"links of dependent relationship and "

msgctxt "d5878446641847cbac0f3899d369438e"
msgid ""
"རང་ སངས་རྒྱས་ ཀྱིས་ ཀྱང་ དེ་ རྟོགས་པ་␣ར་ གསུངས་པ་ གཉིས་ མཉམ་པ་␣འི་ ཕྱིར །"
msgstr ""
"The statement that pratyekabuddhas also realize them, both are similar."

msgctxt "118290967cba47eca3355edc3e9cb202"
msgid "དཔེར་ན །"
msgstr "For example:"

msgctxt "1b3a4ad98f504b26b6eb65b5e8a83db6"
msgid "རྒྱལ་བློན་ གྱི་ བུ་ གཉིས་ ལོ་ གྲངས་ མཉམ་པ་ བཞིན་ ནོ ། །"
msgstr "It is as if the sons of a king and a minister are of the same age."

msgctxt "f2911d98d7da475aa8028fe4d0d49571"
msgid "ཡོན་ཏན་ མཉས་ མམ་ ཞེ་ན་ མི་ མཉམ་ སྟེ །"
msgstr ""
"If one wonders if [they] have equal qualities, [it] is not the same, because"

msgctxt "67482ee5680b4592a2c2ad5a41b8aab3"
msgid "རིན་ཆེན་ ཕྲེང་བ་␣ར །"
msgstr "The Precious Garland says:"

msgctxt "1572f2fa60a349f5b7ce66727d74f533"
msgid "ཉན་ཐོས་ ཐེག་པ་ དེ་ལས་ ནི ། །"
msgstr "From that of the shravaka vehicle."

msgctxt "dfe5795c28c84b799480298b9810e843"
msgid "བྱང་ཆུབ་ སེམས་ སོགས་ དང་ །"
msgstr "Bodhicitta and so forth and "

msgctxt "8b1c327d48564c93888c67bdfa264e85"
msgid "མཚན་མ་ མེད་པ་ མ་ རྟོགས་པ་␣ར་ སོགས་ ཞེས་ སོ་␣༑"
msgstr "Without realizing the absence of signs and so forth."

msgctxt "7d35e5060c994c38b3ed2c251b7957e3"
msgid ""
"རྡོ་␣༽༽  སེམས་ ཙམ་པ་␣ས་ གཟུང་འཛིན་ གཉིས་ སྟོང་ གི་ ཤེས་པ་ རང་རིག་ རང་ གསལ་ "
"བདེན་གྲུབ་ ཏུ་ འདོད་པ་ དེ་ ཆོས་ཅན །"
msgstr ""
"Vajra: Take the subject, the Mind-only school's acceptance that the self-"
"knowing, self-illuminating consciousness, empty of the duality of grasper "
"and grasped, is truly existent. "

msgctxt "cb8fd898f9f24c8ea8d9402e8fe09fb5"
msgid "རང་རིག་ རང་ གསལ་ དུ་ གྲུབ་པ་ མེད་ དེ །"
msgstr "Self-knowing is not established as self-illuminating."

msgctxt "0ca5954c08064300adf7cf0f30a9e591"
msgid "རིག་ བྱ་ རིག་བྱེད་ འགལ་བ་␣འི་ ཕྱིར །"
msgstr "Because the knower and the known are contradictory."

msgctxt "3b09baee1a2640dab11633cdaccc02ec"
msgid "ཡུལ་ ཡུལ་ཅན་ ནི་ ཀུན་རྫོབ་ ཡིན་ ཅིང་"
msgstr "Since object and subject are relative,"

msgctxt "dbfc5a2dacb34fbba91772254aa9519f"
msgid "རང་རིག་ མ་གྲུབ་པ་␣ས་"
msgstr "Self-knowing is not established."

msgctxt "4d269c040fb2488599fadd91344bb8d4"
msgid "ཆོས་ཉིད་ ཀྱི་ བདེན་པ་ མི་ མཐོང་ ཟེར །"
msgstr ""
"It is said that the truth of the true nature of phenomena is not seen."

msgctxt "bca5f5965a4d493b8dd1c07be81d4fe1"
msgid ""
"སྐབས་ འདི་␣ར་ སེམས་ ཙམ་པ་␣འི་ མངོན་རྟོགས་ ནི་ བྱང་སེམས་ ས་ བདུན་པ་ རིང་ དུ་ "
"སོང་བ་␣འི་ མངོན་རྟོགས་ དང་ མཉམ་པ་ ཡིན་ ཏེ་"
msgstr ""
"In this context, the path of the Mind-only school is equivalent to the path "
"of the bodhisattvas on the seventh level, the Far-going [level]."

msgctxt "95bde9caf75a4e408130e574e8bc77e8"
msgid "དེ་ལྟར་ ཡང་ ལང་ གཤེགས་ ལ་␣ས །"
msgstr "Likewise, The Descent to Lanka Sutra says:"

msgctxt "411b2f9e09b94ce1b0921e922b76fd36"
msgid "སེམས་ ཙམ་པ་ ནི་ བདུན་པ་ སྟེ ། །"
msgstr "The Mind-only school is the seventh [level]."

msgctxt "3be27ec130834580823b8a58e1715bf7"
msgid "སྣང་བ་ མེད་པ་ ས་ བརྒྱད་པ ། །"
msgstr "Because of no appearance, the eighth [level]."

msgctxt "e23c545873d845c39880cddc725ede67"
msgid "ས་ གཉིས་ དག་ ནི་ གནས་ ཡིན་ ཏེ ། །"
msgstr "These two levels are the dwelling place."

msgctxt "a599161d287f4bd192fdbaf00054cb22"
msgid "བཅུ་གཅིག་ ཡེ་ཤེས་ ཆེན་པོ་␣འི་ ས ། །"
msgstr "The eleventh is the level of the great primordial wisdom."

msgctxt "17612ec55cc148768198d2d9976b7ff6"
msgid "དེ་ ནི་ ང་ ཡི་ ས་ ཡིན་ ནོ །"
msgstr "That is my level."

msgctxt "9c213eb77cf341ea821c2ea6d0d94381"
msgid "ཞེས་ གསུངས་ ཤིང༌ །"
msgstr "As it is said."

msgctxt "7df3e065d9504f698051eb77167d1e2c"
msgid ""
"དྲུག་པ་ ཤེས་རབ་ མངོན་དུ་ གྱུར་པ་ རྟེན་འབྲེལ་ ལུགས་འབྱུང་ ལུགས་ལྡོག་ "
"རྟོགས་པ་␣ས་ མ་རིག་པ་ རྟོགས་པ་␣འི་ ཤེས་རབ་ ཟེར །"
msgstr ""
"The sixth is the direct perception of wisdom. Because of the realization of "
"the forward order and the reverse order of the dependent-related arising, it"
" is called wisdom realizing ignorance. "

msgctxt "f388a805ff564afca0dd1da02f43115d"
msgid "ཕྱི་ ནང་ གི་ ཆོས་ རྣམས་ སེམས་ སུ་ རྟོགས་ ཏེ་"
msgstr "By realizing the outer and inner phenomena in the mind."

msgctxt "ece2193c483246b188df7b4b6c13fc89"
msgid "ཅི་ཡང་ བསྒྱུར་ བཏུབ་པ་ ནི་ ཐབས་ ཀྱི་ ཕར་ཕྱིན་ ཡིན་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "The ability to change anything is the perfection of methods."

msgctxt "84dba8e5a2a74e17afd489fda6efa390"
msgid "ཕལ་ཆེན་ ལ་␣ས་ ཀྱང་ །"
msgstr "According to the Avatamsaka [Sutra]:"

msgctxt "f0a1032b2daf46a49a0f971761f9b257"
msgid "ཀྱེ་ རྒྱལ་བ་␣འི་ སྲས་ ཁམས་ གསུམ་པོ་ ནི་ སེམས་ ཙམ་ མོ ། །"
msgstr "Oh, the conqueror's sons! the three realms are just mind."

msgctxt "7084099696a24ab4a736df427f339300"
msgid "དུས་གསུམ་ ཡང་ སེམས་ དང་ མཚུངས་པ་␣ར་ རྟོགས་ སོ ། །"
msgstr "The three times are also realized in the same way as the mind."

msgctxt "ead6f86858534214bf5b7037a6f6fce3"
msgid "སེམས་ དེ་␣འང་ མཐའ་ དང་ དབུས་ མེད་པ་␣ར་ ཁོང་ དུ་ ཆུད་ དོ ། །"
msgstr "The mind is also understood without an edge or a center."

msgctxt "acc14c88d3af4873967125d19f27eb06"
msgid "ཅེས་ དང༌ །"
msgstr "And"

msgctxt "21cc5447220543c48f69f3e31097e7f7"
msgid "སེམས་ ཙམ་ བཀའ་ ཡིས་ དབུ་མ་ སྟོན །"
msgstr "The instruction of the Mind-only [school] shows the middle way."

msgctxt "ab502c2b54b74c269b6f5de232d82683"
msgid "བྱ་བ་␣འི་ སྐབས་ སུ་␣འང་ ལེགས་པ་␣ར་ བཤད་པ་ ཡིན་ ནོ །"
msgstr "It is also excellently explained at the time of action."

msgctxt "ff532d7f8fea4f089f82438d72f2c5ce"
msgid ""
"རྡོ་␣༽༽  འཁོར་བ་␣འི་ རྩ་བ་ གང་ཟག་ གི་ བདག་ རྟག་ གཅིག་ རང་དབང་ ཅན་ དང༌ །"
msgstr ""
"Vajra: The root of samsara is [the strong clinging] to the self of persons "
"as permanent, singular, independent, and "

msgctxt "a971b29eb3374e44bb9eed0e97a51adf"
msgid "ཉེར་ལེན་ གྱི་ ཕུང་པོ་␣ར་ མངོན་པར་ ཞེན་པ་␣ས་"
msgstr "to the taken aggregates."

msgctxt "16ca188fba664480a17041f21187d7d6"
msgid ""
"བདག་ ཏུ་ བཟུང་བ་ རྫས་ དང་ རྒྱུན་ དང་ བཏགས་པ་ ལ་སོགས་པ་ འདོད་པ་ གང་ཟག་ གི་ "
"བདག་ དང་"
msgstr ""
"The self-grasping is accepted to be a substance, a continuum, a designation,"
" and so forth. The self of persons and "

msgctxt "5fa60652ebb6446a966d6a3be84a6bdb"
msgid ""
"འཛིན་པ་␣འི་ བདག་མེད་ ཀྱང་ ཕྱི་ ནང་ གི་ ཆོས་ རྣམས་ རྟེན་འབྲེལ་ ཙམ་ དུ་ "
"བྱུང་བ་ འདི་ ཡོད་ དོ་ བྱ་བ་ ཆོས་བདག་ སྟེ །"
msgstr ""
"The selflessness of grasping, the outer and inner phenomena, exist merely as"
" a dependent-related arising. The activity is the self of phenomena."

msgctxt "78c106846ab944819fed43b9016e262a"
msgid "དེ་ རང་བཞིན་ མེད་པ་␣ར་ ས་ དང་པོ་␣ར་ རྟོགས་པ་ དང་"
msgstr "Devoid of its intrinsic nature is realized on the first level.  "

msgctxt "46eabfe2f2014b03a48c45ff09b3d74f"
msgid ""
"བརྒྱད་པ་␣ར་ རྟོགས་པ་␣ར་ འདོད་པ་ རིམ་བཞིན་ བྱམས་མགོན་ དང་ ཀླུ་སྒྲུབ་ ཀྱིས་ "
"བཞེད་པ་␣ས་"
msgstr ""
"The acceptance that it is realized on the eighth level, is successively "
"accepted by Guardian Maitreya and Nagarjuna."

msgctxt "ef64deb2ad754d5abc3a9bf4528f5c62"
msgid "འགལ་བ་ ཅན་ ཡིན་ གསུངས་ མོད ། །"
msgstr "Although [they] are said to be contradictory."

msgctxt "5fb5a1e203294eedb33cb51c36bbeef1"
msgid "འདི་␣ར་ ནི་ དེ་ གཉིས་ མི་འགལ་བ་ ཆོས་ ཀྱི་ བདག་"
msgstr ""
"In this [system], these two are not contradictory. The self of phenomena "

msgctxt "d58083f7bf994d4bba6ab2ad05cb66ba"
msgid "རང་བཞིན་ མེད་པ་ ས་ བརྒྱད་པ་␣ར་ མངོན་དུ་ བྱས་པ་ ལ་ དགོངས་པ་ མཐུན་ ཏེ་"
msgstr ""
"because of the absence of intrinsic nature, it is realized on the eighth "
"level which is concordant with the intent."

msgctxt "9fde591dbf7a458dab037fd9709d40c6"
msgid "དང་པོ་␣ར་ བདག་མེད་ གཉིས་ རྟོགས་པ་ ཡིན་ ན་"
msgstr "If the two selflessnesses are realized on the first [level]."

msgctxt "30a3939029794bf19f8916933ee70050"
msgid "རིང་ དུ་ སོང་བ་␣འི་ ཐ་སྙད་ སྦྱར་ མེད་པ་␣ས་"
msgstr "Because the expression Far-going is not connected"

msgctxt "5b39f1911bee487cb874cfff1be9cba4"
msgid "གང་ཟག་ གི་ བདག་ ཕུང་པོ་␣ར་ འཛིན་པ་"
msgstr "The grasping of the self of a person as the aggregates"

msgctxt "9b2091787737420a8feb78e8ee37cefb"
msgid "རང་བཞིན་ མེད་པ་ ས་ དང་པོ་␣ར་ རྟོགས་པ་ ལ་ དགོངས་ ཤིང་ །"
msgstr ""
"Because it is empty of intrinsic nature, thus the realization on the first "
"[level] is the intent."

msgctxt "a44a139fc56d49ea94fe7f05211bbe6f"
msgid "རྟེན་འབྲེལ་ ཆོས་ ཙམ་ དུ་ སྣང་བ་ དེ་ཡང་"
msgstr ""
"The appearance of dependent-related arising just as a phenomenon is also."

msgctxt "01c31e39feb5418f9bd333e31955c3cd"
msgid "རང་བཞིན་ མེད་པ་ ཆོས་ ཀྱི་ བདག་མེད་པ་ ས་ བརྒྱད་པ་␣ར་ རྟོགས་པ་ ཉིད་"
msgstr ""
"an empty of intrinsic nature, because of the selflessness of phenomena, it "
"is realized on the eighth level."

msgctxt "db7ecdf662174960906b58bcc79533e5"
msgid "གཉིས་ཀ་ དགོངས་པ༌་␣མཉམ་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Thus, both of these have the same intent."

msgctxt "229a70056a4b45d989d32ce734be5e4f"
msgid "དེ་ལྟར་ རྒྱ་ རོལ་ ལ་␣ས་ ༑"
msgstr "According to The Play in Full [sutra]:"

msgctxt "ec9c5dbbaf0a404c8c20fd714c7df1df"
msgid "གང་ ཚེ་ འདི་ ན་ སྐྱེ་འཆི་ གང་ཡང་ མེད ། །"
msgstr "There is no birth or death at that point."

msgctxt "61733a00997346ac93834f709b67efb7"
msgid "ཆོས་ འདི་ ཐམས་ཅད་ རང་བཞིན་ བདག་མེད་པ་␣འི ། །"
msgstr "All phenomena are empty of intrinsic nature and selflessness."

msgctxt "a9dff32c12144e3fae9063e9b88fec43"
msgid "བཟོད་པ་ བདག་ གིས་ ཐོབ་པ་ དེ་ ཡི་ ཚེ ། །"
msgstr "When I attain forbearance"

msgctxt "d73b2eaaf0b14014bee29cec99626179"
msgid "སངས་རྒྱས་ མར་མེ་མཛད་ ཀྱིས་ བདག་ ལུང་བསྟན །"
msgstr "Buddha Dipankara will prophesy about me."

msgctxt "36073342b36e461aa9ec884fa36c1668"
msgid "ཅེས་ དང་ །"
msgstr "And"

msgctxt "65393b058f16420295c4048119a835bb"
msgid "རྣམ་པ་␣ར་ འཕྲུལ་ རྒྱལ་ གྱིས་ ཞུས་ མདོ་␣ར །"
msgstr "According to the Sutra of Requisition by Vikurvanaraja:"

msgctxt "6150493315014e0f8070716046efe43c"
msgid "ཆོས་ ཀྱི་ བདག་མེད་ རྟོགས་ ཕྱིན་ཆད་ བདག་ གིས་ སངས་རྒྱས་ མཐོང་ ། །"
msgstr "After I realize the selflessness of phenomena, I will see the Buddha."

msgctxt "4f5025cbfe8045a6b43535b9dda72535"
msgid "གྲངས་མེད་ གཉིས་ ལ་མ་ མཐོང་ ངམ་ ཞུས་པ་␣ས །"
msgstr ""
"When he was asked: \"Haven't you seen [the Buddha] in the two incalculable "
"[aeons]? "

msgctxt "5d1e00e60bac409bab439660f2b7f51f"
msgid "འཇིག་ཚོགས་ མཐོང་ ཞེས་ དང༌ །"
msgstr "He said: \"I have seen the perishing collection.\""

msgctxt "d6a3326cda7b48f9b23c0f9d0fd1f4fa"
msgid "མར་མེ་མཛད་ ལུང་བསྟན་པ་ ལ་␣ས་ ཀྱང་ དེ་ལྟར་ གསུངས་ སོ ། །"
msgstr "Dipamkara's prophecy also states this."

msgctxt "c54bb3c82e534820ad0fca3dc2a9bbe8"
msgid "གཉིས་ཀ་ དང་པོ་ རྟོགས་པ་ གསུངས་པ་ དག་ས་ དང་"
msgstr ""
"It is said that both of these are realized on the first [level], the pure "
"levels and "

msgctxt "5726dadce1a642bfb6261fbd220fd9d8"
msgid "གཞོན་ནུ་␣འི་ ས་␣འི་ དང་པོ་ བརྒྱད་པ་ ཡིན་པ་␣ས་ སོ །"
msgstr "the levels of youth's first and eighth."

msgctxt "29856d375fb04e6fa842d0cce0a883d3"
msgid "ཞེས་པ་ སོགས་ ཀྱི་ ལུང་རིགས་ ཀྱིས་ སྒྲུབ་བོ །"
msgstr "This is established by such scriptures and reasonings."

msgctxt "84720d6483b8414c82a57ff2eac0fdbf"
msgid ""
"རྡོ་␣༽༽  གཞན་ བཞེད་ ལ་ ས་བཅུ་ ལམ་ ལྔ་ ལས་ཚོགས་ སྦྱོར་ གཉིས་ རྒྱུ་␣ར་ ལམ་ དུ་"
" བརྟགས་པ་ འཇིག་རྟེན་པ་ ཡིན །"
msgstr ""
"Vajra: In other's acceptance, from the ten levels and five paths, the [paths"
" of] accumulation and connection are like designating cause as a path, is a "
"worldly thing."

msgctxt "0dfcddbbdd6c44239f27c0af1828b798"
msgid "མཐོང་ སྒོམ་ གཉིས་ འཇིག་རྟེན་ ལ་␣ས་ འདས་པ་␣འི་ ལམ་ མཚན་ཉིད་པ་ དང་ །"
msgstr ""
"The paths of seeing and cultivation are genuine transcendental paths and"

msgctxt "8625efa1212f4885b0826f88b59fb126"
msgid "མཐ་␣ར་ ཕྱིན་ ལམ་ འབྲས་བུ་␣ར་ ལམ་ དུ་ བརྟགས་ ཤིང་"
msgstr "the final paths are like designating the result as the path."

msgctxt "770180b95ea146d59b39eb4e466e74c1"
msgid "ས་བཅུ་ ནི་ མངོན་རྟོགས་ ཀྱི་ རིམ་པ་ སྟེ་"
msgstr "The ten levels are the stages of manifest realization."

msgctxt "4cb1dd6f7caf475c95d952b39170a8f1"
msgid "དང་པོ་ མཐོང་ལམ་ དེ་ནས་ དཔའ་བ་␣ར་ འགྲོ་བ་"
msgstr ""
"First, one advances from the path of seeing to the courageous [level]."

msgctxt "841c1eb1de0448e3b1151b49717fbc87"
msgid "མཐ་␣ར་ རྡོ་ཏིང་ སོགས་ ཐ་དད་ ཀྱིས་ བགྲོད་ ནས་"
msgstr "Finally, one traverses by vajra-like concentration and so on. "

msgctxt "c46e974c8c02430cb1e58db68f555de2"
msgid "གོང་མ་ རྟོགས་ ཚེ་ འོག་མ་ འདོར་བ་ ཡིན་ ཟེར་ ཡང༌ །"
msgstr ""
"Even though it is said that when one realizes the higher levels, one "
"forsakes the lower ones."

msgctxt "c660bd703f4e46218cec04ff2432b8e0"
msgid ""
"འདི་␣ར་ ནི་ མངོན་རྟོགས་ མཐོང་ལམ་ གྱི་ བདེན་པ་ གཅིག་ ཁོ་ན་␣འི་ ངོ་བོ་ དག་ "
"གིས་ ས་ལམ་ མཐར་ཐུག་ ཚུན་ཆད་ མ་ལུས་པ་ བགྲོད་ དེ་"
msgstr ""
"In this system, through the manifest realization of the essence of the truth"
" of the path of seeing alone, one traverses all the grounds and paths none "
"excluded till the final stage."

msgctxt "4046f33af3684f07b1867fbaaf9183f0"
msgid "ཏིང་འཛིན་ རྒྱལ་པོ་ ལ་␣ས །"
msgstr "According to The King of Meditative Concentration [Sutra]:"

msgctxt "f74298638e114b8989a16a5353de90ef"
msgid "མི་གང་ ཏིང་འཛིན་ མཆོག་ དེ་ སུ་␣ས་ འཛིན་པ ། །"
msgstr "Those who hold this supreme meditative concentration."

msgctxt "6bfe1837f9474cf9b7cb1ff57ea6394e"
msgid "འོད་འཕྲོ་ ཤིན་ཏུ་ སྦྱངས་ དཀའ་ མངོན་གྱུར་ དང༌ ། །"
msgstr "The [levels] of Radiant, Very Difficult to Conquer, Manifest and"

msgctxt "714da8ae4d6047be84dab210fc9a0702"
msgid "རིང་ དུ་ སོང་ དང་ མི་ གཡོ་ ལེགས་པ་␣འི་ བློ ། །"
msgstr "Gone Far, Unwavering, Good Intelligence,"

msgctxt "aa5a546c9306439b8525c2b670813c2d"
msgid "ཆོས་ སྤྲིན་ ས་བཅུ་པོ་ དག་ ཐོབ་པ་␣ར་ འགྱུར །"
msgstr "And the cloud of dharma, these ten levels will be attained. "

msgctxt "9691802e6c1d4cf49ae699e67543049f"
msgid "ཞེས་པ་␣ས་ རྣལ་འབྱོར་ བཞི་ ལ་ སྦྱར་ ན་"
msgstr "Thus, when these four are connected to the four yogas,"

msgctxt "0889fa32b35747148f157ebcb7e0ccdd"
msgid "སྤྲོས་མེད་ ལྷན་སྐྱེས་ ཀྱིས་ ཡེ་ཤེས་ ཅུང་ཟད་ གསལ་བ་ ཚེ་ གཅིག །"
msgstr ""
"One instance is when the unelaborated co-emergence clears a little bit of "
"primordial wisdom."

msgctxt "41ca7120e0644653a51e7d0e54c23c06"
msgid "དེ་␣འི་ ངོ་བོ་ མཐོང་བ་ སྤྲོས་བྲལ །"
msgstr "Its essence is seen as free from elaboration."

msgctxt "9a17812105c74f738b7cdc784c57b43f"
msgid "སྣང་བ་ ཐམས་ཅད་ དེ་ཉིད་ དུ་ རྟོགས་པ་"
msgstr "All appearances are realized in itself."

msgctxt "0ce4bd5260c34c0994dec0a56e432d44"
msgid ""
"རོ་ གཅིག་ མཉམ་རྗེས་ སམ་ ཡུལ་ ཡུལ་ཅན་ གཉིས་ མེད་ དུ་ རྟོགས་པ་ སྒོམ་ མེད་ "
"ཡིན་པ་␣ས་"
msgstr ""
"The realization of the non-duality of equipoise and post-attainment, or the "
"non-duality of subject and object, as a single taste, is the non-meditation "
"[yoga]."

msgctxt "60f0c3d65b1d4d1d90e75a71b74dd3e5"
msgid "སྟོང་ཉིད་ བཅོ་བརྒྱད་ དང་ ཞི་གནས་ རྒལ་བ་␣འི་ བར་མི་ གཅིག་ ལ་"
msgstr ""
"It is not the same until traversing the eighteen emptinesses and calm-"
"abiding."

msgctxt "a8709e8a766c43d0a2df3af480569291"
msgid "གནས་སྐབས་ བཅུརབཏགས་པ་ བཞིན་ ནོ །"
msgstr "It is like being temporarily labeled as ten [categories]."

msgctxt "c09d299a2abc44bc9176e71d0bef7d6f"
msgid "ལྷན་␣༽༽  འགའ་ཞིག་ ན་རེ །"
msgstr "Addendum: Some said,"

msgctxt "55fb92efaecc46a4b9de8091ceb37c71"
msgid "ཏིང་འཛིན་ མང་ དུ་ཡོད་ ཀྱང་"
msgstr "Although there are many meditative concentrations."

msgctxt "533fa307e7ec4fd4b66e5215d9132195"
msgid "རྡོ་ཏིང་ རྒྱུན་མཐ་␣འི་ ཏིང་འཛིན་ ཡིན་ ཟེར་ ཡང་ །"
msgstr ""
"Also, the vajra-like concentration is said to be the meditative "
"concentration of the final continuum."

msgctxt "1c0402547896427c8d8ed793cb87dd2a"
msgid "འདི་␣ར་ ནི་ ཏིང་འཛིན་ མཐའ་དག་ ཀྱང་ རྡོ་རྗེ་ ལྟ་བུ་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], all the meditative concentrations are vajra-like because."

msgctxt "a24b813e11554e358176dc5e798bf567"
msgid "ཚོགས་སྦྱོར་ ཞི་གནས་ ཀྱི་ ཏིང་འཛིན་ ལ་ བརྟེན་ ནས་ མཐོང་ལམ་ སྐྱེ་ ཞིང་"
msgstr ""
"The path of seeing arises in dependence on the concentration of calm-"
"abiding, the paths of accumulation and connection."

msgctxt "9a31388979904ea18e8a0d446041dc7b"
msgid "དེ་␣ས་ ས་བཅུ་ ཚུན་ཆད་ བསྒྲོད་པ་␣འི་ ཕྱིར་ རོ །"
msgstr "It will traverse up to the tenth level."

msgctxt "22b00650664f42bfa8c708d4f62354b6"
msgid "རྡོ་␣༽༽  ས་ དང་པོ་ ཐོབ་ མ་ ཐག་ སངས་རྒྱས་ བརྒྱ་␣འི་ ཞལ་ མཐོང་བ་ སོགས་"
msgstr ""
"Vajra: Soon after attaining the first level, [one] will see the faces of one"
" hundred Buddhas and so on."

msgctxt "be5ca888bbb54064888f91408e82498a"
msgid "ཡོན་ཏན་ བརྒྱ་ ཕྲག་ བཅུ་གཉིས་ འབྱུང་བ་␣ར་ གསུངས་པ་"
msgstr "It is said that twelve hundred qualities will arise."

msgctxt "dab29bef5aae49f984326368eb2b5eac"
msgid "ཁྱེད་ ཀྱི་ རོ་ གཅིག་ དག་པ་␣འི་ མངོན་རྟོགས་ སུ་ འདོད་ ན་"
msgstr "If you accept the one-taste as a pure manifest realization,"

msgctxt "f7b21f246b4142c9b3fc169c674d334c"
msgid "དང་པོ་␣འི་ ཡོན་ཏན་ ཡང་ མི་ འདུག་ ཟེར་ རོ ། །"
msgstr ""
"[They] will say that even the qualities of the first [level] are not "
"present."

msgctxt "464e17a819824faf9d043e0c06480327"
msgid "འདི་␣ར་ ནི་ ས་ ཐོབ་ ཀྱང་ ས་ སྦྱངས་ དགོས་པ་␣ས་"
msgstr ""
"In this [system], even after attaining the levels, still need to train. "

msgctxt "6963f79d132347cf82b71e2ce34d735b"
msgid ""
"ཡོན་ཏན་ འབྱུང་ ཚུལ་ རིམ་གྱིས་ ཅིག་ ཆེ་␣ར་བ་ འགའ་ཞིག་ ཡོད་མེད་ ཡོད་ ཀྱང་"
msgstr ""
"How good qualities arise could be gradually or at once, or some exist, some "
"do not."

msgctxt "43ea2af2df3c42749b37c64c31ce1ea7"
msgid "གཞན་ གྱིས་ མི་ མཐོང་བ་"
msgstr "That which cannot be seen by others,"

msgctxt "a1f360e16c14422b91e6d53c7d4ca315"
msgid "རྣལ་འབྱོར་པ་␣འི་ ཉམས་སྣང་ ལུང་ ཁུངས་ ཀྱི་ མུ་ དང་ མུ་ དྲུག་ ཡོད་ དེ་"
msgstr ""
"There are six possibilities including the possibility of the scriptural "
"source of the yogin’s experiences and visions."

msgctxt "85598b47288f4fff88a58e16e6e045e1"
msgid "དང་པོ་ ནི་ གྲངས་མེད་ གསུམ་ ལ་ རིམ་གྱིས་ བསྒྲོད་པ་ ཤཱཀྱ་ ཐུབ་ ལྟ་བུ་␣ར་"
msgstr ""
"The first is like Shakyamuni, who traversed gradually through the three "
"incalculable [aeons]."

msgctxt "19ece1c0f0ac4dc8b3d424568f67dffc"
msgid "ཇི་སྐད་ བཤད་པ་␣འི་ ཡོན་ཏན་ འབྱུང་བ་ ཡིན ། །"
msgstr "The qualities arise as explained. "

msgctxt "b8bf9a19392f4ab794cf54d7443ae2b7"
msgid ""
"གཉིས་པ་ སྤྱན་རས་ གཟིགས་ ལྟ་བུ་ སེམས་བསྐྱེད་པ་ གཅིག་ གིས་ ས་ བརྒྱད་པ་ "
"ཐོབ་པ་␣ར་ གསུངས་པ་ དང་"
msgstr ""
"The second is like Avalokiteshvara, it is said that he attained the eighth "
"level by generating the mind of awakening once."

msgctxt "2f3bd89233e04924af49d9425b88e9b1"
msgid "བསྒྲེས་ མོ་ མོ་ མི་ སྐྱེ་བ་␣འི་ ཆོས་ ལ་ བཟོད་པ་ ཐོབ་ ཀྱང་"
msgstr ""

msgctxt "992b60e51a6a4cbea7fc0f39623906c7"
msgid "དང་པོ་␣འི་ ཡོན་ཏན་ ཙམ་ ཡང་ མེད་པ་ བཞིན་ ནོ ། །"
msgstr ""
"It is like one does not even possess the qualities of the first [level]."

msgctxt "50db12d839954082be8dfc8e90be099d"
msgid "གསུམ་པ་ འགའ་ཞིག་ ཡོད་ ལ་ འགའ་ཞིག་ མེད་པ་"
msgstr "The third is some exist, some do not. "

msgctxt "5b07ac0a24fa44eea7d05dd57f9e2980"
msgid "ནོར་ བཟང་ གི་ བླ་མ་ རྣམས་ ས་བཅུ་པ་ ཡིན་ ཀྱང་"
msgstr "Although the gurus of Norzang were on the tenth level."

msgctxt "52d76a812f9141f197850783281e0b36"
msgid ""
"བདག་ གིས་ འདི་ ལས་མི་ ཤེས་ ཞེས་ དབུ་སྙུང་ བཞེས་ ནས་ ལུང་བསྟན་པ་ བཞིན་ ནོ ། །"
msgstr ""
"They stated, \"I know nothing beyond this.\" They became perplexed, and a "
"prophecy was made."

msgctxt "01b58c219dcb4646b1bf38aa207aa8d3"
msgid "བཞི་པ་ ཡོད་ ཀྱང་ མི་ མཐོང་བ་"
msgstr " Although the fourth is present, it is not seen."

msgctxt "3de21860d17a4466ad187c3f09d8d32b"
msgid "ཀླུ་སྒྲུབ་ ལང་ གཤེགས་ ལ་␣ས་"
msgstr "Nagarjuna in the Descent to Lanka Sutra:"

msgctxt "3e0fde77c0864e4a99e45a3ef734f780"
msgid "ས་ དང་པོ་ དང་ རྔ་བོ་ ཆེ་ དང་ འཇམ་དཔལ་ རྩ་རྒྱུད་ དུ་ ས་ བརྒྱད་པ་ དང་ །"
msgstr ""
"prophesied that [he] is on the first level and in the Great  Drum and The "
"Manjushri Root Tantra as on the eighth level, and "

msgctxt "0e74f9071ac34e74be33a0cb64541201"
msgid "སྤྲིན་ཆེན་པོ་␣ར་ ས་བཅུ་པ་␣ར་ ལུང་བསྟན་པ་␣ས་"
msgstr "In the Great Cloud as on the tenth level."

msgctxt "d4977706d2b04e4682c24222f8a99dde"
msgid "བརྒྱ་ ཕྲག་ བཅུ་གཉིས་ སོགས་ ཡོན་ཏན་ སུ་␣ས་ ཀྱང་ མ་ མཐོང་བ་ དང་"
msgstr ""
"No one has seen [his] qualities such as the twelve hundred [qualities]."

msgctxt "11a0aa5f312c4f999ce1e21cd6400ff5"
msgid "སྲོང་ བཙན་ གྱི་ དབུ་␣ར་ འོད་ དཔག་མེད་ བཞུགས་པ་ དང་"
msgstr "It is similar to Amitabha sitting on the head of Songtsen [Gampo] and"

msgctxt "175b547b00664cfb8aa28834d846010e"
msgid "ཐོག་མེད་ ཀྱི་ ཕྲག་ ལ་ བྱམས་མགོན་ བཞུགས་ ཀྱང་ མ་ མཐོང་བ་ བཞིན་ ནོ ། །"
msgstr "Maitreya sitting on the shoulders of Asanga, but they are not seen."

msgctxt "3ae991323b8948e494d175a6b117d0f6"
msgid "ལྔ་པ་ ནི་ ས་བཅུ་␣འི་ བཤད་པ་ ལ་␣ས་"
msgstr "The fifth is as in the Explanation of the Tenth Level,"

msgctxt "1757df3d7e644f7b9b251b01f41732f5"
msgid ""
"བྱང་ཆུབ་ སེམས་བྱུང་བ་ རྣམས་ ཁོང་ རང་ གིས་ མ་གཏོགས་ མ་ མཐོང་བ་ མི་ལ་ བཞིན་ ནོ"
" ། །"
msgstr ""
"Those who arise bodhicitta are only seen by themselves, such as Milarepa."

msgctxt "c9de15197c9a4abfa067bbc06ecd4312"
msgid ""
"དྲུག་པ་ ས་ ཐོབ་ མ་ ཐག་ ཡོན་ཏན་ ཉི་མ་ དང་ ཉི་མ་␣འི་ ཟེར་ བཞིན་ འབྱུང་བ་␣ར་ "
"གསུངས་པ་␣འི་ ལུང་མདོ་ རྒྱུད་ ན་ ཡོད་ དོ ། ། །"
msgstr ""
"There are scriptures in the sutras and tantras that say that as soon as the "
"sixth level is attained, the qualities arise like the sun and its rays."

msgctxt "6d924177f2ed40a9a757e1e774920a69"
