msgctxt "8c2295dc3b364a00acd69ea1a427d31e"
msgid ""
"༄༅། ། ཐུབ་བསྟན་ དོན་ བརྒྱུད་ སྙིང་པོ་ མགོན་པོ་ འབྲི་གུང་པ་␣འི་ དམ་ཆོས་ "
"དགོངས་པ་ གཅིག་པ་␣འི་ རྣམ་བཤད་ བློ་ གས་␣ར་ དགའ་བ་␣འི་ རྣ་རྒྱན་ དབྱར་ གྱི་ "
"རྔ་སྒྲ་ ཞེས་ བྱ་བ་ བཞུགས་ སོ ། །"
msgstr ""
"A true transmission of the Buddha's doctrine, A Thorough Explanation of the "
"Holy Dharma Single Intent by Lord Drigungpa, named Summer Drum Sound: An "
"Ornament Earring of Joy for New Minds."

msgctxt "d040936945854546a7449761291d81dd"
msgid "༄༅། ། ན་མོ་ གུ་རུ་ རཏྣ་ ཤྲཱི་ ཡེ །"
msgstr "NAMO GURU RATNA SHRI YE"

msgctxt "4290bd4a976e457096ba1a0bf96b4d12"
msgid ""
"སྣ་ཚོགས་ བསོད་ནམས་ འོ་མ་␣འི་ མཚོ་ ལ་ བརྩོན་འགྲུས་ སྐྱ་བ་␣ས་ བསྲུབས་པ་ ལ་␣ས "
"། །"
msgstr ""
"In the diverse ocean of merit, by churning with the stick of perseverance,"

msgctxt "d6fc2fb4f2b849f68fcc59331d89d07b"
msgid ""
"གཟུགས་སྐུ་␣འི་ རྩི་བཅུད་ མངོན་པར་ འཁྲུངས་ ནས་ སྤང་ རྟོག་ མཐ་␣ར་ ཕྱིན་ རྫོགས་"
" སངས་རྒྱས ། །"
msgstr ""
"The essential nectar of the rupakaya is manifestly born, gone to the end of "
"abandonment and realization, and becomes a complete buddha. "

msgctxt "c18652eda3f642e296f89c2c81a70044"
msgid ""
"དེ་␣ས་ གསུངས་ འགོག་ ལམ་ དམ་པ་␣འི་ ཆོས་ དང་ རིག་ གྲོལ་ དབང་ཕྱུག་ དགེ་འདུན་ ལ "
"། །"
msgstr ""
"It is taught the holy Dharma of the cessation and path and to the sangha of "
"intelligence and liberation."

msgctxt "14f82f31e10840d893e661b74bff847d"
msgid ""
"བྱང་ཆུབ་ བར་ དུ་ སྐྱབས་གནས་ བསླུ་མེད་ དཀོན་མཆོག་ རྣམ་ གསུམ་ གཙུག་ ན་ རྒྱལ "
"། །"
msgstr ""
"[One] will be victorious if [one] crowns the non-deceptive place of refuge- "
"the three jewels until enlightenment. "

msgctxt "fcfd50ffdc63425d86c403f62a4700d8"
msgid ""
"༄༅། ། འགྲོ་ ཀུན་ མ་རིག་ ཞགས་པ་␣ས་ བཅིངས་ རྣམས་ རྣམ་དཔྱོད་ རིག་པ་␣འི་ རལ་གྲི་"
" ཡིས ། །"
msgstr ""
"All those migrators bound by the lasso of ignorance, with the sword of "
"analytical rigpa"

msgctxt "f8e41334c82a4c5c9142a06131e4242d"
msgid ""
"བསྐྲལ་ ནས་ བདེ་བ་␣འི་ གནས་ ལ་ དབྱུང་ མཛད་ ཇི་སྙེད་ མཁྱེན་པ་␣འི་ པོ་ཏི་ བསྣམས"
" ། །"
msgstr ""
"[He] was expelled to the place of bliss and brought the volumes of the "
"entire knowledge of omniscience."

msgctxt "dba99aa6133246239050aaace1ef7d47"
msgid ""
"རྒྱལ་བ་ ཀུན་ གྱི་ མཁྱེན་པ་␣འི་ མངའ་བདག་ འཇམ་དཔལ་ དཔའ་བོ་ ཁྱེད་ མིན་ སུ ། །"
msgstr ""
"Manjushri, the master of all the conquerors' knowledge, if not you, who?"

msgctxt "2de009ff09b14b68af80ef9d5c752f62"
msgid ""
"བདག་ བློ་ དད་པ་␣འི་ ལན་ བརྒྱ་␣ར་ བསྟོད་ ནས་ མི་ འབྲལ་ སྤྱི་བོ་␣འི་ རྒྱན་ དུ་"
" མཆོད ། །"
msgstr ""
"I praise [you] a hundred times with a mind of confidence and offering to "
"[you] at the inseparable ornament of the crown."

msgctxt "2cd5629445c54c12b336b9c4efb174ee"
msgid ""
"སྟོན་པ་␣ས་ ལུང་བསྟན་ གངས་ཅན་ བྱང་ཕྱོགས་ འབྲི་ ཐེལ་ རྡོར་ གདན་ གཉིས་ པ་རུ ། །"
msgstr ""
"The Buddha prophesied that in the north of the Snow Land, Dri Thil, the "
"second Bodh Gaya "

msgctxt "c4296bc4214348c58ff1bfba940f5bb7"
msgid ""
"ཟབ་མོ་ ལྟ་བ་␣འི་ ཤིང་རྟ་␣འི་ རྣམ་ རོལ་ ཀླུ་སྒྲུབ་ གཉིས་པ་ རཏྣ་ ཤྲཱི ། །"
msgstr ""
"The manifested chariot of the profound view, Ratna Shri, the second "
"Nagarjuna. "

msgctxt "19f40658438a4557b8f8cfabdb6498c2"
msgid ""
"ཆོས་ ཀུན་ གཤིས་ བབ་ རྟེན་འབྲེལ་ མངོན་ བསྒྱུར་ རྩེ་གཅིག་ སྤྲོས་བྲལ་ རོ་ གཅིག་"
" དང༌ །"
msgstr ""
"The intrinsic nature or state of all phenomena is the manifestation of "
"interdependence, a single-pointedness, free from elaboration, a single taste"
" and "

msgctxt "0ca08b2082474d7f987a9bec6148b53c"
msgid ""
"སྒོམ་ མེད་ ལྟ་བ་␣འི་ ཡང་རྩེ་␣ར་ སོན་པ་ ཆོས་རྗེ་ འཇིག་རྟེན་ མགོན་ ལ་ འདུད ། །"
msgstr ""
"I bow to Dharma Lord Jigten Gön, the one who has reached the pinnacle of the"
" non-meditation view."

msgctxt "685e3cb30d9345a18b290e5eae7d51c7"
msgid "འཕགས་ཡུལ་ གྲུབ་ཆེན་ ས་ར་ ཧ་ དང་ གངས་ཅན་ ཤེར་ འབྱུང་ རཏྣའི་ མཚན ། །"
msgstr ""
"The names of Mahasiddha Saraha of the Noble Land and Sherjung Ratna of the "
"Snow Land."

msgctxt "fff385220c774be1a4a3d100c7883363"
msgid ""
"སྤྲུལ་པ་␣འི་ སྐུ་ མཆོག་ བཅུ་ཕྲག་ རིག་གནས་ རྒྱུད་སྡེ་ རྒྱ་མཚོ་␣འི་ དོན་ ལ་ "
"མཁས ། །"
msgstr ""
"The excellent nirmanakaya, who is an expert in the ten fields of knowledge, "
"in the meaning of the ocean of tantra section."

msgctxt "5dfac5b6401e4c289ddb4a2fb0487996"
msgid ""
"འཇམ་པ་␣འི་ དབྱངས་ དང་ གཉིས་ སུ་ མེད་པ་ རྒྱལ་དབང་ རིག་འཛིན་ ཆོས་ ཀྱི་ གྲགས "
"། །"
msgstr "Gyalwang Rindzin Chokyi Drak, a non-dual from Manjushri."

msgctxt "ed825d777dda45bab84ffd810bb20ef3"
msgid ""
"ཐུགས་རྗེ་␣ས་ རྗེས་བཟུང་ བདག་ ཡིད་ དྭངས་ བས་ དྲིན་ཅན་ བླ་མ་␣ར་ ཕྱག་ བགྱི་␣འོ "
"། །"
msgstr ""
"[You] hold with compassion and purify my mind, I pay homage to the kind "
"guru."

msgctxt "76257ff95d6047bcb857ccb6d3b3886c"
msgid "སྟོན་པ་␣ས་ གསུང་པ་␣འི་ མདོ་སྔགས་ ཀྱི ། །"
msgstr "The sutra and mantra taught by the Buddha,"

msgctxt "57b3912effb8465682c9a4aa074f5d87"
msgid "དོན་ རྣམས་ མ་ ནོར་ གོ་ བདེ་␣འི་ ཕྱིཪ ། །"
msgstr "To avoid mistake in the meanings and for an easy understanding"

msgctxt "8313b0559b28465bab4be9807dc65180"
msgid "རྒྱལ་མཆོག་ འབྲི་གུང་ རིན་ཆེན་ གྱི ། །"
msgstr "The excellent conqueror, Drigung Rinchen's"

msgctxt "4eb33c5771444f16ba9a3c6d376380e1"
msgid "གསུངས་པ་␣འི་ ཁྱད་ཆོས་ དགོངས་པ་ གཅིག  །"
msgstr "The unique teaching- the Single Intent. "

msgctxt "e490d8dbeadf41988ea1b8ea04e81d16"
msgid "བློ་ དམན་ བདག་ འདྲ་ རྣམས་ ལ་ ནི ། །"
msgstr "For those of lesser intellect like me,"

msgctxt "79b1d88d89cc4d028b4c124452dc137d"
msgid "ཕན་ ཕྱིར་ ཚིག་དོན་ འགྲེལ་ འདི་ བརྩམས ། །"
msgstr ""
"To benefit [them], [I] have composed this commentary on the meanings of the "
"words.  "

msgctxt "617921dbbdfb45eeb87d36dbd1a5c803"
msgid "སྔོན་ཆད་ མ་ བྱུང་ འདི་␣ར་ བརྗོད་ མེད ། །"
msgstr "Nothing is said here that has not happened before."

msgctxt "461226f560f24c9f9d275b7910f56489"
msgid "སྡེབ་སྦྱོར་ སྙན་པ་␣འང་ བདག་ ལ་ མེད ། །"
msgstr "I do not have a pleasant art of composition."

msgctxt "a0548b0c382e4f69b3f70fd5c331e688"
msgid "གཞན་ ལ་ ཕན་པ་␣འི་ བློ་ ཡང་ དཀའ ། །"
msgstr "The mind to benefit others is also difficult. "

msgctxt "2df495225a804e6da4e52145e8e36936"
msgid "རང་ཉིད་ ལས་སྒྲིབ་ དག་ ཕྱིར་ བྱ ། །"
msgstr "Doing it to clean my karmic obscurations."

msgctxt "bf0e8345245949c8b69f9deeea58cf27"
msgid "དེང་ འདི་␣ར་ རང་ཅག་ རྣམས་ ཀྱི་ མེ་ཏོག་ གང་ ལ་ ཕོག་པ་␣འི་ ལྷ་ སྐལ །"
msgstr "At present, our destined deity on whom we bestow our flowers."

msgctxt "87547b540be34b28afacb4fdd7d7d402"
msgid ""
"ཆོས་རྗེ་ རིན་པོ་ཆེ་␣འི་ གསུང་ དམ་ཆོས་ དགོངས་པ་ གཅིག་པ་␣འི་ གཞུང་བཟང་ "
"ཡིད་བཞིན་ གྱི་ ནོར་བུ་ རྡོ་རྗེ་␣འི་ གསུང་ བརྒྱ་ དང་ ལྔ་ བཅུ །"
msgstr ""
"The precious Dharma Lord's teaching, The Single Intent A 150-vajra speech of"
" the holy Dharma, is an excellent text of wish-fulfilling jewel."

msgctxt "cb8a74b7d65d41ee9364bdb2f844a22d"
msgid ""
"ལྷན་ཐབས་ བཞི་ བཅུ་པ་␣འི་ དོན་ བཟང་པོ་ བདེ་བླག་ ཏུ་ རྟོགས་ ཆེད་ ཚིག་དོན་ གྱི་"
" རྣམ་བཤད་ འདི་ཉིད་ འཆད་པ་ ལ །"
msgstr ""
"This complete explanation of the words and their meanings is expounded to "
"easily comprehend the excellent meanings of the forty addendums. "

msgctxt "14e06ad73c8f4a0ea810cecb91a364d7"
msgid "ཐོག་མ་␣ར་ དགེ་བ་ མཚན་ གྱི་ དོན་ དང༌ །"
msgstr "The virtuous in the beginning are the meaning of the title and"

msgctxt "c5db631a1c24444781cb7d467ccdb835"
msgid "འགྱུར་ཕྱག་ གཉིས་ ལ་␣ས །"
msgstr "the translator's homage, from these two."

msgctxt "9117a3482ea84b718b36dde205762fc0"
msgid "དང་པོ །  མཚན་དོན་ ནི །"
msgstr "First, the meaning of the title is"

msgctxt "220661768d7f4d7ba2f208c6feff644d"
msgid "རྡོ་རྗེ་ སྟེ་ མཚོན་བྱེད་ དཔེ་ མཚོན་བྱ་ དོན་ གྱི་ རྡོ་རྗེ་ མཚོན་ ཏེ །"
msgstr ""
"Vajra is an illustrative example that illustrates the ultimate vajra, which "
"is the object of illustration."

msgctxt "172c46858dee4945bc16609d92aa9f0c"
msgid ""
"སྒྲ་ རྟོག་ གི་ རྟོགས་པ་␣ར་ དཀའ་བ་␣ས་ ཟབ་མོ་ ལྟ་ངན་ གཞན་ གྱིས་ མི་ ཐུབ་པ་ དང༌"
" །"
msgstr ""
"It is profound because it is difficult to realize by sound and "
"conceptuality, and other bad views are unable to withstand and"

msgctxt "5a1cd4ec845c4763ad75042cca2edddd"
msgid "སྟོང་ཉིད་ མི་ཕྱེད་པ་ དང༌ །"
msgstr "Emptiness is not distinguished and "

msgctxt "dabc2eae160f4aed9ff294363933c639"
msgid "རྡོ་རྗེ་ རིན་ཆེན་ ལྟར་ དཀོན་པ་␣ས་ ན་"
msgstr "rare like precious vajra."

msgctxt "5679f3db421348db954d5c147343b71f"
msgid ""
"རྡོ་རྗེ་ སྟེ་ དེ་ལྟ་ བུ་␣འི་ གསུང་ གི་ གཞུང་ཚིག་ འབྲུ་ བརྒྱ་ ལྔ་ བཅུ་ ང་ "
"གཉིས་པ་ དང་ ལྷན་ཐབས་ ཞེ་ བདུན་པ་ ཞེས་ བྱ་བ །"
msgstr ""
"Vajra is like that of the textual words of the speech, one hundred fifty-two"
" statements and forty-seven addendums. "

msgctxt "bce0db62aa924f7ea94acecc10224960"
msgid "གཉིས་པ་ འགྱུར་ཕྱག་ ནི །"
msgstr "Second, the translator's homage is"

msgctxt "1b6df08e4e984cf383aea234162da044"
msgid "གནས་ དང་ གནས་མིན །"
msgstr "Abiding and non-abiding"

msgctxt "1f096193bfb04cb0bf62f1ad61526525"
msgid "ལ་␣ས་ ཀྱི་ རྣམ་སྨིན །"
msgstr "The complete ripening of karma,"

msgctxt "2a74a46ab539449597e83fcd1cac2973"
msgid "དབང་མཆོག་ མཆོག་ མིན །"
msgstr "the excellent and not excellent faculties,"

msgctxt "44de76d3f0d94942943310f642b8eee5"
msgid "ཁམས་ སྣ་ཚོགས །"
msgstr "the various constituents,"

msgctxt "96f3f5e9e7bb459ebe9aabb507bb9689"
msgid "མོས་པ་ སྣ་ཚོགས །"
msgstr "the various interests,"

msgctxt "73139d67ef3a4372bf811c0cb26c6483"
msgid "ཀུན་ ནས་ འགྲོ་བ་␣འི་ ལམ །"
msgstr "the path that everyone follows,"

msgctxt "d821c017b8644546971b21271029476c"
msgid "བསམ་གཏན་ དང་ རྣམ་ཐར །"
msgstr "meditative absorptions and complete liberation,"

msgctxt "b87c994717df4195984faea7b59522e9"
msgid "སྔོན་ གནས་ རྗེས་དྲན །"
msgstr "remembering the past places,"

msgctxt "2439c187a1004855810db38357107e89"
msgid "འཆི་ འཕོ་ དང་ སྐྱེ་བ །"
msgstr "death-transference and birth,"

msgctxt "5a4670a2f23e416f8365dd6f607beed1"
msgid "ཟག་ཟད་ དེ་ བཅུ་པོ་ དེ་ མཁྱེན་པ་␣ས་ ན་"
msgstr "the exhaustion of the outflows, by knowing these ten,"

msgctxt "d9f86590f0a24ba8819d4082f0c50d40"
msgid ""
"སྟོབས་ བཅུ་ སྟེ་ དེ་ལྟ་␣འི་ ཚུལ་ ལ་ དབང་ཕྱུག་ ཕ་ ཤཱཀྱ་ སྟེ་ ནུས་པ་ ལ་ "
"འཇུག་པ་␣ས་"
msgstr ""
"The ten strengths, in this way, like father Shakya who has complete control,"
" has engaged in power."

msgctxt "737ffef63d5f410c87feffb94311695c"
msgid ""
"དེ་␣འི་ བདག་ཉིད་ མུ་སྟེགས་ རྣམས་ སྐྲགས་པ་␣ར་ མཛད་པ་␣འི་ སེང་གེ་ ལྟ་བུ་␣འི་ "
"ཐུབ་དབང་ དེ་ ལ་ ཕྱག་ འཚལ་ ལོ ། །"
msgstr ""
"All tirthikas of this kind were frightened and paid obeisance to the lion "
"like the Lord of Sages."

msgctxt "7988a4a16faf44b3b9a0064d73876976"
msgid "དུག་ གསུམ་ མམ་ སྒྲིབ་ གསུམ་ གྱི་ དྲི་མ་ མེད་པ་␣ས་"
msgstr "There are no stains of the three poisons or three obscurations."

msgctxt "be01f3746825497fb24d03e67123482f"
msgid "སྤང་བ་ དང་ རང་བཞིན་ འོད་གསལ་"
msgstr "After being abandoned, [its] intrinsic nature is luminous."

msgctxt "d2384ed6816c458f8bae6c74afbb7731"
msgid ""
"མཚན་མ་␣འི་ རྡུལ་བྲལ་ སོ་སོ་ རང་རིག་ ཡེ་ཤེས་ ཀྱིས་ མཉམ་བཞག་ ཏུ་ གཟིགས་པ་ "
"ཇི་ལྟ་བ་ དང༌ །"
msgstr ""
"The primordial wisdom of individual self-knowing, free from the dust of "
"marks, observes in meditative equipoise just how it is."

msgctxt "6f572b4e1bd9448983d7a118d774ac83"
msgid "དེ་␣འི་ རྗེས་ཐོབ་ ཐུགས་ ཀྱི་ དཀྱིལ་འཁོར་ དུ །"
msgstr "In its post-attainment, at the mandala of the mind,"

msgctxt "c40f2ccc4a074cdcb3f8b4ad55583a72"
msgid "མཚན་ཉིད་ སོ་སོ་␣ར་ རེ་རེ་ ནས་ མ་ འདྲེས་པ་"
msgstr "Every characteristic, without being mixed."

msgctxt "3c26c951ade74a3d9aa6f06709a76011"
msgid "ཤེས་བྱ་␣འི་ དངོས་པོ་ མ་ལུས་པ་ ཀུན་ ཇི་ལྟ་བ་ དེ་ལྟར་ དང་ །"
msgstr "All the knowable things, none excluded, exactly as how they are and "

msgctxt "d3db5456f3264751bfb5e320fb714471"
msgid "ཐམས་ཅད་ ཆགས་ ཐོག་ བྲལ་བ་␣ས་"
msgstr "Everything is free from the impediment of desire."

msgctxt "8ac130464f71455fa6bb3b6c1b359d21"
msgid "ལམ་ མེ་␣ར་ གཟིགས་པ་ ཇི་སྙེད་པ་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ ཏེ་"
msgstr ""
"The primordial wisdom which knows the entire knowledge of omniscience "
"brilliantly,"

msgctxt "b8f68cf513b14a69b3c60e05d1e50f07"
msgid ""
"དེ་ལྟར་ སྤང་བ་ དང་ རྟོགས་པ་ ཕུན་སུམ་ ཚོགས་པ་␣འི་ བདག་ཉིད་ ཀུན་མཁྱེན་ ཆོས་ "
"ཀྱི་ རྗེ །"
msgstr ""
"Like that, the all-knowing great being, the dharma lord who has perfectly "
"accumulated abandonments and realizations. "

msgctxt "bac7e79b7ef349939a148fba0199dd8c"
msgid "དཔེ་ཟླ་ བྲལ་བ་␣ས་ མཉམ་པ་ མེད་པ་"
msgstr "Who is unequaled because [he] is beyond example."

msgctxt "cd20f0839a6f40399d51bf2aa7ac6945"
msgid ""
"འབྲི་གུང་ རིན་ཆེན་ ཏེ་ དགོས་འདོད་ ཐམས་ཅད་ སྟེར་བ་ དེ་ ལ་ ཕྱག་ འཚལ་ ལོ ། །"
msgstr "[I] pay homage to Drigung Rinchen, who bestows all needs and desires."

msgctxt "47100e1eefef403c987c18b85d3db068"
msgid "རྒྱལ་བ་ སངས་རྒྱས་ མཆོག་ གི་ ཞལ་ ནས་ གསུངས་པ་ ཡི་"
msgstr "The supreme conqueror, Buddha, said."

msgctxt "358138e8e67444ff916ba7a32f41f66d"
msgid ""
"མདོ་ རྒྱུད་ དམ་པ་␣འི་ ཆོས་ རྣམས་ ཇི་བཞིན་ ཐུགས་ སུ་ ཆུད་པ་ ལ་ བརྟེན་ ནས་"
msgstr ""
"Depending on how the mind understands the holy Dharmas of sutra and tantra,"

msgctxt "f2d9d7a40f494a41a4d1284ec86101a4"
msgid "ཁྱད་པར་ དུ་ འཕགས་པ་ ཟབ་མོ་␣འི་ དོན་ ཐུན་མོང་ མ་ཡིན་པ ། །"
msgstr "The profound meaning is especially exalted and extraordinary."

msgctxt "86376e626d2946a1926c2e56b464d245"
msgid ""
"སྔོན་ དུ་ འཇིག་རྟེན་ མགོན་པོ་␣ས་ མཛད་པ་␣འི་ བཞེད་སྲོལ་ དཔག་ ཏུ་ མེད་པ་ ཐོས་ "
"ཀྱང་"
msgstr ""
"Although, I have listened to unfathomable philosophical explications by "
"Jigten Gonpo in the past,"

msgctxt "9b61d09f9444471eae1994a9be3f11f9"
msgid "མི་ བརྗེད་པ་␣འི་ གཟུངས་མ་ ཐོབ་པ་ རྨོངས་པ་␣ས་"
msgstr ""
"Because of ignorance and not attaining the retainer of unforgetfulness,"

msgctxt "88231025a9b7491e82bc166fffaa138e"
msgid "ཐམས་ཅད་ བློ་␣ར་ མ་ ཆུད་པ་␣ས་ དྲན་པ་ ཅུང་ཟད་ ཙམ་ ཞིག་ བྲི །"
msgstr ""
"Since I have not comprehended everything, I have written only a little of "
"what I remember."

msgctxt "b065875dda22411cb2fc2aa44358e6c7"
msgid "༈  རྡོ་␣༽༽  གཞན་དག་ ན་རེ །"
msgstr "Vajra: Others say,"

msgctxt "391c48714d824c6c9c682f07eb6d7f37"
msgid "དེ་བཞིན་ གཤེགས་པ་ ནི་ ཆོས་ ཀྱི་ དབང་ཕྱུག་ ཡིན་པ་␣ས་"
msgstr "As Tathagata is the powerful lord of the Dharma,"

msgctxt "de118e9afeec4ab6a343bb06b503465f"
msgid "དེ་␣ས་ ཇི་ལྟར་ བཞེད་པ་ དེ་ལྟར་ འགྱུར་ ཏེ །"
msgstr "Whatever he accepts, it will become that way."

msgctxt "6a569e54ef104dad8af8a94fdd8d659b"
msgid "ཆོས་ ཐམས་ཅད་ ལ་ དབང་ བསྒྱུར་བ་ ཉིད་ ཀྱིས་ སོ་ ཞེས་ འདོད་ དོ ། །"
msgstr ""
"As [they] accept that this is because of having complete control over all "
"phenomena."

msgctxt "64a62d4431f047a59f85693b656f5f66"
msgid "འདི་␣ར་ ནི །"
msgstr "In this [system],"

msgctxt "2897dd4ad3f04d5096b4e672c8d815ce"
msgid ""
"ཆོས་ ཀུན་ གྱི་ གཤིས་ སམ་ བབ་ ཀྱི་ རང་བཞིན་ སྟོང་ཉིད་ གནས་ཚུལ་ སངས་རྒྱས་ "
"ཀྱིས་ བསྟན་པ་ ཡིན་ ཏེ །"
msgstr ""
"The Buddha taught the intrinsic nature or natural state of all phenomena is "
"emptiness."

msgctxt "c2eed4e74c2c4379bc4520789470eb72"
msgid "ཆོས་ ཀུན་ རྣམ་པ་␣ར་ དག་པ་␣འི་ ངོ་བོ་ སངས་རྒྱས་པ་␣ས་"
msgstr "The Buddha is the completely pure essence of all phenomena,"

msgctxt "e9d2ce430f484f268869d68a28356f19"
msgid "ཕྱྭ་ དང་ དབང་ཕྱུག་ ལྟར་ བྱེད་པོ་ མིན་པ་ དང༌ །"
msgstr "And this is not by chance or an act of Ishvara,"

msgctxt "bb652b8fdc184e62aafb27bb6faac75e"
msgid "ཆོས་ རྣམས་ ཀྱི་ གནས་ལུགས་ འདི་ལྟར་ ཡིན་པ་ དེ་"
msgstr "The actuality of all phenomena such as this, "

msgctxt "42386f2e8d064507992baedb7e742abf"
msgid "བརྩེ་བ་␣ས་ སེམས་ཅན་ རྣམས་ ལ་ སྟོན་པ་␣ར་ མཛད་པ་ དང༌ །"
msgstr "is taught by the Buddha out of love for sentient beings."

msgctxt "a5f93ac106b54959898328001f7541da"
msgid "རང་བཞིན་ སངས་རྒྱས་ ཀྱིས་ ཀྱང་ བསྒྱུར་ དུ་ མེད་པ་ དང༌ །"
msgstr "Even the buddhas cannot change the intrinsic nature and "

msgctxt "9ed2c66d740249ecab7044a5f47cd41e"
msgid "རྟེན་འབྲེལ་ གྱི་ གཤིས་ བསླུ་བ་ མེད་པ་ མཐོ་དམན་ ཀུན་ ཏུ་ འབྱུང་བ་ དང༌ །"
msgstr ""
"The nature of interdependence is not deceiving; it occurs to all, high or "
"low."

msgctxt "8aa6b3159e8940848f3abdb21a0f7176"
msgid "གནས་ དང་ གནས་མ་ ཡིན་པ་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ ཀྱི་ ཕྱིར །"
msgstr ""
"This is because of the primordial wisdom of knowing [what is] abiding and "
"[what is] non-abiding."

msgctxt "8efc5d073ff84ce08af373d461eace42"
msgid "བབ་ ཀྱི་ གནས་ལུགས་ བསྟན་ ཏེ །"
msgstr "The actuality of the state is taught,"

msgctxt "bf62eb4a3e5e467d9ba5b363768de34a"
msgid "གནས་ལུགས་ སམ་ རྟེན་འབྲེལ་ དེ་ དང་ གཅིག་ དང་ དུ་མ་␣ར་ གསུངས་ ཀྱང་"
msgstr "Though actuality or interdependence is said to be one and many."

msgctxt "eefca07633c542498ea58349aefea9d7"
msgid "རྒྱུ་འབྲས་ ཀྱི་ དབང་ དུ་ ན །"
msgstr "In terms of cause and effect,"

msgctxt "e18751029f3c44408076ea8c051fb336"
msgid "ཉེས་པ་ མི་དགེ་བ་ སྡུག་བསྔལ་ རྒྱུ་འབྲས་ སྤོང་བ་␣འི་ ཐབས་ བསྟན །"
msgstr ""
"The method of abandoning the bad non-virtue, the cause and effect of "
"suffering are taught. "

msgctxt "ca11e078ef2c4ad4a60a48469d6ace22"
msgid "དགེ་བ་ བདེ་ལེགས་ ཀྱི་ ལ་␣ས་ སྒྲུབ་པ་␣འི་ ཐབས་ཚུལ་ ལ་"
msgstr ""
"To arrange one on the methods of accomplishing the karma of virtue, "
"happiness, and goodness,"

msgctxt "8140bd0581e242679140e7daccf8f470"
msgid "འགོད་པ་␣ས་ སངས་རྒྱས་ ཀྱི་ ཆོས་ ཏེ་"
msgstr "That is the teachings of the Buddha."

msgctxt "05174412301c487bae98aea02d1ec694"
msgid ""
"སྣང་བ་ རྟེན་འབྲེལ་ དང་ རྟེན་འབྲེལ་ སྟོང་པ་ དངོས་པོ་␣འི་ གཤིས་ ཡིན་པ་␣ས་ "
"དེ་ལྟར་ བསྟན་ ཏེ །"
msgstr ""
"Appearances are interdependent, and interdependence is empty. This is the "
"intrinsic nature of things. Thus, it is taught in this way."

msgctxt "221d8295aa004997b2a286a07de37232"
msgid "འོ་ན་ དབང་ བསྒྱུར་བ་ མི་ འགྲུབ་བོ་ སྙམ་ ན །"
msgstr ""
"Well then, If [one] wonders that the complete control will not be "
"accomplished."

msgctxt "ca723417c9b242b29c735555d54f4188"
msgid "དེ་ ནི་ གཤིས་ བབ་ བསྒྱུར་བ་ མ་ ཡིན་ ཏེ་"
msgstr "That is not due to changes in nature."

msgctxt "b46162a2916b4d7e96709dcfbb53e1a3"
msgid ""
"སྐྱོན་ སྤོང་བ་ དང་ ཡོན་ཏན་ སྒྲུབ་པ་␣འི་ ཚུལ་ ཐམས་ཅད་ མི་ གཟིགས་པ་␣འམ་ "
"མངོན་དུ་ མ་ མཛད་པ་ གང་ཡང་ མེད་པ་␣ས་"
msgstr ""
"That is because of not observing or actualizing any of the ways of "
"abandoning faults and accomplishing good qualities."

msgctxt "24fc6b3ef12048109d467c606d14bd69"
msgid "ཆོས་ ཐམས་ཅད་ ལ་ དབང་ བསྒྱུར་ ཞེས་ བྱ །"
msgstr "And saying complete control over all phenomena."

msgctxt "abff3898f21b434ba2d8c973eab63ff0"
msgid "མི་ མཚུངས་ བློ་ ལ་␣ས་ འདས་པ་␣འི་ རྫུ་འཕྲུལ་ བསྟན་པ་ ཡང་"
msgstr ""
"Further, the showing of miraculous displays beyond the dissimilar mind"

msgctxt "08b19e190f3241979dce62f551966380"
msgid "རྒྱུ་རྐྱེན་ རྟེན་འབྲེལ་ གྱི་ གཤིས་ བབ་ བསྟན་པ་ ཡིན་ ནོ ། །"
msgstr "The interdependent nature of cause and condition is taught."

msgctxt "cd412bea3c794bffa6378aa29e3de155"
msgid "དེ་སྐད་ དུའང་"
msgstr "As it is also said:"

msgctxt "e800900bd4d345009a6d5c61f5fd50c3"
msgid "རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་ མ་གཏོགས་པ་␣འི ། །"
msgstr "Other than dependent-related arising,"

msgctxt "58337c86f23c49afa46021db6715376e"
msgid "ཆོས་ འགའ་ ཡོད་པ་ མ་ཡིན་པ ། །"
msgstr "There is not a single phenomenon,"

msgctxt "6620beb675154e7898002aad83261f91"
msgid "དེ་ཕྱིར་ སྟོང་པ་ མ་ཡིན་པ་␣འི ། །"
msgstr "Because of that, something not being emptiness,"

msgctxt "25468ea5b2b044439e400a9ed7c34211"
msgid "ཆོས་ འགའ་ ཡོད་པ་ མ་ ཡིན་ ནོ ། །"
msgstr "There is not a single phenomenon."

msgctxt "e8c0965bf21c435baea5c7965232b503"
msgid "ཅེས་ དང་ །"
msgstr "And,"

msgctxt "b90ef37ddf724420a86c332f5930eff8"
msgid "གང་ ལ་སྟོང་པ་ ཉིད་ རུང་བ ། །"
msgstr "Where emptiness is acceptable,"

msgctxt "14afc3816a4c45f8a648136f20cfc7cc"
msgid "དེ་ ལ་ ཐམས་ཅད་ རུང་བ་␣ར་ འགྱུར །"
msgstr "Everything becomes acceptable upon it. "

msgctxt "3aa7e517b01a4052b6c6716aabcf2bbf"
msgid "སོགས་ དང༌ །"
msgstr "And so on."

msgctxt "9b90e7306e83430d8c036d34ea2df521"
msgid "གང་ཞིག་ རྐྱེན་ ལ་ སོཌ་ དང །"
msgstr "The one which condition and so on."

msgctxt "867b016b54a941c89a1ca9991cf9fa43"
msgid "ལྗོན་པ་␣ས་ ཞུས་པ་␣འི་ མདོ་␣ར །"
msgstr "According to the Sutra of Requisition by Jonpa:"

msgctxt "4dbb6ea876604037b920ce729fd9fa48"
msgid "རྒྱུ་ལ་ བརྟེན་ པའིམཁས་པ་ བཅོམ་ལྡན་འདས ། །"
msgstr "The Blessed One, you are an expert in relying on causes."

msgctxt "cf2c9d40257d4d64b493dcebd1791298"
msgid "མཐའ་ གཉིས་ ལྟ་བ་ རྟག་ ཏུ་ མི་ མངའ་ ཞིང༌ ། །"
msgstr "Never having the views of the two extremes."

msgctxt "94b529dd840c42068f6911b0956b8810"
msgid "ལ་␣ས་ ཀྱི་ རྣམ་སྨིན་ འབྲས་བུ་ དེ་ཉིད་ གསུངས ། །"
msgstr "The complete ripening of karma, the result of thusness is taught."

msgctxt "2bb7c8e9977540ce9b1fce856177a9d5"
msgid "ལྟ་བ་␣འི་ མུན་འཇོམས་ ཁྱོད་ ལ་ ཕྱག་ འཚལ་ ལོ་ ༑"
msgstr "I pay homage to you for defeating the darkness of the view."

msgctxt "3b79fd1bea654fa08a964e9c9ec326b6"
msgid "ཞེས་ སོ ། །"
msgstr "As stated."

msgctxt "ee569ec038f54ea1963d61ec029fa57f"
msgid "ལུགས་ འདི་ ལ་␣ས་ གཞན་ དུ་ ན་"
msgstr "Other than this system,"

msgctxt "90f7010ac1094304a46c59e1759d0f1f"
msgid "བདེ་གཤེགས་ བྱེད་པོ་␣ར་ ཐལ་བ་ དང་ །"
msgstr "It absurdly follows that Sugata as a doer and "

msgctxt "1de3c8cb812b449281de97dcc65ed36a"
msgid "གནས་ དང་ གནས་མིན་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ མེད་པ་ ཐལ་བ་ སོགས་"
msgstr ""
"It follows the absurd consequence of the non-existence of the primordial "
"wisdom of knowing [what is] appropriate and [what is] inappropriate and so "
"on."

msgctxt "ce1846eddb5342da9adb686011e51f56"
msgid "ཉེས་པ་ བསྟན་ རྣམས་ ལྡོག་ ཏུ་ མེད་ དོ །"
msgstr "The faults that have been shown are irreversible."

msgctxt "8517dd999cbc4cbf8dba3ea9326893c2"
msgid "༈  ལྷན་␣༽༽  མཁས་པ་ གཞན་ གྱིས་ གདུལ་བྱ་ ཐ་དད་ ལ་"
msgstr "Addendum: Other experts stated that for distinct disciples,"

msgctxt "67babd5f19f847819c3fb1e041d3b704"
msgid "ཐེག་པ་␣འང་ སྣ་ཚོགས་ སུ་ བསྟན་པ་␣ས་ ཐ་དད་ དོ་ ཞེས་ ཟེར་ རོ །"
msgstr "different vehicles are also taught, therefore they are distinct."

msgctxt "d47436febd2a4fe29bb115978d5c8508"
msgid "འདི་␣ར་ ནི་ ཕྱོགས་ བཅུ་ དུས་གསུམ་ གྱི་ རྒྱལ་བ་ མ་ལུས་པ་ ཀུན་ གྱི་"
msgstr ""
"In this [system], all of the conquerors from the ten directions and three "
"times,"

msgctxt "1bdf7c6a768e4a20ae27927a7a831451"
msgid "ཆོས་ རྣམས་ བསྟན་པ་␣འི་ ཐབས་ ནི་ གཅིག་ ཏུ་ འདོད་ དེ་"
msgstr "The method of showing the Dharma is one, as it accepts that."

msgctxt "9f2c9237f8f94325bcdf89c3103ddfd0"
msgid "སངས་རྒྱས་ ཞེས་པ་␣འི་ ཡི་གེ་ དང་"
msgstr "The word so-called Buddha and "

msgctxt "2687d3b13da7490aa62ca78ef961f784"
msgid "གསུངས་ དབྱངས་ ཡན་ལག་ དྲུག་ བཅུ་ དང་"
msgstr "The sixty-melodious branch of speech and "

msgctxt "9d6c901ee70f4086ae01887c7b7c70d9"
msgid "ཆོས་ བྱང་ཕྱོགས་ སོ་ འདུན་ དང་"
msgstr "The thirty-seven factors harmonious with enlightenment and "

msgctxt "d025da28424946fbbdfbbe3200847936"
msgid "སྐུ་ཆོས་ སྐུ་ དང་ གཟུགས་སྐུ་ མཚན་དཔེ་␣འི་ རྒྱན་པ་ དང་ བཞི་པོ་ དེ་"
msgstr ""
"Kaya as dharmakaya and rupakaya adorned with the major and minor marks and "
"these four,"

msgctxt "9b6a4a98315f46aab0966f6e902789a2"
msgid "སངས་རྒྱས་ ཐམས་ཅད་ ལ་ མཚུངས་པ་␣ས་ བསྟན་པ་ གཅིག་ སྟེ་"
msgstr "are similar to all the buddhas, therefore [their] teachings are one."

msgctxt "0df24270d1fe4f48a972143879b9187b"
msgid "ལང་ཀ་␣ར་ གཤེགས་པ་ ལ་␣ས །"
msgstr "According to the Descent to Lanka Sutra:"

msgctxt "d18dbad99242482eb5b6dcc8053beec9"
msgid "འོད་སྲུང་ ལོག་པ་␣ར་ དད་ སེལ་ དང༌ །"
msgstr "Kashyapa, Krakucchanda and "

msgctxt "48943094de1b449496f84e17ca64c822"
msgid "གསེར་ཐུབ་ དག་ ཀྱང་ ང་ ཡིན་ ཅེས །"
msgstr "Kanakamuni are all me."

msgctxt "818d7f38b7124ba9b6292df2c76a22a9"
msgid "མཉམ་པ་ཉིད་ དུ་ མཉམ་ གྱུར་པ་␣ས །"
msgstr "Since [everyone] has become same equally,"

msgctxt "fd0dd0a1f0fe4e55ba547234048f935c"
msgid "རྒྱལ་བ་␣འི་ སྲས་ ལ་ ངས་ བཤད་ དོ །"
msgstr "I have explained to the sons of the conqueror."

msgctxt "62bc2f95a72c46fcb01708f1a350fe9e"
msgid "ཅེས་པ་␣ས་ སངས་རྒྱས་ རྣམས་ དང་པོ་ ཐུགས་བསྐྱེད་ ཚུལ །"
msgstr "Thus, how the buddhas first generate the mind [for enlightenment]."

msgctxt "6dd5e0c6d5004290bf7b2cafc0ceb78d"
msgid "བར་ དུ་ ལམ་ བསྒྲོད་ ཚུལ །"
msgstr "The middle is the way of traversing the path. "

msgctxt "d275441655f840d5b83adbb8419eaf94"
msgid "ཐ་མ་ སངས་རྒྱས་ ནས་ ཆོས་འཁོར་ བསྐོར་བ་ དང་"
msgstr ""
"The final is the turning of the Dharma Wheel after attaining buddhahood."

msgctxt "b6ab74eec63e470fbaecd1a984def697"
msgid "འབྲས་བུ་ དང་ བཅས་པ་ སེམས་ཅན་ ཁོ་ན་␣འི་ དོན་ ཡིན་པ་␣ས་ སོ་␣༑"
msgstr "Having the result is exclusively for sentient beings."

msgctxt "b9584d003d3843bd9995970cc06f66b6"
msgid "ལྷན་␣༽༽  ཁ་ཅིག་ ན་རེ །"
msgstr "Addendum: A certain person says:"

msgctxt "1aa9be0c8b1c4d1d90bede6f840becca"
msgid "སངས་རྒྱས་ ཀྱི་ ཆོས་ ཐེག་པ་ དང་ གྲུབ་མཐའ་ ཐ་དད་ ངེས་པ་ ཅན་ ཏེ་"
msgstr ""
"The Dharma, vehicles, and philosophical systems of the Buddha are distinct "
"and definitive because"

msgctxt "ee78f774c6c54828bebdd59c59064b98"
msgid "འཇིག་རྟེན་ ལ་ལ་␣ར་ ཀུན་ ཏུ་ གཟིགས་ ལྟ་བུ་␣ས་ ཐེག་ཆེན་ འབའ་ཞིག  །"
msgstr ""
"In some worlds, like Samantadarsin [who will] only [give] the Great Vehicle "
"[teachings],"

msgctxt "72c1484aa77f47e4947698e57afd6f18"
msgid "ཞི་བ་␣འི་ བློ་གྲོས་ ལྟ་བུ་␣ས་ ཐེག་ཆུང་ དང་ །"
msgstr "like by Santamati, the Lesser Vehicle [teachings],"

msgctxt "4e9b12ec32854a5d8607d04f477f6817"
msgid "གཟི་བརྗིད་ ཡོན་ཏན་ ལྟ་བུ་␣ས་ བསྙེན་གནས་ གཅིག་པུ་ དང་ །"
msgstr "like by Guna­tejas, only precepts and "

msgctxt "811850e3aad54286bffc18ff446e86a0"
msgid "ལ་ལ་␣ར་ གསང་སྔགས་ ཁོ་ན་ སོ་སོ་␣ར་ རྟོགས་པ་␣འི་ ངེས་པ་ ཅན་ ཡིན་ ནོ ། །"
msgstr ""
"The secret mantra alone to some [disciples], are the definitive realizations"
" of individuals."

msgctxt "f247f286ce8e44219a8fdef29bc158e4"
msgid "ཞེས་ ཟེར་ རོ །"
msgstr "As said."

msgctxt "af46fc5cb55a4108b68e82a35fea8abc"
msgid ""
"འདི་␣ར་ ནི་ སངས་རྒྱས་ གྱི་ ཐེག་པ་ དང་ གྲུབ་མཐའ་ ཡི་ ཆོས་ ཐམས་ཅད་ རྟེན་འབྲེལ་"
" འབའ་ཞིག་ ཡིན་ ཏེ །"
msgstr ""
"In this [system], only interdependence is the vehicle and all the "
"philosophical Dharma of the Buddha."

msgctxt "c9b6c4f5aa0e4b0dbb33df53920b9cc5"
msgid "རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་ མ་གཏོགས་པ་ སོགས་ ཞེས་པ་ ལྟར་"
msgstr "Other than dependent-related arising, as said so on. "

msgctxt "77326febb928436b82cf43ffd785b029"
msgid ""
"དུས་གསུམ་ གྱི་ སངས་རྒྱས་ ཐམས་ཅད་ ཀྱིས་ མངོན་དུ་ མཛད་པ་␣འི་ ཆོས་ ཐམས་ཅད་ "
"རྟེན་འབྲེལ་ ཏེ །"
msgstr ""
"All phenomena actualized by the buddhas of three times are interdependent."

msgctxt "24f10f63b0a6455190d10917aeef1a7e"
msgid "དེ་␣འང་ ཚིག་དོན་ གཉིས་"
msgstr "That, too, is the words and their meaning, two."

msgctxt "bf3d2a8ca5f941e4a99c951877208fe4"
msgid "དོན་ ལ་␣འང་ ཕྱི་ ནང་ གསང་ གསུམ་ ཐུགས་ སུ་ ཆུད་ མཁན་ དང་ བཞི །"
msgstr ""
"The meaning also includes the one who understands the inner, outer, and "
"secret [meanings] and four. "

msgctxt "861a0dcbb630416eb5e95f47253e0270"
msgid "དང་པོ་ ལ་ རླུང་ བརྟེན་ དེ་ ལ་ ཆུ་ སོགས་ དང་ །"
msgstr "The first is wind support, followed by water and others, "

msgctxt "2b3c9ccea95c4211b9db4cf7b8ec98b4"
msgid ""
"གཉིས་པ་ སྟོང་ བཞིན་ རྒྱུ་འབྲས་ སུ་ འབྱུང་བ་ ཕྱག་རྒྱ་ ཆེན་པོ་␣འི་ དོན་ དང༌ །"
msgstr ""
"The second is empty and occurs in cause-and-effect, which is the meaning of "
"mahamudra. "

msgctxt "7d008e955b3740a4b04479ed5e226d96"
msgid "ནང་ གི་ རྟེན་འབྲེལ་ ལ་␣ས །"
msgstr "From the inner interdependence,"

msgctxt "6c05c8796b314dd4a1c31c51a797ead7"
msgid "ཕྱི་ སྣོད་ དུ་ སྣང་བ་ དང་ བཅུད་ རྣམས་ རྒྱུ་ དེ་ལས་ འདི་ འབྱུང་བ་ དང༌ །"
msgstr ""
"This appearance of the outer container and the inner content emerge from "
"that cause."

msgctxt "b42c3db67dc64697bd26df7f5a9bc1fa"
msgid "གསུམ་པ་ ཕྱི་␣འི་ དངོས་པོ་ བྱ་བ་ འདི་ དང་ འདི་ འགྲུབ་ ཚུལ་ ལོ ། །"
msgstr "The third is the action of the outer thing and how it was produced."

msgctxt "994d634e540c4f93a8182f8f1eb97036"
msgid "གསུམ་པ་ གསང་བ་ རང་བཞིན་ གྱི་ བསམ་པ་"
msgstr "The third is the secret nature of the mind. "

msgctxt "307a1684fa484c00aef18074c1e04bd1"
msgid ""
"ལུས་ ཀྱི་ རྟེན་འབྲེལ་ སྐྱོན་ཡོན་ གྱི་ རྒྱུ་རྐྱེན་ ཐམས་ཅད་ དེ་␣ར་ གནས་པ་␣ས་ "
"སོ ། །"
msgstr ""
"The interdependence of the body, all the causes and conditions of faults as "
"well as good qualities remained on that."

msgctxt "472f31f2cd334ddaa957dd83776e650e"
msgid "གང་ཟག་ ནི་ ཆོས་རྗེ་ ལྟ་བ་␣འོ །"
msgstr "View the person as a dharma lord."

msgctxt "baff2aa82a514514899af3828537fbce"
msgid ""
"༈  རྡོ་␣༽༽  འདི་␣ར་ ནི་ ཆོས་ཕུང་ བརྒྱད་ ཁྲི་ ཉོན་མོངས་ ཐམས་ཅད་ ཟད་པར་ "
"སྤོང་བ་␣འི་ ཐབས་ ཡིན་པ་␣ས་"
msgstr ""
"Vajra: In this [system], the eighty-four thousand Dharma teaching is the "
"method to abandon all afflictions. "

msgctxt "528f78feea0e416fbc8ee661cf0375d5"
msgid "དེས་ན་ སངས་རྒྱས་ སྒྲུབ་པ་␣ར་ ཟག་པ་ བག་ཆགས་ དང་ བཅས་པ་ སྤོང་ དགོས་པ་"
msgstr ""
"Thus, to accomplish buddhahood, [one] must abandon it together with the "
"containments of latency."

msgctxt "110dcdaeac854e798b40d8d0d97b1f86"
msgid "དེ་␣འི་ ཕྱིར་ ཐབས་ གཅིག་ ཏུ་ ཤེས་ དགོས་ ཤིང༌ །"
msgstr "Because of that, [one] must know it in one method."

msgctxt "54b8894aaf044ea9b36d9cc7ec66158d"
msgid "གལ་ཏེ་ གཅིག་ མ་ཚང་ ཡང་"
msgstr "Even if one is incomplete."

msgctxt "2da5c0aff29048a3ab96585ea3475812"
msgid "དེ་ ཡི་ ངོ་སྐལ་ གྱི་ སྤང་བྱ་ མི་ སྤོང་བ་␣ས་"
msgstr "Its corresponding object of abandonment will not be abandoned."

msgctxt "f1596e071fe14ca2a432fe383dcadf75"
msgid "མཐར་ཐུག་ གི་ བྱང་ཆུབ་ མི་ ཐོབ་ སྟེ་"
msgstr "Thus, ultimate enlightenment will not be attained. "

msgctxt "28719e3145944b0fac0859f3a3707fef"
msgid "གཙུག་ ན་ རིན་པོ་ཆེ་␣འི་ མདོ་␣འི་ དོན་ རྒྱུད་ བླ་␣ར་"
msgstr "The meaning of the Jewel Crest sutra in The Highest Continuum"

msgctxt "d76bbdbed51a413a81966c530aec8f17"
msgid "ཇི་ལྟར་ རི་མོ་ བྲི་ བྱེད་པ་ སོགས་ ནས །"
msgstr "From, 'Just as a painting is made' and so on."

msgctxt "aa95a04249554c1387fb4578b3e0b950"
msgid "དེ་ རྣམས་ འབྲི་ བྱེད་ གང་ཡིན་པ །"
msgstr "Whatever the painting instruments are,"

msgctxt "f393295d10e24aee81acb2a19bd25243"
msgid "སྦྱིན་ དང་ ཚུལ་ཁྲིམས་ བརྗོད་ ལ་སོགས ། །"
msgstr "generosity, discipline, and so on are said. "

msgctxt "c019233ff46d4da8ac64cc0284c098a8"
msgid "རྣམ་པ་ ཀུན་ གྱི་ མཆོག་ལྡན་པ །"
msgstr "Endowed with excellence in all aspects,"

msgctxt "5c932eccca894da89ea69e4487a89b2e"
msgid "སྟོང་པ་ཉིད་ ནི་ གཟུགས་ སུ་ བརྗོད །"
msgstr "Emptiness is expressed in forms."

msgctxt "f277f011bcfa44f18c5b28d574e07449"
msgid "ཅེས་ དང༌ །"
msgstr "and."

msgctxt "952cc6802c4d4b999cf7eec39e475992"
msgid "ཇི་སྲིད་ དགེ་བ་␣འི་ རྩ་བ་ དེ་ ནི་ སོགས་ ཀྱིས་"
msgstr "As long as [one] accumulates the root of virtue from this."

msgctxt "7e415c323ade4c688b4b8291973cf5b7"
msgid "བོར་ རྒྱུ་ བཞག་ རྒྱུ་ རྡུལ་ ཙམ་ མེད་"
msgstr "There is nothing to discard or keep, not even a particle."

msgctxt "2b00b870f58549a59a187c916217652f"
msgid "ཐམས་ཅད་ ཉམས་ སུ་ ལེན་ དགོས་ སོ །"
msgstr "All of this must be practiced."

msgctxt "041c64fe69dc4bf682b12fb7b9dbaa08"
msgid "༈  ལྷན་␣༽༽  ཁ་ཅིག་ ན་རེ ། །"
msgstr "Addendum: A certain person says:"

msgctxt "da2eb3221098461488f693d2d8c34ef9"
msgid "ཆོས་ཕུང་ ནི་ བ་གླང་ གི་ རྒྱབ་ཁལ་ དང་"
msgstr "A dharma heap is [equivalent to] an ox's backpack and "

msgctxt "ce7d26c635d14034bd4b893f608e0139"
msgid "བསྟན་བཅོས་ ཚད་ དང་ ཕུང་པོ་ སོགས་ གཏམ་ རེ་ ཚང་བ་ སོགས་ འདོད་ དོ །"
msgstr ""
"[They] accept that the size of a treatise, heap, and others is equivalent to"
" each whole speech."

msgctxt "90f7adbcd145401fac531fc835f83b78"
msgid "འདི་␣ར་ ནི་"
msgstr "In this [system],"

msgctxt "85cbe3ce04c34a8a944ebfc960d31ccf"
msgid ""
"བརྒྱད་ ཁྲི་ བཞི་ སྟོང་པོ་ ཉོན་མོངས་ བརྒྱད་ ཁྲི་ བཞི་ སྟོང་ གི་ གཉེན་པོ་␣ར་ "
"བཞག་པ་"
msgstr ""
"The eighty-four thousand [heaps of the Dharma] serve as antidotes to the "
"eighty-four thousand afflictions."

msgctxt "91785dc6ca1549f2a1e16e987e32d2ce"
msgid "སྙིང་རྗེ་ པད་དཀར་ གསང་བ་ བསམ་ མི་ ཁྱབ་པ་ སོགས་ ལ་␣ས་ དང"
msgstr ""
"According to the Compassionate White Lotus, Inconceivable Secret and others,"

msgctxt "2827c39836594a8194f48bb12ed1f875"
msgid "རྣམ་སྣང་ མངོན་བྱང་ ལ་␣ས་ ཀྱང །"
msgstr "Also from Vairocana Sambodhi:"

msgctxt "e00fc80f3c1f47a59428edf198279585"
msgid "ཉོན་མོངས་ རྣམས་ ཀྱི་ གཉེན་པོ་␣ར་ ནི ། །"
msgstr "To the antidotes for all afflictions,"

msgctxt "f4406e6518514fde9fc6c2902b294f4f"
msgid "ཕུང་པོ་ བརྒྱད་ ཁྲི་ བཞི་ སྟོང་ གསུངས །"
msgstr "The eighty-four thousand heaps of [the Dharma] are taught."

msgctxt "f95520cbb53341ffbf726d8df0daa463"
msgid "མཛོད་ ལ་␣ས །"
msgstr "According to the Treasury of Abhidharma:"

msgctxt "c770d97723ce409e910662586a43941a"
msgid "སྤྱོད་པ་ རྣམས་ ཀྱི་ གཉེན་པོ་ ནི ། །"
msgstr "As the antidotes to all conducts,"

msgctxt "738f755f660f41939d98e5980033cc44"
msgid "ཆོས་ ཀྱི་ ཕུང་བོ་ མཐུན་པ་␣ར་ གསུངས །"
msgstr "The heaps of the Dharma are taught concordantly."

msgctxt "cb8d753a958949ee9a1e5ab99860db5d"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "9df07e8484aa4e7697cbf4db8d0ed8c1"
msgid "ཁ་ཅིག་ ན་རེ །"
msgstr "A certain person says:"

msgctxt "b70e94966fb94aca9f19a5a222e28017"
msgid "སྡེ་སྣོད་ རྒྱུད་སྡེ་ གང་རུང་ རེ་ ཉམས་ སུ་ བླངས་ ན་"
msgstr "If any of the pitakas or tantra sections is practiced,"

msgctxt "b092d3a9f1a848c29bca17f0381a8905"
msgid "མྱང་འདས་ ཐོབ་པ་␣ས་ གང་ མོས་ ཀྱི་ ལམ་ ཡིན་ ཅེས་ ཟེར་ རོ །"
msgstr "Nirvana will be attained, therefore this is the entire path."

msgctxt "2a6aafb9cd264e0f892fd365fc9bba74"
msgid "འདི་␣ར་ ནི་ སྡེ་སྣོད་ གསུམ་ རྒྱུད་སྡེ་ བཞི་ ལམ་ གྱི་ རིམ་པ་ ཡིན་པ་␣ས་"
msgstr ""
"In this [system], the three pitakas and the four tantra sections are the "
"stages of the path."

msgctxt "ae979817e994454ba18192b19b943edb"
msgid "གང་ཟག་ གཅིག་ ལ་ ཚང་ དགོས་ ཏེ་"
msgstr "These must be complete in a person."

msgctxt "f3cdae1a20f947ea91350ecf74797503"
msgid "བསླབ་ གསུམ་ གྱི་ མདོ་␣ར །"
msgstr "According to The Sutra on the Threefold Training,"

msgctxt "800b555135d742929684af7183986e59"
msgid "དགེ་སློང་ དག་ ཚུལ་ཁྲིམས་ ལ་ གནས་ ན་ ཏིང་འཛིན་ སྐྱེ་བ་␣ར་ འགྱུར་ རོ །"
msgstr ""
"Monks, meditative concentration will arise if one dwells on moral "
"discipline."

msgctxt "464e9265909c482898636065c1ff190e"
msgid "དེ་ ཡུན་རིང་ དུ་ གནས་ ན་ ཤེས་རབ་ ཐོབ་པ་ འགྱུར་ རོ །"
msgstr "By abiding for a long time in concentration, one can attain wisdom."

msgctxt "80660c111ea04a3997b8bbb043b8eee3"
msgid "དེ་ གོམས་པ་␣ར་ བྱས་ ན་ དུག་ གསུམ་ ལ་␣ས་ སེམས་ རྣམ་པ་␣ར་ གྲོལ་ ལོ །"
msgstr ""
"By habituating it, the mind will be completely liberated from the three "
"poisons. "

msgctxt "e7eccb9a8a5347cebe96bc9f465b14c9"
msgid "ཞེས་ དང་ །"
msgstr "And"

msgctxt "f8989693324148b0b38de4ecb4f08098"
msgid "དེ་ ལ་ བྱེ་བྲག་ སྨྲ་བ་ གྲག་ ཅེས་ སོགས་ ཀྱི་ གསལ་ ལོ །"
msgstr "To this, Vaibhashika and others have made clear."

msgctxt "1f4c800fc9cf40d5947d8d16ea18f4fe"
msgid "༈  ལྷན་␣༽༽  གཞན་དག་ ན་རེ །"
msgstr "Addendum: Others said,"

msgctxt "9f8b8ec2695b4dfb8d3a380296069376"
msgid "གསུང་རབ་ ཡན་ལག་ བཅུ་གཉིས་ སོ་སོ་␣ར་ མ་ འདྲེས་པ་ ཐ་དད་ ཡིན་ ཟེར །"
msgstr ""
"The twelve branches of the Excellent Speech are distinct from one another "
"without mixing."

msgctxt "225cd889d9bb4c72be67579b9107c62f"
msgid ""
"འདི་␣ར་ ནི །  སྡེ་སྣོད་ རེ་རེ་ ལ་ ཡང་ གསུང་རབ་ བཅུ་གཉིས་པོ་ འདི་རིགས་ སུ་ "
"ཚང་ སྟེ་ ཕལ་ཆེན་ ལྟ་བུ་␣འོ ། །"
msgstr ""
"In this [system], each pikata completes the twelve branches of the Excellent"
" Speech like Avatamsaka [Sutra]."

msgctxt "1c74da5b8b3c410cb1c2403a2cff470e"
msgid "མདོ་སྡེ་ དབྱངས་ བསྙད་ ལུང་བསྟན་ ཚིགས་བཅད་ ཆེད་བརྗོད་"
msgstr "The prophesy is expressed in Harmonious Verse sutra."

msgctxt "132502a2e1a9492dae8a2d310798d2d4"
msgid "གླེང་ གཞི་ རྟོགས་བརྗོད་ དེ་ལྟར་ བྱུང་"
msgstr "Contexts and narrations of realization emerge in this way."

msgctxt "26c564578e1a4803a09e981035a39c73"
msgid "སྐྱེས་ རབ་ ཤིན་ཏུ་ རྒྱས་པ་ རྨད་བྱུང་ གཏན་ དབབ་ བཅུ་གཉིས་ ཏེ་ །"
msgstr ""
"The twelve: the tales of past lives, elaborate [teachings], marvels, "
"determinations and others."

msgctxt "534b256f547a47f59d7d53dab3ceacff"
msgid "དང་པོ་ ལྔ་ ཉན་ཐོས་ ཀྱི་ མདོ་སྡེ་"
msgstr "The first five are the sutra sections of shravaka "

msgctxt "22b9a81241da476288eb5ce2fd2149a9"
msgid "དེ་འོག་ བཞི་ འདུལ་བ་␣འི་ སྡེ་སྣོད་"
msgstr "The next four are the Vinaya Pitaka."

msgctxt "48447a0694b548759551dba98b857903"
msgid "དེ་འོག་ གཉིས་ བྱང་སེམས་ ཀྱི་ མདོ་སྡེ་"
msgstr "The next two are the sutra sections of bodhisatva."

msgctxt "416218f25df743fe886f26e160dfdcee"
msgid "ཐ་མ་ གཅིག་ ནི་ གཉིས་ཀ་␣འི་ མངོན་པ་␣འོ །"
msgstr "The last one is the abhidharma [piṭaka] of both."

msgctxt "fc4e4664f29b4e3f909a4c2aac68af8a"
msgid "ལྷན་␣༽༽་␣མཁས་པ་ ལ་ལ་␣ས་"
msgstr "Addendum: Some experts said,"

msgctxt "adad997c85434628ba81be0e10907863"
msgid "སྡེ་སྣོད་ གསུམ་ སོ་སོ་␣ར་ ཐུག་ རེག་ མེད་ དེ་"
msgstr "The three pitakas are not in contact with one another."

msgctxt "4236bc010c3c4d029d2e9f1e1866b711"
msgid ""
"འདུལ་བ་␣ར་ གསུང་ ས་ མངོན་པ་ ན་ མེད་པ་ སོགས་ ཀྱིས་ མ་ འདྲེས་པ་ ཡིན་ ཟེར་ རོ །"
msgstr ""
"It is said that what is spoken in the Vinaya is not said in Abhidharma and "
"so on, therefore they are not mixed."

msgctxt "7e0c4d65c71247ef966899842961c435"
msgid ""
"འདི་␣ར་ སྡེ་སྣོད་ སྔ་མ་␣འི་ དེ་བཞིན་ དུ་ སྡེ་སྣོད་ འདུལ་བ་ ལྟ་བུ་ གཅིག་ "
"ལ་␣འང་ སྡེ་སྣོད་ གསུམ་ ཀ་ འདུས་ ཏེ་ དང༌པོ་"
msgstr ""
"In this [system], the preceding Pitakas, such as the Vinaya Pitaka, is an "
"assemblage of all three Pitakas. "

msgctxt "b165f6afec684d1cad22be57c31e205b"
msgid ""
"ཝཱ་ རཱ་ ཎ་ སྰིར་ གསུངས་པ་ ནས་ ཐ་མ་ ཀུཤའི་ གྲོང་ དུ་ མྱ་ངན་ ལ་␣ས་ འདས་པ་␣འི་ "
"བར་ དུ་ འདྲེས་ ཅན་ དུ་ གསུངས་ ཏེ་"
msgstr ""
"From his teachings in Varanasi till his final nirvana in the city of Kushi, "
"he taught in mixed."

msgctxt "6d178833a6194419b9e8737bc7f268f3"
msgid "ཤས་ ཆེ་ཆུང་ ཙམ་ ལ་␣ས་ ཐ་དད་ ཡིན་ ན་"
msgstr "If they are distinct only because of greater or lower emphases,"

msgctxt "5c09966d49b34d21b8ca075741aef4d9"
msgid "བསླབ་པ་ གསུམ་ ཡ་བྲལ་ དུ་ འགྱུར་བ་␣འི་ ཕྱིར་ རོ །"
msgstr "Then the threefold training will become disconnected."

msgctxt "92cb0271fa7a4ada8ffa3d8f37aea976"
msgid "རྡོ་␣༽༽་␣བསྟན་འཛིན་ གཞན་ གྱི་ ཐེག་ཆུང་ ཐེག་ཆེན་ ཐེག་པ་ སྣ་ཚོགས་ ཏེ་"
msgstr ""
"Vajra: other upholders of the teachings said, the Lesser Vehicle, the Great "
"Vehicle, or various vehicles are"

msgctxt "f01f6aadabef470cab5ff2168c92c692"
msgid "རིགས་ཅན་ གསུམ་པོ་ ཐ་དད་ ལ་ བསྐོར་བ་ ཡིན་ ཟེར་ རོ །"
msgstr "turned for the three distinct types of disciples. "

msgctxt "9b3b8e7a4c4b43a19c1c58affa241332"
msgid "འདི་␣ར་ རང་ བཞེད་ ནི་"
msgstr "In this [system], our acceptance is"

msgctxt "78db526d15cc4c839eaa4018c1959eff"
msgid "ཆོས་འཁོར་ རྣམ་པ་ གསུམ་པོ་"
msgstr "The three types of the Dharma Wheel "

msgctxt "f408d4c2860b410590bacf8fc5a64479"
msgid ""
"འཁོར་ གྱི་ གདུལ་བྱ་␣འི་ རྟོགས་པ་ གོང་ ནས་ གོང་ དུ་ འཁྲིད་པ་␣འི་ ཐབས་ ཀྱི་ "
"ཁྱད་པར་ རམ་ བོག་ དབྱུང་བ་␣འི་ དོན་ དུ་ གསུངས་པ་ སྟེ་"
msgstr ""
"are different methods for leading the disciples of the wheel to higher and "
"higher realizations, or for teaching others to perfect [themselves]."

msgctxt "f1839e71e9df4fd0bb324a2dfbdb2c19"
msgid ""
"ཝ་ རུ་ ན་ ལྟ་བུ་ བདེན་ བཞི་␣འི་ ཆོས་འཁོར་ གྱིས་ ཉོན་མོངས་ ཀྱིས་ མ་ གོས་པ་␣ས་"
" སྨིན་པ་␣ར་ བྱས །"
msgstr ""
"Such as Varuna, who has been ripened by the Dharma Wheel of the Four Truths "
"without being veiled by afflictions."

msgctxt "8366c62917dd429b86cdaa30679c77ab"
msgid ""
"བར་ དུ་ བདེན་ བཞི་ དེ་ཉིད་ སོགས་ གཟུགས་ ནས་ རྣམ་མཁྱེན་ བར་ སྤྲོས་བྲལ་ དུ་ "
"བསྟན་པ་"
msgstr ""
"In the middle, [he] said that the four truths, as well as from form to "
"omniscience, are free from elaboration."

msgctxt "d8a3804491fd4369ab057d56a86a5cf7"
msgid "མཚན་ཉིད་ མེད་པ་␣ར་ མངོན་པར་ རྟོགས་པ་␣འི་ ཤེས་རབ་ སྐྱེས་ ཏེ་"
msgstr ""
"After arising the wisdom of actualized realizations in the absence of "
"defining characteristics."

msgctxt "07ddfc3eec384190b9bfd4b6252ab8fb"
msgid "ས་␣ས་ རྒྱས་ ཀྱིས་ ང་ ཡང་ དགྲ་བཅོམ་པ་ ཡིན་ ལ་"
msgstr "The Buddha said that I, too, am an arhat."

msgctxt "ce69e0417edc4805a146734a9324b8a0"
msgid "ཁྱེད་ རྣམས་ ཀྱང་ དགྲ་བཅོམ་ ཡིན་ གསུངས་པ་␣ས་ ཤིན་ཏུ་ སྨིན་པ་␣ར་ བྱས །"
msgstr ""
"You all are arhats as well. By saying this [they] are completely ripened."

msgctxt "eedb441f145c40bc95b62829679fb5dc"
msgid ""
"སྟོང་པ་ཉིད་ རྟོགས་པ་ དེ་␣ས་ མི་ ཆོག་ ཆོག་ ག་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་␣འི་ གནས་ "
"ལ་ འཇུག་པ་␣འི་ ཕྱིར །"
msgstr ""

msgctxt "7ad2231cc3db461285b8d8caa21d3a52"
msgid "ཁྱེད་ རྣམས་ དགྲ་བཅོམ་ མ་ ཡིན་ སོགས་ གྱིས་ འོག་མ་ སུན་ དབྱུང་ ནས་"
msgstr "Those who are not arhats should eliminate the lowers and "

msgctxt "f8953bf06ce743d8ae6a84bce7e87fe4"
msgid ""
"གཙང་ བདེ་ རྟག་ བདག་ དམ་པ་␣འི་ ཕར་ཕྱིན་ བསྟན་ ཏེ་ བྱང་ཆུབ་ ཏུ་ ལུང་བསྟན་པ་␣ས "
"།"
msgstr ""
"By showing the excellent paramita of purity, bliss, permanence, and self, "
"[he] then gave prophecies of enlightenment."

msgctxt "4e829a3a924242cfb39cbf93c7526c93"
msgid "ངེས་དོན་ འཁོར་ལོ་␣ས་ ཤིན་ཏུ་ སྨིན་པ་␣ར་ མཛད་ དོ ། །"
msgstr "The Wheel of definitive meaning ripened [them] entirely. "

msgctxt "6666d12288474f7989b297c01bfc947a"
msgid "བྱང་ཆུབ་ ཕུང་པོ་␣ར་ ཞེན་ ནས་ མཆོག་འཛིན་ མ་ བྱེད་ ཅེས །"
msgstr "Do not hold excellence by clinging to the body of enlightenment."

msgctxt "f55bb242d2c94538929930d0ad62773d"
msgid "དང་པོ་ ལས་ཅན་ དེ་ ལ་སོགས་ ཀྱིས་ སྒྲུབ་བོ །"
msgstr "It is accomplished by fortunate beginners such as them."

msgctxt "4878b070ab314fb0a6f3a6fd1842f5a7"
msgid "ལྷན་␣༽༽  མཁས་པ་ ལ་ལ་␣འི་ བཞེད་དོན་"
msgstr "Addendum: Some experts' acceptance,"

msgctxt "685dd2a247c243c4a1d34e01d991ea19"
msgid ""
"སྟོན་འཁོར་ ཆོས་ གནས་དུས་ ཏེ་ ཕུན་ཚོགས་ ལྔ་␣ས་ བསྡུས་པ་ བཀའ་ ཡིན་ ཀུན་ ལ་མ་ "
"ཁྱབ་པ་␣ར་ འདོད་ མོད །"
msgstr ""
"The Buddha-word contains the five excellences such as the excellent teacher,"
" retinue, dharma, place, and time. And [they] accept that it is not pervaded"
" to all."

msgctxt "b7473fcbc3824a4f9924ca42df54f62a"
msgid ""
"འདི་␣ར་ ནི་ འཁོར་བ་ རིགས་ དྲུག་ དང་ མྱང་འདས་ ཐམས་ཅད་ ཕུན་སུམ་ ཚོགས་པ་ ལྔ་ "
"ཡིས་ བསྡུས་པ་␣ར་ བཞེད་ དེ་"
msgstr ""
"In this [system], it asserts that the six classes of samsara, and nirvana "
"contain the five excellences. "

msgctxt "5d15dbc9fff742819092e2a129962fd6"
msgid ""
"རྣམ་བྱང་ ཕྱོགས་ འཁོར་ལོ་ གསུམ་ ལ་ བཀའ་ དང་ བསྟན་བཅོས་ མན་ངག་ གསུམ་ གསུམ་ "
"གྱིས་ དགུ་སྟེ་"
msgstr ""
"There are nine because each of the Three Wheels of complete purification has"
" the Buddha-word, treatises, and foremost instructions."

msgctxt "c54cd63ef21544e381a32a9fdadc0525"
msgid ""
"དེ་དག་ དང་ འཁོར་བ་ འགྲོ་བ་ དྲུག་ ཀྱང་ སོ་སོ་␣ར་ སྟོན་པ་ སོགས་ ཕུན་ཚོགས་ ལྔ་ "
"ཚང་བ་ ཡིན་ ནོ །"
msgstr ""
"Along with those, each of the six samsara migrators has a teacher and other "
"excellences."

msgctxt "1fd5d7d09c4245a08734b7afef39d484"
msgid ""
"རྡོ་␣༽༽  ཁོ་ན་ རེ །  ཆོས་འཁོར་ གསུམ་ བརྗོད་བྱ་ ཐ་དད་པ་ སྔ་ཕྱི་ སོགས་ མ་ "
"འདྲེས་པ་ ཡིན་ ཟེར་ ཡང༌ །"
msgstr ""
"Vajra: Someone said, the subject matter of the three Dharma wheels is "
"distinct, and earlier and later ones are not mixed."

msgctxt "db40468328a94daba0d1d3e621d244f1"
msgid ""
"འདི་␣ར་ ཆོས་ ཀྱི་ འཁོར་ལོ་ རེ་རེ་ ལ་ ཡང་ ཆོས་འཁོར་ དང་པོ་ དང་ གཉིས་པ་ "
"གསུམ་པ་ དང་ བཅས་ གསུམ་ ཀ་ ཚང་བ་␣ར་ བཞེད་ དེ །"
msgstr ""
"In this [system], it accepts that each of the Dharma wheels consists of the "
"first, second, and third wheels of the Dharma, or all three."

msgctxt "8cfa8bb0691549dea876f252d9c35186"
msgid "དང་པོ་␣ར་ སྡུག་བསྔལ་ གྱི་ རྒྱུ་ ཀུན་འབྱུང་"
msgstr "In the first, the origin is the cause of sufferings"

msgctxt "db55a43afd1548a9957d973219f73d68"
msgid "འཕགས་ལམ་ གྱིས་ སྤང་བ་␣ས་"
msgstr "which is abandoned by the noble path. "

msgctxt "5e86a6abab0645c4a103f6578615cc68"
msgid "འབྲས་བུ་ འགོག་␣ས་པ་ མངོན་དུ་ བྱས་པ་ དང་"
msgstr "manifested the resultant negation and "

msgctxt "2aaa5897ea07449aa6fc00de16f882a2"
msgid "གཉིས་པ་␣ར་ ཡང་ འདུ་ཤེས་ གཉིས་ འཛིན་"
msgstr "Secondly, the grasping of the two perceptions,"

msgctxt "4838a16c5eba4135a0c929ffca5b3d68"
msgid ""
"བཟང་ངན་ གྱི་ ཀུན་འབྱུང་ དང་ མཐོ་རིས་ ཡོན་ཏན་ བདུན་ ཐོབ་པ་␣ར་ བྱ་ སྙམ་པ་"
msgstr ""
"wish to attain the origin of good and bad, and the seven good qualities of "
"higher levels."

msgctxt "cb91a955bebc4b898ae97c78a5822604"
msgid "ཆོས་ ལ་ བརྟེན་པ་␣འི་ ཀུན་འབྱུང་ སྤང་བ་␣ས་"
msgstr "abandoning the origin by relying on the Dharma. "

msgctxt "2b410d3958244914956c09d5896782c5"
msgid "རྟེན་འབྲེལ་ སྟོང་ཉིད་ མཚན་མ་ མེད་པ་ མངོན་དུ་ བྱས་པ་ དང༌ །"
msgstr "manifested interdependence, emptiness, and absence of signs."

msgctxt "703e21e6176a437c8f651be758d710a1"
msgid ""
"གསུམ་པ་␣ར་ ཡང་དག་པ་␣ར་ གནས་པ་␣འི་ བྱང་སེམས་ ཀྱི་ རྒྱུད་ ཀྱི་ བག་ཆགས་ "
"ཕྲ་བ་␣འི་ ཀུན་འབྱུང་ སྤངས་པ་␣ས་"
msgstr ""
"Thirdly, abandoning the subtle latency in the continuums of bodhisattvas who"
" dwell in genuineness."

msgctxt "9f01bdd923b24448ab9c19029c386ddf"
msgid "མཐར་ཐུག་ གི་ འགོག་␣ས་པ་ མངོན་དུ་ བྱས་པ་␣ས་"
msgstr "manifested the ultimate negation."

msgctxt "5028017ef8bf46bbbad12093535028da"
msgid "ཀུན་འབྱུང་ སྤོང་བ་ མཚུངས་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "It is similar to the abandonment of the origin."

msgctxt "d089aab209fd41c49dd72988b2c00b5a"
msgid "དང་པོ་ ལ་ དགག་སྒྲུབ་ ཀྱི་ མཚན་ཉིད་ བདེན་ བཞི་ ༑"
msgstr ""
"First, the defining characteristic of negation and assertion is the four "
"truths."

msgctxt "a1734a680ab147139115f1e53065503a"
msgid "རྣམ་ཐར་ སྒོ་གསུམ་ སོགས་ ནི་ མཚན་ཉིད་ མེད་པ །"
msgstr "The three doors of complete emancipation: signlessness and so on. "

msgctxt "6318c88fe3134d3a98d409c4fdb1d4ce"
msgid "གཏུམ་པོ་ རབ་ སྣང་ ལ་ གསུམ་ གསོལ་བ་␣ས་ སྟོབས་ བཅུ་ བསྟན་པ་ ངེས་དོན་ ཏེ་"
msgstr ""
"On the three requests, ferocious Candapradyota showed the ten strengths, "
"which is a definitive meaning."

msgctxt "b33895b3338c4d99ad40dc70f4a4aca1"
msgid "དེ་ལྟར་ གཞན་ གཉིས་ ལ་ ཡོད་པ་␣འི་ ཕྱིར་ རོ །"
msgstr "It exists in the other two in the same way."

msgctxt "9ca3868d174a4371be6b42a7ac0e6568"
msgid "རྡོ་␣༽༽  མཁས་པ་ གཞན་དག་ ན་རེ །"
msgstr "Vajra: Other experts say:"

msgctxt "283bc6abf7744f61954bdc3de5ffd91b"
msgid "འཁོར་ལོ་ གསུམ་ གྱི་ དོན་ འབྲེལ་ དེ་ལྟར་ ཚང་བ་␣ར་ གནས་ ཀྱང་"
msgstr ""
"Though the interconnected meanings of the three Dharma wheels remain "
"complete in this way,"

msgctxt "cb540996f56341ec860e4d8be696b685"
msgid "ཚིག་མཚོན་པ་ མི་ གསལ་བ་ ཡོད་ ཟེར་ མོད །"
msgstr "there are no clear words representing it."

msgctxt "cee56f6eedbb45f3a2641ebe53209589"
msgid "འདི་␣ར་ ཕྱི་མ་ ཕྱི་མ་␣འི་ ས་བོན་ སྔ་མ་ སྔ་མ་␣ར་ གནས་པ་␣འི་ ཕྱིར་"
msgstr "In this [system], all successive seeds dwell in their former states."

msgctxt "1f40ffc64822420385cdaac8046e362e"
msgid "ཚིག་ གིས་ ཀྱང་ གསལ་ ཏེ་"
msgstr "It is also clear in words as"

msgctxt "a144d64cb90041dba937cd682eb33770"
msgid ""
"སྐྱེས་མ་ ཐག་ གི་ བྱིས་པ་ ན་␣ར་ སོན་པ་␣འི་ དུས་ སུ་␣འང་ གཞི་ དང་པོ་␣འི་ ལུས་ "
"དེ་ ཡིན་པ་ བཞིན །"
msgstr ""
"The first base of a newly born infant when it comes to a person is the body."

msgctxt "3273d336b3844d93a8c7201c9af14bc5"
msgid ""
"དང་པོ་␣ར་ བསྟན་པ་ དེ་ཉིད་ མཐར་ཐུག་ གི་ དུས་ སུ་ གསལ་བ་␣ར་ བསྟན་པ་ ཙམ་ ལ་␣ས་"
msgstr "First, the teaching itself was taught clearly during the final age."

msgctxt "f62f517b3ff1405fbc4878f02d1bc669"
msgid "འགལ་བ་␣ར་ མ་ བསྟན་པ་ ནི་ དང་པོ་␣ར་ སྡོམ་པ་␣འི་ ངོ་བོ་ རྣམ་རིག་ མིན་པ་"
msgstr "Not showing it contradiction is not an essence of cognitive vows,"

msgctxt "6e9348eb133a424ba9bf746d6d359d4c"
msgid "དེ་ཉིད་ བར་པ་␣འི་ ས་བོན་ ཡིན་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "because it is the seed of the middle [one]."

msgctxt "c8ad663c877947a4998cffc9369f9600"
msgid "བར་པ་␣ར་ དགོངས་འགྲེལ་ ལ་␣ས །"
msgstr "In the middle, according to the Commentary on the Intent [­sutra]:"

msgctxt "7d7032c4a25045aeb37bdb29d0676533"
msgid "ལེན་པ་␣འི་ རྣམ་པ་␣ར་ ཤེས་པ་ ཟབ་ ཅིང་ ཕྲ །"
msgstr "The appropriating consciousness is profound and subtle."

msgctxt "2ec3f35eb5684a66a4950befb767f4f9"
msgid "ས་བོན་ ཐམས་ཅད་ ཆུ་བོ་␣འི་ རྒྱུན་ བཞིན་ བབས །"
msgstr "All of the seeds fall like a continuous flow of a river."

msgctxt "d47ef48775e64716993ee8d6ac4a8f44"
msgid "བདག་ ཏུ་ རྟོག་པ་␣ར་ འགྱུར་ ན་ མི་ རུང་ ཏེ །"
msgstr "It is not appropriate if [they] think it as a self."

msgctxt "f08ee661cbe04ec29cc8f100cd05bba5"
msgid "བྱིས་པ་ རྣམས་ ལ་ ངས་ ནི་ དེ་ མ་ བསྟན །"
msgstr "I have not taught this to the children."

msgctxt "bb8e7c6d05e34993af7a758512880a5e"
msgid "ཅེས་ དང་ །"
msgstr "And."

msgctxt "4a69a35ec95f4b4bbf99557553e57a54"
msgid "སྨྲ་ བསམ་བརྗོད་ མེད་ ཤེས་རབ་ ཕ་རོལ་ ཕྱིན །"
msgstr ""
"Beyond expression, beyond thought, beyond description, Prajnaparamita."

msgctxt "6048756499af41cb9345f6613abc9f83"
msgid "སོགས་ ནས །"
msgstr "And so on."

msgctxt "bde68e410b0c4155baff0c500be591ab"
msgid "ངོ་བོ་ ཉིད་ ཅེས་ བསྟན་པ་ ནི །"
msgstr "The essenceness [of all phenomena] is taught. "

msgctxt "18e508169eeb4403b4f6b42c307d51f2"
msgid "ཐ་མ་␣འི་ ས་བོན་ ཡིན་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "Because it is the ultimate seed. "

msgctxt "5d4aa8e05df0414585c052c9a5c424db"
msgid "དེ་ཡང་ འཁོར་ལོ་ ཐ་མ་␣འི་ སྐབས་ ལ་"
msgstr "Moreover, during the final wheel [of the Dharma]"

msgctxt "ddbae67fe98b475c934a3b606a06b7e4"
msgid "སྔགས་ ཀྱི་ ས་ འོན་ བཞག་པ་ ལང་ཀ་␣ར་ གཤེགས་པ་ ལ་␣ས །"
msgstr ""
"placed the seed of the mantra. According to the Descent to Lanka [sutra]:"

msgctxt "fde0116231be41929c6b7162af5b41ca"
msgid "བློ་གྲོས་ ཆེན་པོ་ ས་མཐ་␣ར་ ཕྱིན ། །"
msgstr "Those of great intelligence have thoroughly gone all of the grounds."

msgctxt "1cfee4b4659e423d8c2be12723a2b42a"
msgid "ཆོས་ ཀྱི་ དབང་ ནི་ བསྐུར་ གནས་ སུ ། །"
msgstr "The empowerment of the Dharma is in the place of bestowal,"

msgctxt "efccf86881a241d0ade8dbc22acb3bc4"
msgid "འོག་མིན་ སྟུག་པོ་ ཉམས་ དགའ་བ་␣ར ། །"
msgstr "In the dense delightful [realm] of Akanishtha "

msgctxt "e0dfb3a2764c4761914815f7c8f6029e"
msgid "ཡང་དག་ སངས་རྒྱས་ དེ་␣ར་ སངས་རྒྱས ། །"
msgstr "The true buddhas will awaken there."

msgctxt "abd05dc417a749b781cf46fe933ffe5a"
msgid "སྤྲུལ་པ་པོ་ ཞིག་ འདི་␣ར་ འཚང་ རྒྱ །"
msgstr "The one who does emanation will awaken there."

msgctxt "8d2f76d41d724c059b4d9b7d27af1610"
msgid "ཞེས་ དང་ དེ་ཉིད་ ལ་␣ས །"
msgstr "And, from the same:"

msgctxt "7a18c880e6b3415297a2429114a6ae06"
msgid "འདོད་པ་␣འི་ ཁམས་ དང་ གཟུགས་ མེད་ དུ ། །"
msgstr "In the desire realm and the formless realm,"

msgctxt "c85c6da2d99c4005847c6f5eecadf4c6"
msgid "སངས་རྒྱས་ རྣམ་པ་␣ར་ འཚང་ མི་ རྒྱ ། །"
msgstr "The buddhas will not awaken."

msgctxt "7fc2ba763b8747c2a0bbb9f265f581bd"
msgid "གཟུགས་ ཀྱི་ ཁམས་ ཀྱི་ འོག་མིན་ དུ ། །"
msgstr "In the Akanishtha of the form realm,"

msgctxt "629185dd1ddf4b449f8574244dce91d3"
msgid "འདོད་ཆགས་ བྲལ་ ཁྱོད་ འཚང་ རྒྱ་␣འོ ། །"
msgstr "You will be free from desire and awakened."

msgctxt "a78af2e6df6f42e7b92af62f8c871ae6"
msgid "ཞེས་ སོགས་ ཀྱིས་ ཕྱི་མ་ ཕྱི་མ་␣འི་ འབྲས་བུ་ ཐེག་པ་ ནས་ བཟུང་"
msgstr "And others, the successive results, holding from the vehicle"

msgctxt "ea0f9e29a42547c8a14023b279e1f826"
msgid ""
"རྒྱུ་␣འི་ ཐེག་པ་ སྔ་མ་␣འི་ བར་ གྱི་ ས་བོན་ གནས་ཚུལ་ གསལ་བ་␣ར་ སྒྲུབ་ མོ །"
msgstr ""
"The reality of the seed until the previous vehicle of the cause is clearly "
"accomplished."

msgctxt "ffed6237658244ecb5fb51b4313d52f0"
msgid "རྡོ་␣༽༽  ཁ་ཅིག་ ན་རེ །"
msgstr "Vajra: A certain person says:"

msgctxt "f6eef9b7b50f45a0a3170d86de037300"
msgid ""
"འཁོར་ལོ་ གསུམ་ ནི་ གནས་དུས་ རིགས་ཅན་ གསུམ་ གསུམ་ གྱིས་ འབྱེད་པ་␣ར་ འདོད་ "
"མེད་ ལ །"
msgstr ""
"They do not accept that the three wheels are differentiated by the three "
"[factors]: place, time, and the three categories of disciples."

msgctxt "8a83fa0103e24fcab946ab8146b3a4ab"
msgid ""
"འདི་␣ར་ མདོ་ དང་ དོན་ གྱི་ གནད་ ཀྱིས་ ཆོས་ ཀྱི་ འཁོར་ལོ་ རྣམ་པ་ གསུམ་ དུ་ "
"ངེས་ ཏེ །"
msgstr ""
"In this [system], because of the sutras and their essential points, the "
"wheel of Dharma is certain to three types."

msgctxt "82af0a8553c54453a93b8ebbd8a5733f"
msgid "ཚངས་རིས་ ཀྱི་ ལྷས་ ཨེ་མ་ སྔོན་ཆད་ འཇིག་རྟེན་ དུ་"
msgstr ""
"All the gods of the Brahma realms said \"Amazing! The wheel of Dharma, which"
" has never been turned in this world,"

msgctxt "884e56aff5b84d029c56273e65704606"
msgid ""
"དགེ་སྦྱོང་ ངམ་ བྲམ་ཟེ་ འམ །  ལྷ་ འམ །  བདུད་ དམ །  ཚངས་པ་␣འམ །  སུ་␣ས་ ཀྱང་ "
"མ་ བསྐོར་བ་␣འི་ ཆོས་ ཀྱི་ འཁོར་ལོ་ བསྐོར་ རོ ། །"
msgstr ""
"by any shramana, brahmin, gods, demons, Brahma, or anyone else, will now be "
"turned.\""

msgctxt "f84021930f8348998f8c851b7d6e6db0"
msgid "ཞེས་པ་␣ས་ དང་པོ་ དང༌ །"
msgstr "Thus, it is the first and "

msgctxt "40785c2ed1de4bb0b5d6c1af7a82b647"
msgid "རབ་འབྱོར་ གྱིས་ དེ་བཞིན་ཉིད་ ཀྱི་ ལེའུ་ བསྟན་ ཚེ་"
msgstr "When Subhuti taught the chapter of thusness,"

msgctxt "83f11acb1e6643fa9ff406a98f7a3640"
msgid "གཙང་རིས་ ལྷས་ མེ་ཏོག་ འཐོར་ ཞིང་"
msgstr "The Suddhavasa gods disperse flowers."

msgctxt "39e939233d92479596a7695292b6d958"
msgid ""
"ཨེ་མ་ འཛམ་བུ་␣འི་ གླིང་ དུ་ ཆོས་ ཀྱི་ འཁོར་ལོ་ གཉིས་པ་ འསྐོར་བ་ མཐོང་ ངོ་ །"
msgstr "It is amazing to see the second wheel of Dharma turning in the world."

msgctxt "1b6fcf182dd24bc9bff239c893172ba2"
msgid "ཞེས་པ་␣ས་ གཉིས་པ་ དང༌ །"
msgstr "Thus, it is the second."

msgctxt "5a58244af232482dbf98f48024e33b96"
msgid "དགོངས་འགྲེལ་ ལ་␣ས་"
msgstr "According to the Commentary on the Intent [­sutra]:"

msgctxt "b031f7d878dc48e29da51e8acdd6fb64"
msgid ""
"དོན་དམ་ ཡང་དག་ འཕགས་ ཀྱིས་ བཅོམ་ལྡན་འདས་ ཀྱི་ དང་པོ་␣ར་ ཝཱ་ རཱ་ ཎ་ སཱིར་ "
"བསྐོར་བ་ དེ་ཡང་ བླ་ ན་ མཆིས་པ །"
msgstr ""
"Bodhisattva Para­martha­samud­gata said the Blessed One's first turning at "
"the Varanasi is surpassable."

msgctxt "9f11d2ebd86b4b23a7438ad52610c30c"
msgid "སྐབས་མཆིས་པ །"
msgstr "Adapted to the circumstances."

msgctxt "83ed988591fd49c39633dff2ed8f5021"
msgid "དྲང་དོན་ རྩོད་གཞི་␣ར་ གྱུར་པ་ ལགས་ ལ །"
msgstr "As its provisional meaning became a basis for debate,"

msgctxt "fc50b0bbd9ae477c9d575540a2105de0"
msgid "གཉིས་པ་ བྱ་རྒོད་ ཕུང་པོ་ རེ་␣ར་ བསྐོར་བ་␣འང་ དེ་བཞིན་ དང་ །"
msgstr "The second turning on Vulture Peak Mountain is similar as well."

msgctxt "11976e74674d4963b6f8e3c218c18979"
msgid "ད་ལྟར་ བསྐོར་བ་ འདི་ ནི་ སྐབས་ མ་ མཆིས་པ་ དང་ །"
msgstr "The present turning is not adapted to the circumstances and "

msgctxt "bf364e6bc2bf43ea9f8ad03d3664a7ef"
msgid ""
"བླ་ ན་མ་ མཆིས་ སོགས་ ཀྱིས་ མཐའ་མ་␣ར་ བཞག་པ་ མདོ་ ལུང་ འདི་␣འི་ གནད་ ཀྱིས་ "
"གསུམ་ དུ་ ངེས་ སོ །"
msgstr ""
"Because of the importance of keeping the unsurpassed and so on at the end of"
" this scriptural sutra, it is certain to three."

msgctxt "8ef24d7af96546529a3a7ad8fb987fc6"
msgid ""
"གཉིས་པ་ དོན་ གྱི་ གནད་ ཀྱིས་ སངས་རྒྱས་ ཀྱིས་ འཁོར་བ་ སྤོང་བ་␣འི་ ཐབས་ "
"མངོན་རྟོགས་ ཀྱི་ རིམ་པ་ རྒྱུད་ ལ་ དགོས་པ་␣ར་ གསུངས་པ་␣ས་"
msgstr ""
"Second, because of the essential points of the meaning, The Buddha stated "
"that one must have the stages of manifest realizations in one's own "
"continuum as a method to abandon samsara."

msgctxt "3da6d8f3ab3d4e278df4f63c78e918ee"
msgid "གང་ཟག་ གི་ རྒྱུད་ ལ་ རིམ་པ་␣འི་ ཚུལ་ གྱིས་ འབྱུང་ སྟེ་"
msgstr "It will happen gradually in a person's continuum."

msgctxt "583cf2bf7b6042aba8af24d5a632c24a"
msgid ""
"དེ་དོན་ སྒམ་པོ་པ་␣འི་ རྣལ་འབྱོར་ བཞི་␣ར་ འཁོར་ལོ་ བཞི་␣འི་ དོན་ དང་ "
"གཅིག་པ་␣ས་ གསུམ་ དུ་ ངེས་པ་␣འོ ། །"
msgstr ""
"In this sense, the four yogas of Gampopa correspond to the meanings of the "
"four wheels, thus it is certain to three."

msgctxt "c82a9e7cb0564e9785df2bf3bd3e6649"
msgid ""
"འཁོར་ལོ་ གསུམ་ དོན་ མཐོ་དམན་ ཡོད་པ་ ཆེད་ དུ་ བརྗོད་ མཁན་ ཡང་ དེ་བཞིན་ ནོ ། །"
msgstr ""
"Those who express the need for high and low meanings in the three wheels are"
" similar."

msgctxt "b68dd586f90c4635a84c298c76f499bc"
msgid "དེས་ན་ གནས་དུས་ སོགས་ ཀྱིས་ མི་ ཕྱེད་ དེ །"
msgstr "Thus, it is not distinguished by place, time, or other factors."

msgctxt "06f961a1e8914e058061bba175506b29"
msgid "ཝཱ་ རཱ་ ཎ་ སཱིར་ རྡོ་རྗེ་␣འི་ མཆུ་ སོགས་ དང༌ །"
msgstr "The Vajra Beak in Varanasi and "

msgctxt "102bbdff85714f87a583a67b79b04f4f"
msgid ""
"རྒྱལ་པོ་␣འི་ ཁབ་ ཏུ་ བདེན་ བཞི །  མདོ་ བཟུང་བ་ སྙིང་པོ་ བསྟན་པ་ སོགས་ དང༌ །"
msgstr ""
"the four truths in Rajghir. [Buddha] held the sutras and taught the essence "
"and "

msgctxt "ca646e15f7494e3d93cea521ebbd8381"
msgid "རྩ་ མཆོག་ ཏུ་ རབ་ བཟང་ ལ་ བདེན་ བཞི་ བསྟན་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "To give Subhadra the teaching of the four truths at Kushinagar."

msgctxt "4aa430c50534464fa86278da49c27beb"
msgid "གཉིས་པ་ དུས་ ཀྱིས་ ཀྱང་ མི་ ཕྱེད་ དེ །"
msgstr "Second, It is not distinguished by time because"

msgctxt "a3a53aaa64e144d197fa6797e8f69757"
msgid "དུས་ དང་པོ་␣ར་ ཡུམ་ གྱི་ ལྷུམས་ སུ་ ཐེག་ཆེན་ གསུང་པ་ དང༌ །"
msgstr "[Buddha] first taught the Great Vehicle in the mother's womb."

msgctxt "671d6f501e104a86b3e22948c63661f6"
msgid ""
"སངས་རྒྱས་ མ་ ཐག་ རྣམ་ འཇོམས་ སོ་␣ར་ འབྲད་ ཕལ་པོ་ ཆེ་␣འི་ དབུ་ སྟོད་ སོགས་ "
"དང༌ །"
msgstr ""

msgctxt "051952df9120469ebdf1c4ef9abe3765"
msgid "བར་པ་␣ར་ ཡང་ ནོར་ བཟང་ མི་ རྣམ་པ་␣ར་ སྡོང་པོ་ རྒྱན་ སོགས་ དང་ །"
msgstr ""

msgctxt "f2d7fdb83f9d4dd8af7db2d41de5ab2c"
msgid "ཐ་མ་␣ར་ ལུང་ཞུ་བ་ སོགས་ གསུངས་པ་ དང་ །"
msgstr "Finally, requested the scriptural authorization, and so on."

msgctxt "75db77317a85428bac61602166a7de1a"
msgid "གསུམ་པ་ འཁོར་ གྱིས་ ཀྱང་ མི་ ཕྱེད་ དེ་"
msgstr "Third, It is not distinguished by retinue as well because"

msgctxt "5455f788fe3d49688e524cad7c8d3b28"
msgid ""
"དང་པོ་␣ར་ བྱམས་པ་ སོགས་ དང་ །  བར་ མཐའ་ གཉིས་ ལ་␣འང་ ལྔ་ སྡེ་ བཟང་པོ་ "
"ཡོད་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"Maitreya and others were in the first [wheel of the Dharma], while the five "
"ascetic companions were in both the second and final [wheels of the Dharma]."

msgctxt "eb3a81abb88b4deaad4c0c7598b3c625"
msgid "རྡོ་␣༽༽་␣ཚུལ་ དགུ་ འཛིན་པ་ ཁ་ གཅིག་ གིས །"
msgstr "Vajra: Some proponents of the nine approaches stated,"

msgctxt "1b0215ef17894fe5930e18d4fc00ceec"
msgid "དགག་ བྱེད་ ལ་ལུང་ རྣམ་འབྱེད་ སྒྲུབ་བྱེད་ ལ་ལུང་ གཞི །"
msgstr ""
"The full analytical scripture is for negation, while the base scripture is "
"for assertion. "

msgctxt "a0e1094ffc554b928f99845e6a2ccf3a"
msgid "ལུང་ ཕྲན་ ཚིག  །"
msgstr "The Finer Points of Discipline:"

msgctxt "1083dc998b4546ca85a6b759cbd8e4dc"
msgid "ཐེ་ཚོམ་ གཅོད་པ་ ལ་ལུང་ ཞུ་བ་ སོགས་"
msgstr "Requested for scriptural authorization to eradicate doubts."

msgctxt "d55b80c3b3784e35a9a18146ff9b694e"
msgid ""
"དགག་སྒྲུབ་ ཐེ་ཚོམ་ གཅོད་པ་ གསུམ་ བརྗོད་དོན་ ཡིན་ གྱི་ བདེན་ བཞི་ བསྟན་པ་␣འི་"
" ཕྱིར །"
msgstr ""
"The meanings of expression are negation, assertion, and the eradication of "
"doubt, therefore the four truths are taught."

msgctxt "f6925158987e416ba16335ada9541175"
msgid ""
"བདེན་ བཞི་ མངོན་པ་ ནས་ རྒྱས་པ་␣ར་ བསྟན་པ་␣ས་ མངོན་པ་␣འི་ སྡེ་སྣོད་ ཡིན་ ཟེར་"
" ལ །"
msgstr ""
"[They] said that the four truths are extensively taught in Abhidharma. Thus,"
" it is the Abhidharma pitaka."

msgctxt "849ce347c67649538f20bd2d33c40d30"
msgid "འདི་␣ར་ ནི་ འདུལ་བ་␣འི་ སྡེ་སྣོད་ བདེན་ བཞི་␣འི་ ཆོས་འཁོར་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], the Vinaya Pitaka is the Dharma wheel of the four truths "
"as"

msgctxt "2408343d8072422c807b31cce2d61c8c"
msgid "ཉོན་མོངས་པ་ སེམས་ དང་ དེ་ དང་ རྗེས་སུ་ འབྲེལ་བ་ ལ་␣ས་ ཏེ་"
msgstr "the afflictive minds and their connected karmas,"

msgctxt "cf8e7503dd3947e798f851633aeeb366"
msgid "དེ་ གཉིས་ ལས་འབྲས་ བུ་སྡུག་ བསྔལ་ འབྱུང་བ་"
msgstr "the emergence of suffering results from these two."

msgctxt "bf08ec506fe64f229624e32073fb9b4d"
msgid ""
"འཁོར་བ་ རྒྱུ་འབྲས་ དགག་ བཅས་ སྤང་བྱ་ ལྡོག་པ་␣འི་ ཚུལ་ཁྲིམས་ ལུང་ རྣམ་འབྱེད་ "
"ཀྱིས་ བསྟན་པ་ ན་"
msgstr ""
"The full analytical scripture shows the discipline that disengages from "
"abandoning, which is related to the cessation of samsara's cause and effect."

msgctxt "d34ac3e101b74e94a8258c460105a6e7"
msgid "ཉིས་ བརྒྱ་ ལྔ་ བཅུ་ རྩ་ གསུམ་ སྡུག་བསྔལ་ ཤེས་པ །"
msgstr "Two hundred fifty-three knowledge of suffering"

msgctxt "5ca45a2d40bd4decacbc5432713db4e9"
msgid "ཀུན་འབྱུང་ སྤོང་བ་ དང༌ །"
msgstr "After the origin is abandoned,"

msgctxt "7bb475f33919465e81304ff9afbb7c06"
msgid "རྩ་བ་ བླ་མ་ ཡན་ལག་ འཕགས་ལམ་ བསྟེན་པ་␣ས་"
msgstr "[one] attends the branches of the noble path of the root guru"

msgctxt "6285e32feeca49608bd03c29acd4cf45"
msgid "འབྲས་བུ་ འགོག་པ་ ཐོབ་པ་"
msgstr "The fruits of cessation will be attended. "

msgctxt "7bc4133f1ac349e09b3704deab9bce0f"
msgid "མྱང་འདས་ རྒྱུ་འབྲས་ སྒྲུབ་ བཅས་"
msgstr "To accomplish the cause and effect of nirvana."

msgctxt "a0175cb945934a4fa2e326a5e535d7fd"
msgid "བླང་ བྱ་ འཇུག་པ་␣འི་ ཚུལ་ཁྲིམས་ ལུང་བཞི་␣ས་ བསྟན་པ་"
msgstr "The four scriptures show the discipline that engages in adopting,"

msgctxt "f216102f9a9f47c2ba074ddb3b82b062"
msgid "རབ་བྱུང་ སོགས་ བཞི་ བཅུ་བདུན་ ལས་མི་ འགལ་བ་ ལམ་ དང་ །"
msgstr ""
"The path that does not contradict the forty-seven paths including Rabjung."

msgctxt "f2d324b4c7d4474f8237004f21dc7dca"
msgid ""
"དེ་␣ས་ ཀུན་འབྱུང་ སྤང་བ་␣ས་ སྡུག་བསྔལ་ འགག་པ་ འགོག་ འདེན་ ཡིན་པ་␣འི་ ཕྱིར་ "
"དང་ ༑"
msgstr ""
"This will abandon the origin and hence end the suffering; thus it is the "
"truth of cessation. "

msgctxt "c092aa13862443ca8713e265aee33e1f"
msgid "བསྟན་བཅོས་ ཁོ་ན་␣ས་ ཀྱང་ ལུང་སྡེ་བཞི་␣འི་ དོན་"
msgstr ""
"The treatises alone, the meaning of the four sections of the scripture, "

msgctxt "a985315e15cb4492b20b8ab08c49b860"
msgid "བདེན་ བཞི་␣ར་ བཀྲལ་ ཏེ་ ངེས་འབྱུང་ གི་ དབང་ དུ །"
msgstr ""
"the four truths are elucidated and with the power of definite emergence,"

msgctxt "cd9ba85a9ced4d5cad946eae5e5b687b"
msgid "གང་ འབྱུང་ ན་ གང་ཟག་ གམ་ ཀུན་འབྱུང༌ །"
msgstr "A person or the origin is where it occurs."

msgctxt "44fbe99c52e04368961624ece9b842bd"
msgid "གར་ འབྱུང་ ན་ མྱང་འདས་ སམ་ འགོག་པ །"
msgstr "Nirvana or cessation is what it occurs."

msgctxt "8dd6f3f37d714f6a8672cf9409d58823"
msgid ""
"ཐབས་ཚུལ་ གང་ གིས་ འབྱུང་ ན་ འཕགས་ལམ་ དགག་སྒྲུབ་ ཀྱི་ བསླབ་པ་␣འི་ ཚུལ་ གྱིས་ "
"འབྱུང་བ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"The training of the noble path of cessation and assertion is how it occurs."

msgctxt "293e8e4789a44d4fa37c23c2881075ee"
msgid "གནས་མལ་ གྱི་ གཞི་ ལས་སྒོ་ གདོད་ དུ་"
msgstr "The prime door from the basis of the shelter"

msgctxt "7692bcbe1a8f4d61aae7c8f53ad21d3f"
msgid "སྲིད་པ་␣འི་ འཁོར་ལོ་ ཆ་ ལྔ་པ་␣ར་ གསུངས་པ་ དང །"
msgstr "The wheel of existence is taught in the five aspects."

msgctxt "a4f6b1ba28b847d080703b2bdb8d88ee"
msgid "ལུང་ ཡང་"
msgstr "The scriptural passage as well:"

msgctxt "7aaf4eb95a3c44a3a2fc6f3a70b2cf2b"
msgid "དགེ་སློང་ དག  ། ང་ དང་ ཁྱེད་ཅག་ ཁོ་ན་ ལ་␣ས །"
msgstr "Monks, except for you and me,"

msgctxt "61037f92f6b34a58ad2919b153aa3cb3"
msgid "འཕགས་པ་␣འི་ བདེན་པ་ བཞི་པོ་ དག །"
msgstr "The four truths of the noble ones,"

msgctxt "0e38a25f8a5046f7b1e1b702ad45cbda"
msgid "ཇི་ལྟ་བ་ བཞིན་ མ་ མཐོང་བ་␣ས །།"
msgstr "Are not seen as they are, therefore"

msgctxt "a7bf2166be5f4bd983d2cee0581386c3"
msgid "ཡུནརིང་ ལམ་ དུ་ ལཁོར་ བར་ འགྱུར །"
msgstr "[Others] circle for a long time in the path."

msgctxt "c8f08a86e86043a2ae886df9b97ec031"
msgid "ཞེས་ དང༌ །"
msgstr "And,"

msgctxt "09094da162334a1598c308975a244735"
msgid "སློབ་དཔོན་ ཀླུ་སྒྲུབ་ ཀྱིས །"
msgstr "Master Nagarjuna said:"

msgctxt "6c78982b649545e5ac2e51f526e375e6"
msgid "ཀཱ་ ཤི་ ཀ་ ཡི་ ཝཱ་ རཱ་ ཎ་ སཱི་ རུ ། །"
msgstr "Kashika in Varanasi,"

msgctxt "70608384969149008c148c5f82e8cda6"
msgid "ཆོས་ ཀྱི་ འཁོར་ལོ་ རྣམ་གྲོལ་ རྨད་བྱུང་ བས ། །"
msgstr "Because of the marvelous Dharma wheel of complete liberation,"

msgctxt "f14246b632464aef957eac6f65d3a57f"
msgid "ཉོན་མོངས་ སྒྲིལ་པ་ རྣམ་པ་␣ར་ གཅོད་ མཛད་པ་␣འི ། །"
msgstr "Afflictions and obscurations will be eliminated."

msgctxt "4e075382805e40a9905eee6be3a6ad73"
msgid "ཡེ་ཤེས་ མཆོད་རྟེན་ བཞི་ ལ་ ཕྱག་ འཚལ་ ལོ །"
msgstr "I pay homage to the four stupas of wisdom."

msgctxt "695a3ef775fa430588ccd009de62b8f0"
msgid "ཞེས་ སོ ། །"
msgstr "As said."

msgctxt "ae6147eaa39a43fa8d0ca41b73c47a3a"
msgid "རིག་པ་ ཕ་␣འང་ བདེན་ བཞི་ ལ་␣ས་ གཞན་ འདུལ་བ་ མེད་པ་␣ས་ སོ །"
msgstr "There is no Vinaya other than the four truths, the father of rigpa."

msgctxt "0c0e08e58870453ebe96f662d48a9829"
msgid "རྡོ་␣༽༽  གཞན་ བཞེད་པ་"
msgstr "Vajra: Others accept that,"

msgctxt "bf59278b6c3040ceaca1910273f9a645"
msgid "ཐེག་པ་ སྣ་ཚོགས་ སྟོན་པ་ བར་པ་ མཚན་ཉིད་ མེད་པ་ ངེས་དོན་ དང་"
msgstr ""
"From the teachings of the different kinds of vehicles, the middle one is "
"definitive meaning and absence of defining characteristics."

msgctxt "2abcb6fecfcc45a4aa4f769534ed0bac"
msgid "འགའ་ཞིག་ གོན་ དང་ བཟང་པོ་ ལ་ ཤེས་པ་␣ར་ བརྗོད་པ་ དང་པོ །"
msgstr "Some of it is said to Trapusa and Bhallika, which is the first one."

msgctxt "e3df737a2db549b4b74ce4faf05e8792"
msgid "བདེན་ བཞི་ བར་པ་ མཚན་ཉིད་ མེད་པ་ ངེས་དོན །"
msgstr ""
"The four truths and the middle with the absence of defining characteristics "
"are definitive meaning. "

msgctxt "40d43d35bdef497aa2b7862fde4c85e3"
msgid "ཐེག་པ་ སྣ་ཚོགས་ བསྟན་པ་ མ་ངེས་པ་␣འི་ འཁོར་ལོ་ ཡིན་ ཟེར་ ཞིང༌ །"
msgstr ""
"The teaching of the various vehicles is said to be the indefinite wheel of "
"the Dharma."

msgctxt "d20cfe63876c42c5ba2991fbac3dda90"
msgid "ཕྱི་མ་ གཉིས་ ཀྱང་ ངེས་དོན་ མིན་ ཏེ་"
msgstr "The latter two are likewise not a definitive meaning."

msgctxt "2b5ac770586349abbd28cb479dbfb2c3"
msgid "རྒྱུད་ བླ་␣ར །"
msgstr "According to The Highest Continuum:"

msgctxt "7e7ca1ba121f4978a99359a7f381f006"
msgid "སྤྲིན་ དང་ རྨི་ལམ་ སྒྱུ་མ་ བཞིན །"
msgstr "Like a cloud, a dream, or an illusion."

msgctxt "e72d2b6bacbb49c8bd6c1629e405472e"
msgid "དེ་ དང་ དེ་␣ར་ སོགས་ ཀྱི་ དྲང་དོན་ ཡིན་མོད་"
msgstr "Even though, all of these are of provisional meaning."

msgctxt "20c2c3e65587483f8cb83a185f673480"
msgid "འདི་␣ར་ མགོན་པོ་ འབྲི་གུང་པ་␣འི་ བཞེད་པ་ ནི་"
msgstr "In this [system], the philosophical position of lord Drigungpa is"

msgctxt "ae578490f1d04346b2a991e23cd54dee"
msgid "ཐེག་པ་ སྣ་ཚོགས་ ངེས་དོན་ འཁོར་ལོ་ སྟེ་"
msgstr ""
"The different kinds of vehicles are the wheel of definitive meaning because"

msgctxt "cf29c10f3b2b4e17b9f139cf179170f2"
msgid "རིམ་པ་␣འི་ དབང་ གིས་ དང་པོ་␣ར་ རྒྱུ་འབྲས་"
msgstr "In terms of stages, the first is cause and effect."

msgctxt "f05dd73757994c47806bef631a9e47e7"
msgid "བར་པ་␣ར་ སྟོང་པ་ཉིད་ དུ་ བསྟན་པ་ མཚན་ཉིད་ མེད་པ་"
msgstr ""
"the middle shows emptiness which is the absence of defining characteristics."

msgctxt "a09b83ef478542999c2085465fcbea71"
msgid "ཐ་མ་␣ར་ དེ་␣འི་ སྟེང་ དུ་ སྟོང་ཉིད་ རྒྱུ་འབྲས་ སྣ་ཚོགས་ ལ་ འཇུག་པ །"
msgstr "Finally, above it, emptiness engages in various causes and effects,"

msgctxt "7447d525f06d4330a95bdb0ba0920ac4"
msgid "ལམ་སྣ་ ཚོགས་ སུ་ འབྱུང་བ་ ཐེག་པ་ སྣ་ཚོགས་ བསྟན་ ནས་"
msgstr "various paths have emerged, and by teaching various vehicles,"

msgctxt "cee509698cea44f2950add127e9fb52f"
msgid "ཐེག་པ་ གཅིག་ ཏུ་ གཏན་ ལ་ ཕབ་ སྟེ་"
msgstr "One vehicle has been determined."

msgctxt "931a49c848cb41e39461234cb684c730"
msgid "དཀོན་མཆོག་ གསུམ་ རྟག་པ་ རྒྱུན་ མི་ ཆད་པ་ གཏན་ ལ་ ཕབ་པ་␣འི་ ཕྱིར་ དང་"
msgstr "The three jewels are determined as constant and uninterrupted."

msgctxt "7c8a9c3d2fae4f9db5a0a3a32f33321f"
msgid "ལུང་ ཡང་ དེ་བཞིན་ གཤེགས་པ་␣འི་ སྙིང་པོ་␣འི་ མདོ་␣ར་"
msgstr ""
"The scriptural passage also in the sutra of The Essence of All the "
"Tathagatas:"

msgctxt "338bbcac51bd4de484b9d0db6c49a275"
msgid "ནོར་བུ་ བསྐྲུ་བ་ གསུམ་"
msgstr "The threefold refinement of the gem."

msgctxt "180a6787469f4192b69e6cdf0b071821"
msgid "ཕྱི་བ་ གསུམ་ གྱི་ དཔེ་ སྙིང་པོ་ བསྟན་པ་␣ར་ གསུངས་པ་␣ས་"
msgstr ""
"It is said that the examples of the three externals are shown essentially. "

msgctxt "c1a4b2fe810a40df9686084f84d2c459"
msgid ""
"ཐ་མ་ དེ་ ངེས་དོན་ དགོངས་པ་ ངེས་ འགྲེལ་ ལ་␣ས་ ཀྱང་ ཐ་མ་ བླ་ ན་མ་ མཆིས་པ །"
msgstr ""
"The final one is definitive meaning, it is more unsurpassable than the "
"Unravelling of the Thought"

msgctxt "3cd686011b8c4079b13a07a937a6ede1"
msgid "སྐབས་ མ་ མཆིས་པ །"
msgstr "Not adapted to the circumstances"

msgctxt "3b0fd7cad1b24629bbd6792ea12e1bc6"
msgid "ངེས་པ་␣འི་ དོན་ རྩོད་གཞི་␣ར་ མ་ གྱུར་པ་␣ར་ གསུངས་ ཤིང༌ །"
msgstr ""
"Said that the meaning of definitive does not become a basis for debate."

msgctxt "03c7a777ef15435a97ba758545f3e41e"
msgid ""
"བར་པ་ གཉིས་ བླ་ ན་ མཆིས་པ་ དང་ རྩོད་གཞི་␣ར་ ཅན་ དུ་ གསུངས་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"The middle [one] is surpassable and becomes a basis for debate. It is said "
"because"

msgctxt "af4eeacbaf264dec970e793405c07df2"
msgid ""
"ཉམས་ལེན་ གྱི་ རིམ་པ་ མངོན་རྟོགས་ སྐྱེ་བ་␣འི་ དབང་ གིས་ ཀྱང་ ཐ་མ་ ངེས་དོན་ "
"དུ་ ངེས་པ་ ཡིན་ ནོ ། །"
msgstr ""
"In the stages of practice, also by the power of arising the manifest "
"realization, one gains certainty about the definitive meaning at the end."

msgctxt "bac16025137541e39971c80107649e38"
msgid ""
"འོ་ན་ ངེས་དོན་ སྟོང་ཉིད་ དྲང་དོན་ རྒྱུ་འབྲས་ ཡིན་ གསུངས་པ་ དང་ འགལ་ སྙམ་ ན །"
msgstr ""
"Well, if [one] thinks it contradicts the statement, the definitive meaning "
"is emptiness and the provisional meaning is cause and effect,"

msgctxt "788f9dcf0baf424880a8ff00fcd563be"
msgid ""
"དེ་ ནི་ ཕྱོགས་ རེ་ཙམ་ ལྡོག་པ་ ནས་ གསུངས་པ་ མ་གཏོགས་ སྟོང་ཉིད་ རྒྱུ་འབྲས་ "
"དབྱེ་␣ར་ མེད །"
msgstr ""
"Except that it is only stated for a few isolated sides; emptiness and cause-"
"effect are inseparable."

msgctxt "a7ba8bd9983d45a49fbc4f4877d04ffa"
msgid "ཕྱི་མ་ ངེས་དོན་ ཏེ་ མཁའ་འགྲོ་ དྲྭ་བ་␣འི་ ལེའུ་ ལ་␣ས །"
msgstr ""
"The latter is the definitive meaning since, according to the Dakini Net "
"chapter:"

msgctxt "6e302ee23d6e439d8b09182a2cf26317"
msgid "གལ་ཏེ་ སྟོང་པ་ ཐབས་ ཡིན་ ན །"
msgstr "If empty is the method,"

msgctxt "9647ddd539e5415b9a0b55b235ecfa89"
msgid "དེ་ ནི་ སངས་རྒྱས་ ཐོབ་ མི་ འགྱུར །"
msgstr "Then buddhahood will not be attained."

msgctxt "a91b5203fc2c46ec8dba52002524a25e"
msgid "ཞེས་པ་ ཡིན་ ནོ །"
msgstr "As it is said."

msgctxt "b4802f9ea18e4f46b82a9744707ddfcb"
msgid "རྡོ་␣༽༽  གཞན་དག་ ན་རེ །"
msgstr "Vajra: others said,"

msgctxt "9f86bb39f346451d8bf1ca859133c786"
msgid "དྲང་དོན་ ངེས་དོན་"
msgstr "the provisional meaning and the definitive meaning"

msgctxt "b925598ed6314b8fac5b5747084ed22d"
msgid "དགོངས་ ཅན་ དགོངས་ མིན་"
msgstr "Implied meaning and not implied meaning."

msgctxt "2c923ea2c912474782bc716e67a9cc12"
msgid "སྒྲ་ ཇི་བཞིན་ ཇི་བཞིན་ མ་ཡིན་པ་ མཐའ་ དྲུག་ ལ་␣ས༌"
msgstr "From the six extremes whose utterances are not literal,"

msgctxt "6ce9933eb1f9449d9d9a40b7a6b2f623"
msgid ""
"དྲང་དོན་ དགོངས་ ཅན་ སྒྲ་ ཇི་བཞིན་ མ་ཡིན་པ་ གསུམ་ གནས་སྐབས་ ཐབས་ ཀྱི་ "
"རྫུན་པ་␣ར་ གསུངས་པ་␣ས་ ངེས་དོན་ ཡིན་ ཟེར་ རོ ། །"
msgstr ""
"Three are the provisional meanings, whose implied meanings are not literal "
"and are spoken in a certain circumstance as a method of false, and thus it "
"is said as the definitive meaning."

msgctxt "a3e92fd5e10d4b3b80dd8d038cc615fd"
msgid "འདི་␣ར་ ནི་ མཐའ་ དྲུག་ དགོངས་པ་ ངེས་པ་␣འི་ དོན་ འབའ་ཞིག་ ཏེ་"
msgstr ""
"In this [system], the implied meanings of the six extremes are only the "
"definitive meaning. "

msgctxt "506f178b7ab542d6b8229ba1a16562f7"
msgid "དེ་ ཁོ་ན་ཉིད་ དུ་ བཞེད་པ་ ཡིན་ ཏེ་"
msgstr "It is accepted just that and not anything else because"

msgctxt "31e3c7c292844e11beb9dc82af954bf4"
msgid ""
"འདི་␣ར་ ནི་ སངས་རྒྱས་ ཀྱིས་ སེམས་ཅན་ འཁོར་བ་ ལ་␣ས་ ཐར་པ་␣འི་ ཐབས་ རྒྱུ་འབྲས་"
" རྟེན་འབྲེལ་ ལ་ ཇི་ལྟར་ ཡོད་པ་ དེ་ བསྟན་པ་␣ས་"
msgstr ""
"In this [system], The Buddha taught the dependent relations of cause and "
"effect according to how they exist as a method of liberating sentient beings"
" from samsara."

msgctxt "cc07b3e08a3841b386f2601b79bd62cb"
msgid ""
"སྟོན་ ལུགས་ ཇི་ལྟར་ མཛད་ ཀྱང་ ཐབས་མཁས་ མཐའ་ ཡས་ ཀྱི་ རྣམ་ རོལ་ ཡིན་པ་␣ས་"
msgstr ""
"The different ways of teaching are skilled methods in infinite "
"manifestations."

msgctxt "2a7d32e96f214d13869b4363db1f056f"
msgid ""
"མཐའ་ དྲུག་ ཀ་ ལྷུན་གྲུབ་ བདེ་བ་ ཆེན་པོ་␣ར་ འདྲེན་བྱེད་ ཀྱི་ གསུངས་ ཡིན་པ་␣ས་"
msgstr ""
"Since the six extremes serve as a guideline for spontaneously achieving the "
"Great Bliss."

msgctxt "b3cc1fdf8514404ea6c6d0ef0a8fa880"
msgid "དེ་␣འི་ ངོས་ ནས་ ཐམས་ཅད་ དྲང་དོན་ ཡིན །"
msgstr "It's all provisional meaning from that perspective."

msgctxt "0131f92aa6fd4df99767a2c3097a08fd"
msgid "གནས་སྐབས་ མཐར་ཐུག་ གི་ འབྲས་བུ་ འགྲུབ་ ཚུལ་"
msgstr ""
"The ways of accomplishing the ultimate result in a certain circumstance."

msgctxt "03bde1ccdbae4f9c88c06b8f27d721cc"
msgid "འཁོར་བ་␣འི་ སྡུག་བསྔལ་ གྱི་ བསྐྱེད་ ཚུལ་ རྣམས་"
msgstr "The ways of arousing the sufferings of samsara."

msgctxt "26057fa1558f48d79b582f92e99f5a1f"
msgid ""
"བསླུ་མེད་ འབྲས་བུ་འབྱུང་ བར་ ངེས་པ་␣འི་ ཕྱིར་ ངེས་དོན་ འབའ་ཞིག་ ཡིན་པ་␣ས་"
msgstr ""
"It is certain that the undeceiving result will occur, hence it is only "
"definitive meaning."

msgctxt "43fe992c03dc467d862f5c8e9ede0d09"
msgid "དོན་ ལ་ དྲང་ ངེས་ ཐ་དད་ མེད་ དེ ། །"
msgstr ""
"In reality, there is no distinction between provisional and definitive "
"[meanings]."

msgctxt "43ab55f7e248460f80f3d3a72ad89c01"
msgid "ཟླ་བ་ སྒྲོན་མེ་␣འི་ མདོ་␣ར །"
msgstr "According to the Moon Lamp sutra:"

msgctxt "41a026bf353f4d67b26d7e927a558fa1"
msgid "གཞོན་ནུ་ ཁྱེད་ ལ་ བསྒོ་ ཞིང་ བསྟན་པ་␣ར་ བྱ །"
msgstr "Young man, I will instruct and show you,"

msgctxt "118dab34f18743b3877aa18eab4e38e0"
msgid "དད་པ་␣ར་ གྱིས་ ཤིག་ ང་ ལ་ མི་ བདེན་ མེད །"
msgstr "Have confidence [in me], I have no untrue."

msgctxt "9fcc2b9b4aaf4e4cb97f04598c48b44d"
msgid "བདེ་གཤེགས་ རྫུན་ གྱི་ ཚིག་ ནི་ མི་སྨྲ་ སྟེ །"
msgstr "Sugata will never express false words."

msgctxt "c16bf8c5c5c3496a93af11dff3800fd3"
msgid "ཐུགས་རྗེ་ རྒྱལ་བ་ རྟག་ ཏུ་ བདེན་པ་␣ར་ གསུང༌ །"
msgstr "The compassionate conqueror always speaks the truth."

msgctxt "b3e49a8ba58a41679057e0790a5ed2b1"
msgid "ཞེས་ དང་"
msgstr "And"

msgctxt "1744626ea9ef485793eeb778c6cb497d"
msgid "གསེར་འོད་ ལ་␣ས་"
msgstr "According to Golden Light:"

msgctxt "b6bad79669994155998746f9aa10e052"
msgid "བདེན་པ་ སྟོན་པ་ མི་ བསླུ་བ་ ཞེས་ སོགས་ ལུང་ མཐའ་ ཡས་ སོ ། །"
msgstr ""
"There are infinite scriptural passages such as the teaching of truth is non-"
"deceptive."

msgctxt "7e04e9de23b84320bd8c45674fef7d9f"
msgid "དེས་ན་ ཐུགས་རྗེ་ དང་ རྟེན་འབྲེལ་ ཇི་བཞིན་ གཟིགས་པ་ དང་"
msgstr "Thus, compassion and interdependence, observation as it is and "

msgctxt "3b22c2f8597c4be2bede2f20907c09a8"
msgid "སེམས་ཅན་ ལ་ ཕན་བདེ་ སྒྲུབ་ ཕྱིར་ ངེས་དོན་ འབའ་ཞིག་ ཡིན་པ་ ལ་"
msgstr ""
"To accomplish benefit and ease for sentient beings is only the definitive "
"meaning."

msgctxt "f3b5be80316740f2a24c689e44b29c8b"
msgid ""
"བདེན་རྫུན་ ཕྱེ་བ་ ནི་ མནར་མེད་ དུ་ སྐྱེ་ ང་␣འི་ ལ་␣ས་ གསོག་པ་␣ས་ རྣ་བ་ བག་ "
"ཡོད་ བྱ་ སྟེ་"
msgstr ""
"For dividing true and false, [one] will be born in the Unending Torment "
"[Hell]. I should be heedful of the ear as I accumulate karma."

msgctxt "2e433ab15fa9425cbba6feef685083d8"
msgid "དེ་ཕྱིར་ མཐའ་ དྲུག་ དགོངས་པ་ ངེས་དོན་ འབའ་ཞིག་ བཞེད་ དོ ། །"
msgstr ""
"Because of that, the intent of the six extremes is only accepted as the "
"definitive meaning."

msgctxt "0cb1430fe5f044cc946ebedfb6c826a6"
msgid "རྡོ་␣༽༽  གཞན་དག་ ན་རེ །"
msgstr "Vajra: others said,"

msgctxt "19b69d8509ef40878587a024eda031ca"
msgid "ཐེག་ཆེན་ དབུ་ སེམས་ གཉིས་ ཕར་ཕྱིན་ དང༌ །"
msgstr ""
"The Great Vehicle, both the Middle [Way] and the Mind [Only], Paramita and "

msgctxt "c188ebab82024fe981891bb951e89625"
msgid "ཕལ་ཆེན་ སོགས་ སེམས་ ཙམ་ མདོ་ བཞི་ ལྟ་བུ་ འཀའ་ ཐ་དད །"
msgstr ""
"The Majority [School] and others are distinct [Buddha-]words, similar to the"
" four sutras of the Mind Only."

msgctxt "4555ca93015b4673af249e6cacb88803"
msgid "བསྟན་བཅོས་ ཀྱང་ བྱམས་པ་␣ས་ དང་པོ་␣ར་ མངོན་ རྒྱན་ རྒྱུད་ བླ །"
msgstr ""
"Firstly, Maitreya's The Ornament of Manifest Realization and The Highest "
"Continuum as treatises. "

msgctxt "ac7f12ac9d3d405f991acdf57d6001b5"
msgid "གཉིས་པ་␣ར་ རྒྱན་ དང་ འབྱེད་ གཉིས་ མཛད་པ་ དང༌ །"
msgstr ""
"Secondly, [he] composed the Ornament of the Sutra Section and the two "
"Distinctions."

msgctxt "e96e5006ce924b6dac7c1dcc30dcbde3"
msgid "འཕགས་པ་ ཡབ་ སྲས་ ཀྱིས་ དབུ་མ་␣འི་ དགོངས་འགྲེལ་ རིགས་པ་␣འི་ ཚོགས་ དང༌ །"
msgstr ""
"The Commentary on the Intent of the Middle Way and the Collection of "
"Reasoning by Arya Father and Son."

msgctxt "035a36b37464469fbfb5d6cdc6bdb234"
msgid ""
"ཐོགས་མེད་ སྐུ་མཆེད་ ཀྱིས་ སེམས་ ཙམ་ གྱི་ དགོངས་འགྲེལ་ མངོན་པ་ གོང་འོག་ "
"ལྟ་བུ་"
msgstr ""
"The Commentary on the Intent of the Mind Only and the Higher and Lower "
"Abhidharma by Asanga and his brother."

msgctxt "5eaad03dfe4d49bf86016b7929efd220"
msgid ""
"མདོར་ན་ བཀའ་ བསྟན་ གང་ གི་ སྒོ་ ནས་ བརྟགས་ ཚེ་ དབུ་ སེམས་ ཐ་དད་ ཡིན་ ཟེར་ རོ"
" ། །"
msgstr ""
"In brief, When the Buddha-word and treatises are analyzed from all doors, "
"[they] said the Middle Way and Mind Only are distinct."

msgctxt "ca78cb6ce24540959708aeb62f94e073"
msgid "འདི་␣ར་ ནི །  སེམས་ ཙམ་ བཀའ་ ཡིས་ མཐའ་བྲལ་ དབུ་མ་␣འི་ དོན་ སྟོན་ ཏེ་"
msgstr ""
"In this [system], the instruction of the Mind Only taught the meaning of the"
" Middle Way, which is free from extremes."

msgctxt "db2d2cc3f92b4e0eb5fd9b03f2e73bad"
msgid "བཀའ་ དང་ བསྟན་བཅོས་ བླ་མ་␣འི་ མན་ངག་ གསུམ་ གྱིས་ ངེས་ ཏེ །"
msgstr ""
"Ascertained by the three: The Buddha-word, treatises, and the foremost guru "
"instruction."

msgctxt "e317ec0b472b40d2881a0a3c47ee527b"
msgid "དང་པོ་ ནི་ ལང་ གཤེགས་ ལ་␣ས །"
msgstr "According to the Descent to Lanka Sutra, the first is:"

msgctxt "b8cd3900392b4ff3ab1ef8e46d0ca62e"
msgid "སེམས་ ཙམ་ དུ་ ནི་ རྟོགས་པ་ དང་ །"
msgstr "By realizing [things] as mind only and "

msgctxt "a4bff4ec9bfe4fa189c2cd1165e18a38"
msgid "དངོས་པོ་ ཐམས་ཅད་ རྣམས་ གསལ་བ །"
msgstr "All things become completely clear."

msgctxt "8f5bd9a36b984416b5bef137fba0f9e6"
msgid "ཕྱི་རོལ་ རྟོག་པ་ རྣམས་ བཟློག་ སྟེ །"
msgstr "It will put an end to all the external conceptualities."

msgctxt "9057ca10fd0f498899e5bfe8e052fa76"
msgid "ལམ་ དེ་ཉིད་ ནི་ དབུ་མ་␣འོ ། །"
msgstr "This path is the middle way."

msgctxt "7056b7f9c6aa4a2896b64801ef2753d0"
msgid "ཞེས་པ་␣ས་ དང་ །"
msgstr "And,"

msgctxt "b13918e591c547d3bdde54731c55e36d"
msgid "གཉིས་པ་ ཡོད་མེད་ ཀྱི་ མཐའ་ གཟིགས་པ་"
msgstr ""
"The second is the consideration of the extremes of existent and non-"
"existent. "

msgctxt "97828b41011543c0922eb59264652278"
msgid "སློབ་དཔོན་ འཕགས་པ་ དེ་ མདོ་ རྒྱུད་ ཉེར་ གཅིག་ ཏུ་ ལུང་བསྟན་ ཀྱང་"
msgstr ""
"In twenty-one sutras and tantras, Master Arya is prophesied, moreover,"

msgctxt "7407ff8ab3e64026a0ddf2e805d2a066"
msgid ""
"ཕར་ཕྱིན་ དབུ་མ་␣འི་ བཀའ་ ལ་མ་ བརྟེན་པ་␣ར་ རྔ་བོ་ ཆེ་ ལང་ གཤེགས་ འཇམ་དཔལ་ "
"རྩ་རྒྱུད་ སོགས་"
msgstr ""
"Without relying on the instructions of Paramita and the middle way, in the "
"sutras of the Great Drum, the Descent to Lanka, The Manjushri Root Tantra, "
"and others,"

msgctxt "0491617048e047c7b41e0b2534385866"
msgid "སེམས་ ཙམ་ གྱི་ བཀ་␣ར་ ལུང་བསྟན་ ཅིང་"
msgstr "It has been prophesied as the instructions of the Mind Only"

msgctxt "eaecfd2868ef4fa68a72ec3645b66c8a"
msgid "ཆོས་འཁོར་ བསྐོར་བ་␣ར་ འགྱུར་ རོ་ ཞེས་ གསུངས་པ་␣ས་"
msgstr "It is said that [he] will turn the wheel of the Dharma."

msgctxt "6055dcd4ce9648e38faee55ac9dcf95a"
msgid "ལུང་བསྟན་པ་␣འི་ གསུངས་ རབ་ དེ་"
msgstr "The scriptures that were shown in the prophecy"

msgctxt "6197918103ae4567a1e669754bfb86f1"
msgid "གང་ཟག་ དེ་␣ས་ སྐོར་ རྒྱུ་␣འི་ ཆོས་ སུ་ འདོད་པ་␣ས་ དང་ །"
msgstr "It is accepted that the person will turn these dharmas."

msgctxt "349e3f5a21b44692b76cc33e94be0adc"
msgid ""
"གསུམ་པ་ མན་ངག་ ཡང་ སེམས་ ཙམ་ གྱིས་ ཆོས་ ཐམས་ཅད་ སེམས་ ནང་ དུ་ གཏན་ ལ་ ཕབ་པ་ "
"ན །"
msgstr ""
"Thirdly, the foremost instruction is also when the Mind Only [school] "
"determines all phenomena in the mind,"

msgctxt "3c247fc708604c0989d6ed5b19fd5beb"
msgid "སེམས་ ཀྱང་ སྤྲོས་བྲལ་བ་␣འི་ དབུ་མ་ ཡིན་ ཏེ །"
msgstr "the mind too is the middle way, free from elaboration;"

msgctxt "bfdce3e1cb2c4ca297efcfaf72144deb"
msgid "སེམས་ ཀྱི་ རང་བཞིན་ འོད་གསལ་བ་ ཞེས་ གསུངས་པ་␣ས་ སོ་␣༑"
msgstr "The nature of the mind is said to be naturally luminous."

msgctxt "76e115c445984e9cb085b4d46b7471cd"
msgid "ལྷན་␣༽༽  མཁས་པ་ གཞན་ གྱིས་ སངས་རྒྱས་ ཀྱི་ ཆོས་སྡེ་ སྣོད་ དུ་ བྱས་ ན་"
msgstr ""
"Addendums: other experts said that if the Buddha's Dharma is created into "
"pitakas,"

msgctxt "2184756409904009a066d002a1310a7b"
msgid ""
"ལུང་སྡེ་བཞི་ འདུལ་བ་␣འི་ སྡེ་སྣོད་ དེང་སང་ མདོ་ མང་ དུ་ གྲགས་པ་ འདི་ རྣམས་ "
"མདོ་སྡེ་␣འི་ སྡེ་སྣོད །"
msgstr ""
"The Four Sections of the scripture is the Vinaya pitaka, those sutras that "
"are widely renowned are the Sutra pitaka, "

msgctxt "328ec8fbee5a4ad8b57131c1162ebefa"
msgid "མངོན་པ་ ལ་ གོང་འོག་ གཉིས་ ལ་␣ས་"
msgstr "from both the Higher and Lower Abhidharma,"

msgctxt "d5b4dbc2bb104ea4b21b6d5fea92d0c7"
msgid ""
"གོང་མ་ ནི་ མུ་སྟེགས་ ཀྱི་ རྒན་མོ་ སྒྲ་མཁན་ དང་ སྤྲང་པོ་ ཉི་མ་␣འི་ དངོས་གྲུབ "
"།"
msgstr ""
"Because the Higher [Abhidharma] was destroyed by the old lady musician of "
"tirthikas, the beggar Nyime Ngotrub, and "

msgctxt "18c5643ab36d4b55979f1c102e6ba660"
msgid "སྟག་ གཟིགས་ ཀྱི་ རྒྱལ་པོ་ གསུམ་ གྱིས་ བསྣུབས་པ་␣ས་ བོད་ ན་ མི་ བཞུགས །"
msgstr "the King of Tagzik, it no longer resides in Tibet."

msgctxt "44ff0660d21143de9724bbc7ade2f1f1"
msgid "གཉིས་པ་ སེམས་ ལ་ འཇུག་པ་ རྣམ་ཤེས་ ཚོགས །"
msgstr "Second, the collections of consciousness to engage in mind."

msgctxt "24916b7e6ac148b3ab05b00bb7e4aeaa"
msgid "རབ་ཏུ་ རྣམ་འབྱེད །"
msgstr "An extremely fine analysis."

msgctxt "7cb60aae10d34f35b6522a7af202eb3c"
msgid "ཆོས་ ཀྱི་ ཕུང་པོ་ རུ་ གདཌ་པ །"
msgstr "Designated as the aggregate of phenomena."

msgctxt "6f3d1f418768416a99eaec4c00a2e719"
msgid "ཡང་དག་པ་␣ར་ འགྲོ་བ་ སྟེ་"
msgstr "Going with what is genuine, "

msgctxt "4378ea59852b40c8b7a6b36a3fcb8bb5"
msgid ""
"བདུན་པོ་ དེ་ ཉན་ཐོས་ བདུན་ གྱིས་ མཛད་པ་␣ས་ འོག་མ་ ཡིན་ གོང་མ་ ལོགས་ སུ་ མེད་"
" ཟེར་ རོ །"
msgstr ""
"Because these seven are composed by the seven shravakas, they are the lower,"
" and there is no separate higher."

msgctxt "786bb074cd7c44a5ae061b68953661e2"
msgid ""
"འདི་␣ར་ ནི་ ཐུན་མོང་ གི་ མདོ་ དང་ ཐུན་མོང་ མ་ཡིན་པ་ སེམས་ ཙམ་ སྟོན་པ་␣འི་ "
"མདོ་ རྣམས་ མངོན་པ་␣འི་ སྡེ་སྣོད་ དུ་ བཞེད་ དོ ། །"
msgstr ""
"In this [system], the common sutras and the uncommon sutras, the sutras of "
"the Mind Only are accepted under the Abhidharma Pitaka. "

msgctxt "bd1f4c8a5cf24789ad7ecc4a764b997e"
msgid "བདེན་ བཞི་ འདུལ་བ །"
msgstr "The four truths, the Vinaya,"

msgctxt "fcba91cf7a9c4ee8bd6a46de6080d302"
msgid "མཚན་ཉིད་ མེད་པ་ མདོ་སྡེ །"
msgstr "the absence of defining characteristics, the Sutra Pitaka,"

msgctxt "1de726fd588247929b6cbf14433fb1c6"
msgid ""
"ངེས་དོན་ འཁོར་ལོ་ སྙིང་པོ་␣འི་ མདོ་ སེམས་ ཙམ་ མདོ་ བཞི་ སོགས་ མངོན་པ་ "
"གོང་འོག་ མ་ ཡིན་ ཏེ །"
msgstr ""
"The essence of the definitive meaning wheel sutras, the four sutras of the "
"Mind Only, and others are not the Higher and Lower Abhidharma."

msgctxt "a9cd880b41814d69bd75d1ad92399a1c"
msgid "རྒྱུ་མཚན་ མངོན་པ་␣འི་ བསྟན་ དོན་ ལྷག་པ་␣འི་ ཤེས་རབ་ ཡིན་ ན་"
msgstr ""
"The reason for this is if the meaning of the Abhidharma teaching is the "
"higher insight,"

msgctxt "efa92a319b9a42a2a36e6f59b51d6d21"
msgid ""
"དེ་ཉིད་ མཐར་ཐུག་ མེད་དགག་ གི་ སྟོང་ ཀྱང་ ཙམ་ དུ་ མིན་པ་ སྣང་སྟོང་ ཟུང་འཇུག་ "
"ཆོས་སྐུ་ རྟག་པ་ རྒྱུན་ མི་ ཆད་པ་ སྟོན་པ་␣ར་ ངེས་དོན་ འཁོར་ལོ་ ཡིན་པ་␣འི་ "
"ཕྱིར་ རོ །"
msgstr ""
"It is not merely empty of non-affirming negation, but the definitive meaning"
" wheel is the teaching of the union of appearance and emptiness, dharmakaya,"
" which is permanent and uninterrupted. "

msgctxt "a5d7c4f48ff0402bb229dcd25202c7cc"
msgid "རྡོ་␣༽༽  ལོག་པ་␣འི་ ཀུན་རྫོབ་ ཆུ་ཟླ་ ལྟ་བུ་␣ས་ དོན་ མི་ བྱེད་པ་"
msgstr ""
"Vajra: The wrong relative, like the moon reflected in the water, serves no "
"function."

msgctxt "77bd4b05ff2a40ca9d2dbc3facdf2511"
msgid "སློབ་དཔོན་ ཕལ་ཆེ་བ་ འཞེད་ ཀྱང་"
msgstr "Though most masters accept it."

msgctxt "ee1a5ac26aeb4c66a9cbf6d4cec16de3"
msgid "འདི་␣ར་ དེ་ཉིད་ ཀྱིས་ ཀྱང་ དོན་ བྱེད་ ནུས་པ་␣ར་ འདོད་ དེ །"
msgstr ""
"It is accepted in this [system] that it [wrong relative] is capable of "
"performing a function."

msgctxt "39ab34dedc8d49539311eb42698b2c6c"
msgid "ཆུ་ཟླ་ དང་ གཟུགས་བརྙན་ ལ་ ཡང་ རང་བཞིན་ གྲུབ་པ་ མེད་པ་␣ར་ བརྟགས་ ན་"
msgstr ""
"If [one] analyzes the non-inherent existence of the moon reflected in the "
"water and the reflection,"

msgctxt "ddb81452acf14644922c54e26defb46b"
msgid "བདེན་ མ་ མཐོང་ ཞིང་"
msgstr "non-seeing of the truth, "

msgctxt "f39081a4d45c4d4c9bcb84480b9953bc"
msgid "རྟོགས་པ་␣ར་ བྱེད་པ་␣འི་ སེམས་ དང༌ །"
msgstr "the mind of realization and"

msgctxt "f74132f46aed48ecbe33f986a6c5a020"
msgid "དེ་␣ས་ བསྒྲུབས་པ་␣འི་ ལ་␣ས་"
msgstr "the karmas produced by it"

msgctxt "196294a295064c9c82f8bb8c45fbb4ff"
msgid "དེ་␣འི་ རྣམ་སྨིན་ འབྱུང་ སྟེ་"
msgstr "Its completely ripened [results] will occur."

msgctxt "a8af6068cb72455f8565a8ca9bc43da3"
msgid "དྲིན་ལན་ བསབ་ མདོ་␣ར་"
msgstr "According to the Repaying Kindness Sutra:"

msgctxt "a088cdedffd044bcb8f0b453af6cfeaf"
msgid ""
"བཙུན་མོ་ རི་དྭགས་ མ་␣འི་ བུ་ ལྔ་ བརྒྱ་ རྫིང་བུ་␣ར་ རང་ གི་ གཟུགས་བརྙན་ ཤར་བ་"
" མཐོང་བ་␣ས་ རང་ བྱང་ཆུབ་ ཐོབ་པ་ དང༌ །"
msgstr ""
"After seeing their reflections in a pond, the consort Ridakma's five hundred"
" sons attained pratyekabuddha enlightenment."

msgctxt "76076bafc31149b5910d6013768c1f35"
msgid ""
"བྲམ་ཟེ་ ཆེན་པོ་␣ས་ ཐོས་ ཆང་ དུ་ རྩི་ཤིང་ གི་ གཟུགས་བརྙན་ མཐོང་བ་␣ས་ ཕྱག་ "
"ཆེན་ རྟོགས་པ་ དང༌ །"
msgstr ""
"After seeing plant reflections in brewed wine, the great Brahmin realized "
"mahamudra."

msgctxt "245610526ac74879a343f5939407de58"
msgid "འདུལ་བ་ ལུང་ ལ་␣ས་"
msgstr "According to the Vinaya scripture:"

msgctxt "d1d3d772b7024764967de793c8d6a963"
msgid ""
"ཆུ་ ནང་ གི་ ཟླ་བ་ མཐོང་བ་␣འི་ སྤྲེའུ་ ལྔ་ བརྒྱ་ ཤི་བ་␣འི་ དོན་ བྱས་པ་ དང༌ །"
msgstr ""
"It performed the function of ending the lives of the five hundred monkeys "
"who had seen the moon reflected in the water."

msgctxt "1c0c65f7b32d410f8ca9c54791b600e4"
msgid "ཆུ་ཟླ་ དེ་ རྟེན་འབྲེལ་ ལ་ བབ་ ཀྱི་ མཐུན་པ་␣ར་"
msgstr ""
"The moon reflected in the water is concordant with the nature of "
"interdependence. "

msgctxt "46b12e83c7604c1fa41718c2ac545f8a"
msgid "ཀུན་ ལ་ སྣང་བ་ དང་"
msgstr "It appears to all,"

msgctxt "ee14abce21254f1790b228bb360d637d"
msgid "ནམ་མཁའ་ དང་ ཆུ་␣འི་ རྒྱུ་རྐྱེན་ ལ་␣ས་ སྐྱེས་པ་␣ས་"
msgstr "It arises from the cause and condition of the sky and water."

msgctxt "ac523f47bdd44446b3e383941ed99f26"
msgid "མཚན་ཉིད་ བཞི་ ཚང་བ་␣ས་ ཁྱད་པར་ མི་ བྱེད །"
msgstr ""
"It is not distinguished because it completes the four defining "
"characteristics."

msgctxt "6e9d21a814db4d48a1d3798eeb4ada80"
msgid "འོ་ན་ གང་ཡིན་ ན །"
msgstr "Well then, what is this? "

msgctxt "6559e60ea40b4c70b3822b58d5eb0ad5"
msgid "ཉོན་མོངས་ མེད་པ་ སེམས་ དགེ་བ་␣ས་ བསླང་ ཞིང་"
msgstr "The mind arises from virtue without affliction,"

msgctxt "1145c5ba00824ddba54dbb22df0d1bac"
msgid "ལ་␣ས་ སྒྲུབ་པ་ རྣམ་སྨིན་ དང་ བཅས་པ་ ཡང་དག  །"
msgstr ""
"Accomplished karmas, including those related to fully ripened [karma], will "
"be purified."

msgctxt "cbf49a451a29498b8a762ad10aa8336c"
msgid "དེ་ལས་ ལྡོག་པ་ ལོག་པ་␣འི་ ཀུན་རྫོབ་ སྟེ །"
msgstr "The reverse of that is the wrong relative."

msgctxt "c5ccfaa64822406781f094a4974d86ae"
msgid "སློབ་དཔོན་ ཀླུ་␣ས །"
msgstr "The master Nagarjuna said:"

msgctxt "6cf72be174c9477c9dc1198316b1bba0"
msgid "ཡང་དག་ ཀུན་རྫོབ་ རྣམ་ གཉིས་ སྐས །"
msgstr "The two types of stairways are authentic and relative."

msgctxt "a83567907c6a4210a92865158b0e8f65"
msgid "སོགས་ དང་ །"
msgstr "And so on."

msgctxt "a9eb98a9f3694c569aaa8ffcb964b167"
msgid "ཞི་བ་ལྷ་␣ས །"
msgstr "Shantideva said:"

msgctxt "3805f4d15ee44dd7a381ab9a01a7dcc4"
msgid "ཡན་ལག་ འདི་དག་ ཐམས་ཅད་ ནི །"
msgstr "All these branches of [the Dharma],"

msgctxt "d046759e5dd5417eb3c0d76dbe1f8377"
msgid "ཐུབ་པ་␣ས་ ཤེས་རབ་ དོན་ དུ་ གསུངས །"
msgstr "The Able One expounded for the sake of wisdom."

msgctxt "83ded2bd1449488f9285c95e72073efe"
msgid "ཞེསསོ །"
msgstr "As said,"

msgctxt "3feeec4562f44f6d9e72e516e83964b6"
msgid "རྡོ་␣༽༽  ཁ་ཅིག་ ན་རེ །་"
msgstr "Vajra: A certain person says:"

msgctxt "956c9dd4a7854acc91b2f760bf5b1996"
msgid "མཚན་ཉིད་ ཐེག་པ་␣འི་ ལམ་ ས་བཅུ་␣ས་ བགྲོད་ ཀྱང་"
msgstr ""
"Though, the path of the defining characteristic vehicle traversed the ten "
"levels,"

msgctxt "0f58379eac9546b2a08cb2417319d29e"
msgid "སྔགས་ལམ་ གཅིག་ ཆ་␣ར་ བས་ དེ་ འགྲོད་ མི་ དགོས་ ཏེ་"
msgstr ""
"Is simultaneous with the path of mantra, thus it does not need to be "
"traversed."

msgctxt "a023255e27ef438c910d124ab6e8ca65"
msgid "དེ་ལས་ གཞན་ ཞིག་ ཡིན་ ཟེར་ མོད །"
msgstr "It is said to be different."

msgctxt "fff687b448654ea29795ac69fa214c7d"
msgid "འདི་␣ར་ ནི །"
msgstr "In this [system],"

msgctxt "d13a032699b1439d91780b76be57d996"
msgid "ཇི་སྙེད་པ་␣འི་ ལམ་ རྣམས་ ས་བཅུ་པོ་ ནས་ བགྲོད་པ་ ཡིན་ སྟེ་"
msgstr "All of the paths traverse the ten levels."

msgctxt "be21c154f89a4cae9146c104c446749d"
msgid "མདོ་སྔགས་ གང་ཡང་ ས་ དང་པོ་ མཐོང་ལམ་ ནས་ ས་རིམ་ བཞིན་ བགྲོད་ དེ་"
msgstr ""
"In both sutra and mantra, one traverses progressively from the first ground "
"path of seeing and "

msgctxt "696c51bdf6a7405cb8e88d6cf591b7b7"
msgid "ས་བཅུ་␣འི་ རྒྱུན་མཐའ་ ལ་ ཤེས་སྒྲིབ་ ཆེ་ཆུང་ དང་"
msgstr ""
"At the end of the continuum of the tenth level, there are major and minor "
"obscurations to knowables and "

msgctxt "cd9a527dd0094eda899ca8558fff2495"
msgid ""
"སྔོན་ གྱི་ སྦྱང་པ་ ཡོད་མེད་ ཀྱི་ བགྲོད་ མྱུར་ མི་ མྱུར་ ཡང་ གཉིས་ཀ་␣ར་ ཡོད་ "
"དེ་"
msgstr ""
"There are both instances of quick and slow traverse depending on whether or "
"not having previous training. "

msgctxt "d0f7c48bc12246eba6861090a23c6ec9"
msgid "མཚན་ཉིད་ ལ་ ཡང་"
msgstr "In the defining characteristics as well,"

msgctxt "1862f3046c2141e2b56fa9cac91dc4b2"
msgid "གསང་ ཆེན་ ཐབས་ ལ་ མཁས་པ་ ལ་␣ས །"
msgstr "Great Secret who is an expert in method,"

msgctxt "1b70797260044e1dade962522d9f3650"
msgid "བྱང་སེམས་ དགའ་བྱེད་ ས་ དང་པོ་␣འི་ དུས་ སུ་"
msgstr "At the first ground that provides bodhisattvas joy"

msgctxt "3484734fe3504add944bf0af85dffe46"
msgid "ཉོན་མོངས་པ་␣འི་ འདུག་ལུགས་ མཐོང་བ་␣ས་"
msgstr "Seeing how the afflictive emotions are present,"

msgctxt "741b7f589ecf4c93bea47becaa809da0"
msgid "ས་ བརྒྱད་པ་ ཐོབ་པ་ དང༌ །"
msgstr "attained the eighth ground and "

msgctxt "215bc81f43c84a08a67958ab7f623f90"
msgid "སྔགས༌་␣ལ་ སློབ་དཔོན་ རྒྱལ་པོ་ ཚེ་ གཅིག་ སངས་རྒྱས་ ཐོབ་པ་ ཡང་"
msgstr ""
"In mantra, Master King's attainment of buddhahood in a single lifetime"

msgctxt "91c2edf32ad94fc4a348a78c21a87334"
msgid "འོག་མ་ མ་ བགྲོད་པ་ གོང་མ་␣ར་ ཕྱིན་ ཕ་ མིན་ ཏེ་"
msgstr ""
"Is not like proceeding to the higher [path] without traversing the lower "
"[path]."

msgctxt "5d525dc54d964ab7b7441519c692e10b"
msgid "ཨུཏྤ་ ལ་␣འི་ འདབ་མ་ འརྩེགས་པ་ ལ་ ཁབ་ ཀྱིས་ བསྙུན་པ་ བཞིན་ ནོ ། །"
msgstr "It's like sticking a needle through a layer of utpala leaves."

msgctxt "a711650a40af4aaf9b1c9a29f9e2d507"
msgid "དེ་ནས་ རིང་ དུ་ ཚོགས་ བསགས་པ་ དང་ ཉེ་ རྒྱུ་ བརྩོན་འགྲུས་ དང༌ །"
msgstr ""
"Then amass the accumulations for a long and immediate cause perseverance and"
" "

msgctxt "afaf25762a7d4f059c8a2670fdce1fe1"
msgid ""
"བླ་མ་␣འི་ བྱིན་རླབས་ འཛོམ་ ཚེ་ གོང་མ་ ཐབས་ བྱུང་ དུ་ སྐྱེ་བ་ ཡིན་ ཞིང་ །"
msgstr ""
"When the blessings of gurus are assembled, [one] will be born as superior, "
"arising from the skillful methods."

msgctxt "5f31a5a32e7c44a58e1fa4987f1cc44b"
msgid ""
"ཐབས་ ཁྱད་ ཙམ་ ལ་␣ས་ སངས་རྒྱས་ ཀྱི་ རྒྱུ་ དང་ འབྲས་བུ་ སྒྲུབ་པ་␣ར་ གཅིག་ གོ །"
msgstr ""
"Having only special methods is the same as accomplishing the causes and "
"results of buddhahood. "

msgctxt "7806675494d644ef86cc900249776166"
msgid "རྡོ་␣༽༽  གཞན་ འདོད་ ལ་ལ་␣འི་ ལམ་ མངོན་པར་ རྟོགས་པ་ སྐབས་"
msgstr ""
