msgid ""
"དེ་␣འི་ ཕྱིར་ མཐོ་དམན་ ཀུན་ ཏུ་ ཞིང་ ནི་ ཡར༌་␣གདམ་པ་ དང་ ཞིང་ དམན་པ་ "
"དག་པ་␣ར་ སྒྲུབ་པ་ ནི་ ཤིན་ཏུ་ གནད་ ཟབ་པ་ ཡིན་ ནོ །"
msgstr ""
"Therefore, in all fields of high and low, it is a very profound essential "
"point to select the higher field and accomplish the inferior fields as pure."

msgctxt "164085a1e6fc426aa463f45fecd4fffe"
msgid "རྡོ་␣༽༽  འཁོར་བ་ ལ་␣ས་ འདའ་བ་␣ར་ བྱེད་པ་ ལ་"
msgstr "Vajra: [Others] said that to transcend samsara,"

msgctxt "e31ca0e598e44019ad08c8cd4da21f95"
msgid "བདག་ འཛིན་ སྤོང་ དགོས་ ཟེར །"
msgstr "[One] must abandon self-grasping."

msgctxt "b34599a9410941aba5e70fd3767b2bca"
msgid "འདི་␣ར་ ནི་ བདག་ འཛིན་ དེ་ སྤོང་བ་␣འི་ ཆེད་ དུ་ བདག་ ཏུ་ བཟུང་ སྟེ་"
msgstr ""
"In this [system], to abandon this self-grasping, one grasps at a self."

msgctxt "f5566454f0264a49b4d6eae3e9306cd3"
msgid "ཚོགས་ བསགས་ ནི་ ཐབས་མཁས་པ་␣ར་ བཞེད་ དེ་"
msgstr "The accumulation of merit is accepted as a skillful method."

msgctxt "30966299602c44d0b3e78ba4668a8bc2"
msgid "བདག་ ཏུ་ བཟུང་ ནས་ མཆོག་ གསུམ་ ལ་ ཕུལ་བ་␣ས་"
msgstr "By holding to self, one offers to the three jewels."

msgctxt "e76d05e136844b1b9d55ffc2eb484233"
msgid "འབྲས་བུ་ རྒྱ་ཆེན་པོ་ འཕེལ་བ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "Because the result will vastly grow and"

msgctxt "6aaeaa3221b34ffd8d426072567fa8e6"
msgid "བདག་ ཏུ་ བཟུང་བ་␣འི་ དོན་ དེ་ བཏང་ ན་"
msgstr "If [you] let go of the object that holds to self, "

msgctxt "691104ad0ed448a382cdfa62105f786c"
msgid "བདག་མེད་ རྟོགས་པ་␣ར་ འགྱུར་བ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "[You] will realize selflessness and "

msgctxt "eedb80be2daa4130a1a583051c15b7e1"
msgid "སེམས་ཅན་ རྣམས་ བདག་ ཏུ་ བཟུང་ སྟེ་"
msgstr "Sentient beings by holding to self,"

msgctxt "b0fb327344304580856b584060b6baef"
msgid "དེ་ རྣམས་ ཀྱི་ དོན་ དུ་ བཏང་བ་␣ས་"
msgstr "Because of giving up for the sake of these."

msgctxt "7c18c18ed4c04aebbbb45a6e776ef8d5"
msgid "ཞི་བ་ ལ་ མི་ གནས་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "[They] do not abide in peace."

msgctxt "a4776ad0830f4d98bd92754153e56556"
msgid "དེ་ལྟར་ ཡང་ སྤྱོད་འཇུག་ ལ་␣ས །"
msgstr "Likewise, according to the Engaging in the Bodhisattva's Conduct:"

msgctxt "2c55dbd93fa64bf1a1802ce4311e64b5"
msgid "ཡོངས་སུ་ བཟུང་བ་ མེད་པ་ དེ་དག་ ཀུན ། །"
msgstr "All of these, without a holder for the whole."

msgctxt "61706b6823e2449ea43f73b98ed11045"
msgid "བློ་ ཡིས་ བླང་ ནས་ ཐུབ་པ་ སྐྱེས་ ཀྱི་ མཆོག  །"
msgstr "Taking them by the mind, to the Able One, the supreme of beings."

msgctxt "7c87af4e12e743d1875156b515885071"
msgid "སྲས་ དང་ བཅས་པ་ རྣམས་ ལ་ ལེགས་འབུལ་ ན ། །"
msgstr ""
"Together with spiritual sons, when excellent offerings are made to them."

msgctxt "c0c412789c23486fa040e91183cf49fc"
msgid "ཡོན་གནས་ དམ་པ་ ཐུགས་རྗེ་ ཆེ་ རྣམས་ ཀྱིས ། །"
msgstr "The holy objects for offerings, the compassionate ones."

msgctxt "d690a9a4af034dbd86f0cea6f86c6aec"
msgid "བདག་ ལ་ བརྩེར་ དགོངས་ བདག་ གི་ འདི་དག་ བཞེས །"
msgstr "Think of me with love and accept these offerings of mine."

msgctxt "60d18aa5bccf441d9a6ee81d62f65cb6"
msgid "ཞེས་ སོ །"
msgstr "As said"

msgctxt "030cfb44c99c4fea8572ebbc4fe03f19"
msgid "དེ་ལྟར་ ན་ འཁོར་འདས་ ཀྱི་ ཆོས་ ཐམས་ཅད་ སེམས་ ཀྱི་ བསྒྱུར་ ཁ་ ཡིན་པ་␣ས་"
msgstr ""
"Thus, all phenomena of samsara and nirvana are the changing surfaces of the "
"mind."

msgctxt "f853a24509b34faea40b4cd8176d0d9b"
msgid "འཁོར་འདས་ ཀྱི་ བདེ་ལེགས་ དཔལ་འབྱོར་ རྣམས་ བདག་ ཏུ་ བཟུང་ སྟེ་"
msgstr ""
"By holding the happiness, goodness, glory, and riches of samsara and nirvana"
" to be the self,"

msgctxt "da2fba46f29c40acaf7e5fb4c75df571"
msgid "ཚོགས་ བསགས་པ་␣ས་ བདག་ འཛིན་ གཏོང་བ་␣འི་ རྒྱུ་␣ར་ འགྱུར་ ཏེ །"
msgstr ""
"By accumulating merit, this becomes the cause for releasing self-grasping."

msgctxt "c3f495cf588b4ef59bb5b58be59a1952"
msgid ""
"དཔེར་ན །  ཤིང་ ལ་␣ས་ མེ་ བྱུང་ ནས་ ཤིང་ ཉིད་ ཀྱང་ བསྲེག་པ་ བཞིན་ ནོ ། །"
msgstr "For example, fire arises from wood and burns the wood itself."

msgctxt "7f691e2fd93c4e0fa48e96c0f1935aea"
msgid "དེ་སྐད་ དུའང་ །  ས་ར་ ཧ་␣ས །"
msgstr "As it is also said by Saraha:"

msgctxt "712b98f0e0fb4fe9bc6e559ffcb7b8c2"
msgid "སེམས་ ཉིད་ གཅིག་པུ་ ཀུན་ གྱི་ ས་བོན་ ཏེ ། །"
msgstr "Mind itself alone is the seed of everything."

msgctxt "ed373a23fe8542e082ba971ccdaa4e9e"
msgid "གང་ ལ་ ཞེས་ སོགས་ གསུངས་ སོ །"
msgstr "Where, and so forth. As it is said."

msgctxt "e12685b6c85e4580972868eea8deb01a"
msgid "རྡོ་␣༽༽  བསྔོ་ རྒྱུ་␣འི་ དགེ་བ་ རང་ཉིད་ ཀྱིས་ བྱས་ བསགས་ མ་གཏོགས་"
msgstr ""
"Vajra: Except for the virtuous cause of dedication done and accumulated by "
"oneself,"

msgctxt "eed2200b7ef8416988f089570e42c0b5"
msgid "གཞན་ མི་ བསྔོ་བ་ དང༌ །"
msgstr "Not dedicating others and "

msgctxt "5a177303bf5244788bc6e9e5c14377c4"
msgid "ཡང་ འགའ་ཞིག་ ཡོད་པ་␣འི་ དགེ་བ་ ཁམས་ ནི་ བསྔོ་ རྒྱུ་ མེད་ དེ །"
msgstr "Again, some have virtuous elements that cannot be dedicated because"

msgctxt "04ab6a2dd98b4c94b302d2dbb0064552"
msgid "ཡོད་ ཙམ་ མི་རྟག་པ་␣ས་ ཁྱབ་པ་ དང༌ །"
msgstr "Mere existence is necessarily impermanent and "

msgctxt "54411427a52f445e8b9e95b5f7a9b136"
msgid "ཆོས་དབྱིངས་ ལས་མ་ གཏོགས་ ཆོས་ གཞན་ མེད་ ཕྱིར་"
msgstr "Since there is no phenomenon other than the dharmadhatu."

msgctxt "db49127c2963450cae85e3896de55866"
msgid "ཐམས་ཅད་ དགེ་བ་␣ར་ ཐལ་བ་␣ས་ དང༌ །"
msgstr "It absurdly follows that everything is virtuous and "

msgctxt "8a6ca2c641e54f94b01016f43544977f"
msgid "བསྔོ་བ་ ནི་ བསྒྱུར་བ་␣འི་ དོན་ ཡིན་པ་␣ས་"
msgstr "Dedication is the meaning of transformation."

msgctxt "11527d9bc5a54503822ade564a34057b"
msgid "འགྱུར་ ན་ འདུས་བྱས་ སུ་ འགྱུར་བ་␣འི་ ཕྱིར་"
msgstr "If it transforms, it will become a compound."

msgctxt "c9fd5ecd9f2a4e28af8961bc6e5a955b"
msgid "བསྔོ་བ་ བྱར་མེད་ ཟེར་ རོ ། །"
msgstr "It is said that there will be no dedication."

msgctxt "53d172e09d14489dbb99ee6a8c3bb252"
msgid "འདི་␣ར་ ནི་ འཁོར་འདས་ ཀྱི་ དགེ་རྩ་"
msgstr "In this [system], the roots of virtue of samsara and nirvana"

msgctxt "21486c098ecd4383be155bf7ba970405"
msgid "རང་ཉིད་ ཀྱི་ སེམས་ ཀྱི་ དཀྱིལ་འཁོར་ གཅིག་ ཏུ་ བསྡུས་ ཏེ་ བསྔོས་ ན་"
msgstr "When one gathers their mind into a single mandala and dedicates it,"

msgctxt "9c828e492d75413cb902d6f8b1196239"
msgid "དེ་ལྟར་ འབྱུང་བ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "It will happen in that way."

msgctxt "53a4bb419978493da98837d9146bfa22"
msgid "དེ་བཞིན་ཉིད་ ལ་ དབྱེ་བ་ མེད་པ་␣ར་ གསུངས་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "Because it is said that thusness is without division."

msgctxt "1796d9eed3ae43ea91372d971e127871"
msgid "སེམས་བསྐྱེད་པ་ འཁོར་འདས་ ཀྱི་ བདག་པོ་␣ར་ གསུངས་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"The generation of the mind is said to be the master of samsara and nirvana."

msgctxt "b60677bc75b7469281d00c34fc90b63d"
msgid ""
"སེམས་བསྐྱེད་ ནས་ དམ་ཆོས་ མ་ ནུབ་ བར་ གྱི་ དགེ་རྩ་ སེམས་ཅན་ གྱི་ དོན་ "
"ཡིན་པ་␣འི་ ཕྱིར་"
msgstr ""
"After the generation of the mind, the roots of virtue until the decline of "
"the holy Dharma are for the benefit of sentient beings."

msgctxt "8fb8dab337674875a91caf6b785399cd"
msgid "འདས་ ཀྱི་ དགེ་བ་ བསྔོ་ དགོས་པ་ ཡིན་ ནོ ། །"
msgstr "The virtues of the past need to be dedicated."

msgctxt "643e42bb5761497792db9212bd13169e"
msgid "དེ་ལྟར་ ཡང་ མི་ གཡོ་␣འི་ རྒྱུད་ ལ་␣ས །"
msgstr "That as well in the Unwavering Tantra:"

msgctxt "e0306f1380774a5194c5675906565775"
msgid "བཅོམ་ལྡན་འདས་ ཀྱིས་ བསགས་པ་ ཡི ། །"
msgstr "The Blessed One has accumulated"

msgctxt "ea11393b33cf42e886e42ac19558da7a"
msgid "བསོད་ནམས་ གྲངས་མེད་ གཞལ་ མི་ ལང་ ། ། /"
msgstr "Incalculable and immeasurable merits."

msgctxt "5abc58fae9f145a1840ac97ab1ec1e99"
msgid "དེ་␣ས་ ནི་ འགྲོ་བ་ མ་ལུས་པ ། །"
msgstr "These are for every migrator."

msgctxt "cd2c0456d45a493183aae83b05efcb92"
msgid "བླ་མེད་ གོ་འཕང་ ཐོབ་པ་␣ར་ ཤོག  །"
msgstr "May they attain the highest achievement level."

msgctxt "9ed5e60a35c04dbfb59ee34b4540e67b"
msgid "ཅེས་ དང༌ །"
msgstr "And"

msgctxt "a3620f5f63d347a7988dc0966722b7e8"
msgid "ཡུམ་ རྒྱས་པ་␣ར་ ཡང༌་␣འཕགས་ བཞི་␣འི་ དགེ་རྩ་ བསྔོ་བ་␣ར་ གསུངས་ སོ ། །"
msgstr ""
"The dedication of the roots of virtue of the four superior ones is also "
"stated in the Extensive Mother [Prajnaparamita Sutra]."

msgctxt "8bf209efb61b496ba8250a1be1a394c2"
msgid "གཉིས་པ་ ནི་"
msgstr "The second is"

msgctxt "b767533b83854b1dbf38ee196bd29b87"
msgid "ཡོད་པ་ དང་ འདོད་ ཙམ་ མི་རྟག་པ་␣ས་ ཁྱབ་ ན་"
msgstr "If mere existence and acceptance are necessarily impermanent,"

msgctxt "b2fd3b0905054ef4a3abb9313924ecc4"
msgid ""
"སངས་རྒྱས་ ཀྱི་ ཡེ་ཤེས་ དང་ མཐར་ཐུག་ གི་ ཡོན་ཏན་ སྟོབས་ སོགས་ ཀྱང་ དེ་␣ར་ ཐལ་"
" ཡོད་པ་ དང་ འདོད་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"Then it absurdly follows that the wisdom of the Buddha and the ultimate "
"qualities such as the strengths and so forth would also be that because they"
" exist and are accepted."

msgctxt "f42b4c2cafe74121897123271eb072ff"
msgid "ཆོས་དབྱིངས་ ལ་␣ས་ ཆོས་ གཞན་ མེད་ ན །"
msgstr "If there is no phenomenon other than the dharmadhatu."

msgctxt "52438723d3864b14a32bf975444731a1"
msgid "འོ་ན་ ཐམས་ཅད་ ལུང་ མ་ བསྟན་ དུ་ ཅིའི་ཕྱིར་ མི་ འགྱུར་ ཏེ་"
msgstr "Why doesn't everything become unstated [neutral]?"

msgctxt "a8d030b4575341a68819fd3e939be0c2"
msgid "མཚུངས་པ་␣འི་ ཕྱིར་ རོ །"
msgstr "Because they are similar."

msgctxt "0fe3159655b64a469159211a3d6d9f4b"
msgid "དེ་ལྟར་ ན་ དགེ་སྡིག་ གཏན་ མི་ སྲིད་པ་␣ར་ འགྱུར་ རོ །"
msgstr "In that way, virtue and non-virtue would become impossible."

msgctxt "25b232e4d1b648f7a4f1b8de6a4b1ba7"
msgid "ཆོས་དབྱིངས་ བསྔོས་པ་␣ས་ ཐམས་ཅད་ དགེ་བ་␣ར་ འགྱུར་པ་␣ས་"
msgstr "By dedicating the dharmadhatu, everything becomes virtuous."

msgctxt "7ad0ba43f2fc4131b0def8a882b4ca17"
msgid "དམིགས་ མཚན་ འདུ་ བྱས་ སུ་ འགྱུར་ ན །"
msgstr "If the observed sign becomes compounded."

msgctxt "8c9c049122cd46129c6faf2e1ed83996"
msgid "དགེ་བ་␣འི་ ལ་␣ས་ ལ་␣འང་ མཚུངས་པ་␣ས་"
msgstr "Since this is also similar to virtuous actions."

msgctxt "be02e19af7924eff8a11fbd0414ccbc1"
msgid "བསྔོ་བ་ དུག་ མེད་ མི་ སྲིད་པ་␣ར་ འགྱུར་ རོ ། །"
msgstr "It is impossible to have a dedication free of poison."

msgctxt "dc96764993c147c5be1ea053469c7f90"
msgid "དེ་ལྟར་ ན་ བསྔོ་བ་ ནི་ ཀུན་རྫོབ་ ལ་ བརྟེན་ ནས་ བཞག་ དགོས་པ་␣ས་"
msgstr ""
"In that way, dedication must be placed in dependence upon the relative."

msgctxt "f64097b949334caca9df1288c4fc76fa"
msgid "བསོད་ནམས་ བསྔོ་ བྱ་␣ར་ བྱེད་པ་ བཞིན་ མཚན་ ལྟར་ མི་ འགྲོ་␣འོ ། །"
msgstr "The dedication of merit will not go like its characteristics."

msgctxt "26afd30bcb1948b1ad46236a5da94b9f"
msgid "དོན་དམ་པ་␣ར་ ནི་ བསྔོ་བ་ ཉིད་ ཀྱང་ མ་ གྲུབ་ ན་"
msgstr "If the dedication itself is not established on the absolute level,"

msgctxt "33c2eb9a029245b899aa5b85008a58dd"
msgid "ཆོས་དབྱིངས་ བསྔོ་ བྱ་ ཡིན་ མིན་ གྱི་ དཔྱད་པ་ མི་ འཇུག་ གོ  །"
msgstr ""
"Then the analysis of whether the dharmadhatu is or is not the object of "
"dedication does not apply."

msgctxt "f997ca6ab41e42a6bcb681f7c49c21b7"
msgid "དེ་␣འི་ ཕྱིར་ ཆོས་དབྱིངས་ དེ་བཞིན་ཉིད་ བསྔོ་བ་␣ར་ བྱ་བ་ ཡིན་ ཏེ །"
msgstr "Therefore, dharmadhatu thusness is dedicated."

msgctxt "dd3e865c4f17409f907df0acf540bc3d"
msgid "དགེ་བ་ ཐམས་ཅད་ ཆོས་ ཀྱི་ དབྱིངས་ སུ་ རོ་ གཅིག་པ་␣ར་ དམིགས་ ནས་"
msgstr "By observing all the virtues as a single taste in the dharmadhatu."

msgctxt "2b356fc6bfc44d37a5feb2b7c765f61f"
msgid "གནས་ལུགས་ ཆོས་སྐུ་␣ར་ སྨོན་ དགོས་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Thus, one must aspire for dharmakaya as the actuality."

msgctxt "1c2e3427400e4d2e9cf5f505a77d72dc"
msgid "དེ་ལྟར་ ཡང་ །"
msgstr "Likewise,"

msgctxt "62da450174b04913b7a3c5aeb6bc543e"
msgid "རྒྱན་ སྟུག་པོ་␣ར །"
msgstr "The Sutra Densely Arrayed with Ornaments says:"

msgctxt "1aaf0a30fbcb44b6aad21e0eba7d2108"
msgid "བདེ་གཤེགས་ སྙིང་པོ་ ཁམས་ དགེ་བ ། །"
msgstr "The sugatagarbha, the virtuous element"

msgctxt "4f504404ff7844b2b28229d55c82f861"
msgid "ཟག་མེད་ ཡོན་ཏན་ ལྡན་པ་ དེ ། །"
msgstr "Endowed with undefiled qualities,"

msgctxt "4ae2e7ab8b4e41ac909ef24e3cf4c38b"
msgid "བསྔོས་པ་␣ས་ འབྲས་བུ་ སྨིན་པ་␣ར་ འགྱུར །"
msgstr "As it is dedicated, the result will be ripened."

msgctxt "a8e6d53a3bf44bf987a9aef8de7e8d4a"
msgid "ཞེས་ དང །"
msgstr "And."

msgctxt "1da04783dc3f453ca25dcd7a9f5d2c44"
msgid "བདེ་གཤེགས་ སྙིང་པོ་ དགེ་བ་␣འང་ དེ །"
msgstr "The sugatagarbha, the virtue is also."

msgctxt "a8498726897a416997a6dda62298cdc6"
msgid "ཞེས་ དང༌ །"
msgstr "And"

msgctxt "30b474c2482c4742915ecbddc63ed185"
msgid "རྡོ་རྗེ་ རྒྱལ་མཚན་ བསྔོ་བ་␣ར །"
msgstr "The dedication of the vajra victory banner."

msgctxt "88ff5478781540a191c32acbd7991e1a"
msgid "ཁམས་ རྣམས་ ཀུན་ ཀྱང་ ཡོངས་སུ་ བསྡུ་ བྱས་ ཏེ །"
msgstr "Which draws together all the elements."

msgctxt "4eeba4b67c1f49bd8090e12812fb9d21"
msgid "ཞེས་ དང་ །"
msgstr "And"

msgctxt "d9ae499dee01405cb1ef3b7d4ef278e1"
msgid "རྣལ་འབྱོར་ ལ་␣ས་ བྱུང་ དགེ་བ་ བསྔོ ། །"
msgstr "The dedication of virtue that arises from the yoga,"

msgctxt "0bb203bc762945a3b2fc552568ea5eea"
msgid "རང་ གི་ སེམས་ ཀྱང་ བསྔོ་བ་␣ར་ བྱ །"
msgstr "And also dedicate one's own mind."

msgctxt "337c5975631a4ebb91a25ce8ad891c6e"
msgid "ཞེས་ དང༌ །"
msgstr "And"

msgctxt "ce0bc312c16c4318a88aa3a7899ecb18"
msgid "དེ་བཞིན་ཉིད་ ཀྱི་ རང་བཞིན་ ཅི་འདྲ་བ་"
msgstr "Similar to what kind of nature of thusness,"

msgctxt "cf5d04c18d0640bd87e45bdf268391bd"
msgid "དེ་ འདྲ་␣འི་ ལ་␣ས་ རྣམས་ ཀུན་ ཀྱང་ བསྔོ་བ་␣ར་ བྱ །"
msgstr "All such actions must be dedicated."

msgctxt "e50700aa4ce24c8fa667f705a767e1f6"
msgid "ཞེས་ དང་ །"
msgstr "And."

msgctxt "2d53a8a85bc948e0a18a6eb89273691c"
msgid "ཀུན་བཏུས་ ལ་␣ས །"
msgstr "The Compendium says:"

msgctxt "e7256ef9e3124306a54af90caadaeee2"
msgid "དོན་དམ་པ་␣འི་ དགེ་བ་ གང་ཞེ་ན །"
msgstr "If one asks, what is the absolute virtue?"

msgctxt "42f85aabfb1545ad914da7f9fa0a21f9"
msgid "དེ་བཞིན་ཉིད་ དོ །"
msgstr "It is thusness."

msgctxt "bac74f58bf8043d7a202015cca12070c"
msgid "ཅེས་ དང༌ །"
msgstr "And."

msgctxt "7491fdb70c50452cb25138f928b34e48"
msgid ""
"བདག་ སོགས་ བླ་ ན་ མེད་པ་ ཡེ་ཤེས་ ཀྱི་ དགེ་བ་␣འི་ རྩ་བ་ ཞེས་ སོགས་ ལུང་ མཐའ་ "
"ཡས་ སོ་␣༑ །"
msgstr ""
"There are infinite scriptural passages such as the roots of virtue of "
"unsurpassable wisdom of mine and others."

msgctxt "ff85fb76574147de89f946197e3a4579"
msgid "ཡུམ་ ལ་␣ས །"
msgstr "According to the Mother [Prajnaparamita Sutra]:"

msgctxt "6216f616ccd74da790d0f6dfff190b2e"
msgid "གཟུགས་ ནས་ རྣམ་མཁྱེན་ གྱི་ ཆོས་ ཐམས་ཅད་ འགྱུར་མེད་ དུ་ གསུངས་ ཀྱང་"
msgstr ""
"Although all phenomena, from form up to omniscience, are said to be "
"unchanging,"

msgctxt "0727696e09124dbbae54e84671b60937"
msgid "ཀུན་རྫོབ་ འཁྲུལ་པ་␣འི་ དྲི་མ་ སྦྱོང་བ་ ལ་ བལྟོས་པ་␣ས་ མི་ འགལ་ ལོ ། །"
msgstr ""
"This does not contradict the fact that they depend on purifying the stains "
"of the relative."

msgctxt "6f0bba99a3614d4f8a227b794f3fcb11"
msgid ""
"དེ་ལྟར་ ན་ ཡོད་པ་␣འི་ དགེ་བ་ རྒྱ་མཚོ་ དང་ བྱས་ བསགས་ ནི་ དེ་␣འི་ རླབས་ བཞིན་"
" ནོ །"
msgstr ""
"Thus, the ocean of virtue exists like that and the deeds or accumulations "
"are like its waves."

msgctxt "76129bab985a43498ebe8efe255905dc"
msgid "དེས་ན །"
msgstr "Thus,"

msgctxt "3bdcf7a7f83740f8a2f0e5892981022f"
msgid "འཁོར་འདས་ ཀུན་ གྱི་  བསགས་ དང་ ཡོད་པ་␣འི་ དགེ་བ་ བསྔོ་བ་␣ར་ བྱ་␣འོ །"
msgstr ""
"Dedicate the virtues accumulated and possessed from all of samsara and "
"nirvana."

msgctxt "98647449f1814b01af2fdc7cb690aedf"
msgid "རྡོ་␣༽༽  སངས་རྒྱས་ དང་ བླ་མ་ ལ་ བསྔོ་བ་ དགོས་ ཏེ་"
msgstr ""
"Vajra: It is said that one must dedicate to the buddhas and the gurus."

msgctxt "67463d56ca9d4cc9a640cd015f7b3036"
msgid "སྐྱོན་ སྤང་ ཡོན་ཏན་ རྫོགས་པ་␣འི་ ཕྱིར་ ཟེར །"
msgstr "Because [they] have abandoned faults and perfected in good qualities."

msgctxt "3fedd32bf47d49dea2f7738e65e14e32"
msgid "འདི་␣ར་ དེ་དག་ ལ་ ཡང་ བསྔོ་བ་ ནི་ ངེས་པར་ དགོས་ ཏེ་"
msgstr "In this [system], dedication is certainly needed for them because"

msgctxt "dc6b0f0a51a246fc92ebd839c32e4479"
msgid "ཕྲིན་ལས་ རྫོགས་པ་ ལ་ མྱུར་བ་␣འི་ ཕྱིར་"
msgstr "The enlightened activity will be swiftly completed."

msgctxt "7a838f8888e24d42b08dd1663d83a70d"
msgid "དཔེར་ན་ ཕྱུག་པོ་ ལ་ ནོར་ བསྣན་པ་ བཞིན་ ནོ ། །"
msgstr "For example, it is like adding wealth to a rich man."

msgctxt "b1382b7da0c1432591909b0174b1d3bd"
msgid "དེ་ལྟར་ ཡང་ བརྒྱད་ སྟོང་ ལ་␣ས །"
msgstr "Likewise, the Eight Thousand [Verses] says:"

msgctxt "f1f8ffed43ae42e193a88fecb4333d83"
msgid "སངས་རྒྱས་ ཀྱི་ མཛད་འཕྲིན་ ནི་"
msgstr "The activities of the Buddha are "

msgctxt "0b507198a36f4f7d98db9746b11a73ff"
msgid "རྒྱུ་རྐྱེན་ གཅིག་ མིན་པ་"
msgstr "not a single cause and condition."

msgctxt "2324fbec7e6449d0a99ea607e04b080d"
msgid "པི་ཝང་ གི་ སྒྲ་ ལྟར་ གསུངས་པ་ དང་"
msgstr "It is said that it is like the sound of vina and"

msgctxt "246df21b841d44e39d764eaaa5298913"
msgid "དགའ་མོ་ དང་ དགའ་ སྟོབས་ མོས་བ་ སྟོང་ གི་ འོ་མ་␣འི་ ཉིང་ཁུ་ དྲངས་ ནས་"
msgstr ""
"Nanda and Nandabala drew the essence of the milk of a thousand cows and "

msgctxt "f83e0602858e4e93ae26208154e8cbfa"
msgid "བརྟུལ་ཞུགས་ གྲུབ་པ་␣ར་ གྱུར་ཅིག  །"
msgstr "May [we] accomplish the yogic disciplines."

msgctxt "7b496d98ff6e46daa298a8e6792252ab"
msgid "ཅེས་ བསྔོས་པ་␣ས་ ཐོ་རངས་ སངས་རྒྱས་པ་ དང་ །"
msgstr "Because of the dedication, at dawn, [they] attained buddhahood and "

msgctxt "3a8d8b2d51174e5baabcaf929ffb4509"
msgid "ལྷ་ སྦྱིན་ གྱི་ འགྱོགས་ རྡོས་ ཞབས་ ཀྱི་ སྐུ་མཚལ་ ལ་"
msgstr "The shooting stone of Devadatta bleeds the bare feet."

msgctxt "7074851060654e5eafadbb15a26f0f68"
msgid "འོད་སྲུང་ གིས་ བདེན་པ་ བརྗོད་པ་␣ས་ ཆད་པ་ བཞིན་ ནོ ། །"
msgstr "Kashyapa by expressing the truth, the [bleeding] was stopped."

msgctxt "98e7ded33c2d4e05ba24d4596cd41510"
msgid ""
"བླ་མ་␣འང་ སོ་སྐྱེ་␣ས་ དང་ ས་␣ར་ གནས་ གང་ཡིན་ ཀྱང་ གེགས་ སུ་ འགྱུར་བ་␣ས་ "
"བསྔོ་ དགོས་ སོ ། །"
msgstr ""
"Even gurus, whether [they] are individualized beings or abiding on the "
"levels, can become an obstruction, so one must dedicate."

msgctxt "39ddcd9b7593469398eb8984cebc0fcd"
msgid ""
"བྱང་སེམས་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ་␣འི་ ཚིགས་ རྐང་ ཉེར་ ལྔ་ ལྷན་ཐབས་ ཤོ་ལོ་ ཀ་"
" གཅིག་པ་␣འི་ འགྲེལ་བཤད་ ཀྱི་ སྐབས་ ཏེ་ བཞི་པ་␣འོ ། ༈"
msgstr ""
"This concludes the fourth section, a commentary on the twenty-five vajra "
"verses and one verse of addendum, summarizing the essential points of "
"bodhicitta."

msgctxt "c5303fac69ee4f19ac79a9577a2e5544"
msgid ""
"གསང་སྔགས་ ཀྱི་ བསྟན་པ་ ནི་ སྟོན་པ་␣ས་ དུས་ ཞིང་ འདི་ ལ་␣ས་ གཞན་ དུ་ མི་ "
"འབྱུང་ ཟེར་ མོད་ ཀྱང །"
msgstr ""
"Although it is said that the secret mantra teachings would not appear "
"elsewhere than this world by Buddha."

msgctxt "a769da0382dd4e3bb9a214a4f2023c94"
msgid "འདི་␣ར་ ནི་ སྟོན་པ་ དང་ བསྟན་པ་ གཞན་ ལ་␣འང་ སྔགས་ འབྱུང་ སྟེ་"
msgstr ""
"In this [system], the mantra also occurs during other buddhas and teachings."

msgctxt "f6f7561c523b44f7bb713a9cc732a83c"
msgid "རང་ཉིད་ སངས་རྒྱས་པ་ ལ་ སྤང་བྱ་ ཕྲ་ རག་ ཐམས་ཅད་ སྤངས་ ཏེ་"
msgstr ""
"To become a buddha, one has to abandon all the gross and subtle objects of "
"abandonment."

msgctxt "4e85328c803749d7ab4b9763446c03d8"
msgid "གདུལ་བྱ་ གཞན་ ལ་␣འང་ དེ་ སྟོན་ དགོས་ ཤིང་"
msgstr "Also, this must be taught to other disciples."

msgctxt "a06c444d16f84961abb2453dd5069793"
msgid "སྔགས་ མེད་ ན་ ཕྲ་བ་ སྤོང་ བྱེད་ ཀྱི་ གཉེན་པོ་ མེད་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Because without mantra there is no antidote to abandon the subtle."

msgctxt "dc9e1900837b4f9091e998d2c0ce08f5"
msgid "དེ་ལྟར་ ཡང་ རྣམ་སྣང་ མངོན་བྱང་ ལ་␣ས །"
msgstr ""
"Likewise, The Manifest Complete Enlightenment of Vairocana Tantra says:"

msgctxt "a49e364a6195453884f8cd584f5cc402"
msgid "རྫོགས་པ་␣འི་ སངས་རྒྱས་ གང་ འདས་ དང༌ ། །"
msgstr "The perfect buddhas who have gone beyond,"

msgctxt "28958205ddc243c581e2966b04309931"
msgid "དེ་བཞིན་ གང་དག་ མ་ བྱོན་པ ། །"
msgstr "And those who have not yet come."

msgctxt "cda418656c8a4203971f7ac59359d5d0"
msgid "ད་ལྟར་ བྱུང་བ་␣འི་ མགོན་པོ་ རྣམས ། །"
msgstr "All the lords of the present,"

msgctxt "1bde8a80f04640f0a12044f2f3069481"
msgid "འགྲོ་ ལ་ ཕན་ ཕྱིར་ བཞུགས་པ་ དག  །"
msgstr "Those who dwell for the benefit of beings."

msgctxt "2eab5d89db3c4c0999ccaf0b411b7513"
msgid "ཆོ་ག་ བཟང་པོ་ འདི་ མཁྱེན་ ནས ། །"
msgstr "By knowing this excellent ritual,"

msgctxt "e3f5a0f5150c40c5b95ad26bba9b9cd1"
msgid "ཐམས་ཅད་ མཁྱེན་པ་ ཚད་ མེད་ བརྙེས །"
msgstr "Will achieve immeasurable omniscience."

msgctxt "aba7e44bdd89482ca39e52cb9f19d741"
msgid "ཞེས་ དང༌ །"
msgstr "And."

msgctxt "374390284ad84de1a15577424e58de51"
msgid "འདས་པ་␣འི་ སངས་རྒྱས་ ཞེས་ སོགས་ སོ ། །"
msgstr "The buddhas of the past and so forth. "

msgctxt "bdbc4c2d08ae42388dbfcd84a65271c6"
msgid "དེས་ན་ སྔགས་ འབྱུང་བ་ གཞན་ ལ་␣འང་ ཡོད་ དོ །"
msgstr "Therefore, the mantra occurs in others as well."

msgctxt "1af2d2826b854d3fbb0666b65e7a6a93"
msgid "ལྷན་␣༽༽  སྔགས་ ནི་ སྡེ་སྣོད་ བཞི་པ་ ཡིན་ ཏེ་"
msgstr "Addendum: Mantra is the fourth pitaka."

msgctxt "1e238009bacb4258b16e5ca878b28fa0"
msgid "ལེགས་ གྲུབ་ ལ་␣ས །"
msgstr "According to the Excellent Accomplishment:"

msgctxt "92b7b1445c5a4d06a2eac53c7f8b480f"
msgid "བཞི་པ་ རིག་འཛིན་ སྡེ་སྣོད་ དག་ ལ་␣ས་ ཤེས་ ཞེས་ སོ ། །"
msgstr "The fourth is known from the Pidyadhara Pitaka."

msgctxt "50656f0e31424cf6b172f12aee3d1039"
msgid "ཡང་ན་ ང་ སེམས་ འདུལ་བ་␣ས་ འདུལ་བ་ ཡིན་ ཅེས་ དང་ །"
msgstr "Or because it tames my mind, thus it is Vinaya."

msgctxt "8ac4273256fd4d439d98bf8be834c393"
msgid "ཡང་ན་ མདོ་སྡེ་ ཡིན་ ཏེ་ དཔུང་ བཟང་ ལ་␣ས །"
msgstr ""
"Or it is the sutra section because The Tantra of Subahu’s Questions says:"

msgctxt "04f49ef9211f445f98ba8d76b26159ac"
msgid "གསང་སྔགས་ མདོ་སྡེ་␣འི་ ཚུལ་ དུ་ ནི །"
msgstr "In the way of the secret mantra system"

msgctxt "a71eb9a9548847e4bba38af4f5c4cd88"
msgid "ཡང་དག་ ངས་ བཤད་  དྭངས་ བས་ ཉོན ། །"
msgstr "I will explain genuinely, and listen clearly."

msgctxt "e1cf4f2358b14aa49e4570d885ae1be9"
msgid "ཅེས་ སོ །"
msgstr "As said."

msgctxt "39fdbbdb09bc4eec9edfbf421b5b7224"
msgid "ཡང་ ཆོས་སྤྱོད་ མངོན་རྟོགས་ རྒྱུད་ ལ་␣ས །"
msgstr ""
"Also, according to the Tantra of Manifest Realization of Dharma Activity:"

msgctxt "b243de81ac0543c283438952b9db7fe4"
msgid ""
"མངོན་པ་ ཕྱི་ ནང་ གཉིས་ གསུངས་པ་␣ས་ སྔགས་ ནང༌་␣གི་ མངོན་པ་ ཡིན་ ཅེས་པ་ སྟེ །"
msgstr ""
"Abhidharma is taught as twofold: outer and inner. Mantra is the inner "
"abhidharma."

msgctxt "981e9f9e72254fc89d358b73bda2bfd9"
msgid "དེ་ལྟར་ སོ་སོ་␣ས་ འདོད་པ་ རེ་ བཤད་ ཀྱང་"
msgstr "In this way, each person explains their acceptance but"

msgctxt "e556ce91fcb540b5b4875e55085cadd4"
msgid "གཙོ་ ཆེ་␣ར་ མདོ་སྡེ་␣ར་ བསྡུ་བ་ འདི་ ཕལ་ གྱིས་ བཞེད་པ་␣ར་ སྣང་ངོ་ །"
msgstr ""
"It seems that most accept that it is mainly included in the sutra section."

msgctxt "639b4798a333474583a71e0c7e77a4ff"
msgid ""
"འདི་␣ར་ ནི་ སྡེ་སྣོད་ གསུམ་ མམ་ དེ་ གསུམ་ ཁ་ ཡི་ སྙིང་པོ་ ལྟ་བུ་ སྔགས་ ཡིན་ "
"ཏེ །"
msgstr ""
"In this [system], Mantra is the essence of the three pitakas or all of these"
" three."

msgctxt "4cc07e0598554186862e786ab0834923"
msgid "གང་ཟག་ གཅིག་ འཚང་རྒྱ་བ་␣ར་ སྤང་བྱ་ བསྡུ་ ན་"
msgstr ""
"If the objects of abandonment for a single person to become a buddha are "
"drawn together,"

msgctxt "be35453c32664f29bd4cd872ef6c4b58"
msgid ""
"དུག་ གསུམ་ སྤོང་ བྱེད་ སྡེ་སྣོད་ གསུམ་ གྱི་ དོན་ བསླབ་པ་ གསུམ་ ཡིན་པ་␣ས་"
msgstr ""
"The three trainings are the meaning of the three pitakas that abandon the "
"three poisons."

msgctxt "c94378852d1342918cb927043dc4a597"
msgid "བསྐྱེད་རྫོགས་ ཟུང་འཇུག་ གིས་ སྤང་བྱ་ དྲུང་ ནས་ ཕྱུང་ སྟེ་"
msgstr ""
"The union of generation and completion will remove the objects of "
"abandonment from their roots."

msgctxt "b2d6b7c4ad46415c84b6e5f95e99b0d1"
msgid ""
"ཐབས་ཤེས་ གཉིས་ སུ་ མེད་པ་ ཟུང་འཇུག་ བདེ་བ་ ཆེན་པོ་␣འི་ སྐུར་ སངས་ རྒྱ་བ་␣འི་"
" ཕྱིར་ རོ ། །"
msgstr ""
"This is because the non-duality of method and wisdom enlightens the union of"
" the great bliss body."

msgctxt "31ce8d059d9341c3a7bb1ef2a4ff6191"
msgid "ལུང་ ཡང་ གསུམ་ ཀར་ ཡོད་པ་␣ས་"
msgstr "There are scriptural passages for all three,"

msgctxt "fc2fda60729146a1a060e7525efab3cb"
msgid "འདི་ལྟར་ བྱས་ ན་ མི་ འགལ་ ཞིང་ ཆེས་ འཐད་པ་ ཡིན་ ནོ །"
msgstr ""
"If one does this, there is no contradiction, and it is very logically "
"admissible."

msgctxt "b6b59904e3764560be6a673f12f1ea08"
msgid "རྡོ་␣༽༽  སྔགས་ ལ་ གཞི་ སྒོ་གསུམ་ རྡོ་རྗེ་ གསུམ་ གདོད་མ་ ནས་ གནས་པ །"
msgstr ""
"Vajra: There are the three doors of the ground, the three vajras in mantra, "
"which have existed primarily."

msgctxt "18e0710e9cc04b1aa5f982ba7e7b2f1b"
msgid "ལམ་ སྨིན་གྲོལ་ གཉིས །"
msgstr "The two paths of ripening and liberating."

msgctxt "675f79e32797407d919db1e6c87dadab"
msgid "འབྲས་བུ་ སྐུ་བཞི་ སྟེ་ གསུམ་ ལ་␣ས །"
msgstr "The result is the four or three bodies."

msgctxt "d07f30f2083243cf93ac8c49d083a2e5"
msgid "འཇམ་དཔལ་ རྩ་རྒྱུད་ ལ་␣ས །"
msgstr "According to The Manjushri Root Tantra:"

msgctxt "8d1621cd78054f369b08a0013d5ae688"
msgid "གང་ཞིག་ དཀྱིལ་འཁོར་ མ་ མཐོང་བ །"
msgstr "One who has not seen the mandala."

msgctxt "43212e73e63d4245a09f85a753ee732c"
msgid "རྣལ་འབྱོར་པ་ ནི་␣x"
msgstr "A yogin is ....X"

msgctxt "864f3ec19c2d4c8f867f46cd68fc0536"
msgid "མཁའ་ ལ་ ཁུ་ཚུར་ གྱིས་␣x"
msgstr "Fist against space ...X"

msgctxt "47c577e49c304c7fa3b83ed4ee51fde1"
msgid "སྨིག་རྒྱུ་␣འི་ ཆུ་ ནི་␣x"
msgstr "Mirage water is ....X"

msgctxt "2ad0ae4866fa47bcaab941d97a32a9da"
msgid "ཅེས་པ་␣ས་ དབང་ བསྐུར་ སྔོན་ དུ་ དགོས །"
msgstr "Thus, the empowerment must [go] first."

msgctxt "04c462f864dc46e49e4de5e887d5a964"
msgid "དེ་␣འང་ གང་ གིས་ བསྐུར་བ་ རྡོ་རྗེ་ སློབ་དཔོན་ རབ་ འབྲིང་ ཐ་ གསུམ །"
msgstr ""
"The one who bestows the empowerment is the vajra master, who may be of the "
"high, medium, or low capacity,"

msgctxt "3ca05b44e6f444369d52f7d4aa22ee00"
msgid ""
"གང་ ལ་ བསྐུར་བ་ རྟེན་ གྱི་ གང་ཟག་ སྐྱབས་འགྲོ་ སོགས་ ཀྱིས་ རྒྱུད་ དག་པ །"
msgstr ""
"Those to whom the empowerment is bestowed must have a pure mindstream, by "
"taking refuge and so forth."

msgctxt "3242593db70147309684619cfcaba053"
msgid "ཇི་ལྟར་ བསྐུར་བ་␣འི་ ཆོ་ག་ རྒྱུད་ ནས་ གསུངས་པ་ ལྟར་ སྦྱོར་བ་ སྟ་གོན །"
msgstr ""
"The preparatory liturgy is as said in the tantras for the ritual of "
"bestowing empowerment."

msgctxt "8e742f1e74f44efe851f540a87fd50ca"
msgid ""
"དངོས་གཞི་ བུམ་ གསང་ ཤེར་ ཚིག་དབང་ བཞི་␣འི་ ཆོ་ག་ ཚུལ་བཞིན་ བྱས་པ་␣ས་ ཐོབ་པ་ "
"ཡིན་ ཟེར །"
msgstr ""
"It is said that one will receive it by properly performing the main part of "
"the rituals of the four empowerments such as the vase, secret, primordial "
"wisdom, and word [empowerment]."

msgctxt "8051777e619f4d478392c63f0fcaff45"
msgid "འདི་␣ར་ ནི་ སློབ་དཔོན་ མཚན་ཉིད་ དང་ ལྡན་པ་␣ས་"
msgstr "In this system, by a qualified master,"

msgctxt "ffc00f210b01470e84d3df6b6fe2a5cd"
msgid "སློབ་མ་ མོས་གུས་ དང་ ལྡན་པ་␣ར་"
msgstr "To devoted disciples"

msgctxt "4e2d0d67c51a4e718ea1e35e98d1c3be"
msgid "གདམས་ངག་ རྗེས་ བསྟན་ གྱི་ རྟེན་འབྲེལ་ ལ་␣ས་"
msgstr ""
"Through the interdependence of the instructions and further teachings,"

msgctxt "9273a5e62e8b413db03290eb6796b588"
msgid "སྒོ་གསུམ་ ཐ་དད་ དུ་ འཛིན་པ་␣འི་ དྲི་མ་ དག་ ནས་"
msgstr "The stains of grasping the three doors as distinct are purified,"

msgctxt "36acdcddf7fb44deb395bdff66f504c9"
msgid "རྡོ་རྗེ་ གསུམ་ དུ་ ངོ་ སྤྲད་པ་␣ས་"
msgstr "By introducing the three vajras,"

msgctxt "880becc810c441af8348c90ad67dbfec"
msgid "ངེས་ཤེས་ རྟོགས་པ་ སྐྱེས་པ་␣ར་ དོན་ གྱི་ དབང་ ཐོབ་པ་ ཞེས་ བྱ །"
msgstr ""
"When the realization of certainty arises, this is known as obtaining the "
"actual empowerment."

msgctxt "cd87b11bcfad443bbaceb00198967ae0"
msgid "དེ་ཡང་ ཕུང་ ཁམས་ སྐྱེ་མཆེད་ དཀྱིལ་འཁོར་ གྱི་ འཁོར་ལོ་␣ར་"
msgstr ""
"Furthermore, the aggregates, elements, and sense fields are in the mandala's"
" wheel."

msgctxt "0fe0362911fe4a279fbd61eaffcb800d"
msgid "ངེས་ཤེས་ ལྷན་ཅིག་ གིས་ སྐྱེས་པ་ བུམ་ དབང །"
msgstr "The arising of certainty together is the vase empowerment."

msgctxt "0427050b292f4d3f8335be671df5e7c7"
msgid "གསལ་སྟོང་ གི་ ཏིང་འཛིན་ སྐྱེས་པ་␣ར་ གསང་དབང་ །"
msgstr ""
"The secret empowerment is for the arising of the concentration of clarity-"
"emptiness."

msgctxt "d9eec6bd325541a6b99146728e270f20"
msgid "བདེ་སྟོང་ གི་ ཤེས་རབ་ ཡེ་ཤེས་ ཀྱི་ དབང་ །"
msgstr ""
"The wisdom of bliss and emptiness is the primordial wisdom empowerment."

msgctxt "b8243e8aec3b420894775b5ac8201ab0"
msgid "སེམས་ཉིད་ སྐྱེ་ མེད་ དུ་ རྟོགས་པ་ ཚིག་དབང་ སྟེ །"
msgstr ""
"The realization that the mind itself is non-arising is the word empowerment."

msgctxt "2e9972b4110c4bb6b13ba3035b2830df"
msgid ""
"དེ་ལྟ་ བུ་␣འི་ དབང་ གི་ དོན་ རང་རྒྱུད་ ལ་ ངེས་ཤེས་ སྐྱེས་ ན་ དབང་ ཐོབ་པ་␣ར་ "
"བཞེད་ དོ །"
msgstr ""
"When the meaning of empowerment arises in one's mindstream with such "
"certainty, it is accepted that one has obtained empowerment."

msgctxt "acf37586c3a642ecb441b87045242493"
msgid ""
"ལྷན་␣༽༽  གང་ཟག་ རབ་ འབྲིང་ ཐ་ གསུམ་ ལ་ རིམ་བཞིན་ དབང་མ་ བསྐུར་ ཡང་ ཐོབ་པ་ "
"དང༌ །"
msgstr ""
"Addendum: The three types of persons: higher, middling, and lower "
"respectively, obtain empowerment even without bestowing and"

msgctxt "8f65b18d4b604ea6ac7085084c9d59f9"
msgid "བསྐུར་ ན་ ཐོབ་པ །"
msgstr "obtain empowerment by bestowing,"

msgctxt "27ed11c203ba4fc7ac16fa1c85e55c1f"
msgid "བསྐུར་ ཡང་ མི་ ཐོབ་པ་ དང་ གསུམ་ ལ་␣ས །"
msgstr "and not obtaining even by bestowing. From these three"

msgctxt "f0ef51a352ee490294b0a5eab7b00f63"
msgid "དབང་ རབ་ དང་པོ །"
msgstr "The first is the best empowerment."

msgctxt "aa9f8b708a904f96ab2b023759b4598c"
msgid "དེ་ལྟ་ བུ་ ནི་ བླ་མ་␣ར་ མོས་གུས་ ཀྱིས་ སྒོ་གསུམ་ གྱི་ དྲི་མ་ དག་པ་␣ས་"
msgstr ""
"It is said that such a person, through devotion to the guru, purifies the "
"stains of the three doors and"

msgctxt "ed73a79ca9ee4087a34fe505601c2b24"
msgid "མ་ བསྐུར་ ཡང་ ཐོབ་པ་ ཡིན་ ཟེར་ རོ །"
msgstr "obtains empowerment even without bestowing."

msgctxt "ed3a33387ddc40639ca3c7f4b7dd99f8"
msgid "འདི་␣ར་ ནི་ དབང་ རབ་ དེ་ལྟར་ རྟོགས་པ་ ཡོད་ ཀྱང་"
msgstr ""
"In this [system], although those of the best faculties may have such "
"realization,"

msgctxt "a3c301daef354afb98c4b6131f989828"
msgid "རྒྱུད་པ་␣འི་ ཆོ་ག་ ཟབ་ ཕྱིར་"
msgstr "Because the tantra’s ritual is profound,"

msgctxt "099e953fd0084672b856677080337a21"
msgid "དེ་␣འི་ ཆོ་ག་ ནི་ ངེས་པར་ དགོས་་ ཏེ་"
msgstr "its ritual is certainly necessary. "

msgctxt "e198a06ac6be4db99ee474dc2defd3a7"
msgid "དབང་ རབ་ ཡིན་ཡང་ མ་ སྨིན་པ་ ཡིན་པ་␣ས་"
msgstr "Even if [they] are of the best faculties, [they] are immature, "

msgctxt "067a55a4c28747bea7d3f0959db5aee0"
msgid ""
"དཔོན་སློབ་ གཉིས་ཀ་␣ར་ གསང་ སྒྲོགས་ ཀྱི་ རྩ་ལྟུང་ ཕོག་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr ""
"So both master and disciple incur the root downfall of proclaiming the "
"secret, "

msgctxt "cb57ec6d898d480c992e084e2178d1e6"
msgid "ལོང་བ་␣ས་ ལོང་བ་ ཁྲིད་པ་ ལྟར་"
msgstr "Like leading a blind person by a blind person."

msgctxt "dfbfab30e5cc45369ad28ff48eabdc52"
msgid "གཞན་དོན་ དུ་ དབང་ བསྐུར་བ་␣འི་ བཀའ་ མེད་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr ""
"because there is no instruction for bestowing empowerment for the benefit of"
" others and "

msgctxt "31a23aac942f4ff4bc57cee72dfe34b8"
msgid "ཆོ་ག་ སངས་རྒྱས་ ཀྱི་ ཡེ་ཤེས་ ཡིན་ ཅིང་"
msgstr "The ritual is the primordial wisdom of buddhas."

msgctxt "2c962128a2884caf81a201c38369a9ec"
msgid ""
"དེ་ བྱས་ ན་ དེ་␣འི་ རྒྱུད་ ལ་ ནུས་པ་␣འི་ ས་བོན་ འཇོག་པ་ ཡིན་པ་␣འི་ ཕྱིར་ རོ "
"། །"
msgstr ""
"When it is performed, the seed of potency is planted in the mindstream."

msgctxt "33b2c41169174c93a74346c522e5221e"
msgid "དབང་པོ་ ཐ་མ་␣ར་ ཡང་ བསྐུར་ དགོས་ ཏེ་"
msgstr "Even those of the least faculties are required to be bestowed because"

msgctxt "fae5dfaad0af45ad85b776da49e6752f"
msgid ""
"བག་ཆགས་ ཀྱི་ རྒྱུས་ ནམ་ཞིག་ ན་ འབྲས་བུ་ འདོར་བ་ མི་ སྲིད་པ་␣འི་ ཕྱིར་ རོ ། །"
msgstr ""
"This is because it is impossible for a cause of latent tendency to ever "
"discard its result."

msgctxt "c962e6508fc74f9187708e6645d43205"
msgid "གཞི་ འམ་ ལུས་ ལྟ་བུ་ བུམ་ དབང་ རེ་ ལ་མ་ བརྟེན་ ཐབས་མེད་ ཡིན་ ནོ ། །"
msgstr ""
"Therefore, there is no choice but to rely on each of the vase empowerment, "
"like a base or body."

msgctxt "8d9ebd0f8a1a4e86957c716354c81e60"
msgid "རྡོ་␣༽༽  དབང་ བཞི་ ལ་␣ས་"
msgstr "Vajra: From the four empowerments,"

msgctxt "726a6878edb14424a49e61f619e12cc8"
msgid ""
"བུམ་ དབང་ རྡུལ་ མཚོན་ གྱི་ དཀྱིལ་འཁོར་ རྒྱས་པ་␣འི་ རྟེན་ ལ་ བརྟེན་པ་ "
"སངས་རྒྱས་ དང་ བྱང་སེམས་ ཀྱི་ གདན །"
msgstr ""
"The vase empowerment is based on the support of the extensive mandala of "
"particles and symbols and is supported by the seats of the Buddha and the "
"Bodhisattvas,"

msgctxt "7ed2fd142a8642eda19acb59c9bb9329"
msgid "རིག་མ་ དང་ ལྷ་མོ་␣འི་ གདན །"
msgstr "the seats of the consort and the goddess,"

msgctxt "8302a747ea83405ab3677314db404de2"
msgid "ཁྲོ་བོ་ དང་ ཁྲོ་མོ་␣འི་ གདན་ ཏེ་"
msgstr "and the seats of the male and female wrathful ones."

msgctxt "38c264935c4441a1ababb56bcc7b0a99"
msgid ""
"དེ་ གསུམ་ མ་ཚང་བ་ རྡོ་རྗེ་ རྣལ་འབྱོར་ མ་ ལྟ་བུ་␣ས་ ནི་ མི་ ཐོབ་ ཅེས་ ཟེར་ རོ"
" ། །"
msgstr ""
"It is said that if these three are not complete, then the level such as "
"Vajrayogini, will not attain."

msgctxt "9c9a387ad0964ba29ba9c163cb24de75"
msgid "འདི་␣ར་ ནི་ སངས་རྒྱས་ རྣམས་ ཤིན་ཏུ་ ཕྲ་བ་␣འི་ བག་ཆགས་ སྤངས་ ཏེ་"
msgstr ""
"In this [system], Because the Buddhas have abandoned the most subtle latent "
"tendencies"

msgctxt "aaae937f1bbf4489bd4c51249165dd3e"
msgid "དཀྱིལ་འཁོར་ གྱི་ འཁོར་ལོ་ གཅིག་ ཏུ་ སངས་རྒྱས་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "and have become Buddhas in a single mandala wheel."

msgctxt "354db05cfecf4250bc4ef9d8538f9cab"
msgid "གདན་ ཅེས་པ་ རྟེན་ སྒྱུ་མ་␣འི་ ལུས་ ལ་"
msgstr "The seat refers to the illusory body that is the support,"

msgctxt "5df5074951d44e0a9c71b992a27c4d10"
msgid "རང་རིག་ བྱང་ཆུབ་ ཀྱི་ སེམས་ བརྟེན་པ་␣འི་ ཚུལ་ དུ་ གནས་ ཤིང་"
msgstr ""
"in which the self-knowing bodhicitta abides as a way of being supported."

msgctxt "414b6071a34445e08628df49f5eab8d4"
msgid "དེ་␣འང་ བདག་ གི་ ཕུང་ ལྔ་ སངས་རྒྱས་ ལྔ་ ཚོགས་ བརྒྱད་"
msgstr ""
"Furthermore, the five aggregates of self, the five buddhas, the eight "
"assemblies and "

msgctxt "846e083b20d444e28ee01a9182aa5988"
msgid "སེམས་དཔའ་ བརྒྱད་ ནི་ སངས་རྒྱས་ བྱང་སེམས་ ཀྱི་ གདན །"
msgstr "the eight sattvas are the seats of buddhas and bodhisattvas."

msgctxt "07adf61c4c07449ba06ad91b7184f187"
msgid "འབྱུང་ ལྔ་ ཡུམ་ ལྔ་ ཡུལ་ བརྒྱད་ སེམས་མ་ བརྒྱད་ ནི་"
msgstr ""
"The five elements, five mothers, eight objects, and eight female "
"bodhisattvas are "

msgctxt "6b9fff07aeb348b2b8a6beddc096cf03"
msgid "རིག་མ་ དང་ ལྷ་མོ་␣འི་ གདན །"
msgstr "The seats of consorts and goddesses."

msgctxt "8340e3e029bd4eeea261a0348814643d"
msgid "ཚིག་ ཆེན་ བཅུ་ ཁྲོ་ བཅུ་ ཡུལ་ བཅུ་ ཁྲོ་མོ་ བཅུ་ ནི་"
msgstr ""
"The ten great words, ten wrathful ones, ten objects, and ten wrathful "
"females are "

msgctxt "aeeae2a2fcf5447998e1c5071ae47669"
msgid "ཁྲོ་བོ་ ཁྲོ་མོ་␣འི་ གདན་ ཡིན་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "the seats of wrathful male and female ones."

msgctxt "9f8d2aa6f2b24e90aa3f6b5ad9cc8c79"
msgid "རྣལ་འབྱོར་ མ་ ལྷ་ གཅིག་"
msgstr "Whether a single deity yogini or"

msgctxt "db16e860aee745f882079866757e7471"
msgid "ལྷ་ ལྔ་ གང་ཡིན་ ཡང་"
msgstr "or five-deity [yogini], "

msgctxt "78066b27a4314afe9ea682e78f400869"
msgid "ཕུང་ ཁམས་ སྐྱེ་མཆེད་ སངས་རྒྱས་ སུ་ ངོ་འཕྲོད་ ན་"
msgstr ""
"If the aggregates, elements, and sense fields are recognized as buddhas,"

msgctxt "8dadb65bd17b411e9ef4283864eecc85"
msgid "བུམ་ དབང་ ཐོབ་ ཅིང་"
msgstr "The vase empowerment is obtained."

msgctxt "d3702712ad0e4846b55b48923495910b"
msgid "དེ་ ལ་ བརྟེན་ ནས་ དབང་ གསུམ་པོ་ ཡང་ ཐོབ་པ་␣ར་ འགྱུར་ ཞིང་"
msgstr "In dependence on that the three empowerments are also obtained."

msgctxt "d421d811d9b343a1b89cce05314c144e"
msgid "རིགས་བརྒྱ་ རིགས་ ལྔ་ རིགས་གསུམ་ སོགས་"
msgstr ""
"This is because one hundred families, five families, three families, and so "
"forth "

msgctxt "feae34966d404160a7ae25d7cfbadf18"
msgid "རིགས་ གཅིག་ ཏུ་ འདུ་བ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "are included within one family."

msgctxt "c269f94e2f1c486590df5d0430436d07"
msgid "དོན་ གྱིས་ དེ་ལྟར་ ཚང་ ཡང་"
msgstr "If one says, \"Although they are all complete like this in actuality, "

msgctxt "189cc94361e04c75bdb59557471a4c8a"
msgid "དངོས་ སུ་ མ་ཚང་ བས་ མི་ ཐོབ་ ཅེ་ན །"
msgstr "but they are not complete directly, so they are not obtained. ”"

msgctxt "1b307932673a4030ac43492c35136140"
msgid "དེ་ལྟར་ ན་ འཇམ་རྡོར་ མ་གཏོགས་"
msgstr "In that way, except for Manjuvajra,"

msgctxt "80269387354b4aaa8f1cb7734d0c6894"
msgid "དུས་  གསང་ བདེ་ དགྱེས་ གང་ གིས་ ཀྱང་ མི་ ཐོབ་ སྟེ་"
msgstr ""
"None of Chakrasamvara, Hevajra, or anybody else has obtained the secret of "
"time."

msgctxt "8c6ac825e8554b9e916d2b486f9e25df"
msgid "དངོས་ སུ་ མི་ཚང་བ་␣འི་ ཕྱིར་ རོ ། །"
msgstr "Because they are not complete directly."

msgctxt "71bea48525eb434e9692cb395721ff00"
msgid "དེ་བས་ན་"
msgstr "Therefore,"

msgctxt "2cb33e2c509646dcba0618e1b72b322b"
msgid "ལྷ་␣འི་ གྲངས་ ནི་ ཕྱོགས་ འདོག་ ཚང་བ་␣འམ་"
msgstr "The number of deities is complete in a group,"

msgctxt "0fa7fbea25d84e3f8c9a9555714a3726"
msgid "རིགས་ གཅིག་པ་␣ས་ ཀྱང་ དབང་ བསྐུར་ ཐོབ་པ་␣ར་ འགྲོ་བ་ ཡིན་ ནོ །"
msgstr ""
"and even if they are from the same family, they will obtain empowerment."

msgctxt "20206f58e4ad47ac99e2fa4225b9ed6f"
msgid ""
"ལྷན་␣༽༽  སྐུ་གསུམ་ མཛད་པ་ གསུམ་ དུ་ ངེས་པ་␣ས་ བསམ་ གྱིས་ མི་ ཁྱབ་པ་␣ར་ འདོད་"
" མོད །"
msgstr ""
"Addendum: Because the three bodies are definite to the three enlightened "
"activities, it is accepted that they are inconceivable."

msgctxt "23858e46dce3481397a1e0e418d3ff96"
msgid "འདི་␣ར་ ནི་ ལྷ་ གཅིག་ གིས་་  ཀྱང་ ཕྲིན་ལས་ ཐམས་ཅད་ འགྲུབ་པ་ ཡིན་ ཏེ་"
msgstr ""
"In this [system], even a single deity can accomplish all the enlightened "
"activities."

msgctxt "6589d0d956e4453399a90b0f016ac625"
msgid ""
"ངོ་བོ་ གཅིག་ ཅིང་ ཕྲིན་ལས་ རྣམས་ ཀྱང་ རྒྱུན་ མི་འཆད་པ་␣ར་ འདུ་བ་␣འི་ ཕྱིར །"
msgstr ""
"Because their essence is one, and the enlightened activities are "
"uninterruptedly collected."

msgctxt "41cf177bfbc841c2b83ee76671499979"
msgid "བརྟགས་ གཉིས་ ལ་␣ས །"
msgstr "From the two analyses,"

msgctxt "ef1040befc524049b05fae46a9a7043d"
msgid "སེམས་ ནི་ ཆེན་པོ་ གཅིག་ཉིད་ ལ་␣ས ། །"
msgstr "From the one great mind"

msgctxt "ae5dfd568b234582a4b1c60d2a2121e2"
msgid "ལྔ་ ཡི་ གཟུགས་ ཀྱི་ རྣམ་པ་␣ར་ མཚོན ། །"
msgstr "Is represented by the five aspects of form."

msgctxt "5058b78e00534e24a8e1d5dbd7dc6fe8"
msgid "རིགས་ ནི་ ལྔ་པོ་ དེ་ཉིད་ ལ་␣ས ། །"
msgstr "From those five families,"

msgctxt "b5a3c26ea66d41bf885c965a33eb634a"
msgid "སྟོང་ཕྲག་ དུ་མ་ སྐྱེ་བ་ ཉིད །"
msgstr "Many thousands will arise."

msgctxt "069134f5913745fab5ed5fc3f5c7c697"
msgid "དེ་ཕྱིར་ འདི་དག་ རང་བཞིན་ གཅིག  །"
msgstr "Therefore, their nature is one."

msgctxt "9c283a70ea44427788c46c6f0685fdaa"
msgid "ཅེས་ སོ །"
msgstr "As said."

msgctxt "8608856435474435ab37e4027955d354"
msgid "ཐུགས་ ཀྱི་ རིགས་ གཅིག་ ལ་␣འང་ །"
msgstr "Even in a single kind of mind,"

msgctxt "0884c449b9444976a441f9298daa5dbe"
msgid "སྐུ་གསུང་ཐུགས་ ཡོན་ ཕྲིན་ལས་ ལྔ་ ཚང་བ་␣འི་ ཕྱིར །"
msgstr ""
"The five qualities and enlightened activities of body, speech, and mind are "
"complete."

msgctxt "620d8af418e14ad68117a47fe1ded5eb"
msgid "སྔགས་ རྣམས་ ཀུན་ གྱི་ མཚན་ཉིད་ ནི ། །"
msgstr "The characteristics of all mantras are"

msgctxt "fd29aec9d02f4318b257dd991202cda4"
msgid "བདེ་བ་␣ར་ གཤེགས་པ་␣འི་ ཐུགས་ ལ་ གནས །"
msgstr "Abided in the mind of Sugata."

msgctxt "0459cf1dd79547068b47f97cafdd2421"
msgid "ཞེས་ སོ །"
msgstr "As said."

msgctxt "e26b628aba8a4f6cb9e2a56db18cac44"
msgid "དེ་ལྟར་ ན་ ལྷ་ གཅིག་ གིས་ རིགས་ ཐམས་ཅད་ བསྡུས་པ་␣ས་"
msgstr ""
"In this way, because one deity can bring together all of the families,"

msgctxt "503a08e4dd2047b7a6636fde10f7a13a"
msgid "ཕྲིན་ལས་ བཞི་ ཀ་ སྒྲུབ་ ནུས་པ་ ཡིན་ ནོ །"
msgstr "All four enlightened activities can be accomplished."

msgctxt "0bc181376e8c4ac79dcd8b525eb6154b"
msgid "ལྷན་␣༽༽  ལྷ་ རེ་རེ་ ལ་ མཚན་ ངེས་པ་ ཅན་ རེ་རེ་ ཡོད་པ་ འདོད་ མོད་ ཀྱང་ །"
msgstr ""
"Addendum: Although it is accepted that each deity has a definite name."

msgctxt "5b0022dfeb774455a99b266ec5b1527c"
msgid "འདི་␣ར་ ནི་ ལྷ་ རྣམས་ ཀུན་ གྱི་ མཚན་ ནི་"
msgstr "In this [system], the names of all the gods are"

msgctxt "37e72936705f442cbe8aeb2242470253"
msgid "འབྲས་བུ་ མངོན་དུ་ བྱས་པ་␣འམ་ མཛད་འཕྲིན་ གྱི་ དོན་ ལ་བཏགས་པ་ ཡིན་ ན་"
msgstr ""
"If [the names] are designated for the sake of the actualized result or the "
"enlightened activity, "

msgctxt "88ab3784cd454d6691fd51ea686374aa"
msgid ""
"དེ་ ནི་ རང་ གི་ ལྷག་པ་␣འི་ ལྷ་ གཅིག་ བདེ་མཆོག་ ལྟ་བུ་ ཡིས་ ཀྱང་ མཚན་ དེ་ "
"ཀུན་ བཟུང་བ་ ཡིན་ ཏེ་"
msgstr ""
"That is the name of one's own special deity, such as Cakrasamvara, is held "
"by everyone."

msgctxt "63966bf75d204c2dbc313b56aaa1cbc7"
msgid "སྒྲིབ་པ་ ལམ་ གྱིས་ སྦྱངས་ ཏེ་"
msgstr "Obscurations are purified by the path."

msgctxt "3460cfd221854c2dbac68cc3e3eaed33"
msgid ""
"འབྲས་བུ་␣ས་ ཡོན་ཏན་ གྱི་ ངོ་བོ་␣ར་ སངས་རྒྱས་པ་␣ར་ གཅིག་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"The result is the same as becoming Buddha in the essence of the qualities."

msgctxt "e97710487ecc4ed78fa464c2c2ee6e65"
msgid "སྐུ་ མཚན་དཔེ་ ཐུགས་ བྲལ་འབྲས་ ཡེ་ཤེས་ དང་ ལྡན་ ཅིང་ །"
msgstr ""
"The body is endowed with marks and signs, the mind is the result of "
"disconnection endowed with wisdom, "

msgctxt "a34d3f905bc74c97821dc99b0001b69c"
msgid "མཚན་ བཅོམ་ལྡན་འདས་ འབོད་པ་ དང༌ །"
msgstr "The name is called the Blessed One and"

msgctxt "333794db0f384cada3df54d1aea2bb1f"
msgid "གསོལ་བ་ བཏབ་ ན་ རྗེས་སུ་ འཛིན་པ་ གཅིག་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"Because if one supplicates, accepting and subsequent caring are the same. "

msgctxt "437d1a60d9bd43b6994e434a809a7b93"
msgid ""
"རྡོ་␣༽༽  གསུམ་པ་ ཤེས་རབ་ ཡེ་ཤེས་ གཞན་ ལུས་ ཕྱག་རྒྱ་ ལ་␣ས་ ལེན་པ་␣ར་ གསུངས་ "
"ཏེ །"
msgstr ""
"Vajra: The third, it is said that the wisdom-knowledge is taken from the "
"mudra of other body."

msgctxt "be7c7860d4624c70b0a2e1dd8c9be416"
msgid ""
"དེ་␣འང་ དངོས་གཞི་ སློབ་དཔོན་ གྱིས་ གདམས་ངག་ རྗེས་ བསྟན་ གྱི་ དགའ་ བཞི་ "
"བདེ་སྟོང་ གི་ ཏིང་འཛིན་ ངོ་ སྤྲད་ ཅིང་"
msgstr ""
"In the main practice, the master introduces the meditative absorption of "
"bliss and emptiness of the four joys through instruction and further "
"teaching."

msgctxt "4a65aa571b9f4e82baff0f1ccbfc9ad1"
msgid "དེ་ལྟར་ ངེས་ཤེས་ སྐྱེས་པ་ ལ་"
msgstr "For the arising of such certainty,"

msgctxt "6e20fc6c99a04c348f23680059f09f2f"
msgid "མཻ་ ཏྲིས་ དཔེ་ དང་ ནཱ་ རོ་␣ས་ དོན་ གྱི་ ཡེ་ཤེས་ སུ་ བཞེད་པ་␣ས་"
msgstr ""
"Maitri accepted it as metaphoric wisdom and Naropa accepted it as true "
"wisdom."

msgctxt "2b63191c5eb34f8b905bf37f452f5d5e"
msgid "མར་པ་␣ས་ དེ་ཉིད་ རྟོགས་ མ་ རྟོགས་ ཡིན་ གསུངས་པ་ དང་"
msgstr "Marpa said that it is whether or not one realizes suchness."

msgctxt "f41dcdd6929b4d8d8b80b28c7d847797"
msgid "འགའ་ཞིག་ དཔེ་ དང་ འགའ་ཞིག་ དོན་ གྱི་ ཡེ་ཤེས་ སུ་ འདོད་ མོད །"
msgstr ""
"Though, some accept it as metaphoric wisdom, while others accept it as "
"ultimate wisdom."

msgctxt "e655d23d84da46338a6a40ad4e66877f"
msgid ""
"འདི་␣ར་ ནི་ དབང་དོན་ བློ་ ལ་␣ས་ འདས་པ་␣ར་ རྟོགས་པ་␣འི་ ཡེ་ཤེས་ རྒྱུད་ ལ་མ་ "
"སྐྱེས་ ན་"
msgstr ""
"In this [system], If the wisdom realizing that the sense faculties and "
"referents are beyond the intellect has not arisen in one's mindstream, "

msgctxt "66f13823d09d48baa182d5761334747f"
msgid "དཔེ་ ཡིས་ དོན་ དེ་ གཉིས་ ཁོང་ དུ་ མི་ ཆུད་"
msgstr "The meanings of these two cannot be understood by examples."

msgctxt "7a15066034f343ee9c9150c18280728a"
msgid ""
"དེ་ འདྲ་བ་␣ས་ འདྲ་བ་ མཚོན་པ་␣འི་ ཉམས་མྱོང་ ཐམས་ཅད་ བློ་␣ས་ བྱས་ ཡིན་པ་␣འི་ "
"ཕྱིར་ རོ ། །"
msgstr ""
"This is because all experiences that indicate something similar to that are "
"created by the mind."

msgctxt "8022795593ea4df5a3fc8f629c129e0e"
msgid "དེ་ལྟར་ ཡང་ ཡེ་ཤེས་ གྲུབ་པ་ ལ་␣ས །"
msgstr "Likewise, The Attainment of Wisdom says:"

msgctxt "b09f479e8c8e4ead8861f7bd68a5555f"
msgid "དབང་པོ་ གཉིས་ སྦྱོར་ བདེ་བ་ ནི །"
msgstr "The bliss of the union of the two organs,"

msgctxt "d62f6b94e8bf450dabda05be09845a68"
msgid "དེ་ཉིད་ ཡིན་ ཅེས་ སྐྱེ་ ངག་ སྨྲ ། །"
msgstr "Is thusness as it is said by beings."

msgctxt "9c0189e70a3147f3b63746020d18d09d"
msgid "དེ་ ནི་ བདེ་བ་ ཆེ་ ཡིན་ ཅེས ། །"
msgstr "That is great bliss."

msgctxt "8d900bfb0fbc43e698fde4928328677b"
msgid "རྒྱལ་བ་ རྣམས་ ཀྱིས་ མ་ གསུངས་ སོ །"
msgstr "The conquerors have not said it."

msgctxt "6d9be6c2490247b1a96f245904b07168"
msgid "ཅེས་ སོ །"
msgstr "As said."

msgctxt "f6fcdc5d709a44b381883f4b101c17e0"
msgid "ཕག་གྲུ་␣ས །"
msgstr "Phagmo Drupa said:"

msgctxt "7717ad3fbfac4b048030ff2ffd147df9"
msgid "ཟག་བཅས་ བདེ་བ་ ཆེ་ སྒོ་ ཡི །"
msgstr "The door of great bliss is with outflows."

msgctxt "739c358db6a440578bce347507952ab8"
msgid "བདེ་ཆེན་ ཡན་ལག"
msgstr "The limb of great bliss."

msgctxt "ead6af63fe0e455ab0bbb617a1afee22"
msgid "ཞེས་ སོགས་ སོ །"
msgstr "And so on."

msgctxt "d9108dd38fc74e90abe8073f8f703ea7"
msgid ""
"དེ་ལྟར་ ན་ དཔེ་ དོན་ དེ་ གཉིས་ཀ་ ལ་␣ས་ གང་ཡིན་ ཁ་ཚོན་ བཅད་ དུ་ མེད་ དེ་"
msgstr ""
"In that case, neither of the two, the example and the meaning are for the "
"decision."

msgctxt "644861a23f934ce9b0e1665748273b6a"
msgid ""
"ཚོར་བ་ ལྷན་སྐྱེས་ བློ་འདས་ ཀྱི་ ཡེ་ཤེས་ སུ་ རྟོགས་ ན་ དཔེ་␣འམ་ དོན་ ཀྱང་ "
"ཡིན་ ཅིང་ །"
msgstr ""
"Because if one realizes feeling to be the innate wisdom beyond the rational "
"mind, it is also the example as well as the meaning,"

msgctxt "54e885cd2fc645888af3c396a8d51309"
msgid "མ་ རྟོགས་ ན་ དེ་ གཉིས་ཀ་ མིན་པ་␣འི་ ཕྱིར་ རོ །"
msgstr "But if it is not realized, it is neither."

msgctxt "316e35b9f2b74375871da1bc7b9b5993"
msgid "ལྷན་␣༽༽  གསུམ་པ་␣ས་"
msgstr "Addendum: The third"

msgctxt "e2614f4830004935b395cf5a207ed5b2"
msgid ""
"རང་རྒྱུད་ ཀྱི་ ཡེ་ཤེས་ དེ་ རིགས་ མཐུན་ བདེ་བ་␣ས་ མི་ རྟོགས་ ཟེར་བ་ དང་ །"
msgstr ""
"The statement that the wisdom of one’s own mindstream is not realized by the"
" bliss of a similar type and"

msgctxt "ea42c52f6e69423198e3a9aa9f9c4d24"
msgid "ཡང་ ཕྱིན་ ཅི་ མ་ ལོག་པ་␣ར་ རྟོགས་པ་␣ས་"
msgstr ""
"Furthermore, it is said that, since it is realized without misconception, "

msgctxt "c55e3a14471d46f5927a7234f86f6da8"
msgid "སངས་རྒྱས་ ཀྱི་ ཡེ་ཤེས་ དང་ ཁྱད་མེད་ ཅེས་ དང་ །"
msgstr "It is no different from the wisdom of the buddhas."

msgctxt "f707ccdaa73d4be3a1086d035e8c81b3"
msgid "དོན་ ཡེ་ བདེ་སྟོང་ རོ་ མཉམ་ བརྗོད་ མེད་ དུ་ མྱོང་ ན་ ཡིན་ ཟེར་བ་ དང་ །"
msgstr ""
"It is said that it is if one experiences the principal meaning and the bliss"
" and emptiness in inexpressible equal taste and "

msgctxt "d4aa41c33171463aae4af739d7975a07"
msgid "ཡང་ དེ་ མཐོང་ལམ་ གྱི་ ཡེ་ཤེས་ འོད་ གཅིག་ ཙམ་ སྐྱེ་ ཟེར་བ་"
msgstr ""
"Again, it is said that the wisdom of the path of seeing has arisen as just a"
" single light."

msgctxt "c912ab6094d84b4b9df4954af07023a4"
msgid "དེ་ བཞི་ དང༌ །"
msgstr "These four and"

msgctxt "fd6697a7402d4f6d85269891bb1a1c2d"
msgid ""
"དེ་ལས་ གོ་བ་ བཟང་ དུ་ རེ་བ་ རྣམས་ ཀྱིས་ དེ་␣ས་ གཟུགས་བརྙན་ ཙམ་ རྟོགས་ ཟེར་བ་"
" དང༌ །"
msgstr ""
"From this, those who hope for a better understanding say that it realizes "
"mere reflections."

msgctxt "d983b45b97a84814bbf73ed736b9e076"
msgid "ཡང་དག་ ལྷ་ ཡས །"
