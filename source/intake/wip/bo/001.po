msgctxt "2e9972b4110c4bb6b13ba3035b2830df"
msgid ""
"དེ་ལྟ་ བུ་␣འི་ དབང་ གི་ དོན་ རང་རྒྱུད་ ལ་ ངེས་ཤེས་ སྐྱེས་ ན་ དབང་ ཐོབ་པ་␣ར་ "
"བཞེད་ དོ །"
msgstr ""
"དེ་ལྟ་ བུ་␣འི་ དབང་ གི་ དོན་ རང་རྒྱུད་ ལ་ ངེས་ཤེས་ སྐྱེས་ ན་ དབང་ ཐོབ་པ་␣ར་ "
"བཞེད་ དོ །"

msgctxt "acf37586c3a642ecb441b87045242493"
msgid ""
"ལྷན་␣༽༽  གང་ཟག་ རབ་ འབྲིང་ ཐ་ གསུམ་ ལ་ རིམ་བཞིན་ དབང་མ་ བསྐུར་ ཡང་ ཐོབ་པ་ "
"དང༌ །"
msgstr ""
"ལྷན་␣༽༽  གང་ཟག་ རབ་ འབྲིང་ ཐ་ གསུམ་ ལ་ རིམ་བཞིན་ དབང་མ་ བསྐུར་ ཡང་ ཐོབ་པ་ "
"དང༌ །"

msgctxt "8f65b18d4b604ea6ac7085084c9d59f9"
