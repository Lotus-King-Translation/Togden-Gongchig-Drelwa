msgctxt "d4dcb4eb69a441b5b949f3853928fafb"
msgid ""
"རིམ་བཞིན་ གསང་བདག  ནམ་ སྙིང༌ །  སྤྱན་རས་ གཟིགས །  སྒྲིབ་ ་ སེལ །  སྐྱེ་མཆེད་"
" བསྡུས་པ་ ཀུན་བཟང་ དང་ རིགས །  མི་ བསྐྱོད །  རིན་འབྱུང་ །  སྣང་ མཐའ །  "
"དོན་གྲུབ །  དྲུག་པ་ རྡོ་རྗེ་ འཆང་ སྟེ་ ལྔ་པོ་ གོང་ ལྟར་ སྦྱར་ རོ །"
msgstr ""
"རིམ་བཞིན་ གསང་བདག  ནམ་ སྙིང༌ །  སྤྱན་རས་ གཟིགས །  སྒྲིབ་ ་ སེལ །  སྐྱེ་མཆེད་"
" བསྡུས་པ་ ཀུན་བཟང་ དང་ རིགས །  མི་ བསྐྱོད །  རིན་འབྱུང་ །  སྣང་ མཐའ །  "
"དོན་གྲུབ །  དྲུག་པ་ རྡོ་རྗེ་ འཆང་ སྟེ་ ལྔ་པོ་ གོང་ ལྟར་ སྦྱར་ རོ །"

msgctxt "461f93e980054cbcb65cf436a53fdc08"
msgid ""
"ནང་ལྟར་ ན །  མེ་ལོང་ །  ཆོས་དབྱིངས །  མཉམ་ཉིད །  སོ་␣ར་ རྟོག །  བྱ་ གྲུབ་ "
"ཀྱི་ ཡེ་ཤེས་"
msgstr ""
"ནང་ལྟར་ ན །  མེ་ལོང་ །  ཆོས་དབྱིངས །  མཉམ་ཉིད །  སོ་␣ར་ རྟོག །  བྱ་ གྲུབ་ "
"ཀྱི་ ཡེ་ཤེས་"

msgctxt "343a07b4de2f42d28a184bfddd5fa454"
msgid ""
"ལྔ་␣ས་ སྤང་བྱ །  གཏི་མུག  ། ཞེ་ སྡངསེར་ སྣ་ འདོད་ཆགས །  ཕྲག་དོག་ གི་ "
"མ་རིག་པ་ ལྔ་ བསལ་ བཞག་ མེད་པ་␣ར་ སྤང་ གཉེན་ མི་ བྱེད་པ་␣འི་ ཚུལ་ གྱིས་ "
"འཇོམས་པ་␣ས་ སྲུང་བ་␣འི་ ཆོག་ གོ  །"
msgstr ""
"ལྔ་␣ས་ སྤང་བྱ །  གཏི་མུག  ། ཞེ་ སྡངསེར་ སྣ་ འདོད་ཆགས །  ཕྲག་དོག་ གི་ "
"མ་རིག་པ་ ལྔ་ བསལ་ བཞག་ མེད་པ་␣ར་ སྤང་ གཉེན་ མི་ བྱེད་པ་␣འི་ ཚུལ་ གྱིས་ "
"འཇོམས་པ་␣ས་ སྲུང་བ་␣འི་ ཆོག་ གོ  །"

msgctxt "245e7a2530be4897a7eaabd3b0ef88ad"
msgid ""
"སྲུང་བ་ ཞེས་པ་ རྒྱུ་ལ་ གནས་པ་ ལམ་ གྱིས་ བསྲུངས་ ནས་ འབྲས་བུ་ མངོན་དུ་ "
"བྱེད་པ་␣འོ ། །"
msgstr ""
"སྲུང་བ་ ཞེས་པ་ རྒྱུ་ལ་ གནས་པ་ ལམ་ གྱིས་ བསྲུངས་ ནས་ འབྲས་བུ་ མངོན་དུ་ "
"བྱེད་པ་␣འོ ། །"

msgctxt "7c3af3b7142745389e3a431d9133f761"
msgid ""
"རྡོ་␣༽༽  སྨིན་ བྱེད་ སྟ་དངོ་␣ས་ གྲོལ་ བྱེད་ བསྐྱེད་རྫོགས་ སོགས་ ཀྱི་ རྣམ་ "
"བཞག་ རྒྱས་པ་ རྣམས་"
msgstr ""
"རྡོ་␣༽༽  སྨིན་ བྱེད་ སྟ་དངོ་␣ས་ གྲོལ་ བྱེད་ བསྐྱེད་རྫོགས་ སོགས་ ཀྱི་ རྣམ་ "
"བཞག་ རྒྱས་པ་ རྣམས་"

msgctxt "e142c73cca17452f8b5e15b13fd4ecae"
msgid "སྤྲོས་པ་ ལ་ དགའ་བ་ ལ་ གསུངས་པ་ ཡིན་ ཟེར །"
msgstr "སྤྲོས་པ་ ལ་ དགའ་བ་ ལ་ གསུངས་པ་ ཡིན་ ཟེར །"

msgctxt "357afc0f810644b893eafc73550f1a2e"
msgid "འདི་␣ར་ ནི་ སྤྲོས་པ་␣འི་ རིམ་པ་ དེ་ ཐམས་ཅད་"
msgstr "འདི་␣ར་ ནི་ སྤྲོས་པ་␣འི་ རིམ་པ་ དེ་ ཐམས་ཅད་"

msgctxt "1dfad4bd6d844eb3bb0331ccc539f39d"
msgid "ཤེས་བྱ་␣འི་ གཤིས་ ལ་ ཡོད་པ་ བབས་ ཀྱི་ རྟེན་འབྲེལ་ ཡིན་ ཏེ་"
msgstr "ཤེས་བྱ་␣འི་ གཤིས་ ལ་ ཡོད་པ་ བབས་ ཀྱི་ རྟེན་འབྲེལ་ ཡིན་ ཏེ་"

msgctxt "5f22b20d79ab49bf909b5bf6b23dd82b"
msgid "ཕྱི་ སྣོད་ རླུང་ མེ་ ཆུ་ ས་རི་ རབ་ ལྔ །"
msgstr "ཕྱི་ སྣོད་ རླུང་ མེ་ ཆུ་ ས་རི་ རབ་ ལྔ །"

msgctxt "23c3bfa10cdb4956a23f8ac000c94af0"
msgid ""
"རང་ ལུས་ རྐང་མཐིལ །  འདོམས །  ལྟེ་བ །  བྲང་ །  སྒལ་ཚིགས་ རྣམས་ ཡིན་པ་␣ར་ "
"གསུངས་པ་␣ས་"
msgstr ""
"རང་ ལུས་ རྐང་མཐིལ །  འདོམས །  ལྟེ་བ །  བྲང་ །  སྒལ་ཚིགས་ རྣམས་ ཡིན་པ་␣ར་ "
"གསུངས་པ་␣ས་"

msgctxt "979f0a6f911e42db8632d35158af32f3"
msgid "ཚུལ་ དེ་ལྟར་ བསྒོམ་ དགོས་པ་ དང༌ །"
msgstr "ཚུལ་ དེ་ལྟར་ བསྒོམ་ དགོས་པ་ དང༌ །"

msgctxt "b5d7003fd37e4575820c473badd8ce5d"
msgid "བཅུད་ གྲུབ་པ་␣འི་ ཚུལ་ དུ་ ལྷ་ དང་ ལྷ་མོ་␣འི་ རང་བཞིན་ གདོད་ ནས་"
msgstr "བཅུད་ གྲུབ་པ་␣འི་ ཚུལ་ དུ་ ལྷ་ དང་ ལྷ་མོ་␣འི་ རང་བཞིན་ གདོད་ ནས་"

msgctxt "3c192d9d77284ea392504fe1d9a8c39f"
msgid "གྲུབ་པ་ བསྒོམ་པ་␣ས་ འབྲས་བུ་ མཉམ་ཉིད་ མངོན་དུ་ གྱུར་པ་ སྟེ་"
msgstr "གྲུབ་པ་ བསྒོམ་པ་␣ས་ འབྲས་བུ་ མཉམ་ཉིད་ མངོན་དུ་ གྱུར་པ་ སྟེ་"

msgctxt "41a935b2528e409faefad9dfe4ae4daa"
msgid ""
"སྤྲོས་པ་ དེ་དག་ གདོད་ ནས་ གནས་པ་ རྟེན་འབྲེལ་ གྱི་ ཚུལ་ དུ་ འབྱུང་བ་␣འི་ "
"ཕྱིར་ རོ ། །"
msgstr ""
"སྤྲོས་པ་ དེ་དག་ གདོད་ ནས་ གནས་པ་ རྟེན་འབྲེལ་ གྱི་ ཚུལ་ དུ་ འབྱུང་བ་␣འི་ "
"ཕྱིར་ རོ ། །"

msgctxt "c6ec7a05c1dd4dada3b448a34cc8f04d"
msgid "དེ་ལྟར་ ཡང་ །"
msgstr "དེ་ལྟར་ ཡང་ །"

msgctxt "ed65f39d92a1437b96c1a10510c62f0f"
msgid "རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་ མ་གཏོགས་པ་␣འི ། །"
msgstr "རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་ མ་གཏོགས་པ་␣འི ། །"

msgctxt "884cd2c789274ddda4988ee9107fac37"
msgid "ཆོས་ འགའ་ ཡོད་པ་ མ་ ཡིན་ ནོ ། །"
msgstr "ཆོས་ འགའ་ ཡོད་པ་ མ་ ཡིན་ ནོ ། །"

msgctxt "bdcb9c602ff747e98a60a412d047018d"
msgid "ཞེས་ དང་ །"
msgstr "ཞེས་ དང་ །"

msgctxt "bd88d3f4ae4a4e519b6c61fba656526f"
msgid "ཕུར་པ་␣འི་ རྒྱུད་ ཉི་མ་␣འི་ འོད་ཟེར་ ལ་␣ས ། །"
msgstr "ཕུར་པ་␣འི་ རྒྱུད་ ཉི་མ་␣འི་ འོད་ཟེར་ ལ་␣ས ། །"

msgctxt "862bc43d5be349698477a45cf41d62d2"
msgid "རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་གནས་པ་␣འི་ ཆོས ། །"
msgstr "རྟེན་ ཅིང་ འབྲེལ་ འབྱུང་གནས་པ་␣འི་ ཆོས ། །"

msgctxt "e3dffe4df3634bb8bdf7617eebe568ca"
msgid "རིག་པ་␣འི་ ཡེ་ཤེས་ གསལ་བ་␣ར་ འགྱུར །"
msgstr "རིག་པ་␣འི་ ཡེ་ཤེས་ གསལ་བ་␣ར་ འགྱུར །"

msgctxt "4418644c464f4ffb8cca96cc72af059f"
msgid "ཞེས་ སོ །"
msgstr "ཞེས་ སོ །"

msgctxt "b8d44f6ea68846ea9243ef716565a811"
msgid "རྡོ་␣༽༽  རྡོ་རྗེ་␣འི་ ལུས་ ཀྱི་ གནས་ལུགས་ ལུས་ དང་ མཉམ་ དུ་"
msgstr "རྡོ་␣༽༽  རྡོ་རྗེ་␣འི་ ལུས་ ཀྱི་ གནས་ལུགས་ ལུས་ དང་ མཉམ་ དུ་"

msgctxt "278a7b1cc61c4044bacda07e264c2f91"
msgid "ཆགས་པ་ གནས་པ་ རྩ་ གཡོ་བ་ རླུང་ བཀོད་པ་"
msgstr "ཆགས་པ་ གནས་པ་ རྩ་ གཡོ་བ་ རླུང་ བཀོད་པ་"

msgctxt "7098dd7009f5457fb7ebac043385de76"
msgid "བྱང་སེམས་ ཐིག་ལེ་␣འི་ འཁོར་ལོ་ བཞི་ འདི་ ཡིན་ ཟེར །"
msgstr "བྱང་སེམས་ ཐིག་ལེ་␣འི་ འཁོར་ལོ་ བཞི་ འདི་ ཡིན་ ཟེར །"

msgctxt "28c0bc69633d4f71937c5109f63007ba"
msgid ""
"འདི་␣ར་ ནི་ རྡོ་རྗེ་␣འི་ ལུས་ ཟབ་མོ་ གཉིས་ སུ་ མེད་པ་␣འི་ འཁོར་ལོ་ བཞེད་ དེ་"
msgstr ""
"འདི་␣ར་ ནི་ རྡོ་རྗེ་␣འི་ ལུས་ ཟབ་མོ་ གཉིས་ སུ་ མེད་པ་␣འི་ འཁོར་ལོ་ བཞེད་ དེ་"

msgctxt "5d97116584c1429a8e69132a0e136b44"
msgid "ཆོས་སྐུ་ ཡིན་པ་␣འི་ ཕྱིར་␣༑"
msgstr "ཆོས་སྐུ་ ཡིན་པ་␣འི་ ཕྱིར་␣༑"

msgctxt "e42a5887667d4ae18e6b72fcc4acfdee"
msgid "དཔེར་ན་ དམ་བཅའ་ བདུན་ ལྡན་ གྱི་ ཕ་ལམ་ བཞིན་ ནོ །"
msgstr "དཔེར་ན་ དམ་བཅའ་ བདུན་ ལྡན་ གྱི་ ཕ་ལམ་ བཞིན་ ནོ །"

msgctxt "777d18065da3436a8af99bcb49f7132f"
msgid "དེ་ལྟར་ ཡང་ རྡོ་རྗེ་ རྩེ་མོ་ ལ་␣ས་"
msgstr "དེ་ལྟར་ ཡང་ རྡོ་རྗེ་ རྩེ་མོ་ ལ་␣ས་"

msgctxt "62686fa70c824248aa88b631da2ad5a5"
msgid "སྲ་ ཞིང་ སྙིང་པོ་ ཁོང་སྟོང་ མེད ། །"
msgstr "སྲ་ ཞིང་ སྙིང་པོ་ ཁོང་སྟོང་ མེད ། །"

msgctxt "53d8c5105e8f4024a41f193c4f2f10bd"
msgid "གཞིག་ ཅིང་ གཞོམ་ དུ་ མེད་པ་␣ས་ ན ། །"
msgstr "གཞིག་ ཅིང་ གཞོམ་ དུ་ མེད་པ་␣ས་ ན ། །"

msgctxt "3fe7f01505c94afaae43a2bab5012fb6"
msgid "བསྲེག་ པ་␣ར་ བྱར་མེད་ འཇིགས་པ་ མེད ། །"
msgstr "བསྲེག་ པ་␣ར་ བྱར་མེད་ འཇིགས་པ་ མེད ། །"

msgctxt "ae5f38974e6d45ce80491094f658a23a"
msgid "སྟོང་པ་ཉིད་ ནི་ རྡོ་རྗེ་␣ར་ བཤད ། །"
msgstr "སྟོང་པ་ཉིད་ ནི་ རྡོ་རྗེ་␣ར་ བཤད ། །"

msgctxt "36e25b466d41446d919f81bedf6354b3"
msgid "ཅེས་པ་␣ས་ ཆོས་སྐུ་ ཡོན་ཏན་ མཛད་པ་ དང་ བཅས་པ་ སྟེ་"
