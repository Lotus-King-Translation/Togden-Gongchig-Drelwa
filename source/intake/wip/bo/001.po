msgctxt "7aa78afa61834ea5a69a0d9e53c60785"
msgid ""
"སངས་རྒྱས་ ཀྱི་ གནས་ དང་ གནས་མིན་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ ཀྱི་ གཟིགས་པ་ དང་"
msgstr ""
"སངས་རྒྱས་ ཀྱི་ གནས་ དང་ གནས་མིན་ མཁྱེན་པ་␣འི་ ཡེ་ཤེས་ ཀྱི་ གཟིགས་པ་ དང་"

msgctxt "3896332cb2ca423caaf920a3916426d6"
