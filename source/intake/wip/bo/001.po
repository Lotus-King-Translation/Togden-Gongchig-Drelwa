msgstr "དུས་ དུས་གསུམ་ དུས་ མེད་ དང་ །"

msgctxt "e062ee1351074ee9812182f3e9e799e8"
msgid "རྟག་པ་ རྒྱུན་ འཁོར་ དང་ འདུལ་བ་␣འི་ དུས་ ཏེ་ གསུམ་ ལ་"
msgstr "རྟག་པ་ རྒྱུན་ འཁོར་ དང་ འདུལ་བ་␣འི་ དུས་ ཏེ་ གསུམ་ ལ་"

msgctxt "22c1ea27fd894306ad1e8f296f81334f"
