msgstr "བསྐྱེད་རྫོགས་ གཉིས་ དངོས་གཞི་ མེད་ ཐབས་མེད་པ་ དང་"

msgctxt "2c7afe2943f74a15ace47c07898aa69f"
msgid "དགེ་རྩ་ བྱང་ཆུབ་ ཏུ་ བསྔོ་བ་ དང་ བཅས་པ་ མེད་ ན་ ཆུད་ ཟ་བ་␣འི་ ཕྱིར །"
msgstr "དགེ་རྩ་ བྱང་ཆུབ་ ཏུ་ བསྔོ་བ་ དང་ བཅས་པ་ མེད་ ན་ ཆུད་ ཟ་བ་␣འི་ ཕྱིར །"

msgctxt "fa36032f725446e4900fea2654c95718"
msgid ""
"དེ་ལྟར་ ཐུན་ གཅིག་ གི་ སྟེང་ དུ་ ཉམས་ སུ་ ལེན་ ན་ ཇོ་བོ་ རྗེའི་ དགོངས་པ་ "
"ཡིན་ ནོ །"
msgstr ""
"དེ་ལྟར་ ཐུན་ གཅིག་ གི་ སྟེང་ དུ་ ཉམས་ སུ་ ལེན་ ན་ ཇོ་བོ་ རྗེའི་ དགོངས་པ་ "
"ཡིན་ ནོ །"

msgctxt "13e59852a5e04443ac2c06a8882e4cd9"
msgid "རྡོ་␣༽༽  ཞིང་ གཅིག་ ལ་ སངས་རྒྱས་ གཅིག་ ལས་མི་ འབྱུང་བ་"
msgstr "རྡོ་␣༽༽  ཞིང་ གཅིག་ ལ་ སངས་རྒྱས་ གཅིག་ ལས་མི་ འབྱུང་བ་"

msgctxt "31ee9e5b91d34d8c848adbe818935d11"
msgid "དགོངས་ འདུས་ དང་ བོན་ འབུམ་ ན་ འདོད་ འདོད་པ་␣ས་"
