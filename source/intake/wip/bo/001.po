msgctxt "105e243f7b91419db6b78e38dd3ab249"
msgid ""
"དེ་ལྟར་ ཡང་གསང་ འདུས་ རིགས་བཞི་␣འི་ དམ་ཚིག་ གི་ སྲོག་ཆགས་ གསོད་པ་ སོགས་ "
"བཞི་␣འི་ དོན་"
msgstr ""
"དེ་ལྟར་ ཡང་གསང་ འདུས་ རིགས་བཞི་␣འི་ དམ་ཚིག་ གི་ སྲོག་ཆགས་ གསོད་པ་ སོགས་ "
"བཞི་␣འི་ དོན་"

msgctxt "28a7df32bbc84ad1a5172002b26bcb59"
