msgstr "ཞེས་པ་␣ས་ དེ་ མངོན་དུ་ བྱས་པ་␣འོ །"

msgctxt "6a01bebdcdf942eaa66e06ba898575e1"
msgid ""
"རྡོ་␣༽༽  རྩ་ རླུང་ ཐིག་ལེ་␣འི་ གནས་ལུགས་ རྒྱུད་ དུ་ གསུངས་པ་ དེ་ ཁོ་ན་␣ར་ "
"ངེས་ ཟེར་"
msgstr ""
"རྡོ་␣༽༽  རྩ་ རླུང་ ཐིག་ལེ་␣འི་ གནས་ལུགས་ རྒྱུད་ དུ་ གསུངས་པ་ དེ་ ཁོ་ན་␣ར་ "
"ངེས་ ཟེར་"

msgctxt "7a9ee1fa99034c5cbe7813cdb9a0a1a5"
msgid "འདི་␣ར་ ནི་ ཟབ་མོ་␣འི་ གནས་ལུགས་ འགའ་ཞིག་"
msgstr "འདི་␣ར་ ནི་ ཟབ་མོ་␣འི་ གནས་ལུགས་ འགའ་ཞིག་"

msgctxt "8004c99d5dd747d78e223dcac45bddd6"
msgid ""
"རྡོ་རྗེ་ འཆང་ གིས་ རྒྱུད་ དཀྲུགས་ ལུང་ བཅུ་␣ས་ མན་ངག་ གབ་པ་␣འི་ སྒོ་ ནས་ "
"སྦས་པ་ ཡིན་ ཏེ །"
