msgstr "སྔགས་ སུ་ མི་འགྱུར་བ་␣ས་ སྦྱོང་བ་␣འི་ ལམ་པ་ ཡིན་ ནོ །"

msgctxt "ab7bdd1769334f8bbe768b90ffaac777"
msgid ""
"རྡོ་␣༽༽  སྔགས་ སུ་ མི་དགེ་བ་ ཐབས་མཁས་པ་␣ས་ སྤྱད་པ་␣ས་ དགེ་བ་␣ར་ འགྱུར་ ཏེ་"
msgstr ""
"རྡོ་␣༽༽  སྔགས་ སུ་ མི་དགེ་བ་ ཐབས་མཁས་པ་␣ས་ སྤྱད་པ་␣ས་ དགེ་བ་␣ར་ འགྱུར་ ཏེ་"

