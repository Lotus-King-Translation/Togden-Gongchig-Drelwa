msgstr "འབྲས་བུ་ འགོག་པ་ ཐོབ་པ་"

msgctxt "7bc4133f1ac349e09b3704deab9bce0f"
msgid "མྱང་འདས་ རྒྱུ་འབྲས་ སྒྲུབ་ བཅས་"
msgstr "མྱང་འདས་ རྒྱུ་འབྲས་ སྒྲུབ་ བཅས་"

msgctxt "a0175cb945934a4fa2e326a5e535d7fd"
msgid "བླང་ བྱ་ འཇུག་པ་␣འི་ ཚུལ་ཁྲིམས་ ལུང་བཞི་␣ས་ བསྟན་པ་"
msgstr "བླང་ བྱ་ འཇུག་པ་␣འི་ ཚུལ་ཁྲིམས་ ལུང་བཞི་␣ས་ བསྟན་པ་"

msgctxt "f216102f9a9f47c2ba074ddb3b82b062"
msgid "རབ་བྱུང་ སོགས་ བཞི་ བཅུ་བདུན་ ལས་མི་ འགལ་བ་ ལམ་ དང་ །"
msgstr "རབ་བྱུང་ སོགས་ བཞི་ བཅུ་བདུན་ ལས་མི་ འགལ་བ་ ལམ་ དང་ །"

msgctxt "f2d324b4c7d4474f8237004f21dc7dca"
msgid ""
"དེ་␣ས་ ཀུན་འབྱུང་ སྤང་བ་␣ས་ སྡུག་བསྔལ་ འགག་པ་ འགོག་ འདེན་ ཡིན་པ་␣འི་ ཕྱིར་ "
"དང་ ༑"
msgstr ""
"དེ་␣ས་ ཀུན་འབྱུང་ སྤང་བ་␣ས་ སྡུག་བསྔལ་ འགག་པ་ འགོག་ འདེན་ ཡིན་པ་␣འི་ ཕྱིར་ "
"དང་ ༑"

msgctxt "c092aa13862443ca8713e265aee33e1f"
msgid "བསྟན་བཅོས་ ཁོ་ན་␣ས་ ཀྱང་ ལུང་སྡེ་བཞི་␣འི་ དོན་"
msgstr "བསྟན་བཅོས་ ཁོ་ན་␣ས་ ཀྱང་ ལུང་སྡེ་བཞི་␣འི་ དོན་"

msgctxt "a985315e15cb4492b20b8ab08c49b860"
msgid "བདེན་ བཞི་␣ར་ བཀྲལ་ ཏེ་ ངེས་འབྱུང་ གི་ དབང་ དུ །"
msgstr "བདེན་ བཞི་␣ར་ བཀྲལ་ ཏེ་ ངེས་འབྱུང་ གི་ དབང་ དུ །"

msgctxt "cd9ba85a9ced4d5cad946eae5e5b687b"
msgid "གང་ འབྱུང་ ན་ གང་ཟག་ གམ་ ཀུན་འབྱུང༌ །"
msgstr "གང་ འབྱུང་ ན་ གང་ཟག་ གམ་ ཀུན་འབྱུང༌ །"

msgctxt "44fbe99c52e04368961624ece9b842bd"
msgid "གར་ འབྱུང་ ན་ མྱང་འདས་ སམ་ འགོག་པ །"
msgstr "གར་ འབྱུང་ ན་ མྱང་འདས་ སམ་ འགོག་པ །"

msgctxt "8dd6f3f37d714f6a8672cf9409d58823"
msgid ""
"ཐབས་ཚུལ་ གང་ གིས་ འབྱུང་ ན་ འཕགས་ལམ་ དགག་སྒྲུབ་ ཀྱི་ བསླབ་པ་␣འི་ ཚུལ་ གྱིས་ "
"འབྱུང་བ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"ཐབས་ཚུལ་ གང་ གིས་ འབྱུང་ ན་ འཕགས་ལམ་ དགག་སྒྲུབ་ ཀྱི་ བསླབ་པ་␣འི་ ཚུལ་ གྱིས་ "
"འབྱུང་བ་␣འི་ ཕྱིར་ དང༌ །"

msgctxt "293e8e4789a44d4fa37c23c2881075ee"
msgid "གནས་མལ་ གྱི་ གཞི་ ལས་སྒོ་ གདོད་ དུ་"
msgstr "གནས་མལ་ གྱི་ གཞི་ ལས་སྒོ་ གདོད་ དུ་"

msgctxt "7692bcbe1a8f4d61aae7c8f53ad21d3f"
msgid "སྲིད་པ་␣འི་ འཁོར་ལོ་ ཆ་ ལྔ་པ་␣ར་ གསུངས་པ་ དང །"
msgstr "སྲིད་པ་␣འི་ འཁོར་ལོ་ ཆ་ ལྔ་པ་␣ར་ གསུངས་པ་ དང །"

msgctxt "a4f6b1ba28b847d080703b2bdb8d88ee"
msgid "ལུང་ ཡང་"
