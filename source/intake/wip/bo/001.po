msgstr "ལུས་མེད་ ལུས་ ཏེ་ ལུས་ ཀྱི་ མཆོག  །"

msgctxt "a5976b0b82d8480eb2be2aa7b8ec69a1"
msgid "ལུས་ ཀྱི་ མཐའ་ ནི་ རྟོཌ་པ་ པོ །"
msgstr "ལུས་ ཀྱི་ མཐའ་ ནི་ རྟོཌ་པ་ པོ །"

msgctxt "e03d72c4e4e74eab8fe16840d713012a"
