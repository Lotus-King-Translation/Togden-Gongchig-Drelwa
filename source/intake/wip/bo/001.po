msgstr "འབྲས་བུ་ མངོན་དུ་ བྱས་པ་␣འམ་ མཛད་འཕྲིན་ གྱི་ དོན་ ལ་བཏགས་པ་ ཡིན་ ན་"

msgctxt "88ab3784cd454d6691fd51ea686374aa"
msgid ""
"དེ་ ནི་ རང་ གི་ ལྷག་པ་␣འི་ ལྷ་ གཅིག་ བདེ་མཆོག་ ལྟ་བུ་ ཡིས་ ཀྱང་ མཚན་ དེ་ "
"ཀུན་ བཟུང་བ་ ཡིན་ ཏེ་"
msgstr ""
"དེ་ ནི་ རང་ གི་ ལྷག་པ་␣འི་ ལྷ་ གཅིག་ བདེ་མཆོག་ ལྟ་བུ་ ཡིས་ ཀྱང་ མཚན་ དེ་ "
"ཀུན་ བཟུང་བ་ ཡིན་ ཏེ་"

msgctxt "63966bf75d204c2dbc313b56aaa1cbc7"
msgid "སྒྲིབ་པ་ ལམ་ གྱིས་ སྦྱངས་ ཏེ་"
msgstr "སྒྲིབ་པ་ ལམ་ གྱིས་ སྦྱངས་ ཏེ་"

msgctxt "3460cfd221854c2dbac68cc3e3eaed33"
msgid ""
"འབྲས་བུ་␣ས་ ཡོན་ཏན་ གྱི་ ངོ་བོ་␣ར་ སངས་རྒྱས་པ་␣ར་ གཅིག་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"འབྲས་བུ་␣ས་ ཡོན་ཏན་ གྱི་ ངོ་བོ་␣ར་ སངས་རྒྱས་པ་␣ར་ གཅིག་པ་␣འི་ ཕྱིར་ དང༌ །"

msgctxt "e97710487ecc4ed78fa464c2c2ee6e65"
msgid "སྐུ་ མཚན་དཔེ་ ཐུགས་ བྲལ་འབྲས་ ཡེ་ཤེས་ དང་ ལྡན་ ཅིང་ །"
msgstr "སྐུ་ མཚན་དཔེ་ ཐུགས་ བྲལ་འབྲས་ ཡེ་ཤེས་ དང་ ལྡན་ ཅིང་ །"

msgctxt "a34d3f905bc74c97821dc99b0001b69c"
