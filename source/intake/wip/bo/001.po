msgstr "སོ་སོ་ ཐ་དད་ དུ་ སྟོན་པ་ ཡིན་ ཟེར་ རོ ། །"

msgctxt "25d1bcbe3bad4e86b07a7f10e43de7d6"
msgid "འདི་␣ར་ ནི་ སྐུ་གསུམ་པོ་ ཐ་དད་ མེད་པ་␣ར་ བཞུགས་པ་ ཡིན་ ཏེ་"
msgstr "འདི་␣ར་ ནི་ སྐུ་གསུམ་པོ་ ཐ་དད་ མེད་པ་␣ར་ བཞུགས་པ་ ཡིན་ ཏེ་"

msgctxt "6dc621a3c442409592bab6e83d5bdce2"
msgid "རྒྱུ་ བླ་མ་ ལ་␣ས །"
msgstr "རྒྱུ་ བླ་མ་ ལ་␣ས །"

msgctxt "f40c25437b94422cb1c87bab221bb96e"
msgid "དེ་ ནི་ རང་བཞིན་ དག་ ཕྱིར་ དང་ ། །"
msgstr "དེ་ ནི་ རང་བཞིན་ དག་ ཕྱིར་ དང་ ། །"

msgctxt "7759f750ba6b4e33ae8cfb797f23af3d"
msgid "བག་ཆགས་ སྤངས་ ཕྱིར་ གཙང་བ་ ཡིན ། །"
msgstr "བག་ཆགས་ སྤངས་ ཕྱིར་ གཙང་བ་ ཡིན ། །"

msgctxt "12699cf22ffb460787e1d2ed34a42101"
msgid "བདག་ དང་ བདག་མེད་ སྤྲོས་པ་ དག  །"
msgstr "བདག་ དང་ བདག་མེད་ སྤྲོས་པ་ དག  །"

msgctxt "22c5747677ce4232a0d66e59ae22e3f4"
msgid "ཉེ་བར་ ཞི་བ་ དམ་པ་␣འི་ བདག  །"
msgstr "ཉེ་བར་ ཞི་བ་ དམ་པ་␣འི་ བདག  །"

msgctxt "2760d9c2206042cfa4501989d996b1ae"
msgid "ཡིད་ ཀྱི་ རང་བཞིན་ ཕུང་པོ་ དང༌ ། །"
msgstr "ཡིད་ ཀྱི་ རང་བཞིན་ ཕུང་པོ་ དང༌ ། །"

msgctxt "b26c76cf54704cad82fa90b1e02605a8"
msgid "དེ་ རྒྱུ་␣འི་ ལོག་ ཕྱིར་ བདེ་བ་ ཉིད ། །"
msgstr "དེ་ རྒྱུ་␣འི་ ལོག་ ཕྱིར་ བདེ་བ་ ཉིད ། །"

msgctxt "e488e49f0ffa41f9949eef6ef2bcf559"
msgid "ཅེས་པ་␣ས་ མཚན་ཉིད་ བཞི་ ལྡན་ གྱི་ ཆོས་སྐུ་ དེ་ཉིད་"
msgstr "ཅེས་པ་␣ས་ མཚན་ཉིད་ བཞི་ ལྡན་ གྱི་ ཆོས་སྐུ་ དེ་ཉིད་"

msgctxt "65f07dd8c468466184858bc28167f3b7"
msgid "མཚན་ དང་ དཔེ་བྱད་ ཀྱིས་ བརྒྱན་པ་ ལོངས་སྐུ །"
msgstr "མཚན་ དང་ དཔེ་བྱད་ ཀྱིས་ བརྒྱན་པ་ ལོངས་སྐུ །"

msgctxt "fb107224c2944e248b819e3909db34cf"
msgid ""
"དེ་ གཉིས་ དབྱེ་␣ར་ མེད་པ་␣ར་ སེམས་ཅན་ གྱི་ དོན་ མཛད་པ་ སྤྲུལ་སྐུ་ ཡིན་པ་␣འི་"
" ཕྱིར་ རོ ། །"
msgstr ""
"དེ་ གཉིས་ དབྱེ་␣ར་ མེད་པ་␣ར་ སེམས་ཅན་ གྱི་ དོན་ མཛད་པ་ སྤྲུལ་སྐུ་ ཡིན་པ་␣འི་"
" ཕྱིར་ རོ ། །"

msgctxt "3f03d6b4c1fd45b6911bbfefe6bb4009"
msgid "དེ་ལྟར་ ཟླ་ སྒྲོན་ ལ་␣ས །"
msgstr "དེ་ལྟར་ ཟླ་ སྒྲོན་ ལ་␣ས །"

msgctxt "85b6222791c1459f818ff8ed826983c8"
msgid "སྐུ་ ནི་ ནམ་མཁ་␣འི་ མཚན་ཉིད་ དེ ། །"
msgstr "སྐུ་ ནི་ ནམ་མཁ་␣འི་ མཚན་ཉིད་ དེ ། །"

msgctxt "a2754fdb07c84402a6f3f281271c9152"
msgid "སངས་རྒྱས་ ཞིང་ ཡང་ དེ་ འདྲ་ སྟེ ། །"
