msgstr "འཕོ་ བྱ་ འཕོ་ བྱེད་ ཀྱི་ རྟེན་ དང་ བྲལ་བ་␣འི་ ཕྱིར་ རོ ། །"

msgctxt "af732c8457ca4899b205f862aa4b1f88"
msgid "དེ་ལྟར་ ཡང་ འཕོ་ རྒྱུ་ བྱུང་ ན་ རྣལ་འབྱོར་ མིན །"
msgstr "དེ་ལྟར་ ཡང་ འཕོ་ རྒྱུ་ བྱུང་ ན་ རྣལ་འབྱོར་ མིན །"

msgctxt "9652cd4237aa4ed9a06f6fbc69d42b31"
