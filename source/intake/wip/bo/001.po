msgstr "ལེགས་ སྐར་ སངས་རྒྱས་ བར་ གསུངས་པ་ བཞིན་ ནོ ། །"

msgctxt "b51978a4d96245e3945c44f75e7130ef"
msgid ""
"ཆོས་ ཀྱི་ འཁོར་ལོ་␣འི་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ་ ཚིགས་ རྐང་ སུམ་ བཅུ་པ་ "
"ལྷན་ཐབས་ ཚིགས་ རྐང་ བཅོ་ལྔ་␣འི་ འགྲེལ་བཤད་ ཀྱི་ སྐབས་ ཏེ་ དང་པོ་␣འོ ། །"
msgstr ""
"ཆོས་ ཀྱི་ འཁོར་ལོ་␣འི་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ་ ཚིགས་ རྐང་ སུམ་ བཅུ་པ་ "
"ལྷན་ཐབས་ ཚིགས་ རྐང་ བཅོ་ལྔ་␣འི་ འགྲེལ་བཤད་ ཀྱི་ སྐབས་ ཏེ་ དང་པོ་␣འོ ། །"

msgctxt "09de03364286405a9d179f8d50aa06a9"
msgid "རྡོ་␣༽༽  གཞན་དག་ ན་རེ །"
msgstr "རྡོ་␣༽༽  གཞན་དག་ ན་རེ །"

msgctxt "6f4742e0d70445ba99994a764efdfa53"
msgid ""
"དགེ་ མི་དགེ་ གང་ གིས་ ཀྱང་ དབང་མ་ བྱས་པ་␣འི་ འབྱུང་ ཆེན་ བཞི་ ཁམས་ "
"བཅོ་བརྒྱད་ ལུང་ མ་ བསྟན་ དུ་ གསུངས་ མོད །"
msgstr ""
"དགེ་ མི་དགེ་ གང་ གིས་ ཀྱང་ དབང་མ་ བྱས་པ་␣འི་ འབྱུང་ ཆེན་ བཞི་ ཁམས་ "
"བཅོ་བརྒྱད་ ལུང་ མ་ བསྟན་ དུ་ གསུངས་ མོད །"

msgctxt "55215049bfed41a1b6d1d737a7df7ac1"
