msgctxt "c4f7bfaad7fb4dea9ae7a089f423fb6f"
msgid ""
"འདི་␣ར་ དེ་␣འི་ སྟེང་ དུ་ ཆོས་ ཚུལ་ཁྲིམས་ དང་ སྒྲུབ་པ་ དང་ ཚད་ མེད་པ་␣འི་ "
"སྙིང་རྗེ་ གསུམ་ མི་ ལྡན་ ན་"
msgstr ""
"འདི་␣ར་ དེ་␣འི་ སྟེང་ དུ་ ཆོས་ ཚུལ་ཁྲིམས་ དང་ སྒྲུབ་པ་ དང་ ཚད་ མེད་པ་␣འི་ "
"སྙིང་རྗེ་ གསུམ་ མི་ ལྡན་ ན་"

msgctxt "b9f99def4eaf4cff916325a366438d1e"
