msgctxt "0ef727766ef94d4688b0f5071d149379"
msgid ""
"ལྟ་ སྒོམ་ སྤྱོད་པ་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ་␣འི་ ཚིག་རྐང་ ཉི་ཤུ་ ལྷན་ཐབས་ "
"ཚིག་རྐང་ ལྔ་ བཅས་ ཀྱི་ འགྲེལ་བཤད་ བྱེད་པ་␣འི་ སྐབས་ ཏེ་ དྲུག་པ་␣འོ །"
msgstr ""
"ལྟ་ སྒོམ་ སྤྱོད་པ་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ་␣འི་ ཚིག་རྐང་ ཉི་ཤུ་ ལྷན་ཐབས་ "
"ཚིག་རྐང་ ལྔ་ བཅས་ ཀྱི་ འགྲེལ་བཤད་ བྱེད་པ་␣འི་ སྐབས་ ཏེ་ དྲུག་པ་␣འོ །"

msgctxt "4614041febf443daa0ccd6f1a56488c2"
