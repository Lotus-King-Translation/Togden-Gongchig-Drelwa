"སྨོན་ འཇུག་ གཉིས་ ལས་རིམ་ བཞིན་ ལོངས་སྐུ་ དང་ སྤྲུལ་སྐུ་ རུ་ འབྱུང་བ་␣འང་ "
"ཡོད་པ་␣ར་ སྲིད་ དེ །"
msgstr ""
"སྨོན་ འཇུག་ གཉིས་ ལས་རིམ་ བཞིན་ ལོངས་སྐུ་ དང་ སྤྲུལ་སྐུ་ རུ་ འབྱུང་བ་␣འང་ "
"ཡོད་པ་␣ར་ སྲིད་ དེ །"

msgctxt "c29ec7d8511d4277921fce5a598fac4e"
msgid "ནམ་མཁ་␣འི་ མཐའ་ དང་ མཉམ་པ་␣འི་"
msgstr "ནམ་མཁ་␣འི་ མཐའ་ དང་ མཉམ་པ་␣འི་"

msgctxt "0cbeecdef5704c4994759974a6a05204"
msgid ""
"སེམས་ཅན་ བློ་␣འི་ ཁོངས་ སུ་ ཆུད་པ་␣འི་ སྨོན་པ་ འདི་␣འི་ འབྲས་བུ་ ཡང་ ཚད་  "
"མེད་པ་␣འི་ ཕྱིར་ དང༌ །"
msgstr ""
"སེམས་ཅན་ བློ་␣འི་ ཁོངས་ སུ་ ཆུད་པ་␣འི་ སྨོན་པ་ འདི་␣འི་ འབྲས་བུ་ ཡང་ ཚད་  "
"མེད་པ་␣འི་ ཕྱིར་ དང༌ །"

msgctxt "af855c018e874c25bf59fc2f1474194c"
msgid "རབ་འབྱམས་ ཕྱོགས་ བཅུ་␣འི་ སངས་རྒྱས་ ལ་"
msgstr "རབ་འབྱམས་ ཕྱོགས་ བཅུ་␣འི་ སངས་རྒྱས་ ལ་"

msgctxt "6139483604054353b919e967c8fa0f05"
msgid "འདོད་འདུན་ གྱིས་ བསྐྱེད་པ་␣འི་ ཕྱིར་"
msgstr "འདོད་འདུན་ གྱིས་ བསྐྱེད་པ་␣འི་ ཕྱིར་"

msgctxt "995b800389034be3af539186739a419c"
msgid "སྨོན་པ་ ལ་␣ས་ ལོངས་སྐུ་ འབྱུང་ ཞིང༌ །"
msgstr "སྨོན་པ་ ལ་␣ས་ ལོངས་སྐུ་ འབྱུང་ ཞིང༌ །"

msgctxt "a7cd583f96b749c8aecfb031f1479100"
msgid ""
"སེམས་བསྐྱེད་པ་ དེ་ ལ་ བརྟེན་པ་ དགེ་རྩ་ ཐ་དད་ རེ་རེ་␣ས་ ཀྱང་ སྤྲུལ་པ་␣འི་ "
"སྐུ་ རེ་རེ་ འབྱུང་བ་"
msgstr ""
"སེམས་བསྐྱེད་པ་ དེ་ ལ་ བརྟེན་པ་ དགེ་རྩ་ ཐ་དད་ རེ་རེ་␣ས་ ཀྱང་ སྤྲུལ་པ་␣འི་ "
"སྐུ་ རེ་རེ་ འབྱུང་བ་"

msgctxt "0a4c94948b2949ea97abac16fb5c8783"
msgid "ཆོས་དབྱིངས་ ཐམས་ཅད་ དུ་ སངས་ རྒྱ་བ་ དང་ །"
msgstr "ཆོས་དབྱིངས་ ཐམས་ཅད་ དུ་ སངས་ རྒྱ་བ་ དང་ །"

msgctxt "eefd5c1341224fbf95342c0cecc424e3"
msgid ""
"སྐུ་རྟེན་ འབྲེལ་ དུ་ བཞེད་པ་ དག་ སྤྲུལ་པ་ རྒྱུ་ཅན་ དུ་ བཞེད་པ་␣འི་ གནད་ "
"ཀྱིས་ ཡིན་ ནོ །"
msgstr ""
"སྐུ་རྟེན་ འབྲེལ་ དུ་ བཞེད་པ་ དག་ སྤྲུལ་པ་ རྒྱུ་ཅན་ དུ་ བཞེད་པ་␣འི་ གནད་ "
"ཀྱིས་ ཡིན་ ནོ །"

msgctxt "3fbed35e77b542cea43e47a79ffef73c"
msgid "༑་␣སྔ་མ་ ལྟར་ རྫ་མཁན་ ཡང་པ་␣འི་ འོད་ ལྟར་"
msgstr "༑་␣སྔ་མ་ ལྟར་ རྫ་མཁན་ ཡང་པ་␣འི་ འོད་ ལྟར་"

msgctxt "43308815f6d14ae1be0675e9bdf23e04"
msgid "སངས་རྒྱས་ གཅིག་ ལ་ འདོད་འདུན་ བསྐྱེད་པ་␣ས་ སོ ། །"
msgstr "སངས་རྒྱས་ གཅིག་ ལ་ འདོད་འདུན་ བསྐྱེད་པ་␣ས་ སོ ། །"

msgctxt "ed31c4ee646c4c8aa071e0807de0c81e"
msgid "རྡོ་␣༽༽  སྐུ་གསུམ་པོ་ རིམ་བཞིན་ གནས་ ཆོས་དབྱིངས་ ཀྱི་ ཕོ་བྲང་ དང༌ །"
msgstr "རྡོ་␣༽༽  སྐུ་གསུམ་པོ་ རིམ་བཞིན་ གནས་ ཆོས་དབྱིངས་ ཀྱི་ ཕོ་བྲང་ དང༌ །"

msgctxt "60b75eaf217b4996b00d6519b7070909"
msgid "འོག་མིན་ དང༌ །"
msgstr "འོག་མིན་ དང༌ །"

msgctxt "e11ee04e721b4694b1ae55958a973666"
msgid "བྱ་རྒོད་ ཕུང་ རི་ སོགས་ སུ །"
msgstr "བྱ་རྒོད་ ཕུང་ རི་ སོགས་ སུ །"

msgctxt "ecb2840e258948a28dbc23111c34ef7a"
msgid "འཁོར་ སངས་རྒྱས་ དང་ །  ས་བཅུ་པ་ དང་ །  ཐེག་པ་ གསུམ་ གྱི་ རིགས་ཅན་ ལ་"
msgstr "འཁོར་ སངས་རྒྱས་ དང་ །  ས་བཅུ་པ་ དང་ །  ཐེག་པ་ གསུམ་ གྱི་ རིགས་ཅན་ ལ་"

msgctxt "b7bed558d46e4dbd9be788e672bf8deb"
msgid "ཆོས་ ཟབ་མོ་ སྐྱེ་ མེད་ དང༌ །"
msgstr "ཆོས་ ཟབ་མོ་ སྐྱེ་ མེད་ དང༌ །"

msgctxt "4bbf1557c86b4d619e9adf64fb863e5d"
msgid "ཐེག་ཆེན་ དང་ ཐེག་པ་ སྣ་ཚོགས་ དང་ །"
msgstr "ཐེག་ཆེན་ དང་ ཐེག་པ་ སྣ་ཚོགས་ དང་ །"

msgctxt "78c4011322d94d72b87753240177def5"
