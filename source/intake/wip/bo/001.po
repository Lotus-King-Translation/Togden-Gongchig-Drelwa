msgctxt "ad51752c2f2143d98d7fb2a78e3aa8cb"
msgid "སྤོང་ སེམས་ དགེ་བ་␣འི་ འབྲས་བུ་ ནི་ འབྱུང་ སྟེ །"
msgstr "སྤོང་ སེམས་ དགེ་བ་␣འི་ འབྲས་བུ་ ནི་ འབྱུང་ སྟེ །"

msgctxt "155df452d06944f985d49dec39d83502"
