msgstr "ནམ་ཞིག་ ན་ དུས་ ཡོད་ གསུངས་པ་ སོགས་ ཀྱི་ ལེགས་པ་␣ར་ གྲུབ་བོ ། །"

msgctxt "1ab59593b9ad49308ac22f8301651114"
msgid ""
