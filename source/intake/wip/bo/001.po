"རྒྱུ་␣འི་ ཐེག་པ་ སྔ་མ་␣འི་ བར་ གྱི་ ས་བོན་ གནས་ཚུལ་ གསལ་བ་␣ར་ སྒྲུབ་ མོ །"

msgctxt "ffed6237658244ecb5fb51b4313d52f0"
msgid "རྡོ་␣༽༽  ཁ་ཅིག་ ན་རེ །"
msgstr "རྡོ་␣༽༽  ཁ་ཅིག་ ན་རེ །"

msgctxt "f6eef9b7b50f45a0a3170d86de037300"
msgid ""
"འཁོར་ལོ་ གསུམ་ ནི་ གནས་དུས་ རིགས་ཅན་ གསུམ་ གསུམ་ གྱིས་ འབྱེད་པ་␣ར་ འདོད་ "
"མེད་ ལ །"
msgstr ""
"འཁོར་ལོ་ གསུམ་ ནི་ གནས་དུས་ རིགས་ཅན་ གསུམ་ གསུམ་ གྱིས་ འབྱེད་པ་␣ར་ འདོད་ "
"མེད་ ལ །"

msgctxt "8a83fa0103e24fcab946ab8146b3a4ab"
msgid ""
"འདི་␣ར་ མདོ་ དང་ དོན་ གྱི་ གནད་ ཀྱིས་ ཆོས་ ཀྱི་ འཁོར་ལོ་ རྣམ་པ་ གསུམ་ དུ་ "
"ངེས་ ཏེ །"
msgstr ""
"འདི་␣ར་ མདོ་ དང་ དོན་ གྱི་ གནད་ ཀྱིས་ ཆོས་ ཀྱི་ འཁོར་ལོ་ རྣམ་པ་ གསུམ་ དུ་ "
"ངེས་ ཏེ །"

msgctxt "82af0a8553c54453a93b8ebbd8a5733f"
msgid "ཚངས་རིས་ ཀྱི་ ལྷས་ ཨེ་མ་ སྔོན་ཆད་ འཇིག་རྟེན་ དུ་"
msgstr "ཚངས་རིས་ ཀྱི་ ལྷས་ ཨེ་མ་ སྔོན་ཆད་ འཇིག་རྟེན་ དུ་"

msgctxt "884e56aff5b84d029c56273e65704606"
msgid ""
"དགེ་སྦྱོང་ ངམ་ བྲམ་ཟེ་ འམ །  ལྷ་ འམ །  བདུད་ དམ །  ཚངས་པ་␣འམ །  སུ་␣ས་ ཀྱང་ "
"མ་ བསྐོར་བ་␣འི་ ཆོས་ ཀྱི་ འཁོར་ལོ་ བསྐོར་ རོ ། །"
msgstr ""
"དགེ་སྦྱོང་ ངམ་ བྲམ་ཟེ་ འམ །  ལྷ་ འམ །  བདུད་ དམ །  ཚངས་པ་␣འམ །  སུ་␣ས་ ཀྱང་ "
"མ་ བསྐོར་བ་␣འི་ ཆོས་ ཀྱི་ འཁོར་ལོ་ བསྐོར་ རོ ། །"

msgctxt "f84021930f8348998f8c851b7d6e6db0"
msgid "ཞེས་པ་␣ས་ དང་པོ་ དང༌ །"
msgstr "ཞེས་པ་␣ས་ དང་པོ་ དང༌ །"

msgctxt "40785c2ed1de4bb0b5d6c1af7a82b647"
msgid "རབ་འབྱོར་ གྱིས་ དེ་བཞིན་ཉིད་ ཀྱི་ ལེའུ་ བསྟན་ ཚེ་"
msgstr "རབ་འབྱོར་ གྱིས་ དེ་བཞིན་ཉིད་ ཀྱི་ ལེའུ་ བསྟན་ ཚེ་"

msgctxt "83f11acb1e6643fa9ff406a98f7a3640"
msgid "གཙང་རིས་ ལྷས་ མེ་ཏོག་ འཐོར་ ཞིང་"
msgstr "གཙང་རིས་ ལྷས་ མེ་ཏོག་ འཐོར་ ཞིང་"

msgctxt "39e939233d92479596a7695292b6d958"
msgid ""
"ཨེ་མ་ འཛམ་བུ་␣འི་ གླིང་ དུ་ ཆོས་ ཀྱི་ འཁོར་ལོ་ གཉིས་པ་ འསྐོར་བ་ མཐོང་ ངོ་ །"
msgstr ""
"ཨེ་མ་ འཛམ་བུ་␣འི་ གླིང་ དུ་ ཆོས་ ཀྱི་ འཁོར་ལོ་ གཉིས་པ་ འསྐོར་བ་ མཐོང་ ངོ་ །"

msgctxt "1b6fcf182dd24bc9bff239c893172ba2"
msgid "ཞེས་པ་␣ས་ གཉིས་པ་ དང༌ །"
msgstr "ཞེས་པ་␣ས་ གཉིས་པ་ དང༌ །"

msgctxt "5a58244af232482dbf98f48024e33b96"
msgid "དགོངས་འགྲེལ་ ལ་␣ས་"
msgstr "དགོངས་འགྲེལ་ ལ་␣ས་"

msgctxt "b031f7d878dc48e29da51e8acdd6fb64"
msgid ""
"དོན་དམ་ ཡང་དག་ འཕགས་ ཀྱིས་ བཅོམ་ལྡན་འདས་ ཀྱི་ དང་པོ་␣ར་ ཝཱ་ རཱ་ ཎ་ སཱིར་ "
"བསྐོར་བ་ དེ་ཡང་ བླ་ ན་ མཆིས་པ །"
msgstr ""
"དོན་དམ་ ཡང་དག་ འཕགས་ ཀྱིས་ བཅོམ་ལྡན་འདས་ ཀྱི་ དང་པོ་␣ར་ ཝཱ་ རཱ་ ཎ་ སཱིར་ "
"བསྐོར་བ་ དེ་ཡང་ བླ་ ན་ མཆིས་པ །"

msgctxt "9f11d2ebd86b4b23a7438ad52610c30c"
msgid "སྐབས་མཆིས་པ །"
msgstr "སྐབས་མཆིས་པ །"

msgctxt "83ed988591fd49c39633dff2ed8f5021"
msgid "དྲང་དོན་ རྩོད་གཞི་␣ར་ གྱུར་པ་ ལགས་ ལ །"
msgstr "དྲང་དོན་ རྩོད་གཞི་␣ར་ གྱུར་པ་ ལགས་ ལ །"

msgctxt "fc50b0bbd9ae477c9d575540a2105de0"
msgid "གཉིས་པ་ བྱ་རྒོད་ ཕུང་པོ་ རེ་␣ར་ བསྐོར་བ་␣འང་ དེ་བཞིན་ དང་ །"
msgstr "གཉིས་པ་ བྱ་རྒོད་ ཕུང་པོ་ རེ་␣ར་ བསྐོར་བ་␣འང་ དེ་བཞིན་ དང་ །"

msgctxt "11976e74674d4963b6f8e3c218c18979"
msgid "ད་ལྟར་ བསྐོར་བ་ འདི་ ནི་ སྐབས་ མ་ མཆིས་པ་ དང་ །"
msgstr "ད་ལྟར་ བསྐོར་བ་ འདི་ ནི་ སྐབས་ མ་ མཆིས་པ་ དང་ །"

msgctxt "bf364e6bc2bf43ea9f8ad03d3664a7ef"
msgid ""
"བླ་ ན་མ་ མཆིས་ སོགས་ ཀྱིས་ མཐའ་མ་␣ར་ བཞག་པ་ མདོ་ ལུང་ འདི་␣འི་ གནད་ ཀྱིས་ "
"གསུམ་ དུ་ ངེས་ སོ །"
msgstr ""
"བླ་ ན་མ་ མཆིས་ སོགས་ ཀྱིས་ མཐའ་མ་␣ར་ བཞག་པ་ མདོ་ ལུང་ འདི་␣འི་ གནད་ ཀྱིས་ "
"གསུམ་ དུ་ ངེས་ སོ །"

msgctxt "8ef24d7af96546529a3a7ad8fb987fc6"
msgid ""
"གཉིས་པ་ དོན་ གྱི་ གནད་ ཀྱིས་ སངས་རྒྱས་ ཀྱིས་ འཁོར་བ་ སྤོང་བ་␣འི་ ཐབས་ "
"མངོན་རྟོགས་ ཀྱི་ རིམ་པ་ རྒྱུད་ ལ་ དགོས་པ་␣ར་ གསུངས་པ་␣ས་"
msgstr ""
"གཉིས་པ་ དོན་ གྱི་ གནད་ ཀྱིས་ སངས་རྒྱས་ ཀྱིས་ འཁོར་བ་ སྤོང་བ་␣འི་ ཐབས་ "
"མངོན་རྟོགས་ ཀྱི་ རིམ་པ་ རྒྱུད་ ལ་ དགོས་པ་␣ར་ གསུངས་པ་␣ས་"

msgctxt "3da6d8f3ab3d4e278df4f63c78e918ee"
msgid "གང་ཟག་ གི་ རྒྱུད་ ལ་ རིམ་པ་␣འི་ ཚུལ་ གྱིས་ འབྱུང་ སྟེ་"
msgstr "གང་ཟག་ གི་ རྒྱུད་ ལ་ རིམ་པ་␣འི་ ཚུལ་ གྱིས་ འབྱུང་ སྟེ་"

msgctxt "583cf2bf7b6042aba8af24d5a632c24a"
msgid ""
"དེ་དོན་ སྒམ་པོ་པ་␣འི་ རྣལ་འབྱོར་ བཞི་␣ར་ འཁོར་ལོ་ བཞི་␣འི་ དོན་ དང་ "
"གཅིག་པ་␣ས་ གསུམ་ དུ་ ངེས་པ་␣འོ ། །"
msgstr ""
"དེ་དོན་ སྒམ་པོ་པ་␣འི་ རྣལ་འབྱོར་ བཞི་␣ར་ འཁོར་ལོ་ བཞི་␣འི་ དོན་ དང་ "
"གཅིག་པ་␣ས་ གསུམ་ དུ་ ངེས་པ་␣འོ ། །"

msgctxt "c82a9e7cb0564e9785df2bf3bd3e6649"
msgid ""
"འཁོར་ལོ་ གསུམ་ དོན་ མཐོ་དམན་ ཡོད་པ་ ཆེད་ དུ་ བརྗོད་ མཁན་ ཡང་ དེ་བཞིན་ ནོ ། །"
msgstr ""
"འཁོར་ལོ་ གསུམ་ དོན་ མཐོ་དམན་ ཡོད་པ་ ཆེད་ དུ་ བརྗོད་ མཁན་ ཡང་ དེ་བཞིན་ ནོ ། །"

msgctxt "b68dd586f90c4635a84c298c76f499bc"
msgid "དེས་ན་ གནས་དུས་ སོགས་ ཀྱིས་ མི་ ཕྱེད་ དེ །"
msgstr "དེས་ན་ གནས་དུས་ སོགས་ ཀྱིས་ མི་ ཕྱེད་ དེ །"

msgctxt "06f961a1e8914e058061bba175506b29"
msgid "ཝཱ་ རཱ་ ཎ་ སཱིར་ རྡོ་རྗེ་␣འི་ མཆུ་ སོགས་ དང༌ །"
msgstr "ཝཱ་ རཱ་ ཎ་ སཱིར་ རྡོ་རྗེ་␣འི་ མཆུ་ སོགས་ དང༌ །"

msgctxt "102bbdff85714f87a583a67b79b04f4f"
msgid ""
"རྒྱལ་པོ་␣འི་ ཁབ་ ཏུ་ བདེན་ བཞི །  མདོ་ བཟུང་བ་ སྙིང་པོ་ བསྟན་པ་ སོགས་ དང༌ །"
msgstr ""
"རྒྱལ་པོ་␣འི་ ཁབ་ ཏུ་ བདེན་ བཞི །  མདོ་ བཟུང་བ་ སྙིང་པོ་ བསྟན་པ་ སོགས་ དང༌ །"

msgctxt "ca646e15f7494e3d93cea521ebbd8381"
msgid "རྩ་ མཆོག་ ཏུ་ རབ་ བཟང་ ལ་ བདེན་ བཞི་ བསྟན་པ་␣འི་ ཕྱིར་ དང་ །"
msgstr "རྩ་ མཆོག་ ཏུ་ རབ་ བཟང་ ལ་ བདེན་ བཞི་ བསྟན་པ་␣འི་ ཕྱིར་ དང་ །"

msgctxt "4aa430c50534464fa86278da49c27beb"
msgid "གཉིས་པ་ དུས་ ཀྱིས་ ཀྱང་ མི་ ཕྱེད་ དེ །"
msgstr "གཉིས་པ་ དུས་ ཀྱིས་ ཀྱང་ མི་ ཕྱེད་ དེ །"

msgctxt "a3a53aaa64e144d197fa6797e8f69757"
msgid "དུས་ དང་པོ་␣ར་ ཡུམ་ གྱི་ ལྷུམས་ སུ་ ཐེག་ཆེན་ གསུང་པ་ དང༌ །"
msgstr "དུས་ དང་པོ་␣ར་ ཡུམ་ གྱི་ ལྷུམས་ སུ་ ཐེག་ཆེན་ གསུང་པ་ དང༌ །"

msgctxt "671d6f501e104a86b3e22948c63661f6"
msgid ""
"སངས་རྒྱས་ མ་ ཐག་ རྣམ་ འཇོམས་ སོ་␣ར་ འབྲད་ ཕལ་པོ་ ཆེ་␣འི་ དབུ་ སྟོད་ སོགས་ "
"དང༌ །"
msgstr ""
"སངས་རྒྱས་ མ་ ཐག་ རྣམ་ འཇོམས་ སོ་␣ར་ འབྲད་ ཕལ་པོ་ ཆེ་␣འི་ དབུ་ སྟོད་ སོགས་ "
"དང༌ །"

msgctxt "051952df9120469ebdf1c4ef9abe3765"
msgid "བར་པ་␣ར་ ཡང་ ནོར་ བཟང་ མི་ རྣམ་པ་␣ར་ སྡོང་པོ་ རྒྱན་ སོགས་ དང་ །"
msgstr "བར་པ་␣ར་ ཡང་ ནོར་ བཟང་ མི་ རྣམ་པ་␣ར་ སྡོང་པོ་ རྒྱན་ སོགས་ དང་ །"

msgctxt "f2d7fdb83f9d4dd8af7db2d41de5ab2c"
msgid "ཐ་མ་␣ར་ ལུང་ཞུ་བ་ སོགས་ གསུངས་པ་ དང་ །"
msgstr "ཐ་མ་␣ར་ ལུང་ཞུ་བ་ སོགས་ གསུངས་པ་ དང་ །"

msgctxt "75db77317a85428bac61602166a7de1a"
msgid "གསུམ་པ་ འཁོར་ གྱིས་ ཀྱང་ མི་ ཕྱེད་ དེ་"
msgstr "གསུམ་པ་ འཁོར་ གྱིས་ ཀྱང་ མི་ ཕྱེད་ དེ་"

msgctxt "5455f788fe3d49688e524cad7c8d3b28"
msgid ""
"དང་པོ་␣ར་ བྱམས་པ་ སོགས་ དང་ །  བར་ མཐའ་ གཉིས་ ལ་␣འང་ ལྔ་ སྡེ་ བཟང་པོ་ "
"ཡོད་པ་␣འི་ ཕྱིར་ རོ །"
msgstr ""
"དང་པོ་␣ར་ བྱམས་པ་ སོགས་ དང་ །  བར་ མཐའ་ གཉིས་ ལ་␣འང་ ལྔ་ སྡེ་ བཟང་པོ་ "
"ཡོད་པ་␣འི་ ཕྱིར་ རོ །"

msgctxt "eb3a81abb88b4deaad4c0c7598b3c625"
msgid "རྡོ་␣༽༽་␣ཚུལ་ དགུ་ འཛིན་པ་ ཁ་ གཅིག་ གིས །"
msgstr "རྡོ་␣༽༽་␣ཚུལ་ དགུ་ འཛིན་པ་ ཁ་ གཅིག་ གིས །"

msgctxt "1b0215ef17894fe5930e18d4fc00ceec"
msgid "དགག་ བྱེད་ ལ་ལུང་ རྣམ་འབྱེད་ སྒྲུབ་བྱེད་ ལ་ལུང་ གཞི །"
msgstr "དགག་ བྱེད་ ལ་ལུང་ རྣམ་འབྱེད་ སྒྲུབ་བྱེད་ ལ་ལུང་ གཞི །"

msgctxt "a0e1094ffc554b928f99845e6a2ccf3a"
msgid "ལུང་ ཕྲན་ ཚིག  །"
msgstr "ལུང་ ཕྲན་ ཚིག  །"

msgctxt "1083dc998b4546ca85a6b759cbd8e4dc"
msgid "ཐེ་ཚོམ་ གཅོད་པ་ ལ་ལུང་ ཞུ་བ་ སོགས་"
msgstr "ཐེ་ཚོམ་ གཅོད་པ་ ལ་ལུང་ ཞུ་བ་ སོགས་"

msgctxt "d55b80c3b3784e35a9a18146ff9b694e"
msgid ""
"དགག་སྒྲུབ་ ཐེ་ཚོམ་ གཅོད་པ་ གསུམ་ བརྗོད་དོན་ ཡིན་ གྱི་ བདེན་ བཞི་ བསྟན་པ་␣འི་"
" ཕྱིར །"
msgstr ""
"དགག་སྒྲུབ་ ཐེ་ཚོམ་ གཅོད་པ་ གསུམ་ བརྗོད་དོན་ ཡིན་ གྱི་ བདེན་ བཞི་ བསྟན་པ་␣འི་"
" ཕྱིར །"

msgctxt "f6925158987e416ba16335ada9541175"
msgid ""
"བདེན་ བཞི་ མངོན་པ་ ནས་ རྒྱས་པ་␣ར་ བསྟན་པ་␣ས་ མངོན་པ་␣འི་ སྡེ་སྣོད་ ཡིན་ ཟེར་"
" ལ །"
msgstr ""
"བདེན་ བཞི་ མངོན་པ་ ནས་ རྒྱས་པ་␣ར་ བསྟན་པ་␣ས་ མངོན་པ་␣འི་ སྡེ་སྣོད་ ཡིན་ ཟེར་"
" ལ །"

msgctxt "849ce347c67649538f20bd2d33c40d30"
msgid "འདི་␣ར་ ནི་ འདུལ་བ་␣འི་ སྡེ་སྣོད་ བདེན་ བཞི་␣འི་ ཆོས་འཁོར་ ཡིན་ ཏེ་"
msgstr "འདི་␣ར་ ནི་ འདུལ་བ་␣འི་ སྡེ་སྣོད་ བདེན་ བཞི་␣འི་ ཆོས་འཁོར་ ཡིན་ ཏེ་"

msgctxt "2408343d8072422c807b31cce2d61c8c"
msgid "ཉོན་མོངས་པ་ སེམས་ དང་ དེ་ དང་ རྗེས་སུ་ འབྲེལ་བ་ ལ་␣ས་ ཏེ་"
msgstr "ཉོན་མོངས་པ་ སེམས་ དང་ དེ་ དང་ རྗེས་སུ་ འབྲེལ་བ་ ལ་␣ས་ ཏེ་"

msgctxt "cf8e7503dd3947e798f851633aeeb366"
msgid "དེ་ གཉིས་ ལས་འབྲས་ བུ་སྡུག་ བསྔལ་ འབྱུང་བ་"
msgstr "དེ་ གཉིས་ ལས་འབྲས་ བུ་སྡུག་ བསྔལ་ འབྱུང་བ་"

msgctxt "bf08ec506fe64f229624e32073fb9b4d"
msgid ""
"འཁོར་བ་ རྒྱུ་འབྲས་ དགག་ བཅས་ སྤང་བྱ་ ལྡོག་པ་␣འི་ ཚུལ་ཁྲིམས་ ལུང་ རྣམ་འབྱེད་ "
"ཀྱིས་ བསྟན་པ་ ན་"
msgstr ""
"འཁོར་བ་ རྒྱུ་འབྲས་ དགག་ བཅས་ སྤང་བྱ་ ལྡོག་པ་␣འི་ ཚུལ་ཁྲིམས་ ལུང་ རྣམ་འབྱེད་ "
"ཀྱིས་ བསྟན་པ་ ན་"

msgctxt "d34ac3e101b74e94a8258c460105a6e7"
msgid "ཉིས་ བརྒྱ་ ལྔ་ བཅུ་ རྩ་ གསུམ་ སྡུག་བསྔལ་ ཤེས་པ །"
msgstr "ཉིས་ བརྒྱ་ ལྔ་ བཅུ་ རྩ་ གསུམ་ སྡུག་བསྔལ་ ཤེས་པ །"

msgctxt "5ca45a2d40bd4decacbc5432713db4e9"
msgid "ཀུན་འབྱུང་ སྤོང་བ་ དང༌ །"
msgstr "ཀུན་འབྱུང་ སྤོང་བ་ དང༌ །"

msgctxt "7bb475f33919465e81304ff9afbb7c06"
msgid "རྩ་བ་ བླ་མ་ ཡན་ལག་ འཕགས་ལམ་ བསྟེན་པ་␣ས་"
msgstr "རྩ་བ་ བླ་མ་ ཡན་ལག་ འཕགས་ལམ་ བསྟེན་པ་␣ས་"

msgctxt "6285e32feeca49608bd03c29acd4cf45"
