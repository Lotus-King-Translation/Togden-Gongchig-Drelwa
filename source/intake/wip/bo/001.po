"བསམ་གཏན་ ནགས་མེ་␣ས་ ཡང་ དང་ ཡང་ དུ་ ནི་ ཉོན་མོངས་ ཚང་ཚིང་ བསྲེག་པ་␣ར་ གྱུར་ "
"ན་ ཡང༌ ། །"
msgstr ""
"བསམ་གཏན་ ནགས་མེ་␣ས་ ཡང་ དང་ ཡང་ དུ་ ནི་ ཉོན་མོངས་ ཚང་ཚིང་ བསྲེག་པ་␣ར་ གྱུར་ "
"ན་ ཡང༌ ། །"

msgctxt "b62e893c47d649b6b8c4d813847976b3"
msgid "བདག་ ལྟ་␣འི་ རྩ་བ་ བརྟན་པོ་ མ་ སྤངས་པ་␣ས ། །"
msgstr "བདག་ ལྟ་␣འི་ རྩ་བ་ བརྟན་པོ་ མ་ སྤངས་པ་␣ས ། །"

msgctxt "b3dab9c1fdab420d9001e71592cdaf04"
msgid "ཆ་␣ར་ གྱིས་ བརླན་ བཞིན་ མོད་ ལ་ རབ་ཏུ་ སྐྱེ །"
msgstr "ཆ་␣ར་ གྱིས་ བརླན་ བཞིན་ མོད་ ལ་ རབ་ཏུ་ སྐྱེ །"

msgctxt "2ab37fe7642f44d881bb583ff1d983ab"
msgid "ཞེས་ དང༌ །"
msgstr "ཞེས་ དང༌ །"

msgctxt "1dd566196bda4e51a19627b07673fbf2"
msgid "མགོན་པོ་ ཕག་མོ་ གྲུ་པ་␣ས་ ཀྱང༌ ། །"
msgstr "མགོན་པོ་ ཕག་མོ་ གྲུ་པ་␣ས་ ཀྱང༌ ། །"

msgctxt "a310f32c68fe4de6a39d3d15132b519a"
msgid "བདེ་ དང་ གསལ་བ་␣འི་ རྒྱ་མཚོ་ རུ ། །"
msgstr "བདེ་ དང་ གསལ་བ་␣འི་ རྒྱ་མཚོ་ རུ ། །"

msgctxt "3e3a532e91be45478350d202801089aa"
msgid "ཞེན་ དང་ འཛིན་པ་␣འི་ ནོར་བུ་ གནས ། །"
msgstr "ཞེན་ དང་ འཛིན་པ་␣འི་ ནོར་བུ་ གནས ། །"

msgctxt "03666a5bc3da424eb90fde9968e3cdf3"
msgid "ནོར་བུ་ ལ་ མངོན་ཞེན་ སྐྱེ་ གྱུར་ ན ། །"
msgstr "ནོར་བུ་ ལ་ མངོན་ཞེན་ སྐྱེ་ གྱུར་ ན ། །"

msgctxt "52b91d0a12e545f793e3660d45df59b0"
msgid "དུག་སྦྲུལ་ ལྟ་བུ་␣འི་ དམྱལ་་ སྲུང་ གིས ། །"
msgstr "དུག་སྦྲུལ་ ལྟ་བུ་␣འི་ དམྱལ་་ སྲུང་ གིས ། །"

msgctxt "672cf41405ea4be5b0d935158fece978"
msgid "བདེ་བ་ ཆེན་པོ་␣འི་ སྲོག་ བཅད་ དེ་␣༑ ༑"
msgstr "བདེ་བ་ ཆེན་པོ་␣འི་ སྲོག་ བཅད་ དེ་␣༑ ༑"

msgctxt "ee9192783c9543ad9b956c537e10180c"
msgid "ཉམ་ང་ ཆེན་པོ་␣འི་ གཡང་ ལ་ བསྐུར །"
msgstr "ཉམ་ང་ ཆེན་པོ་␣འི་ གཡང་ ལ་ བསྐུར །"

msgctxt "120d4eb3b7cd4dc9bb8eabf8d53af51e"
msgid "ཞེས་པ་␣ས །"
msgstr "ཞེས་པ་␣ས །"

msgctxt "d898b65c33914d1cb8a3dc64cc593f2a"
msgid ""
"གསུམ་པོ་ དབྱེ་␣ར་ མེད་ ཆོས་དབྱིངས་ སུ་ རོ་ མཉམ་པ་ ཞིག་ དགོས་པ་␣ར་ སེམས་ ཤིང་"
" གཞན་ དུ་ སྐྱོན་མེད་ དུ་ བཤད་  ཀྱང་"
msgstr ""
"གསུམ་པོ་ དབྱེ་␣ར་ མེད་ ཆོས་དབྱིངས་ སུ་ རོ་ མཉམ་པ་ ཞིག་ དགོས་པ་␣ར་ སེམས་ ཤིང་"
" གཞན་ དུ་ སྐྱོན་མེད་ དུ་ བཤད་  ཀྱང་"

msgctxt "d3ac7195e1214a8abfa6a03ce6642939"
msgid ""
"བདེ་ གསལ་ སོགས་ སོ་སོ་␣ར་ འཛིན་པ་␣འི་ རྟོག་པ་ ལས་མ་ འདས་པ་␣ར་ དགོངས་པ་ ཡིན་ "
"ནམ་ མཉམ་ མོ །"
msgstr ""
"བདེ་ གསལ་ སོགས་ སོ་སོ་␣ར་ འཛིན་པ་␣འི་ རྟོག་པ་ ལས་མ་ འདས་པ་␣ར་ དགོངས་པ་ ཡིན་ "
"ནམ་ མཉམ་ མོ །"

msgctxt "e352944010024670884cf9160ee326e0"
msgid "རྡོ་␣༽༽  དཀྱིལ་འཁོར་ གྱི་ འཁོར་ལོ་ བདེ་མཆོག་ ལྟ་བུ་␣ར་ མཚོན་ ན་"
msgstr "རྡོ་␣༽༽  དཀྱིལ་འཁོར་ གྱི་ འཁོར་ལོ་ བདེ་མཆོག་ ལྟ་བུ་␣ར་ མཚོན་ ན་"

msgctxt "dccc513036844c4cbbae6622e30521da"
msgid ""
"ལོངས་སྐུ་ ཡུམ་ ཆོས་སྐུ་ ཡུལ་ ཉེར་ བཞི་ གནས་པ་␣འི་ ཐུགས་ གསུང་ སྐུ་ ཡི་ "
"འཁོར་ལོ་ དཔའ་བོ་ མཁའ་འགྲོ་ སྒོ་མཚམས་ ཀྱི་ ལྷ་མོ་ དང་ བཅས་པ་ སྤྲུལ་སྐུ་ སྟེ་"
msgstr ""
"ལོངས་སྐུ་ ཡུམ་ ཆོས་སྐུ་ ཡུལ་ ཉེར་ བཞི་ གནས་པ་␣འི་ ཐུགས་ གསུང་ སྐུ་ ཡི་ "
"འཁོར་ལོ་ དཔའ་བོ་ མཁའ་འགྲོ་ སྒོ་མཚམས་ ཀྱི་ ལྷ་མོ་ དང་ བཅས་པ་ སྤྲུལ་སྐུ་ སྟེ་"

msgctxt "bb50effddc5e46e6a823f615adbc755c"
msgid "དེ་ གསུམ་ ཐ་དད་ ཡིན་ ཟེར་ རོ །"
msgstr "དེ་ གསུམ་ ཐ་དད་ ཡིན་ ཟེར་ རོ །"

msgctxt "308ee389c1ee4dbbaa4e066f54c0d24c"
msgid "འདི་␣ར་ ནི་ སྐུ་གསུམ་པོ་ རེ་རེ་ ལ་ ཡང་ གཞན་ གཉིས་ཀ་ ཚང་ སྟེ་"
msgstr "འདི་␣ར་ ནི་ སྐུ་གསུམ་པོ་ རེ་རེ་ ལ་ ཡང་ གཞན་ གཉིས་ཀ་ ཚང་ སྟེ་"

msgctxt "01240107b5b440a98aaea75ee13eb72c"
msgid "དཀྱིལ་འཁོར་ གྱི་ དུར་ཁྲོད་ བརྒྱད་ དང་ བཅས་པ་"
msgstr "དཀྱིལ་འཁོར་ གྱི་ དུར་ཁྲོད་ བརྒྱད་ དང་ བཅས་པ་"

msgctxt "dd62d9fa70384c0888fd2336bb913321"
