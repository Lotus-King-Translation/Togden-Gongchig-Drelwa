msgctxt "ea5e20c6a9ad4f69a9faf38eb16c751d"
msgid "བུས་ མ་ བསད་པ་ གཉིས་ཀ་ གང་ཡིན་ ཡང་ དམྱལ་བ་␣ར་ ལྟུང་བ་ བཞིན་ ནོ །"
msgstr "བུས་ མ་ བསད་པ་ གཉིས་ཀ་ གང་ཡིན་ ཡང་ དམྱལ་བ་␣ར་ ལྟུང་བ་ བཞིན་ ནོ །"

msgctxt "e76d836edfc84575bf31a0d127386f7b"
msgid ""
"གསང་སྔགས་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ་␣འི་ ཚིག་རྐང་ ཉེར་ བརྒྱད་ ལྷན་ཐབས་ ཚིག་རྐང་"
" བཅུ་བདུན་ བཅས་ ཀྱི་ འགྲེལ་བཤད་ བྱེད་པ་␣འི་ སྐབས་ ཏེ་ ལྔ་པ་␣འོ །"
msgstr ""
"གསང་སྔགས་ གནད་བསྡུས་ ཏེ་ རྡོ་རྗེ་␣འི་ ཚིག་རྐང་ ཉེར་ བརྒྱད་ ལྷན་ཐབས་ ཚིག་རྐང་"
" བཅུ་བདུན་ བཅས་ ཀྱི་ འགྲེལ་བཤད་ བྱེད་པ་␣འི་ སྐབས་ ཏེ་ ལྔ་པ་␣འོ །"

msgctxt "f258aa77141b41cdbaab30aa674b39c1"
msgid "རྡོ་␣༽༽  འགའ་ཞིག་ ཆོས་ རྒྱུད་པ་ མེད་པ་␣འི་ ཉམས་མྱོང་ དང༌ །"
