msgctxt "8c2295dc3b364a00acd69ea1a427d31e"
msgid ""
"༄༅། ། ཐུབ་བསྟན་ དོན་ བརྒྱུད་ སྙིང་པོ་ མགོན་པོ་ འབྲི་གུང་པ་␣འི་ དམ་ཆོས་ "
"དགོངས་པ་ གཅིག་པ་␣འི་ རྣམ་བཤད་ བློ་ གས་␣ར་ དགའ་བ་␣འི་ རྣ་རྒྱན་ དབྱར་ གྱི་ "
"རྔ་སྒྲ་ ཞེས་ བྱ་བ་ བཞུགས་ སོ ། །"
msgstr ""
"༄༅། ། ཐུབ་བསྟན་ དོན་ བརྒྱུད་ སྙིང་པོ་ མགོན་པོ་ འབྲི་གུང་པ་␣འི་ དམ་ཆོས་ "
"དགོངས་པ་ གཅིག་པ་␣འི་ རྣམ་བཤད་ བློ་ གས་␣ར་ དགའ་བ་␣འི་ རྣ་རྒྱན་ དབྱར་ གྱི་ "
"རྔ་སྒྲ་ ཞེས་ བྱ་བ་ བཞུགས་ སོ ། །"

msgctxt "d040936945854546a7449761291d81dd"
msgid "༄༅། ། ན་མོ་ གུ་རུ་ རཏྣ་ ཤྲཱི་ ཡེ །"
msgstr "༄༅། ། ན་མོ་ གུ་རུ་ རཏྣ་ ཤྲཱི་ ཡེ །"

msgctxt "4290bd4a976e457096ba1a0bf96b4d12"
msgid ""
"སྣ་ཚོགས་ བསོད་ནམས་ འོ་མ་␣འི་ མཚོ་ ལ་ བརྩོན་འགྲུས་ སྐྱ་བ་␣ས་ བསྲུབས་པ་ ལ་␣ས "
"། །"
msgstr ""
"སྣ་ཚོགས་ བསོད་ནམས་ འོ་མ་␣འི་ མཚོ་ ལ་ བརྩོན་འགྲུས་ སྐྱ་བ་␣ས་ བསྲུབས་པ་ ལ་␣ས "
"། །"

msgctxt "d6fc2fb4f2b849f68fcc59331d89d07b"
msgid ""
"གཟུགས་སྐུ་␣འི་ རྩི་བཅུད་ མངོན་པར་ འཁྲུངས་ ནས་ སྤང་ རྟོག་ མཐ་␣ར་ ཕྱིན་ རྫོགས་"
" སངས་རྒྱས ། །"
msgstr ""
"གཟུགས་སྐུ་␣འི་ རྩི་བཅུད་ མངོན་པར་ འཁྲུངས་ ནས་ སྤང་ རྟོག་ མཐ་␣ར་ ཕྱིན་ རྫོགས་"
" སངས་རྒྱས ། །"

msgctxt "c18652eda3f642e296f89c2c81a70044"
msgid ""
"དེ་␣ས་ གསུངས་ འགོག་ ལམ་ དམ་པ་␣འི་ ཆོས་ དང་ རིག་ གྲོལ་ དབང་ཕྱུག་ དགེ་འདུན་ ལ "
"། །"
msgstr ""
"དེ་␣ས་ གསུངས་ འགོག་ ལམ་ དམ་པ་␣འི་ ཆོས་ དང་ རིག་ གྲོལ་ དབང་ཕྱུག་ དགེ་འདུན་ ལ "
"། །"

msgctxt "14f82f31e10840d893e661b74bff847d"
msgid ""
"བྱང་ཆུབ་ བར་ དུ་ སྐྱབས་གནས་ བསླུ་མེད་ དཀོན་མཆོག་ རྣམ་ གསུམ་ གཙུག་ ན་ རྒྱལ "
"། །"
msgstr ""
"བྱང་ཆུབ་ བར་ དུ་ སྐྱབས་གནས་ བསླུ་མེད་ དཀོན་མཆོག་ རྣམ་ གསུམ་ གཙུག་ ན་ རྒྱལ "
"། །"

msgctxt "fcfd50ffdc63425d86c403f62a4700d8"
msgid ""
"༄༅། ། འགྲོ་ ཀུན་ མ་རིག་ ཞགས་པ་␣ས་ བཅིངས་ རྣམས་ རྣམ་དཔྱོད་ རིག་པ་␣འི་ རལ་གྲི་"
" ཡིས ། །"
msgstr ""
"༄༅། ། འགྲོ་ ཀུན་ མ་རིག་ ཞགས་པ་␣ས་ བཅིངས་ རྣམས་ རྣམ་དཔྱོད་ རིག་པ་␣འི་ རལ་གྲི་"
" ཡིས ། །"

msgctxt "f8e41334c82a4c5c9142a06131e4242d"
msgid ""
"བསྐྲལ་ ནས་ བདེ་བ་␣འི་ གནས་ ལ་ དབྱུང་ མཛད་ ཇི་སྙེད་ མཁྱེན་པ་␣འི་ པོ་ཏི་ བསྣམས"
" ། །"
msgstr ""
"བསྐྲལ་ ནས་ བདེ་བ་␣འི་ གནས་ ལ་ དབྱུང་ མཛད་ ཇི་སྙེད་ མཁྱེན་པ་␣འི་ པོ་ཏི་ བསྣམས"
" ། །"

msgctxt "dba99aa6133246239050aaace1ef7d47"
msgid ""
"རྒྱལ་བ་ ཀུན་ གྱི་ མཁྱེན་པ་␣འི་ མངའ་བདག་ འཇམ་དཔལ་ དཔའ་བོ་ ཁྱེད་ མིན་ སུ ། །"
msgstr ""
"རྒྱལ་བ་ ཀུན་ གྱི་ མཁྱེན་པ་␣འི་ མངའ་བདག་ འཇམ་དཔལ་ དཔའ་བོ་ ཁྱེད་ མིན་ སུ ། །"

msgctxt "2de009ff09b14b68af80ef9d5c752f62"
msgid ""
"བདག་ བློ་ དད་པ་␣འི་ ལན་ བརྒྱ་␣ར་ བསྟོད་ ནས་ མི་ འབྲལ་ སྤྱི་བོ་␣འི་ རྒྱན་ དུ་"
" མཆོད ། །"
msgstr ""
"བདག་ བློ་ དད་པ་␣འི་ ལན་ བརྒྱ་␣ར་ བསྟོད་ ནས་ མི་ འབྲལ་ སྤྱི་བོ་␣འི་ རྒྱན་ དུ་"
" མཆོད ། །"

msgctxt "2cd5629445c54c12b336b9c4efb174ee"
msgid ""
"སྟོན་པ་␣ས་ ལུང་བསྟན་ གངས་ཅན་ བྱང་ཕྱོགས་ འབྲི་ ཐེལ་ རྡོར་ གདན་ གཉིས་ པ་རུ ། །"
msgstr ""
"སྟོན་པ་␣ས་ ལུང་བསྟན་ གངས་ཅན་ བྱང་ཕྱོགས་ འབྲི་ ཐེལ་ རྡོར་ གདན་ གཉིས་ པ་རུ ། །"

msgctxt "c4296bc4214348c58ff1bfba940f5bb7"
msgid ""
"ཟབ་མོ་ ལྟ་བ་␣འི་ ཤིང་རྟ་␣འི་ རྣམ་ རོལ་ ཀླུ་སྒྲུབ་ གཉིས་པ་ རཏྣ་ ཤྲཱི ། །"
msgstr ""
"ཟབ་མོ་ ལྟ་བ་␣འི་ ཤིང་རྟ་␣འི་ རྣམ་ རོལ་ ཀླུ་སྒྲུབ་ གཉིས་པ་ རཏྣ་ ཤྲཱི ། །"

msgctxt "19f40658438a4557b8f8cfabdb6498c2"
msgid ""
"ཆོས་ ཀུན་ གཤིས་ བབ་ རྟེན་འབྲེལ་ མངོན་ བསྒྱུར་ རྩེ་གཅིག་ སྤྲོས་བྲལ་ རོ་ གཅིག་"
" དང༌ །"
msgstr ""
"ཆོས་ ཀུན་ གཤིས་ བབ་ རྟེན་འབྲེལ་ མངོན་ བསྒྱུར་ རྩེ་གཅིག་ སྤྲོས་བྲལ་ རོ་ གཅིག་"
" དང༌ །"

msgctxt "0ca08b2082474d7f987a9bec6148b53c"
msgid ""
"སྒོམ་ མེད་ ལྟ་བ་␣འི་ ཡང་རྩེ་␣ར་ སོན་པ་ ཆོས་རྗེ་ འཇིག་རྟེན་ མགོན་ ལ་ འདུད ། །"
msgstr ""
"སྒོམ་ མེད་ ལྟ་བ་␣འི་ ཡང་རྩེ་␣ར་ སོན་པ་ ཆོས་རྗེ་ འཇིག་རྟེན་ མགོན་ ལ་ འདུད ། །"

msgctxt "685e3cb30d9345a18b290e5eae7d51c7"
msgid "འཕགས་ཡུལ་ གྲུབ་ཆེན་ ས་ར་ ཧ་ དང་ གངས་ཅན་ ཤེར་ འབྱུང་ རཏྣའི་ མཚན ། །"
msgstr "འཕགས་ཡུལ་ གྲུབ་ཆེན་ ས་ར་ ཧ་ དང་ གངས་ཅན་ ཤེར་ འབྱུང་ རཏྣའི་ མཚན ། །"

msgctxt "fff385220c774be1a4a3d100c7883363"
msgid ""
"སྤྲུལ་པ་␣འི་ སྐུ་ མཆོག་ བཅུ་ཕྲག་ རིག་གནས་ རྒྱུད་སྡེ་ རྒྱ་མཚོ་␣འི་ དོན་ ལ་ "
"མཁས ། །"
msgstr ""
"སྤྲུལ་པ་␣འི་ སྐུ་ མཆོག་ བཅུ་ཕྲག་ རིག་གནས་ རྒྱུད་སྡེ་ རྒྱ་མཚོ་␣འི་ དོན་ ལ་ "
"མཁས ། །"

msgctxt "5dfac5b6401e4c289ddb4a2fb0487996"
msgid ""
"འཇམ་པ་␣འི་ དབྱངས་ དང་ གཉིས་ སུ་ མེད་པ་ རྒྱལ་དབང་ རིག་འཛིན་ ཆོས་ ཀྱི་ གྲགས "
"། །"
msgstr ""
"འཇམ་པ་␣འི་ དབྱངས་ དང་ གཉིས་ སུ་ མེད་པ་ རྒྱལ་དབང་ རིག་འཛིན་ ཆོས་ ཀྱི་ གྲགས "
"། །"

msgctxt "ed825d777dda45bab84ffd810bb20ef3"
msgid ""
"ཐུགས་རྗེ་␣ས་ རྗེས་བཟུང་ བདག་ ཡིད་ དྭངས་ བས་ དྲིན་ཅན་ བླ་མ་␣ར་ ཕྱག་ བགྱི་␣འོ "
"། །"
msgstr ""
"ཐུགས་རྗེ་␣ས་ རྗེས་བཟུང་ བདག་ ཡིད་ དྭངས་ བས་ དྲིན་ཅན་ བླ་མ་␣ར་ ཕྱག་ བགྱི་␣འོ "
"། །"

msgctxt "76257ff95d6047bcb857ccb6d3b3886c"
msgid "སྟོན་པ་␣ས་ གསུང་པ་␣འི་ མདོ་སྔགས་ ཀྱི ། །"
msgstr "སྟོན་པ་␣ས་ གསུང་པ་␣འི་ མདོ་སྔགས་ ཀྱི ། །"

msgctxt "57b3912effb8465682c9a4aa074f5d87"
msgid "དོན་ རྣམས་ མ་ ནོར་ གོ་ བདེ་␣འི་ ཕྱིཪ ། །"
msgstr "དོན་ རྣམས་ མ་ ནོར་ གོ་ བདེ་␣འི་ ཕྱིཪ ། །"

msgctxt "8313b0559b28465bab4be9807dc65180"
msgid "རྒྱལ་མཆོག་ འབྲི་གུང་ རིན་ཆེན་ གྱི ། །"
msgstr "རྒྱལ་མཆོག་ འབྲི་གུང་ རིན་ཆེན་ གྱི ། །"

msgctxt "4eb33c5771444f16ba9a3c6d376380e1"
msgid "གསུངས་པ་␣འི་ ཁྱད་ཆོས་ དགོངས་པ་ གཅིག  །"
