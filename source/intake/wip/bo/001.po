"ཁྱིམ་བདག་ གཙོ་བོ་␣འི་ བུ་ གྲགས་པ་ ཁྱིམ་པ་␣འི་ ཆ་བྱད་ དུ་ འདུག་ བཞིན་པ་␣ར་ "
"དགྲ་བཅོམ་པ་ ཐོབ་ ནས་"
msgstr ""
"ཁྱིམ་བདག་ གཙོ་བོ་␣འི་ བུ་ གྲགས་པ་ ཁྱིམ་པ་␣འི་ ཆ་བྱད་ དུ་ འདུག་ བཞིན་པ་␣ར་ "
"དགྲ་བཅོམ་པ་ ཐོབ་ ནས་"

msgctxt "9256beeb20c34de9b7cd0f43dfbc1c6e"
msgid "ཕྱིས་ རབ་ཏུ་ བྱུང་བ་ ལྟ་བུ་ སྟེ །"
msgstr "ཕྱིས་ རབ་ཏུ་ བྱུང་བ་ ལྟ་བུ་ སྟེ །"

msgctxt "ad36e34ce621453d90f00d00e5c60fce"
msgid "དབྱེ་ ན་ གཞི་ ལ་␣ས །"
msgstr "དབྱེ་ ན་ གཞི་ ལ་␣ས །"

msgctxt "9df096dfb8cb4bad933549f72a5bcc94"
msgid "རྒྱན་ གྱི་ རྒྱན་ བཞིན་ དུ་ ནི་ སོགས་ དང །"
msgstr "རྒྱན་ གྱི་ རྒྱན་ བཞིན་ དུ་ ནི་ སོགས་ དང །"

msgctxt "61e13dc317474dcaadda4455a4dce6e0"
msgid "སྡུད་པ་ ལ་␣ས །"
msgstr "སྡུད་པ་ ལ་␣ས །"

msgctxt "cb0bd7aba9fb4616b9cdf28c6740f454"
msgid "སྦྱིན་པ་ སྦྱིན་པ་␣འི་ སྔོན་ དུ་ འགྲོ་བ་ ཤེས་རབ་ སྟེ །"
msgstr "སྦྱིན་པ་ སྦྱིན་པ་␣འི་ སྔོན་ དུ་ འགྲོ་བ་ ཤེས་རབ་ སྟེ །"

msgctxt "7f5e8ee0fe2f4bcb852a3e4a15ff3aaf"
msgid "སོགས་ གསུངས་པ་␣ས །"
msgstr "སོགས་ གསུངས་པ་␣ས །"

msgctxt "2309f63bec6a4d1bad842450064e453d"
msgid "ཤེས་རབ་ བསླབས་པ་ ཐོག་མ་␣ར་ འགྲོ་བ་␣འང་ ཡོད་ དོ །"
msgstr "ཤེས་རབ་ བསླབས་པ་ ཐོག་མ་␣ར་ འགྲོ་བ་␣འང་ ཡོད་ དོ །"

msgctxt "98984ddb0aff45898515166ce12f6f7d"
msgid ""
"རྡོ་␣༽༽  མདོ་སྔགས་ ལམ་ གྱི་ རིམ་པ་ སྔགས་ ལ་ རིམ་ ལྔ་ སྦྱོར་ དྲུག་ སོགས་ དང་ "
"མཚན་ཉིད་ རིམ་པ་ གསུམ་ ཡོད་པ་␣ས་"
msgstr ""
"རྡོ་␣༽༽  མདོ་སྔགས་ ལམ་ གྱི་ རིམ་པ་ སྔགས་ ལ་ རིམ་ ལྔ་ སྦྱོར་ དྲུག་ སོགས་ དང་ "
"མཚན་ཉིད་ རིམ་པ་ གསུམ་ ཡོད་པ་␣ས་"

msgctxt "fe8eed9318864f5f9d963222f3ec1119"
msgid ""
"སྔོན་ དུ་ འཆི་བ །  མི་རྟག་པ །  ལ་␣ས་ རྒྱུ་འབྲས །  འཁོར་བ་␣འི་ ཉེས་དམིགས །  "
"བསྐྱེད་རིམ་ རྣམས་ ལོ་ བཅུ་གཉིས་ རེ་ བསྒོམས་ ནས །"
msgstr ""
"སྔོན་ དུ་ འཆི་བ །  མི་རྟག་པ །  ལ་␣ས་ རྒྱུ་འབྲས །  འཁོར་བ་␣འི་ ཉེས་དམིགས །  "
"བསྐྱེད་རིམ་ རྣམས་ ལོ་ བཅུ་གཉིས་ རེ་ བསྒོམས་ ནས །"

msgctxt "f966703d6d4743d1bd4a56a7f3510610"
msgid "དེ་ རྗེས་ བཅུ་གཉིས་ རྫོགས་རིམ་ བསྒོམ་པ་ ཡིན་"
msgstr "དེ་ རྗེས་ བཅུ་གཉིས་ རྫོགས་རིམ་ བསྒོམ་པ་ ཡིན་"

msgctxt "46ab46b1cb9a4346bfae1384b369fd01"
msgid "ཅེས་ བཀའ་ གདམས་པ་ འགའ་ཞིག་ གིས་ ཟེར་ རོ ། །"
msgstr "ཅེས་ བཀའ་ གདམས་པ་ འགའ་ཞིག་ གིས་ ཟེར་ རོ ། །"

msgctxt "199898febca349cba3178f367930f007"
msgid ""
"འདི་␣ར་ ནི་ ལམ་རིམ་ ཐམས་ཅད་ ཐུན་ གཅིག་ གི་ སྟེང་ དུའང་ ཉམས་ སུ་ ལེན་ དགོས་ "
"ཏེ །"
msgstr ""
"འདི་␣ར་ ནི་ ལམ་རིམ་ ཐམས་ཅད་ ཐུན་ གཅིག་ གི་ སྟེང་ དུའང་ ཉམས་ སུ་ ལེན་ དགོས་ "
"ཏེ །"

msgctxt "b2127b5d01824b088db9fbb6ec0b694e"
msgid "སྔ་ཐུན་ དང་པོ་␣ར་ མི་རྟག་པ་ ཐུན་ གཅིག་ མ་ བསྒོམ་ ན་"
msgstr "སྔ་ཐུན་ དང་པོ་␣ར་ མི་རྟག་པ་ ཐུན་ གཅིག་ མ་ བསྒོམ་ ན་"

msgctxt "75c74de74ce24e179de5bbf29d209873"
msgid "འཇིག་རྟེན་ རང་ གར་ འཁྱམས་ འགྲོ་བ་␣འི་ ཕྱིར་ དང༌ །"
msgstr "འཇིག་རྟེན་ རང་ གར་ འཁྱམས་ འགྲོ་བ་␣འི་ ཕྱིར་ དང༌ །"

msgctxt "0b87bc3c28344a2794a8a99ef5e39f5d"
msgid ""
"དེ་ རྗེས་ ལ་␣ས་ རྒྱུ་འབྲས་ འཁོར་བ་␣འི་ ཉེས་དམིགས་ ཐུན་ གཅིག་ མ སྒོམ་ ན་"
msgstr ""
"དེ་ རྗེས་ ལ་␣ས་ རྒྱུ་འབྲས་ འཁོར་བ་␣འི་ ཉེས་དམིགས་ ཐུན་ གཅིག་ མ སྒོམ་ ན་"

msgctxt "f1826f9406284b16b9e4e1744e8f6cfa"
msgid "ཉེས་པ་ ལ་␣ས་ བཙན་པ་␣ར་ མི་འགྱུར་བ་␣འི་ ཕྱིར་ དང །"
