msgid "འདི་␣ར་ རྡོ་རྗེ་ ཐེག་པ་␣འི་ ལམ་རིམ་ གྱི་ བསླབ་པ་"
msgstr "འདི་␣ར་ རྡོ་རྗེ་ ཐེག་པ་␣འི་ ལམ་རིམ་ གྱི་ བསླབ་པ་"

msgctxt "0ba821a356234998be9ea79e49282795"
msgid ""
"དེ་ གསུམ་ ཀ་␣འི་ གང་ཟག་ ཆོས་ འབྲས་བུ་ སོགས་ བཟང་ངན་ བསལ་ བཞག་ མེད་པ་␣ས་ "
"ཐམས་ཅད་ དགོས་ ཏེ །"
msgstr ""
"དེ་ གསུམ་ ཀ་␣འི་ གང་ཟག་ ཆོས་ འབྲས་བུ་ སོགས་ བཟང་ངན་ བསལ་ བཞག་ མེད་པ་␣ས་ "
"ཐམས་ཅད་ དགོས་ ཏེ །"

msgctxt "3c9cdc13046e487a99a46d63babf8bd4"
msgid ""
"གང་ཟག་ གཅིག་ སངས་རྒྱས་པ་␣འི་ རྒྱུ་རྐྱེན་ ཐབས་ ཀྱི་ རིམ་པ་ ཡིན་པ་␣འི་ ཕྱིར །"
msgstr ""
"གང་ཟག་ གཅིག་ སངས་རྒྱས་པ་␣འི་ རྒྱུ་རྐྱེན་ ཐབས་ ཀྱི་ རིམ་པ་ ཡིན་པ་␣འི་ ཕྱིར །"

msgctxt "d490c9f4738b4c3eb21762e1c2f81e1d"
msgid "དཔེར་ན་ རྒྱལ་པོ་ མཁས་པ་␣ས་ ཁྲིམས་ འཆའ་བ་ བཞིན་ ནོ ། །"
msgstr "དཔེར་ན་ རྒྱལ་པོ་ མཁས་པ་␣ས་ ཁྲིམས་ འཆའ་བ་ བཞིན་ ནོ ། །"

msgctxt "784be05a26aa48d69b0543e8e28b9d87"
msgid "དེ་ལྟར་ ཡང་ བརྟག་ གཉིས་ ལ་␣ས །"
msgstr "དེ་ལྟར་ ཡང་ བརྟག་ གཉིས་ ལ་␣ས །"

msgctxt "1ddf1fff57d445168426a2db538027d5"
msgid "དང་པོ་ གསོ་སྦྱོང་ སྦྱིན་པ་␣ར་ བྱ །"
msgstr "དང་པོ་ གསོ་སྦྱོང་ སྦྱིན་པ་␣ར་ བྱ །"

msgctxt "27f85bbc16b64538a753031d2b55d5a9"
msgid "སོགས་ གསུངས་པ་␣ས །"
msgstr "སོགས་ གསུངས་པ་␣ས །"

msgctxt "69f86934696f4d34813dca3134f49660"
msgid ""
"སྔགས་སྡོམ་ མན་ཆད་ ལ་ བསླབ་པ་ གསུམ་ ལམ་རིམ་ སྤྱི་ཁྱབ་ ཏུ་ དགོས་པ་ ཁོ་ན་ ཡིན་ "
"ནོ །"
msgstr ""
"སྔགས་སྡོམ་ མན་ཆད་ ལ་ བསླབ་པ་ གསུམ་ ལམ་རིམ་ སྤྱི་ཁྱབ་ ཏུ་ དགོས་པ་ ཁོ་ན་ ཡིན་ "
"ནོ །"

msgctxt "9c52b8c017284ba1bfcc263f44958d84"
msgid "ལྷན་␣༽༽  སོ་ བྱང་ སྔགས་ གསུམ་ ལམ་ མི་ གཅིག་པ་ ཐ་དད་ ཡིན་ ཟེར་ ཡང༌ །"
