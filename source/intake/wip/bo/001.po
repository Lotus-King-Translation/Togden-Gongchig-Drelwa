msgctxt "5ee56f4f035c4fae9c10ba10796b9f15"
msgid ""
"ལྷ་ དང་ བཅས་པ་␣འི་ འཇིག་རྟེན་ ན་ སུ་␣ས་ ཀྱང་ རྒོལ་བ་ མེད་པ་␣འི་ ཕྱིར་ དང་"
msgstr ""
"ལྷ་ དང་ བཅས་པ་␣འི་ འཇིག་རྟེན་ ན་ སུ་␣ས་ ཀྱང་ རྒོལ་བ་ མེད་པ་␣འི་ ཕྱིར་ དང་"

msgctxt "a38541fbf9a340c68aaf1cd18310df95"
msgid ""
"རྡོ་རྗེ་ འཆང་ གི་ རྒྱུད་ དཀྲུགས་ ལུང་ བཅུ་␣ས་ མན་ངག་ གབ་པ་ དང་ མཐའ་ དྲུག་ "
"ལ་␣ས་"
msgstr ""
"རྡོ་རྗེ་ འཆང་ གི་ རྒྱུད་ དཀྲུགས་ ལུང་ བཅུ་␣ས་ མན་ངག་ གབ་པ་ དང་ མཐའ་ དྲུག་ "
"ལ་␣ས་"

msgctxt "9f9cebb3022948f49aaf8f3aec7da58d"
msgid "དགོངས་པ་ ཅན་ དང་ སྒྲ་ ཇི་བཞིན་ མ་ཡིན་པ་ དང༌ །"
msgstr "དགོངས་པ་ ཅན་ དང་ སྒྲ་ ཇི་བཞིན་ མ་ཡིན་པ་ དང༌ །"

msgctxt "82b76224dcf14f1aa85fa55f1d2940ed"
