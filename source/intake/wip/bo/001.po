msgstr "དེ་ ལ་ བྱེ་བྲག་ སྨྲ་བ་ གྲག་ ཅེས་ སོགས་ ཀྱི་ གསལ་ ལོ །"

msgctxt "1f4c800fc9cf40d5947d8d16ea18f4fe"
msgid "༈  ལྷན་␣༽༽  གཞན་དག་ ན་རེ །"
msgstr "༈  ལྷན་␣༽༽  གཞན་དག་ ན་རེ །"

msgctxt "9f8b8ec2695b4dfb8d3a380296069376"
msgid "གསུང་རབ་ ཡན་ལག་ བཅུ་གཉིས་ སོ་སོ་␣ར་ མ་ འདྲེས་པ་ ཐ་དད་ ཡིན་ ཟེར །"
msgstr "གསུང་རབ་ ཡན་ལག་ བཅུ་གཉིས་ སོ་སོ་␣ར་ མ་ འདྲེས་པ་ ཐ་དད་ ཡིན་ ཟེར །"

msgctxt "225cd889d9bb4c72be67579b9107c62f"
msgid ""
"འདི་␣ར་ ནི །  སྡེ་སྣོད་ རེ་རེ་ ལ་ ཡང་ གསུང་རབ་ བཅུ་གཉིས་པོ་ འདི་རིགས་ སུ་ "
"ཚང་ སྟེ་ ཕལ་ཆེན་ ལྟ་བུ་␣འོ ། །"
msgstr ""
"འདི་␣ར་ ནི །  སྡེ་སྣོད་ རེ་རེ་ ལ་ ཡང་ གསུང་རབ་ བཅུ་གཉིས་པོ་ འདི་རིགས་ སུ་ "
"ཚང་ སྟེ་ ཕལ་ཆེན་ ལྟ་བུ་␣འོ ། །"

msgctxt "1c74da5b8b3c410cb1c2403a2cff470e"
msgid "མདོ་སྡེ་ དབྱངས་ བསྙད་ ལུང་བསྟན་ ཚིགས་བཅད་ ཆེད་བརྗོད་"
msgstr "མདོ་སྡེ་ དབྱངས་ བསྙད་ ལུང་བསྟན་ ཚིགས་བཅད་ ཆེད་བརྗོད་"

msgctxt "132502a2e1a9492dae8a2d310798d2d4"
msgid "གླེང་ གཞི་ རྟོགས་བརྗོད་ དེ་ལྟར་ བྱུང་"
msgstr "གླེང་ གཞི་ རྟོགས་བརྗོད་ དེ་ལྟར་ བྱུང་"

msgctxt "26c564578e1a4803a09e981035a39c73"
msgid "སྐྱེས་ རབ་ ཤིན་ཏུ་ རྒྱས་པ་ རྨད་བྱུང་ གཏན་ དབབ་ བཅུ་གཉིས་ ཏེ་ །"
msgstr "སྐྱེས་ རབ་ ཤིན་ཏུ་ རྒྱས་པ་ རྨད་བྱུང་ གཏན་ དབབ་ བཅུ་གཉིས་ ཏེ་ །"

msgctxt "534b256f547a47f59d7d53dab3ceacff"
msgid "དང་པོ་ ལྔ་ ཉན་ཐོས་ ཀྱི་ མདོ་སྡེ་"
msgstr "དང་པོ་ ལྔ་ ཉན་ཐོས་ ཀྱི་ མདོ་སྡེ་"

msgctxt "22b9a81241da476288eb5ce2fd2149a9"
