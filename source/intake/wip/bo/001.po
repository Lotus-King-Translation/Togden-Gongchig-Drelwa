msgctxt "fb9cd9bd1e9943e0a848ec862359f732"
msgid ""
"སྒོ་གསུམ་ རྡོ་རྗེ་ གསུམ་ ལ་␣ས་ ནམ་ཡང་ མི་འདའ་ བར་ བྱེད་པ་ རྡོ་རྗེ་ འཛིན་པ་ "
"ཟེར །"
msgstr ""
"སྒོ་གསུམ་ རྡོ་རྗེ་ གསུམ་ ལ་␣ས་ ནམ་ཡང་ མི་འདའ་ བར་ བྱེད་པ་ རྡོ་རྗེ་ འཛིན་པ་ "
"ཟེར །"

msgctxt "96b3a605f5154a1fac0b685ff2218804"
msgid ""
"དེ་ ལ་ བརྟེན་ ནས་ སྒོ་གསུམ་ དབྱེ་␣ར་ མེད་ གཉིས་ སུ་ མེད་པ་␣འི་ རྡོ་རྗེ་ "
"མི་ཕྱེད་པ་"
msgstr ""
"དེ་ ལ་ བརྟེན་ ནས་ སྒོ་གསུམ་ དབྱེ་␣ར་ མེད་ གཉིས་ སུ་ མེད་པ་␣འི་ རྡོ་རྗེ་ "
"མི་ཕྱེད་པ་"

msgctxt "b43eb9b9526643379349d4252f282769"
