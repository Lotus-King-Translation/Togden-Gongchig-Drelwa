msgctxt "841c1eb1de0448e3b1151b49717fbc87"
msgid "མཐ་␣ར་ རྡོ་ཏིང་ སོགས་ ཐ་དད་ ཀྱིས་ བགྲོད་ ནས་"
msgstr "མཐ་␣ར་ རྡོ་ཏིང་ སོགས་ ཐ་དད་ ཀྱིས་ བགྲོད་ ནས་"

msgctxt "c46e974c8c02430cb1e58db68f555de2"
msgid "གོང་མ་ རྟོགས་ ཚེ་ འོག་མ་ འདོར་བ་ ཡིན་ ཟེར་ ཡང༌ །"
msgstr "གོང་མ་ རྟོགས་ ཚེ་ འོག་མ་ འདོར་བ་ ཡིན་ ཟེར་ ཡང༌ །"

msgctxt "c660bd703f4e46218cec04ff2432b8e0"
msgid ""
"འདི་␣ར་ ནི་ མངོན་རྟོགས་ མཐོང་ལམ་ གྱི་ བདེན་པ་ གཅིག་ ཁོ་ན་␣འི་ ངོ་བོ་ དག་ "
"གིས་ ས་ལམ་ མཐར་ཐུག་ ཚུན་ཆད་ མ་ལུས་པ་ བགྲོད་ དེ་"
msgstr ""
"འདི་␣ར་ ནི་ མངོན་རྟོགས་ མཐོང་ལམ་ གྱི་ བདེན་པ་ གཅིག་ ཁོ་ན་␣འི་ ངོ་བོ་ དག་ "
"གིས་ ས་ལམ་ མཐར་ཐུག་ ཚུན་ཆད་ མ་ལུས་པ་ བགྲོད་ དེ་"

msgctxt "4046f33af3684f07b1867fbaaf9183f0"
