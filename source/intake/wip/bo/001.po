msgctxt "4f7c738848424662a7843ccb7aeba431"
msgid ""
"ཕྱི་ རྒྱུ་ས་ བོན་ རྐྱེན་ འབྱུང་ ལྔ་ དུས་ ཀྱི་ འགྱུར་བ་ དྲུག་ ཚོགས་པ་␣ས་ "
"འབྲས་བུ་འབྱུང་བ་ དང༌ །"
msgstr ""
"ཕྱི་ རྒྱུ་ས་ བོན་ རྐྱེན་ འབྱུང་ ལྔ་ དུས་ ཀྱི་ འགྱུར་བ་ དྲུག་ ཚོགས་པ་␣ས་ "
"འབྲས་བུ་འབྱུང་བ་ དང༌ །"

msgctxt "7c6dbf5aaebf48b1a50c3c888f4d9b1a"
msgid ""
"ནང་ རྒྱུ་མ་ རིག་པ་ རྐྱེན་ ཁམས་ དྲུག་ ལ་ བརྟེན་ ནས་ རྒ་ཤི་␣འི་ བར་ "
"ལུགས་འབྱུང་ དང་ དེ་ ལྡོག་པ་ ལུགས་ལྡོག་ སྟེ་"
msgstr ""
"ནང་ རྒྱུ་མ་ རིག་པ་ རྐྱེན་ ཁམས་ དྲུག་ ལ་ བརྟེན་ ནས་ རྒ་ཤི་␣འི་ བར་ "
"ལུགས་འབྱུང་ དང་ དེ་ ལྡོག་པ་ ལུགས་ལྡོག་ སྟེ་"

msgctxt "40cef5ffdc7b44e796d22ac5e61e2db7"
msgid "དེ་ གཉིས་ བདག་མེད་ བཞིན་ དུ་ འབྲས་བུ་འབྱུང་ ཞིང་"
msgstr "དེ་ གཉིས་ བདག་མེད་ བཞིན་ དུ་ འབྲས་བུ་འབྱུང་ ཞིང་"

msgctxt "f738306a844849dba221f6712f272cf7"
msgid "རྟག་ཆད་ དང་ བྲལ་བ་␣ས་ རྟེན་འབྲེལ་ མདུང་ ཁྱིམ་ ལྟ་བུ་ སྟེ་"
msgstr "རྟག་ཆད་ དང་ བྲལ་བ་␣ས་ རྟེན་འབྲེལ་ མདུང་ ཁྱིམ་ ལྟ་བུ་ སྟེ་"

msgctxt "74fb7bb70b1f466da8463febce308c9d"
msgid "དེ་དག་ ལས་མ་ རིག་པ་ ནི་ བཅུ་གཉིས་ ཀྱི་ ཡ་ རྒྱལ་ གཅིག་ ཡིན་ ཟེར །"
msgstr "དེ་དག་ ལས་མ་ རིག་པ་ ནི་ བཅུ་གཉིས་ ཀྱི་ ཡ་ རྒྱལ་ གཅིག་ ཡིན་ ཟེར །"

msgctxt "01dd374298404f64ba55bbdc753f804e"
msgid ""
"འདི་␣ར་ ནི་ རྟེན་འབྲེལ་ བཅུ་གཉིས་ མ་རིག་ ཁོ་ན་␣འི་ གཡོས་ སམ་ འཕྲུལ་ ཏེ་ "
"མ་རིག་ ཡོད་ ན་"
msgstr ""
"འདི་␣ར་ ནི་ རྟེན་འབྲེལ་ བཅུ་གཉིས་ མ་རིག་ ཁོ་ན་␣འི་ གཡོས་ སམ་ འཕྲུལ་ ཏེ་ "
"མ་རིག་ ཡོད་ ན་"

msgctxt "eabb5aa3b91f4b2fbd43456470174d00"
msgid "རྒ་ཤི་␣འི་ བར་ ཡོད་ དུ་ཡོད་པ་␣ས་ དང༌ །"
msgstr "རྒ་ཤི་␣འི་ བར་ ཡོད་ དུ་ཡོད་པ་␣ས་ དང༌ །"

msgctxt "577ca07e5b074c5f958196c76c28233a"
msgid ""
"མ་རིག་ འགག་ ན་ རྒ་ཤི་␣འི་ བར་ དུ་ འགག་པ་␣ས་ ཀྱང་ མ་རིག་པ་␣འི་ གཡོས་ ཏེ །"
msgstr ""
"མ་རིག་ འགག་ ན་ རྒ་ཤི་␣འི་ བར་ དུ་ འགག་པ་␣ས་ ཀྱང་ མ་རིག་པ་␣འི་ གཡོས་ ཏེ །"

msgctxt "f3979e4863854dc6a9b3a11fd9d0bf92"
